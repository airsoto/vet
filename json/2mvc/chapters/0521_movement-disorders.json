        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Frequently breed-specific syndromes— Norwich terrier, chinook (paroxysmal dyskinesia), border collie/Australian shepherd dog (collapse), Scottish terrier (collapse).",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gluten hypersensitivity—border terrier,",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "possibly also other dog breeds.",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gene mutations—cavalier King Charles spaniel",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "(BCAN, episodic falling), Irish wolfhound",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "puppies (SLGA5; glycine receptor, startle",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "disease), Russell terrier (KCNJ10, hereditary",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "cerebellar ataxia associated with myokymia),",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1,
              "subheading": "disease), Russell terrier (KCNJ10, hereditary"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "soft-coated wheaten terrier (PIGN); Labrador",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "retriever collapse (DNM1); Chinese-crested",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "dog, Kerry blue terrier (multisystem",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1,
              "subheading": "retriever collapse (DNM1); Chinese-crested"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "degeneration,SERAC1), Sheltie (PCK2).",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1,
              "subheading": "retriever collapse (DNM1); Chinese-crested"
            }
          ]
        }
      }
    },
