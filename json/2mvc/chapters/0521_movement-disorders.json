      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Non-epileptic CNS disorders.",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Characterized by the occurrence of continuous or episodic involuntary movements",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "in a conscious, responsive animal.",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Unrelated",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "to epileptic activity.",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Movements may involve the whole body or be restricted to one body part, e.g., one or two limbs or one side of the",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "body.",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperkinetic movement disorders often occur as paroxysmal dyskinesias with long episodes of abnormal movements and increased muscle tone (dystonia) alternating with normal",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "neurologic function.",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypokinetic movement disorders manifest as bradykinesia or collapse.",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pathophysiology—abnormal CNS neural transmission, unrelated to epilepsy, dysfunction of basal nuclei, altered dopaminergic or serotinergic neurotransmission.",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            }
          ]
        },
