        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs; less common in cats.",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Breed-related",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "syndromes.",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Age of onset variable; often <3 years.",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Physical examination—unremarkable.",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neurologic examination—unremarkable",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "between episodes.",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cardiologic examination— unremarkable between and during episodes.",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Signs may include—repeated flexion or kicking, excessive lifting of one or more limbs, episodic muscle rigidity, muscle hypertonicity, difficulty initiating movements, episodic ataxia, kyphosis, scoliosis, backward gait, falling,",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "collapse.",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Description of episodes may vary between dog breeds. See specific references for detailed information on breed-specific",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "syndromes.",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Frequently long duration—",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "minutes to hours.",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Differentiated from epileptic seizures—no autonomic signs: no salivation, urination, normal pupils, no postictal",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "period, responsive during episode.",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Triggers are frequent—excitement, stress, excessive exercise,",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "heat.",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In some dog breeds there are gastrointestinal signs in association with episodes (Border terriers, paroxysmal glutensensitive dyskinesia).",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 1
            }
          ]
        },
