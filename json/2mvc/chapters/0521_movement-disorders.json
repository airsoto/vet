            {
              "type": "bullet",
              "level": 0,
              "text": "q12h; fluoxetine 1–2 mg/kg q24h.",
              "pdf_page": 989,
              "printed_page": 907,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Trial therapy with antiepileptic drugs—gabapentin 10–20 mg/kg q8h; levetiracetam 10–20 mg/kg q8h; phenobarbital 2.5 mg/kg q12h.",
