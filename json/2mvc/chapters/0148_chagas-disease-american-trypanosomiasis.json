      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Caused by hemoflagellate protozoan Trypanosoma cruzi.",
              "pdf_page": 336,
              "printed_page": 254,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Transmission through contact with infected feces of the Reduviid (“kissing”) bug, ingestion of bug vector, through blood transfusion, or vertical transmission to offspring.",
              "pdf_page": 336,
              "printed_page": 254,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "After multiplication at entry site (5 days postinfection [PI]), hematogenous spread to heart, brain, and other organs.",
              "pdf_page": 336,
              "printed_page": 254,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Maximal parasitemia at 14 days PI; associated with acute myocarditis and (less commonly) encephalitis.",
              "pdf_page": 336,
              "printed_page": 254,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infection becomes subpatent 30 days PI.",
              "pdf_page": 336,
              "printed_page": 254,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs then enter long asymptomatic period (months to years); subset develop cardiomyopathy.",
              "pdf_page": 336,
              "printed_page": 254,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "South and Central America—endemic in humans and pets; infected animals are sentinels for human risk.",
              "pdf_page": 336,
              "printed_page": 254,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "United States—in southern states with infected vectors and reservoir hosts (raccoons, opossums, armadillos, mice, rats, squirrels).",
              "pdf_page": 336,
              "printed_page": 254,
              "column": 1
            }
          ]
        },
