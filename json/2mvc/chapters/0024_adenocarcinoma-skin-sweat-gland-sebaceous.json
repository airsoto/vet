        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "May appear as solid, firm, raised, superficial skin lesions.",
              "pdf_page": 120,
              "printed_page": 38,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May be ulcerated and bleeding and accompanied by inflammation of the surrounding tissue.",
              "pdf_page": 120,
              "printed_page": 38,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Apocrine sweat gland—often poorly circumscribed, ulcerated and potentially purple in color; very invasive into underlying tissue; may occur anywhere on the body, frequently affecting the limbs and trunk in dogs and head, limbs, and abdomen in cats.",
              "pdf_page": 120,
              "printed_page": 38,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sebaceous gland—often nodular, ulcerated and inflamed, moderate risk of lymph node involvement; frequently found on head and neck in dogs and on the head, thorax, and perineum in cats.",
              "pdf_page": 120,
              "printed_page": 38,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dermal and lymphatic tracking can be observed early in disease course.",
              "pdf_page": 120,
              "printed_page": 38,
              "column": 1
            }
          ]
        },
