  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Tumor arising from major (e.g., parotid, mandibular, sublingual, or zygomatic) or minor salivary glands.",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mandibular or parotid glands constitute 80% of cases.",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mandibular gland most frequently affected in dogs.",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Parotid gland most frequently affected in",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "cats.",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Locally invasive.",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 1,
              "subheading": "cats."
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats typically have more advanced disease",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 1,
              "subheading": "cats."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "than dogs at time of diagnosis.",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 1,
              "subheading": "cats."
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metastasis—regional lymph node in 39%",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 1,
              "subheading": "cats."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "of cats and 17% of dogs at diagnosis; distant",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 1,
              "subheading": "cats."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "metastasis reported in 16% of cats and 8% of",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 1,
              "subheading": "cats."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "dogs at diagnosis, but may be slow to develop.",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 1,
              "subheading": "cats."
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Epithelial malignancies—constitute roughly",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 1,
              "subheading": "cats."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "85% of salivary gland tumors.",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 1,
              "subheading": "cats."
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Adenomas comprise only 5% of salivary",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 1,
              "subheading": "cats."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "tumors.",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 1,
              "subheading": "cats."
            }
          ]
        },
