        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Regional radiographs usually are normal; may see periosteal reaction on adjacent bones or displacement of surrounding structures.",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "MRI or CT imaging allows superior discrimination of tumor for surgery and/or radiation treatment planning.",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiographs indicated to check for lung metastases.",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytologic examination of aspirate may differentiate salivary adenocarcinoma from mucocele and abscess.",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Biopsy for histopathology is required for definitive diagnosis.",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 2
            }
          ]
        },
