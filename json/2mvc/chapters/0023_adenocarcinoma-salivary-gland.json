        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs and cats.",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mean age, 10–12 years.",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Siamese cats may be at relatively higher risk.",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Male cats affected twice as often as female cats.",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No other breed or sex predilection has been determined.",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Unilateral, firm, painless swelling of the upper neck (mandibular and sublingual), ear base (parotid), upper lip or maxilla (zygomatic), or mucous membrane of lip (accessory or minor salivary tissue).",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other signs may include halitosis, weight loss, anorexia, dysphagia, exophthalmus, Horner’s syndrome, sneezing, and dysphonia.",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 1
            }
          ]
        },
