      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Evaluations—physical examination and thoracic radiographs every 3 months reasonable if aggressive surgery and/or radiation therapy employed.",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 2
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": []
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Temporary acute side effects (e.g., moist dermatitis and alopecia) expected with radiation therapy. Consultation with a radiation oncologist is recommended regarding specific, anatomic site–related side effects associated with planned dose and field size.",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 2
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Improved survival time in dogs without evidence of nodal or distant metastasis at diagnosis; clinical stage not prognostic for cats.",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Median survival 550 days for dogs and 516 days for cats in retrospective study.",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Local control obtained through radiation and/or surgery is critical to outcome.",
              "pdf_page": 119,
              "printed_page": 37,
              "column": 3
            }
          ]
        }
      }
