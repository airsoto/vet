    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Aggressive surgical resection—when possible; most are invasive and difficult to excise completely.",
          "pdf_page": 119,
          "printed_page": 37,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Radiotherapy—good local control and prolonged survival may be possible.",
          "pdf_page": 119,
          "printed_page": 37,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Aggressive local resection (usually histologically incomplete) followed by adjuvant radiation can achieve local control and long-term survival in some cases, but further studies are needed to determine the most effective treatment, including the possible role for chemotherapy.",
          "pdf_page": 119,
          "printed_page": 37,
          "column": 2
        }
      ],
