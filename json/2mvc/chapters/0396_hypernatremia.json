              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "in dogs or>165 mEq/L in cats.",
              "pdf_page": 773,
              "printed_page": 691,
              "column": 1,
              "subheading": "Serum sodium (Na+) concentration>158 mEq/L"
            }
          ]
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Na+is the most abundant cation in the extracellular fluid, so hypernatremia usually results in hyperosmolality.",
              "pdf_page": 773,
              "printed_page": 691,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypernatremia can be caused by excessive free water loss, increased intake of Na+, or a combination of both.",
              "pdf_page": 773,
              "printed_page": 691,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Common causes of hypernatremia include renal or gastrointestinal loss of water in excess of sodium loss and low water intake. Excessive Na+ingestion is a rare cause.",
              "pdf_page": 773,
              "printed_page": 691,
              "column": 1
            }
          ]
        },
        "SYSTEMS AFFECTED": {
          "present": true,
          "status": "content",
          "source_heading": "SYSTEMS AFFECTED",
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Endocrine/metabolic.",
              "pdf_page": 773,
              "printed_page": 691,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nervous.",
              "pdf_page": 773,
              "printed_page": 691,
              "column": 1
            }
          ]
        },
        "GENETICS": {
          "present": false,
