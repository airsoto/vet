        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Polydipsia.",
              "pdf_page": 773,
              "printed_page": 691,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Disorientation.",
              "pdf_page": 773,
              "printed_page": 691,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Coma.",
              "pdf_page": 773,
              "printed_page": 691,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Seizures.",
              "pdf_page": 773,
              "printed_page": 691,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other findings depend on underlying cause.",
              "pdf_page": 773,
              "printed_page": 691,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Severity of signs usually correlates to the degree of hypernatremia.",
              "pdf_page": 773,
              "printed_page": 691,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES",
          "canonical_heading": "CAUSES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Free water deficit (most common cause)— low water intake (e.g., no access to water, adipsia, or hypodipsia); high urinary water loss; high insensible water loss (e.g., panting, hyperthermia).",
              "pdf_page": 773,
              "printed_page": 691,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Urinary loss (e.g., diabetes insipidus,",
              "pdf_page": 773,
              "printed_page": 691,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "diabetes mellitus, osmotic diuresis, diuresis after acute urinary obstruction).",
              "pdf_page": 773,
              "printed_page": 691,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Gastrointestinal sodium loss (e.g.,",
              "pdf_page": 773,
              "printed_page": 691,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "administration of osmotic cathartic, vomiting, diarrhea).",
              "pdf_page": 773,
              "printed_page": 691,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "A wide variety of drugs interfere with",
              "pdf_page": 773,
              "printed_page": 691,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "renal capacity to concentrate urine, leading to water loss in excess of Na+; these drugs include lithium, demeclocycline, and amphotericin.",
              "pdf_page": 773,
              "printed_page": 691,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Oral sodium ingestion (rare); IV administration of 0.9% or 7% NaCl; hyperaldosteronism (rarely hypernatremic); hyperadrenocorticism (mild).",
              "pdf_page": 773,
              "printed_page": 691,
              "column": 1
            }
          ]
        },
