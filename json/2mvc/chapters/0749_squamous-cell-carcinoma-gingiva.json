      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Malignant tumor of squamous epithelium.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rapid progression, locally invasive, highly osteo-invasive (77%).",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most common oral malignancy in cats; one of most common oral malignancies in dogs.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Approximately 10–20% metastasis in dogs and cats with potential involvement of draining lymph nodes (most common) and lung parenchyma.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1
            }
          ]
        },
