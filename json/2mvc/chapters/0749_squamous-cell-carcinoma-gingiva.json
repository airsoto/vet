        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Dogs",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Negative prognostic factors—caudal or",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 3,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "maxillary location, >2 cm diameter, older age,",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 3,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "incomplete excision.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 3,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Surgical excision—median survival 15–16",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 3,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "months, 34 months combined with radiation",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 3,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "therapy; mandibulectomy better outcome",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 3,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "than maxillectomy.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 3,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Combination carboplatin and piroxicam",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 3,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "with or without surgery—median survival",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 3,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": ">18 months (7 dogs).",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 3,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Piroxicam—17% response rate with a median",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 3,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "progression-free interval of 3.5–6 months.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 3,
              "subheading": "Dogs"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Cats",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "1-year survival rate is 10% for multimodal",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 3,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "therapy.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 3,
              "subheading": "Cats"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In rare cases where surgery is an option,",
