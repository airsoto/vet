    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "subheading",
          "level": 0,
          "text": "Dogs",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Radical surgical excision required (e.g.,",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Dogs"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "hemi-mandibulectomy); usually well",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Dogs"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "tolerated; margins of at least 2 cm necessary.",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Dogs"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Radiation therapy—effective for long-term",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Dogs"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "control; curative-intent treatment used alone or",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Dogs"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "in combination with surgery or chemotherapy.",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Dogs"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Chemotherapy—alone or in combination",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Dogs"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "with other treatment modalities; toceranib",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Dogs"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "phosphate (Palladia) exerts single-agent",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Dogs"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "activity in a substantial fraction (biologic",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Dogs"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "response) of dogs treated.",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Dogs"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Piroxicam may have some antineoplastic effects.",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Dogs"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Cryosurgery or electrochemotherapy—",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Dogs"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "indicated for small lesions with no bone",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Dogs"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "involvement.",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Dogs"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Photodynamic therapy—adjunct to surgery",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Dogs"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "may be effective for local control of small tumors.",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Dogs"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Analgesics for pain or antibiotics for",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Dogs"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "secondary bacterial infections may be indicated.",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Dogs"
        },
        {
          "type": "subheading",
          "level": 0,
          "text": "Cats",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgery—most tumors are inoperable;",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Cats"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "small rostral lesions may be excised with wide",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Cats"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "2–3 cm margins; cats do not tolerate",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Cats"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "aggressive oral surgery as well as dogs.",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Cats"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Palliative treatments include coarse-fraction",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Cats"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "radiation therapy (<50% response).",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Cats"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Metastasis less of a concern as most cats",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Cats"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "succumb to local disease progression.",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Cats"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Bisphosphonates—used to palliate bone pain.",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Cats"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Analgesics for pain or antibiotics for secondary",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Cats"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "bacterial infections may be indicated.",
          "pdf_page": 1367,
          "printed_page": 1285,
          "column": 2,
          "subheading": "Cats"
        }
      ],
