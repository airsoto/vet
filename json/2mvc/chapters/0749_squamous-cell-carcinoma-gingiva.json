              "type": "bullet",
              "level": 0,
              "text": "Toceranib phosphate (Palladia)—dogs and cats, 2.5–3.25 mg/kg PO q48h.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cisplatin—dogs only, 60–70 mg/m2IV once q3–4 weeks for 4 treatments.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Carboplatin—dogs, 300 mg/m2q3 weeks IV; cats, 180–240 mg/m2q3–4 weeks for 4–5 treatments.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mitoxantrone—cats, 5–6 mg/m2q3 weeks IV for 4–5 treatments.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Piroxicam—dogs, 0.3 mg/kg PO q24h; cats, q48–72h.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 3
            }
          ]
        },
