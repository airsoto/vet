              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mass effect.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ptyalism.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dysphagia.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Halitosis.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bloody saliva.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Weight loss.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyporexia or avoidance of hard foods/toys.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Poor grooming (cats).",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Erythematous, ulcerated, fleshy lesion.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Loose teeth.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Facial swelling or deformity.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exophthalmos.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pain on opening jaw.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
