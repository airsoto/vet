        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Skull radiography—evaluate potential bone involvement.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "High-detail dental radiography—more sensitive in evaluating local disease than skull radiography; best with mandibular masses.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CT—ideal to evaluate soft tissue extension, bone invasion, regional lymph nodes, and for surgical planning.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiography—evaluate for pulmonary metastasis (uncommon in dogs, rare in cats).",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytology—fine-needle aspirate samples can be sufficient, though ulceration, inflammation, and secondary infection may limit diagnostic utility.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Deep tissue biopsy—beneficial to differentiate from other oral malignancies via histopathology.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytology of regional lymph nodes to assess for regionally metastatic disease.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
