    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other oral malignancy—fibrosarcoma in cats; melanoma, fibrosarcoma, osteosarcoma in dogs.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Epulis (acanthamatous, fibrous, ossifying).",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tooth root abscess.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Benign growth or polyp.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gingival hyperplasia (breed, e.g., boxer, or drug-induced, e.g., cyclosporine).",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Eosinophilic granuloma complex.",
              "pdf_page": 1367,
              "printed_page": 1285,
              "column": 1
            }
          ]
        },
