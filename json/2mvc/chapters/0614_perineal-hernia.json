              "pdf_page": 1143,
              "printed_page": 1061,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Part of conservative medical management.",
              "pdf_page": 1143,
              "printed_page": 1061,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Postoperatively.",
              "pdf_page": 1143,
              "printed_page": 1061,
              "column": 3
            }
          ]
        },
        "CLIENT EDUCATION": {
          "present": true,
          "status": "not_applicable",
          "source_heading": "CLIENT EDUCATION",
          "canonical_heading": "CLIENT EDUCATION",
          "content_blocks": [
            {
              "type": "paragraph",
