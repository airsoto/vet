      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Stool softeners may be considered as a component of conservative medical management or prior to surgery:",
              "pdf_page": 1144,
              "printed_page": 1062,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Lactulose 0.5–1 mL/kg PO q8–12h,",
              "pdf_page": 1144,
              "printed_page": 1062,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "adjusted to effect.",
              "pdf_page": 1144,
              "printed_page": 1062,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "PEG 3350 (MiraLax®) 1⁄4–1 tsp on food",
              "pdf_page": 1144,
              "printed_page": 1062,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "q12h, adjusted to effect.",
              "pdf_page": 1144,
              "printed_page": 1062,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Goal is 2–3 soft-formed stools per day.",
              "pdf_page": 1144,
              "printed_page": 1062,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intraoperative antibiotics may be given, but there is no indication to continue antibiotic treatment postoperatively unless significant contamination occurs during surgery.",
              "pdf_page": 1144,
              "printed_page": 1062,
              "column": 1
