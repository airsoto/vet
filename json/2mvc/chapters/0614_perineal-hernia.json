          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Intact male dogs are at highest risk. The disease occurs rarely in castrated male dogs, female dogs, and cats.",
              "pdf_page": 1143,
              "printed_page": 1061,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Constipation is the main feature, although some patients present with diarrhea as looser stool escapes around the firmer stool.",
              "pdf_page": 1143,
              "printed_page": 1061,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Unilateral or bilateral perineal bulge due to fecal impaction and/or herniation:",
              "pdf_page": 1143,
              "printed_page": 1061,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "May be dynamic or static.",
              "pdf_page": 1143,
              "printed_page": 1061,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "May become more obvious during events",
              "pdf_page": 1143,
              "printed_page": 1061,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "of increased intra-abdominal pressure— barking, coughing, defecation, and urination.",
              "pdf_page": 1143,
              "printed_page": 1061,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Often the only presenting sign in cats.",
              "pdf_page": 1143,
              "printed_page": 1061,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Straining to urinate if bladder incarceration occurs.",
              "pdf_page": 1143,
              "printed_page": 1061,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
