        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Intact status in older male dogs and male dogs with unilateral or bilateral cryptorchidism.",
              "pdf_page": 1143,
              "printed_page": 1061,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Underlying pathology leading to excessive straining:",
              "pdf_page": 1143,
              "printed_page": 1061,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Prostatomegaly in male dogs.",
              "pdf_page": 1143,
              "printed_page": 1061,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Megacolon and malunion of pelvic",
              "pdf_page": 1143,
              "printed_page": 1061,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "fractures in cats.",
              "pdf_page": 1143,
              "printed_page": 1061,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Caudal neuropathy, malformation or injury such as tail traction or avulsion.",
              "pdf_page": 1143,
              "printed_page": 1061,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Trauma (rare).",
              "pdf_page": 1143,
              "printed_page": 1061,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other causes of straining during defecation or urination include perineal or intrapelvic mass:",
              "pdf_page": 1143,
              "printed_page": 1061,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Neoplasia (adenoma, lipoma, adeno",
              "pdf_page": 1143,
              "printed_page": 1061,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "carcinoma, sarcoma).",
              "pdf_page": 1143,
              "printed_page": 1061,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Sublumbar lymphadenomegaly secondary",
              "pdf_page": 1143,
              "printed_page": 1061,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "to anal sac adenocarcinoma.",
              "pdf_page": 1143,
              "printed_page": 1061,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Rectal tumor.",
              "pdf_page": 1143,
              "printed_page": 1061,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Paraprostatic cyst or abscess.",
              "pdf_page": 1143,
              "printed_page": 1061,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Perineal abscess (e.g., anal sac).",
              "pdf_page": 1143,
              "printed_page": 1061,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "No specific abnormalities. Azotemia if urinary obstruction occurs.",
              "pdf_page": 1143,
              "printed_page": 1061,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
