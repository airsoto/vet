    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgical management required for definitive",
          "pdf_page": 1143,
          "printed_page": 1061,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 1,
          "text": "Emergency if bladder retroflexion and",
          "pdf_page": 1143,
          "printed_page": 1061,
          "column": 3
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "entrapment, or intestinal entrapment have occurred.",
          "pdf_page": 1143,
          "printed_page": 1061,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Conservative treatment may temporarily ameliorate clinical signs:",
          "pdf_page": 1143,
          "printed_page": 1061,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 1,
          "text": "Low residue diet.",
          "pdf_page": 1143,
          "printed_page": 1061,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 1,
          "text": "Stool softeners.",
          "pdf_page": 1143,
          "printed_page": 1061,
          "column": 3
        }
      ],
