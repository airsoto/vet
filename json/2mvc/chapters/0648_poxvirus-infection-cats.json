        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—domestic and exotic.",
              "pdf_page": 1204,
              "printed_page": 1122,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No age, sex, or breed predisposition.",
              "pdf_page": 1204,
              "printed_page": 1122,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Skin lesions—multiple, circular; dominant feature; usually develop on head, neck, or forelimbs.",
              "pdf_page": 1204,
              "printed_page": 1122,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary lesions—crusted papules, plaques, nodules, crateriform ulcers, or areas of cellulitis or abscesses.",
              "pdf_page": 1204,
              "printed_page": 1122,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary lesions—erythematous nodules that ulcerate and crust; often widespread; develop after 1–3 weeks.",
              "pdf_page": 1204,
              "printed_page": 1122,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Oral lesions—erosions, ulcers either concurrently or alone (20% of cases).",
              "pdf_page": 1204,
              "printed_page": 1122,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pruritus variable.",
              "pdf_page": 1204,
              "printed_page": 1122,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Systemic—20% of cases; anorexia, lethargy, pyrexia, vomiting, diarrhea, oculonasal discharge, conjunctivitis, pneumonia.",
              "pdf_page": 1204,
              "printed_page": 1122,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
