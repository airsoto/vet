      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Member of the genusOrthopoxvirus, family Poxviridae.",
              "pdf_page": 1204,
              "printed_page": 1122,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Enveloped, double-stranded DNA virus, resistant to drying (viable for years) but readily inactivated by most disinfectants.",
              "pdf_page": 1204,
              "printed_page": 1122,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Geographically limited to Eurasia.",
              "pdf_page": 1204,
              "printed_page": 1122,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Relatively common.",
              "pdf_page": 1204,
              "printed_page": 1122,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Serologic evidence of infection may approach 10% in cats in western Europe.",
              "pdf_page": 1204,
              "printed_page": 1122,
              "column": 1
            }
          ]
        },
