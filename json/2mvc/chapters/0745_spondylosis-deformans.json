    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Discospondylitis—differentiated by radiographic evidence of endplate lysis.",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Spinal osteoarthritis—degeneration of articular facet joints.",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neoplasia—may have irregular, ventral, nonbridging bone.",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Normal",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Radiographic Findings",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Spinal radiography initially shows osteophytes",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 2,
              "subheading": "Radiographic Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "as triangular projections several millimeters",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 2,
              "subheading": "Radiographic Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "from the edge of the vertebral body. With",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 2,
              "subheading": "Radiographic Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "progression, osteophytes appear to bridge the",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 2,
              "subheading": "Radiographic Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "intervertebral space. True ankylosis is rare.",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 2,
              "subheading": "Radiographic Findings"
            }
          ]
        },
