    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "If signs are present, restrict activity and gradually return the animal to normal activity after signs have subsided for several weeks.",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Relapse can occur with strenuous activity.",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "With prolonged use of analgesic medications, periodic biochemistry testing is warranted.",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 3
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Boxers—given genetic correlation between spondylosis deformans and hip dysplasia and potential for early radiographic detection, dogs should be screened and selectively bred.",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 3
            }
          ]
        },
