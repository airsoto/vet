        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog and cat.",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Females>males.",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—commonly seen in large breeds, especially German shepherd dog; also boxer, Airedale terrier, and cocker spaniel.",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Occurrence increases with age. Present in 50% of dogs by 6 years and 75% by 9 years. May be radiographically evident in young dogs with an inherited predisposition.",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Boxers—positive correlation between spondylosis deformans and hip dysplasia. Both heritable traits are detectable in predisposed animals by radiographic examination at 1 year.",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—present in 68% of asymptomatic cats.",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "General Comments",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Patients are typically asymptomatic; lesions",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "are of minor if any clinical importance.",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pain may follow fracture of bony spurs or",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "bridges.",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Stiffness.",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Restricted motion.",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Spinal pain.",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Neurologic deficits are uncommon. If",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "present, referable to compression of the spinal",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "cord or nerve root.",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
