  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Degenerative, noninflammatory condition of the vertebral column that occurs in response to intervertebral disc degeneration.",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Often an incidental finding, rarely clinically important.",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Characterized by the production of osteophytes along the ventral, lateral, and dorsolateral aspects of the vertebral endplates. Radiographically, appears as smooth, ventral bridging bone.",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most common location in dogs is the thoracolumbar spine in the area of the anticlinal vertebra and the upper lumbar vertebrae; in cats, the thoracic vertebrae.",
              "pdf_page": 1363,
              "printed_page": 1281,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
