    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Typically not needed. Inform client that the condition is usually an asymptomatic, incidental finding, and is likely not respons ible for any clinical signs that may be present.",
          "pdf_page": 1363,
          "printed_page": 1281,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Treat spondylosis on an outpatient basis with strict rest and analgesia, possibly acupuncture.",
          "pdf_page": 1363,
          "printed_page": 1281,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "If overconditioned, recommend weightreduction program.",
          "pdf_page": 1363,
          "printed_page": 1281,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Acupuncture—dry needle or electro acupuncture treatment at weekly or biweekly interval and tapered to as-needed basis can be very effective in relief of pain. Useful in animals who do not tolerate medication or when clients prefer an alternative treatment modality.",
          "pdf_page": 1363,
          "printed_page": 1281,
          "column": 2
        }
      ],
