      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Monitor serum biochemistry at 14-day intervals to assess treatment response; monitor serum potassium concentration regularly as bicarbonate therapy may aggravate renal potassium loss; once stable, monitor biochemistry at 3-month intervals.",
          "pdf_page": 571,
          "printed_page": 489,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Clinical course varies; some dogs remain stable for years, others develop rapidly progressive renal failure over a few months; cause of death usually acute kidney injury with severe metabolic acidosis.",
          "pdf_page": 571,
          "printed_page": 489,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Some dogs (18% in one study) developed seizures or other neurologic signs several years after diagnosis.",
          "pdf_page": 571,
          "printed_page": 489,
          "column": 3
        }
      ],
