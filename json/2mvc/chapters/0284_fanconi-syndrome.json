        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Species",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Dogs and rarely cats.",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 1,
              "subheading": "Species"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Breed Predilections",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Sporadically reported in several breeds,",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "idiopathic Fanconi syndrome primarily affects",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "the basenji breed (approximately 75% of",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "cases). In America, 10–30% of basenjis are",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "affected. It is presumed to be inherited in this",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "breed, but the mode of inheritance is",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "unknown.",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Mean Age and Range",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Age at diagnosis: 10 weeks–11 years. Affected",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 1,
              "subheading": "Mean Age and Range"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "basenjis usually are>2 years of age; most",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "develop clinical signs from 4 to 7 years.",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 1,
              "subheading": "basenjis usually are>2 years of age; most"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Predominant Sex",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "None",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 1,
              "subheading": "Predominant Sex"
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Depends on the severity of specific solute losses and residual renal function.",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Loss of amino acids and glucose—usually not associated with clinical signs other than polyuria and polydipsia.",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Weight loss.",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Uremia, lethargy, decreased appetite.",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abnormal growth (rickets) may occur in young animals.",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Inherited in basenjis and possibly Irish wolfhounds.",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acquired Fanconi syndrome has been reported in dogs given gentamicin, streptozotocin, maleic acid, amoxicillin, chlorambucil (cats), and chicken or duck jerky treats, many of which have originated from China; also reported secondary to primary hypoparathyroidism, copper associated hepatopathy, and lead toxicity.",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Primary renal glucosuria causes glucosuria despite normoglycemia; documentation of aminoaciduria, mild proteinuria, or a hyperchloremic normal anion gap metabolic acidosis suggests Fanconi syndrome.",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "CBC usually normal.",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypokalemia.",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperchloremic metabolic acidosis.",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Azotemia if renal failure develops.",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypophosphatemia and hypocalcemia may occur in affected young, growing animals.",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urine specific gravity usually low (1.005– 1.018); mild proteinuria common; ketonuria may be present.",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Granular or lipid casts and bacteria were seen in 27–40% of dogs.",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Hyperchloremic normal anion gap metabolic acidosis due to bicarbonaturia with urine pH",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "<5.5. Urine pH>6.0 in distal renal tubular",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "acidosis, which is key diagnostic difference to",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 2,
              "subheading": "<5.5. Urine pH>6.0 in distal renal tubular"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "proximal renal tubular acidosis (Fanconi",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 2,
              "subheading": "<5.5. Urine pH>6.0 in distal renal tubular"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "syndrome).",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 2,
              "subheading": "<5.5. Urine pH>6.0 in distal renal tubular"
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Radiography—young growing dogs may have rickets and angular limb deformities; adults may have decreased bone density.",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Urinary clearance studies to document excessive excretion of glucose, amino acids, and electrolytes needed for confirmation. Do",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "not test animals<8 weeks of age because",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "false-positive results may occur. Urine can be",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 2,
              "subheading": "not test animals<8 weeks of age because"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "evaluated at PennGen for aminoaciduria.",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 2,
              "subheading": "not test animals<8 weeks of age because"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Fractional reabsorption of amino acids in",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 2,
              "subheading": "not test animals<8 weeks of age because"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "affected dogs ranges from 50% to 96%",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 2,
              "subheading": "not test animals<8 weeks of age because"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(normal 97–100%).",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 2,
              "subheading": "not test animals<8 weeks of age because"
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Renal papillary necrosis may occur in late disease.",
              "pdf_page": 571,
              "printed_page": 489,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Discontinue any drug or treats that may cause Fanconi syndrome or treat for specific intoxication.",
          "pdf_page": 571,
          "printed_page": 489,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "No treatment reverses transport defects in dogs with inherited or idiopathic disease.",
          "pdf_page": 571,
          "printed_page": 489,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Because magnitude of transport defects varies among affected animals, treatment must be individualized.",
          "pdf_page": 571,
          "printed_page": 489,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Treat for metabolic acidosis if blood",
          "pdf_page": 571,
          "printed_page": 489,
          "column": 2
        },
        {
          "type": "subheading",
          "level": 0,
          "text": "bicarbonate concentration<12 mEq/L. Large",
          "pdf_page": 571,
          "printed_page": 489,
          "column": 2
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "doses of alkalinizing agents may be required",
          "pdf_page": 571,
          "printed_page": 489,
          "column": 2,
          "subheading": "bicarbonate concentration<12 mEq/L. Large"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "because decreased proximal tubular resorptive",
          "pdf_page": 571,
          "printed_page": 489,
          "column": 2,
          "subheading": "bicarbonate concentration<12 mEq/L. Large"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "capacity results in marked bicarbonaturia.",
          "pdf_page": 571,
          "printed_page": 489,
          "column": 2,
          "subheading": "bicarbonate concentration<12 mEq/L. Large"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "Goal of alkali therapy to maintain blood",
          "pdf_page": 571,
          "printed_page": 489,
          "column": 2,
          "subheading": "bicarbonate concentration<12 mEq/L. Large"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "bicarbonate concentration 12–18 mEq/L.",
          "pdf_page": 571,
          "printed_page": 489,
          "column": 2,
          "subheading": "bicarbonate concentration<12 mEq/L. Large"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Young, growing dogs may require vitamin D,",
          "pdf_page": 571,
          "printed_page": 489,
          "column": 2,
          "subheading": "bicarbonate concentration<12 mEq/L. Large"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "calcium, and phosphorus supplementation.",
          "pdf_page": 571,
          "printed_page": 489,
          "column": 2,
          "subheading": "bicarbonate concentration<12 mEq/L. Large"
        }
      ],
