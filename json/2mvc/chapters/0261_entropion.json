        "SURGERY": {
          "present": true,
          "status": "content",
          "source_heading": "SURGERY",
          "canonical_heading": "SURGERY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "If cornea ulcerated—topical antibiotic (e.g., neomycin/polymyxin B/bacitracin) ointment q6–8h.",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If mildly entropic and cornea not ulcerated, lubricate with artificial tear ointment q8–12h.",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If moderate to severe entropion with or without corneal ulceration, temporarily evert eyelid margins with sutures to break the irritation–spasm cycle; if successful, permanent procedure is unnecessary; may need to be repeated every 2–4 weeks until adult facial conformation is achieved.",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Semi-permanent eyelid eversion with hyaluronic acid filler injection—lasts up to several months, often until adult facial conformation is achieved.",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Permanent skin resection technique— postponed until patient’s facial conformation matures (usually 1.5–2 years).",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Medial Entropion",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Temporary eversion of medial canthus with",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 2,
              "subheading": "Medial Entropion"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "sutures may aid in determining contribution",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 2,
              "subheading": "Medial Entropion"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "of medial entropion to epiphora.",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 2,
              "subheading": "Medial Entropion"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Medial canthoplasty should be considered if",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 3,
              "subheading": "Medial Entropion"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "entropion results in pigmentary keratitis,",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 3,
              "subheading": "Medial Entropion"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "chronic epiphora, or corneal scarring.",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 3,
              "subheading": "Medial Entropion"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Mature Dogs and Cats",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic entropion—requires eyelid",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 3,
              "subheading": "Mature Dogs and Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "margin–everting surgery; ranges from simple",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 3,
              "subheading": "Mature Dogs and Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Hotz-Celsus procedure to more radical lateral",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 3,
              "subheading": "Mature Dogs and Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "canthoplasty procedures; often combined",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 3,
              "subheading": "Mature Dogs and Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "with lid-shortening procedures.",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 3,
              "subheading": "Mature Dogs and Cats"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No history of previous entropion and",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 3,
              "subheading": "Mature Dogs and Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "clinical signs of acute condition—identify",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 3,
              "subheading": "Mature Dogs and Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "cause of spastic condition and correct; may",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 3,
              "subheading": "Mature Dogs and Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "attempt temporary eversion sutures before",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 3,
              "subheading": "Mature Dogs and Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "permanent skin resection.",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 3,
              "subheading": "Mature Dogs and Cats"
            }
          ]
        },
