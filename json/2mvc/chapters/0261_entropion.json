    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "paragraph",
          "level": 0,
          "text": "Temporary eversion suture technique—entropion may revert when sutures are removed or spontaneously pull through the skin; repeat as necessary until patient is mature enough to undergo more permanent repair. Consider hyaluronic acid filler injection as alternative.",
          "pdf_page": 531,
          "printed_page": 449,
          "column": 3
        }
