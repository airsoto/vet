        "GEOGRAPHIC DISTRIBUTION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GEOGRAPHIC DISTRIBUTION",
          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Common in dogs—seen in chow chow, Chinese Shar-Pei, Norwegian elkhound, sporting breeds (e.g., spaniel, retriever), brachycephalic breeds, toy breeds, and giant breeds; age—puppies as early as 2–6 weeks old; usually identified in dogs<1 year old.",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—usually in brachycephalic breeds, in young cats due to chronic ocular surface disease, and older animals due to retrobulbar fat loss.",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Mild, medial—chronic epiphora and medial pigmentary keratitis (toy dogs and brachycephalic dogs and cats).",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mild, lateral—chronic mucoid to mucopurulent ocular discharge (giant-breed dogs).",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Upper lid, lower lid, or lateral canthal— severe blepharospasm, purulent discharge, pigmentary or ulcerative keratitis, potential cornea rupture (chow chow, shar-pei, bloodhound, sporting breeds).",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—often have associated keratoconjunctivitis, corneal ulceration, or corneal sequestrum (brown-black corneal opacity).",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Genetic predisposition—based on facial conformation and eyelid support.",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Brachycephalic breeds (dogs and cats)— excessive tension on ligamentous structures of medial canthus plus nasal folds and facial conformation results in rolling inward of medial aspects of upper and lower eyelids at the medial canthus.",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Giant breeds and breeds with excessive eyelid length (macroblepharon), heavy/loose facial skin, or excessive facial folds—laxity of lateral canthus allows entropion of upper and lower eyelids and lateral canthus.",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Spastic entropion—from ocular irritation (e.g., distichia, ectopic cilia, trichiasis, foreign body, irritant conjunctivitis); leads to excessive blepharospasm.",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Non-predisposed breeds—may be primary irritant causing secondary spastic entropion.",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Loss of orbital fat or periorbital musculature may lead to enophthalmos and entropion.",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary cicatricial entropion—from scarring due to eyelid wounds or eyelid surgery.",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—chronic infectious conjunctivitis or keratitis: may lead to functional entropion",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "caused by chronic blepharospasm (spastic entropion); also in older cats due to enophthalmos from retrobulbar fat loss.",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 2
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Underlying causes of spastic entropion (eyelid hair anomalies, foreign bodies, infectious keratitis/conjunctivitis) should be ruled out and corrected, if possible, before an attempt at surgical correction is made.",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Puppies—common for first-time breeders of chow chows and Chinese Shar-Peis to mistakenly think that eyelids have not opened at 4–5 weeks of age, when puppies actually have severe blepharospasm and spastic entropion.",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 2
            }
          ]
        },
