        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Observe patient with minimal restraint to assess degree of entropion without distortion from tension on eyelids or periocular area.",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Apply a topical anesthetic to reduce spastic component to differentiate spastic versus physiologic entropion.",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 2
            }
          ]
        },
