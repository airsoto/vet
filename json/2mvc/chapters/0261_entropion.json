  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Inversion or rolling in of eyelid margin, resulting in frictional irritation of cornea and/or conjunctiva from contact with outer surface of eyelid.",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May result in keratitis, corneal ulceration, or corneal perforation.",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Can be conformational/congenital (primary) or acquired (secondary).",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Severe corneal disease may threaten vision.",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
        "PATHOPHYSIOLOGY": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": []
        },
        "SYSTEMS AFFECTED": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": []
        },
        "GENETICS": {
          "present": false,
