      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Topical ophthalmic ointment—triple antibiotic (in dogs only, q6–12h) or antibiotic based on culture and sensitivity testing; may be used if cornea is ulcerated, postoperatively, or as presurgical lubricant.",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Topical petrolatum-based artificial tear ointments (e.g., Puralube® q8–12h) may be used temporarily in mild cases without corneal ulceration.",
              "pdf_page": 531,
              "printed_page": 449,
              "column": 3
            }
          ]
        },
