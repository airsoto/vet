    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Hip dysplasia or other orthopedic disease (notably iliopsoas injury)—distinguish via thorough orthopedic examination ± imaging.",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic discospondylitis, osteomyelitis, neoplastic disease—cannot be differentiated by clinical signs alone.",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vertebral fractures and subluxations— acute; characterized by more bilateral signs.",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Localized meningomyelitis or radiculo neuritis—usually more diffuse pain.",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually normal.",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urinalysis—may reveal lower urinary tract infection secondary to urinary incontinence, or associated with discospondylitis.",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
