        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "If images suggest the need, cerebrospinal fluid (CSF) analysis may aid in diagnosing inflammatory (or infectious or neoplastic) disease.",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Radiology—commonly exhibit spondylosis at the lumbosacral junction; narrowing of the L7–S1 disc space; ventral displacement of the",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "sacrum relative to the lumbar vertebrae;but",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "interpret with caution because all these can be",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 3,
              "subheading": "sacrum relative to the lumbar vertebrae;but"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "observed in clinically normal animals.",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 3,
              "subheading": "sacrum relative to the lumbar vertebrae;but"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CT and MRI—modalities of choice.",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 3,
              "subheading": "sacrum relative to the lumbar vertebrae;but"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Apparent abnormalities must be interpreted",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 3,
              "subheading": "sacrum relative to the lumbar vertebrae;but"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "with regard to the whole clinical picture",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 3,
              "subheading": "sacrum relative to the lumbar vertebrae;but"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "because many are also observed in normal",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 3,
              "subheading": "sacrum relative to the lumbar vertebrae;but"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "animals.",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 3,
              "subheading": "sacrum relative to the lumbar vertebrae;but"
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Electromyography—denervation may be detected in muscles innervated by the nerves L7 to caudal; denervation confirms localiza tion of the lesion but is not specific for compressive lesions.",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Slowed sciatic–tibial nerve conduction or prolongation of F wave latencies may be detected.",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 3
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "May see one or more of the following features:",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Type II disc disease with bulging of dorsal",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "annulus.",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Hypertrophy of the interarcuate",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "ligament.",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Stenosis of the intervertebral foramen by",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "soft tissue or bony proliferation compressing L7 nerve(s) or as a congenital lesion.",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Ventral displacement of the sacrum in",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "relation to lumbar vertebrae.",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Proliferation of articular facets and",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hypertrophy of joint capsule.",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Congenitally shortened pedicles.",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Thickened and sclerotic laminae and",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "articular processes.",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Various vertebral malformations (not",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "only transitional vertebrae).",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cauda equina syndrome can also be associated with neoplasia, inflammation, infection.",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 3
            }
          ]
        }
      }
    },
