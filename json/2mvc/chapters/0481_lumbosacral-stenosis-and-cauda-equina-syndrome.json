    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "NSAIDs—e.g., carprofen 2 mg/kg q12h for 5–7 days then reducing doses until PRN.",
              "pdf_page": 924,
              "printed_page": 842,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gabapentin—frequently used at ~20–30 mg/kg q8h and may be effective (side effect: sedation; dizziness reported in humans).",
              "pdf_page": 924,
              "printed_page": 842,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Epidural corticosteroid—methylprednisolone actetate 1 mg/kg (<0.5 mL total volume).",
              "pdf_page": 924,
              "printed_page": 842,
              "column": 1
            }
          ]
        },
