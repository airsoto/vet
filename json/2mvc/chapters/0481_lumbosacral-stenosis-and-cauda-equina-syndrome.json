        "DEFINITION": {
          "present": true,
          "status": "content",
          "source_heading": "DEFINITION",
          "canonical_heading": "DEFINITION",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Lumbosacral stenosis refers to narrowing of the lumbosacral vertebral canal and/or L7– sacral intervertebral foramina, causing compression of L7, sacral, or caudal nerves.",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cauda equina syndrome implies pain or other clinical signs related to dysfunction of these nerves.",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 1
            }
          ]
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Congenital—abnormal vertebral development causing narrowing of the lumbosacral vertebral canal. Transitional vertebrae and other malformations are common at this site and may contribute to (early) disease progression.",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acquired—bony and soft tissue degenerative changes, most commonly affecting the L7 intervertebral disc, that cause stenosis of the vertebral canal and/or intervertebral foramina. Specific syndrome of sacral osteochondrosis dissecans is recognized in young German shepherd dogs and other breeds.",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 1
            }
          ]
        },
        "SYSTEMS AFFECTED": {
          "present": true,
          "status": "content",
          "source_heading": "SYSTEMS AFFECTED",
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Nervous—specifically nerves from L7 caudally.",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 1
            }
          ]
        },
        "GENETICS": {
          "present": true,
          "status": "content",
          "source_heading": "GENETICS",
          "canonical_heading": "GENETICS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "No known genetic basis.",
              "pdf_page": 923,
              "printed_page": 841,
              "column": 1
            }
          ]
        },
