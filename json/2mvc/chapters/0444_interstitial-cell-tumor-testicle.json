    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Bilateral orchiectomy and scrotal ablation is the treatment of choice; exploratory laparotomy for retained testicles.",
          "pdf_page": 861,
          "printed_page": 779,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Histopathologic examination of appropriate tissue.",
          "pdf_page": 861,
          "printed_page": 779,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Immunohistochemistry may be necessary to identify cell of origin in some cases.",
          "pdf_page": 861,
          "printed_page": 779,
          "column": 2
        }
