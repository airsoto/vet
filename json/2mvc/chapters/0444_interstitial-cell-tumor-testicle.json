        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "33–50% of all testicular tumors in dogs, but rare in cats.",
              "pdf_page": 861,
              "printed_page": 779,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Median age, 10 years.",
              "pdf_page": 861,
              "printed_page": 779,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Boxer, German shepherd, Afghan hound, Weimaraner, Shetland sheepdog, collie, and Maltese may be at increased risk.",
              "pdf_page": 861,
              "printed_page": 779,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually incidental finding.",
              "pdf_page": 861,
              "printed_page": 779,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fertility issues in breeding dogs.",
              "pdf_page": 861,
              "printed_page": 779,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May be associated with testosterone secretion and perianal gland hyperplasia or adenomas.",
              "pdf_page": 861,
              "printed_page": 779,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "4–20% of dogs will have more than one type of testicular tumor. Up to 50% of dogs will have bilateral tumors; only 12% of contralateral tumors will be palpable.",
              "pdf_page": 861,
              "printed_page": 779,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
