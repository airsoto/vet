        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Classical (acute)—hyperesthesia; cervical rigidity; stiff gait; fever up to 42°C (107.6°F).",
              "pdf_page": 1376,
              "printed_page": 1294,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Protracted—neurologic deficits, usually reflecting a spinal cord or multifocal lesion.",
              "pdf_page": 1376,
              "printed_page": 1294,
              "column": 1
            }
          ]
        },
