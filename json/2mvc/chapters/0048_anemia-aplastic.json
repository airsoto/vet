        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Dogs and cats, no apparent breed or sex predilection. In one study, the mean age of nine affected dogs was 3 years.",
              "pdf_page": 164,
              "printed_page": 82,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute form—fever, petechial hemorrhages, epistaxis, hematuria, melena; i.e., signs due to neutropenia and thrombo-",
              "pdf_page": 164,
              "printed_page": 82,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "cytopenia.",
              "pdf_page": 164,
              "printed_page": 82,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic form—pale mucous membranes, weakness, lethargy; i.e., signs due to anemia, in addition to signs observed in acute forms.",
              "pdf_page": 164,
              "printed_page": 82,
              "column": 1
            }
          ]
        },
