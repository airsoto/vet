          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs and cats of any age; older dogs and cats more likely to have age-related conditions.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No breed predilection.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Persistent infertility after appropriately timed mating to several reproductively proven bitches.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abnormalities identified during semen evaluation.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1
            }
          ]
        },
