        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Hormonal profile—concentrations of gonadotropin and steroid hormones should be determined to rule out endocrinopathies.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Azoospermic ejaculates—alkaline phosphatase concentration should be >5,000 U/L in complete ejaculates.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rapid slide agglutination test (brucellosis)— used as a screening test, recommend recheck of dogs with positive slide test with agar gel immunodiffusion test or other listed methods (see Brucellosis).",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Ultrasonography—to visualize abnormalities in testes or scrotum that may promote abnormal spermatogenesis.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Semen morphology (bright-field microscopy)—eosin–nigrosin stain or modified Giemsa stain; a minimum of 100 (preferably 200) sperm cells are counted under oil immersion (100× objective).",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acrosome staining—acrosomal damage can be evaluated by Coomassie Brilliant blue staining or Spermac stain.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Wet-mount semen morphology (phase contrast or differential interference contrast light microscopy)—samples diluted with formalin phosphate-buffered saline solution; verifies if presence of kinked or coiled tails on a stained slide is due to staining artifact.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Biopsy—reveals spermatogenic capability of testicle; absence of spermatids or spermatocytes confirms impaired spermatogenesis.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inflammation—peritubular lymphocytic accumulation.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Degenerative changes.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypoplasia.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neoplasia.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Unilateral orchiectomy for unilateral testicular tumors or severe orchitis.",
          "pdf_page": 1355,
          "printed_page": 1273,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Sexual rest for edema or hematocele associated with trauma.",
          "pdf_page": 1355,
          "printed_page": 1273,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "If inciting cause was transient and has resolved, semen collection may “improve” individual ejaculate quality by depleting affected sperm cells.",
          "pdf_page": 1355,
          "printed_page": 1273,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Adjust environment and avoid exercise/competitive events that may induce heat stress in the 2 months leading up to when optimal semen quality is needed for breeding or processing.",
          "pdf_page": 1355,
          "printed_page": 1273,
          "column": 3
        }
      ],
