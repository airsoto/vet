          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Congenital",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Canine fucosidosis—rare lysosomal storage",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Congenital"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "disorder (α-l-fucosidase deficiency); acroso-",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Congenital"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "mal defects, proximal droplets, bent tails;",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Congenital"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "autosomal recessive inheritance in English",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Congenital"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "springer spaniels.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Congenital"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary ciliary dyskinesia—ultrastructural",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Congenital"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "abnormality of cilia causing absent or",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Congenital"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "abnormal motility of ciliated cells; affected",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Congenital"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "animals are infertile; probably autosomal",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Congenital"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "recessive inheritance.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Congenital"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Idiopathic.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Congenital"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Testicular hypoplasia.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Congenital"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inbreeding.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Congenital"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Acquired",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Conditions disrupting normal testicular",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Acquired"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "thermoregulation—trauma, hematocele,",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Acquired"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hydrocele, orchitis, epididymitis, fever,",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Acquired"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "obesity (increased scrotal fat), high environ-",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Acquired"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "mental temperatures, exercise-induced heat",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Acquired"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "exhaustion.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Acquired"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infections of the reproductive tract.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Acquired"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Overuse.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Acquired"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Testicular neoplasia.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Acquired"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Testicular degeneration.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Acquired"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prolonged sexual abstinence.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Acquired"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Drugs—anabolic steroids, androgens,",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Acquired"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "estrogen, progestogens, corticosteroids,",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Acquired"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "ketoconazole, amphotericin B, cimetidine,",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Acquired"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "phytoestrogen, gonadotropin-releasing",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1,
              "subheading": "Acquired"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hormone antagonists, intratesticular",
              "pdf_page": 1355,
