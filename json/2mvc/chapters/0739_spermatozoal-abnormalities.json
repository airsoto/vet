      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "In cases from reversible causes, a complete improvement in sperm morphology will not occur before 70 days (approximate length of a complete spermatogenic cycle).",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "After an underlying cause is identified and treated, a semen evaluation performed at 70 days will provide an indication as to longterm expectations for semen quality.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 3
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Climate-controlled environment for animals not adapted to high environmental temperatures.",
