    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Excessive kinked or coiled tails may be iatrogenic, caused by morphology stain; reexamine the sample under phase contrast microscopy after dilution with formalin phosphate-buffered saline solution.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 2
            }
          ]
        },
