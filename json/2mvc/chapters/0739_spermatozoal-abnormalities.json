      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Teratozoospermia—sperm abnormalities of ≥40% in the ejaculate (i.e., low percentage of morphologically normal sperm).",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "High percentage of sperm abnormalities may affect fertility.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Some fertile cats inherently have ≥40% abnormalities.",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sperm abnormalities may also be classified as primary (those occurring during spermatogenesis) or secondary (those occurring during epididymal storage and transport or from inappropriate semen handling).",
              "pdf_page": 1355,
              "printed_page": 1273,
              "column": 1
            }
          ]
        },
