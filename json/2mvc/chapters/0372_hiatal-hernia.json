      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Herniation of abdominal contents (most commonly the stomach) cranial to the diaphragm into the thorax through the esophageal hiatus. Four types have been described:",
              "pdf_page": 728,
              "printed_page": 646,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Type I (sliding; most common).",
              "pdf_page": 728,
              "printed_page": 646,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Type II (paraesophageal).",
              "pdf_page": 728,
              "printed_page": 646,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Type III (includes elements of both types",
              "pdf_page": 728,
              "printed_page": 646,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "I and II).",
              "pdf_page": 728,
              "printed_page": 646,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Type IV (herniation of organs other than",
              "pdf_page": 728,
              "printed_page": 646,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "the stomach).",
              "pdf_page": 728,
              "printed_page": 646,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May be congenital or acquired—acquired most commonly associated with upper respiratory disease (brachycephalic syndrome, laryngeal paralysis).",
              "pdf_page": 728,
              "printed_page": 646,
              "column": 1
            }
          ]
        },
