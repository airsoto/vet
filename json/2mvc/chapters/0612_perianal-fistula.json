    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cyclosporine (CsA) ± ketoconazole is treatment of choice but is expensive. Ketaconazole reduces dose of cyclosporine required by inhibiting CsA-metabolizing",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "enzymes:",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Give CsA orally at 1–5 mg/kg/day",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "PO and ketoconazole at 5–10 mg/kg/day PO and then taper CsA as clinical signs resolve.",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Continue treatment at least 4 weeks after",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "complete resolution of fistula(e). Many patients require chronic treatment at reduced",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "frequency to prevent recurrence.",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tacrolimus (0.1% ointment) topically as maintenance therapy may be sufficient to control lesions; begin application as dose of oral medications is",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "reduced:",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Apply q12h with gloved hand, then",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "taper to q24–72h.",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Oral prednisone and topical tacrolimus appears to be efficacious and",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "economical in less severe cases:",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Prednisone 2",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "mg/kg PO q24h for 2 weeks, decrease to 1 mg/kg q24h for 4 weeks and then 1 mg/kg q48h",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "for 10 weeks.",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Tacrolimus 0.1% ointment as",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "above.",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Chronic maintenance therapy with",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "tacrolimus and possibly prednisone likely necessary for long-term control.",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Azathioprine alone or combined with prednisone is another treatment option.",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 2
            }
          ]
        },
