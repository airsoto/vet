        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Multifactorial immune-mediated",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "mechanism is suspected.",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Appears to be an inappropriate T-cell mediated response.",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "An association with colitis has also been proposed, particularly in German shepherd",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "dogs.",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "A genetic predisposition has been",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "proposed but not proven.",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Low tail carriage and a broad-based tail may contribute in German shepherd dogs.",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "High density of apocrine sweat glands in the cutaneous zone of the anal canal of German shepherd dogs.",
              "pdf_page": 1139,
              "printed_page": 1057,
              "column": 1
            }
          ]
        }
      }
    },
