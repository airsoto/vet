    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Outpatient medical therapy recommended",
          "pdf_page": 1139,
          "printed_page": 1057,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "initially in all cases.",
          "pdf_page": 1139,
          "printed_page": 1057,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Clipping and cleaning the perianal area facilitates local therapy.",
          "pdf_page": 1139,
          "printed_page": 1057,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Bathing with an antimicrobial shampoo may",
          "pdf_page": 1139,
          "printed_page": 1057,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "be helpful.",
          "pdf_page": 1139,
          "printed_page": 1057,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Dietary modification—strictly enforced hydrolyzed or novel protein",
          "pdf_page": 1139,
          "printed_page": 1057,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "elimination diet.",
          "pdf_page": 1139,
          "printed_page": 1057,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Stool softeners—with pain",
          "pdf_page": 1139,
          "printed_page": 1057,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "or tenesmus.",
          "pdf_page": 1139,
          "printed_page": 1057,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgery is considered for patients with incomplete resolution following",
          "pdf_page": 1139,
          "printed_page": 1057,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "appropriate medical therapy.",
          "pdf_page": 1139,
          "printed_page": 1057,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Anal sacculectomy—if anal sac involvement.",
          "pdf_page": 1139,
          "printed_page": 1057,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgical options—resection of inflammatory tissue and/or ablation of remaining sinuses with carbon dioxide laser is preferred.",
          "pdf_page": 1139,
          "printed_page": 1057,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgical debridement (deroofing) with fulguration by chemical cautery or electrocautery; surgical resection followed by primary closure or second intention healing are",
          "pdf_page": 1139,
          "printed_page": 1057,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "other options.",
          "pdf_page": 1139,
          "printed_page": 1057,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Radical excision of the rectal ring with modified rectal pull-through is rarely necessary and is associated with a higher risk of fecal incontinence.",
          "pdf_page": 1139,
          "printed_page": 1057,
          "column": 2
        }
      ],
