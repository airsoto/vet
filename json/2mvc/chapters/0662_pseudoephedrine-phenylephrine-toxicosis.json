    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "paragraph",
          "level": 0,
          "text": "μg/kg IM; xylazine 0.44 mg/kg IM;",
          "pdf_page": 1226,
          "printed_page": 1144,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Manage severe or life-threatening signs first. hydromorphone 0.1 mg/kg SC.",
          "pdf_page": 1226,
          "printed_page": 1144,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Control CNS stimulation, then manage",
          "pdf_page": 1226,
          "printed_page": 1144,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Activated charcoal 1–3 g/kg suspended in cardiovascular (CV) stimulation, as blood 50–200 mL of water. pressure and heart rate may decrease significantly once CNS signs are managed.",
          "pdf_page": 1226,
          "printed_page": 1144,
          "column": 2
        },
        {
          "type": "subheading",
          "level": 0,
          "text": "CONTRAINDICATIONS/POSSIBLE",
          "pdf_page": 1226,
          "printed_page": 1144,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "For seizures, use propofol, pentobarbital, or",
          "pdf_page": 1226,
          "printed_page": 1144,
          "column": 2,
          "subheading": "CONTRAINDICATIONS/POSSIBLE"
        },
        {
          "type": "subheading",
          "level": 0,
          "text": "INTERACTIONS",
          "pdf_page": 1226,
          "printed_page": 1144,
          "column": 2
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "phenobarbital; consider gas anesthetic for",
          "pdf_page": 1226,
          "printed_page": 1144,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "The use of diazepam to control CNS",
          "pdf_page": 1226,
          "printed_page": 1144,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "refractory cases.",
          "pdf_page": 1226,
          "printed_page": 1144,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "stimulation should be avoided, as diazepam",
          "pdf_page": 1226,
          "printed_page": 1144,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "For agitation, hyperactivity, or other CNS",
          "pdf_page": 1226,
          "printed_page": 1144,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "may induce a dysphoric effect in these",
          "pdf_page": 1226,
          "printed_page": 1144,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "stimulation, use acepromazine or",
          "pdf_page": 1226,
          "printed_page": 1144,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "patients and worsen the CNS excitation.",
          "pdf_page": 1226,
