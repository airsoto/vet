  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Syndrome resulting from exposure to excessive levels of pseudoephedrine or phenylephrine.",
              "pdf_page": 1226,
              "printed_page": 1144,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Present in various concentrations in a variety of over-the-counter (OTC) cold and allergy products.",
              "pdf_page": 1226,
              "printed_page": 1144,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
        "PATHOPHYSIOLOGY": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": []
        },
        "SYSTEMS AFFECTED": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": []
        },
        "GENETICS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GENETICS",
          "content_blocks": []
        },
        "INCIDENCE/PREVALENCE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "INCIDENCE/PREVALENCE",
          "content_blocks": []
        },
        "GEOGRAPHIC DISTRIBUTION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GEOGRAPHIC DISTRIBUTION",
          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Any species may be affected, but dogs are most commonly involved in accidental overdoses.",
              "pdf_page": 1226,
              "printed_page": 1144,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Mydriasis, panting, hyperthermia, agitation/hyperactivity, tachycardia, hypertension are common. Other signs include vomiting, vocalization, tremors, disorientation, or lethargy.",
              "pdf_page": 1226,
              "printed_page": 1144,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Head-bobbing, sinus arrhythmias, scleral hemorrhage, or seizure-like activity are possible. Acute collapse may follow.",
              "pdf_page": 1226,
              "printed_page": 1144,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Signs of acute intoxication may persist 1–3 days, depending on dose ingested.",
              "pdf_page": 1226,
              "printed_page": 1144,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Severe cases may progress to disseminated intravascular coagulation (DIC), myoglobin uremia/uria with secondary renal injury, or permanent CNS dysfunction.",
              "pdf_page": 1226,
              "printed_page": 1144,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Pseudoephedrine is a synthetic salt of ephedrine and is an indirect sympatho mimetic amine.",
              "pdf_page": 1226,
              "printed_page": 1144,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Phenylephrine is a synthetic sympathomimetic amine chemically related to ephedrine and pseudoephedrine. Phenylephrine has poor oral bioavailability and generally will have less severe cardio vascular effects than pseudoephedrine.",
              "pdf_page": 1226,
              "printed_page": 1144,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pseudoephedrine indirectly stimulates alpha- and, to a lesser degree, beta-adrenergic receptors.",
              "pdf_page": 1226,
              "printed_page": 1144,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pseudoephedrine dosages >1 mg/kg can result in agitation, hyperactivity, and panting.",
              "pdf_page": 1226,
              "printed_page": 1144,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Phenylephrine dosages >3–4 mg/kg may cause vomiting, lethargy or hyperactivity, hypertension, and tachycardia.",
              "pdf_page": 1226,
              "printed_page": 1144,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Head-bobbing, DIC, or myoglobinuria indicate serious intoxication and a more guarded prognosis.",
              "pdf_page": 1226,
              "printed_page": 1144,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Other CNS stimulants and sympathomimetics—amphetamines, cocaine,",
              "pdf_page": 1226,
              "printed_page": 1144,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "serotonergic antidepressants, phenylprop",
              "pdf_page": 1226,
              "printed_page": 1144,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acepromazine 0.05–1.0 mg/kg IM or IV; anolamine, methylxanthines, ephedra. start low and titrate up as needed.",
              "pdf_page": 1226,
              "printed_page": 1144,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chlorpromazine 0.5–1.0 mg/kg IV or IM;",
              "pdf_page": 1226,
              "printed_page": 1144,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "start low and titrate up as needed.",
              "pdf_page": 1226,
              "printed_page": 1144,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No specific clinical pathology alterations are",
              "pdf_page": 1226,
              "printed_page": 1144,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cyproheptadine 1.1 mg/kg PO or per expected in most cases. rectum q6h (dogs); 2–4 mg PO or per rectum",
              "pdf_page": 1226,
              "printed_page": 1144,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In severe cases DIC, myoglobinemia, (cats). myoglobinuria, or azotemia may occur.",
              "pdf_page": 1226,
              "printed_page": 1144,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Propranolol 0.02–0.06 mg/kg IV q6–8h",
              "pdf_page": 1226,
              "printed_page": 1144,
              "column": 2
            }
          ]
        },
