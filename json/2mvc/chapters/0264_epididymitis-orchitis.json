    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "IfB. canisis diagnosed, removal of affected testicle(s) is strongly recommended due to",
              "pdf_page": 535,
              "printed_page": 453,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "zoonotic potential.",
              "pdf_page": 535,
              "printed_page": 453,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If infection present, antibiotic choice should be based on culture and sensitivity if available; broad-spectrum antibiotics (e.g., ampicillin sulbactam 22–30 mg/kg IV q8h) may be administered",
              "pdf_page": 535,
              "printed_page": 453,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "until cultures are available.",
              "pdf_page": 535,
              "printed_page": 453,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If attempting to",
              "pdf_page": 535,
              "printed_page": 453,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "treatB. canis, combined antibiotic regimes",
              "pdf_page": 535,
              "printed_page": 453,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "generally more successful; treatments may fail",
              "pdf_page": 535,
              "printed_page": 453,
              "column": 2,
              "subheading": "treatB. canis, combined antibiotic regimes"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "to completely clear infection.",
              "pdf_page": 535,
              "printed_page": 453,
              "column": 2,
              "subheading": "treatB. canis, combined antibiotic regimes"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reported",
              "pdf_page": 535,
              "printed_page": 453,
              "column": 2,
              "subheading": "treatB. canis, combined antibiotic regimes"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "success with doxycycline (10 mg/kg PO",
              "pdf_page": 535,
              "printed_page": 453,
              "column": 2,
              "subheading": "treatB. canis, combined antibiotic regimes"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "q12h), gentamicin (5 mg/kg SC q24h for 7",
              "pdf_page": 535,
              "printed_page": 453,
              "column": 2,
              "subheading": "treatB. canis, combined antibiotic regimes"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "days and repeated every 3 weeks), rifampin",
              "pdf_page": 535,
              "printed_page": 453,
              "column": 2,
              "subheading": "treatB. canis, combined antibiotic regimes"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(5 mg/kg PO q24h), or enrofloxacin (5 mg/",
              "pdf_page": 535,
              "printed_page": 453,
              "column": 2,
              "subheading": "treatB. canis, combined antibiotic regimes"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "kg PO q12h) for 1–3 months.",
              "pdf_page": 535,
              "printed_page": 453,
              "column": 2,
              "subheading": "treatB. canis, combined antibiotic regimes"
            }
          ]
        },
