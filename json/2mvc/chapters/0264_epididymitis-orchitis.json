    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Prognosis for fertility—guarded to poor,",
          "pdf_page": 535,
          "printed_page": 453,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "especially with bilateral orchitis.",
          "pdf_page": 535,
          "printed_page": 453,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Testicular degeneration of remaining contralateral testis may occur due to elevated intrascrotal temperature (inflammation), even following",
          "pdf_page": 535,
          "printed_page": 453,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "unilateral castration.",
          "pdf_page": 535,
          "printed_page": 453,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Trauma or inflammation can cause obstruction of efferent tubules or epididymal duct, leading to spermatocele or",
          "pdf_page": 535,
          "printed_page": 453,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "sperm granuloma.",
          "pdf_page": 535,
          "printed_page": 453,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Semen—evaluate characteristics 3 months after treatment for orchitis is completed (dogs).",
          "pdf_page": 535,
          "printed_page": 453,
          "column": 3
        }
      ],
