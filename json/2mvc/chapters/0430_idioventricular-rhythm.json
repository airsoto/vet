        "DEFINITION": {
          "present": true,
          "status": "content",
          "source_heading": "DEFINITION",
          "canonical_heading": "DEFINITION",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "If conduction of sinus node pacemaker impulses to the ventricles is blocked or the impulses decrease in frequency, the lower regions of the heart automatically take over the role of pacemaker for the ventricles, which results in ventricular escape complexes (Figure 1) or an idioventricular rhythm (Figure 2).",
              "pdf_page": 836,
              "printed_page": 754,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "ECG Features",
              "pdf_page": 836,
              "printed_page": 754,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "P waves may be absent or may precede, be",
              "pdf_page": 836,
              "printed_page": 754,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hidden within, or follow the ectopic QRS",
              "pdf_page": 836,
              "printed_page": 754,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "complex.",
              "pdf_page": 836,
              "printed_page": 754,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "P waves are unrelated to the QRS",
              "pdf_page": 836,
              "printed_page": 754,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "complexes.",
              "pdf_page": 836,
              "printed_page": 754,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "QRS configuration—wide and bizarre;",
              "pdf_page": 836,
              "printed_page": 754,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "paragraph",
              "level": 0,
