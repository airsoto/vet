        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—often associated with feline leukemia virus (FeLV) infection.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—usually acquired, but may be inherited.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Breed predilection for inherited cobalamin malabsorption—giant schnauzers, Australian shepherds, Komondorok, and beagles— present as young as 8–12 weeks; border collies as young adults.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Familial macrocytosis and megaloblastic change in toy/miniature poodles.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "In dogs, anemia often not symptomatic. For cobalamin deficiency, clinical signs include gastrointestinal signs and failure to thrive. Affected poodles usually not anemic.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In cats, anemia may be mild to marked, if FeLV positive.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Infectious—FeLV most common cause in cats. Feline immunodeficiency virus (FIV) infrequently reported as causative agent.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nutritional—folic acid and cobalamin deficiencies, primarily in dogs with inherited cobalamin malabsorption (uncommon with other causes of cobalamin deficiency).",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Toxic—many drugs such as immuno modulators, chemotherapeutic agents, anticonvulsants, antibiotics.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Congenital—toy/miniature poodles.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "In dogs, all other mild to moderate nonregenerative anemias, including anemia of inflammatory disease and lead poisoning.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Differentiation based on distinctive CBC and bone marrow findings.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In cats, FeLV infection is primary differential.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Classically, anemia macrocytic and normochromic, but often normocytic.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Large, fully hemoglobinized RBC; few to many nucleated RBC precursors, no polychromasia.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In dogs, mild to moderate anemia; may see neutropenia with hypersegmented neutrophils.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In cats, mild to marked anemia.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In cats with FeLV, anemia may occur with myelodysplastic syndrome or leukemia.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In dogs with inherited cobalamin malabsorption, can see proteinuria and variable biochemistry derangements.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "FeLV in blood and bone marrow.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Genetic tests for dogs with inherited cobalamin malabsorption (available at University of Pennsylvania, PennGen).",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Serum cobalamin.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Methylmalonic acid (MMA) in serum or urine (increase caused by inhibited cobalamindependent enzyme).",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 2
            }
          ]
        },
