    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "In animals with drug toxicity, discontinue offending drug.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In animals with hypocobalaminemia, supplement with vitamin B12(0.25–1 mg cyanocobalamin SC weekly to monthly or hydroxycobalamin IM every few months; oral may be effective in some patients— dogs, 250–1000μg/day PO; cats, 250μg/day PO).",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 3
            }
          ]
        },
