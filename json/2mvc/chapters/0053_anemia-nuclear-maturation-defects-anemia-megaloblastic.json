  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Nonregenerative anemia characterized by impaired DNA synthesis in red blood cell (RBC) precursors (nuclear : cytoplasmic asynchrony).",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affected RBC precursors fail to divide normally and thus are larger than corresponding normal precursors; their nuclei are deficient in chromatin with open and stippled appearance; these giant precursors with atypical nuclei are known as megaloblasts. Hemoglobin content in these precursors is normal.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Asynchronous changes most prominent in RBC precursors, but white blood cell (WBC) and platelet precursors similarly affected.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
