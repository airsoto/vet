        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Bone Marrow Biopsy",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In dogs, usually hyperplastic; may be",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 2,
              "subheading": "Bone Marrow Biopsy"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hypocellular with hemosiderosis.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 2,
              "subheading": "Bone Marrow Biopsy"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In cats, may be hypo- or hyperplastic.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 2,
              "subheading": "Bone Marrow Biopsy"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Maturation arrest with nuclear : cytoplasmic",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 2,
              "subheading": "Bone Marrow Biopsy"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "asynchrony possible in all cell lines.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 2,
              "subheading": "Bone Marrow Biopsy"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Megaloblastic RBC precursors.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 2,
              "subheading": "Bone Marrow Biopsy"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Macrophage hyperplasia with phagocytosis",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 2,
              "subheading": "Bone Marrow Biopsy"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "of nucleated RBCs.",
              "pdf_page": 171,
              "printed_page": 89,
              "column": 2,
              "subheading": "Bone Marrow Biopsy"
            }
          ]
        },
