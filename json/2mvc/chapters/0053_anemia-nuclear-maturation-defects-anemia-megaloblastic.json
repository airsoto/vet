    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Monitor response to treatment by CBC (weekly to every few months).",
          "pdf_page": 171,
          "printed_page": 89,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Closely monitor FeLV-positive cats for disease progression.",
          "pdf_page": 171,
          "printed_page": 89,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Prognosis depends on underlying cause; in FeLV-positive cats, prognosis poor; with drug-induced anemia, prognosis good if drug discontinued; inherited cobalamin malabsorption has good prognosis, with lifelong cobalamin supplementation.",
          "pdf_page": 171,
          "printed_page": 89,
          "column": 3
        }
      ],
