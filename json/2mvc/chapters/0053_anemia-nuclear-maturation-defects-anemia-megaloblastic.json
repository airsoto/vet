    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Anemia often mild and does not need specific therapy. FeLV-positive cats may require blood transfusion for stabilization.",
          "pdf_page": 171,
          "printed_page": 89,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Target underlying cause and address concurrent signs.",
          "pdf_page": 171,
          "printed_page": 89,
          "column": 2
        }
      ],
