        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Young dogs (<1 year of age).",
              "pdf_page": 1166,
              "printed_page": 1084,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Miniature dachshunds and cavalier King Charles spaniels (CKCS, worldwide), Pomeranians (in Japan) predisposed (congenital immunodeficiencies).",
              "pdf_page": 1166,
              "printed_page": 1084,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Progressive respiratory difficulty (weeks",
              "pdf_page": 1166,
              "printed_page": 1084,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "to months).",
              "pdf_page": 1166,
              "printed_page": 1084,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dyspnea and tachypnea,",
              "pdf_page": 1166,
              "printed_page": 1084,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "cyanosis.",
              "pdf_page": 1166,
              "printed_page": 1084,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exercise intolerance.",
              "pdf_page": 1166,
              "printed_page": 1084,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cough.",
              "pdf_page": 1166,
              "printed_page": 1084,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fever uncommon.",
              "pdf_page": 1166,
              "printed_page": 1084,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inappetence, weight",
              "pdf_page": 1166,
              "printed_page": 1084,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "loss, and thin body condition.",
              "pdf_page": 1166,
              "printed_page": 1084,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Some dogs have concurrent generalized demodicosis.",
              "pdf_page": 1166,
              "printed_page": 1084,
              "column": 1
            }
          ]
        },
