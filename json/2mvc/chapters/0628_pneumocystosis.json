        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Spread by airborne droplets. Neonates may",
              "pdf_page": 1166,
              "printed_page": 1084,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "be infected at birth.",
              "pdf_page": 1166,
              "printed_page": 1084,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Congenital or acquired immunodeficiency predisposes to develop",
              "pdf_page": 1166,
              "printed_page": 1084,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "ment of clinical disease:",
              "pdf_page": 1166,
              "printed_page": 1084,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Severe immuno",
              "pdf_page": 1166,
              "printed_page": 1084,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "suppression—deficiency of IgA, IgG, IgM in dachshunds; immunoglobulin deficiency and decreased lymphocyte function in CKCS.",
              "pdf_page": 1166,
              "printed_page": 1084,
              "column": 1
            }
          ]
        }
      }
    },
