    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Treat CHF and correct any electrolyte or acid/base imbalances.",
              "pdf_page": 222,
              "printed_page": 140,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Dogs",
              "pdf_page": 222,
              "printed_page": 140,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Digoxin (0.005–0.01 mg/kg PO q12h,",
              "pdf_page": 222,
              "printed_page": 140,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "maintenance dosage), diltiazem (0.5–1.5 mg/",
              "pdf_page": 222,
              "printed_page": 140,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "kg PO q8h), or atenolol (0.25–1 mg/kg PO",
              "pdf_page": 222,
              "printed_page": 140,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "q12h) are used to treat clinically significant",
              "pdf_page": 222,
              "printed_page": 140,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "arrhythmias.",
              "pdf_page": 222,
              "printed_page": 140,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Digoxin—treatment of",
              "pdf_page": 222,
              "printed_page": 140,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "choice.",
              "pdf_page": 222,
              "printed_page": 140,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CHF is treated with appropriate",
              "pdf_page": 222,
              "printed_page": 140,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "dosage of diuretic, angiotensin-converting",
              "pdf_page": 222,
              "printed_page": 140,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "enzyme inhibitor, and pimobendan; approp-",
              "pdf_page": 222,
              "printed_page": 140,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "riate management of CHF may reduce APC",
              "pdf_page": 222,
              "printed_page": 140,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "frequency.",
              "pdf_page": 222,
              "printed_page": 140,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Cats",
              "pdf_page": 222,
              "printed_page": 140,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats with hypertrophic cardiomyopathy—",
              "pdf_page": 222,
              "printed_page": 140,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "diltiazem (1–2.5 mg/kg PO q8h) or atenolol",
              "pdf_page": 222,
              "printed_page": 140,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "(6.25–12.5 mg PO q12–24h).",
              "pdf_page": 222,
              "printed_page": 140,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats",
              "pdf_page": 222,
              "printed_page": 140,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "with dilated cardiomyopathy—digoxin",
              "pdf_page": 222,
              "printed_page": 140,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(one-fourth of a 0.125 mg digoxin tablet",
              "pdf_page": 222,
              "printed_page": 140,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "q24h or q48h).",
              "pdf_page": 222,
              "printed_page": 140,
              "column": 1,
              "subheading": "Cats"
            }
          ]
        },
