        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Virtually never causes clinical signs.",
              "pdf_page": 230,
              "printed_page": 148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May become a more severe atrioventricular (AV) conduction disturbance in some animals.",
              "pdf_page": 230,
              "printed_page": 148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Normally the PR interval tends to shorten with rapid heart rates.",
              "pdf_page": 230,
              "printed_page": 148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May be the result of intra-atrial conduction delay (prolongation of the PA interval on surface ECG and simultaneous His bundle electrogram) or delay of conduction within the AV node itself (prolongation of the AH interval on His bundle electrogram).",
              "pdf_page": 230,
              "printed_page": 148,
              "column": 1
            }
          ]
        },
