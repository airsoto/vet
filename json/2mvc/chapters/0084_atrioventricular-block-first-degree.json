          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Avoid hypokalemia—increases sensitivity to vagal tone; may potentiate AV conduction delay.",
              "pdf_page": 231,
              "printed_page": 149,
              "column": 1
