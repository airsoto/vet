        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Pao2—normal.",
              "pdf_page": 1188,
              "printed_page": 1106,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Serum erythropoietin concentrations are usually low to zero and often overlap with those reported for other causes of polycythemia.",
              "pdf_page": 1188,
              "printed_page": 1106,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytologic examination of bone marrow and core biopsy, in parallel with peripheral blood count analysis.",
              "pdf_page": 1188,
              "printed_page": 1106,
              "column": 1
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Radiography—assess kidneys and cardio pulmonary system.",
              "pdf_page": 1188,
              "printed_page": 1106,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal ultrasonography—assess Weiss DJ, Aird B. Cytologic evaluation of kidneys and adrenal glands.",
              "pdf_page": 1188,
              "printed_page": 1106,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Echocardiography—evaluate for right-toleft cardiac shunts.",
              "pdf_page": 1188,
              "printed_page": 1106,
              "column": 2
            }
          ]
        },
