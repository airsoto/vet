    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Depression.",
          "pdf_page": 1188,
          "printed_page": 1106,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Anorexia.",
          "pdf_page": 1188,
          "printed_page": 1106,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Weakness.",
          "pdf_page": 1188,
          "printed_page": 1106,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Polydipsia and polyuria.",
          "pdf_page": 1188,
          "printed_page": 1106,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Erythema of skin and mucous membranes.",
          "pdf_page": 1188,
          "printed_page": 1106,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Dilated and tortuous retinal blood vessels.",
          "pdf_page": 1188,
          "printed_page": 1106,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Uveitis.",
          "pdf_page": 1188,
          "printed_page": 1106,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Acute blindness.",
          "pdf_page": 1188,
          "printed_page": 1106,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Splenomegaly and hepatomegaly uncommon. Diagnostic tests should exclude all other conditions that may lead to increased packed cell volume (PCV) and RBC mass.",
          "pdf_page": 1188,
          "printed_page": 1106,
          "column": 1
        }
      ],
      "subsections": {
