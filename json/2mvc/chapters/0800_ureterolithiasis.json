    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Medical dissolution is only effective for struvite ureteroliths when combined with",
              "pdf_page": 1445,
              "printed_page": 1363,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "ureteral stent placement. Medical dissolution requires culture-guided antibiotics and dissolution diet.",
              "pdf_page": 1446,
              "printed_page": 1364,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Therapy aimed at prevention of recurrent disease is imperative following relief of obstruction.",
              "pdf_page": 1446,
              "printed_page": 1364,
              "column": 1
            }
          ]
        },
