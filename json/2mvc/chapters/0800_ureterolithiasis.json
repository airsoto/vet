        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog and cat.",
              "pdf_page": 1445,
              "printed_page": 1363,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Breed, age, and sex predispositions vary with type of ureterolith.",
              "pdf_page": 1445,
              "printed_page": 1363,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "May be asymptomatic initially.",
              "pdf_page": 1445,
              "printed_page": 1363,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pain (ureteral colic) during passage of ureteroliths or acute ureteral obstruction.",
              "pdf_page": 1445,
              "printed_page": 1363,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Renomegaly if obstruction leads to hydronephrosis.",
              "pdf_page": 1445,
              "printed_page": 1363,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "“Big kidney, little kidney syndrome”— obstruction of one ureter has previously occurred, resulting in a shrunken end-stage kidney; signs of uremia and renomegaly occur due to obstruction of the remaining functional kidney.",
              "pdf_page": 1445,
              "printed_page": 1363,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Unilateral ureteral obstruction results in azotemia and uremic clinical signs only when the contralateral kidney has reduced function.",
              "pdf_page": 1445,
              "printed_page": 1363,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Signs referable to a lower urinary tract infection (UTI) or septicemia may be present with ureterolithiasis.",
              "pdf_page": 1445,
              "printed_page": 1363,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ureteral rupture may occur, resulting in urine accumulation in the retroperitoneum.",
              "pdf_page": 1445,
              "printed_page": 1363,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats with distal ureteral obstruction may have signs of dysuria and pollakiuria.",
              "pdf_page": 1445,
              "printed_page": 1363,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "For a list of causes, see chapters on each urolith type.",
              "pdf_page": 1445,
              "printed_page": 1363,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most ureteroliths are calcium oxalate. Dogs may form struvite nephroliths and subsequent ureteroliths from urease-producing bacterial UTI. Cats may have ureteroliths composed of dried solidified blood clots.",
              "pdf_page": 1445,
              "printed_page": 1363,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Circumcaval ureters (more commonly in right ureter) may predispose cats to obstruction by ureteroliths and secondary ureteral stricture formation.",
              "pdf_page": 1445,
              "printed_page": 1363,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prior treatment of nephroliths by extra corporeal shock wave lithotripsy (ESWL) or medical dissolution may be additional risk factors.",
              "pdf_page": 1445,
              "printed_page": 1363,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Consider in cases of acute kidney injury (AKI), rapid progression of chronic kidney",
              "pdf_page": 1445,
              "printed_page": 1363,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "disease (CKD), renomegaly, abdominal pain, or fluid accumulation in the retroperitoneal space. Obstruction to urine outflow of both kidneys may not produce the same magnitude of renomegaly as unilateral obstruction because the patient may succumb to uremic complications before severe dilation occurs.",
              "pdf_page": 1445,
              "printed_page": 1363,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Radiopacities detected by abdominal radiography that may be confused with ureteroliths include fecal material in the colon, nipples, peritoneoliths, calcified lymph nodes, and mineralization of the renal pelvis.",
              "pdf_page": 1445,
              "printed_page": 1363,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Radiolucent ureteroliths may be difficult to differentiate from blood clots. Other causes of ureteral obstruction include intraluminal tumors, ureteroceles, ureteral strictures, and extraluminal compression. Hydroureter and hydronephrosis may occur because of ureteral ectopia, pyelonephritis, ureterovesical stenosis, and obstruction of the ureteral opening at the trigone (most commonly due to urothelial carcinoma).",
              "pdf_page": 1445,
              "printed_page": 1363,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "CBC in patients with pyonephrosis secondary to obstructive ureteroliths may have leukocytosis, immature neutrophilia, and thrombocytopenia. Ionized calcium concentration, urinalysis, and urinary excretion of electrolytes may permit estimation of urolith composition pending results of definitive analysis.",
              "pdf_page": 1445,
              "printed_page": 1363,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Submit all retrieved ureteroliths for quantitative analysis to determine appropriate preventive strategies.",
              "pdf_page": 1445,
              "printed_page": 1363,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Blood pressure should be monitored; hypertension is common with CKD or AKI secondary to ureteral obstruction.",
              "pdf_page": 1445,
              "printed_page": 1363,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Radiography—radiopaque ureteroliths may be visualized. If obstruction and hydronephrosis have occurred, renomegaly may be apparent. If ureteral rupture occurs, contrast in the retroperitoneal space may be lost. Small ureteroliths may not be visualized.",
              "pdf_page": 1445,
              "printed_page": 1363,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ultrasonography—valuable for detecting hydronephrosis or hydroureter. Changes suggesting pyelonephritis may also be detected by ultrasound. The dilated proximal ureter may be traced to the ureteroliths. Ureteroliths are not observed ultrasono graphically in up to 25% of cats with ureteroliths. Ultrasound-guided pyelocentesis can be used to confirm ureteral obstruction, although this is usually performed during surgical placement of subcutaneous ureteral bypass (SUB) or ureteral stents.",
              "pdf_page": 1445,
              "printed_page": 1363,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CT before and after IV contrast can be used to confirm obstructive ureteroliths if they are suspected but not confirmed by other imaging modalities. This is not required for surgical planning for SUB or stent placement.",
              "pdf_page": 1445,
              "printed_page": 1363,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Nuclear scintigraphy alone should not be used to determine whether or not to preserve or surgically remove a kidney.",
              "pdf_page": 1445,
              "printed_page": 1363,
              "column": 3
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Progressive dilation of the pelvis and calyces; in advanced cases, the kidney may be transformed into a thin-walled sac with only shell of atrophic cortical parenchyma; ureteral dilation proximal to the site of obstruction is often present.",
              "pdf_page": 1445,
              "printed_page": 1363,
              "column": 3
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "For small nonobstructive ureteroliths, allowing time for the ureteroliths to spontaneously pass down the ureter to the bladder may eliminate the need for intervention.",
          "pdf_page": 1445,
          "printed_page": 1363,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Remove or bypass ureteroliths that are causing obstruction.",
          "pdf_page": 1445,
          "printed_page": 1363,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Ureteroliths in dogs have been successfully treated with ESWL. Efficiency of ESWL fragmentation of ureteroliths is improved with prior ureteral stent placement. Calcium oxalate uroliths from cats are intrinsically resistant to fragmentation via ESWL. ESWL is not recommended for cats.",
          "pdf_page": 1445,
          "printed_page": 1363,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgical techniques recommended for removal of ureteroliths vary, depending on the site of obstruction, species, the presence or absence of UTI, and the degree of function of the associated kidney.",
          "pdf_page": 1445,
          "printed_page": 1363,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "SUB placement is effective for relief of ureteral obstruction in cats and is often the preferred surgical procedure for cats.",
          "pdf_page": 1445,
          "printed_page": 1363,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Ureteroneocystotomy may be performed for ureteroliths in the middle and distal ureter: the ureter proximal to the obstruction is excised and reimplanted into the bladder. Ureteroliths in the proximal ureter may be removed by ureterotomy. Performance of ureterotomy or ureteroneocystotomy in cats requires microsurgical expertise. When the contralateral kidney functions normally and severe end-stage hydronephrosis is present, ureteronephrectomy may be appropriate.",
          "pdf_page": 1445,
          "printed_page": 1363,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Ureteral stent placement to bypass obstructive ureteroliths relieves the obstruction and causes passive ureteral dilation. Ureteral stents may be placed endoscopically in dogs and surgically in dogs and cats. Ureteral stent combined with medical dissolution effectively resolves struvite ureteroliths in dogs.",
          "pdf_page": 1445,
          "printed_page": 1363,
          "column": 3
        }
      ],
