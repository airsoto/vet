    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Following SUB placement, routine sampling of the SUB for urinalysis and culture along with flushing the SUB is performed every 3 months.",
              "pdf_page": 1446,
              "printed_page": 1364,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Instillation of tetra-EDTA solution into the SUB is recommended with SUB flushes.",
              "pdf_page": 1446,
              "printed_page": 1364,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Following successful removal of ureteroliths, recheck every 3–6 months for recurrence of uroliths and to ensure owner compliance with preventive measures; urinalysis, imaging, and urine culture.",
              "pdf_page": 1446,
              "printed_page": 1364,
              "column": 1
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "SUB = subcutaneous ureteral bypass.",
              "pdf_page": 1446,
              "printed_page": 1364,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Elimination of predisposing factors.",
              "pdf_page": 1446,
              "printed_page": 1364,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "UTI = urinary tract infection.",
              "pdf_page": 1446,
              "printed_page": 1364,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Specific therapy depends on the mineral",
              "pdf_page": 1446,
              "printed_page": 1364,
              "column": 2
            }
          ]
        },
