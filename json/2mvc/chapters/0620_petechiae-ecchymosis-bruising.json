            {
              "type": "bullet",
              "level": 0,
              "text": "Geography/travel history (susceptibility to tick-borne disease).",
              "pdf_page": 1154,
              "printed_page": 1072,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Certain drug exposures (e.g., sulfa-containing",
              "pdf_page": 1154,
              "printed_page": 1072,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Minimize activity to reduce the risk of trauma. antimicrobials).",
              "pdf_page": 1154,
              "printed_page": 1072,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Discontinue any medications that may alter platelet function (e.g., NSAIDs).",
              "pdf_page": 1154,
              "printed_page": 1072,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Discontinue medications that might be associated with ITP.",
              "pdf_page": 1154,
              "printed_page": 1072,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Avoid jugular venipuncture.",
              "pdf_page": 1154,
              "printed_page": 1072,
              "column": 2
            }
          ]
        },
