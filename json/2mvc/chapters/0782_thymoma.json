      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Prednisone 20 mg/m2PO q48h and cyclophosphamide 50–100 mg/m2PO",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "q48h—used in a very limited number of patients, two of which had a partial remission likely associated with lymphodepleting effects.",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Myasthenia gravis—treat with prednisone and anticholinesterase drugs until the tumor can be removed.",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 3
            }
          ]
        },
