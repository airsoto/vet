    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Inpatient.",
          "pdf_page": 1417,
          "printed_page": 1335,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgical excision—treatment of choice, and possible in 70% of cases; use an intercostal approach for small masses and a sternotomy",
          "pdf_page": 1417,
          "printed_page": 1335,
          "column": 2
        },
        {
          "type": "subheading",
          "level": 0,
          "text": "for large masses. Recurrence~17%, median",
          "pdf_page": 1417,
          "printed_page": 1335,
          "column": 2
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "survival time 635 days overall not considering",
          "pdf_page": 1417,
          "printed_page": 1335,
          "column": 2,
          "subheading": "for large masses. Recurrence~17%, median"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "prognostic factors (compared to 76 days",
          "pdf_page": 1417,
          "printed_page": 1335,
          "column": 2,
          "subheading": "for large masses. Recurrence~17%, median"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "without surgery).",
          "pdf_page": 1417,
          "printed_page": 1335,
          "column": 2,
          "subheading": "for large masses. Recurrence~17%, median"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Dogs with myasthenia gravis and aspiration",
          "pdf_page": 1417,
          "printed_page": 1335,
          "column": 2,
          "subheading": "for large masses. Recurrence~17%, median"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "pneumonia have a poorer prognosis with",
          "pdf_page": 1417,
          "printed_page": 1335,
          "column": 2,
          "subheading": "for large masses. Recurrence~17%, median"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "surgery. Myasthenia gravis and megaesopha-",
          "pdf_page": 1417,
          "printed_page": 1335,
          "column": 2,
          "subheading": "for large masses. Recurrence~17%, median"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "gus are not necessarily poor prognostic",
          "pdf_page": 1417,
          "printed_page": 1335,
          "column": 2,
          "subheading": "for large masses. Recurrence~17%, median"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "factors, but require more intensive husbandry",
          "pdf_page": 1417,
          "printed_page": 1335,
          "column": 2,
          "subheading": "for large masses. Recurrence~17%, median"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "practices.",
          "pdf_page": 1417,
          "printed_page": 1335,
          "column": 2,
          "subheading": "for large masses. Recurrence~17%, median"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Radiotherapy—potentially beneficial by",
          "pdf_page": 1417,
          "printed_page": 1335,
          "column": 2,
          "subheading": "for large masses. Recurrence~17%, median"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "reducing the lymphoid component of the",
          "pdf_page": 1417,
          "printed_page": 1335,
          "column": 2,
          "subheading": "for large masses. Recurrence~17%, median"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "mass (50-75% of cases benefit); median",
          "pdf_page": 1417,
          "printed_page": 1335,
          "column": 2,
          "subheading": "for large masses. Recurrence~17%, median"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "survival time 248 days in dogs (though 75%",
          "pdf_page": 1417,
          "printed_page": 1335,
          "column": 2,
          "subheading": "for large masses. Recurrence~17%, median"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "alive at 1 year in one series) and 720 days in",
          "pdf_page": 1417,
          "printed_page": 1335,
          "column": 2,
          "subheading": "for large masses. Recurrence~17%, median"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "cats. Can be used after surgery if excision",
          "pdf_page": 1417,
          "printed_page": 1335,
          "column": 2,
          "subheading": "for large masses. Recurrence~17%, median"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "incomplete.",
          "pdf_page": 1417,
          "printed_page": 1335,
          "column": 2,
          "subheading": "for large masses. Recurrence~17%, median"
        }
      ],
