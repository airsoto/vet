    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Thoracic radiography—every 3 months; monitor for recurrence.",
          "pdf_page": 1417,
          "printed_page": 1335,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Cure—possible if tumor is surgically resectable; greater than 80% alive at 1 year if resectable and no associated megaesophagus; median survival >1800 days for cats and 800 to >1000 days for dogs; 10–20% recur and may respond favorably to a second surgery.",
          "pdf_page": 1417,
          "printed_page": 1335,
          "column": 3
        },
        {
