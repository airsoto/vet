        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Rare in dog and cat.",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most common in medium- and large-breed dogs (especially Labrador and golden retrievers).",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—mean age 9.5 years.",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—mean age 10 years.",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "From physical presence of tumor— coughing, tachypnea, dyspnea.",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary to obstruction of cranial vena cava—swelling of the head, neck, or forelimbs (dependent edema).",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Paraneoplastic syndromes (hypercalcemia or immune-mediated disease).",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Muscle weakness and megaesophagus caused by myasthenia gravis (~20%), hypercalcemia (causing polyuria/polydipsia), polymyositis, skin disease (especially in cats: exfoliative dermatitis and pemphigus vulgaris), hypergammaglobulinemia.",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Myasthenia gravis most often pre-op in dogs but can develop post-op in cats.",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 1
            }
          ]
        },
