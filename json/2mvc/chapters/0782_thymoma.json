    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Lymphoma (main rule-out).",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Branchial cyst.",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ectopic thyroid carcinoma.",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chemodectoma.",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Various subtypes of sarcoma.",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mesothelioma.",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Non-neoplastic granuloma, abscess, or cyst.",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Lymphocytosis—occasionally (<5%).",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intermittent basophilia—one case report.",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypercalcemia ~30%.",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Antibody titers to acetylcholine receptors to confirm myasthenia gravis.",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ultrasound-guided fine-needle aspiration and cytology of the mass—characterized by",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "small lymphocytes, scattered mast cells, often with plasma cells and up to 60% will have an epithelial population (vs. a pure population of lymphoblasts with lymphoma). Thymomas can be cavitated/cystic, whereas lymphoma is usually homogeneous upon sonographic evaluation.",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Biopsy may be needed to confirm diagnosis and immunohistochemical stains (cytokeratin, lymphocyte CD markers) can be used.",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Flow cytometry of mass aspirate can confirm as a minimally invasive test (usually polyclonal CD4+ and CD8+ whereas lymphoma usually not); consider PCR for antigen receptor rearrangements to rule out lymphoma.",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiography—typically reveals a cranial mediastinal mass with dorsal deviation of the trachea, and may show pleural effusion or megaesophagus.",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CT scan or MRI can be used prior to thoracotomy for surgical planning, though cannot predict ease of resection.",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Tensilon test—evaluate for myasthenia gravis in patients with signs of muscle weakness, dysphagia, or regurgitation.",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
