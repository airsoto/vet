      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Originates from thymic epithelium, rarely metastasizes.",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infiltrated with mature lymphocytes.",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May be associated with paraneoplastic syndromes (myasthenia gravis, hypercalcemia of malignancy).",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Classified as invasive (malignant) or noninvasive (benign).",
              "pdf_page": 1417,
              "printed_page": 1335,
              "column": 1
            }
          ]
        },
