        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Occurs in black and yellow Labrador",
              "pdf_page": 1025,
              "printed_page": 943,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "retrievers.",
              "pdf_page": 1025,
              "printed_page": 943,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Age of onset—variable (6 weeks– 7 months); most commonly recognized at",
              "pdf_page": 1025,
              "printed_page": 943,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "3–4 months.",
              "pdf_page": 1025,
              "printed_page": 943,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affects males and females.",
              "pdf_page": 1025,
              "printed_page": 943,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "A similar inherited CNM has been identified in young male and female Great Danes.",
              "pdf_page": 1025,
              "printed_page": 943,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Severity ranges from stilted gait and exercise intolerance to severe muscle weakness, bunny-hopping pelvic limb gait, ventro flexion of the head and neck, arched back, and abnormal joint posture (cow-hocked",
              "pdf_page": 1025,
              "printed_page": 943,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "stance, hyperextended carpi).",
              "pdf_page": 1025,
              "printed_page": 943,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Worsen with exercise, excitement, and cold weather.",
              "pdf_page": 1025,
              "printed_page": 943,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Patient may collapse with forced exercise.",
              "pdf_page": 1025,
              "printed_page": 943,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Some improvement with rest.",
              "pdf_page": 1025,
              "printed_page": 943,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Generalized",
              "pdf_page": 1025,
              "printed_page": 943,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "muscle atrophy—mild to severe.",
              "pdf_page": 1025,
              "printed_page": 943,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Atrophy of proximal limb and masticatory muscles",
              "pdf_page": 1025,
              "printed_page": 943,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "often most prominent.",
              "pdf_page": 1025,
              "printed_page": 943,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tendon reflexes—",
              "pdf_page": 1025,
              "printed_page": 943,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "normal, hypoactive, or absent.",
              "pdf_page": 1025,
              "printed_page": 943,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Occasionally, patients become recumbent or develop megaesophagus.",
              "pdf_page": 1025,
              "printed_page": 943,
              "column": 1
            }
          ]
        },
