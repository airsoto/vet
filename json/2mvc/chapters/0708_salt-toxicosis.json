    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Antiemetic for vomiting—maropitant 1 mg/kg SC or IV q24h.",
              "pdf_page": 1302,
              "printed_page": 1220,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Proton pump inhibitor if signs of stomach mucosal irritation:",
              "pdf_page": 1302,
              "printed_page": 1220,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Pantoprazole 1 mg/kg IV slowly q24h.",
              "pdf_page": 1302,
              "printed_page": 1220,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Omeprazole 1 mg/kg PO q24h.",
              "pdf_page": 1302,
              "printed_page": 1220,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Methocarbamol 55–220 mg/kg IV slowly, to effect for muscle tremors; do not exceed 330 mg/kg/day.",
              "pdf_page": 1302,
              "printed_page": 1220,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anticonvulsant such as diazepam 0.5–2 mg/kg IV for seizures.",
              "pdf_page": 1302,
              "printed_page": 1220,
              "column": 1
            }
          ]
        },
        "CONTRAINDICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS",
          "canonical_heading": "CONTRAINDICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Neurologic signs should improve with Activated charcoal—will worsen hyperimprovement of Na level. natremia.",
              "pdf_page": 1302,
              "printed_page": 1220,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prognosis is generally good. Guarded to poor prognosis with severe neurologic signs",
              "pdf_page": 1302,
              "printed_page": 1220,
              "column": 2
            }
          ]
        },
        "PRECAUTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "PRECAUTIONS",
          "canonical_heading": "PRECAUTIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "and poor response to treatment.",
              "pdf_page": 1302,
              "printed_page": 1220,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mannitol, hypertonic saline, and sodium bicarbonate should be used with caution as they may worsen hypernatremia.",
              "pdf_page": 1302,
              "printed_page": 1220,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diuretics such as furosemide may be helpful for Na excretion via the kidney but hydration status needs to be monitored carefully.",
              "pdf_page": 1302,
              "printed_page": 1220,
              "column": 2
            }
          ]
        },
