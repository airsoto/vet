        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "CSF sodium concentration can be measured. Normal is 135–150 mEq/L; >180 mEq/L is consistent with salt toxicosis.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiography if respiratory signs to evaluate for hypervolemia and signs of fluid overload and pulmonary edema.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "MRI or CT—evaluate for subarachnoid or cerebral hemorrhage.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "CSF tap for sodium concentration (rarely performed) and rule out other causes for neurologic signs.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
