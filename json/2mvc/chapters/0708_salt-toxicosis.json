              "printed_page": 1219,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cerebral edema, perivascular hemorrhage and fibrinous exudate.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pulmonary edema.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute renal and hepatic necrosis.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3
            }
          ]
        }
      }
    },
