        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Severity of signs is dependent on sodium level.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mild—lethargy, vomiting, diarrhea, polydipsia ± polyuria.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Severe—behavioral changes, twitching, muscle tremors, ataxia, seizures, coma, death.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ingestion of homemade playdough or clay.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Administration of salt as an emetic.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exposure to other forms of salt (i.e., rock",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "salt, baking soda).",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Swimming in the ocean/ingestion of",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "saltwater.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abnormal hydration:",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Dehydration with vomiting and diarrhea.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Overhydration and hypervolemia with",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "saltwater ingestion or secondary to treat-",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "ment.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tachycardia.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ataxia, muscle weakness, muscle tremors.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperreflexia.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
        "CAUSES": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES",
          "canonical_heading": "CAUSES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Salt intake:",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Salt ingestion—table salt, baking soda,",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "salt for water softeners, deicing salt, ocean/saltwater.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Other products made with table salt—",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "homemade or commercial playdough, ornament dough.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Iatrogenic with IV hypertonic saline or",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "IV sodium bicarbonate; sodium phosphate enemas.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Decreased water intake (typically chronic).",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Adipsia.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "No access to water.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Free water loss:",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Mannitol bolus or CRI causes free water",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "loss via kidneys.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Activated charcoal with sorbitol (more",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "common with multidose activated charcoal or high doses) causes free water loss via gastrointestinal tract.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2
            }
          ]
        },
        "RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "RISK FACTORS",
          "canonical_heading": "RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Swimming in oceans and intake of saltwater.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Outdoor pets with frozen or spilled water.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Patients predisposed to dehydration— kidney disease, unregulated diabetes mellitus, central diabetes insipidus, chronic vomiting and diarrhea, hyperthermia/fever.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2
            }
          ]
        },
