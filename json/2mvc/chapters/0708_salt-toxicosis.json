          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypernatremic hyperosmolar nonketotic diabetes, chronic kidney disease, diabetes mellitus.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary neurologic disease.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Toxins that cause neurologic signs: (ethylene glycol, bromethalin, metaldehyde, baclofen, pyrethrins/pyrethroids, organophosphates/carbamates).",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Paintball ingestion",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Biochemistry—hypernatremia, hyperchloremia, azotemia with dehydration, possible elevation of liver enzymes.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
