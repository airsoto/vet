          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Oral water can be offered to lower Na. Water intake should be regulated so that Na level does not drop too rapidly.",
              "pdf_page": 1302,
              "printed_page": 1220,
              "column": 1
            }
          ]
        },
        "CLIENT EDUCATION": {
          "present": true,
          "status": "content",
          "source_heading": "CLIENT EDUCATION",
          "canonical_heading": "CLIENT EDUCATION",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Outdoor pets may be susceptible to decreased intake with frozen or empty water containers or if they become trapped in a garage or shed. Heated water bowls and multiple water sources should be available.",
              "pdf_page": 1302,
              "printed_page": 1220,
              "column": 1
            }
          ]
        },
        "SURGICAL CONSIDERATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "SURGICAL CONSIDERATIONS",
          "canonical_heading": "SURGICAL CONSIDERATIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Gastrotomy may be needed to remove homemade playdough or ornament dough if unable to remove with emesis or gastric lavage.",
              "pdf_page": 1302,
              "printed_page": 1220,
              "column": 1
            }
          ]
        },
