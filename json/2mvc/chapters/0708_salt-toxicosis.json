            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "discharge patient to be monitored at home.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3,
              "subheading": "Asymptomatic"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Symptomatic",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Stabilize neurologic signs as needed.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3,
              "subheading": "Symptomatic"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Decontamination with emesis if indicated.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3,
              "subheading": "Symptomatic"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "IV fluids for rehydration. May need to",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3,
              "subheading": "Symptomatic"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "match fluid Na content to patient serum Na",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3,
              "subheading": "Symptomatic"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "depending on chronicity and degree of",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3,
              "subheading": "Symptomatic"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hypernatremia.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3,
              "subheading": "Symptomatic"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Calculate free water replacement for",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3,
              "subheading": "Symptomatic"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hypernatremia:",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3,
              "subheading": "Symptomatic"
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "IV use D5W or 0.45% NaCl + 2.5%",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3,
              "subheading": "Symptomatic"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "dextrose; use with caution in patients with",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3,
              "subheading": "Symptomatic"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hyperglycemia.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3,
              "subheading": "Symptomatic"
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Water oral or via nasoesophageal tube—",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3,
              "subheading": "Symptomatic"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "use for stable patients that are not vomiting",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3,
              "subheading": "Symptomatic"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "or those with underlying cardiac disease/",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3,
              "subheading": "Symptomatic"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "failure or evidence of fluid overload. Can be",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3,
              "subheading": "Symptomatic"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "used with IV therapy.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3,
              "subheading": "Symptomatic"
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Acute toxicity (<24 hours)—lower Na",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3,
              "subheading": "Symptomatic"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "acutely (over 1–2 hours) until neurologic",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3,
              "subheading": "Symptomatic"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "signs resolve, then replace remaining free",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3,
              "subheading": "Symptomatic"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "water over 6–24 hours.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3,
              "subheading": "Symptomatic"
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Chronic toxicity (>24 hours) or",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3,
              "subheading": "Symptomatic"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "unknown time frame—lower Na slowly,",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3,
              "subheading": "Symptomatic"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "not to exceed 12 mEq/day (0.5 mEq/h).",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 3,
              "subheading": "Symptomatic"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Free water deficit calculation:",
              "pdf_page": 1302,
              "printed_page": 1220,
              "column": 1,
              "subheading": "Symptomatic"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "[(patient Na ÷ normal Na) − 1] × (0.6 × body",
              "pdf_page": 1302,
              "printed_page": 1220,
              "column": 1,
              "subheading": "Symptomatic"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "weightkg) × 1000 = Free water deficit in",
              "pdf_page": 1302,
              "printed_page": 1220,
              "column": 1,
              "subheading": "Symptomatic"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "milliliters",
              "pdf_page": 1302,
              "printed_page": 1220,
              "column": 1,
              "subheading": "Symptomatic"
            }
          ]
        },
