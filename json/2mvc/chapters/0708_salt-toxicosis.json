        "DEFINITION": {
          "present": true,
          "status": "content",
          "source_heading": "DEFINITION",
          "canonical_heading": "DEFINITION",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Salt ingestion results in direct irritation to the gastrointestinal mucosa, causing vomiting, diarrhea, and anorexia. Polydipsia is a common early sign that hypernatremia is developing.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypernatremia (typically Na+>170 mEq/L, dogs; >175 mEq/L, cats) may cause neurologic signs including lethargy, behavioral changes, ataxia, muscle tremors, and seizures. Coma and death may occur.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "LD50(dogs) = 4 g NaCl/kg, <1 teaspoonful of table salt/kg body weight.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 1
            }
          ]
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypernatremia causes water movement from intracellular space to extracellular space (interstitium and blood vessel), resulting in cellular shrinkage/dehydration.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In the brain, this may cause the parenchyma to pull away from the skull, causing intra cerebral and subarachnoid hemorrhage.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In the lungs, fluid movement into the interstitial tissue may cause pulmonary edema.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Idiogenic osmoles begin to develop intracellularly within hours to prevent cellular dehydration but take 1–7 days for full compensation.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 1
            }
          ]
        },
        "SYSTEMS AFFECTED": {
          "present": true,
          "status": "content",
          "source_heading": "SYSTEMS AFFECTED",
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Gastrointestinal—vomiting, diarrhea, anorexia, polydipsia.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neuromuscular—twitching, muscle tremors, ataxia, seizures, coma.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pulmonary—edema, respiratory distress.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cardiovascular—hypervolemia, tachycardia.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 1
            }
          ]
        },
        "GENETICS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GENETICS",
          "content_blocks": []
        },
        "INCIDENCE/PREVALENCE": {
          "present": true,
          "status": "content",
          "source_heading": "INCIDENCE/PREVALENCE",
          "canonical_heading": "INCIDENCE/PREVALENCE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "With ingestion, gastrointestinal signs and mild hypernatremia are common but neurologic signs occur in severe cases.",
              "pdf_page": 1301,
              "printed_page": 1219,
              "column": 1
            }
          ]
        },
