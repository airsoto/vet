        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—dolichocephalic head types are affected most often, especially dachshunds.",
              "pdf_page": 1087,
              "printed_page": 1005,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—rare",
              "pdf_page": 1087,
              "printed_page": 1005,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic rhinitis—with or without blood.",
              "pdf_page": 1087,
              "printed_page": 1005,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sneezing—common, especially when the maxillary canines are digitally palpated.",
              "pdf_page": 1087,
              "printed_page": 1005,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually associated with advancedperiodontitis (PD4) of the maxillary canine tooth, leading to destruction of the bone separating the nasal and oral cavities.",
              "pdf_page": 1087,
              "printed_page": 1005,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other causes include trauma, penetration of a foreign body, bite wounds, traumatic tooth extraction, electrical shock, or oral cancer.",
              "pdf_page": 1087,
              "printed_page": 1005,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fistula width can be related to the size of the tooth affected; fistula depth to the chronicity of the periodontal infection.",
              "pdf_page": 1087,
              "printed_page": 1005,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs with lingually displaced (mesioverted) mandibular canines, mandibular distoclusion (overbite) resulting in penetration of the hard palate are predisposed to oronasal fistulas.",
              "pdf_page": 1087,
              "printed_page": 1005,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dachshunds predisposed.",
              "pdf_page": 1087,
              "printed_page": 1005,
              "column": 1
            }
          ]
        }
      }
    },
