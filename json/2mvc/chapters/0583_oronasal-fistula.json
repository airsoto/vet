        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Skull radiographs rarely helpful in diagnosing oronasal fistula because the lesions are generally isolated to the palatal surface.",
              "pdf_page": 1087,
              "printed_page": 1005,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intraoral radiographs are highly recommended to evaluate the periodontal status of the patient’s teeth.",
              "pdf_page": 1087,
              "printed_page": 1005,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Radiographs may show foreign body entrapment or lysis consistent with neoplasia.",
              "pdf_page": 1087,
              "printed_page": 1005,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Periodontal probing-—results in direct extension into the nasal cavity or epistaxis in cases of oronasal fistula. Periodontal probing will also identify areas where significant palatal defects are present which can be treated to help prevent the occurrence of oronasal fistulas.",
              "pdf_page": 1087,
              "printed_page": 1005,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
