  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "An oronasal fistula is an abnormal connection between the oral and nasal cavities.",
              "pdf_page": 1087,
              "printed_page": 1005,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "which can occur from pathology of any of the tissues surrounding the maxillary teeth or hard palate.",
              "pdf_page": 1087,
              "printed_page": 1005,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The maxillary canines are most commonly involved.",
              "pdf_page": 1087,
              "printed_page": 1005,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The palatal root of the maxillary fourth premolar is the next most common area",
              "pdf_page": 1087,
              "printed_page": 1005,
              "column": 1
            }
          ]
        },
