        },
        "OTHER LABORATORY TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": []
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiography—to evaluate for metastatic disease (develops in up to 25% of dogs) and rule out a primary pulmonary carcinoma (cats).",
              "pdf_page": 1365,
              "printed_page": 1283,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Limb radiography—lysis of the third phalanx of the affected digit in 80% of patients with potential secondary extension proximally to phalanx 2 and 1.",
              "pdf_page": 1365,
              "printed_page": 1283,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal ultrasonography—for hind limb lesions, evaluate intra-abdominal lymph nodes for presence of metastatic disease.",
              "pdf_page": 1365,
              "printed_page": 1283,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytology—diagnostic utility limited if there is severe inflammation or secondary infection (common), or the tumor is well differentiated.",
              "pdf_page": 1365,
              "printed_page": 1283,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Biopsy of lesion—may be needed to confirm diagnosis.",
              "pdf_page": 1365,
              "printed_page": 1283,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytology of regional lymph nodes to evaluate for metastasis.",
              "pdf_page": 1365,
              "printed_page": 1283,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": []
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Amputation of the affected digit at the level of the metacarpal or metatarsal phalangeal joint.",
          "pdf_page": 1365,
          "printed_page": 1283,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "In cats with a primary pulmonary tumor, amputation of a single affected digit may provide local palliative care and confirm diagnosis, however multiple digits on multiple limbs are often affected.",
          "pdf_page": 1365,
          "printed_page": 1283,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Palliative radiation can be considered for single digits if metastatic disease present or in the setting of multicentric/multiple digits affected.",
          "pdf_page": 1365,
          "printed_page": 1283,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Analgesics for pain control, antibiotics for secondary bacterial infections may be indicated.",
          "pdf_page": 1365,
          "printed_page": 1283,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Benefit of chemotherapy has not been established; however in patients with advanced stage of disease chemotherapy useful for squamous cell carcinoma of other sites could be considered.",
          "pdf_page": 1365,
          "printed_page": 1283,
          "column": 2
        }
      ],
