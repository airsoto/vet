        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog and rarely cat.",
              "pdf_page": 1365,
              "printed_page": 1283,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Median age—dogs and cats 10 years; reported in dogs as young as 3 years old.",
              "pdf_page": 1365,
              "printed_page": 1283,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Large breeds (>75%) and black/dark-coated dogs (>90%) predisposed; breeds include standard poodle, Labrador retriever, giant schnauzer, Rottweiler, dachshund, flat-coated retriever, and possibly Beauceron, Briard, and miniature poodle.",
              "pdf_page": 1365,
              "printed_page": 1283,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Swollen digit or digital mass which fails to heal.",
              "pdf_page": 1365,
              "printed_page": 1283,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lameness.",
              "pdf_page": 1365,
              "printed_page": 1283,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ulceration.",
              "pdf_page": 1365,
              "printed_page": 1283,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fractured or missing nail.",
              "pdf_page": 1365,
              "printed_page": 1283,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Multiple digits affected in up to 22% of dogs; may present in one digit and develop additional digital tumors later.",
              "pdf_page": 1365,
              "printed_page": 1283,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Multiple digits commonly seen in cats (30%); due to lung–digit syndrome.",
              "pdf_page": 1365,
              "printed_page": 1283,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Regional lymphadenomegaly of the sentinel draining lymph node (uncommon at time of diagnosis).",
              "pdf_page": 1365,
              "printed_page": 1283,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Risk factors (dogs)—hereditary; dark skin/hair pigmentation.",
              "pdf_page": 1365,
              "printed_page": 1283,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Nailbed infection (paronychia).",
              "pdf_page": 1365,
              "printed_page": 1283,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Trauma.",
              "pdf_page": 1365,
              "printed_page": 1283,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other tumors (dog)—melanoma; soft tissue sarcomas; mast cell tumor; osteosarcoma.",
              "pdf_page": 1365,
              "printed_page": 1283,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Benign lesions—epithelial inclusion cyst, keratoacanthoma.",
              "pdf_page": 1365,
              "printed_page": 1283,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Usually normal.",
              "pdf_page": 1365,
              "printed_page": 1283,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
