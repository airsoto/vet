  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Locally invasive malignant tumor usually arising from subungual epithelium.",
              "pdf_page": 1365,
              "printed_page": 1283,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—metastasis to one or multiple digits from primary pulmonary site.",
              "pdf_page": 1365,
              "printed_page": 1283,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—most common digital tumor (~50%); up to 25% metastatic rate, up to 22% multiple digits affected (multicentric disease).",
              "pdf_page": 1365,
              "printed_page": 1283,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Forelimb more commonly affected than hind limb.",
              "pdf_page": 1365,
              "printed_page": 1283,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Organ systems—skin/endocrine, musculoskeletal.",
              "pdf_page": 1365,
              "printed_page": 1283,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
