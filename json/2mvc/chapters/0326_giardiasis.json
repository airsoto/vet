  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Enteric infection of dogs and cats with protozoan parasite,Giardia duodenalis.",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Direct transmission by ingestion of cysts that are immediately infective when shed in feces.",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Trophozoites, motile (flagellated) organisms released from ingested cysts, attach to surface of enterocytes in small intestine with ventral sucking disc; move from site to site.",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Can cause small bowel diarrhea, but infection often asymptomatic.",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
