        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "More common in dogs than cats.",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical signs more common in young hosts; adults usually asymptomatic.",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Signs can be acute, transient, intermittent, or chronic.",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Malabsorption syndrome with soft, frothy, greasy, voluminous feces (diarrhea), usually with rancid odor.",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Transmitted by ingestion of cysts from feces in/on food, water, environment, or fur.",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Indirect water-borne transmission most common; cool, moist conditions favor cyst survival.",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Higher risk of infection in puppies and kittens, in high-density populations, and in animals with compromised immunity.",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
