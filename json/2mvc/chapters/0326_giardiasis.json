        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Detection ofGiardiatrophozoites, cysts, or antigen in feces.",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Trophozoites (15 × 8μm) detectable in fresh feces (especially diarrheic feces) and in duodenal aspirates obtained by endoscopy; trophozoites identified on Diff-Quik® or Lugol’s iodine-stained fecal smear by teardrop shape with two prominent nuclei. Trophozoites",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "identified in wet mount diluted in saline by recommended because it can be teratogenic “falling leaf” motility; flotation media may and cause anorexia, depression, vomiting, lyse trophozoites, interfering with accurate ataxia, diarrhea, abortion, and identification. myelosuppression.",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cysts, ~12μm long, oval with 2–4 nuclei, shed intermittently; centrifugal flotation of fresh feces in zinc sulfate (specific gravity 1.18) preferred method for identification of cysts. Three samples collected at 2–3-day",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Repeat fecal examinations to confirm",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "intervals should be examined to detect>70%",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "efficacy of treatment and detect reinfection.",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 2,
              "subheading": "intervals should be examined to detect>70%"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "of infections; cysts become distorted",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 2,
              "subheading": "intervals should be examined to detect>70%"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic infection can lead to debilitation.",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 2,
              "subheading": "intervals should be examined to detect>70%"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(crescent-shaped) in sugar or other flotation",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 2,
              "subheading": "intervals should be examined to detect>70%"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "solution with specific gravity>1.25;",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 2,
              "subheading": "intervals should be examined to detect>70%"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "formalin–ethyl acetate sedimentation is useful",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 2,
              "subheading": "intervals should be examined to detect>70%"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "in cases of steatorrhea.",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 2,
              "subheading": "intervals should be examined to detect>70%"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "ELISA-based kits available for in-house",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 2,
              "subheading": "intervals should be examined to detect>70%"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "detection ofGiardiaantigen in feces have",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 2
            }
          ]
        },
