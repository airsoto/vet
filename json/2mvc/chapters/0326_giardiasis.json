          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Infectious and noninfectious causes of small bowel diarrhea, maldigestion, and malabsorption syndromes, especially pancreatic exocrine insufficiency or inflammatory bowel disease.",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In cats, differentiate from infection with Tritrichomonas foetus.",
              "pdf_page": 644,
              "printed_page": 562,
              "column": 1
            }
          ]
        },
