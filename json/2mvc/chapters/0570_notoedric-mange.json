    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "When scabicidal dips are used, the entire cat must be treated.",
          "pdf_page": 1065,
          "printed_page": 983,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Treatment failures occur if product is not applied to the face and ears.",
          "pdf_page": 1065,
          "printed_page": 983,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "All in-contact cats should be treated.",
          "pdf_page": 1065,
          "printed_page": 983,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Response is usually quick if all in-contact animals are treated.",
          "pdf_page": 1065,
          "printed_page": 983,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Thorough cleaning of the cat’s environment may be helpful if severely contaminated.",
          "pdf_page": 1065,
          "printed_page": 983,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Systemic antibiotics—may be needed to resolve secondary bacterial folliculitis.",
          "pdf_page": 1065,
          "printed_page": 983,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "There is no immunity from repeat infestation; clinical signs following a reinfestation are likely to be more rapid due to previous exposure and sensitization.",
          "pdf_page": 1065,
          "printed_page": 983,
          "column": 3
        }
      ],
