              "text": "Pemphigus erythematosus.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Systemic lupus erythematosus.",
              "pdf_page": 1065,
