          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Reinfestation may occur if contact with infested animals continues; the source of infestation must be determined (if possible) as well as all in-contact cats must be treated.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 3
            }
          ]
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Topical scabicidal treatments are more prone to failure because of incomplete application of the treatment solution.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Persistent infection if not all in-contact animals are treated.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 3
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Response to therapy is rapid providing all in-contact animals are treated; symptoms should significantly reduce within 2 weeks of",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 3
            }
          ]
        }
