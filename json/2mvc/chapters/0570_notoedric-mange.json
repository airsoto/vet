        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Domestic cats of all ages and both sexes.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fairly host-specific, but can also produce symptoms in dogs, cheetahs, raccoons, rabbits, coatis, palm civets, bobcats, ocelots, foxes, and humans.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "All in-contact cats usually develop clinical",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Epizootic in localized areas.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Endemic in large feral cat populations.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Transmission by direct contact: mite is very short-lived when off the host.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nonseasonal intense pruritus.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Following exposure, initial pruritus may be mild, but progresses to severe.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Change from mild pruritus to onset of severe pruritus (incubation period) of 3–6 weeks may indicate eventual seroconversion and the development of hypersensitivity (IgG as well as humoral response).",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rare individuals do not seroconvert, and therefore may not develop severe pruritus.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Papules and crusts develop on pinnae and spread to eyelids, face, and neck (also known as “head mange”).",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Progresses to the legs, feet and perineum.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Severe self-trauma leads to secondary lesions.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Skin becomes thickened, lichenified, and covered with gray-yellow crust.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Large patches of lesions and alopecia develop over the entire body if untreated.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Unlike canine scabies, large numbers of mites are present on the skin.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Peripheral lymphadenopathy often develops.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Causes significant debilitation in severe cases.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 1
            }
          ]
        },
