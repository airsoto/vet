  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "A nonseasonal, intensely pruritic, highly contagious parasitic skin disease of cats caused byNotoedres cati.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mites burrow through the superficial skin between follicles causing intense pruritus.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Can cause transient pruritus in humans.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
