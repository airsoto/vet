    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Lime sulfur rinses 2–3%; apply to entire body weekly for 6–8 applications; clipping might be necessary to permit adequate contact with the skin.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ivermectin—effective; 0.2–0.3 mg/kg SC every 2 weeks for 2–3 treatments.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Doramectin 0.2–0.3 mg/kg SC once.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Selamectin—off-label; applied every 2 weeks for three applications.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Imidacloprid/moxidectin spot-on applied once or twice as directed on the label.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Isoxazoline parasiticides—not FDA approved: single administration.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 2
            }
          ]
        },
