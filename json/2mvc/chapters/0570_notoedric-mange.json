        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Superficial skin scraping—relatively easy to find mites.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mite smaller thanS. scabiei, with dorsal anus, typical dorsal concentric “finger print” striae, and only two pairs of forelegs protruding from the body line.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Serum testing (ELISA) for mite antibody not available.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acetate tape impression—as sensitive as skin scraping.",
              "pdf_page": 1065,
              "printed_page": 983,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
