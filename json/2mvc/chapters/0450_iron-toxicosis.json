  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Iron is an essential metal for mammals; overdose results in clinical signs and potential",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "death.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Absorption increases with readily",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "ionized and soluble iron.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Oral sources may include dietary supplements (multivitamin, prenatal), snail and slug baits, single-use heat-producing packs (hand warmers), fertilizers, most oxygen absorber packets; overdoses of injectable iron may occur.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Oral overdose leads to disruption of gastrointestinal (GI) mucosa allowing greater iron absorption, resulting in possible",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "systemic toxicity.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Potential organ systems involved include GI, cardiovascular (CV), hepatobiliary, nervous, hemic, and renal.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tissue damage occurs due to free radical/reactive oxygen species formation resulting in direct or secondary damage through processes such as lipid peroxidation.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Disrupts mitochondrial function and interferes with cellular respiration.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
