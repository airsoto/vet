    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Chelation",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chelate when serum iron>350–500μg/dL or",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 3,
              "subheading": "Chelation"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "serum iron>TIBC.•Deferoxamine mesylate",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(40 mg/kg IM q4–8h) until urine no longer",
