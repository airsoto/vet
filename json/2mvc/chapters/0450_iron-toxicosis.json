        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Predominantly dogs, uncommon in other",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "species.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "All ages susceptible.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "History of iron ingestion or injectable",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "overdose.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Initial signs related to GI irritation and mucosal damage; onset of signs occurs within 6–8 hours post ingestion; may include vomiting, diarrhea, mucosal damage (hematemesis, melena), abdominal pain and depression; signs with mild to moderate",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "ingestions may not progress beyond GI.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In absence of significant initial GI signs,",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "systemic toxicity unlikely.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "A quiet/latent period may follow initial GI signs and last up",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "to 24 hours post ingestion.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In severe cases, recurrence of clinical signs occurs 12–96 hours post ingestion and can include ongoing vomiting/diarrhea ± mucosal damage, tachycardia, hypotension, CV collapse, metabolic acidosis, shock, hepatic necrosis, coagulopathy/disseminated intravascular coagulation (DIC), acute kidney injury,",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "seizures, death.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Following GI involvement, scarring and stricture formation may occur during healing.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ingestion of iron-containing medication or",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "other materials.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Majority of cases due to",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "canine dietary indiscretion.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Elemental/absorbable iron results in mild signs at 20 mg/kg PO and severe signs at 60 mg/kg; other forms of iron including iron salts require conversion to elemental iron for dose",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "calculations.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metallic iron and iron oxide (rust)not readily ionizable/absorbable and toxicity not expected.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Other causes of severe gastroenteritis and shock, viral/bacterial enteritis, caustic/corrosive ingestion, other dietary indiscretion, gastric torsion, heatstroke, snake bite.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Leukocytosis.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anemia (blood loss) or",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "hemoconcentration.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Normal to high aspartate aminotransferase (AST), alanine aminotransferase (ALT), alkaline phosphatase (ALP), serum bilirubin.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Blood gas to monitor for metabolic",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "acidosis.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Serum iron levels ± total iron binding capacity (TIBC); serum iron level more commonly performed and drawn 4–6 hours post ingestion with capsule or tablet ingestion and 2–3 hours post ingestion with liquid or chewable tablets; repeat q2–4h",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "until peak level if able.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hemolyzed serum samples increase iron content and should be",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "avoided.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "ECG/blood pressure.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Coagulation profile for DIC.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Abdominal radiography—iron-containing material may be radiopaque; adherence to mucosa may be visible.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Analysis of GI or stomach contents may aid in documenting high iron exposures.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary gross lesions—hemorrhage in GI tract and liver; hepatomegaly.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Histopathologic lesions—GI necrosis with potential of hepatocellular and vascular endothelial necrosis.",
              "pdf_page": 873,
              "printed_page": 791,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Inpatient monitoring with toxic doses; home monitoring if patient remains asymptomatic during initial 8 hours post ingestion; continue inpatient care if",
          "pdf_page": 873,
          "printed_page": 791,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "symptomatic.",
          "pdf_page": 873,
          "printed_page": 791,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Correct hypovolemic shock",
          "pdf_page": 873,
          "printed_page": 791,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "with IV fluids.",
          "pdf_page": 873,
          "printed_page": 791,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Correct severe acidosis with",
          "pdf_page": 873,
          "printed_page": 791,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "IV sodium bicarbonate.",
          "pdf_page": 873,
          "printed_page": 791,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Feed patient bland diet depending on GI status.",
          "pdf_page": 873,
          "printed_page": 791,
          "column": 2
        },
        {
          "type": "subheading",
          "level": 0,
          "text": "Decontamination",
          "pdf_page": 873,
          "printed_page": 791,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Oral milk of magnesia or aluminum",
          "pdf_page": 873,
          "printed_page": 791,
          "column": 2,
          "subheading": "Decontamination"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "hydroxide (precipitates iron in GI tract) at",
          "pdf_page": 873,
          "printed_page": 791,
          "column": 2,
          "subheading": "Decontamination"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "5–30 mL PO q8–12h × 24h; may cause",
          "pdf_page": 873,
          "printed_page": 791,
          "column": 2,
          "subheading": "Decontamination"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "diarrhea.",
          "pdf_page": 873,
          "printed_page": 791,
          "column": 2,
          "subheading": "Decontamination"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Induce emesis or gastric lavage (if",
          "pdf_page": 873,
          "printed_page": 791,
          "column": 2,
          "subheading": "Decontamination"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "emesis contraindicated).",
          "pdf_page": 873,
          "printed_page": 791,
          "column": 2,
          "subheading": "Decontamination"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Emergency",
          "pdf_page": 873,
          "printed_page": 791,
          "column": 2,
          "subheading": "Decontamination"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "gastrotomy if lavage fails to remove adherent",
          "pdf_page": 873,
          "printed_page": 791,
          "column": 2,
          "subheading": "Decontamination"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "pills or bezoars.",
          "pdf_page": 873,
          "printed_page": 791,
          "column": 2,
          "subheading": "Decontamination"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Whole bowel irrigation or",
          "pdf_page": 873,
          "printed_page": 791,
          "column": 2,
          "subheading": "Decontamination"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "enema.",
          "pdf_page": 873,
          "printed_page": 791,
          "column": 2,
          "subheading": "Decontamination"
        }
      ],
