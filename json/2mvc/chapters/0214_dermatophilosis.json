              "printed_page": 369,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "subcutaneous disease—episode of trauma;",
              "pdf_page": 451,
              "printed_page": 369,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "existence of a foreign body; lesions generally",
