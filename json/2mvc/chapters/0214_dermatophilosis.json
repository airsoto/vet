              "printed_page": 369,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 451,
              "printed_page": 369,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—lesions: circular to coalescent, papular,",
              "pdf_page": 451,
              "printed_page": 369,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "crusted skin lesions on the head and/or trunk,",
              "pdf_page": 451,
              "printed_page": 369,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "lesions resemble superficial bacterial pyoderma",
              "pdf_page": 451,
              "printed_page": 369,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "caused byStaphylococcus pseudintermedius;",
              "pdf_page": 451,
              "printed_page": 369,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "lesions may resemble dermatophilosis in horses",
              "pdf_page": 451,
              "printed_page": 369,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(adherent thick, gray-yellow crusts that",
              "pdf_page": 451,
              "printed_page": 369,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "incorporate hair and leave a circular, glistening,",
