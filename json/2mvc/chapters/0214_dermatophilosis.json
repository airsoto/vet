              "printed_page": 369,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "shallow erosion when removed); pruritus is",
              "pdf_page": 451,
              "printed_page": 369,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "variable.",
