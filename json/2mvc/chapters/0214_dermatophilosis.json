              "type": "bullet",
              "level": 0,
              "text": "crusts.",
              "pdf_page": 451,
              "printed_page": 369,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—pyogranulomatous inflammation; central necrosis; fistulous tract formation; organism visualized near the necrotic center of granulomas, especially with Gram stain.",
              "pdf_page": 451,
              "printed_page": 369,
              "column": 2
            }
          ]
        }
