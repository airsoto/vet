          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "D.congolensis—causative agent; Gram-positive, branching filamentous bacterium classified as an actinomycete; very common cause of crusting dermatoses in hoofed animals; persists in the",
              "pdf_page": 451,
              "printed_page": 369,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "environment within crusts.",
              "pdf_page": 451,
              "printed_page": 369,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs, cats, and humans can be exposed directly from lesions on large animals or from environmental",
              "pdf_page": 451,
              "printed_page": 369,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "exposure.",
              "pdf_page": 451,
              "printed_page": 369,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infectious stage—requires wetting for activation; cannot penetrate intact epithelium; minor trauma or mechanical",
              "pdf_page": 451,
              "printed_page": 369,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "transmission by biting ectoparasites (Amblyomma",
              "pdf_page": 451,
              "printed_page": 369,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "variegatum) may help in establishing infection.",
              "pdf_page": 451,
              "printed_page": 369,
              "column": 1,
              "subheading": "transmission by biting ectoparasites (Amblyomma"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Deeper infections—require traumatic",
              "pdf_page": 451,
              "printed_page": 369,
              "column": 1,
              "subheading": "transmission by biting ectoparasites (Amblyomma"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "inoculation of infectious material.",
              "pdf_page": 451,
              "printed_page": 369,
              "column": 1,
              "subheading": "transmission by biting ectoparasites (Amblyomma"
            }
          ]
        }
