    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Glucocorticoids may improve the pruritis of NME skin lesions, but are not recommended for use in glucagonomas as they are likely to exacerbate hyperglycemia associated with secondary DM.",
          "pdf_page": 651,
          "printed_page": 569,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "IV amino acids (500 mL of essential amino acids added to saline or lactated Ringer’s solution over 12h, or 10% amino acid solution 24 mL/kg over 8–12h) have resulted in variable improvement in NME skin lesions in dogs. Treatments may be repeated every 1–2 weeks if effective until clinical signs abate or resolve.",
          "pdf_page": 651,
          "printed_page": 569,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Sulfur/salicylic acid–based shampoos or very mild shampoos may help remove crusts, soften skin, and improve pain and pruritus associated with footpad or skin lesions.",
          "pdf_page": 651,
          "printed_page": 569,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Oral zinc sulfate (10 mg/kg/day PO), zinc methionine (2 mg/kg/day PO), or zinc gluconate (3 mg/kg/day PO) may be considered.",
          "pdf_page": 651,
          "printed_page": 569,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Supplementation with oral fatty acids (80 mg/kg PO) may also be of benefit.",
          "pdf_page": 651,
          "printed_page": 569,
          "column": 1
        }
      ],
