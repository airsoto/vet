        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog—rare; older animals.",
              "pdf_page": 650,
              "printed_page": 568,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cat—rare.",
              "pdf_page": 650,
              "printed_page": 568,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "The hallmark sign is NME, although this may be caused by glucagonoma or hepatocutaneous syndrome. NME has also been described in veterinary medicine as metabolic epidermal necrosis and superficial necrolytic dermatitis.",
              "pdf_page": 650,
              "printed_page": 568,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Skin lesions include erythema, erosions, and crusting, generally located around mucocutaneous junctions (perineum, face, and genitalia), distal extremities, and footpads. Lesions are often pruritic with hyperkeratotic and painful footpads. In many cases, footpads are the only affected area.",
              "pdf_page": 650,
              "printed_page": 568,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other systemic signs include lethargy, polyuria, polydipsia, diarrhea, secondary pyoderma or yeast infection, anorexia, and weight loss.",
              "pdf_page": 650,
              "printed_page": 568,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
