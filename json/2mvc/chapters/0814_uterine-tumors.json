        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog and cat.",
              "pdf_page": 1469,
              "printed_page": 1387,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No breed predilection reported.",
              "pdf_page": 1469,
              "printed_page": 1387,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Middle-aged to older animals usually affected.",
              "pdf_page": 1469,
              "printed_page": 1387,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Birt-Hogg-Dube syndrome in German shepherd dogs has been associated with uterine leiomyomas, renal cystadenocarcinomas, and nodular dermatofibrosis.",
              "pdf_page": 1469,
              "printed_page": 1387,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—often clinically silent and discovered incidentally; vaginal discharge; pyometra, infertility; abdominal organ compression or secondary metastatic signs (site specific).",
              "pdf_page": 1469,
              "printed_page": 1387,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—vaginal discharge (may be hemorrhagic); abnormal estrous cycles; polyuria; polydipsia; vomiting; abdominal distention, infertility, uterine prolapse; signs related to metastatic disease (site specific).",
              "pdf_page": 1469,
              "printed_page": 1387,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Intact sexual status (hormonal influence).",
              "pdf_page": 1469,
              "printed_page": 1387,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nulliparous bitches have an increased risk of uterine pathology.",
              "pdf_page": 1469,
              "printed_page": 1387,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "MutatedBHDgene in German shepherd dogs.",
              "pdf_page": 1469,
              "printed_page": 1387,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
