              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other mid-caudal abdominal masses.",
              "pdf_page": 1469,
              "printed_page": 1387,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
