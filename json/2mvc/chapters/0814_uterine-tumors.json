        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal radiography—may detect a mid-caudal abdominal mass.",
              "pdf_page": 1469,
              "printed_page": 1387,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiography—recommended; assess for distant pulmonary metastasis.",
              "pdf_page": 1469,
              "printed_page": 1387,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ultrasonography—may reveal uterine mass, masses in uterine horns may be difficult to definitely identify at uterine.",
              "pdf_page": 1469,
              "printed_page": 1387,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal CT/MRI—further delineation of mass, assess for metastatic disease.",
              "pdf_page": 1469,
              "printed_page": 1387,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytologic evaluation—however, tumors might be poorly exfoliative, especially if mesenchymal in origin; improved cytologic yield with epithelial malignancies (carcinoma).",
              "pdf_page": 1469,
              "printed_page": 1387,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Imaging unable to differentiate between histologic subtypes.",
              "pdf_page": 1469,
              "printed_page": 1387,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Histopathologic examination—necessary for definitive diagnosis.",
              "pdf_page": 1469,
              "printed_page": 1387,
              "column": 2
            }
          ]
        },
