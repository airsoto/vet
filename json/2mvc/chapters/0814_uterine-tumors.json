  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Rare tumors arising from the uterine smooth muscle and epithelial tissues.",
              "pdf_page": 1469,
              "printed_page": 1387,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Comprise 0.3–0.4% of tumors in dogs and 0.2–1.5% in cats.",
              "pdf_page": 1469,
              "printed_page": 1387,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—usually benign; leiomyomas, 85%–90%; leiomyosarcoma, 10%; other types (e.g., carcinoma, fibroma, fibrosarcoma, lipoma, extramedullary plasma cell tumor, mast cell tumor, hemangiosarcoma) rare.",
              "pdf_page": 1469,
              "printed_page": 1387,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—usually malignant (adenocarcinoma); include leiomyoma, leiomyosarcoma, fibrosarcoma, fibroma, lipoma, and Mullerian tumor (adenosarcoma).",
              "pdf_page": 1469,
              "printed_page": 1387,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metastasis—may occur with malignant forms.",
              "pdf_page": 1469,
              "printed_page": 1387,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
