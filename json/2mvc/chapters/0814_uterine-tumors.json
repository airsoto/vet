        "CONTRAINDICATIONS/POSSIBLE INTERACTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Doxorubicin—carefully monitor patients with underlying cardiac disease; consider pretreatment and serial echocardiograms and ECG.",
              "pdf_page": 1469,
              "printed_page": 1387,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cisplatin—do not use in dogs with preexisting renal disease; do not use without appropriate and concurrent diuresis; do not use in cats (fatal).",
              "pdf_page": 1469,
              "printed_page": 1387,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chemotherapy may be toxic; seek advice if unfamiliar with these agents.",
              "pdf_page": 1469,
              "printed_page": 1387,
              "column": 2
            }
          ]
        },
