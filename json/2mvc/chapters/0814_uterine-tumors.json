      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Doxorubicin, cisplatin, carboplatin, epirubicin— rational choices for palliation of malignant or metastatic disease.",
