        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Rare in dog and very rare in cat.",
              "pdf_page": 714,
              "printed_page": 632,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affected dogs commonly>10 years of age.",
              "pdf_page": 714,
              "printed_page": 632,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Breed predispositions unknown.",
              "pdf_page": 714,
              "printed_page": 632,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually asymptomatic; when clinical signs present, symptoms may be nonspecific; typically incidental finding.",
              "pdf_page": 714,
              "printed_page": 632,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute tumor rupture may cause hemoperitoneum with resultant weakness and hypovolemic shock-like symptoms.",
              "pdf_page": 714,
              "printed_page": 632,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Occasionally, large tumors may cause cranial abdominal pain, vomiting, and inappetance.",
              "pdf_page": 714,
              "printed_page": 632,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
