              "printed_page": 632,
              "column": 2,
              "subheading": "Abdominal Ultrasonography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "appropriate postoperative supportive care is",
              "pdf_page": 714,
              "printed_page": 632,
              "column": 2,
              "subheading": "Abdominal Ultrasonography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "echogenicity to mixed echogenicity, presence",
              "pdf_page": 714,
              "printed_page": 632,
              "column": 2,
              "subheading": "Abdominal Ultrasonography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "available.",
              "pdf_page": 714,
              "printed_page": 632,
              "column": 2,
              "subheading": "Abdominal Ultrasonography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "of multiple nodules, or cystic mass appearance.",
