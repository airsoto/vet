              "printed_page": 632,
              "column": 2,
              "subheading": "Abdominal Ultrasonography"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Biopsy of local lymph nodes, normal-",
              "pdf_page": 714,
              "printed_page": 632,
              "column": 2,
              "subheading": "Abdominal Ultrasonography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "appearing liver, and any abnormal tissue",
              "pdf_page": 714,
              "printed_page": 632,
              "column": 2,
              "subheading": "Abdominal Ultrasonography"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Abdominal CT",
              "pdf_page": 714,
              "printed_page": 632,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "identified during the exploratory surgery is of",
              "pdf_page": 714,
              "printed_page": 632,
              "column": 2,
              "subheading": "Abdominal CT"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May allow for improved assessment",
              "pdf_page": 714,
              "printed_page": 632,
              "column": 2,
