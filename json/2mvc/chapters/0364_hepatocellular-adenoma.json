        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Serum bile acids are usually normal unless tumor growth compromises hepatic perfusion and biliary flow.",
              "pdf_page": 714,
              "printed_page": 632,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Coagulation abnormalities consistent with disseminated intravascular coagulation (DIC) occur rarely with large necrotic or hemorrhagic tumors.",
              "pdf_page": 714,
              "printed_page": 632,
              "column": 1
            }
          ]
        },
