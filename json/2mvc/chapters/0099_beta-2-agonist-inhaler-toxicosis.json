        },
        "SYSTEMS AFFECTED": {
          "present": true,
          "status": "content",
          "source_heading": "SYSTEMS AFFECTED",
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Behavioral—hyperactivity, apprehension, nervousness, restlessness.",
              "pdf_page": 254,
              "printed_page": 172,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cardiovascular—sinus tachycardia, other tachyarrhythmias.",
              "pdf_page": 254,
              "printed_page": 172,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Endocrine/metabolic—hypokalemia, hypophosphatemia.",
              "pdf_page": 254,
              "printed_page": 172,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gastrointestinal—mild vomiting.",
              "pdf_page": 254,
              "printed_page": 172,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Musculoskeletal—tremors, weakness with catecholamine depletion.",
              "pdf_page": 254,
              "printed_page": 172,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nervous—anxiety, apprehension initially, depression with catecholamine depletion.",
              "pdf_page": 254,
              "printed_page": 172,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neuromuscular—tremors.",
              "pdf_page": 254,
              "printed_page": 172,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory—tachypnea.",
              "pdf_page": 254,
              "printed_page": 172,
              "column": 1
            }
          ]
        },
