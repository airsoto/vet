    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Neurologic status—examine at weekly-tomonthly intervals if progression of signs is uncertain; consider videotaping patient to determine progression objectively.",
          "pdf_page": 329,
          "printed_page": 247,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Progression of signs—rate varies depending on etiology; ranges from days to years.",
          "pdf_page": 329,
          "printed_page": 247,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Nonprogressive disease—patient may show improvements as they learn to compensate for",
          "pdf_page": 329,
          "printed_page": 247,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "deficits.",
          "pdf_page": 329,
          "printed_page": 247,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Do not vaccinate pregnant animals",
          "pdf_page": 329,
          "printed_page": 247,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "with modified live virus.",
          "pdf_page": 329,
          "printed_page": 247,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Do not breed animals with familial history of cerebellar disease.",
          "pdf_page": 329,
          "printed_page": 247,
          "column": 3
        }
      ],
