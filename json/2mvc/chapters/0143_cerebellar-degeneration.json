          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Progressive and non-progressive etiologies. Progressive - premature aging and neuronal death; may be due to failure of neuronal energy supply, ion regulation, excitotoxicity, autoimmunity/inflammation, or inappropriate apoptosis; neonatal, postnatal, and adult onset",
              "pdf_page": 329,
              "printed_page": 247,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "(rare).",
              "pdf_page": 329,
              "printed_page": 247,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nonprogressive - due to abnormal cerebellar development following in utero or neonatal viral infection in cats (feline panleukopenia) and dogs (canine herpesvirus, canine parvovirus).",
              "pdf_page": 329,
              "printed_page": 247,
              "column": 1
            }
          ]
        },
