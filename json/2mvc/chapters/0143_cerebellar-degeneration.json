        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Causal mutations associated with progressive cerebellar degeneration have been identified",
              "pdf_page": 329,
              "printed_page": 247,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "in several breeds.",
              "pdf_page": 329,
              "printed_page": 247,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In utero or neonatal exposure to feline panleukopenia or canine",
              "pdf_page": 329,
              "printed_page": 247,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "herpesvirus infection.",
              "pdf_page": 329,
              "printed_page": 247,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Poor vaccination history or exposure to modified live virus",
              "pdf_page": 329,
              "printed_page": 247,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "during gestation.",
              "pdf_page": 329,
              "printed_page": 247,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "A syndrome of hepatocerebellar degeneration has been described in a litter of Bernese mountain dogs.",
              "pdf_page": 329,
              "printed_page": 247,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Paraneoplastic cerebellar degeneration has been reported in humans.",
              "pdf_page": 329,
              "printed_page": 247,
              "column": 2
            }
          ]
        }
      }
