    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Restrict to supervised activity in safe areas; leash-walks only; avoid stairs, furniture, proximity to swimming pools, etc.",
          "pdf_page": 329,
          "printed_page": 247,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Amantadine has potentiating effects on dopaminergic neurotransmission in CNS and anticholinergic activity; buspirone is serotonin agonist; research models demonstrate some potential benefit for progressive cerebellar degeneration; guidelines and clinical evidence",
          "pdf_page": 329,
          "printed_page": 247,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "are lacking.",
          "pdf_page": 329,
          "printed_page": 247,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Neuroprotective agents (such as coenzyme Q10 and acetyl-L-carnitine) may have promising effects.",
          "pdf_page": 329,
          "printed_page": 247,
          "column": 3
        }
      ],
