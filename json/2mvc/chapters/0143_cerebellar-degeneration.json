        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "CSF analysis—normal with nonprogressive disease; normal-to-high protein concentration and normal cell counts with progressive disease.",
              "pdf_page": 329,
              "printed_page": 247,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
