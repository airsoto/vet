        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cerebellar ataxia- hypermetria; broad-based stance; swaying of body, intention tremors.",
              "pdf_page": 329,
              "printed_page": 247,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lack of menace responses with normal",
              "pdf_page": 329,
              "printed_page": 247,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "vision and pupillary light reflexes.",
              "pdf_page": 329,
              "printed_page": 247,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Head tilt and episodes of vestibular ataxia with resting",
              "pdf_page": 329,
              "printed_page": 247,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "or positional nystagmus.",
              "pdf_page": 329,
              "printed_page": 247,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diffuse tapetal",
              "pdf_page": 329,
              "printed_page": 247,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hyperreflectivity on funduscopic exam.",
              "pdf_page": 329,
              "printed_page": 247,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Decerebellate posture—opisthotonos with extensor rigidity of the forelimbs and flexed",
              "pdf_page": 329,
              "printed_page": 247,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "hind limbs.",
              "pdf_page": 329,
              "printed_page": 247,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cerebellar degeneration is not characterized by altered mentation, proprio",
              "pdf_page": 329,
              "printed_page": 247,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "ceptive deficits, or paresis.",
              "pdf_page": 329,
              "printed_page": 247,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Progression of",
              "pdf_page": 329,
              "printed_page": 247,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "signs varies.",
              "pdf_page": 329,
              "printed_page": 247,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Use caution in interpreting progression of clinical signs—cerebellar ataxia in a puppy or kitten with cerebellar degeneration caused by in utero or neonatal infection may appear to worsen as the animal grows and becomes more active; the underlying disease process itself is nonprogressive.",
              "pdf_page": 329,
              "printed_page": 247,
              "column": 2
            }
          ]
        },
