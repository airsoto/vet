          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "infection may limit diagnostic utility. After complete surgical resection, recheck at",
              "pdf_page": 1372,
              "printed_page": 1290,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Deep wedge tissue biopsy—necessary for 1–2 months and then every 3 months with definitive diagnosis. physical examination and evaluation for",
              "pdf_page": 1372,
              "printed_page": 1290,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytology and/or lymph node biopsy to metastasis (lymph node palpation/aspiration evaluate for regional metastasis; more and thoracic imaging). common in dogs.",
              "pdf_page": 1372,
              "printed_page": 1290,
              "column": 2
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": false,
