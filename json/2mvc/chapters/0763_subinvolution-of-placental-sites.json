      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Failure or delay of normal postpartum uterine involution (normally requires 12–15 weeks to complete).",
              "pdf_page": 1386,
              "printed_page": 1304,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Failure of eosinophilic masses of collagen at placental sites to slough at 3–4 weeks postpartum.",
              "pdf_page": 1386,
              "printed_page": 1304,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Failure of fetal trophoblastic cells to regress (normally occurs within 2 weeks); instead, they invade the maternal deep glandular endometrium and myometrium.",
              "pdf_page": 1386,
              "printed_page": 1304,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cause—unknown; hormonal or uterine basis not suspected based on coexistence of unaffected and subinvoluted placental sites in the same uterus.",
              "pdf_page": 1386,
              "printed_page": 1304,
              "column": 1
            }
          ]
        },
