        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Spontaneous resolution—the usual outcome",
              "pdf_page": 1386,
              "printed_page": 1304,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gross—sites characterized by a thickened, in the majority of cases. hemorrhagic area that may be nodular.",
              "pdf_page": 1386,
              "printed_page": 1304,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Recurrence—not expected, occurs rarely.",
              "pdf_page": 1386,
              "printed_page": 1304,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Histopathologic—definitive diagnosis;",
              "pdf_page": 1386,
              "printed_page": 1304,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prognosis for future reproduction— eosinophilic collagen masses with trophoblasts excellent with spontaneous resolution. extending into the myometrium.",
              "pdf_page": 1386,
              "printed_page": 1304,
              "column": 2
            }
          ]
        }
