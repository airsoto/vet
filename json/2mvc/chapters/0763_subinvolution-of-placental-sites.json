    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Metritis—differentiated by vaginal cytology and physical examination.",
              "pdf_page": 1386,
              "printed_page": 1304,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vaginitis—differentiated by vaginal cytology.",
              "pdf_page": 1386,
              "printed_page": 1304,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vaginal neoplasia—differentiated by vaginal cytology and vaginal endoscopy.",
              "pdf_page": 1386,
              "printed_page": 1304,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Uterine neoplasia—differentiated by ultrasonography or exploratory laparotomy.",
              "pdf_page": 1386,
              "printed_page": 1304,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cystitis—differentiated by vaginal cytology and urinalysis obtained by cystocentesis.",
              "pdf_page": 1386,
              "printed_page": 1304,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Coagulopathy—differentiated by clotting times, platelet count.",
              "pdf_page": 1386,
              "printed_page": 1304,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Trauma.",
              "pdf_page": 1386,
              "printed_page": 1304,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Endogenous estrogen stimulation—bitch with an extremely shortened interestrous interval.",
              "pdf_page": 1386,
              "printed_page": 1304,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exogenous estrogen stimulation—oral medication or contact with topical hormone replacement product on human skin, bedding, or clothing.",
              "pdf_page": 1386,
              "printed_page": 1304,
              "column": 1
            }
          ]
        },
