  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Sympathomimetic drugs used for topical vasoconstrictive effects in ophthalmic anti-redness drops and nasal decongestant sprays.",
              "pdf_page": 841,
              "printed_page": 759,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Oxymetazoline, naphazoline, tetrahydro zoline, brimonidine, and xylometazoline are imidazolines commonly used in prescription and over-the-counter ophthalmic and nasal products.",
              "pdf_page": 841,
              "printed_page": 759,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Central and peripheral alpha2adrenergic agonist activity. In overdose, central activity predominates, resulting in norepinephrine release and clinical signs of hypotension, bradycardia, and sedation.",
              "pdf_page": 841,
              "printed_page": 759,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Companion animal pharmacokinetic data limited. Imidazolines considered to have narrow margin of safety, with no known therapeutic dose in veterinary medicine.",
              "pdf_page": 841,
              "printed_page": 759,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Absorption rapid and nearly complete when ingested.",
              "pdf_page": 841,
              "printed_page": 759,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Imidazolines partially metabolized in liver and eliminated mostly unchanged in urine.",
              "pdf_page": 841,
              "printed_page": 759,
              "column": 1
            }
          ]
        },
        "SYSTEMS AFFECTED": {
          "present": true,
          "status": "content",
          "source_heading": "SYSTEMS AFFECTED",
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cardiovascular—early transient tachy cardia and hypertension followed by prolonged bradycardia and hypotension, arrhythmias, pallor, slow capillary refill time.",
              "pdf_page": 841,
              "printed_page": 759,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gastrointestinal—vomiting.",
              "pdf_page": 841,
              "printed_page": 759,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nervous—sedation, lethargy, ataxia, weakness, tremors, rare seizures, rare paradoxical agitation, coma.",
              "pdf_page": 841,
              "printed_page": 759,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ophthalmic—miosis.",
              "pdf_page": 841,
              "printed_page": 759,
              "column": 1
            }
          ]
        },
        "GENETICS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GENETICS",
          "content_blocks": []
        },
