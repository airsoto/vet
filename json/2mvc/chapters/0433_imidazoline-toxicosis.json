    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Activated charcoal (1 g/kg PO) with cathartic × 1 dose in asymptomatic patients presenting early (<1–2 hours after ingestion); avoid use in symptomatic patients.",
              "pdf_page": 841,
              "printed_page": 759,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Alpha2adrenergic antagonists—atipamezole 50μg/kg IV/IM may be used to reverse severe sedation and bradycardia; give 1⁄4 dose IV and remainder IM to avoid worsening hypotension; administer additional doses PRN based on clinical signs; alternatively, yohimbine 0.1 mg/kg IV may be used.",
              "pdf_page": 841,
              "printed_page": 759,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bradycardia—atropine 0.01–0.02 mg/kg IV PRN; avoid use if hypertensive.",
              "pdf_page": 841,
              "printed_page": 759,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperactivity—diazepam (0.5–1 mg/kg IV) or butorphanol (0.2–0.8 mg/kg IM/IV) PRN.",
              "pdf_page": 841,
              "printed_page": 759,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Seizures—diazepam (0.5–1 mg/kg IV)",
              "pdf_page": 841,
              "printed_page": 759,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tremors—diazepam (0.5–1 mg/kg IV) or methocarbamol (50–220 mg/kg IV slowly, up to a daily dose of 330 mg/kg)",
              "pdf_page": 841,
              "printed_page": 759,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vomiting—maropitant (1 mg/kg SC/IV q24h) PRN.",
              "pdf_page": 841,
              "printed_page": 759,
              "column": 3
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Alternative Drugs",
              "pdf_page": 841,
              "printed_page": 759,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Naloxone 0.011–0.022 mg/kg IV/IM PRN",
              "pdf_page": 841,
              "printed_page": 759,
              "column": 3,
              "subheading": "Alternative Drugs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "may be tried if atipamezole and yohimbine",
              "pdf_page": 841,
              "printed_page": 759,
              "column": 3,
              "subheading": "Alternative Drugs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "are unavailable. Mechanism of action is",
              "pdf_page": 841,
              "printed_page": 759,
              "column": 3,
              "subheading": "Alternative Drugs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "unknown, and results may be variable.",
              "pdf_page": 841,
              "printed_page": 759,
              "column": 3,
              "subheading": "Alternative Drugs"
            }
          ]
        },
