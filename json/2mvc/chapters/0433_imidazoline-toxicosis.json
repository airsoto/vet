          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other alpha agonist drugs—clonidine, tizanidine, medetomidine, dexmedetomidine, xylazine, amitraz.",
              "pdf_page": 841,
              "printed_page": 759,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Marijuana, methanol, ethanol.",
              "pdf_page": 841,
              "printed_page": 759,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Beta adrenergic blocker toxicosis— metoprolol, atenolol, propranolol.",
              "pdf_page": 841,
              "printed_page": 759,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Calcium channel blocker toxicosis— diltiazem, amlodipine, verapamil.",
              "pdf_page": 841,
              "printed_page": 759,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary cardiac disease with signs of bradycardia and hypotension.",
              "pdf_page": 841,
              "printed_page": 759,
              "column": 2
            }
          ]
        },
