    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dopamine agonists—reduce milk production and some maternal behaviors by inhibiting prolactin release.",
              "pdf_page": 568,
              "printed_page": 486,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cabergoline 5μg/kg PO q24h for 5–7 days.",
              "pdf_page": 568,
              "printed_page": 486,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bromocriptine 10μg/kg PO q8h for 5–7",
              "pdf_page": 568,
              "printed_page": 486,
              "column": 1
            }
          ]
        },
        "CONTRAINDICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS",
          "canonical_heading": "CONTRAINDICATIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Dopamine agonists can cause abortion if given to a pregnant bitch or queen, as prolactin is luteotrophic. Drugs that suppress prolactin will terminate pregnancy by reducing progesterone and can cause premature parturition (abortion).",
              "pdf_page": 568,
              "printed_page": 486,
              "column": 1
            }
          ]
        },
        "PRECAUTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "PRECAUTIONS",
          "canonical_heading": "PRECAUTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Incidence of vomiting with bromocriptine administration reduced if given with food; cabergoline has fewer side effects and higher efficacy, but is more costly.",
              "pdf_page": 568,
              "printed_page": 486,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Coat color changes in dogs possible with prolonged dopamine agonist treatment (uncommon).",
              "pdf_page": 568,
              "printed_page": 486,
              "column": 1
            }
          ]
        },
        "POSSIBLE INTERACTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE INTERACTIONS",
          "canonical_heading": "POSSIBLE INTERACTIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Avoid acepromazine and metoclopramide; both can promote lactation and reduce efficacy of dopamine agonists.",
              "pdf_page": 568,
              "printed_page": 486,
              "column": 1
            }
          ]
        },
        "CONTRAINDICATIONS/POSSIBLE INTERACTIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": []
        },
        "ALTERNATIVE DRUG(S)": {
          "present": true,
          "status": "content",
          "source_heading": "ALTERNATIVE DRUG(S)",
          "canonical_heading": "ALTERNATIVE DRUG(S)",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Short-term therapy with diazepam can be useful for bitches with extreme behavioral",
              "pdf_page": 568,
              "printed_page": 486,
              "column": 1
            }
          ]
        }
      }
    },
