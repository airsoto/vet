            {
              "type": "bullet",
              "level": 0,
              "text": "Prevent mammary gland stimulation from self-nursing with Elizabethan collar or body suit.",
              "pdf_page": 567,
              "printed_page": 485,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Owners can cold pack mammary glands to reduce mammary gland activity.",
              "pdf_page": 567,
              "printed_page": 485,
              "column": 3
            }
          ]
        },
        "ACTIVITY": {
          "present": true,
          "status": "content",
          "source_heading": "ACTIVITY",
          "canonical_heading": "ACTIVITY",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Increase activity in sedentary dogs and cats to increase caloric expenditure and decrease calories available for lactation.",
              "pdf_page": 567,
              "printed_page": 485,
              "column": 3
            }
          ]
        },
        "DIET": {
          "present": true,
          "status": "content",
          "source_heading": "DIET",
          "canonical_heading": "DIET",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Decrease caloric intake for several days to reduce energy available for lactation.",
              "pdf_page": 567,
              "printed_page": 485,
              "column": 3
            }
          ]
        },
        "CLIENT EDUCATION": {
          "present": true,
          "status": "content",
          "source_heading": "CLIENT EDUCATION",
          "canonical_heading": "CLIENT EDUCATION",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "False pregnancies are normal in bitches and do not impact future fertility.",
              "pdf_page": 567,
              "printed_page": 485,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Advise cat owners that pyometra can develop following spontaneous ovulations.",
              "pdf_page": 567,
              "printed_page": 485,
              "column": 3
            }
          ]
        },
        "SURGICAL CONSIDERATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "SURGICAL CONSIDERATIONS",
          "canonical_heading": "SURGICAL CONSIDERATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "OVE or OHE if bitch or queen is not intended for use in a breeding program.",
              "pdf_page": 567,
              "printed_page": 485,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Perform OVE or OHE during anestrus or early diestrus when possible.",
              "pdf_page": 567,
              "printed_page": 485,
              "column": 3
            }
          ]
        },
