          "canonical_heading": "INCIDENCE/PREVALENCE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "False pregnancies occur in 100% of bitches following ovulation.",
              "pdf_page": 567,
              "printed_page": 485,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": ">60% of cycling bitches exhibit signs of false pregnancy.",
              "pdf_page": 567,
              "printed_page": 485,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Spontaneous ovulation occurs frequently in the queen (35–85%) depending on presence of other queens and tom. False pregnancy occurs after every nonpregnant ovulation in the queen, but overt symptoms are uncommon.",
              "pdf_page": 567,
              "printed_page": 485,
              "column": 1
            }
          ]
