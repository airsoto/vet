        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs more frequently affected than cats.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No sex or breed predilections.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "More common in older animals due to increased incidence of malignancy.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No consistent signs.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anorexia.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lethargy.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Depression.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Polyuria and polydipsia.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Blindness, ataxia, seizures, syncope.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bleeding tendencies.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory distress.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Congestive heart failure.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neurologic deficits, including seizures and",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "disorientation.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tachycardia and tachypnea due to volume",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "overload (e.g., congestive heart failure) or",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "pulmonary thromboembolism.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Epistaxis or other mucosal bleeding.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hepatomegaly, splenomegaly, lympha-",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "denopathy.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Visual deficits associated with engorged",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "retinal vessels, retinal hemorrhage or",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "detachment, and papilledema.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
