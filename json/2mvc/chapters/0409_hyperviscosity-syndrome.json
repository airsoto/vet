        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Multiple myeloma and plasma cell tumors— immunoglobulin (Ig) M>IgA>IgG.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lymphocytic leukemia or lymphoma.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Marked polycythemia—hematocrit (HCT) >65%, usually >75%.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic atypical inflammation with monoclonal gammopathy (e.g., ehrlichiosis or leishmaniasis in dogs).",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "CONTRAINDICATIONS/POSSIBLE",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic autoimmune disease (e.g., systemic",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 2,
              "subheading": "CONTRAINDICATIONS/POSSIBLE"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "lupus erythematosus and rheumatoid",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 2,
              "subheading": "CONTRAINDICATIONS/POSSIBLE"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "INTERACTIONS",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "arthritis)—very rare.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Avoid use of medications that might",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "increase vascular volume, including synthetic",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "colloids (e.g., hetastarch); do not try to",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "correct compensatory low albumin.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Avoid medications that alter platelet",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 2,
              "subheading": "INTERACTIONS"
            }
          ]
        }
      }
    },
