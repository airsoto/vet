      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "An assortment of clinical signs caused by high blood viscosity.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Typically results from markedly high concentration of plasma proteins, although can result (rarely) from extremely high erythrocyte or leukocyte counts.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most frequently seen as paraneoplastic syndrome, often associated with multiple myeloma or other lymphoid neoplasms.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Total plasma protein may exceed 10 g/dL (100 g/L), with serum protein electrophoresis showing monoclonal gammopathy or rarely biclonal gammopathy.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical signs caused by reduced blood flow through smaller vessels, high plasma volume, and associated coagulopathy.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Systems affected include hemic/lymphatic/immune, ophthalmic, and nervous; in rare cases, pulmonary thromboembolism may occur.",
              "pdf_page": 798,
              "printed_page": 716,
              "column": 1
            }
          ]
        },
