          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cycad palms, also called sago palms, belong",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "in the family Cycadaceae.",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Native to tropical and subtropical regions but have become popular ornamental plants in the United",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "States.•Cycas revoluta,Cycas circinalis,and",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Zamia floridanaare the most common species.",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 1,
              "subheading": "States.•Cycas revoluta,Cycas circinalis,and"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Contain the toxins cycasin, betamethylamino-l-",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 1,
              "subheading": "States.•Cycas revoluta,Cycas circinalis,and"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "alanine, and an unidentified high-molecular-",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 1,
              "subheading": "States.•Cycas revoluta,Cycas circinalis,and"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "weight compound.",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 1,
              "subheading": "States.•Cycas revoluta,Cycas circinalis,and"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Toxins present in all parts",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 1,
              "subheading": "States.•Cycas revoluta,Cycas circinalis,and"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "of the plant; highest concentrations in seeds.",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 1,
              "subheading": "States.•Cycas revoluta,Cycas circinalis,and"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cycasin is metabolized by the intestinal flora",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 1,
              "subheading": "States.•Cycas revoluta,Cycas circinalis,and"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "to the active hepatotoxic, carcinogenic,",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 1,
              "subheading": "States.•Cycas revoluta,Cycas circinalis,and"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "mutagenic, teratogenic, and neurotoxic",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 1,
              "subheading": "States.•Cycas revoluta,Cycas circinalis,and"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "compound methylazoxymethanol (MAM).",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 1,
              "subheading": "States.•Cycas revoluta,Cycas circinalis,and"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cycad toxicosis has been documented in",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 1,
              "subheading": "States.•Cycas revoluta,Cycas circinalis,and"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "several animal species (dogs and ruminants)",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 1,
              "subheading": "States.•Cycas revoluta,Cycas circinalis,and"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "and humans.",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 1,
              "subheading": "States.•Cycas revoluta,Cycas circinalis,and"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In dogs, gastrointestinal (GI)",
