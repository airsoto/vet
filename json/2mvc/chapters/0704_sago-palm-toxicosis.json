              "printed_page": 1213,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "hemorrhage, edema, etc.).",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gait abnormalities; paresis/paralysis; tremors.",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Depression, coma, and death.",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 1
            }
          ]
        },
