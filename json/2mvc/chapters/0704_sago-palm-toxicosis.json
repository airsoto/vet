        "ALTERNATIVE DRUG(S)": {
          "present": true,
          "status": "content",
          "source_heading": "ALTERNATIVE DRUG(S)",
          "canonical_heading": "ALTERNATIVE DRUG(S)",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "S-Adenosylmethionine—antioxidant and hepatoprotectant; no data on efficacy in sago palm toxicosis available. Dose 20 mg/kg PO",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "q24h.",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ascorbic acid and cimetidine— hepatocyte protectors; no data on efficacy in",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "sago palm toxicosis available. Can be given",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 3
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "for supportive therapy.•N-Acetylcysteine—",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "antioxidant; no data on efficacy in sago palm",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 3,
              "subheading": "for supportive therapy.•N-Acetylcysteine—"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "toxicosis available. A glutathione precursor",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 3,
              "subheading": "for supportive therapy.•N-Acetylcysteine—"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "that can be included in the treatment regimen",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 3,
              "subheading": "for supportive therapy.•N-Acetylcysteine—"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "for acute fulminant hepatic failure at 140 mg/",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 3,
              "subheading": "for supportive therapy.•N-Acetylcysteine—"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "kg IV load, followed by 70 mg/kg IV q6h for",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 3,
              "subheading": "for supportive therapy.•N-Acetylcysteine—"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "7 treatments.",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 3,
              "subheading": "for supportive therapy.•N-Acetylcysteine—"
            }
          ]
        }
      }
