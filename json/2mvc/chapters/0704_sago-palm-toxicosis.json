    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Activated charcoal—multi-dose activated charcoal at 1–4 g/kg PO q4–6h for 2–3 days post ingestion. Mix activated charcoal in water",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "at 1 g/5−10 mL of water.",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "IV fluids— maintain hydration, induce diuresis, correct",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "hypoglycemia.",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dextrose—50% dextrose 1 mL/kg IV slow bolus (1–3 minutes).",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vitamin K1—0.5–1.5 mg/kg SC or IM",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "q12h; 1 mg/kg PO q24h.",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Blood products— dependent on hemostatic test results.",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 2
            }
          ]
        },
