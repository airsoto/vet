        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Hepatic encephalopathy.",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Disseminated",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "intravascular coagulation.",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Renal failure.",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 3
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs develop vomiting within minutes,",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "followed by further GI upset.",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Changes in clinical laboratory values occur after 24–48",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "hours.",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nadir serum albumin levels and nadir platelet counts are important prognostic",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "indicators.",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Liver failure within a few days.",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prognosis is poor to guarded.",
              "pdf_page": 1295,
              "printed_page": 1213,
              "column": 3
            }
          ]
        }
      }
    },
