        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "The course of the disease is chronic for months or even years; in every confirmed case, the neurologic signs have been progressive.",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prognosis is guarded, survival with good quality of life in part of the cases.",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 3
            }
          ]
        }
