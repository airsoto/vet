    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Symptomatic treatment.",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "To control seizures, phenobarbital 2–6 mg/kg PO q12h.",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Corticosteroids can reduce the inflammatory response and improve clinical signs (e.g., prednisolone or prednisone 1–2 mg/kg PO q24h for the first 1–2 weeks; then the dosage can be tapered slowly); frequently used medication: cytosine arabinoside 50 mg/m2SQ q12h for 2-4 days, repeat about every 4 weeks (other dosage regimens possible); other immunosuppressive drugs are used successfully.",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 2
            }
          ]
        },
