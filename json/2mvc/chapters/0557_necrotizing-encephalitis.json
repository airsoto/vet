          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Breed Predilections",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Maltese, pugs, Yorkshire terriers, French",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "bulldogs, Chihuahuas, shih tzus, Pekingese,",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and other toy breeds.",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Mean Age and Range",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Mostly young adult dogs (range 4 months–10",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 1,
              "subheading": "Mean Age and Range"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "years).",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 1,
              "subheading": "Mean Age and Range"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Predominant Sex",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "No sex predilection.",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 1,
              "subheading": "Predominant Sex"
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Progressive signs related to a forebrain lesion (abnormal behavior, seizures, circling, blindness), brainstem lesions with central vestibular signs, or a multifocal lesion.",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 1
            }
          ]
        },
