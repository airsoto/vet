        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Genetic test for predisposition.",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 1
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "MRI—results help support the clinical diagnosis considering breed, age, clinical signs, and course of the disease. Lesions may be asymmetric, multifocal prosencephalic with varying contrast enhancement, and can include multiple cystic areas of necrosis.",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "CSF—pleocytosis with predominantly mononuclear cells; mild to marked protein elevation.",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Brain biopsy—to confirm diagnosis.",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Necrosis and nonsuppurative inflammation of the cerebral gray and white matter; multifocal lesions; active lesions consist of a large malacic gliotic center surrounded by a wall of severe mononuclear inflammation.",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Old lesions consist of rarefied or cystic areas surrounded by intense astroglial sclerosis.",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Inpatient or outpatient based on the neurologic status.",
          "pdf_page": 1045,
          "printed_page": 963,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Symptomatic treatment recommended.",
          "pdf_page": 1045,
          "printed_page": 963,
          "column": 2
        }
      ],
