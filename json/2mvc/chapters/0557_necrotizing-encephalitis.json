  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Historically restricted to a few breeds such as the pug, Yorkshire terrier, and Maltese dog. Described nowadays also in other breeds such as the Chihuahua, the shih tzu, and others. Even described in large-breed dogs. The disease includes necrotizing meningoencephalitis (NME) and necrotizing leukoencephalitis (NLE), since an overlap of clinical signs and histopathologic findings occurs.",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Systems affected—nervous.",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Genetics—a genetic basis (genetic risk loci) detected in pug dogs, Maltese dogs, and toy dog breeds; multifactorial disorder suspected.",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Incidence/prevalence—not determined but disease occurring regularly.",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Geographic distribution—occurs worldwide, mostly seen in toy breeds.",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 1
            }
          ]
        },
