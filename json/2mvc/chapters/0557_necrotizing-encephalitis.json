          "canonical_heading": "CLIENT EDUCATION",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Disease cannot be treated specifically; improvement with anti-inflammatory or immunosuppressive drugs.",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Seizures may be the only sign at onset of the disease in pug dogs; diagnostic workup including MRI in pug dogs presented with seizures is recommended.",
              "pdf_page": 1045,
              "printed_page": 963,
              "column": 2
            }
          ]
        },
