        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Depend on immunologic status of host and degree of initial cytotoxic injury.",
              "pdf_page": 710,
              "printed_page": 628,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Peracute—fever; CNS signs; vascular collapse; disseminated intravascular coagulation (DIC); death within hours.",
              "pdf_page": 710,
              "printed_page": 628,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute—fever; anorexia; lethargy; vomiting; diarrhea; hepatomegaly; abdominal pain; abdominal effusion; vasculitis (petechia, bruising); DIC; lymphadenopathy; rarely, nonsuppurative encephalitis.",
              "pdf_page": 710,
              "printed_page": 628,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Uncomplicated—lethargy; anorexia; transient fever; tonsillitis; vomiting;",
              "pdf_page": 710,
              "printed_page": 628,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "diarrhea; lymphadenopathy; hepatomegaly; parenchyma (multifocal or diffuse pattern), abdominal pain. and effusion.",
              "pdf_page": 710,
              "printed_page": 628,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Late—20% of cases develop anterior",
              "pdf_page": 710,
              "printed_page": 628,
              "column": 2
            }
          ]
        },
