      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Monitor fluid, electrolyte, acid-base, and coagulation status to adjust supportive measures.",
              "pdf_page": 711,
              "printed_page": 629,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Monitor for acute renal failure.",
              "pdf_page": 711,
              "printed_page": 629,
              "column": 2
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "MLV vaccination—at 6–8 weeks of age; two boosters 3–4 weeks apart until 16 weeks of age; booster at 1 year; highly effective vaccine; boosters may not be needed.",
              "pdf_page": 711,
              "printed_page": 629,
              "column": 2
            }
          ]
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Fulminant hepatic failure.",
              "pdf_page": 711,
              "printed_page": 629,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "HE.",
              "pdf_page": 711,
              "printed_page": 629,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Septicemia.",
              "pdf_page": 711,
              "printed_page": 629,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute renal failure.",
              "pdf_page": 711,
              "printed_page": 629,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Glomerulonephritis.",
              "pdf_page": 711,
              "printed_page": 629,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "DIC.",
              "pdf_page": 711,
              "printed_page": 629,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Glaucoma.",
              "pdf_page": 711,
              "printed_page": 629,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic hepatitis.",
              "pdf_page": 711,
              "printed_page": 629,
              "column": 2
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Peracute—poor prognosis; death within hours.",
              "pdf_page": 711,
              "printed_page": 629,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute—variable: guarded to good prognosis.",
              "pdf_page": 711,
              "printed_page": 629,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Poor antibody response (titer 1 : 16–1 : 50)— chronic hepatitis may develop.",
              "pdf_page": 711,
              "printed_page": 629,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Good antibody response (titer>1 : 500 IgG)—complete recovery in 5–7 days possible.",
              "pdf_page": 711,
              "printed_page": 629,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Recovered patients—may develop chronic liver or renal disease.",
              "pdf_page": 711,
              "printed_page": 629,
              "column": 2
            }
          ]
        }
      }
    },
