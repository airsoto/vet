        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Barbiturates—sedation (rarely agitation), ataxia, bradycardia, hypotension, respiratory",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "depression (rare), coma.",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cocaine—agitation, mydriasis, tachycardia, hypertension, tremors,",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "seizures.",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "GHB, opioids—lethargy, weakness,",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "coma, respiratory depression.",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "LSD— mydriasis, disorientation, hallucinations, agitation (rarely sedation), tachycardia.",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "MDMA—agitation, mydriasis, hyper thermia, tachycardia, tremors, hallucinations,",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "PCP—depression to agitation, hypertension, tachycardia, tremors, seizures.",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            }
          ]
        },
