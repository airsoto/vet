  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Intoxication with illicit/club drugs includes various pharmaceuticals—barbiturates, benzodiazepines, cocaine, gamma hydroxy butyric acid (GHB), lysergic acid diethylamide (LSD), marijuana, methylenedioxymetham phetamine (MDMA: ecstasy), methampheta mine and other designer amphetamines, opioids, and phencyclidine (PCP).",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Barbiturates—sedative hypnotics causing",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CNS depression.",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cocaine—myocardial stimulant and increases catecholamine and serotonin levels, causing CNS stimulation.",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "GHB—syntheticγ-aminobutyric acid (GABA) derivative causing CNS depression.",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "LSD—CNS stimulation and hallucinations by increasing serotonin and glutamate in CNS, binds dopamine andα-adrenergic receptors.",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "MDMA—increases serotonin and catechola mines in CNS, leading to CNS stimulation",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "and hallucinations.",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Opioids—bind to opioid",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "receptors causing CNS depression.",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "PCP— inhibits glutamate and stimulatesα-adrenergic receptors; potentiates effects of norepineph rine, epinephrine, and serotonin; sympathomi metic and hallucinogen.",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            }
          ]
        },
        "SYSTEMS AFFECTED": {
          "present": true,
          "status": "content",
          "source_heading": "SYSTEMS AFFECTED",
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cardiovascular—cocaine, GHB, LSD, MDMA, PCP: arrhythmias, hypertension; barbiturates, opioids: arrhythmias, hypo",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "tension.",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Musculoskeletal—cocaine, PCP:",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "tremors.",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nervous—cocaine, LSD, MDMA: stimulation; barbiturates, GHB: depression; opioids, PCP: sedative to stimulatory effects,",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "ataxia.",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ophthalmic—cocaine, LSD, MDMA: mydriasis; opioids: miosis.",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory—barbiturates, opioids: respiratory depression (rare).",
              "pdf_page": 840,
              "printed_page": 758,
              "column": 1
            }
          ]
        },
