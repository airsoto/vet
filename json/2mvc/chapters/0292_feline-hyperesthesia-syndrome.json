  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Idiopathic disorder of cats characterized by paroxysmal agitation, focal epaxial muscle spasms, vocalization, and intense biting or licking of the back, tail, and pelvic limbs.",
              "pdf_page": 585,
              "printed_page": 503,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Also known as atypical neurodermatitis, rolling skin disease, apparent neuritis, and twitchy cat",
              "pdf_page": 585,
              "printed_page": 503,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "disease.",
              "pdf_page": 585,
              "printed_page": 503,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pathophysiology unknown.",
              "pdf_page": 585,
              "printed_page": 503,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Organ systems affected—behavioral, nervous, neuromuscular, skin/exocrine.",
              "pdf_page": 585,
              "printed_page": 503,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
