    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Cats administered phenobarbital—check serum drug concentrations in 2–3 weeks and adjust dosage as needed to maintain levels of 20–30μg/mL (85–130μmol/L); CBC and biochemistry profile at 6–12-month intervals to monitor for adverse effects.",
              "pdf_page": 585,
              "printed_page": 503,
              "column": 3
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
