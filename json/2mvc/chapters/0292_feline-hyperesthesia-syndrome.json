    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Outpatient.",
          "pdf_page": 585,
          "printed_page": 503,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Eliminate environmental changes that can precipitate episodes.",
          "pdf_page": 585,
          "printed_page": 503,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Behavioral modification has been successful in reducing clinical manifestations in some",
          "pdf_page": 585,
          "printed_page": 503,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "cats.",
          "pdf_page": 585,
          "printed_page": 503,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "In severe cases of self-mutilation, Elizabethan collar or tail bandaging may be necessary.",
          "pdf_page": 585,
          "printed_page": 503,
          "column": 2
        }
      ],
