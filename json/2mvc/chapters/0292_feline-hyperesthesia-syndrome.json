        },
        "OTHER LABORATORY TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": []
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "None required aside from that necessary to exclude differential diagnoses.",
              "pdf_page": 585,
              "printed_page": 503,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Diagnosis based on characteristic history and clinical findings, and by excluding other",
              "pdf_page": 585,
              "printed_page": 503,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "diseases that can cause similar signs.",
              "pdf_page": 585,
              "printed_page": 503,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No test or group of tests support definitive diagnosis.",
              "pdf_page": 585,
              "printed_page": 503,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Electromyography (EMG)—evidence of abnormal spontaneous activity in thora columbar epaxial muscles in one study of",
              "pdf_page": 585,
              "printed_page": 503,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "affected cats.",
              "pdf_page": 585,
              "printed_page": 503,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Muscle biopsy—if EMG changes; isolated report of vacuoles within epaxial muscles, with antibody labeling characteristics similar to those described with inclusion body myositis/myopathy in humans.",
              "pdf_page": 585,
              "printed_page": 503,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
