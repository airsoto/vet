          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Prognosis depends on whether underlying cause is identified, response to medication, and frequency and severity of episodes.",
              "pdf_page": 585,
              "printed_page": 503,
              "column": 3
            }
          ]
        }
