    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Several pharmacologic agents recommended, based on suspected underlying cause.",
              "pdf_page": 585,
              "printed_page": 503,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prednisolone indicated if pruritic dermatitis",
              "pdf_page": 585,
              "printed_page": 503,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "suspected.",
              "pdf_page": 585,
              "printed_page": 503,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Antiepileptic drugs often utilized; phenobarbital (1–2 mg/kg PO q12h) effective in some cats; gabapentin (5–10 mg/kg PO q12h) can be used for both antiepileptic and analgesic properties; topiramate (5 mg/kg PO q12h) is antiepileptic that has also been used to",
              "pdf_page": 585,
              "printed_page": 503,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "treat self-mutilation in cats.",
              "pdf_page": 585,
              "printed_page": 503,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Selective serotonin reuptake inhibitors (fluoxetine 0.5–2.0 mg/kg PO q24h), tricyclic antidepressants (clomipramine 0.5–1.0 mg/kg PO q24h), or benzodiazepines (lorazepam 0.125–0.50 mg per cat PO q8–24h) recommended when primary behavioral disorder",
              "pdf_page": 585,
              "printed_page": 503,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "suspected.",
              "pdf_page": 585,
              "printed_page": 503,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Combination therapy often",
              "pdf_page": 585,
              "printed_page": 503,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "required.",
              "pdf_page": 585,
              "printed_page": 503,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Treatment response variable; in cats that respond, therapy often lifelong as episodes tend to resume after medication discontinued.",
              "pdf_page": 585,
              "printed_page": 503,
              "column": 3
            }
          ]
        },
        "CONTRAINDICATIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CONTRAINDICATIONS",
          "content_blocks": []
        },
