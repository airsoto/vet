          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—systemic poisoning.",
              "pdf_page": 916,
              "printed_page": 834,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—only mild gastrointestinal upset, even after ingestion of large quantities of plant material.",
              "pdf_page": 916,
              "printed_page": 834,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No age or breed predilections noted.",
              "pdf_page": 916,
              "printed_page": 834,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Sudden onset of vomiting and drooling— gradually subsides within 4–6 hours.",
              "pdf_page": 916,
              "printed_page": 834,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Depression and anorexia—typically within 12 hours of exposure; both persist throughout",
              "pdf_page": 916,
              "printed_page": 834,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "the syndrome.",
              "pdf_page": 916,
              "printed_page": 834,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Polyuria and dehydration; azotemia by 12–24 hours; progresses to anuric",
              "pdf_page": 916,
              "printed_page": 834,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "renal failure by 24–48 hours.",
              "pdf_page": 916,
              "printed_page": 834,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vomiting— recurs by 36 hours; accompanied by progressive",
              "pdf_page": 916,
              "printed_page": 834,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "weakness.",
              "pdf_page": 916,
              "printed_page": 834,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Recumbency—by 2–4 days.",
              "pdf_page": 916,
              "printed_page": 834,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Death—by 3–7 days post ingestion.",
              "pdf_page": 916,
              "printed_page": 834,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Severe pancreatitis has also been reported but is rare.",
              "pdf_page": 916,
              "printed_page": 834,
              "column": 1
            }
          ]
        },
