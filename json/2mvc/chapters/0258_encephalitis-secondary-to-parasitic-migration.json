        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Cerebrospinal fluid (CSF)—may show eosinophilic, neutrophilic, or mononuclear pleocytosis (also found in protozoal, fungal, and prototheca encephalitides); may be normal (strictly parenchymal lesions).",
              "pdf_page": 526,
              "printed_page": 444,
              "column": 1
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "CT or MRI—brain; focal lesion and/or cerebral infarction from occlusion of cerebral",
              "pdf_page": 526,
              "printed_page": 444,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "vessels. Nonspecific and often inconclusive, but could lead to surgical exploration and removal of migrating parasite.",
              "pdf_page": 526,
              "printed_page": 444,
              "column": 2
            }
          ]
        },
