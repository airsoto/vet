        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dirofilariasis—adult animals only.",
              "pdf_page": 526,
              "printed_page": 444,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other parasites—young dogs and cats with access to outdoors: rare and sporadic occurrence.",
              "pdf_page": 526,
              "printed_page": 444,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Vary with the portion of CNS affected.",
              "pdf_page": 526,
              "printed_page": 444,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Likely asymmetric.",
              "pdf_page": 526,
              "printed_page": 444,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May suggest a focal mass lesion or a multifocal disease process.",
              "pdf_page": 526,
              "printed_page": 444,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cuterebriasis—seasonal (July–October) acute or peracute onset of behavior changes, seizures, visual deficits, etc.; previous history of respiratory disease is common.",
              "pdf_page": 526,
              "printed_page": 444,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rat parasite,Angiostrongylus cantonensis (Australia)—lumbosacral syndrome (hind limbs, tail, and bladder paralysis/paresis) in puppies that may ascend to thoracic limbs and cranial nerves.",
              "pdf_page": 526,
              "printed_page": 444,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
