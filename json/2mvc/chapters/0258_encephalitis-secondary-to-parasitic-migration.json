    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Rule out other causes of focal encephalopathy— infectious diseases (viral, bacterial, protozoan, or fungal); granulomatous meningoencephalomyelitis; brain tumor.",
              "pdf_page": 526,
              "printed_page": 444,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diagnosis often made on necropsy.",
              "pdf_page": 526,
              "printed_page": 444,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Normal unless the parasite also affects non-neural tissues.",
              "pdf_page": 526,
              "printed_page": 444,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
