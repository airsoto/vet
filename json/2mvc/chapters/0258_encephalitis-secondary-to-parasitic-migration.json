      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Aberrant parasitic migration into the CNS.",
              "pdf_page": 526,
              "printed_page": 444,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Parasites usually affect another organ system of the same host (e.g.,Dirofilaria immitis, Taenia,Ancylostoma caninum,Angiostrongylus,",
              "pdf_page": 526,
              "printed_page": 444,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "orToxocara canis) or a different host species",
              "pdf_page": 526,
              "printed_page": 444,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "(e.g., raccoon roundworm,Baylisascaris",
              "pdf_page": 526,
              "printed_page": 444,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "procyonis; skunk roundworm,B. columnaris;",
              "pdf_page": 526,
              "printed_page": 444,
              "column": 1,
              "subheading": "(e.g., raccoon roundworm,Baylisascaris"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Coenurusspp.; orCysticercus cellulosae).",
              "pdf_page": 526,
              "printed_page": 444,
              "column": 1,
              "subheading": "(e.g., raccoon roundworm,Baylisascaris"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Access to CNS—hematogenously (dirofila-",
              "pdf_page": 526,
              "printed_page": 444,
              "column": 1,
              "subheading": "(e.g., raccoon roundworm,Baylisascaris"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "riasis) or through adjacent tissues, including",
              "pdf_page": 526,
              "printed_page": 444,
              "column": 1,
              "subheading": "(e.g., raccoon roundworm,Baylisascaris"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "the middle ear, skull foramina, cribriform",
              "pdf_page": 526,
              "printed_page": 444,
              "column": 1,
              "subheading": "(e.g., raccoon roundworm,Baylisascaris"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "plate through nasal cavities, or open",
              "pdf_page": 526,
              "printed_page": 444,
              "column": 1,
              "subheading": "(e.g., raccoon roundworm,Baylisascaris"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "fontanelles (cuterebraiasis).",
              "pdf_page": 526,
              "printed_page": 444,
              "column": 1,
              "subheading": "(e.g., raccoon roundworm,Baylisascaris"
            }
          ]
        },
