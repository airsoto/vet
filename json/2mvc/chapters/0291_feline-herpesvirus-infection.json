        "DEFINITION": {
          "present": true,
          "status": "content",
          "source_heading": "DEFINITION",
          "canonical_heading": "DEFINITION",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "An acute disease in cats characterized by sneezing, fever, rhinitis, conjunctivitis, and ulcerative keratitis.",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 1
            }
          ]
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Feline herpesvirus-1 (FHV-1) causes acute cytolytic infection of respiratory or ocular epithelium after oral, intranasal, or conjunctival exposure. The intracellular virus travels from cell to cell and does not stimulate a strong immune response from the host.",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 1
            }
          ]
        },
        "SYSTEMS AFFECTED": {
          "present": true,
          "status": "content",
          "source_heading": "SYSTEMS AFFECTED",
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Integumentary—herpes dermatitis near the nares.",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ophthalmic—conjunctivitis with serous or purulent ocular discharge; ulcerative keratitis or panophthalmitis.",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reproductive—in utero infection (infected pregnant queen) may result in severe neonatal herpetic infection.",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory—rhinitis with sneezing and serous to purulent nasal discharge; chronic sinusitis may result; tracheitis possible.",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neurologic—latent virus found in optic nerve, ciliary ganglion, brainstem, cerebellum, and olfactory bulb.",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 1
            }
          ]
        },
        "GENETICS": {
          "present": true,
          "status": "not_applicable",
          "source_heading": "GENETICS",
          "canonical_heading": "GENETICS",
          "content_blocks": [
