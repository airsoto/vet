        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Gross—ocular and nasal discharge, mucosal edema of upper airway epithelium, tracheitis, sinusitis, ulcerative keratitis, panophthalmitis.",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Microscopic—submucosal edema, inflammatory cell infiltrates of upper respiratory and conjunctival tissues, chronic sinusitis, intranuclear inclusion bodies in epithelial cells.",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 3
            }
          ]
        }
      }
    },
