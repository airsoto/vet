    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Antibiotics not recommended if nasal discharge is serous and lacks purulent or mucopurulent component; antibiotics recommended only if fever, lethargy, or anorexia present concurrently with mucopurulent nasal discharge.",
              "pdf_page": 584,
              "printed_page": 502,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Doxycycline (10 mg/kg PO q24h) recommended; amoxicillin (22 mg/kg PO/IM/SC q8–12h) or ampicillin (10–20 mg/kg IV/IM/SC q6–8h) for secondary bacterial infections.",
              "pdf_page": 584,
              "printed_page": 502,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Famciclovir (40–90 mg/kg PO 12h) may shorten course and severity of disease.",
              "pdf_page": 584,
              "printed_page": 502,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ophthalmic antibiotics—for keratitis.",
              "pdf_page": 584,
              "printed_page": 502,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ophthalmic antivirals for herpetic ulcers in order of efficacy—trifluridine, cidofovir, idoxuridine, ganciclovir, aciclovir; must be instilled q2h for significant effect, except for cidofovir which can be given q12h, making it ophthalmic drug of choice, although it must be compounded.",
              "pdf_page": 584,
              "printed_page": 502,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Some evidence that administration of intranasal vaccine 2–6 days prior to exposure will result in lessening of clinical signs; may be helpful in outbreak in multicat setting.",
              "pdf_page": 584,
              "printed_page": 502,
              "column": 1
            }
          ]
        },
        "CONTRAINDICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS",
          "canonical_heading": "CONTRAINDICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Idoxuridine ophthalmic—may be painful; discontinue medication.",
              "pdf_page": 584,
              "printed_page": 502,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cidofovir ophthalmic—scarring of nasolacrimal duct reported in humans, rabbits.",
              "pdf_page": 584,
              "printed_page": 502,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Trifluridine, idoxuridine, acyclovir—toxic if given systemically.",
              "pdf_page": 584,
              "printed_page": 502,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Systemic corticosteroids—may induce relapse in chronically infected cats.",
              "pdf_page": 584,
              "printed_page": 502,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ophthalmic corticosteroids—may predispose to ulcerative keratitis",
              "pdf_page": 584,
              "printed_page": 502,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nasal decongestant drops—0.25% oxymetazoline HCl; decrease nasal discharge; contraindicated because some cats object and some experience rebound rhinorrhea.",
              "pdf_page": 584,
              "printed_page": 502,
              "column": 1
            }
          ]
        },
        "PRECAUTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "PRECAUTIONS",
          "canonical_heading": "PRECAUTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Oral doxycycline tablets can cause esophageal ulceration.",
              "pdf_page": 584,
              "printed_page": 502,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Death usually result of inadequate nutritional and fluid support or immuno suppression due to feline leukemia virus",
              "pdf_page": 584,
              "printed_page": 502,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(FeLV) or feline immunodeficiency virus (FIV).",
              "pdf_page": 584,
              "printed_page": 502,
              "column": 2
            }
          ]
        },
