          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Surgically implanted feeding tubes (esopha gostomy tube, gastrostomy tube) may be needed to manage prolonged anorexia.",
              "pdf_page": 584,
              "printed_page": 502,
              "column": 1
            }
          ]
        },
