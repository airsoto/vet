        "APPROPRIATE HEALTH CARE": {
          "present": true,
          "status": "content",
          "source_heading": "APPROPRIATE HEALTH CARE",
          "canonical_heading": "APPROPRIATE HEALTH CARE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Inpatient—nutritional and fluid support to anorectic cats.",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Outpatient—if eating and afebrile.",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 3
            }
          ]
        },
        "NURSING CARE": {
          "present": true,
          "status": "content",
          "source_heading": "NURSING CARE",
          "canonical_heading": "NURSING CARE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Outpatient—keep patient indoors to prevent environmentally induced stress, which may lengthen disease course.",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fluids—IV or SC; to correct and prevent dehydration; to keep nasal secretions thin.",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Appetite stimulant as needed (mirtazapine—1.8 mg/cat PO q24–48h).",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 3
            }
          ]
        },
        "ACTIVITY": {
          "present": true,
          "status": "content",
          "source_heading": "ACTIVITY",
          "canonical_heading": "ACTIVITY",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Isolate affected cats during acute phase because they are contagious.",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 3
            }
          ]
        },
        "DIET": {
          "present": true,
          "status": "content",
          "source_heading": "DIET",
          "canonical_heading": "DIET",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Outpatient—encourage food consumption to avoid anorexia; offer foods with appealing tastes and smells; warming food may enhance smell.",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inpatient—forced enteral feeding for anorectic cats; remove nasal secretions (so nasal breathing can occur) before starting orogastric or esophagostomy tube feeding; avoid nasoesophageal tubes because of rhinitis.",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 3
            }
          ]
        },
        "CLIENT EDUCATION": {
          "present": true,
          "status": "content",
          "source_heading": "CLIENT EDUCATION",
          "canonical_heading": "CLIENT EDUCATION",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Inform client of contagious nature of disease.",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Discuss proper vaccination protocols and early vaccination of cats in multicat facilities and households.",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inform client that early weaning and isolation from all other cats except littermates may prevent infections.",
              "pdf_page": 584,
              "printed_page": 502,
              "column": 1
            }
          ]
        },
        "SURGICAL CONSIDERATIONS": {
          "present": true,
          "status": "content",
