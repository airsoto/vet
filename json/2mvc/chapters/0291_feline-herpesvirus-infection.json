      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Feline calicivirus infection—less sneezing than FHV-1, conjunctivitis, ulcerative keratitis; may cause ulcerative stomatitis, pneumonia.",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "FelineChlamydophilainfection—more chronic conjunctivitis, which may be unilateral; pneumonitis; intracytoplasmic inclusions in conjunctival scrapings; responds to tetracyclines or chloramphenicol.",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bacterial infection (Bordetella,Haemophilus,",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "orPasteurella)—less nasal and ocular",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "involvement; often respond to antibiotics.",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 2,
              "subheading": "orPasteurella)—less nasal and ocular"
            }
          ]
        },
