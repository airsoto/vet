        "RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "RISK FACTORS",
          "canonical_heading": "RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Lack of vaccination for FHV-1, although vaccines do not bestow sterilizing immunity.",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Multicat facilities with overcrowding, poor ventilation, poor sanitation, poor nutrition, or physical or psychologic stress.",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pregnancy and lactation.",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Concomitant disease, especially owing to immunosuppressive organisms or other respiratory organisms.",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Kittens born to carrier queens—infected ~5 weeks of age.",
              "pdf_page": 583,
              "printed_page": 501,
              "column": 2
            }
          ]
        },
