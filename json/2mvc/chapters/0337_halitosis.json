            {
              "type": "subheading",
              "level": 0,
              "text": "Breed Predilections",
              "pdf_page": 661,
              "printed_page": 579,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Small breeds and brachycephalic breeds are",
              "pdf_page": 661,
              "printed_page": 579,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "more prone to oral disease because the teeth",
              "pdf_page": 661,
              "printed_page": 579,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "are closer together, smaller animals live",
              "pdf_page": 661,
              "printed_page": 579,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "longer, and their owners tend to feed softer",
              "pdf_page": 661,
              "printed_page": 579,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "food.",
              "pdf_page": 661,
              "printed_page": 579,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Mean Age and Range",
              "pdf_page": 661,
              "printed_page": 579,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Older animals are predisposed.",
              "pdf_page": 661,
              "printed_page": 579,
              "column": 1,
              "subheading": "Mean Age and Range"
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "When oral malodor is secondary to oral disease, ptyalism (with or without blood), pawing at mouth, and anorexia may occur.",
              "pdf_page": 661,
              "printed_page": 579,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In most cases, no clinical signs are present other than the odor.",
              "pdf_page": 661,
              "printed_page": 579,
              "column": 2
            }
          ]
        },
        "CAUSES": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES",
          "canonical_heading": "CAUSES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Eating malodorous food.",
              "pdf_page": 661,
              "printed_page": 579,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metabolic—diabetes, uremia.",
              "pdf_page": 661,
              "printed_page": 579,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory—rhinitis, sinusitis, neoplasia.",
              "pdf_page": 661,
              "printed_page": 579,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gastrointestinal—megaesophagus, neoplasia, foreign body.",
              "pdf_page": 661,
              "printed_page": 579,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dermatologic—lip-fold pyoderma.",
              "pdf_page": 661,
              "printed_page": 579,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dietary—fetid foodstuffs, coprophagy.",
              "pdf_page": 661,
              "printed_page": 579,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Oral disease—periodontal disease and ulceration, orthodontic, pharyngitis, tonsillitis, neoplasia, foreign bodies.",
              "pdf_page": 661,
              "printed_page": 579,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Trauma—electric cord injury, open fractures, caustic agents damaging oral cavity.",
              "pdf_page": 661,
              "printed_page": 579,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infectious—bacterial, fungal, viral infections of oral cavity.",
              "pdf_page": 661,
              "printed_page": 579,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Autoimmune diseases of oral cavity.",
              "pdf_page": 661,
              "printed_page": 579,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Eosinophilic granuloma complex.",
              "pdf_page": 661,
              "printed_page": 579,
              "column": 2
            }
          ]
        },
