        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Daily brushing or friction wipes to remove plaque and control dental disease and odor; periodic veterinary examinations to monitor care.",
              "pdf_page": 661,
              "printed_page": 579,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Veterinary Oral Health Council (VOHC. org) was created to accept products that decrease the accumulation of plaque and/or tartar; additionally those products accepted are considered safe to use.",
              "pdf_page": 661,
              "printed_page": 579,
              "column": 3
            }
          ]
        },
