        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Intraoral radiographs are appropriate to help diagnose causes of halitosis.",
              "pdf_page": 661,
              "printed_page": 579,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Hydrogen sulfide, mercaptans, and volatile fatty acids are the primary components of halitosis; an industrial sulfide monitor can be used to measure sulfide concentration in peak parts per billion.",
              "pdf_page": 661,
              "printed_page": 579,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Additional diagnostic procedures to evaluate periodontal disease include intraoral radiography, probing pocket depths, attachment levels, and tooth mobility.",
              "pdf_page": 661,
              "printed_page": 579,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
