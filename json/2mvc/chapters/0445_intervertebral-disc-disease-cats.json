  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Disc extrusion or protrusion causing myelopathy is more common in dogs; both Hansen’s type I and type II disc disease, and acute, noncompressive nucleus pulposus extrusion (ANNPE) are reported in cats.",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Type I disc disease is secondary to chondroid metaplasia and mineralization of the nucleus",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "pulposus.",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Type II disc disease is secondary to fibroid degeneration and protrusion of the",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "annulus fibrosus.",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "With ANNPE, normal nucleus pulposus is extruded through a tear in the dorsal annulus, resulting in a concussive or contusive injury, with minimal to no ongoing compression of the spinal cord.",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
