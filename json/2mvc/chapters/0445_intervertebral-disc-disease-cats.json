        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "For all reported cats with myelopathy secondary to disc disease—mean age 8.4",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "years, range: 1.5–17 years.",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats with mineralized type I disc disease—mean age 7.3",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "years, range: 2–13 years.",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Predominantly domestic breeds, several purebred (Oriental) breeds reported; rare exotic large cat (tiger)",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "reported.",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No sex predisposition.",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Majority of cats have thoracolumbar or lumbosacral disc disease—clinical signs confined to pelvic limbs; cervical disc disease also described, in which case all four limbs may be affected; sacrocaudal disc disease can result in urinary and/or fecal retention or incontinence, lower",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "lumbar pain.",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Signs frequently acute or",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "peracute, but may be chronic.",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Paresis/",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "paralysis.",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ataxia.",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gait abnormality,",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "lameness, reluctance to jump.",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Spinal/back",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "pain.",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urinary/fecal incontinence.",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abnormalities of tail carriage or tone.",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Loss of pain perception (if severe lesion).",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypoventilation (if severe cervical lesion).",
              "pdf_page": 862,
              "printed_page": 780,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
