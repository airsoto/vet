        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "ICD",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute condition—may occur after only one",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 3,
              "subheading": "ICD"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "exposure; can be manifested within 24 hours of",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 3,
              "subheading": "ICD"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "exposure.",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 3,
              "subheading": "ICD"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Corticosteroids rarely helpful.",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 3,
              "subheading": "ICD"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lesions resolve 1–2 days after irritant removal.",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 3,
              "subheading": "ICD"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "ACD",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Requires chronic exposure for hypersensitivity",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 3,
              "subheading": "ACD"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "to develop.",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 3,
              "subheading": "ACD"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reexposure results in development",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 3,
              "subheading": "ACD"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "of clinical signs within 1–5 days; signs may",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 3,
              "subheading": "ACD"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "persist for several weeks.",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 3,
              "subheading": "ACD"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Responds well to",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 3,
              "subheading": "ACD"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "corticosteroids; pruritus returns after discon-",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 3,
              "subheading": "ACD"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "tinuation if antigenic stimulus persists.",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 3,
              "subheading": "ACD"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyposensitization not effective.",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 3,
              "subheading": "ACD"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prognosis—",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 3,
              "subheading": "ACD"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "good if allergen is identified and removed,",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 3,
              "subheading": "ACD"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "otherwise poor: may require lifelong treatment.",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 3,
              "subheading": "ACD"
            }
          ]
        }
      }
