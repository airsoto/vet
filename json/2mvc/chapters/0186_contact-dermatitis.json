        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "ACD—closed-patch test (corticosteroids and nonsteroidal anti-inflammatory drugs [NSAIDs] must be discontinued for 3–6 weeks); materials taken from environment or home applied to upper thorax skin under bandage; examine for erythema, edema, pruritus at 48, 72 hours, and 7 days.",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "ICD—eliminate exposure to contact irritant",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "or antigen, followed by provocation.",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Open patch test—apply substance to inside pinnae; monitor for mild erythema, edema, pruritus;",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "examine daily for 5–15 days.",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Human patch",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "test kits (TRUE Test®).",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Skin biopsy.",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Intraepidermal vesiculation and spongiosis; superficial dermal edema with perivascular mononuclear cell infiltrate in ICD and ACD; polymorphonuclear cell infiltrate in ICD;",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "leukocyte exocytosis common.",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lymphocytic spongiotic or eosinophilic and lymphocytic spongiotic infiltrate with intraepidermal eosinophilic pustules in canine ACD.",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
