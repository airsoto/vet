  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Irritant and allergic contact dermatitis—rare syndromes with similar clinical signs but different pathophysiology; differentiation may be",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "more conceptual.",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Irritant contact dermatitis (ICD)—direct damage to keratinocytes by exposure to particular irritant or sensitizer induces inflammatory response directed at skin",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "without prior sensitization.",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Allergic contact dermatitis (ACD)—type IV (delayed) hypersensitivity: immunologic event requiring sensitization and elicitation; Langerhans cells and keratinocytes interact with environmental haptens to create antigens, leading to sensitization of T-lymphocytes and activation following reexposure with release of cytokines (mainly",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "tumor necrosis factor alpha",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "[TNF-α],",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "IL1βGM-CSF).",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Recent reports blur distinction between ICD, ACD, and atopic dermatitis.",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1
            }
          ]
        },
