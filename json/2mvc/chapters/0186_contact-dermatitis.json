          "printed_page": 325,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Create mechanical barriers, if possible—socks, shirts, restriction from environment.",
          "pdf_page": 407,
          "printed_page": 325,
          "column": 2
        }
