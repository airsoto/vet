        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "ICD—Any age as direct result of irritation",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "from offending chemical.",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "ACD—older dogs; chronic exposure to antigen (months to years); extremely rare in cats, (except exposure to",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "d-limonene-containing insecticides).",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "ACD— German shepherd dog, poodle, wirehaired fox terrier, Scottish terrier, West Highland white terrier, Labrador and golden retriever.",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Lesions",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Location determined by antigen contact;",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1,
              "subheading": "Lesions"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "commonly limited to glabrous skin and",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1,
              "subheading": "Lesions"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "regions frequently in direct contact with the",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1,
              "subheading": "Lesions"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "environment.",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1,
              "subheading": "Lesions"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Extreme erythroderma stops",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1,
              "subheading": "Lesions"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "abruptly at hairline.",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1,
              "subheading": "Lesions"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Initial erythema,",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1,
              "subheading": "Lesions"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "edema, and papules leading to crusts and",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1,
              "subheading": "Lesions"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "excoriations; lichenification and hyperpigmen-",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1,
              "subheading": "Lesions"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "tation with chronicity; vesicles uncommon.",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1,
              "subheading": "Lesions"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Others",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Localized reactions to topical medications.",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1,
              "subheading": "Others"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Generalized reactions to shampoos or",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1,
              "subheading": "Others"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "insecticide sprays.",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1,
              "subheading": "Others"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pruritus—moderate to",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1,
              "subheading": "Others"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "severe (most common).",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1,
              "subheading": "Others"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Seasonal incidence",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1,
              "subheading": "Others"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "may indicate plant or outdoor antigen.",
              "pdf_page": 407,
              "printed_page": 325,
              "column": 1,
              "subheading": "Others"
            }
          ]
        },
        "CAUSES": {
          "present": false,
