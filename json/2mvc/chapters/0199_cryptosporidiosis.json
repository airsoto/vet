        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Sugar and zinc sulfate centrifugal flotation— specific gravity = 1.18–1.3; concentrates fecal oocysts (oocysts are 5μm, routine salt flotation often fails); oocysts best seen with modified acid-fast stain, may have slight pink color.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fecal antigen detection test (ProSpecT",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "CryptosporidiumMicrotiter Assay, Color-Vue",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Cryptosporidium) available for humans.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 2,
              "subheading": "CryptosporidiumMicrotiter Assay, Color-Vue"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fluorescent antibody assay—veterinary",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 2,
              "subheading": "CryptosporidiumMicrotiter Assay, Color-Vue"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "diagnostic laboratories.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 2,
              "subheading": "CryptosporidiumMicrotiter Assay, Color-Vue"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "PCR—commercial laboratories; more",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 2,
              "subheading": "CryptosporidiumMicrotiter Assay, Color-Vue"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "sensitive for diagnosis than other techniques.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 2,
              "subheading": "CryptosporidiumMicrotiter Assay, Color-Vue"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Submitting feces to laboratory—laboratory-",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 2,
              "subheading": "CryptosporidiumMicrotiter Assay, Color-Vue"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "specific protocols; can mix 1 part 100%",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 2,
              "subheading": "CryptosporidiumMicrotiter Assay, Color-Vue"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "formalin with 9 parts feces to inactivate oocysts",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 2,
              "subheading": "CryptosporidiumMicrotiter Assay, Color-Vue"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and decrease health risk to laboratory personnel.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 2,
              "subheading": "CryptosporidiumMicrotiter Assay, Color-Vue"
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
