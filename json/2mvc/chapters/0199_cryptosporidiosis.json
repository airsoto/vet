    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "No drugs currently labeled for animal use in United States.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Paromomycin (Humatin®)—125–165 mg/kg PO q12h for 5 days; aminoglycoside effective in humans with acute intestinal symptoms; may cause nephropathy in young animals with damaged gastrointestinal barrier; monitor urine for casts during therapy.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tylosin—11 mg/kg PO q12h for 28 days; reported effective in cat with concurrent lymphocytic duodenitis.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nitazoxanide (Alinia®)—25 mg/kg PO q24h for 7–28 days; reduces oocyst shedding in cats; associated with vomiting (responsive to antiemetics); used in limited number of",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 3
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "cats.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 3
            }
          ]
        },
