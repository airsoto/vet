        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "C. canis(dogs),C. felis(cats)—ingestion of contaminated water or feces.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Morphologically, intestinalCryptosporidium species very similar.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Some species are host specific (C. canis,C.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "felis); others (C. parvum,C. muris) infect",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "multiple species.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 1,
              "subheading": "felis); others (C. parvum,C. muris) infect"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Immunosuppression—major risk factor;",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 1,
              "subheading": "felis); others (C. parvum,C. muris) infect"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "common causes feline leukemia virus, canine",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 1,
              "subheading": "felis); others (C. parvum,C. muris) infect"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "distemper virus, canine parvovirus, intestinal",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 1,
              "subheading": "felis); others (C. parvum,C. muris) infect"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "lymphoma.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 1,
              "subheading": "felis); others (C. parvum,C. muris) infect"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Immunocompetent animals—usually asympto",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 1,
              "subheading": "felis); others (C. parvum,C. muris) infect"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "matic infection with fecal oocyst shedding.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 1,
              "subheading": "felis); others (C. parvum,C. muris) infect"
            }
          ]
        }
      }
