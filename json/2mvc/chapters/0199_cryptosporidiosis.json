        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "No sex or breed predilection.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—virtually all clinical cases in immunocompromised animals or animals <6 months of age; older dogs can excrete oocysts without clinical signs.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—more common in immuno compromised cats or kittens <6 months of age.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Most infections subclinical.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Principally small bowel diarrhea; large bowel diarrhea reported.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
