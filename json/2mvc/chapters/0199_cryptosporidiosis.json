  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cryptosporidiumspp.—apicomplexan protozoan causing gastrointestinal disease; ubiquitous in nature with worldwide distribution.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infection—sporulated oocysts are ingested, sporozoites are released and penetrate intestinal epithelial cells; after asexual reproduction, merozoites released to infect other cells, sexual reproduction follows, then oocyst shedding.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prepatent period—5–10 days (cats).",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Immunocompetent animals—intestinal disease.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Immunocompromised animals—intestinal, liver, gallbladder, pancreatic, respiratory infection.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—prevalence 0.5% worldwide; 2–17% in the United States.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—prevalence 0–29% worldwide; 2–15% in the United States.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 1
            }
          ]
        },
