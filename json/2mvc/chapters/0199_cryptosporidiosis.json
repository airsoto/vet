        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Gross lesions—enlarged mesenteric lymph nodes, hyperemic intestinal (especially ileal) mucosa; fix specimens in Bouin’s or formalin solution within hours of death; autolysis causes rapid loss of intestinal surface with organisms.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Microscopic lesions—villous atrophy, reactive lymphoid tissue, inflammatory infiltrates in lamina propria; parasites throughout intestines, most numerous in distal small intestine.",
              "pdf_page": 429,
              "printed_page": 347,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Outpatient.",
          "pdf_page": 429,
          "printed_page": 347,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "In immunocompetent animals—diarrhea usually mild and self-limiting; withhold food for 24–48h to control diarrhea; oral glucoseelectrolyte solution if mild diarrhea; parenteral fluids (isotonic with potassium added) if severe diarrhea.",
          "pdf_page": 429,
          "printed_page": 347,
          "column": 2
        }
      ],
