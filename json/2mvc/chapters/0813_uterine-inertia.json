              "printed_page": 1386,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Primary Uterine Inertia",
              "pdf_page": 1468,
              "printed_page": 1386,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Multifactorial—failure to establish a",
              "pdf_page": 1468,
              "printed_page": 1386,
              "column": 1,
              "subheading": "Primary Uterine Inertia"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "normal, progressive myometrial contraction",
              "pdf_page": 1468,
              "printed_page": 1386,
              "column": 1,
              "subheading": "Primary Uterine Inertia"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "pattern.",
              "pdf_page": 1468,
              "printed_page": 1386,
              "column": 1,
              "subheading": "Primary Uterine Inertia"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Seen in bitches with fewer than 3 puppies",
              "pdf_page": 1468,
              "printed_page": 1386,
              "column": 1,
              "subheading": "Primary Uterine Inertia"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "in the litter—failure to initiate parturition at",
              "pdf_page": 1468,
              "printed_page": 1386,
              "column": 1,
              "subheading": "Primary Uterine Inertia"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "term.",
              "pdf_page": 1468,
              "printed_page": 1386,
              "column": 1,
              "subheading": "Primary Uterine Inertia"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Occurs with large litter sizes—over",
              "pdf_page": 1468,
              "printed_page": 1386,
              "column": 1,
              "subheading": "Primary Uterine Inertia"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "stretching of the uterus.",
              "pdf_page": 1468,
              "printed_page": 1386,
              "column": 1,
              "subheading": "Primary Uterine Inertia"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Secondary Uterine Inertia",
