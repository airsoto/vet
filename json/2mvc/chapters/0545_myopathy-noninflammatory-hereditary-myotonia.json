        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Congenital myotonia—chow chows, miniature schnauzers and Australian cattledogs; rarely seen in other dog breeds.",
              "pdf_page": 1026,
              "printed_page": 944,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical signs seen when affected puppies begin to walk.",
              "pdf_page": 1026,
              "printed_page": 944,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acquired myotonia—all breeds of any age potentially susceptible.",
              "pdf_page": 1026,
              "printed_page": 944,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Myotonia reported in young domestic cats.",
              "pdf_page": 1026,
              "printed_page": 944,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neuromyotonia and myokymia (CMFA)— described in predominantly young JRTs worldwide, rarely in other breeds, and a cat.",
              "pdf_page": 1026,
              "printed_page": 944,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Difficulty rising.",
              "pdf_page": 1026,
              "printed_page": 944,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Stiffness after rest or initiation of activity.",
              "pdf_page": 1026,
              "printed_page": 944,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May note dyspnea, voice change, dysphagia, and/or regurgitation, especially after eating.",
              "pdf_page": 1026,
              "printed_page": 944,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May improve with exercise.",
              "pdf_page": 1026,
              "printed_page": 944,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May be exacerbated by cold.",
              "pdf_page": 1026,
              "printed_page": 944,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Muscle stiffness and myokymia observed in young JRTs may result in life-threatening hyperthermia. In this breed clinical signs are episodic but dogs may have continuous ataxia.",
              "pdf_page": 1026,
              "printed_page": 944,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 1026,
              "printed_page": 944,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypertrophy of proximal limb muscles,",
              "pdf_page": 1026,
              "printed_page": 944,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "neck muscles, and tongue.",
