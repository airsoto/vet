              "printed_page": 944,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tongue may protrude from the mouth.",
              "pdf_page": 1026,
              "printed_page": 944,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abduction of thoracic limbs.",
