              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "cyanotic.",
              "pdf_page": 1026,
              "printed_page": 944,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affected miniature schnauzers may have",
