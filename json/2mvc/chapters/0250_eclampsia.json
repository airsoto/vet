    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Emergency inpatient.",
          "pdf_page": 515,
          "printed_page": 433,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Hyperthermia—cool by wetting haircoat and exposing to breeze from fan.",
          "pdf_page": 515,
          "printed_page": 433,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Puppies—remove from dam onto a foster dam or hand-raise; if not possible or undesirable due to behavioral need for contact with dam, remove pups from dam for 24 hours, or until serum calcium is stabilized, and provide supplemental calcium for remainder of lactation; continue to monitor serum calcium level.",
          "pdf_page": 515,
          "printed_page": 433,
          "column": 2
        }
      ],
