        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Calcium supplementation during gestation, including dairy products.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inappropriate Ca : P ratio in gestational",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1
            }
          ]
        }
      }
