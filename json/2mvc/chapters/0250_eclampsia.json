      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Postparturient hypocalcemia.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually develops 1–4 weeks postpartum; may occur at term, prepartum, or during late lactation.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypocalcemia alters cell membrane potentials, causing spontaneous discharge of nerve fibers and tonic–clonic contraction of skeletal muscles.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Life-threatening tetany and convulsions, leading to hyperthermia.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cerebral edema possible.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1
            }
          ]
        },
