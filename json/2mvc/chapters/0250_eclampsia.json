      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Serum calcium concentration—monitor until stabilized in the normal range.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Avoid calcium supplementation during gestation.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diet—maternal: ensure calcium : phosphorus ratio of 1.1 : 1 or 1.2 : 1; avoid high-phytate foods (e.g., soybeans); puppies: supplement feeding for large litters.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 3
            }
          ]
        },
