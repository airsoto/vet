    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Calcium gluconate—10% solution 0.22–0.44 mL/kg IV given slowly to effect over 5 min; monitor heart rate or ECG during administration; corresponds to dosage of 50–150 mg/kg.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Correct hypoglycemia—50% dextrose: 0.5 g/kg diluted 1 : 3 with saline IV; can supplement maintenance IV fluids to 2.5% or 5% dextrose for longer-term treatment.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diazepam—0.5 mg/kg IV; for unresponsive seizures.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cerebral edema—if present, can treat with mannitol: 0.25–0.5 g/kg IV over 20 min, or",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "7.2% hypertonic saline 1–3 mL/kg IV over 15–20 min.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Long-term therapy—calcium carbonate or calcium gluconate 10–30 mg/kg PO q8h until lactation ends (calcium carbonate 500 mg tablets supply 200 mg calcium).",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Magnesium supplementation may be helpful in hypomagnesemic bitches.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Start puppies/kittens on solid food at 3–4 weeks of age.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 3
            }
          ]
        },
