        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog—postpartum bitch; most common in toy breeds; higher incidence with first litter.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most common prior to day 40 postpartum; occasionally occurs prepartum.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Breeds at increased risk—chihuahua, miniature pinscher, shih tzu, miniature poodle, Xoloitzcuintli, Pomeranian.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cat—rare.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Poor mothering.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Restlessness, nervousness.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Panting, whining.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vomiting, diarrhea.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ataxia, stiff gait, limb pain.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Facial pruritis.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Muscle tremors, tetany, convulsions.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Recumbency, extensor rigidity—usually",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "seen 8–12 hours after onset of signs.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperthermia.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rapid respiratory rate.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dilated pupils, sluggish pupillary light",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "responses.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Muscle tremors, muscular rigidity,",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "convulsions.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
