    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Hypoglycemia—may be concurrent.",
          "pdf_page": 515,
          "printed_page": 433,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Hypomagnesemia has been reported in 44% of affected bitches; may promote tetany.",
          "pdf_page": 515,
          "printed_page": 433,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Serum potassium elevated in 56% of cases, due to metabolic acidosis or respiratory alkalosis.",
          "pdf_page": 515,
          "printed_page": 433,
          "column": 2
        }
      ],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypoglycemia—may be concurrent; hypoglycemia alone does not cause muscular rigidity.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Toxicosis—distinguished by signalment and history.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Epilepsy or other neurologic disorder— differentiated by signalment; calcium concentration diagnostic.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Total serum calcium<9 mg/dL in bitches; <8 mg/dL in queens.",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Although ionized calcium (<2.4–3.2 mg/dL) is the form important for normal neuro muscular function, measurement of total serum calcium is usually sufficient for",
              "pdf_page": 515,
              "printed_page": 433,
              "column": 2
            }
          ]
        },
