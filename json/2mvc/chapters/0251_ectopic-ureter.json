        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog and cat.",
              "pdf_page": 516,
              "printed_page": 434,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Juvenile incontinent dogs.",
              "pdf_page": 516,
              "printed_page": 434,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infrequently reported in cats and male dogs; 20 : 1 ratio of female : male dogs.",
              "pdf_page": 516,
              "printed_page": 434,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog breeds may be predisposed—retrievers, Siberian huskies, Newfoundlands, poodles, terriers.",
              "pdf_page": 516,
              "printed_page": 434,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Constant or intermittent incontinence since birth.",
              "pdf_page": 516,
              "printed_page": 434,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Normal voiding in some.",
              "pdf_page": 516,
              "printed_page": 434,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic urinary tract infection(s) (UTIs).",
              "pdf_page": 516,
              "printed_page": 434,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May be asymptomatic (male dogs) and can have moderate to severe hydroureter/hydronephrosis.",
              "pdf_page": 516,
              "printed_page": 434,
              "column": 1
            }
          ]
        },
