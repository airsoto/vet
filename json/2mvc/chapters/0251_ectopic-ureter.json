        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Urine bacterial culture and sensitivity—via cystocentesis.",
              "pdf_page": 516,
              "printed_page": 434,
              "column": 1
            }
