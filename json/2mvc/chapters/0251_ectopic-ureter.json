    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Ureterocele.",
          "pdf_page": 516,
          "printed_page": 434,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Cystoscopic-guided laser ablation (CLA)—",
          "pdf_page": 516,
          "printed_page": 434,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Pelvic bladder. performed for intramural EU only. Opens",
          "pdf_page": 516,
          "printed_page": 434,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Persistent paramesonephric remnant. ureteral tract in a minimally invasive manner;",
          "pdf_page": 516,
          "printed_page": 434,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Vaginal septum. addresses concurrent vaginal defects, which",
          "pdf_page": 516,
          "printed_page": 434,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Renal dysplasia. may lead to considerable deviation of the",
          "pdf_page": 516,
          "printed_page": 434,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Renal agenesis. urethra. Patients treated with CLA typically",
          "pdf_page": 516,
          "printed_page": 434,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "USMI. discharged the same day.",
          "pdf_page": 516,
          "printed_page": 434,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Short urethra/intrapelvic bladder.",
          "pdf_page": 516,
          "printed_page": 434,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgical—treatment of choice for extra",
          "pdf_page": 516,
