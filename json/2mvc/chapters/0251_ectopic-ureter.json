              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inappropriate urination—urge incontinence, “overactive bladder,” behavioral (conscious urination).",
              "pdf_page": 516,
              "printed_page": 434,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "UTI—pollakiuria and urge incontinence.",
              "pdf_page": 516,
              "printed_page": 434,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vaginal pooling.",
              "pdf_page": 516,
              "printed_page": 434,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Congenital hydroureter/hydronephrosis— male dogs with ectopic ureter(s) (EUs) often continent.",
              "pdf_page": 516,
              "printed_page": 434,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Short urethra/intrapelvic bladder syndrome.",
              "pdf_page": 516,
              "printed_page": 434,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Labwork is typically normal, except when patients have concurrent anomalies (e.g., renal dysplasia, pyelonephritis).",
              "pdf_page": 516,
              "printed_page": 434,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
