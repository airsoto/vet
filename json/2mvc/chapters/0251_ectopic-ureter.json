        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cystoscopy (96% sensitivity).",
              "pdf_page": 516,
              "printed_page": 434,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CT (91% sensitivity).",
              "pdf_page": 516,
              "printed_page": 434,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urinary tract ultrasonography (60–91% sensitivity) can provide accurate diagnosis and anatomic information of the upper urinary tract. Color-flow Doppler ultrasonography",
              "pdf_page": 516,
              "printed_page": 434,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "with placement of a hydraulic occlude. Cystoscopy—definitive diagnosis and characterization of EU, short urethra syndrome, location of ectopic orifice in the genitourinary tract. Also allows for simultane ous treatment.",
              "pdf_page": 516,
              "printed_page": 434,
              "column": 2
