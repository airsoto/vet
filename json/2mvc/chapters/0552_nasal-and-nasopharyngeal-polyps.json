    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Excisional biopsy for nasal polyps.",
          "pdf_page": 1037,
          "printed_page": 955,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Traction removal of nasopharyngeal polyps via oral cavity.",
          "pdf_page": 1037,
          "printed_page": 955,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Ventral bulla osteotomy for nasopharyngeal polyps to release stalk and remove epithelial lining; may decrease rate of recurrence of polyps. Recommended if bullous involvement (clinical evidence of otitis media) is apparent.",
          "pdf_page": 1037,
          "printed_page": 955,
          "column": 2
        }
      ],
