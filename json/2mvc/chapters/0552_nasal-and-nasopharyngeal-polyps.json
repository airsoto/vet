        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Nasal polyps—middle-aged to older dogs and cats.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nasopharyngeal polyps—typically kittens and young adult cats, but can be seen in older cats (months—15 years), rarely seen in dogs.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Nasal Polyps",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic mucopurulent nasal discharge.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 1,
              "subheading": "Nasal Polyps"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Noisy breathing—stertor.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 1,
              "subheading": "Nasal Polyps"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nasal congestion and/or discharge.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 1,
              "subheading": "Nasal Polyps"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sneezing or epistaxis.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 1,
              "subheading": "Nasal Polyps"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Decreased nasal airflow, generally unilateral.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 1,
              "subheading": "Nasal Polyps"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Generally nonresponsive to antibiotics.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 1,
              "subheading": "Nasal Polyps"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Nasopharyngeal or Aural Polyps",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inspiratory stridor.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 1,
              "subheading": "Nasopharyngeal or Aural Polyps"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gagging.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 1,
              "subheading": "Nasopharyngeal or Aural Polyps"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cyanosis.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 1,
              "subheading": "Nasopharyngeal or Aural Polyps"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Voice change.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 1,
              "subheading": "Nasopharyngeal or Aural Polyps"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dysphagia.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 1,
              "subheading": "Nasopharyngeal or Aural Polyps"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic otitis externa/otitis media.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 1,
              "subheading": "Nasopharyngeal or Aural Polyps"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Head tilt.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 1,
              "subheading": "Nasopharyngeal or Aural Polyps"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nystagmus.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 1,
              "subheading": "Nasopharyngeal or Aural Polyps"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ataxia.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 1,
              "subheading": "Nasopharyngeal or Aural Polyps"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Horner’s syndrome.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 1,
              "subheading": "Nasopharyngeal or Aural Polyps"
            }
          ]
        },
