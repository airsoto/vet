          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Feline upper respiratory disease complex.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nasopharyngeal stenosis.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic otitis externa or media.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nasal or nasopharyngeal foreign body.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Laryngeal paralysis.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nasal neoplasia—lymphoma, nasal adenocarcinoma.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Laryngeal neoplasia—squamous cell carcinoma, lymphoma, adenocarcinoma.",
