    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Incomplete removal of polyp and stalk may result in recurrence.",
          "pdf_page": 1037,
          "printed_page": 955,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Horner’s syndrome can occur following removal by traction or ventral bulla osteotomy; usually transient but can be permanent.",
          "pdf_page": 1037,
          "printed_page": 955,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Facial paresis or paralysis or vestibular syndrome may develop after bulla osteotomy but is generally transient.",
          "pdf_page": 1037,
          "printed_page": 955,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Prognosis excellent with complete removal.",
          "pdf_page": 1037,
          "printed_page": 955,
          "column": 3
        }
