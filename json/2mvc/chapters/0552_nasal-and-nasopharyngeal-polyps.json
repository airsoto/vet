        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Feline leukemia virus/feline immunodeficiency virus (FeLV/FIV)—general retroviral screening.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Skull radiographs—soft tissue density within nasal cavity, nasopharynx, tympanic bulla, external ear canal; 25% false-negative rate.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CT and MRI—better sensitivity for nasal, nasopharyngeal, and aural masses.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Digital palpation of soft palate, visual examination of the nasopharynx and larynx under general anesthesia utilizing spay hook, dental mirror, and laryngoscope.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Flexible fiber-optic caudal rhinoscopy to examine the dorsal nasopharynx, choanae, and caudal nasal cavity.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rigid rostral rhinoscopy to examine the nasal cavity.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Deep otoscopic examination.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fine-needle aspirate and/or biopsy.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytology and histopathology.",
              "pdf_page": 1037,
              "printed_page": 955,
              "column": 2
            }
          ]
        },
