              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "(dogs).",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Foreign body.",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thrombocytopenia",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "or other coagulopathy.",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tooth root abscess.",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Oronasal fistula.",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1
            }
          ]
        },
