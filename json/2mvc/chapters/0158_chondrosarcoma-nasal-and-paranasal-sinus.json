          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other nasal tumors—adenocarcinoma, squamous cell carcinoma, osteosarcoma, fibrosarcoma, lymphoma, transmissible venereal tumor (dogs), nasopharyngeal polyp",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "(cats).",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fungal rhinitis—aspergillosis and penicilliosis (dogs), cryptococcus (cats),",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "sporotrichosis (both).",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rhinosporidiosis",
              "pdf_page": 352,
