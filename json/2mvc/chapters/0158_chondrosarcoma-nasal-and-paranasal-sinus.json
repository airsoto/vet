      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Chondrosarcoma (CSA) is a malignant mesenchymal tumor arising from cartilage and characterized by production of chondroid",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "and fibrillar matrix.",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nasal CSA arises most",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "commonly from the nasal turbinates.",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In dogs, CSA accounts for 15% of all nasal tumors.",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1
            }
          ]
        },
