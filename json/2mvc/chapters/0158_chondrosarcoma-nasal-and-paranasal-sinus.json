        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "months.",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Recurrence/progression of tumor",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Blood pressure, to rule out systemic hyperand recurrence of clinical signs generally",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "tension as cause for epistaxis.",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mandibular",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "life-limiting event for nasal CSA.",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Brain lymph node cytology to screen for possible involvement is poor prognostic sign.",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "metastasis.",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rhinoscopy is helpful for",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Unilateral versus bilateral involvement is visualization of mass or fungal plaque and not significant prognostic factor.",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "guiding subsequent tissue biopsy.",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tissue biopsy and histopathology needed for definitive diagnosis; biopsy instrument should not pass caudal to level of medial canthus of eye to avoid penetrating cribriform plate.",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 2
            }
          ]
        },
