        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Mixed-breed dogs, Labrador retrievers, golden retrievers, boxers, and German",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "shepherd dogs are overrepresented.",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Median",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "age is 7 years (range: 2–13 years).",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CSA tends to develop at a younger age than other",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "nasal tumors.",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rare in cats, with no obvious breed or sex predilections.",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intermittent unilateral epistaxis and/or",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "mucopurulent discharge, may progress to",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "bilateral involvement.",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sneezing, stertorous",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "breathing, and/or facial deformity.",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Decreased",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "appetite and/or halitosis secondary to oral cavity",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "invasion.",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Seizures, behavior changes, and/or",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "obtundation secondary to cranial invasion.",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Epistaxis and/or nasal discharge, initially",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "unilateral but can progress to bilateral.",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Decreased nasal air flow (unilateral or",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "bilateral).",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pain on nasal or paranasal sinus",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "palpation or percussion.",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Facial deformity,",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "decreased ocular retropulsion, exophthalmia,",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "or epiphora.",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Visible mass effect protruding",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "through the palate into the oral cavity.",
              "pdf_page": 352,
              "printed_page": 270,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
