          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog and cat.",
              "pdf_page": 1150,
              "printed_page": 1068,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Age when clinical signs first occur varies; more than one-third of patients are 4 years of age or older.",
              "pdf_page": 1150,
              "printed_page": 1068,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Weimaraners and Persians may be predisposed.",
              "pdf_page": 1150,
              "printed_page": 1068,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No evidence that lesions are hereditary, but they have been reported in littermates.",
              "pdf_page": 1150,
              "printed_page": 1068,
              "column": 1
            }
          ]
        },
