              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Cats",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May have no clinical signs.",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lymphoid",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hyperplasia, uveitis, endocarditis (rare),",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "self-limiting fever.",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Between 5 and 60%",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "seropositive, depending on geographic area.",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Dogs",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Nonspecific; include lethargy, fever, lymphad-",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "enomegaly, uveitis, or chorioretinitis, and may",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "include signs consistent with endocarditis (e.g.",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "weakness, cardiac arrhythmias), encephalitis",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(e.g. seizures, ataxia), myocarditis, vasculitis,",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "rhinitis, angioproliferative lesions, or arthritis.",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1,
              "subheading": "Dogs"
            }
          ]
        },
