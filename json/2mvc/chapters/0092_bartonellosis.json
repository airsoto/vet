        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Veterinarians are at occupational risk of",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Histopathology of lymph nodes—nonspecific",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "infection from exposure.",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Human disease inflammatory reaction: granulomas, micromanifested as erythema followed by unilateral",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "abscesses, and necrosis.",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Warthin–Starry regional lymphadenopathy (painful, often silver stain—bacilli in lesions. suppurative) in 3–10 days. Infection may be",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Immunohistochemistry, alone or with PCR accompanied by fever, malaise, myalgia, nausea. to identify bacteria. Atypical infections may result in encephalopathy, meningitis, palpebral conjunctivitis, endocarditis, hepatitis, other systemic manifestations.",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 2
            }
          ]
        }
