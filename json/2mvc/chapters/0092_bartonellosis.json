      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Small, facultative, fastidious intracellular argyrophilic, hemotrophic Gram-negative rod",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "(bacilli) bacteria.",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Emerging, vectortransmitted (fleas, ticks); adapted to reservoir hosts, establishes chronic, intraerythrocytic",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "bacteremia.",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—usually asymptomatic,",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "reservoir host.",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—emerging clinical",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "syndrome.",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Seasonal—more cases reported",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "between July and January.",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Human syndrome— variable; cat scratch disease most common;",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "worldwide, estimate>25,000 cases/year in",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "United States; few fatalities.",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1,
              "subheading": "worldwide, estimate>25,000 cases/year in"
            }
          ]
        },
