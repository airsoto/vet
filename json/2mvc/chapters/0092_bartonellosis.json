        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—flea and tick exposure, rural",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "environment.",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bartonella associated with clinical illness in dogs and cats include Bartonella henselae,B. clarridgeiae, B. koehlerae,B. quintana,B. vinsoniissp. berkhoffii,B. rochalimae,B. elizabethae.",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Human disease associated with contact with cats (>90%), particularly young cats with fleas.",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1
            }
          ]
        }
      }
    },
