          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Serology—indirect fluorescent antibody, ELISA, and western immunoblot.",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Fourfold rise in antibody titer over a",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "2–3-week period consistent with infection.",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Good specificity, poor sensitivity.",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Acutely",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "ill bacteremic animals may not have detectable antibodies.",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "PCR amplification of bacterial DNA—on",
              "pdf_page": 246,
              "printed_page": 164,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "One episode appears to confer lifelong blood, body fluids, fresh or fresh frozen",
              "pdf_page": 246,
