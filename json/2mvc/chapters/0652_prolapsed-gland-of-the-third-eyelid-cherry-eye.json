        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog and cat.",
              "pdf_page": 1209,
              "printed_page": 1127,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog—usually in young dogs (6 months to 2 years of age); common breeds: American cocker spaniel, English bulldog, beagle, bloodhound, Lhasa apso, mastiff, shih tzu, other brachycephalic breeds.",
              "pdf_page": 1209,
              "printed_page": 1127,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cat—rare; occurs in Burmese, Persians, and has been reported in domestic shorthair cats.",
              "pdf_page": 1209,
              "printed_page": 1127,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Oval, hyperemic mass protruding from behind the leading edge of the third eyelid in the medial canthus.",
              "pdf_page": 1209,
              "printed_page": 1127,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May be unilateral or bilateral.",
              "pdf_page": 1209,
              "printed_page": 1127,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May see signs of epiphora, hyperemic conjunctiva, keratitis, or blepharospasm.",
              "pdf_page": 1209,
              "printed_page": 1127,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Additional swelling and hyperemia of the exposed gland can result from environmental exposure leading to irritation and desiccation.",
              "pdf_page": 1209,
              "printed_page": 1127,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Congenital weakness of the attachment of the gland of the third eyelid.",
              "pdf_page": 1209,
              "printed_page": 1127,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inheritance unknown but considered complex and multigenic.",
              "pdf_page": 1209,
              "printed_page": 1127,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Scrolled or everted cartilage of the third eyelid—seen in Weimaraner, Great Dane, German shorthaired pointer, and other breeds in which the T-shaped cartilage of the third eyelid is rolled away from the surface of the cornea instead of conforming to the surface of the cornea.",
              "pdf_page": 1209,
              "printed_page": 1127,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neoplasia of the third eyelid—usually seen in older animals. Most common third eyelid neoplasms in the dog are adenocarcinoma, adenoma, and squamous cell carcinoma. May also see lymphoma or fibrosarcoma. Most common third eyelid neoplasms in the cat are adenocarcinoma followed by squamous cell carcinoma. A small incisional biopsy is indicated to differentiate.",
              "pdf_page": 1209,
              "printed_page": 1127,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Orbital fat prolapse—may dissect anteriorly between the conjunctiva and globe; occasionally occurs in the medial canthus.",
              "pdf_page": 1209,
              "printed_page": 1127,
              "column": 1
            }
          ]
        },
