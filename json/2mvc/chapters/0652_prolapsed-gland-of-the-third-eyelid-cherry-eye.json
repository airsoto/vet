    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Recurrence—5–20%, depending on the breed, with large-breed dogs (e.g., mastiff) having the highest recurrence rates; rereplacement of the gland is encouraged.",
          "pdf_page": 1209,
          "printed_page": 1127,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "If unilateral, warn client that the other gland may also prolapse and that no preventive procedure or medication exists.",
          "pdf_page": 1209,
          "printed_page": 1127,
          "column": 2
        }
      ],
