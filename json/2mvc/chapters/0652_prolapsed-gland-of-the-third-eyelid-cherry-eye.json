  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Definition—prolapsed gland of the third eyelid.",
              "pdf_page": 1209,
              "printed_page": 1127,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pathophysiology—the gland is normally anchored by a fibrous attachment to the periorbita beneath the third eyelid. In cases of prolapse these attachments are weak, resulting in dorsal movement of the gland. Commonly occurs in dogs and rarely in cats; animals may have unilateral or bilateral prolapse.",
              "pdf_page": 1209,
              "printed_page": 1127,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
