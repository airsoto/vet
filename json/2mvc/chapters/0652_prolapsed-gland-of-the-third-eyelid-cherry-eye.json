    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgical replacement of the gland (various techniques can be performed)—see Suggested Reading.",
          "pdf_page": 1209,
          "printed_page": 1127,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Gland excision contraindicated; gland can produce up to 50% (or more) of the aqueous tear film; puts patient at substantial risk for developing keratoconjunctivitis sicca as the dog ages. Excision may be considered if neoplasia is confirmed, although potential complications and risks should be discussed.",
          "pdf_page": 1209,
          "printed_page": 1127,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Elizabethan collar—to prevent self-trauma.",
          "pdf_page": 1209,
          "printed_page": 1127,
          "column": 2
        }
      ],
