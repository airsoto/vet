              "printed_page": 440,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Singed hair or whiskers.",
              "pdf_page": 522,
              "printed_page": 440,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most common clinical signs are related to acute",
              "pdf_page": 522,
              "printed_page": 440,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "dyspnea.",
