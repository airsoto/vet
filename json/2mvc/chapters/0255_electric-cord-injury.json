    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Left-sided congestive heart failure due to congenital or acquired heart disease; the presence of cardiac murmur or dysrhythmia may help differentiate; however, dysrhythmias may be seen with electric cord injury.",
              "pdf_page": 522,
              "printed_page": 440,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vitamin K antagonist, rodenticide intoxication history (pulmonary hemorrhage).",
              "pdf_page": 522,
              "printed_page": 440,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic trauma (pulmonary contusions)—",
              "pdf_page": 522,
              "printed_page": 440,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "history, thoracic radiographs.",
              "pdf_page": 522,
              "printed_page": 440,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other causes of noncardiogenic pulmonary edema.",
              "pdf_page": 522,
              "printed_page": 440,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pleural space disease—muffled lung sounds during auscultation, thoracic radiographs.",
              "pdf_page": 522,
              "printed_page": 440,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thermal or chemical injuries—history, physical examination, thoracic radiographs.",
              "pdf_page": 522,
              "printed_page": 440,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exposure to fire and smoke inhalation—",
              "pdf_page": 522,
              "printed_page": 440,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "history, physical examination.",
              "pdf_page": 522,
              "printed_page": 440,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Atypical",
              "pdf_page": 522,
              "printed_page": 440,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "pneumonia—history, physical examination,",
              "pdf_page": 522,
              "printed_page": 440,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "required.",
              "pdf_page": 522,
              "printed_page": 440,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Oral and cutaneous burns—treated thoracic radiographs. symptomatically.",
              "pdf_page": 522,
              "printed_page": 440,
              "column": 2
            }
          ]
        },
