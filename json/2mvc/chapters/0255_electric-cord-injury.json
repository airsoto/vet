        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Most commonly dogs; also cats.",
              "pdf_page": 522,
              "printed_page": 440,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most commonly young animals; in published report age ranged from 5 months to 1.5 years.",
              "pdf_page": 522,
              "printed_page": 440,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No breed or sex predilections.",
              "pdf_page": 522,
              "printed_page": 440,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No genetic basis.",
              "pdf_page": 522,
              "printed_page": 440,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Burns associated with gingiva, tongue,",
