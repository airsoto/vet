        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Physical and neurologic examinations—",
              "pdf_page": 1036,
              "printed_page": 954,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "normal except during an episode.",
              "pdf_page": 1036,
              "printed_page": 954,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Onset—",
              "pdf_page": 1036,
              "printed_page": 954,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "peracute.",
              "pdf_page": 1036,
              "printed_page": 954,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Excessive daytime sleepiness and fragmented sleep patterns reported in domestic animals, but cataplexy is usually the clinical sign recognized by owners.",
              "pdf_page": 1036,
              "printed_page": 954,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cataplexy episodes—acute onset of flaccid paralysis without loss of consciousness lasting a few seconds to minutes (up to 20 minutes) with sudden return to normal;",
              "pdf_page": 1036,
              "printed_page": 954,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "multiple episodes in 1 day.",
              "pdf_page": 1036,
              "printed_page": 954,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Narcolepsy— eye movements, muscular twitching, and whining (as in REM sleep) frequently",
              "pdf_page": 1036,
              "printed_page": 954,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "observed during episodes.",
              "pdf_page": 1036,
              "printed_page": 954,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Patients are usually aroused by loud noises, petting, or other external stimuli.",
              "pdf_page": 1036,
              "printed_page": 954,
              "column": 1
            }
          ]
        },
