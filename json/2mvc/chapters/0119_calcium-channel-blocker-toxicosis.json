    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Emesis if asymptomatic and <2 hours after",
          "pdf_page": 287,
          "printed_page": 205,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "exposure.",
          "pdf_page": 287,
          "printed_page": 205,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Gastric lavage if decreased mental",
          "pdf_page": 287,
          "printed_page": 205,
          "column": 1
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "status and large number of pills ingested.",
          "pdf_page": 287,
          "printed_page": 205,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Temporary cardiac pacing when medical",
          "pdf_page": 287,
          "printed_page": 205,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "therapy fails.",
          "pdf_page": 287,
          "printed_page": 205,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "IV fluid bolus over 15–20 min for hypotension—cats, 10–20 mL/kg; dogs, 20–30 mL/kg.",
          "pdf_page": 287,
          "printed_page": 205,
          "column": 2
        }
      ],
