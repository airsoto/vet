    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Monitor heart rate/ECG, BP, and BG for 6–12h with immediate-release preparations and 12–24h for ER/sustained-release (SR) preparations, depending on peak drug levels.",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 3
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": []
        },
        "POSSIBLE COMPLICATIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": []
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ingestion of immediate-release preparations typically result in clinical signs in 8–12h.",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "SR or ER preparations may take 12–24h",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "for clinical signs to develop.",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prognosis depends on dose ingested and response to",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "therapy.",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Toxicosis normally results in bradycardia, hypotension, and in severe cases decreased mental status, coma, and apnea.",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 3
            }
          ]
        }
      }
