    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Activated charcoal (1–2 g/kg) PO, repeat activated charcoal for extended-release (ER)",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "formulations.",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Atropine (0.02–0.04 mg/kg",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "IV) for sinus bradycardia.",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Calcium infusion—first-line therapy despite normo calcemia to increase Ca availability for muscle",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "function and improve contractility.",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Ca",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "gluconate 10% bolus 0.5–1.5 mL/kg IV over 5–10 min followed by CRI of 0.5–1.5 mL/kg/h, titrated to effect; monitor continuous ECG and infusion should be slowed or stopped if bradycardia or conduction",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "blockade worsens.",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Ca chloride 10% bolus",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "0.15–0.5 mL/kg IV; central line recommended due to risk of tissue injury secondary to drug extravasation.",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intravenous fat emulsion (IFE)—may bind lipid-soluble drugs, increase Ca available for muscle contraction, and provide an energy",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "source for heart muscle.",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "IFE 20% solution",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "dose—1.5 mL/kg IV bolus over 1 min; follow with CRI of 0.25 mL/kg/min for 30–60 min; additional IV doses: 1.5 ml/kg every 4–6h or CRI of 0.5 mL/kg/h; monitor serum for lipemia every 2–4h to determine if additional",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "dosing is needed.",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "High-dose insulin euglycemia (HIE) treatment—may provide energy for heart muscle and increase Ca available for muscle contraction.",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Recommended treatment:",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Check blood",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "glucose (BG) concentration and administer",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "dextrose if BG <100 mg/dL.",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Administer",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "regular insulin at 1 unit/kg IV, followed by CRI at 0.5–2 units/kg/h; may increase every 10 min up to maximum dose of 10 units/kg/h; when signs resolve, decrease insulin by",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "1–2 units/kg/h.",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Monitor BG every 10 min",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "while titrating insulin dose; once stabilized, check BG every 30–60 min; central line placement recommended for frequent glucose monitoring and dextrose administration during HIE treatment; dextrose supplemen tation will be needed to maintain normal BG concentrations and continued up to 24h after",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "discontinuation of insulin therapy.",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Monitor",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "potassium concentration every hour during titration, then every 6h; administer potassium chloride to keep potassium concentrations",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "within normal range.",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Glucagon—may not be as effective as HIE or IFE; dose is 0.05–0.2 mg/kg slowly IV bolus, followed by CRI of 0.05–0.1 mg/kg/h.",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "CONTRAINDICATION/POSSIBLE",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 3
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "INTERACTIONS",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Vasopressors/sympathomimetics may not be",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 3,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "as effective as other therapy and may make",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 3,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "patients less response to other therapy.",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 3,
              "subheading": "INTERACTIONS"
            }
          ]
        },
