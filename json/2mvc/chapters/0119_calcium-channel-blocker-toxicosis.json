        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Systems affected include:",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cardiovascular— bradycardia, AV dissociation and AV block (first, second, or third degree), hypotension.",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gastrointestinal—vomiting, diarrhea, ileus.",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory—pulmonary edema.",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nervous—decreased mentation, weakness,",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "collapse, seizures.",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Endocrine/metabolic— hyperglycemia, metabolic acidosis secondary to hypoperfusion.",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 1
            }
          ]
        },
