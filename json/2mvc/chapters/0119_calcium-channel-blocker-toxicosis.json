      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Calcium channel blockers (CCBs): class IV antidysrhythmics used to treat systemic hypertension, cardiac disease, tachydys rhythmias, and oliguric/anuric renal failure in",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "dogs and cats.",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CCBs inhibit movement of Ca through L-type voltage-gated slow Ca channels located on cardiac muscle, atrioventricular (AV) and sinoatrial (SA) nodes, vasculature smooth muscle, and",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "pancreatic beta cells.",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Three classes of CCBs—phenylalkylamine, benzothiazepine, dihydropyridine; CCB class determines the effect on the body.",
              "pdf_page": 287,
              "printed_page": 205,
              "column": 1
            }
          ]
        },
