        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog and cat.",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Young adult cats—higher incidence of anuria associated with UTO.",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Reduction in quantity of urine voided.",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Enlarged urinary bladder, stranguria, pollakiuria with urethral obstruction.",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Systemic signs of uremia if oliguria/anuria persists.",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES",
          "canonical_heading": "CAUSES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Physiologic oliguria—renal hypoperfusion or serum hyperosmolality.",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pathologic oliguria—AKI or advanced chronic kidney disease (CKD).",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anuria—complete UTO, urinary tract rupture, or severe primary kidney disease.",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 1
            }
          ]
        },
        "RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "RISK FACTORS",
          "canonical_heading": "RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Physiologic oliguria—dehydration, decreased cardiac output, hypotension.",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pathologic oliguria and anuria—primary kidney disease, nephrotoxin exposure, dehydration, low cardiac output, hypotension, electrolyte imbalance, acidosis, fever, sepsis, liver disease, multiple organ failure, trauma, hypoalbuminemia, hyperviscosity syndrome.",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anuria—caused by urolithiasis, urinary tract neoplasia, idiopathic feline lower urinary tract disease, functional micturition disorder, trauma, gross hematuria.",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 2
            }
          ]
        },
        "CAUSES & RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": []
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Physiologic oliguria—poor tissue perfusion, history of recent fluid loss, signs of uremia are typically absent. Oliguria resolves rapidly when renal hypoperfusion is corrected.",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pathologic oliguria—caused by CKD have a history of progressive kidney disease (polyuria, polydipsia, poor appetite, weight loss). Patients with CKD are at risk for AKI. Signs of uremia are commonly observed; fluid therapy and other measures to restore adequate renal perfusion often fail to increase urine flow.",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Suspect anuria due to UTO or rupture of the excretory pathway with repeated stranguria and inability to produce urine. Patients may have a history of pollakiuria, dysuria, hematuria, urolithiasis, trauma, instrumentation of the urinary tract. Physical exam may reveal enlarged urinary bladder, painful posterior abdomen, masses or uroliths in the urethra or bladder. Patients with rupture of the urinary tract may have ascites, fluid infiltration in tissues, painful caudal abdomen, masses or uroliths in the bladder or urethra, or evidence of trauma. UTO caused by functional urinary obstruction: suspect in patients with urinary bladder enlargement, increased resistance to manual bladder expression, and neurologic signs affecting the hind limbs and/or tail. Signs of uremia may develop. Restoring urinary flow/correcting rents in the excretory pathway rapidly restores adequate urine flow.",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Serum urea nitrogen, creatinine concentration—elevated unless onset of oliguria or anuria is very recent.",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperkalemia—common with pathologic oliguria and anuria, less common/less severe in animals with physiologic oliguria (except with hypoadrenocorticism).",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Physiologic oliguria—characterized by high urine specific gravity (USG) (dogs >1.030, cats >1.035). Oliguria associated with lower USG suggests renal parenchymal disease or UTO. Patients with urine concentrating defects due to other diseases or drugs are the",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "exception to this rule.",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Renal parenchymal anuria is typically characterized by USG <1.030 (dogs) or",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 3
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "<1.035 (cats). USG varies in patients with",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "post-renal anuria. Adequate urine-",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 3,
              "subheading": "<1.035 (cats). USG varies in patients with"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "concentrating ability often lost after UTO.",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 3,
              "subheading": "<1.035 (cats). USG varies in patients with"
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
