        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal radiographs and ultrasound are useful to rule out UTO/excretory pathway rupture.",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Excretory urography, retrograde urethro cystography, pyelography, or vaginourethro cystography may provide definitive proof of UTO/excretory pathway rupture.",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Distension of the excretory pathway or detection of uroliths in the ureters, bladder neck, urethra suggest UTO.",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Detection of fluid within the peritoneum supports a diagnosis of excretory pathway rupture. Contrast media leakage confirms a",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 3
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Electrocardiography—to identify significant arrhythmia (see Hyperkalemia).",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urethrocystoscopy—may provide evidence for UTO/urinary tract rupture.",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urinary catheterization—may provide information about the integrity of the lower urinary tract. Not recommended as a diagnostic procedure because it may be misleading and may cause additional trauma; iatrogenic UTI.",
              "pdf_page": 1073,
              "printed_page": 991,
              "column": 3
            }
          ]
        },
