    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "A variety of drugs are used in humans; opinions differ on agents of choice.",
              "pdf_page": 1490,
              "printed_page": 1408,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lidocaine 2 mg/kg IV bolus followed by 25–75 mg/kg/min CRI IV drip (dogs only).",
              "pdf_page": 1490,
              "printed_page": 1408,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Figure 2.",
              "pdf_page": 1490,
              "printed_page": 1408,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Esmolol 50–100 mg/kg bolus, 50–200 mg/",
              "pdf_page": 1490,
              "printed_page": 1408,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "kg/min CRI (dogs and cats).",
              "pdf_page": 1490,
              "printed_page": 1408,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Propranolol 2.5–5 mg PO q8–12h (cats); 0.2–1 mg/kg PO q8h (dogs) or atenolol 6.2–12.5 mg PO q24h (cats); 0.25–1 mg/kg PO q12h (dogs).",
              "pdf_page": 1490,
              "printed_page": 1408,
              "column": 2
            }
          ]
        },
