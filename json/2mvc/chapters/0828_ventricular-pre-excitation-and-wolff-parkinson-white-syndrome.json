        "DEFINITION": {
          "present": true,
          "status": "content",
          "source_heading": "DEFINITION",
          "canonical_heading": "DEFINITION",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ventricular pre-excitation occurs when impulses originating in the sinoatrial node or atrium activate a portion of the ventricles prematurely through an accessory pathway without going through the atrioventricular (AV) node; the remainder of the ventricles are activated normally through the usual",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "conduction system.",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Wolff–Parkinson–White (WPW) syndrome consists of ventricular pre-excitation with episodes of paroxysmal supraventricular tachycardia (Figures 1 and 2).",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "ECG Features of Ventricular",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Pre-excitation",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Normal heart rate and rhythm.",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 1,
              "subheading": "Pre-excitation"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Normal P",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 1,
              "subheading": "Pre-excitation"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "waves.",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 1,
              "subheading": "Pre-excitation"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Short PR interval (dogs, <0.06",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 1,
              "subheading": "Pre-excitation"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "seconds; cats, <0.05 seconds).",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 1,
              "subheading": "Pre-excitation"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Widened",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 1,
              "subheading": "Pre-excitation"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "QRS (small dogs, >0.05 seconds; large dogs,",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 1,
              "subheading": "Pre-excitation"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": ">0.06 seconds; cats, >0.04 seconds), often",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 1,
              "subheading": "Pre-excitation"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "with slurring or notching of the upstroke of",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 1,
              "subheading": "Pre-excitation"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "the R wave (delta wave).",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 1,
              "subheading": "Pre-excitation"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "ECG Features of Ventricular Pre-",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "excitation with WPW Syndrome",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Extremely rapid heart rate (dogs, often",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 1,
              "subheading": "excitation with WPW Syndrome"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": ">300 bpm; cats, approaching 400–500 bpm).",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 1,
              "subheading": "excitation with WPW Syndrome"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "P waves may be difficult to recognize.",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 1,
              "subheading": "excitation with WPW Syndrome"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "QRS",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 1,
              "subheading": "excitation with WPW Syndrome"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "complexes may be normal, wide with delta",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 1,
              "subheading": "excitation with WPW Syndrome"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "wave, or very wide and bizarre, depending on",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 1,
              "subheading": "excitation with WPW Syndrome"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "the circuit.",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 1,
              "subheading": "excitation with WPW Syndrome"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Conduction is usually 1:1 (i.e.,",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 1,
              "subheading": "excitation with WPW Syndrome"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "1 P wave for every QRS complex).",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 1,
              "subheading": "excitation with WPW Syndrome"
            }
          ]
