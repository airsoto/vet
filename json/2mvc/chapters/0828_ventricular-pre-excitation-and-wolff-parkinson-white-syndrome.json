    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ventricular pre-excitation—differentiate from other causes of short PR intervals (e.g., fever, hyperthyroidism, and anemia); these conditions do not cause delta waves.",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Narrow complex WPW syndrome— differentiate from other supraventricular arrhythmias (e.g., atrial tachycardia, atrial flutter, and atrial fibrillation); WPW syndrome is most easily recognized after conversion to normal heart rate and rhythm.",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Alternating WPW syndrome should not be",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "confused with ventricular bigeminy.",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Wide complex WPW syndrome must be differentiated from ventricular tachycardia.",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Short PR interval may be correlated with a normal QRS complex if the anomalous pathway bypasses the AV node and connects to the bundle of His (i.e., Lown-Ganong Levine syndrome).",
              "pdf_page": 1489,
              "printed_page": 1407,
              "column": 3
            }
          ]
        },
