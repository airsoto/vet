              "printed_page": 1383,
              "column": 3
            }
          ]
        },
        "PRECAUTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "PRECAUTIONS",
          "canonical_heading": "PRECAUTIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Allopurinol is contraindicated in animals with renal failure and is not effective in animals with portosystemic shunts.",
