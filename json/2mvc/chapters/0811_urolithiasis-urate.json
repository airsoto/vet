        "DEFINITION": {
          "present": true,
          "status": "content",
          "source_heading": "DEFINITION",
          "canonical_heading": "DEFINITION",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Uroliths composed of uric acid, sodium urate, or ammonium urate.",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 1
            }
          ]
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Impaired conversion of uric acid to allantoin (see Figure 1) causes high concentration of uric",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "acid in serum and urine.",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Patients with portosystemic shunts may develop ammonium urate uroliths because of impaired hepatic metabolism of uric acid and ammonia.",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 1
            }
          ]
        },
        "SYSTEMS AFFECTED": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": []
        },
        "GENETICS": {
          "present": true,
          "status": "content",
          "source_heading": "GENETICS",
          "canonical_heading": "GENETICS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Dalmatians have a breed predisposition to forming urate urolithiasis.",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 1
            }
          ]
        },
        "INCIDENCE/PREVALENCE": {
