      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Other causes of lower or upper urinary tract disease.",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Aciduria, urate crystalluria, azotemia in patients with urinary outflow obstruction.",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Low BUN and microcytosis in patients with portosystemic shunts; reduced production of urea by the liver may mask hypoglycemia, hypoalbuminemia, and increased hepatic enzyme activities in patients with more severe hepatic dysfunction.",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Liver function tests such as postprandial serum bile acids have abnormal results in patients with portosystemic shunts.",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Genetic testing for mutation in SLC2A9 gene, which encodes for a carrier protein necessary for uric acid metabolism, can be performed in dogs without portosystemic shunts who are at high risk or who have formed urate uroliths (performed at University of California Davis and Embark).",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Urate uroliths may be radiolucent; may need IV pyelogram to detect nephroliths or double contrast cystography to detect urocystoliths. Microhepatica in patients with portosystemic",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "shunts.",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ultrasonography may reveal radiolucent uroliths. Patients with a portosystemic shunt may also have microhepatica, bilateral renomegaly, and a portosystemic vascular anomaly identified with ultrasound.",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Liver biopsy; bile acids, blood ammonia; advanced imaging to identify portosystemic shunt.",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "In patients with portosystemic shunts, liver biopsy may reveal hepatic atrophy and/or dysplasia.",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
