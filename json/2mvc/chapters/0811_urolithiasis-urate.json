        "APPROPRIATE HEALTH CARE": {
          "present": true,
          "status": "content",
          "source_heading": "APPROPRIATE HEALTH CARE",
          "canonical_heading": "APPROPRIATE HEALTH CARE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Urethral or ureteral obstruction may require inpatient treatment. Urate uroliths can be dissolved on outpatient basis.",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 2
            }
          ]
        },
        "NURSING CARE": {
          "present": true,
          "status": "content",
          "source_heading": "NURSING CARE",
          "canonical_heading": "NURSING CARE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Fluid therapy to correct dehydration.",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 2
            }
          ]
        },
        "ACTIVITY": {
          "present": true,
          "status": "content",
          "source_heading": "ACTIVITY",
          "canonical_heading": "ACTIVITY",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Usually not restricted, except after surgery.",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 2
            }
          ]
        },
        "DIET": {
          "present": true,
          "status": "content",
          "source_heading": "DIET",
          "canonical_heading": "DIET",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "For dissolution and prevention, a high moisture, low-purine, urine-alkalinizing diet.",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 2
            }
          ]
        },
        "CLIENT EDUCATION": {
          "present": true,
          "status": "content",
          "source_heading": "CLIENT EDUCATION",
          "canonical_heading": "CLIENT EDUCATION",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Recurrence of uroliths is possible. A plan to minimize recurrence should be developed.",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 2
            }
          ]
        },
        "SURGICAL CONSIDERATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "SURGICAL CONSIDERATIONS",
          "canonical_heading": "SURGICAL CONSIDERATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Minimally invasive techniques such as cystoscopic stone basket removal, percutaneous cystolithotomy or lithotripsy are preferred over cystotomy, urethrotomy, and nephrotomy to",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "remove uroliths.",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Portosystemic shunt ligation.",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Endogenous Dietary Purines Purine Pool Hypoxanthine Xanthine oxidase Xanthine Uric Acid Uricase Allantoin Figure 1.",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 3
            }
          ]
        },
