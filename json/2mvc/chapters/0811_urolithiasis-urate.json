          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "High-moisture, low-purine, urine-alkaliniz-",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "ing diet.",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Some dogs require allopurinol administration (5.0–7.5 mg/kg PO q12h).",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Low uric acid excreting Dalmatians (those without SLC2A9 mutation) should be at lower risk due to decreased urinary uric acid excretion.",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 3
            }
          ]
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Urethral obstruction.",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Uroliths likely to recur if no preventive measures.",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 3
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Medical dissolution takes an average of 4 weeks, if there is good compliance.",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Medical dissolution usually not successful with portosystemic shunt.",
              "pdf_page": 1465,
              "printed_page": 1383,
              "column": 3
            }
          ]
        }
      }
