        "DEFINITION": {
          "present": true,
          "status": "content",
          "source_heading": "DEFINITION",
          "canonical_heading": "DEFINITION",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Diabetes insipidus (DI) is a disorder of water metabolism characterized by polyuria (PU), urine of low specific gravity or osmolality (so-called insipid, or tasteless, urine), and polydipsia (PD).",
              "pdf_page": 473,
              "printed_page": 391,
              "column": 1
            }
          ]
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Central DI (CDI)—deficiency in the secretion of antidiuretic hormone (ADH).",
              "pdf_page": 473,
              "printed_page": 391,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nephrogenic DI (NDI)—renal insensitivity to ADH.",
              "pdf_page": 473,
              "printed_page": 391,
              "column": 1
            }
          ]
        },
