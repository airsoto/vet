        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "ADH supplementation trial—preferred to water deprivation test; therapeutic trial with synthetic ADH (desmopressin [DDAVP]); positive response (water intake decreases by 50% in 5–7 days).",
              "pdf_page": 473,
              "printed_page": 391,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Modified water deprivation test (see Appendix II for protocol)—not routinely recommended due to risk of complications.",
              "pdf_page": 473,
              "printed_page": 391,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rule out all other causes of PU/PD before considering primary CDI.",
              "pdf_page": 473,
              "printed_page": 391,
              "column": 2
            }
          ]
        },
