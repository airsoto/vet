        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "CDI usually permanent, except in patients in which condition was trauma induced.",
              "pdf_page": 473,
              "printed_page": 391,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "NDI usually resolves with treatment of underlying disorder.",
              "pdf_page": 473,
              "printed_page": 391,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prognosis generally good, depending on",
              "pdf_page": 473,
              "printed_page": 391,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Without treatment, dehydration can lead to stupor, coma, and death.",
              "pdf_page": 473,
              "printed_page": 391,
              "column": 3
            }
          ]
        }
      }
