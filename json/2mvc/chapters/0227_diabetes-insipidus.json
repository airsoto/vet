    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "CDI—DDAVP (1–2 drops of intranasal preparation in conjunctival sac q12–24h to control PU/PD); alternatively, intranasal preparation may be given SC (2–5μg, q12–24h). Oral preparation of DDAVP is available in 0.1–0.2 mg tablets, with each 0.1 mg comparable to 1 large drop of intranasal preparation.",
              "pdf_page": 473,
              "printed_page": 391,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "NDI—hydrochlorothiazide (2–4 mg/kg PO q12h), in addition to treatment of any underlying cause.",
              "pdf_page": 473,
              "printed_page": 391,
              "column": 3
            }
          ]
        },
