          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Adjust treatment according to patient’s signs; ideal dosage and frequency of DDAVP administration based on water intake.",
              "pdf_page": 473,
              "printed_page": 391,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Laboratory tests such as PCV, total solids, and serum sodium concentration, and patient weight to detect dehydration (inadequate DDAVP replacement).",
              "pdf_page": 473,
              "printed_page": 391,
              "column": 3
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
