            {
              "type": "subheading",
              "level": 0,
              "text": "arrhythmias.•Median survival~2 weeks",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "without treatment, ~4 months with",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 3,
              "subheading": "arrhythmias.•Median survival~2 weeks"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "doxorubicin, possibly longer if tumor",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 3,
              "subheading": "arrhythmias.•Median survival~2 weeks"
            },
            {
              "type": "paragraph",
