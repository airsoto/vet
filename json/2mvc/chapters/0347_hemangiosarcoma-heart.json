      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Highly metastatic malignant tumor of",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "endothelial cell precursors",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most common",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "cardiac tumor in dogs.",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Can be primary or, less",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "commonly, metastatic site.",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most tumors involve right atrium or right auricular appendage.",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            }
          ]
        },
