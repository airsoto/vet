    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Doxorubicin (30 mg/m2IV for dogs",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": ">15 kg; 1 mg/kg IV for dogs<15 kg) q2–3",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "weeks for 5 cycles.",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 2,
              "subheading": ">15 kg; 1 mg/kg IV for dogs<15 kg) q2–3"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metronomic",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 2,
              "subheading": ">15 kg; 1 mg/kg IV for dogs<15 kg) q2–3"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "cyclophosphamide (12.5–15 mg/m2PO",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 2,
              "subheading": ">15 kg; 1 mg/kg IV for dogs<15 kg) q2–3"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "q24h) in combination with nonsteroidal",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 2,
              "subheading": ">15 kg; 1 mg/kg IV for dogs<15 kg) q2–3"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "anti-inflammatory drug (NSAID; e.g.,",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 2,
              "subheading": ">15 kg; 1 mg/kg IV for dogs<15 kg) q2–3"
            },
            {
              "type": "paragraph",
              "level": 0,
