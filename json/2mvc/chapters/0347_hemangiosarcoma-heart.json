        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs, rarely cats.",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "German shepherds, Labrador retrievers, golden retrievers",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "predisposed.",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Typically middle-aged to older",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "animals.",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Predisposition for male dogs.",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Signs most commonly related to pericardial effusion, cardiac tamponade, secondary",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "right-sided congestive heart failure.•Historical",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "findings—collapse, lethargy, weakness, exercise",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "intolerance, anorexia, cough, dyspnea,",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1,
              "subheading": "findings—collapse, lethargy, weakness, exercise"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "vomiting.•Physical examination findings—",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "muffled heart and lung sounds, arrhythmias,",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1,
              "subheading": "vomiting.•Physical examination findings—"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "pulse deficits, pulsus paradoxus, pale mucous",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1,
              "subheading": "vomiting.•Physical examination findings—"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "membranes, jugular vein distention, abdominal",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1,
              "subheading": "vomiting.•Physical examination findings—"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "distension with effusion, hepatomegaly.",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1,
              "subheading": "vomiting.•Physical examination findings—"
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Dogs—genetic abnormalities including inactivation of tumor suppressor genePTEN; overexpression of growth and apoptosisrelated proteins RB, cyclin D1, Bcl2, survivin; overexpression of angiogenic factors such as vascular endothelial growth factor (VEGF) and angiopoietins.",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other cardiac neoplasia.",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Idiopathic",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "hemorrhagic pericardial effusion.",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other causes of right heart failure and arrhythmias.",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Regenerative anemia.",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thrombocytopenia.",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Poikilocytosis—acanthocytes, schistocytes,",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "spherocytes.",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neutrophilic leukocytosis.",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Coagulation panel (prothrombin time [PT], partial thromboplastin time [PTT], D-dimers, fibrinogen)—criteria for disseminated intra vascular coagulation (DIC) present in up to",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "50% of patients.",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Plasma cardiac troponin (cTnI) levels elevated in dogs with pericardial effusion secondary to hemangiosarcoma (HSA) and can help differentiate from pericardial effusion not caused by HSA.",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiography—may reveal presence of globoid cardiac silhouette, pleural effusion, pulmonary metastasis, characterized by miliary to diffuse nodular pattern.",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal ultrasonography—can screen for primary or metastatic hepatosplenic lesions, omental nodules, free abdominal fluid",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "(hemoabdomen).•Echocardiography—useful",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "for identifying and guiding removal of",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 2,
              "subheading": "(hemoabdomen).•Echocardiography—useful"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "pericardial effusion and determining location",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 2,
              "subheading": "(hemoabdomen).•Echocardiography—useful"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and extent of tumor involvement (tumor",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 2,
              "subheading": "(hemoabdomen).•Echocardiography—useful"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "better visualized when effusion present).",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 2,
              "subheading": "(hemoabdomen).•Echocardiography—useful"
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Definitive diagnosis requires tissue biopsy.",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracoscopy can be used to perform pericardiectomy and obtain biopsies; thoracoscopic tumor resection also",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "infrequently performed.",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytologic evaluation of pericardial fluid rarely provides definitive diagnosis due to hemodilution and",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "lack of tumor cell exfoliation.",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "ECG may reveal arrhythmias and electrical alternans.",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Gross findings—hemorrhagic friable mass in right side of heart; metastasis can be multifocal, including lungs, spleen, liver, kidneys,",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "muscle, peritoneum.•Histopathology",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "findings—anaplastic mesenchymal cells",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "arranged in chords forming vascular channels",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 2,
              "subheading": "findings—anaplastic mesenchymal cells"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and spaces filled with red blood cells,",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 2,
              "subheading": "findings—anaplastic mesenchymal cells"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "thrombi, necrotic debris.",
              "pdf_page": 677,
              "printed_page": 595,
              "column": 2,
              "subheading": "findings—anaplastic mesenchymal cells"
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Periodic pericardiocentesis can provide temporary symptomatic relief from cardiac",
          "pdf_page": 677,
          "printed_page": 595,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "tamponade.",
          "pdf_page": 677,
          "printed_page": 595,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Thoracoscopic pericardectomy (pericardial window) can be performed as palliative procedure to lower risk of life-",
          "pdf_page": 677,
          "printed_page": 595,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "threatening cardiac tamponade.",
          "pdf_page": 677,
          "printed_page": 595,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgical tumor excision provides best chance of long-term tumor control, but restricted to tumors on atrial appendage and/or small areas",
          "pdf_page": 677,
          "printed_page": 595,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "of right atrial wall.",
          "pdf_page": 677,
          "printed_page": 595,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Use of doxorubicin chemotherapy in measurable disease setting associated with >40% objective tumor response rate and provides clinical benefit in almost 70%.",
          "pdf_page": 677,
          "printed_page": 595,
          "column": 2
        }
      ],
