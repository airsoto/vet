  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Relatively common cause of colitis in Boxer breeds and infrequently seen in",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "French bulldogs and border collies.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Boxer colitis is also referred to as granulomatous colitis (GC) in light of the granulomatous inflammation (macrophages) in the colon.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Etiology of GC is an adherent-invasive E. coli(AIEC) strain.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
