    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUGS",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Antimicrobials—First-Line Therapy",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Enrofloxacin (10 mg/kg q24h) for minimum",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2,
              "subheading": "Antimicrobials—First-Line Therapy"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "duration of 6–8 weeks is typically associated",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2,
              "subheading": "Antimicrobials—First-Line Therapy"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "with rapid resolution of clinical signs and",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2,
              "subheading": "Antimicrobials—First-Line Therapy"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "resolution of histopathologic abnormalities.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2,
              "subheading": "Antimicrobials—First-Line Therapy"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Because enrofloxacin resistance has been",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2,
              "subheading": "Antimicrobials—First-Line Therapy"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "documented in up to 70% of isolates from",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2,
              "subheading": "Antimicrobials—First-Line Therapy"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "dogs with GC, attempts to isolateE. colifrom",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "colonic biopsies before treatment recommended",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2,
              "subheading": "dogs with GC, attempts to isolateE. colifrom"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "such that antimicrobial susceptibility testing",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2,
              "subheading": "dogs with GC, attempts to isolateE. colifrom"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "can be performed.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2,
              "subheading": "dogs with GC, attempts to isolateE. colifrom"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Antimicrobials that",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2,
              "subheading": "dogs with GC, attempts to isolateE. colifrom"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "penetrate intracellularly, such as fluoroquinolones,",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2,
              "subheading": "dogs with GC, attempts to isolateE. colifrom"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "chloramphenicol, rifampin, or trimethoprim-",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2,
              "subheading": "dogs with GC, attempts to isolateE. colifrom"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "sulfonamides, should be preferentially chosen",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2,
              "subheading": "dogs with GC, attempts to isolateE. colifrom"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "for treatment based on results of antimicrobial",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2,
              "subheading": "dogs with GC, attempts to isolateE. colifrom"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "susceptibility testing.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2,
              "subheading": "dogs with GC, attempts to isolateE. colifrom"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chloramphenicol,",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2,
              "subheading": "dogs with GC, attempts to isolateE. colifrom"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "trimethoprim-sulfa, clarithromycin, imipenem,",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2,
              "subheading": "dogs with GC, attempts to isolateE. colifrom"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and meropenem should be considered for cases",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2,
              "subheading": "dogs with GC, attempts to isolateE. colifrom"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "resistant to fluoroquinolones.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2,
              "subheading": "dogs with GC, attempts to isolateE. colifrom"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Anti-inflammatory/Immunosuppressive",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rarely indicated in dogs with GC, and used at anti-inflammatory dose in conjunction with appropriate antimicrobial therapy.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diagnosis must be reconsidered if no dramatic improvement in clinical signs following administration of fluoroquinolone therapy, because not all boxers with signs of colitis have GC.",
