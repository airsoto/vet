          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—primarily affects young Boxers,",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "usually <3 years of age.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reported in French bulldogs and border collies less frequently.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Bloody, mucoid diarrhea with marked",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "increase in frequency of defecation.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tenesmus.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Weight loss and anorexia can occur and debilitation may develop.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "GC appears to be a genetic disorder in boxer breeds associated with reduced macrophage phagocytic function and inability to kill AIEC.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other causes of colitis—nonhistiocytic inflammatory bowel disease (IBD), lymphocytic, plasmacytic, eosinophilic colitis, other infectious causes of colitis (pythiosis, protothecosis, entamoeba), parasitic colitis (whipworms), food-responsive diarrhea.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cecal inversion.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ileocolic intussusception.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neoplasia—lymphoma, adenocarcinoma.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Foreign body.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Colorectal polyps—dogs with colorectal polyps do not have diarrhea or increased mucus in stools, and instead have normal defecation frequency with formed stools (can have altered shape) coated with",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "frank blood.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Irritable bowel syndrome.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Differentiate by clarifying history (colitis vs. colorectal neoplaia), fecal flotations, abdominal imaging, and colonoscopy or proctoscopy and biopsy.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually unremarkable; microcytic anemia may be present in Boxer dogs with GC",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "secondary to intestinal bleeding.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chemistry panel may reveal hypoalbuminemia, electrolyte abnormalities, and prerenal azotemia in dogs with severe diarrhea and anorexia.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": []
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Abdominal ultrasound in Boxer dogs with GC often reveals mild or moderate mesenteric or sublumbar lymphadenomegaly, and colonic wall can appear thickened.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 1
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Proctoscopy or colonoscopy to obtain",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "colonic biopsies.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most Boxer dogs with GC have involvement of descending colon, underscoring diagnostic utility of procto",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "scopy.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Common changes in appearance to colonic wall include erythema, irregularity, and ulceration of colonic and rectal wall.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Microbiologic Testing",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "E. colicommonly isolated on routine",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "bacteriologic media from feces of both healthy",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2,
              "subheading": "E. colicommonly isolated on routine"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "dogs and dogs with diarrhea; however,",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2,
              "subheading": "E. colicommonly isolated on routine"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "attempts to isolateE. colifrom colonic",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "biopsies is recommended for sensitivity testing",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2,
              "subheading": "attempts to isolateE. colifrom colonic"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and optimization of antimicrobial therapy.",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2,
              "subheading": "attempts to isolateE. colifrom colonic"
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Histopathologic lesions include neutrophilic inflammation, epithelial ulceration, crypt hyperplasia and distortion, decreased numbers of goblet cells, and large numbers of macro phages that stain positive with periodic acid–",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Schiff (PAS) stain.•Presence ofE. coliwithin",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "macrophages can be confirmed using",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2,
              "subheading": "Schiff (PAS) stain.•Presence ofE. coliwithin"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "fluorescent in-situ hybridization (FISH).",
              "pdf_page": 385,
              "printed_page": 303,
              "column": 2,
              "subheading": "Schiff (PAS) stain.•Presence ofE. coliwithin"
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Outpatient medical management following",
          "pdf_page": 385,
          "printed_page": 303,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "confirmation of diagnosis.",
          "pdf_page": 385,
          "printed_page": 303,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Antimicrobial therapy utilizing fluoroquinolones (unless resistance is observed) is mainstay of therapy.",
          "pdf_page": 385,
          "printed_page": 303,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Diet change to include moderately fermentable fiber source can be used in cases that do not show complete resolution of diarrhea.",
          "pdf_page": 385,
          "printed_page": 303,
          "column": 2
        }
      ],
