        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Most patients die or are euthanized due to progression or recurrence of local disease.",
              "pdf_page": 615,
              "printed_page": 533,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Overall metastatic rate is 25% (regional lymph nodes and lungs).",
              "pdf_page": 615,
              "printed_page": 533,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prognosis with surgery alone depends on tumor size and location, with reported median survival times 9–24 months; longterm control is possible with complete excision.",
              "pdf_page": 615,
              "printed_page": 533,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Combining surgery with radiation therapy, median survival is 18 months.",
              "pdf_page": 615,
              "printed_page": 533,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "With radiation therapy alone, median progression-free survival is 45 months for",
              "pdf_page": 615,
              "printed_page": 533,
              "column": 3
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "tumors<2 cm, 31 months for tumors",
              "pdf_page": 615,
              "printed_page": 533,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "2–4 cm, and 7 months for tumors>4 cm.",
              "pdf_page": 615,
              "printed_page": 533,
              "column": 3,
              "subheading": "tumors<2 cm, 31 months for tumors"
            }
          ]
        }
      }
    },
