        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—overall, large-breed dogs are predisposed; median age 9 years (range: 1–13 years).",
              "pdf_page": 615,
              "printed_page": 533,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Golden retrievers are overrepresented specifically for histologically low-grade but biologically high-grade FSA variant (see Pathologic Findings).",
              "pdf_page": 615,
              "printed_page": 533,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—no breed predilections; median age 8–10 years (range: 1–21 years).",
              "pdf_page": 615,
              "printed_page": 533,
              "column": 1
            }
          ]
        },
