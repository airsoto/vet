    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Cytology or histopathology of ipsilateral mandibular lymph node recommended to screen for metastasis.",
          "pdf_page": 615,
          "printed_page": 533,
          "column": 2
        }
      ],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other malignant oral tumors, including melanoma, squamous cell carcinoma, or osteosarcoma.",
              "pdf_page": 615,
              "printed_page": 533,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Benign tumors such as acanthomatous ameloblastoma, peripheral odontogenic fibroma (epulis), or osteoma.",
              "pdf_page": 615,
              "printed_page": 533,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tooth root abscess or osteomyelitis.",
              "pdf_page": 615,
              "printed_page": 533,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dentigerous cyst.",
              "pdf_page": 615,
              "printed_page": 533,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Craniomandibular osteopathy (lion’s jaw).",
              "pdf_page": 615,
              "printed_page": 533,
              "column": 2
            }
          ]
        },
