      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Fibrosarcoma (FSA) is a malignant tumor of spindle cells that produce varying amounts of collagenous (fibrous) extracellular matrix and associated stroma.",
              "pdf_page": 615,
              "printed_page": 533,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Oral FSA arises most commonly in the gingiva; occasionally involves lips and rarely tongue; invasion into bone is common.",
              "pdf_page": 615,
              "printed_page": 533,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In dogs, FSA is third most common oral malignancy (20% of all oral tumors).",
              "pdf_page": 615,
              "printed_page": 533,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In cats, FSA is second most common oral malignancy (5–15% of all oral tumors).",
              "pdf_page": 615,
              "printed_page": 533,
              "column": 1
            }
          ]
        },
