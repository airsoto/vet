              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Halitosis, hypersalivation, dysphagia, and/",
              "pdf_page": 615,
              "printed_page": 533,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "or bloody oral discharge.",
