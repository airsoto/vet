    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Diagnosis based on history, complete oral exam, and full (esophagus and abdominal GIT) survey radiographs.",
              "pdf_page": 248,
              "printed_page": 166,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nonsteroidal anti-inflammatory drugs (NSAIDs), foreign body obstruction (FBO), pancreatitis, and other corrosive compounds (cleaning agents, drain cleaners, pool shocking agents, etc.).",
              "pdf_page": 248,
              "printed_page": 166,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Anemia—secondary to bleeding GI ulceration.",
              "pdf_page": 248,
              "printed_page": 166,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Leukocytosis—inflammation and secondary infection.",
              "pdf_page": 248,
              "printed_page": 166,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Elevated total proteins/prerenal azotemia— secondary to dehydration.",
              "pdf_page": 248,
              "printed_page": 166,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Elevated liver enzymes secondary to heavy metal toxicity from breakdown of casing.",
              "pdf_page": 248,
              "printed_page": 166,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": []
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Full survey radiographs—determine if a battery was swallowed, assess location and condition of battery and casing; look for evidence of perforation and/or obstruction.",
              "pdf_page": 248,
              "printed_page": 166,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Endoscopy—pending severity of signs, evaluate extent of damage to esophagus; may be able to remove battery or casing; use caution and do not damage esophagus.",
              "pdf_page": 248,
              "printed_page": 166,
              "column": 2
            }
          ]
        },
