  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Alkaline/acid-based batteries (generally referred to as dry cell batteries)—gastro intestinal tract (GIT) ulcers from leaking corrosive contents, oral injury from chewing on casing, rarely heavy metal toxicity from breakdown of casing in the GIT.",
              "pdf_page": 248,
              "printed_page": 166,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Disc/button/lithium ion batteries—rapid necrosis to the esophagus and stomach due to electric current from the battery; significant necrosis can occur 15 minutes after contact.",
              "pdf_page": 248,
              "printed_page": 166,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
