        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Dogs, cats, birds, and small mammals. Young animals are more commonly affected.",
              "pdf_page": 248,
              "printed_page": 166,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Historical—finding chewed-up electronic equipment without the battery; chewed or mangled battery or battery packaging.",
              "pdf_page": 248,
              "printed_page": 166,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Black debris in the oral cavity is evidence of leaked dry cell battery contents.",
              "pdf_page": 248,
              "printed_page": 166,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Physical:",
              "pdf_page": 248,
              "printed_page": 166,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Oral ulcerations.",
              "pdf_page": 248,
              "printed_page": 166,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Oral injury from chewing on battery",
              "pdf_page": 248,
              "printed_page": 166,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "casing.",
              "pdf_page": 248,
              "printed_page": 166,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Anorexia, drooling, regurgitation, vomiting,",
              "pdf_page": 248,
              "printed_page": 166,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "diarrhea, melena, progressive weakness, dyspnea, coughing, stridor, pleuritis, pyothorax, and pneumo-mediastinum.",
              "pdf_page": 248,
              "printed_page": 166,
              "column": 1
            }
          ]
        },
