          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Trauma—primary cause; may be relatively minor force (e.g., restraint) in brachycephalic breeds; usually severe impact or trauma in other breeds.",
              "pdf_page": 1210,
              "printed_page": 1128,
              "column": 1
            }
          ]
        }
