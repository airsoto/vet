              "printed_page": 1128,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exophthalmia—forward displacement of globe due to retrobulbar space-occupying lesion; may be acute, rarely peracute.",
              "pdf_page": 1210,
              "printed_page": 1128,
              "column": 1
            }
          ]
        },
