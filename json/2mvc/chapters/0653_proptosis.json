      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Prevent further trauma—lubricate cornea, Elizabethan collar.",
          "pdf_page": 1210,
          "printed_page": 1128,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Stabilize patient and perform thorough systemic physical examination before surgery.",
