      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Forward displacement of globe, with eyelids trapped behind globe’s equator (see Web Figures 1 and 2).",
              "pdf_page": 1210,
              "printed_page": 1128,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Frequently acute and due to bite wounds, head trauma.",
              "pdf_page": 1210,
              "printed_page": 1128,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vision threatening.",
              "pdf_page": 1210,
              "printed_page": 1128,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Immediate repositioning of globe critical.",
              "pdf_page": 1210,
              "printed_page": 1128,
              "column": 1
            }
          ]
        },
