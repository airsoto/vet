        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "More common in brachycephalic breeds (shallow orbit, large palpebral fissure).",
              "pdf_page": 1210,
              "printed_page": 1128,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May occur in any species or breed with severe enough traumatic force.",
              "pdf_page": 1210,
              "printed_page": 1128,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Possible Accompanying Signs",
              "pdf_page": 1210,
              "printed_page": 1128,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Subconjunctival or intraocular hemorrhage.",
              "pdf_page": 1210,
              "printed_page": 1128,
              "column": 1,
              "subheading": "Possible Accompanying Signs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pupil dilated or constricted.",
              "pdf_page": 1210,
              "printed_page": 1128,
              "column": 1,
              "subheading": "Possible Accompanying Signs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intraocular inflammation (uveitis).",
              "pdf_page": 1210,
              "printed_page": 1128,
              "column": 1,
              "subheading": "Possible Accompanying Signs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Globe deviation/strabismus/rupture.",
              "pdf_page": 1210,
              "printed_page": 1128,
              "column": 1,
              "subheading": "Possible Accompanying Signs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Corneal ulceration/desiccation.",
              "pdf_page": 1210,
              "printed_page": 1128,
              "column": 1,
              "subheading": "Possible Accompanying Signs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Periocular bite wounds.",
              "pdf_page": 1210,
              "printed_page": 1128,
              "column": 1,
              "subheading": "Possible Accompanying Signs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fractures of bony orbit or skull.",
              "pdf_page": 1210,
              "printed_page": 1128,
              "column": 1,
              "subheading": "Possible Accompanying Signs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Systemic injuries.",
              "pdf_page": 1210,
              "printed_page": 1128,
              "column": 1,
              "subheading": "Possible Accompanying Signs"
            }
          ]
        },
