        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "CA, CAA, APOT, and FIOT are highly invasive/expansile in bone.",
              "pdf_page": 1071,
              "printed_page": 989,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No known metastasis.",
              "pdf_page": 1071,
              "printed_page": 989,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Good to excellent prognosis/surgical cure can be expected when excisional margins are free of neoplastic cells.",
              "pdf_page": 1071,
              "printed_page": 989,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mean survival after radiotherapy in dogs with CAA ranges from 1 to 102 months (median, 37 months); 1-year survival rate 85%; 2-year survival rate 67%.",
              "pdf_page": 1071,
              "printed_page": 989,
              "column": 2
            }
          ]
        }
      }
