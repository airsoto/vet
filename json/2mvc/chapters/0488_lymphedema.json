        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Serologic tests for tick-borne infections, includingBartonellaspp.",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Radiography and ultrasound to rule out",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "obvious masses.",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lymphangiography ± computed tomography allows evaluation of lymphatic abnormalities; best results obtained with direct injection of water-based contrast media into a lymphatic vessel (see Suggested Reading).",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Biopsy of affected tissues to rule out",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "lymphangiosarcoma.",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Culture and sensitivity when lymphangitis present.",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
