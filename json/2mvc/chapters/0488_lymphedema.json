  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Pathologic accumulation of protein-rich lymph into interstitial spaces, especially subcutaneous fat due to primary/secondary",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "failure of lymphatic drainage.",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If chronic,",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "causes tissue fibrosis.",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May be congenital or acquired.",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1
            }
          ]
        },
