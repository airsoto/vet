        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog (more common) and cat.",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Congenital",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "in bulldogs.",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hereditary/congenital in a",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "family of poodles and whippets.",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Possible breed predilection in Labrador retrievers and Old English sheepdogs.",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary/congenital—peripheral limb",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "swelling/pitting edema at birth or develops",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "within the first several months.",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Progressive,",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "nonpainful swelling starting at distal extremity",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and slowly advances proximally.",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most common in limbs, especially pelvic",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "limbs; unilateral or bilateral.",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Less common",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "in ventral thorax, abdomen, ears, and tail.",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nonpainful pitting; affected area is",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "normothermic.",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pitting quality lost with",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "chronicity as fibrosis occurs.",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lameness and",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "pain uncommon unless cellulitis develops.",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Hereditary/congenital malformation of lymphatics—aplasia of thoracic duct, cisterna chyli or peripheral lymphatics, valvular incompetence, and lymph node fibrosis.",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Excessive interstitial fluid production due to venous hypertension (e.g., congestive heart failure, venous obstruction) or increased vascular permeability (e.g., infection, trauma,",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "heat, irradiation).",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary damage to lymphatic vessels or lymph nodes—associated",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "with trauma, infection (e.g.,Brugia pahangi",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "lymphatic filarial infection—Southeast Asia),",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1,
              "subheading": "with trauma, infection (e.g.,Brugia pahangi"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "neoplasia (e.g., lymphoma, lymphangiosarcoma",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1,
              "subheading": "with trauma, infection (e.g.,Brugia pahangi"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "[rare]), radiation therapy and thoracic duct",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1,
              "subheading": "with trauma, infection (e.g.,Brugia pahangi"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "ligation (rare).",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1,
              "subheading": "with trauma, infection (e.g.,Brugia pahangi"
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Edema due to venous stasis (e.g., congestive heart failure, cirrhosis); look for varices, hyperpigmentation, and ulceration.",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Arteriovenous fistulae—listen for machinery murmur; feel for pulsatile vessels; confirm",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "with angiogram.",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Edema due to hypoproteinemia—protein-losing nephropathy or enteropathy, hepatic failure, serum loss from burns or hemorrhage; check serum protein",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "concentration.",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Trauma—review history; look for bruising and lacerations.",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neoplasia—if swelling is firm, obtain",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "aspirate for cytology.",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cellulitis—fever, pain,",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "and warm swelling.",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Insect bites.",
              "pdf_page": 935,
              "printed_page": 853,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
