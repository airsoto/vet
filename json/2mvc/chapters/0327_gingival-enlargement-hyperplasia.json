          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Biopsy—focal area or areas that do not respond to standard therapy.",
              "pdf_page": 645,
              "printed_page": 563,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Histopathology—to rule out neoplasia and other causes; histologic evaluation is only way to confirm.",
              "pdf_page": 645,
              "printed_page": 563,
              "column": 2
            }
          ]
        },
