      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Enlargement of gingival tissue due to proliferation of its elements (abnormal multiplication or increase in the normal number of cells in normal arrangement).",
              "pdf_page": 645,
              "printed_page": 563,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Probable familial tendency—boxers.",
              "pdf_page": 645,
              "printed_page": 563,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
