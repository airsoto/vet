          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs and rarely cats.",
              "pdf_page": 645,
              "printed_page": 563,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Breed predilections—boxers, Great Danes, collies, Doberman pinschers, Dalmatians.",
              "pdf_page": 645,
              "printed_page": 563,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Thickening and increase in height of attached gingiva and gingival margin— sometimes completely covers tooth surface.",
              "pdf_page": 645,
              "printed_page": 563,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Resultant formation of “pseudopockets”— increase in pocket depth due to increased gingival height; not due to loss of attachment, unless untreated and progresses to concurrent periodontal disease.",
              "pdf_page": 645,
              "printed_page": 563,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gingival margin may be thickened in a labial to lingual direction, especially at incisors.",
              "pdf_page": 645,
              "printed_page": 563,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Locally affected areas possible (shelties), but typically more generalized pattern found.",
              "pdf_page": 645,
              "printed_page": 563,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Focally affected areas, other than the marginal gingiva, may develop hyperplastic areas due to chronic irritation, such as the “gum chewer’s lesion.” These areas should be evaluated for therapeutic need (excision).",
              "pdf_page": 645,
              "printed_page": 563,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May form as protuberant masses (grape cluster) at gingival margins—biopsy necessary to rule out neoplasia.",
              "pdf_page": 645,
              "printed_page": 563,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES",
          "canonical_heading": "CAUSES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Chronic inflammatory response to presence of bacteria in plaque associated with periodontal disease.",
              "pdf_page": 645,
              "printed_page": 563,
              "column": 1
            }
          ]
        },
        "RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "RISK FACTORS",
          "canonical_heading": "RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Breed predilection (see Signalment).",
              "pdf_page": 645,
              "printed_page": 563,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic drug administration— diphenylhydantoin, cyclosporine, nitrendipine, nifedipine, amlodipine.",
              "pdf_page": 645,
              "printed_page": 563,
              "column": 1
            }
          ]
        },
        "CAUSES & RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": []
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Presumptive diagnosis based on clinical appearance, especially if generalized and found in breed with high predilection.",
              "pdf_page": 645,
              "printed_page": 563,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Oral neoplasia—e.g., peripheral odontogenic fibromas; usually not generalized; sometimes osseous changes present.",
              "pdf_page": 645,
              "printed_page": 563,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Oral papillomatosis—papilloma usually on mucosal surfaces.",
              "pdf_page": 645,
              "printed_page": 563,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Operculum—seen in young animals during eruption phase of teeth; incomplete loss and/or persistence of gingival tissue covering erupting tooth.",
              "pdf_page": 645,
              "printed_page": 563,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic sublingual or buccal trauma with proliferation—“gum chewer’s lesion.”",
              "pdf_page": 645,
              "printed_page": 563,
              "column": 2
            }
          ]
        },
