          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Intraoral radiography—to rule out any underlying osseous changes (more common with epulides or tumors).",
              "pdf_page": 645,
              "printed_page": 563,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
