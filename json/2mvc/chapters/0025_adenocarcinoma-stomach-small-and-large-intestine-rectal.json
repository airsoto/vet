          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog more commonly affected than cat.",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Middle-aged to older (>6 years) animals; age range 3–13 years.",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No breed predisposition.",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Possible male predisposition.",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
