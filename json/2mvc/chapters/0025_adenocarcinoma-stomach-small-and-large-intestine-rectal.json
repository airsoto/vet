        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Stomach and small intestine—may see microcytic, hypochromic, nonregenerative anemia (iron-deficiency anemia). Mild and persistent elevations in blood urea nitrogen in the face of normal creatinine can support GI protein or blood loss.",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Large intestine and rectum—no characteristic changes.",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Fecal occult blood may be positive; diet affects results—can recheck to confirm after 3 days of non-meat diet.",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 1
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ultrasound—may reveal a thickened stomach or bowel wall; may see mass in the gastrointestinal tract, enlarged lymph nodes.",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Positive contrast radiography—filling defect (stomach); intraluminal space-occupying or annular constriction (small bowel); gastric neoplasm most often found in distal twothirds of stomach.",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Double contrast radiography—large intestine and rectum; polypoid or annular space-occupying masses.",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Advanced imaging with contrast CT can provide highest-quality images of gastrointestinal tract and assessment for presence and extent of lymphadenopathy.",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ultrasound-guided fine-needle aspirate of bowel mass or enlarged lymph node may provide definitive cytologic diagnosis.",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Endoscopic biopsy may be nondiagnostic because tumors are frequently deep to the mucosal surface; thus surgical biopsy often required.",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Presence of signet ring cells and/or cytoplasmic microvacuolation on cytologic evaluation of gastric biopsy squash prep samples correlated well with diagnosis of gastric adenocarcinoma in one study.",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
