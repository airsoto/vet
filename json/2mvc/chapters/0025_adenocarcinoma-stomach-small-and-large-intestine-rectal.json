    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgical resection—treatment of choice; seldom curative.",
          "pdf_page": 121,
          "printed_page": 39,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Gastric—usually nonresectable.",
          "pdf_page": 121,
          "printed_page": 39,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Small intestine—remove by resection and anastomosis; metastasis to regional lymph nodes and liver common.",
          "pdf_page": 121,
          "printed_page": 39,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Large intestine and rectal—may occasionally be resected via pull-through surgical procedure; metastasis common; transcolonic debulking may provide palliation of obstruction.",
          "pdf_page": 121,
          "printed_page": 39,
          "column": 2
        }
      ],
