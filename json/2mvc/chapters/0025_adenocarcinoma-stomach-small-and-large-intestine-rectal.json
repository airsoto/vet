          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Stomach—vomiting, anorexia, weight loss,",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hematemesis, and melena.",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Small intestine—vomiting, weight loss,",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "borborygmus, flatulence, and melena.",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Large intestine and rectum—mucus,",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "blood-tinged feces, and tenesmus.",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Stomach—nonspecific, melena on rectal",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "exam.",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Small intestine—may feel mid-abdominal",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "mass; distended, painful loops of small bowel.",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Large intestine and rectum—palpable mass",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "per rectum, may form annular ring, may have",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "multiple nodular lesions protruding into the",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "colon; bright red blood on rectal exam.",
              "pdf_page": 121,
              "printed_page": 39,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
