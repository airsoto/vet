        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Achondroplastic breeds—bulldog; Boston terrier; pug; Pekingese; Japanese spaniel; shih tzu.",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypochondroplastic breeds—dachshund; basset hound; beagle; Welsh corgi; Dandie Dinmont terrier; Scottish terrier; Skye terrier.",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reported nonselected chondrodysplastic abnormalities—Alaskan Malamute; Samoyed; Labrador retriever; English pointer; Norwegian elkhound; Great Pyrenees; cocker spaniel; Scottish terrier; Scottish deerhound; beagle; miniature poodle; French bulldog; Scottish fold cat.",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Oculoskeletal dysplasia—diagnosed in Labrador retriever and Samoyed.",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Phenotypically normal at birth, retardation of",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "growth recognized in first few months of life.",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually affects the appendicular skeleton;",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "may affect axial skeleton.",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Long bones—",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "appear shorter than normal; often bowed.",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Major joints (elbow, stifle, carpus, tarsus)—",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "appear enlarged.",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Radius and ulna—often",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "severely affected owing to asynchronous",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "growth.",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lateral bowing of the forelimbs.",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Enlarged carpal joints.",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Valgus deformity",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "of the paws.",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Shortened maxilla—relative",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "mandibular prognathism.",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Spinal devia-",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "tions—due to vertebral abnormalities (hemi,",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "wedge, block, transitional, etc.).",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Retina—",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "dysplasia; partial to complete detachment.",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
