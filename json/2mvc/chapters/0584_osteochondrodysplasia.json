      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "A developmental abnormality of cartilage and bone; encompasses many disorders",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "involving bone growth.",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Results from abnormal endochondral ossification.",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Skeletal defects—usually involve the appendicular skeleton; specifically the metaphyseal growth plates.",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Achondroplasia—failure of cartilage growth; characterized by a proportionate short-limbed dysplasia; evident soon after birth.",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypochondrodysplasia—less severe form",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "of achondrodysplasia.",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Characteristic breeds—result of selection of certain desirable",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "traits.",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affects musculoskeletal and possibly ophthalmic systems.",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1
            }
          ]
        },
