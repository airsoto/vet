          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Achondrodysplastic and hypochondrodysplastic breeds—autosomal dominant trait.",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nonselected chondrodysplastic breeds— autosomal recessive or polygenic trait.",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Littermates often affected.",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Congenital",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "hypothyroidism.",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Autosomal incomplete dominant trait in Scottish folds.",
              "pdf_page": 1088,
              "printed_page": 1006,
              "column": 1
            }
          ]
        }
      }
    },
