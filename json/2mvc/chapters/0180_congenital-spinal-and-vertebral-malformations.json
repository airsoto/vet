        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Survey radiography—to reveal vertebral malformation(s) and deviation of the spinal column.",
              "pdf_page": 395,
              "printed_page": 313,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Myelography—to determine the level(s) of spinal cord compression; flexed and extended views may cause neurologic deterioration if instability present.",
              "pdf_page": 395,
              "printed_page": 313,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CT myelography and 3D reconstructed imaging—to characterize bony abnormalities and associated spinal cord compression.",
              "pdf_page": 395,
              "printed_page": 313,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "MRI—sensitive modality to visualize abnormalities of spinal cord parenchyma, cauda equina, nerve roots, and surrounding soft tissues.",
              "pdf_page": 395,
              "printed_page": 313,
              "column": 3
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Cerebrospinal fluid analysis to rule out infectious/inflammatory conditions.",
              "pdf_page": 395,
              "printed_page": 313,
              "column": 3
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
