        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Distortion of the spinal column—lordosis; kyphosis; and scoliosis in cases of vertebral malformations.",
              "pdf_page": 395,
              "printed_page": 313,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ataxia and paresis associated with spinal cord compression and trauma.",
              "pdf_page": 395,
              "printed_page": 313,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Signs vary with spinal cord segment(s) involved.",
              "pdf_page": 395,
              "printed_page": 313,
              "column": 2
            }
          ]
        },
        "CAUSES": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES",
          "canonical_heading": "CAUSES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Breed-related inherited defects are suspected for most congenital spinal abnormalities, although interactions between several genes and environmental factors (e.g., teratogenic compounds, nutritional deficiencies) are likely involved and would explain some of these complex pathologic changes.",
              "pdf_page": 395,
              "printed_page": 313,
              "column": 2
            }
          ]
        },
