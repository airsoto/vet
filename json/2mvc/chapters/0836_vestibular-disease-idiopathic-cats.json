        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Marked improvement, especially in resting nystagmus starting within 72 hours, with progressive improvement of gait and head tilt.",
              "pdf_page": 1507,
              "printed_page": 1425,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Patients usually normal within 2–3 weeks.",
              "pdf_page": 1507,
              "printed_page": 1425,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Head tilt—final sign to resolve; mild residual tilt may remain.",
              "pdf_page": 1507,
              "printed_page": 1425,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If signs do not improve rapidly, other causes of vestibular disease should be pursued.",
              "pdf_page": 1507,
              "printed_page": 1425,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rarely recurs.",
              "pdf_page": 1507,
              "printed_page": 1425,
              "column": 2
            }
          ]
        }
