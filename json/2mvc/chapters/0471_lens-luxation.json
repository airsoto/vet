        },
        "CONTRAINDICATIONS/POSSIBLE INTERACTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Topical miotics—contraindicated if lens in anterior chamber.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Client must verify location of lens prior to applying a miotic",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mannitol—contraindicated in patients with cardiac disease, dehydration, pulmonary edema, anuria and intracranial bleeding.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 3
            }
          ]
        },
        "ALTERNATIVE DRUG(S)": {
