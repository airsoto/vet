    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Medically treated primary posterior luxation—recheck IOP 24 hours after starting treatment and frequently thereafter; once IOP is stable, re-examine patient 3 or 4 times/year.",
          "pdf_page": 909,
          "printed_page": 827,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Monitor for secondary glaucoma and retinal detachment.",
          "pdf_page": 909,
          "printed_page": 827,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "If only one lens is involved at the time of examination, the other lens may eventually luxate as well; the ophthalmologist may choose to perform prophylactic phacoemulsification in the contralateral eye if not yet luxated.",
          "pdf_page": 909,
          "printed_page": 827,
          "column": 3
        }
      ],
