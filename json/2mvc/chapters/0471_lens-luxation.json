        "OTHER LABORATORY TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": []
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiographs, abdominal ultrasonography—may be indicated if intraocular neoplasia.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ocular ultrasonography—useful if corneal edema or cloudy ocular media preclude examination.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Complete ophthalmic examination, including tonometry.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Genetic test available for some predisposed breeds.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
