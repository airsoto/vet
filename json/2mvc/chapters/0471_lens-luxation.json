          "source_heading": null,
          "canonical_heading": "INCIDENCE/PREVALENCE",
          "content_blocks": []
        },
        "GEOGRAPHIC DISTRIBUTION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GEOGRAPHIC DISTRIBUTION",
          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary—usually adult dogs (typically 3–6 years); common breeds include terriers, Chinese crested and Chinese Shar-Pei. Rare in cats.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary—dog and cat; any age/breed.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Fibrils of liquefied vitreous in anterior chamber.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abnormally shallow (anterior luxation) or deep anterior chamber (posterior luxation).",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abnormal iris curvature secondary to tilting of lens.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Phacodonesis (tremor of lens with globe movement).",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Iridodonesis (tremor of iris with globe",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Aphakic crescent (crescent-shaped area of pupil lacking lens).",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute or chronic painful eye, episcleral injection, diffuse or central corneal edema.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Glaucoma more common in anterior lens luxation but can be detected in any stage.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Uveitis.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cataracts.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Retinal detachment.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary—associated withADAMTS17 gene mutation in some canine breeds; inheritance pattern uncertain in others.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary luxation and primary glaucoma— may occur simultaneously in some breeds.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic uveitis.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intraocular neoplasia—secondary to physical luxation or chronic inflammation.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Trauma—rarely causes a normal lens to luxate without severe ocular injury.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cataracts—can cause tension and breakage of lens zonules.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 2
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Uveitis, glaucoma—painful, red eyes with corneal edema; may be concurrent.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Buphthalmia may cause lens luxation.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Corneal endothelial dystrophy or degeneration may also cause corneal edema.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diagnosis made by careful ophthalmic examination and history.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Normal, unless systemic disease present.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
