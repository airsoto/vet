    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Potentially visual eyes—immediate referral to a veterinary ophthalmologist for possible intracapsular lens extraction is indicated.",
          "pdf_page": 909,
          "printed_page": 827,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Manual trans-corneal reduction of anterior lens luxation and medical management of posterior luxation has been described.",
          "pdf_page": 909,
          "printed_page": 827,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Topical miotic therapy may be used to keep a posteriorly luxated lens behind pupil and avoid surgery in some cases.",
          "pdf_page": 909,
          "printed_page": 827,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Irreversibly blind eyes can be enucleated or eviscerated with intrascleral prosthesis; if secondary to neoplasia, enucleation is the best choice (therapeutic and diagnostic).",
          "pdf_page": 909,
          "printed_page": 827,
          "column": 2
        }
      ],
