    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Topical miotics—demecarium bromide or prostaglandin analogs (latanoprost) q12h indicated if the lens is primarily subluxated or posteriorly luxated.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If the pupil is blocked due to anterior lens luxation, tropicamide may allow the pupil to dilate, releasing lens and decreasing risk for pupillary block glaucoma.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mannitol: 1 g/kg IV over 20 minutes indicated for intraocular pressure (IOP) >40 mmHg.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Carbonic anhydrase inhibitors—topical dorzolamide q8h for high IOP.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Topical anti-inflammatory—0.1% dexamethasone sodium phosphate or 1% prednisolone acetate (q6–24h) if inflammation present.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 3
            }
          ]
        },
        "CONTRAINDICATIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
