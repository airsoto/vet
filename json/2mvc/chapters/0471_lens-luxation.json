  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Lens luxation—total dislocation of lens from its normal location; occurs when lens capsule separates 360° from the zonules that hold lens in place.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anterior—forward displacement through the pupil into anterior chamber.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Posterior—backward displacement into vitreous.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Subluxation—partial separation of lens from its zonular attachments; lens remains in a normal or near-normal position in pupil.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary (hereditary) luxation—inherited zonular defect of dogs resulting in bilateral but often asymmetrical clinical signs.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Congenital luxation—often associated with other congenital ocular anomalies.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary luxation—due to chronic inflammation, buphthalmia, intraocular neoplasia, senile zonular degeneration, or trauma.",
              "pdf_page": 909,
              "printed_page": 827,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
        "PATHOPHYSIOLOGY": {
          "present": false,
          "status": "missing",
