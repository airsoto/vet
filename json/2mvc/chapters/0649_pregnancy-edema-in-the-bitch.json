        },
        "RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "RISK FACTORS",
          "canonical_heading": "RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Large litter (10–12+).",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Occurs variably with previous/subsequent pregnancies.",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 2
            }
          ]
        },
