        "PRECAUTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "PRECAUTIONS",
          "canonical_heading": "PRECAUTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Any drug used is likely to cross the placenta; fetal effects should be considered and informed consent acquired.",
              "pdf_page": 1206,
              "printed_page": 1124,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The use of diuretics can exacerbate hyper tension by promoting dehydration, and at this time, use of diuretics cannot be routinely recommended unless studies demonstrate benefit to the dam/fetuses (beyond anecdotal reports).",
              "pdf_page": 1206,
              "printed_page": 1124,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In humans, the role of diuretics in obstetric practice is restricted to the management of pulmonary edema in preeclampsia.",
              "pdf_page": 1206,
              "printed_page": 1124,
              "column": 1
            }
          ]
        },
