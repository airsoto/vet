    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Uteromegaly—closed pyometra, pregnancy.",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Edema—cardiogenic, secondary to electrolyte abnormalities, hypoalbuminemia, vasculitis, protein losing nephropathy or enteropathy, thrombosis, or hepatopathy.",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominomegaly—ascites, hepato/splenomegaly, ruptured uterus, uterine torsion.",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypertension—primary, secondary to renal disease, endocrine disease.",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "May be normal; anticipated anemia of pregnancy, stress leukogram, possible electrolyte abnormalities (e.g., hyponatremia, hyperkalemia, hypomagnesemia). Proteinuria possible.",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypomagnesemia is associated with preeclampsia in women.",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Consider urine electrolyte evaluation if electrolyte abnormalities exist.",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urine protein creatinine ratio if proteinuric.",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Adrenocorticotropic hormone stimulation test can identify hypo- or hyperadrenocorticism.",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal ultrasound with attention to fetal viability, and intra-abdominal, intrauterine, placental, allantoic and amniotic fluid volumes.",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Echocardiography for evaluation of dam for cardiac disorders.",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Blood pressure measurement, serial if hypertensive.",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tocodynamometry to assess myometrial activity/irritability.",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fetal heart rate determinations with Doppler or ultrasound to determine fetal wellbeing.",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 3
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Poorly characterized; collection of deceased fetuses, placentae encouraged for histopatho logic evaluation.",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Consider uterine/placental biopsy during cesarean section.",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Complete necropsy with histopathology desirable in the event of maternal death to elucidate the cause.",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 3
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "GENERAL": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GENERAL",
          "content_blocks": []
        },
        "APPROPRIATE HEALTH CARE": {
          "present": true,
          "status": "content",
          "source_heading": "APPROPRIATE HEALTH CARE",
          "canonical_heading": "APPROPRIATE HEALTH CARE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Address life-threatening conditions (malignant hypertension, hypomagnesemia) first, then secondary conditions (edema, nausea).",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Medical pregnancy termination not advised due to the fragile condition of the bitch and likely myometrial hypocontractility.",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 3
            }
          ]
        },
        "NURSING CARE": {
          "present": true,
          "status": "content",
          "source_heading": "NURSING CARE",
          "canonical_heading": "NURSING CARE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Mild distal limb edema can benefit from mild walking, hydrotherapy, or massage. Elevating the limbs and avoiding further compression of the caudal abdominal veins/lymphatics can help disseminate edema.",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 3
            }
          ]
        },
        "ACTIVITY": {
          "present": true,
          "status": "content",
          "source_heading": "ACTIVITY",
          "canonical_heading": "ACTIVITY",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Appropriate but not excessive restriction.",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 3
            }
          ]
        },
        "DIET": {
          "present": true,
          "status": "content",
          "source_heading": "DIET",
          "canonical_heading": "DIET",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Mild sodium restriction if advanced heart disease is present.",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Appropriate-for-pregnancy dietary protein, especially if hypoalbuminemia or significant proteinuria present.",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 3
            }
          ]
        },
        "CLIENT EDUCATION": {
          "present": true,
          "status": "content",
          "source_heading": "CLIENT EDUCATION",
          "canonical_heading": "CLIENT EDUCATION",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Anticipate the likely need for cesarean section due to litter size, uterine wall distension, and vulvar edema contributing to an obstructive dystocia.",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 3
            }
          ]
        },
        "SURGICAL CONSIDERATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "SURGICAL CONSIDERATIONS",
          "canonical_heading": "SURGICAL CONSIDERATIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Elective cesarean section at term, or pregnancy termination via ovariohysterectomy should be considered in cases of severe edema.",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 3
            }
          ]
        },
