    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypertension—hydralazine 0.5–2 mg/kg PO q12h, titrate up to effect; or 0.2 mg/kg IM; repeat q2h as needed; monitor for hypotension, hospitalize until normotensive. Continue blood pressure monitoring until normotension is maintained.",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypomagnesemia and related signs— magnesium sulfate 0.7–1 mEq/kg/ day IV CRI; 0.25 mEq/kg slow IV bolus (loading dose); reduce 50% if patient is azotemic.",
              "pdf_page": 1205,
              "printed_page": 1123,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Edema—medical treatment of edematous conditions in pregnancy in the bitch is controversial and without evidence-based",
              "pdf_page": 1206,
              "printed_page": 1124,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "data. In human medicine, diuretics arenot",
              "pdf_page": 1206,
              "printed_page": 1124,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "advised to treat physiologic edema of",
              "pdf_page": 1206,
              "printed_page": 1124,
              "column": 1,
              "subheading": "data. In human medicine, diuretics arenot"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "pregnancy and do not prevent preeclampsia.",
              "pdf_page": 1206,
              "printed_page": 1124,
              "column": 1,
              "subheading": "data. In human medicine, diuretics arenot"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nausea/anorexia—metoclopramide",
              "pdf_page": 1206,
              "printed_page": 1124,
              "column": 1,
              "subheading": "data. In human medicine, diuretics arenot"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(0.1–0.2 mg/kg SC or PO q12h, ondansetron",
              "pdf_page": 1206,
              "printed_page": 1124,
              "column": 1,
              "subheading": "data. In human medicine, diuretics arenot"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "[FDA pregnancy category B; 0.5–1 mg/kg",
              "pdf_page": 1206,
              "printed_page": 1124,
              "column": 1,
              "subheading": "data. In human medicine, diuretics arenot"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "PO q8–12h], maropitant [1 mg/kg SC or",
              "pdf_page": 1206,
