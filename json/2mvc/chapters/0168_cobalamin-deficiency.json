        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "In the United States, Chinese Shar-Pei have a high prevalence of cobalamin deficiency. Isolated families of other breeds, such as the giant schnauzer, beagle, border collie, and Australian shepherd dog, have also been described as having cobalamin deficiency.",
              "pdf_page": 372,
              "printed_page": 290,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No other breed, sex, or age predilections are known for canine or feline patients with cobalamin deficiency.",
              "pdf_page": 372,
              "printed_page": 290,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical signs attributable to the underlying disease process:",
              "pdf_page": 372,
              "printed_page": 290,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Chronic enteropathy—diarrhea, weight",
              "pdf_page": 372,
              "printed_page": 290,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "loss, vomiting, poor appetite, or others.",
              "pdf_page": 372,
              "printed_page": 290,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "EPI—weight loss, failure to thrive, loose",
              "pdf_page": 372,
              "printed_page": 290,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "stools, steatorrhea, polyphagia or pica, borborygmus, flatulence.",
              "pdf_page": 372,
              "printed_page": 290,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical signs attributable to cobalamin deficiency—weight loss, failure to thrive, poor hair coat, lethargy, anorexia; less commonly signs of peripheral and central neuropathy such as a plantigrade stance or encephalopathy.",
              "pdf_page": 372,
              "printed_page": 290,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
