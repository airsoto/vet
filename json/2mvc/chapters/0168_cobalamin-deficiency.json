    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 1,
          "text": "Cyanocobalamin—usually at 1,000μg/mL",
          "pdf_page": 372,
          "printed_page": 290,
          "column": 3
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "for parenteral use; or 1,000μg tablets or 250μg and 1000μg chewable tablets for oral use.",
          "pdf_page": 372,
          "printed_page": 290,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 1,
          "text": "Hydroxocobalamin—usually at 1,000μg/",
          "pdf_page": 372,
          "printed_page": 290,
          "column": 3
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "mL; for parenteral use.",
          "pdf_page": 372,
          "printed_page": 290,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 1,
          "text": "Methylcobalamin—usually 1 mg capsule;",
          "pdf_page": 372,
          "printed_page": 290,
          "column": 3
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "for oral use.",
          "pdf_page": 372,
          "printed_page": 290,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 1,
          "text": "Cats receive 250μg/injection; dogs",
          "pdf_page": 372,
          "printed_page": 290,
          "column": 3
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "receive between 250μg (small dog) and 1,500μg (giant dog) per injection; doses should approximate 50μg/kg per injection within this dose range.",
          "pdf_page": 372,
          "printed_page": 290,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 1,
          "text": "In either species there are 6 weekly",
          "pdf_page": 372,
          "printed_page": 290,
          "column": 3
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "injections, one more injection a month later, and reevaluation of serum cobalamin concentration a month later.",
          "pdf_page": 372,
          "printed_page": 290,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 1,
          "text": "Cats receive 250μg/day; dogs receive",
          "pdf_page": 372,
          "printed_page": 290,
          "column": 3
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "between 250μg (small dog) and 1,000μg (giant dog) per day.",
          "pdf_page": 372,
          "printed_page": 290,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 1,
          "text": "Reevaluation of serum cobalamin",
          "pdf_page": 372,
          "printed_page": 290,
          "column": 3
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "concentration 2–4 weeks after the last dose.",
          "pdf_page": 372,
          "printed_page": 290,
          "column": 3
        }
      ],
