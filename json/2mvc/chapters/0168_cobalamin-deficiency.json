        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Intestinal disease involving the distal small intestine (i.e., the ileum)—inflammatory bowel disease, food-responsive enteropathy, lymphoma, others.",
              "pdf_page": 372,
              "printed_page": 290,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "EPI.",
              "pdf_page": 372,
              "printed_page": 290,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Short bowel syndrome.",
              "pdf_page": 372,
              "printed_page": 290,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hereditary (Chinese Shar-Pei, giant schnauzer, beagle, border collie, Australian shepherd dog).",
              "pdf_page": 372,
              "printed_page": 290,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dietary—being fed exclusively vegan or vegetarian diet without concurrent supple-",
              "pdf_page": 372,
              "printed_page": 290,
              "column": 2
            }
          ]
        }
      }
    },
