        "DEFINITION": {
          "present": true,
          "status": "content",
          "source_heading": "DEFINITION",
          "canonical_heading": "DEFINITION",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "An increase in packed cell volume (PCV), hemoglobin concentration, or red blood cell (RBC) count above the reference interval due to a relative or absolute increase in the number of circulating RBCs.",
              "pdf_page": 544,
              "printed_page": 462,
              "column": 1
            }
          ]
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Circulating RBC numbers are affected by changes in plasma volume, rate of RBC destruction or loss, splenic contraction, erythropoietin (EPO) secretion, and bone marrow production.",
              "pdf_page": 544,
              "printed_page": 462,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Erythropoiesis is also affected by hormones from the adrenal cortex, thyroid gland, ovary, testis, and anterior pituitary gland; normal PCV is maintained by an endocrine loop.",
              "pdf_page": 544,
              "printed_page": 462,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Erythrocytosis is either relative or absolute.",
              "pdf_page": 544,
              "printed_page": 462,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Relative—develops when hemoconcentration or splenic contraction produces an increase in circulating RBCs.",
              "pdf_page": 544,
              "printed_page": 462,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Absolute—increase in circulating RBC mass due to an increase in bone marrow production; either primary or secondary to an increase in the production of EPO.",
              "pdf_page": 544,
              "printed_page": 462,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary absolute (polycythemia vera)— myeloproliferative disorder characterized by neoplastic proliferation of all marrow cell precursors independent of EPO.",
              "pdf_page": 544,
              "printed_page": 462,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary absolute—caused by physiologically appropriate release of EPO due to chronic hypoxemia, excessive production of EPO or an EPO-like substance in an animal with normal partial pressure of oxygen (PaO2), or by excessive exogenous administration of EPO or darbepoetin.",
              "pdf_page": 544,
              "printed_page": 462,
              "column": 1
            }
          ]
        },
        "SYSTEMS AFFECTED": {
          "present": true,
          "status": "content",
          "source_heading": "SYSTEMS AFFECTED",
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Cardiovascular, respiratory, nervous, renal/urologic—blood hyperviscosity causes poor perfusion and oxygen delivery to tissues.",
              "pdf_page": 544,
              "printed_page": 462,
              "column": 1
            }
          ]
        },
        "GENETICS": {
          "present": true,
          "status": "content",
          "source_heading": "GENETICS",
          "canonical_heading": "GENETICS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Mutations of the JAK2 gene have been associated with polycythemia vera in humans.",
              "pdf_page": 544,
              "printed_page": 462,
              "column": 1
            }
          ]
        },
        "INCIDENCE/PREVALENCE": {
          "present": true,
          "status": "content",
          "source_heading": "INCIDENCE/PREVALENCE",
          "canonical_heading": "INCIDENCE/PREVALENCE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Relative erythrocytosis due to hemoconcentration or splenic contraction is the most common cause of erythrocytosis.",
              "pdf_page": 544,
              "printed_page": 462,
              "column": 1
            }
          ]
        },
