    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Polycythemia vera—hydroxyurea (dogs: 40–50 mg/kg PO divided twice daily; cats: 30 mg/kg PO q24h).",
              "pdf_page": 545,
              "printed_page": 463,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Erythrocytosis secondary to hypoxemia— hydroxyurea (40–50 mg/kg PO q48h).",
              "pdf_page": 545,
              "printed_page": 463,
              "column": 1
            }
          ]
        },
        "CONTRAINDICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS",
          "canonical_heading": "CONTRAINDICATIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Phlebotomy may be contraindicated in hypoxemic patients.",
              "pdf_page": 545,
              "printed_page": 463,
              "column": 1
            }
          ]
        },
        "PRECAUTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "PRECAUTIONS",
          "canonical_heading": "PRECAUTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Rapid removal of blood can cause hypotension and cardiovascular collapse.",
              "pdf_page": 545,
              "printed_page": 463,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Adverse effects of hydroxyurea include bone marrow hypoplasia with",
              "pdf_page": 545,
              "printed_page": 463,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "thrombocytopenia, anemia, and neutropenia, alopecia, changes in skin pigmentation, and sloughing of toenails.",
              "pdf_page": 545,
              "printed_page": 463,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Methemoglobinemia and hemolytic anemia reported in cats treated with hydroxyurea.",
              "pdf_page": 545,
              "printed_page": 463,
              "column": 2
            }
          ]
        },
        "POSSIBLE INTERACTIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "POSSIBLE INTERACTIONS",
          "content_blocks": []
        },
        "CONTRAINDICATIONS/POSSIBLE INTERACTIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": []
        },
        "ALTERNATIVE DRUG(S)": {
          "present": true,
          "status": "content",
          "source_heading": "ALTERNATIVE DRUG(S)",
          "canonical_heading": "ALTERNATIVE DRUG(S)",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Polycythemia vera—chlorambucil (dogs and cats: 0.2 mg/kg PO q24h) or busulfan (dogs: 2–4 mg/m2PO q24h).",
              "pdf_page": 545,
              "printed_page": 463,
              "column": 2
            }
          ]
        }
      }
    },
    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "PCV, total protein, urine output, and bodyweight daily in severely dehydrated animals.",
              "pdf_page": 545,
              "printed_page": 463,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Patients treated for polycythemia vera by chemotherapy—monitor weekly for changes in PCV, leukocytes, and platelets during initial treatment; then monthly for adjustment of chemotherapy and periodic phlebotomy.",
              "pdf_page": 545,
              "printed_page": 463,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Periodic assessment of bone marrow iron stores or serum iron levels is indicated to detect iron deficiency.",
              "pdf_page": 545,
              "printed_page": 463,
              "column": 2
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": []
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperviscosity in patients with absolute polycythemia, especially polycythemia vera, may lead to thrombosis, infarction, or hemorrhage.",
              "pdf_page": 545,
              "printed_page": 463,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chemotherapy may cause bone marrow suppression.",
              "pdf_page": 545,
              "printed_page": 463,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Patients undergoing repeated phlebotomies can develop iron deficiency, hypoproteinemia, and peripheral edema.",
              "pdf_page": 545,
              "printed_page": 463,
              "column": 2
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Relative erythrocytosis—fair to good prognosis depending on primary cause.",
              "pdf_page": 545,
              "printed_page": 463,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary absolute appropriate erythrocytosis—clinical course and prognosis are determined by the severity of the lesion causing hypoxemia.",
              "pdf_page": 545,
              "printed_page": 463,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary inappropriate absolute erythrocytosis—if the tissue source of excessive EPO secretion can be identified and removed or corrected, prognosis is good to fair depending on cause.",
              "pdf_page": 545,
              "printed_page": 463,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary absolute erythrocytosis (polycythemia vera)—prognosis is guarded, although cats have had survival times up to 5 years.",
              "pdf_page": 545,
              "printed_page": 463,
              "column": 3
            }
          ]
        }
      }
    },
