          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "All dog breeds can be affected.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Not reported in cats.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "English bulldog (EB), French bulldog, boxer, Doberman pinscher (DP), and Labrador retriever are predisposed.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reported prevalence of 19–38% in EB.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reports that males are overrepresented in DP and EB.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Generally starts early in life (<3 years old), but can start at any age.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute onset of head tremor episodes.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Possible recent stressful event (heat, whelping",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "with lactation, vaccination, illness, etc.).",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Littermates may be affected (familial form",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "identified in DP ≤1 year old).",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "None if not currently experiencing an episode.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Typical vertical or horizontal rapid (4–8 Hertz",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "or movements per second) head tremors—",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "episodes last from a few seconds to a few hours.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Variable tremor episode frequency,",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "duration, and interepisode interval.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Occasional reports of abnormal dystonic",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "posture (subtle head tilt, stiffness, floppiness)",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "during episodes, but not between episodes.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Occasional reports of abnormal behavior",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(disorientation, sleepiness, agitation)",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "immediately prior to episode.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "All dogs are reported to be responsive to",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "their surroundings during the episode.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rare reports of associated generalized seizure.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Episodes can often be interrupted by",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "distraction or treats.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other neurologic abnormalities (ataxia,",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "proprioceptive deficits, paresis) consistent",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "with concurrent, unrelated neurologic disease",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(cervical spondylomyelopathy in DP,",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hemivertebrae in bulldogs) are often noted.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Unknown pathophysiology.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anatomic, neoplastic, and traumatic causes have been ruled out by different studies.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Genetic basis suspected but unproven.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May be triggered by a recent stressful event.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Tremorgenic toxin (mycotoxin, permethrins, etc.).",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Corticosteroid responsive shaker/tremor syndrome.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypomyelinating/dysmyelinating congenital or degenerative disease.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cerebellar disease (intention tremor).",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypocalcemia.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypoglycemia.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypoadrenocorticism (electrolyte imbalance).",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Epilepsy (focal or generalized seizures) or reactive seizures.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Stress.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Muscle fatigue following exercise or associated with generalized weakness from myopathy, neuropathy, or neuromuscular disease.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "History, signalment, and viewing of a video helps greatly in identifying this typical head movement and differentiating it from other types of tremor.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Variation from the above-described typical pattern should be video-filmed and reviewed.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
