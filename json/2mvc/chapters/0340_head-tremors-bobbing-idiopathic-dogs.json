  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Common, very specific, benign, often self-limiting, head and neck tremors in dogs.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Synonyms—head bobbing, wobbling, nodding, shaking, tremors; episodic head tremor syndrome; bobble head doll syndrome.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "A movement disorder (paroxysmal dyskinesia) was suspected, but the pathophysiology remains unknown and a recent electroencephalographic (EEG) study may support an epileptic syndrome.",
              "pdf_page": 667,
              "printed_page": 585,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
