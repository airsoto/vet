          "present": true,
          "status": "content",
          "source_heading": "APPROPRIATE HEALTH CARE",
          "canonical_heading": "APPROPRIATE HEALTH CARE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Compensated cats can be managed as outpatients if they are alert, hydrated, and eating and drinking without vomiting.",
