        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Fructosamine >350μmol/L—confirms persistence of hyperglycemia.",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Feline pancreas-specific lipase >3.50μg/L— identifies presence of pancreatitis.",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urine culture—positive in 10–15% of newly diagnosed DM.",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic and abdominal radiography— to evaluate for concurrent or underlying disease (e.g., neoplasia, cystic or renal calculi, emphysematous cystitis, or cholecystitis).",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal ultrasonography—in selected patients, particularly those with jaundice, to evaluate for hepatic lipidosis, cholangio hepatitis, and pancreatitis.",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Liver fine-needle aspiration—if concern for hepatic lipidosis.",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 3
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually no gross necropsy changes; pancreatic weight may be increased.",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Histopathology—normal, more likely to reveal islet amyloidosis, vacuolar or hydropic degeneration of the islets of Langerhans; lymphoplasmacytic pancreatic infiltration rare in cats.",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 3
            }
          ]
        }
      }
