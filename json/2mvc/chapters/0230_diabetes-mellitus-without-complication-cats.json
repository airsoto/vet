              "column": 2,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Signs suggesting a complication—anorexia,",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 2,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
