      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Stress hyperglycemia—no PU/PD or weight loss; blood glucose concentration normal if sample taken when cat is not stressed; normal fructosamine concentration.",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Renal glucosuria—absence of hyperglycemia; usually does not cause PU/PD or weight loss.",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Mild normocytic, normochromic anemia possible.",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Glucose>150 mg/dL.",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "High alkaline phosphatase (ALP), alanine aminotransferase (ALT), and aspartate aminotransferase (AST) activities.",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypercholesterolemia, hyperbilirubinemia, and hypertriglyceridemia.",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Total CO2or HCO3low with ketoacidosis or severe dehydration.",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Glucosuria, ketonuria uncommon in uncomplicated DM.",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Isosthenuria, proteinuria.",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 2
            }
          ]
        },
