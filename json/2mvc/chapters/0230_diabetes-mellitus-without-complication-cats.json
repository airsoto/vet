        "DEFINITION": {
          "present": true,
          "status": "content",
          "source_heading": "DEFINITION",
          "canonical_heading": "DEFINITION",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Disorder of carbohydrate, fat, and protein metabolism caused by an absolute or relative insulin deficiency, resulting in the hallmark abnormality of persistent hyperglycemia.",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The most common form in cats resembles Type II or non-insulin-dependent diabetes mellitus (DM) of humans.",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 1
            }
          ]
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Insulin resistance impairs the ability of tissues (especially muscle, adipose tissue, and liver) to use carbohydrates, fats, and proteins.",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Impaired systemic glucose utilization coupled with ongoing hepatic gluconeogenesis causes persistent hyperglycemia, which directly impairs insulin secretion by reducing functional beta cell mass (“glucose toxicity”).",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Initial beta cell dysfunction progresses to irreversible failure of insulin production as reactive oxidative species, inflammatory cytokines, and amyloid deposition perpetuate beta cell injury and loss.",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 1
            }
          ]
        },
        "SYSTEMS AFFECTED": {
          "present": true,
          "status": "content",
          "source_heading": "SYSTEMS AFFECTED",
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Endocrine/metabolic—electrolyte depletion, metabolic acidosis.",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hepatobiliary—chronic pancreatitis, hepatic lipidosis.",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neuromuscular—muscle wasting, peripheral neuropathy.",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Renal/urologic—osmotic diuresis with compensatory polydipsia (PD); urinary tract infection.",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 1
            }
          ]
        },
        "GENETICS": {
          "present": true,
          "status": "content",
          "source_heading": "GENETICS",
          "canonical_heading": "GENETICS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Genetic susceptibility suspected in certain breeds (e.g., European Burmese cats).",
              "pdf_page": 479,
              "printed_page": 397,
              "column": 1
            }
          ]
        },
