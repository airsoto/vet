    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Consider appropriate antimicrobic (i.e., lipid-soluble antibiotic chosen on the basis of antimicrobial susceptibility) if pseudocysts become infected.",
              "pdf_page": 1149,
              "printed_page": 1067,
              "column": 2
            }
          ]
        },
