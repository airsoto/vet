    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Monitor patients periodically (every 2–6 months) for development and progression of",
          "pdf_page": 1149,
          "printed_page": 1067,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "CKD.",
          "pdf_page": 1149,
          "printed_page": 1067,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Short-term prognosis appears favorable with or without pseudocyst decompression in patients with no evidence",
          "pdf_page": 1149,
          "printed_page": 1067,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "of CKD.",
          "pdf_page": 1149,
          "printed_page": 1067,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Long-term prognosis is unknown because it has not been determined whether perirenal pseudocysts are associated with underlying lesions in the renal parenchyma that may be progressive. It is also unknown whether perirenal pseudocysts are associated",
          "pdf_page": 1149,
          "printed_page": 1067,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "with hypertension.",
          "pdf_page": 1149,
          "printed_page": 1067,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Survival is related to the severity and progression of CKD.",
          "pdf_page": 1149,
          "printed_page": 1067,
          "column": 3
        }
      ],
