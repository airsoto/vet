      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Nonsteroidal anti-inflammatory drugs.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tramadol.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gabapentin.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intravenous aminobisphosphonates (pamidronate or zoledronate) might alleviate bone pain and attenuate bone resorption.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Empiric antibiotic therapy can be considered for secondary bacterial infections.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 2
            }
          ]
        },
