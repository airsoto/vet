    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other primary oral tumors, including melanoma, fibrosarcoma, squamous cell carcinoma, osteosarcoma, and acanthomatous ameloblastoma.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Maxillary invasion of primary nasal CSA.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Craniomandibular osteopathy.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dentigerous cyst, tooth root abscess, or osteomyelitis.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Usually normal.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": []
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiographs are recommended to screen for pulmonary metastasis.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Skull radiographs often will show features of an aggressive bone lesion (bone lysis, cortical destruction, nonhomogenous bone formation, ill-defined zone of transition); however, normal radiographs do not exclude bone involvement.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "High-detail dental radiographs may be appropriate for imaging smaller lesions.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CT imaging can more accurately determine extent of local disease and is useful for surgical planning, particularly caudal lesions; CT is generally required for radiation therapy planning.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Fine-needle aspiration (FNA) and cytology of the mass may provide provisional diagnosis. FNA and cytology are recommended for mandibular lymph nodes, especially if they are enlarged.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Histopathology is required to reach a definitive diagnosis; preoperative incisional biopsy is recommended.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If curative-intent surgery is performed, all excised tissue should be submitted to the",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "pathologisten blocfor evaluation of surgical",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "margin.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 2,
              "subheading": "pathologisten blocfor evaluation of surgical"
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
