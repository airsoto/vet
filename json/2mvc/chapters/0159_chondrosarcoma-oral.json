        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—medium- to large-breed dogs, with mixed-breed dogs, golden retrievers, boxers, and German shepherd dogs overrepresented; median age is 8 years (range: 1–15 years).",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—rarely affected.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Visible mass involving the mandible or",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "maxilla.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Halitosis, dysphagia, and/or hypersalivation.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bloody oral discharge and oral pain.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Weight loss secondary to a prolonged",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "decrease in food intake.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "A firm to hard mass centered on the maxilla",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "or mandible is seen most commonly.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The overlying gingival mucosa usually is",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "intact, although trauma and ulceration from",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "the occlusal teeth are common with larger",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "tumors.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Loose or missing teeth.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Difficulty or pain when opening the mouth",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(especially caudal tumors).",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Facial deformity.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mandibular lymphadenopathy.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nasal discharge, epistaxis, or decreased air",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "flow through the nares (maxillary tumors).",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
