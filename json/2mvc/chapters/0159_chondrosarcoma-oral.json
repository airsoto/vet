          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": []
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Prognosis depends on tumor size and location, and surgical resectability; with complete excision, long-term control may be possible.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most patients die or are euthanized due to local disease progression.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Overall CSA metastatic rate is 15–30%, with the lungs being affected most commonly; metastatic rates approach 50% for high-grade tumors.",
              "pdf_page": 353,
              "printed_page": 271,
              "column": 3
            }
          ]
        }
      }
    },
