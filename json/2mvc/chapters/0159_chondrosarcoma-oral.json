    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgical excision—removal of the affected segment of bone (maxillectomy or mandibulectomy) with a margin of at least 2 cm is recommended whenever possible.",
          "pdf_page": 353,
          "printed_page": 271,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "If excision is incomplete, adjuvant radiation therapy might help improve local control, although there is little information regarding efficacy.",
          "pdf_page": 353,
          "printed_page": 271,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Radiation therapy can be considered as a sole local treatment modality but, because of the chondroid matrix produced by CSAs, radiation therapy likely will stabilize tumor size and not necessarily cause substantial shrinkage.",
          "pdf_page": 353,
          "printed_page": 271,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Chemotherapy has not been evaluated, but is not thought to be effective.",
          "pdf_page": 353,
          "printed_page": 271,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Palliative care focuses on pain control.",
          "pdf_page": 353,
          "printed_page": 271,
          "column": 2
        }
      ],
