      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Bacterial uterine infection that develops in the immediate postpartum period (usually within the first week); occasionally develops after an abortion or nonsterile artificial insemination—rarely after natural breeding.",
              "pdf_page": 988,
              "printed_page": 906,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bacteria—ascend through the open cervix to the uterus; postpartum uterus provides an ideal environment for growth; Gram-negative",
              "pdf_page": 988,
              "printed_page": 906,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "bacteria (e.g.,Escherichia coli) commonly",
              "pdf_page": 988,
              "printed_page": 906,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "isolated.",
              "pdf_page": 988,
              "printed_page": 906,
              "column": 1,
              "subheading": "bacteria (e.g.,Escherichia coli) commonly"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Potentially life-threatening infection; may",
              "pdf_page": 988,
              "printed_page": 906,
              "column": 1,
              "subheading": "bacteria (e.g.,Escherichia coli) commonly"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "lead to septic shock.",
              "pdf_page": 988,
              "printed_page": 906,
              "column": 1,
              "subheading": "bacteria (e.g.,Escherichia coli) commonly"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Can become chronic and lead to infertility.",
              "pdf_page": 988,
              "printed_page": 906,
              "column": 1,
              "subheading": "bacteria (e.g.,Escherichia coli) commonly"
            }
          ]
        },
