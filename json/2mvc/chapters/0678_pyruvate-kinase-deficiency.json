        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Autosomal recessive trait recognized in basenji, beagle, West Highland white terrier, Cairn terrier, miniature poodle, dachshund, Chihuahua, pug, American Eskimo, and Labrador retriever dogs, and in Abyssinian, Somali, and domestic shorthair cats.",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Heterozygous-deficient Bengal, Egyptian Mau, La Perm, Maine coon, Norwegian Forest, Savannah, Siberian, and Singapura cats.",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affected homozygous animals are generally not recognized as abnormal until several months of age or adulthood.",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Affected cats are often asymptomatic.",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Signs of anemia and shock (lethargy, tachycardia, exercise intolerance, pale mucous membranes).",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Splenomegaly may be present.",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Systolic heart murmur due to anemia.",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Icterus is occasionally seen in cats but rarely in dogs, unless hepatic failure present.",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affected dogs may be slightly smaller than normal for their breed and age and may exhibit weakness and muscle wasting.",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affected cats may exhibit diarrhea, inappetence, poor coat quality, and weight loss.",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "RBCs from normal adult dogs exhibit only one PK isozyme (the R-type).",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Breed-specific defects in thePKLRgene result in erythrocyte PK deficiency in dogs.",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "A common molecular defect in thePKLR gene has been described in cats.",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other causes of hemolytic anemia— immune-mediated hemolytic anemia, hemotropic mycoplasmosis, babesiosis, Heinz",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "body hemolytic anemia, microangiopathic hemolytic anemia, and phosphofructokinase deficiency (dogs).",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affected animals—negative Coombs’ test, no parasites or Heinz bodies in stained blood",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "films, seronegative forBabesiaspp., and no",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "evidence of disseminated intravascular",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 2,
              "subheading": "films, seronegative forBabesiaspp., and no"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "coagulation or heartworm disease.",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 2,
              "subheading": "films, seronegative forBabesiaspp., and no"
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—persistent macrocytic hypochromic anemia, with hematocrit (HCT) of 16–28% and reticulocyte counts of 15–50%.",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—anemia is intermittent (HCT 13–40%), with slightly to markedly increased aggregate reticulocyte counts.",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Normal or slightly high total leukocyte counts.",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Normal to slightly high platelet counts.",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Moderate to marked polychromasia, anisocytosis, and increased nucleated RBCs on stained blood films.",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Poikilocytosis in splenectomized dogs.",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Possible abnormal clinical chemistry findings, such as hyperferremia, hyperbilirubinemia, and slightly high serum alanine aminotransferase and alkaline phosphatase activities. Hyperglobulinemia common in cats.",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Normal urinalysis, except for bilirubinuria in dogs.",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Total RBC PK activity—low value diagnostic in cats and some dogs; many affected dogs have normal or high activities because of the expression of an M2 isozyme that does not normally occur in mature RBCs; approximately 50% of normal activity in heterozygous animals.",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Additional assays (e.g., enzyme heat stability test, measurement of RBC glycolytic intermediates, electrophoresis of isozymes, and enzyme immunoprecipitation)—to reach a diagnosis in dogs whose total enzyme activity is not low.",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "DNA diagnostic tests—screening for cats and several dog breeds (available at http://research.vet.upenn.edu/penngen).",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 2
            }
          ]
        },
