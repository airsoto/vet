    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Affected animals can be cured by bone marrow transplantation or gene therapy.",
          "pdf_page": 1253,
          "printed_page": 1171,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Splenectomy may reduce the severity of the anemia in cats.",
          "pdf_page": 1253,
          "printed_page": 1171,
          "column": 2
        }
      ],
