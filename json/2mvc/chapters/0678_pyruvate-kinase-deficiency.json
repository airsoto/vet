  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Red blood cells (RBCs) require energy in the form of ATP for maintenance of shape, deformability, active membrane transport, and limited synthetic activities; mature RBCs lack mitochondria and depend on anaerobic glycolysis for ATP generation.",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pyruvate kinase (PK) catalyzes an important rate-controlling ATP-generating step in glycolysis; consequently, energy metabolism is markedly impaired in PK-deficient RBCs, resulting in shortened RBC lifespan and anemia; bone marrow compensation is reflected by erythroid hyperplasia and marked reticulocytosis.",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hepatic failure may result from chronic iron overload.",
              "pdf_page": 1253,
              "printed_page": 1171,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
