    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Hepatic iron overload—develops in affected dogs; can result in cirrhosis and liver failure.",
          "pdf_page": 1253,
          "printed_page": 1171,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Myelofibrosis and osteosclerosis—develop in affected dogs with age; most die by 5 years old as a result of bone marrow or liver failure.",
          "pdf_page": 1253,
          "printed_page": 1171,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Severe anemia with minimal reticulocytosis or abnormal liver function tests and ascites secondary to hypoalbuminemia indicate the terminal stage of the disease in dogs.",
          "pdf_page": 1253,
          "printed_page": 1171,
          "column": 3
        }
      ],
