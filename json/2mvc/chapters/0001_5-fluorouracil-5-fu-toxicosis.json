    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Anticonvulsant—levetiracetam 60 mg/kg IV loading dose, 20 mg/kg IV q8h; propofol 4–6 mg/kg IV bolus followed by 0.6 mg/kg/minute CRI; inhalant anesthesia; valium is typically ineffective; phenobarbital and pentobarbital have unpredictable efficacy, but can be attempted, phenobarbital 5–8 mg/kg IV slowly to effect.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Antiemetic—maropitant 1 mg/kg IV, SC q24h; ondansetron 0.1–0.2 mg/kg IV q6–12h; metoclopramide 0.1–0.5 mg/kg IV, SC q6–8h.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "GI protection—proton pump inhibitors, H2 blockers, sucralfate.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Analgesia—buprenorphine 0.005–0.03 mg/kg IM or IV q6–12h, butorphanol 0.1–0.5 mg/kg SC, IV, or IM.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Antibiotic—broad-spectrum antibiotic therapy if total white blood cell count is below 2000.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bone marrow stimulation—filgrastim (Neupogen®) 4–6μg/kg SQ q24h.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Transfusion therapy may be indicated if PCV <20%.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "20% intravenous fat emulsion (IFE) unlikely to be effective.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Antidote—uridine triacetate has not been used in veterinary medicine; must be instituted prior to development of CNS signs; cost prohibitive.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 3
            }
          ]
        },
