    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Emesis—not typically indicated due to rapid onset of seizures.",
          "pdf_page": 83,
          "printed_page": 1,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Single dose activated charcoal with sorbitol in asymptomatic patients; seizures may develop before opportunity to administer charcoal.",
          "pdf_page": 83,
          "printed_page": 1,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Gastric lavage can be performed in patients with recent exposure; a single dose of activated charcoal with a cathartic (AC/C) can be administered, recovering patient with endotracheal tube in place.",
          "pdf_page": 83,
          "printed_page": 1,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Balanced crystalloid IVF to maintain hydration, aid in elimination, and maintain perfusion.",
          "pdf_page": 83,
          "printed_page": 1,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Monitor blood pressure q4–6h.",
          "pdf_page": 83,
          "printed_page": 1,
          "column": 2
        }
      ],
