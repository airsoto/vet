  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Antimetabolite, antineoplastic agent; it is metabolized to thymidine, which blocks the methylation reaction of deoxyuridylic and thymidylic acids, resulting in thymine deficiency; thymine is critical for DNA and to a lesser extent RNA replication; the result is cell death due to interruption of normal DNA and RNA synthesis; this mechanism targets rapidly growing cells like bone marrow and intestinal crypts; 5-FU has various active metabolites resulting in delayed clearance from bone marrow andγ-aminobutyric acid (GABA) depletion in the brain.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Labeled for human use only.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Topical preparation for actinic and solar keratoses: Efudex® (5% cream, 2% and 5% solution), Carac® (0.5% cream), Fluoroplex® (1% cream), Tolak® (4% cream).",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "IV preparation used for a variety of neoplastic conditions: Adrucil® (50 mg/m: IV solution).",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Causes acute and severe gastroenteritis and seizures; seizures can develop within 30 minutes to 6 hours post exposure; bone marrow suppression occurs 7–21 days after acute presentation.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Patients may survive acute toxicity to succumb to bone marrow suppression later.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Any suspected exposure in animals warrants immediate veterinary evaluation.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 1
            }
          ]
        },
