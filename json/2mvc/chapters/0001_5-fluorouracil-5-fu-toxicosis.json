        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "No species or breed predilection.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cardiovascular—hypotension, myocardial ischemia, arrhythmias.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Immune—bone marrow suppression of all cell lines.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gastrointestinal (GI)—nausea, salivation, profuse vomiting, hematemesis, diarrhea, hematochezia, abdominal pain, stomatitis.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nervous—lethargy, ataxia, depression, disorientation, tremors, seizures (often refractory to treatment), death.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ophthalmic—blindness (cats).",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reproductive—teratogenic, embryotoxic.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory—noncardiogenic pulmonary edema, dyspnea, cyanosis, tachypnea.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 1
            }
          ]
        },
