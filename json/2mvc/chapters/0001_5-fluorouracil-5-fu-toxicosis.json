          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Access to topical preparations in the home.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats and small dogs may be exposed by licking pet owner.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pets in geographic locations of high human UV exposure due to increased human use.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other toxins—bromethalin, castor bean, cycad palms (CycasandZamiaspp.), disulfoton,",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "iron, metaldehyde, mushrooms (Amanita,",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Galerina, andLepiotaspp.), sodium fluoroac-",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "etate (Compound 1080), strychnine.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 2,
              "subheading": "Galerina, andLepiotaspp.), sodium fluoroac-"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metabolic—hepatic failure, hepatic",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 2,
              "subheading": "Galerina, andLepiotaspp.), sodium fluoroac-"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "encephalopathy.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 2,
              "subheading": "Galerina, andLepiotaspp.), sodium fluoroac-"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nervous—idiopathic epilepsy, meningitis,",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 2,
              "subheading": "Galerina, andLepiotaspp.), sodium fluoroac-"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "neoplasia.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 2,
              "subheading": "Galerina, andLepiotaspp.), sodium fluoroac-"
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "CBC—baseline, then continue to monitor q3–4 days post exposure for 21 days; monitor for echinocytes; leukopenia develops by day 7 and continues to day 13; thrombocytopenia develops by day 7 and can continue for 21 days; acute anemia due to blood loss can be secondary to bone marrow suppression by day 9, persisting until day 21.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chemistry—baseline; hepatic values may increase.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Electrolytes—baseline; recheck PRN based on GI losses.",
              "pdf_page": 83,
              "printed_page": 1,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
