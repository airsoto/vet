              "subheading": "Histologic"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "bodies—in epithelium of bronchi, stomach,",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 3,
              "subheading": "Histologic"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "urinary bladder; also in reticulum cells and",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 3,
              "subheading": "Histologic"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "leukocytes in lymphatic tissues.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 3,
              "subheading": "Histologic"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inclusion bodies in glial cells and neurons—",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 3,
              "subheading": "Histologic"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "frequently intranuclear; also in cytoplasm.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 3,
              "subheading": "Histologic"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Immunofluorescence and/or immunocyto",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 3,
              "subheading": "Histologic"
            },
            {
