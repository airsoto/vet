        "APPROPRIATE HEALTH CARE": {
          "present": true,
          "status": "content",
          "source_heading": "APPROPRIATE HEALTH CARE",
          "canonical_heading": "APPROPRIATE HEALTH CARE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Inpatient medical management to intensive care as indicated; isolate patient to prevent spread to other dogs.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 3
            }
          ]
        },
        "NURSING CARE": {
          "present": true,
          "status": "content",
          "source_heading": "NURSING CARE",
          "canonical_heading": "NURSING CARE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Symptomatic.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "IV fluids—for hypovolemia, support.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Oxygen therapy, nebulization, and coupage—for pneumonia.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Clean ocular, nasal discharges.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 3
            }
          ]
        },
        "ACTIVITY": {
          "present": true,
          "status": "content",
          "source_heading": "ACTIVITY",
          "canonical_heading": "ACTIVITY",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Limited, to reduce spread.",
