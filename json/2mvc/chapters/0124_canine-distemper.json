          "content_blocks": []
        },
        "DEFINITION": {
          "present": true,
          "status": "content",
          "source_heading": "DEFINITION",
          "canonical_heading": "DEFINITION",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute to subacute, contagious, febrile, often fatal disease with respiratory, urogenital, gastrointestinal, ocular, and CNS manifestations.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Caused by canine distemper virus (CDV), a Morbillivirusin theParamyxoviridaefamily.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affects many Carnivora species; mortality rate varies greatly.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 1
            }
          ]
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Natural route of infection—airborne and droplet exposure; from nasal cavity, pharynx, and lungs, virus replication occurs in local lymph nodes; within 1 week, viral shedding occurs (mainly in respiratory exudates but also urine) and virtually all lymphatic tissues become infected; spreads via viremia to surface epithelium of respiratory, gastrointestinal, and urogenital tracts and to CNS.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Disease progression depends on virus strain and host immune response:",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Strong cellular and humoral immune",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "response—subclinical infection.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Weak immune response—subacute",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "infection; longer survival.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Failed immune response—death within",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "2–4 weeks after infection; frequently due to CNS manifestations.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Viral excretion can occur for up to 2–3 months.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 1
            }
          ]
        },
        "SYSTEMS AFFECTED": {
          "present": true,
          "status": "content",
          "source_heading": "SYSTEMS AFFECTED",
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Multisystemic—all lymphatic tissues, surface epithelium in respiratory, alimentary, and urogenital tracts, skin, endocrine and exocrine glands.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CNS—brain and/or spinal cord.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 1
            }
          ]
        },
        "GENETICS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GENETICS",
          "content_blocks": []
        },
        "INCIDENCE/PREVALENCE": {
          "present": true,
          "status": "content",
          "source_heading": "INCIDENCE/PREVALENCE",
          "canonical_heading": "INCIDENCE/PREVALENCE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—sporadic outbreaks.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Wildlife (raccoons, skunks, fox, tigers)— fairly common.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 1
            }
          ]
        },
        "GEOGRAPHIC DISTRIBUTION": {
          "present": true,
          "status": "content",
          "source_heading": "GEOGRAPHIC DISTRIBUTION",
          "canonical_heading": "GEOGRAPHIC DISTRIBUTION",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Worldwide",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 1
            }
          ]
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Species",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Most species of the order Carnivora; has been",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 1,
              "subheading": "Species"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "reported in large exotic cats.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 1,
              "subheading": "Species"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Mean Age and Range",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Young, especially unvaccinated animals are",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 1,
              "subheading": "Mean Age and Range"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "most susceptible.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 1,
              "subheading": "Mean Age and Range"
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Fever—intermittent peaks starting 3–6 days after infection.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gastrointestinal and/or respiratory signs— nasal and ocular discharge, depression, anorexia, vomiting, diarrhea; often exacer bated by secondary bacterial infection.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CNS—common; generally after systemic disease (depends on virus strain).",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Gray matter disease—affects cerebral",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "cortex, brainstem, and spinal cord and may cause a nonsuppurative meningitis, seizures, mentation change, and ataxia; dogs may die in 2–3 weeks; some dogs recover (associated with prompt humoral and cell-mediated immunity), others develop white matter disease.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "White matter disease—multifocal disease,",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "commonly cerebellovestibular signs, paresis, ataxia, occasionally myoclonus; some dogs die 4–5 weeks after initial infection with noninflammatory, demyelinating disease; some dogs may recover with minimal CNS injury.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Optic neuritis and retinal lesions may occur; anterior uveitis, keratoconjunctivitis sicca possible.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hardening of footpads (hyperkeratosis) and nose—some virus strains; uncommon.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Enamel hypoplasia of teeth after neonatal infection.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 2
            }
          ]
        },
        "CAUSES": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES",
          "canonical_heading": "CAUSES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "CDV exposure.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Incompletely attenuated vaccines (rare).",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 2
            }
          ]
        },
        "RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "RISK FACTORS",
          "canonical_heading": "RISK FACTORS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Contact of nonimmunized animals with CDV-infected animals (dogs, wild carnivores).",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 2
            }
          ]
        },
        "CAUSES & RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": []
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Diagnosis based on clinical suspicion; combination of respiratory and gastrointestinal, ± CNS disease, in unvaccinated dog.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory signs—can mimic kennel cough.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Enteric signs—differentiate from canine parvovirus, coronavirus, parasitism (giardiasis), bacterial infections, gastroenteritis from toxin ingestion, inflammatory bowel disease.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CNS form—differentiate from auto immune meningoencephalitis (granulomatous meningoencephalomyelitis, necrotizing encephalitis, meningoencephalitis of unknown etiology), protozoal (e.g., toxoplasmosis, neosporosis), fungal (e.g., cryptococcosis), and rickettsial (e.g., ehrlichiosis, Rocky Mountain spotted fever) meningoencephalitis, rabies.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Lymphopenia in early infection; rare thrombocytopenia; intracytoplasmic inclusions in white and red blood cells.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Serology—positive antibody tests donot differentiate between vaccination and exposure to virulent virus; patient may die from acute disease before neutralizing antibody is produced. Immunoglobulin (Ig) M responses may occur up to 3 months after exposure to virulent virus, up to 3 weeks after vaccination; rising IgG titers in unvaccinated",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "dog are suggestive of infection; may be useful for risk assessment of clinically healthy dogs in shelter environment.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CDV antibody in cerebrospinal fluid (CSF)—indicative of distemper encephalitis, false negatives possible.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 3
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Radiographs—evaluate pulmonary disease.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CT and MRI—may or may not show lesions; MRI sensitive for demyelination.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 3
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Immunohistochemical detection in haired skin, nasal mucosa, and footpad epithelium.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Viral antigen or viral inclusions—in buffy coat cells, urine sediment, conjunctival or vaginal imprints, trans-tracheal wash (negative results do not rule out CDV).",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reverse transcriptase polymerase chain reaction (RT-PCR)—on buffy coat, urine sediment cells, respiratory secretions, conjunctival swabs, CSF; false negatives possible, false positives with recent vaccination (uncommon).",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CSF—moderate mononuclear pleocytosis, elevated concentrations of CDV-specific antibody, interferon, and viral antigen early in disease course.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 3
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
