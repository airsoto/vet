              "printed_page": 211,
              "column": 3,
              "subheading": "Gross"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lungs—patchy consolidation.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 3,
              "subheading": "Gross"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Footpads, nose—hyperkeratosis.",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 3,
              "subheading": "Gross"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mucopurulent discharges—from eyes and",
              "pdf_page": 293,
              "printed_page": 211,
              "column": 3,
              "subheading": "Gross"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "nose, bronchopneumonia, catarrhal enteritis,",
