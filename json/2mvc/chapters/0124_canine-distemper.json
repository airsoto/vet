    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Antiviral drugs—none known to be effective.",
              "pdf_page": 294,
              "printed_page": 212,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Broad-spectrum antibiotics—for secondary bacterial infection (CDV is immuno suppressive), beta-lactams or cephalosporins are good initial choices.",
              "pdf_page": 294,
              "printed_page": 212,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anticonvulsant therapy—phenobarbital, potassium bromide, levetiracetam.",
              "pdf_page": 294,
              "printed_page": 212,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Myoclonus—no proven treatment; single case report describes use of botulinum toxin type A.",
              "pdf_page": 294,
              "printed_page": 212,
              "column": 1
            }
          ]
        },
        "CONTRAINDICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS",
          "canonical_heading": "CONTRAINDICATIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Corticosteroids—use anti-inflammatory dosages with caution; may provide short-term control. Immunosuppressive dosages may enhance viral dissemination.",
              "pdf_page": 294,
              "printed_page": 212,
              "column": 1
            }
          ]
        },
        "PRECAUTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "PRECAUTIONS",
          "canonical_heading": "PRECAUTIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Tetracycline, fluoroquinolones—avoid in growing animals.",
              "pdf_page": 294,
              "printed_page": 212,
              "column": 1
            }
          ]
        },
