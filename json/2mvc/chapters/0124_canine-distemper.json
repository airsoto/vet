          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Inform client that mortality rate is about 50%.",
              "pdf_page": 294,
              "printed_page": 212,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inform client that dogs appearing to recover from early catarrhal signs may develop fatal CNS disease.",
              "pdf_page": 294,
              "printed_page": 212,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Presenting neurologic abnormalities usually not reversible.",
              "pdf_page": 294,
              "printed_page": 212,
              "column": 1
