              "printed_page": 212,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Recovered dogs may shed virus for up to 4 months; isolate for this time period or until multiple negative RT-PCR tests.",
              "pdf_page": 294,
              "printed_page": 212,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Vaccines",
