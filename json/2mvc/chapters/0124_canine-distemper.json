          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Vaccination.",
              "pdf_page": 294,
              "printed_page": 212,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Isolate puppies to prevent infection from wildlife (e.g., raccoons, foxes, skunks), CDV-infected dogs, ferrets.",
