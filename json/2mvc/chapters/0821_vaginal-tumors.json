      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Second most common reproductive tumor, comprising 1.9–3% of all tumors in dogs.",
              "pdf_page": 1478,
              "printed_page": 1396,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—83% benign smooth muscle tumors, often pedunculated (e.g., leiomyoma, fibroleiomyoma, and fibroma); less common differentials include lipoma, transmissible venereal tumor, mast cell tumor, squamous cell carcinoma, leiomyosarcoma, hemangio sarcoma, osteosarcoma, or extension of primary urinary tract carcinomas also reported.",
              "pdf_page": 1478,
              "printed_page": 1396,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—may be an incidental finding at necropsy.",
              "pdf_page": 1478,
              "printed_page": 1396,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—extremely rare; usually of smooth muscle origin.",
              "pdf_page": 1478,
              "printed_page": 1396,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hormonal influence—may play a role in the development of leiomyomas, fibromas, or polypoid tumors.",
              "pdf_page": 1478,
              "printed_page": 1396,
              "column": 1
            }
          ]
        },
