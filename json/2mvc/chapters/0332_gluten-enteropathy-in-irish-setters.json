          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Canine chronic enteropathy—food-responsive enteropathy, inflammatory bowel disease.",
              "pdf_page": 654,
              "printed_page": 572,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infectious diseases such asGiardia, hook worms, and roundworms.",
              "pdf_page": 654,
              "printed_page": 572,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metabolic abnormalities.",
              "pdf_page": 654,
              "printed_page": 572,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exocrine pancreatic insufficiency.",
              "pdf_page": 654,
              "printed_page": 572,
              "column": 1
            }
          ]
        },
