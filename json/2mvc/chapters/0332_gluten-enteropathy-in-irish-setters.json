        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Irish setter breed—the line of affected setters originally described in the UK has been bred out.",
              "pdf_page": 654,
              "printed_page": 572,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Signs develop in young dogs, but are modulated by the age of first exposure to gluten.",
              "pdf_page": 654,
              "printed_page": 572,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Genetic transmission of gluten sensitive enteropathy is likely under the control of a single major autosomal recessive locus.",
              "pdf_page": 654,
              "printed_page": 572,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gluten enteropathy has been suspected but not proven in other dog breeds and cats.",
              "pdf_page": 654,
              "printed_page": 572,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Poor weight gain (or weight loss).",
              "pdf_page": 654,
              "printed_page": 572,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Poor body condition.",
              "pdf_page": 654,
              "printed_page": 572,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mild small intestinal diarrhea that can be intermittent.",
              "pdf_page": 654,
              "printed_page": 572,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "The enteropathy and clinical signs are triggered by gluten-containing diets. Abnormal mucosal permeability precedes the development of signs, implying there is abnormal entry of gluten across the mucosal barrier. Gluten is then either directly toxic to the intestinal mucosa or induces an immunemediated reaction. An analogous condition in humans (celiac disease) is characterized by the presence of antibodies cross-reacting to gluten and tissue transglutaminase, but they have not been tested for in affected setters. These antibodies have been demonstrated in Border terriers with gluten-sensitive dyskinesia.",
              "pdf_page": 654,
              "printed_page": 572,
              "column": 1
            }
          ]
        }
      }
    },
