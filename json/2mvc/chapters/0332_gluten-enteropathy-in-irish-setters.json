      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "A rarely confirmed, inherited, intestinal disease in which sensitivity develops to dietary gluten (present in wheat) and similar proteins present in related grains (i.e., rye and barley). In affected dogs, the enteropathy is characterized by partial villous atrophy, reduced brush border enzyme expression, lymphocytic infiltration of the intestinal mucosa, and goblet cell hyperplasia; changes that are reversed by feeding a gluten-free diet.",
              "pdf_page": 654,
              "printed_page": 572,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
