          "source_heading": "DEFINITION",
          "canonical_heading": "DEFINITION",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Conduction delay or block in the anterior fascicle of the left bundle branch (Figures 1",
              "pdf_page": 898,
              "printed_page": 816,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "and 2).",
              "pdf_page": 898,
              "printed_page": 816,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Left ventricle activation is altered or delayed toward the blocked fascicle and corresponding papillary muscle.",
              "pdf_page": 898,
              "printed_page": 816,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Controversial terminology in veterinary cardiology because, in contrast to humans, dogs and cats do not appear to have an anatomic left anterior fascicle.",
              "pdf_page": 898,
              "printed_page": 816,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Electrocardiogram (ECG) Features",
              "pdf_page": 898,
              "printed_page": 816,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "QRS complex—normal duration.",
              "pdf_page": 898,
              "printed_page": 816,
              "column": 1,
              "subheading": "Electrocardiogram (ECG) Features"
            },
