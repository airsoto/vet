  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Also called feline diffuse iris melanoma.",
              "pdf_page": 1470,
              "printed_page": 1388,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The most common intraocular tumor in cats.",
              "pdf_page": 1470,
              "printed_page": 1388,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually arise from the anterior iridal surface with extension to the ciliary body and choroid.",
              "pdf_page": 1470,
              "printed_page": 1388,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tend to be flat and diffuse, not nodular (unlike intraocular melanomas in dogs).",
              "pdf_page": 1470,
              "printed_page": 1388,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Initially has a benign clinical and histologic appearance.",
              "pdf_page": 1470,
              "printed_page": 1388,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Unique feature—may develop metastatic disease up to several years later.",
              "pdf_page": 1470,
              "printed_page": 1388,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metastatic rate may be 8.1–63%.",
              "pdf_page": 1470,
              "printed_page": 1388,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary glaucoma may increase the risk for metastasis.",
              "pdf_page": 1470,
              "printed_page": 1388,
              "column": 1
            }
          ]
        },
