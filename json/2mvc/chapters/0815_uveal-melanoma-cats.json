        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "No sex or breed predisposition.",
              "pdf_page": 1470,
              "printed_page": 1388,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Average age is 9.5 years, although can affect any adult cat.",
              "pdf_page": 1470,
              "printed_page": 1388,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 1470,
              "printed_page": 1388,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Iris color change.",
              "pdf_page": 1470,
              "printed_page": 1388,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary glaucoma leading to mydriasis or",
              "pdf_page": 1470,
              "printed_page": 1388,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "buphthalmia, resulting in blindness.",
              "pdf_page": 1470,
              "printed_page": 1388,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 1470,
              "printed_page": 1388,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Iris surface—thickened, irregular, usually",
              "pdf_page": 1470,
              "printed_page": 1388,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "pigmented, though can be nonpigmented.",
              "pdf_page": 1470,
              "printed_page": 1388,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lesions—focal to diffuse; usually flat; slowly",
              "pdf_page": 1470,
              "printed_page": 1388,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "progressive; may involve one or both eyes.",
              "pdf_page": 1470,
              "printed_page": 1388,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Advanced disease—often see pigmented",
              "pdf_page": 1470,
              "printed_page": 1388,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "tumor cells in the aqueous; homogeneously",
              "pdf_page": 1470,
              "printed_page": 1388,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "thickened iris, black, velvety appearance.",
              "pdf_page": 1470,
              "printed_page": 1388,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May note drainage angle infiltration, which",
              "pdf_page": 1470,
              "printed_page": 1388,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "may result in secondary glaucoma.",
              "pdf_page": 1470,
              "printed_page": 1388,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
