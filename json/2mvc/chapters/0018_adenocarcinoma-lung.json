    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Serial thoracic radiographs—every 3 mths; administer minimum two cycles of chemo",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "therapy before evaluating response.",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Perform CBC (with any chemotherapy), biochemical analysis (cisplatin), and urinalysis (cisplatin) before each chemotherapy.",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 3
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": []
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Following diagnostic procedures or thoracotomy—pneumo‐ or hemothorax.",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Resulting from chemotherapy—myelo suppression, fever, sepsis, nausea.",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 3
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Metastasis to tracheobronchial lymph nodes—single best prognostic indicator; median survival without metastasis approaches 1 yr and with metastasis, 60 days. More",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "common (75%) in cats.",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Postoperative survival around 2 yrs in both cats and dogs if positive prognostic factors present, and~1 yr overall in dogs, 4 mths overall in cats.",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other patient, tumor, and treatment factors positively influencing prognosis—complete surgical excision; size of primary tumor (<5 cm); lack of metastasis; well‐differentiated cellular morphology on histopathology, lack of",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "clinical signs prior to surgery.",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Poor prognosis for cats with lung‐digit syndrome poor (~1 mth).",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 3
            }
          ]
        }
      }
    },
