        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiography—usually demonstrates focal, solitary, well‐circumscribed mass in dogs, often in caudal lung lobes; caudal lobes most common in cats, though radiographic patterns vary more and can include diffuse interstitial disease; radiographs must be performed in cats presenting with multiple digit tumors to screen for primary lung tumor (lung‐digit syndrome).",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ultrasonography—to obtain aspirate or biopsy specimen if mass in contact with chest wall, or",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "evaluate abdomen for primary tumor.",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CT—to assess surgical feasibility, lymphadenopathy (93% accuracy), metastatic disease; can see cavitated areas, irregular margins, bronchial invasion.",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracocentesis with cytologic examination",
