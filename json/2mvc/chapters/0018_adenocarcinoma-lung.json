              "printed_page": 31,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "(for pleural effusion).",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytology—transthoracic fine‐needle aspiration (83% agreement with",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "histopathology).",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Percutaneous tissue biopsy— use Tru‐Cut instrument, not commonly",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "performed.",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Open lung biopsy—via thoraco tomy, or minimally invasive thoracoscopy.",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 2
            }
          ]
        },
