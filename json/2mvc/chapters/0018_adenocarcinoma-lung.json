        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Adenocarcinoma—classified by location (bronchial, bronchiolar, bronchiolar‐alveolar, or alveolar) and degree of differentiation.",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Immunohistochemistry on biopsy for thyroid transcription factor‐1 (TTF‐1), surfactant protein A, and napsin A to confirm pulmonary carcinoma, especially adenocarcinoma. TTF‐1 and napsin A can also be seen in thyroid tumors.",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats tend to have less differentiated tumors, corresponding to more aggressive behavior.",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgery—mainstay of treatment: partial or complete lobectomy with tracheobronchial lymph node biopsy or removal; thoracoscopic removal possible at limited centers and offers",
          "pdf_page": 113,
          "printed_page": 31,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "less postoperative morbidity.",
          "pdf_page": 113,
          "printed_page": 31,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Radiotherapy— reports anecdotal, but certain patients may",
          "pdf_page": 113,
          "printed_page": 31,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "benefit.",
          "pdf_page": 113,
          "printed_page": 31,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Chemotherapy should be considered following surgery for tumors that are high grade, undifferentiated, and/or have nodal involvement, though no benefit confirmed. Intracavitary chemotherapy can be used to treat malignant pleural effusion.",
          "pdf_page": 113,
          "printed_page": 31,
          "column": 2
        }
      ],
