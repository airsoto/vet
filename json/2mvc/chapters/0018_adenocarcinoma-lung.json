    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Chemotherapy—vinorelbine concentrates in lungs and responses have been seen.",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Doxorubicin, cisplatin, carboplatin,",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "mitoxantrone, vinorelbine, and/or vindesine: rational choices for primary or adjuvant",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "therapy.",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Platinum‐based or gemcitabine",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "chemotherapy may be superior.",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Toceranib",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "phosphate (Palladia) has shown some anecdotal",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "success.",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chemotherapy can be toxic; seek advice if unfamiliar with cytotoxic drugs.",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 3
            }
          ]
        },
