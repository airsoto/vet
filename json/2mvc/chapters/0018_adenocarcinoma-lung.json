        "CONTRAINDICATIONS/POSSIBLE INTERACTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Doxorubicin—cardiotoxic, avoid in dogs with myocardial disease (arrhythmias);",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "nephrotoxic in cats.",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cisplatin—do not give to cats (fatal); do not use in dogs with preexisting renal disease; never use without appropriate and concurrent diuresis.",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 3
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "FOLLOW‐UP",
              "pdf_page": 113,
              "printed_page": 31,
              "column": 3
            }
          ]
        },
