        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary ciliary dyskinesia.",
              "pdf_page": 280,
              "printed_page": 198,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inadequately treated infectious or inflammatory lung conditions (pneumonia, bronchitis, or eosinophilic lung disease).",
              "pdf_page": 280,
              "printed_page": 198,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Smoke inhalation, chronic aspiration pneumonia, radiation injury, and inhalation of environmental toxins—predispose animal to airway injury and colonization by bacteria.",
              "pdf_page": 280,
              "printed_page": 198,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic bronchial obstruction or foreign body pneumonia—development of bronchiec tasis distal to the obstructed region common.",
              "pdf_page": 280,
              "printed_page": 198,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Signs related to bronchiectasis may not be recognized until long after the primary injury.",
              "pdf_page": 280,
              "printed_page": 198,
              "column": 1
            }
          ]
        }
      }
    },
