        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Primarily dogs but radiographically detected in many cats.",
              "pdf_page": 280,
              "printed_page": 198,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cocker spaniels and perhaps West Highland white terriers predisposed.",
              "pdf_page": 280,
              "printed_page": 198,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Young animals (<1 year) with primary ciliary dyskinesia.",
              "pdf_page": 280,
              "printed_page": 198,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Middle-aged to old dogs with chronic pulmonary disease.",
              "pdf_page": 280,
              "printed_page": 198,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic cough—usually moist and productive; hemoptysis.",
              "pdf_page": 280,
              "printed_page": 198,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Recurrent fever.",
              "pdf_page": 280,
              "printed_page": 198,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exercise intolerance.",
              "pdf_page": 280,
              "printed_page": 198,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tachypnea or respiratory distress.",
              "pdf_page": 280,
              "printed_page": 198,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic nasal discharge or sinusitis, particularly with primary ciliary dyskinesia.",
              "pdf_page": 280,
              "printed_page": 198,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Moist, harsh inspiratory crackles; loud expiratory lung sounds or wheezes on physical exam.",
              "pdf_page": 280,
              "printed_page": 198,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tracheal hypersensitivity.",
              "pdf_page": 280,
              "printed_page": 198,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
