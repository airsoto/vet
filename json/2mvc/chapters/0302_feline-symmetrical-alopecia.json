        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "No age, breed, or sex predilection reported.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Total to partial hair loss; most often symmetrical but can occur in a patchy distribution.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Areas of the body commonly affected— ventrum, caudal dorsum, and lateral and caudal thighs.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affected areas are often those accessible for grooming.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Patchy areas of hair loss (unsymmetrical) on distal extremities or body.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cutaneous hypersensitivity—flea allergic dermatitis, food, atopy.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ectoparasites—flea bite dermatitis, Cheyletiellosis,Otodectes cynotis.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infection—dermatophytosis.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neurologic or behavioral—“psychogenic alopecia” (uncommon as primary cause of symptoms).",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Stress or metabolic—telogen effluvium.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neoplasia—pancreatic neoplasia (paraneoplastic alopecia).",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperadrenocorticism.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Alopecia areata.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperthyroidism (early sign).",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
