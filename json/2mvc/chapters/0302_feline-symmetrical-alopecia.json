        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Flea combing—identify fleas, flea excrement, or both.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Microscopic examination of hair—selfinduced hair loss results in broken blunt shafts; endogenous hair loss results in tapered ends (telogen hairs).",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fecal examination—excess hair, mites, and ova (Cheyletiella), tapeworm, or fleas.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Food elimination diet trial—adverse reactions to food.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intradermal allergy testing—atopy.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Skin biopsy—confirm/exclude presence of underlying cause (e.g., hypersensitivity dermatitis vs. psychogenic, or rarely systemic disease).",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytology of papules or crusts, if present, may have large numbers of eosinophils.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Microscopic examination of skin scrapings—ectoparasites.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hair plucks (trichogram)—dermatophyte",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "arthrospores orDemodexmites adjacent to",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hair shafts.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 2,
              "subheading": "arthrospores orDemodexmites adjacent to"
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Histopathologic findings—vary depending on cause.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Feline psychogenic alopecia—hair follicles and skin normal.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "High numbers of mast cells, eosinophils, lymphocytes, or macrophages suggest allergic dermatitis.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Alopecia areata—lymphocytic inflammation that encircles bulb portions of hair follicles; rare.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Management of underlying cause.",
          "pdf_page": 603,
          "printed_page": 521,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Inform the owner of the diagnostic plan and the time it could take to see a response (hair coat regrowth).",
          "pdf_page": 603,
          "printed_page": 521,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Environmental enrichment in cases of true psychogenic cause.",
          "pdf_page": 603,
          "printed_page": 521,
          "column": 2
        }
      ],
