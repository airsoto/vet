              "type": "paragraph",
              "level": 0,
              "text": "Serum thyroxine—hyperthyroidism.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 1
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "not_applicable",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
