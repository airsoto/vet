    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Antihistamines—e.g., chlorpheniramine 0.5 mg/kg PO q8h; cetirizine 5 mg/cat q12–24h.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Glucocorticosteroid—prednisolone 0.5 mg/kg PO, tapering/alternate-day therapy.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Amitriptyline—1–2 mg/kg PO daily.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Clomipramine hydrochloride—0.5 mg/kg q24h.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cyclosporine, modified—5–7 mg/kg PO daily; tapering therapy.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 2
            }
          ]
        },
        "CONTRAINDICATIONS": {
          "present": false,
          "status": "missing",
