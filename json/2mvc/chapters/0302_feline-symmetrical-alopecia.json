  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Alopecia in a symmetrical pattern with no gross changes in the skin.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Common clinical presentation in cats.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Similar manifestation for many different underlying disorders.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
