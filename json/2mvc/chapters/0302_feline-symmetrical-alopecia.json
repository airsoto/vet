    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Frequent examinations are essential in confirming differential diagnoses.",
          "pdf_page": 603,
          "printed_page": 521,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Successful identification of underlying cause offers best prognosis, if cause can be controlled (e.g., flea bites or food hypersensitivity).",
          "pdf_page": 603,
          "printed_page": 521,
          "column": 3
        }
      ],
