        "POSSIBLE INTERACTIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "POSSIBLE INTERACTIONS",
          "content_blocks": []
        },
        "CONTRAINDICATIONS/POSSIBLE INTERACTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Glucocorticosteroids—can cause alopecia, diabetes mellitus, polydipsia, polyuria, polyphagia, and weight gain; can suppress pruritus, making it difficult to determine underlying cause.",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Withdraw antipruritic medications (including glucocorticosteroids) as diagnostic tests near completion (e.g., restrictedingredient food trials).",
              "pdf_page": 603,
              "printed_page": 521,
              "column": 2
            }
          ]
        },
        "ALTERNATIVE DRUG(S)": {
          "present": false,
          "status": "missing",
