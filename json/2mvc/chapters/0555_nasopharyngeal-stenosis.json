        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats of any breed or sex.",
              "pdf_page": 1042,
              "printed_page": 960,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Less commonly seen in dogs.",
              "pdf_page": 1042,
              "printed_page": 960,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Age—any age as long as ample time has passed since exposure to the inciting cause; congenital cases may present early or late in life.",
              "pdf_page": 1042,
              "printed_page": 960,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Evidence of upper respiratory obstruction.",
              "pdf_page": 1042,
              "printed_page": 960,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Whistling, stridorous, or snoring sounds during respiration.",
              "pdf_page": 1042,
              "printed_page": 960,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Open-mouth breathing.",
              "pdf_page": 1042,
              "printed_page": 960,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Minimal nasal discharge in many cases.",
              "pdf_page": 1042,
              "printed_page": 960,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Duration of signs for at least several months.",
              "pdf_page": 1042,
              "printed_page": 960,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Aggravation of obstruction during eating or drinking.",
              "pdf_page": 1042,
              "printed_page": 960,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Failure to respond to antibiotics or corticosteroids.",
              "pdf_page": 1042,
              "printed_page": 960,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Absence of nasal airflow from one or both nares.",
              "pdf_page": 1042,
              "printed_page": 960,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic upper respiratory disease.",
              "pdf_page": 1042,
              "printed_page": 960,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Foreign body or irritant contacting the affected area (perianesthetic regurgitation, reflux of gastric contents secondary to esophageal or gastric disease).",
              "pdf_page": 1042,
              "printed_page": 960,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Nasopharyngeal polyps—seen during oral examination or by radiography or endoscopy.",
              "pdf_page": 1042,
              "printed_page": 960,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic rhinitis or sinusitis—moderate to severe nasal discharge and sneezing; obvious radiographic changes in the rostral nasal cavity commonly seen.",
              "pdf_page": 1042,
              "printed_page": 960,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Foreign body—unilateral mucopurulent nasal discharge; radiographic abnormalities.",
              "pdf_page": 1042,
              "printed_page": 960,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intranasal neoplasia—unilateral obstruction; nasal discharge often bloody; radiographic changes.",
              "pdf_page": 1042,
              "printed_page": 960,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mycotic rhinitis—moderate-to-severe nasal Glaus TM, Gerber B, Tomsa K, Keiser M. discharge, often hemorrhagic; radiographic changes.",
              "pdf_page": 1042,
              "printed_page": 960,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Laryngeal disease—no improvement with open-mouth breathing; lack of snoring or Unterer S, Kirberger RM, Steenkamp G, et al. nasal discharge; abnormalities on laryngeal examination.",
              "pdf_page": 1042,
              "printed_page": 960,
              "column": 2
            }
          ]
        },
