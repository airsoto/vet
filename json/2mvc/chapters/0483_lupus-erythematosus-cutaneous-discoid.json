              "column": 1,
              "subheading": "GDLE"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "mucocutaneous junctions.",
              "pdf_page": 926,
              "printed_page": 844,
              "column": 1,
              "subheading": "GDLE"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Initial lesion—",
              "pdf_page": 926,
