              "printed_page": 844,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "GDLE—German shepherd dog and",
              "pdf_page": 926,
              "printed_page": 844,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chinese crested (predominantly).",
              "pdf_page": 926,
              "printed_page": 844,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "FDLE— no age predilection; GDLE—older dogs.",
              "pdf_page": 926,
              "printed_page": 844,
              "column": 1
            }
          ]
        },
