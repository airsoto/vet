      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Considered to be a relatively benign variant of systemic lupus erythematosus (SLE).",
              "pdf_page": 926,
              "printed_page": 844,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Divided into facial discoid lupus erythematosus (FDLE) and generalized DLE (GDLE).",
              "pdf_page": 926,
              "printed_page": 844,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "FDLE is one of the most common immune-",
              "pdf_page": 926,
              "printed_page": 844,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "mediated skin diseases in dogs.",
              "pdf_page": 926,
              "printed_page": 844,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "FDLE predominantly involves the nasal planum,",
              "pdf_page": 926,
              "printed_page": 844,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "face, and ears.",
              "pdf_page": 926,
              "printed_page": 844,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "GDLE—lesions progress beyond the head.",
              "pdf_page": 926,
              "printed_page": 844,
              "column": 1
            }
          ]
        },
