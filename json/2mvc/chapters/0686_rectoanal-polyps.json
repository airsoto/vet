          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Most rectoanal polyps are benign growths located in the distal rectum. Histopathologic evaluation typically reveals adenomas, but lesions may undergo malignant transformation.",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            }
          ]
        },
