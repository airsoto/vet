    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Carcinomain situand adenocarcinoma.",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other neoplasms—leiomyoma,",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "lymphoma, papilloma.",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inflammatory polyps—primarily reported in miniature dachshunds in Japan; lesions appear as diffuse small white polyps that are responsive",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "to immunosuppressive therapy.",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Proctitis.",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pythiosis.",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Colitis (clinical signs are characterized by diarrhea with a marked increase in frequency, scant volume of feces, increased fecal mucus, and tenesmus. These clinical signs are vastly different to those of dogs with rectoanal polyps which do not",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "cause diarrhea).",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Incomplete rectal prolapse.",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            }
          ]
        },
