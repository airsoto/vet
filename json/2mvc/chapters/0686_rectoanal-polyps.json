        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Rectal palpation.",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Direct visualization",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "through anus.",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Proctoscopy—viable low-cost procedure that allows one to visualize the descending colon after cleansing the animal’s colon. This method is suitable in most dogs and cats because the polyps are usually localized",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "to the rectoanal or colorectal region and tend",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Twice yearly examination thereafter to",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "not to metastasize.",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Colonoscopy—may be assess for recurrence. recommended to evaluate the entire rectum",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 2
            }
          ]
        },
