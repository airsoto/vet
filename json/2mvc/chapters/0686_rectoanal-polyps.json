        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog and rarely cat.",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Middle-aged to older.",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No breed or sex predilection established but German shepherd dogs, collies, and West Highland white terriers overrepresented in some studies.",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "May be none (incidental finding on",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "wellness exam).",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hematochezia with",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "relatively well-formed feces.",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mucus-covered",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "feces.",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pencil-thin or ribbon-like feces.",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tenesmus.",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dyschezia.",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Soft, wellvascularized, friable, and often ulcerated mass(es) may be seen or palpated rectally.",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually single but multiple polyps can",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "occur.",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May be pedunculated or broadbased sessile masses.",
              "pdf_page": 1264,
              "printed_page": 1182,
              "column": 1
            }
          ]
        },
