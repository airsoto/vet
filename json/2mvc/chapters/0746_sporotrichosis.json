            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs (cutaneous form)—numerous nodules that may drain or crust; most lesions located on the head, dorsal muzzle; occasionally on the chest, or disseminated on the body and on the limbs.",
              "pdf_page": 1364,
              "printed_page": 1282,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats (cutaneous form)—lesions appear initially as wounds or abscesses mimicking wounds associated with fighting.",
              "pdf_page": 1364,
              "printed_page": 1282,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cutaneolymphatic form—usually an extension of the cutaneous form through the lymphatics, resulting in the formation of new nodules and draining tracts or crusts; lympha denopathy is common.",
              "pdf_page": 1364,
              "printed_page": 1282,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Disseminated form—systemic signs including lameness, respiratory symptoms (nasal discharge, sneezing, stertorous breathing), anorexia and weight loss also reported in dogs.",
              "pdf_page": 1364,
              "printed_page": 1282,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—hunting dogs from puncture wounds associated with thorns or splinters.",
              "pdf_page": 1364,
              "printed_page": 1282,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—intact male outdoor cats: Healthy cats may have a minor role in sporotrichosis transmission",
              "pdf_page": 1364,
              "printed_page": 1282,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Animals exposed to soil rich in decaying organic debris.",
              "pdf_page": 1364,
              "printed_page": 1282,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exposure to infected animals or clinically healthy cats sharing a household with an affected cat.",
              "pdf_page": 1364,
              "printed_page": 1282,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Immunosuppressive disease.",
              "pdf_page": 1364,
              "printed_page": 1282,
              "column": 1
            }
          ]
        }
      }
    },
