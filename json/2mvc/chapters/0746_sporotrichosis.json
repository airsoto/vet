              "printed_page": 1282,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "dimorphic fungusSporothrix schenckiiinto",
              "pdf_page": 1364,
              "printed_page": 1282,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "subcutaneous tissue.",
              "pdf_page": 1364,
              "printed_page": 1282,
              "column": 1,
              "subheading": "dimorphic fungusSporothrix schenckiiinto"
