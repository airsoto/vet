    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Choices include agents for gastric mucosal protection against refluxed bile or use of gastric prokinetic agents to improve motility.",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Often single evening dose of medication may be all that is required to prevent clinical",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "signs if signs occur at night.",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Drugs for gastric mucosal protection include various antacids or sucralfate (1 g/25 kg q8h).",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Drugs that block gastric acid production, including famotidine (0.5–1.0 mg/kg q12h–24h), ranitidine (1–2 mg/kg q8–12h), and omeprazole (0.7–1.5 mg/kg q12–24h) may be beneficial; ranitidine has mild gastric prokinetic effects in vitro and may be beneficial, but is less effective acid reducer.",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Specific gastric prokinetic agents include",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "metoclopramide (0.2–0.4 mg/kg PO q6–8h) and cisapride (0.5 mg/kg PO q8–12h); cisapride only available through compound-",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "ing pharmacies.",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Erythromycin (0.5–1 mg/kg q8h) stimulates gastric motility by activation of motilin receptors and may also resolve signs.",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 3
            }
          ]
        },
