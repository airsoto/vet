        },
        "CONTRAINDICATIONS/POSSIBLE INTERACTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Gastric prokinetic agents should not be administered in patients with GI obstruction.",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metoclopramide can cause nervousness,",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "anxiety, or depression.",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cisapride at higher doses can cause vomiting, diarrhea, or",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "abdominal cramping.",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Erythromycin can cause vomiting.",
