        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Commonly observed in dogs, rarely in cats.",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most animals are young or middle‐aged.",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No breed or sex predisposition.",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic intermittent vomiting of bile associated with empty stomach. Signs generally occur late at night or early in morning. Signs may occur daily, but usually intermittent. Between episodes, animal appears normal and most dogs appear healthy",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "immediately after vomiting episodes.",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Results of physical examination usually unremarkable.",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cause unknown (idiopathic).",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary gastric hypomotility or abnormal intestinal peristaltic motility are suspected as probable",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "underlying causes.",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Conditions causing gastritis, duodenitis, or intestinal obstructive disease may be responsible for altered proximal GI motility and can cause bile reflux; investi-",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "gate for parasitism (e.g.,Giardia), inflamma-",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "tory bowel disease (IBD), intestinal neoplasia,",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 1,
              "subheading": "gate for parasitism (e.g.,Giardia), inflamma-"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "or obstructions as possible etiologies.",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 1,
              "subheading": "gate for parasitism (e.g.,Giardia), inflamma-"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Previous pyloric opening or resection surgery",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 1,
              "subheading": "gate for parasitism (e.g.,Giardia), inflamma-"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "can increase risk of enterogastric reflux.",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 1,
              "subheading": "gate for parasitism (e.g.,Giardia), inflamma-"
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Any number of GI and non‐GI disorders",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "can cause chronic vomiting.Giardiashould",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "be excluded since signs of this disease may",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 1,
              "subheading": "can cause chronic vomiting.Giardiashould"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "mimic those of BVS.",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 1,
              "subheading": "can cause chronic vomiting.Giardiashould"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "IBD can result in bile",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 1,
              "subheading": "can cause chronic vomiting.Giardiashould"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "reflux.",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 1,
              "subheading": "can cause chronic vomiting.Giardiashould"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intestinal obstruction or partial",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 1,
              "subheading": "can cause chronic vomiting.Giardiashould"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "obstructions should be ruled out.",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 1,
              "subheading": "can cause chronic vomiting.Giardiashould"
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
