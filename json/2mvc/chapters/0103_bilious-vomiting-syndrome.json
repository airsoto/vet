        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Fecal examination to detectGiardiaor",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "other parasites.",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Baseline cortisol to rule out",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "hypoadrenocorticism.",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "GI panel—pancreatic lipase immunoreactivity (PLI), trypsin‐like‐ immunoreactivity (TLI), cobalamin, folate.",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Barium contrast study may reveal delayed gastric emptying, although finding must be",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "interpreted with caution.",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Barium given with meals, radiopaque markers, or using special motility capsule (Smartpill®) may also demonstrate delayed gastric motility.",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Endoscopic findings frequently unremarkable",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "and help rule out underlying GI disease.",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May be evidence of bile in stomach or gastritis in",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "antral region of stomach.",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Endoscopy useful to rule out structural or inflammatory disease, since BVS is diagnosis of exclusion.",
              "pdf_page": 261,
              "printed_page": 179,
              "column": 2
            }
          ]
        },
