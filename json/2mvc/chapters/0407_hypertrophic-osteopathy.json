        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "More common in dogs than cats.",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Age of highest frequency >8 years; coincides with the peak incidence of neoplasia.",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic or acute lameness with pain in one",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "or more limbs.",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reluctance to move or use affected limb(s).",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Large firm swelling of affected limb(s).",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory clinical signs if intra-thoracic",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "disease present (rare).",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Long bone or distal extremities—enlarged,",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "firm, taut, thickened; not edematous.",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Single or multiple limbs.",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Firm swelling may extend proximally with",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "progression of disease.",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lameness and pain noted in affected",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "limb(s).",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
