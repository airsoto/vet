  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Disease of the distal extremities resulting from peripheral blood flow changes that stimulate an overgrowth of vascular connective tissue and subsequent periosteal proliferation.",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pathogenesis—speculative; increased blood circulation in the limb due to neural or humoral mechanisms is likely secondary to an underlying disease process: most notably intra-thoracic or intra-abdominal neoplasia.",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Predominantly affects the diaphyseal region of phalanges, metacarpals, and metatarsals.",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1
            }
          ]
        },
