        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary and metastatic neoplasia—lung tumors; esophageal sarcoma; rhabdomyo sarcoma; adenocarcinoma of the adrenal gland, liver, or prostate; nephroblastoma; renal cell carcinoma; thoracic and abdominal mesotheliomas.",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Non-neoplastic conditions—pneumonia, lung abscess/granulomas, dirofilariasis; congenital or acquired heart disease, bronchial",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "foreign bodies;Spirocerca lupiinfestation of",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "the esophagus; focal lung atelectasis; obscure",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1,
              "subheading": "foreign bodies;Spirocerca lupiinfestation of"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "toxins; hypertension; hyperestrogenism;",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1,
              "subheading": "foreign bodies;Spirocerca lupiinfestation of"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "congenital idiopathic megaesophagus.",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1,
              "subheading": "foreign bodies;Spirocerca lupiinfestation of"
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Osteomyelitis—asymmetric; edematous; lytic bone lesions; history of penetrating trauma or systemic infection.",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metastatic neoplasia—asymmetric.",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypervitaminosis A (feline)—asymmetric; generally involves joint surface.",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypertrophic osteodystrophy—metaphyseal abnormality, young dogs.",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Multiple cartilaginous exostosis—metaphy-",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Degenerative joint disease—involves articular surface changes in multiple joints.",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Dependent on underlying cause and concurrent conditions.",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Fecal examination—rule out gastrointestinal and respiratory parasitism.",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Radiographs of affected long bones— bilaterally symmetric extensive, aggressive, or nonaggressive periosteal new bone formation on diaphysis; palisading periosteal reaction; joints not affected.",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic and abdominal imaging (radiographs, ultrasound, and/or CT)— identify and differentiate primary lesions.",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Bone biopsy and culture (bacterial and fungal)—in atypical cases to rule out neoplasia and osteomyelitis.",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
