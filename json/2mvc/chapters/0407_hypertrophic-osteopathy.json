    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Directed at managing, treating, or removing the underlying cause.",
          "pdf_page": 795,
          "printed_page": 713,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Options in selected cases—unilateral vagotomy on the side of a lung lesion or bilateral cervical vagotomy; incising through parietal pleura; subperiosteal rib resection.",
          "pdf_page": 795,
          "printed_page": 713,
          "column": 2
        }
      ],
