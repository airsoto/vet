        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical signs and bone changes may resolve with treatment of underlying disease.",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bone changes may take several months to regress.",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prognosis—guarded to poor due to the common occurrence of neoplastic causes; non-neoplastic lesions may resolve with appropriate treatment of primary cause.",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tumor recurrence or metastasis may result in recurrence of osteopathy.",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No relationship between size, site, or histologic type of primary lesion, the development of or recurrence of hypertrophic osteopathy postoperatively.",
              "pdf_page": 795,
              "printed_page": 713,
              "column": 3
            }
          ]
        }
      }
