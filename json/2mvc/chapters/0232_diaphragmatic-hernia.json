          "canonical_heading": "SURGICAL CONSIDERATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Anesthesia and surgery should be delayed until animal is hemodynamically stable.",
              "pdf_page": 483,
              "printed_page": 401,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Emergency surgery indicated with evidence of gastrothorax, gastrointestinal entrapment, or",
              "pdf_page": 483,
              "printed_page": 401,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "persistent respiratory distress.",
              "pdf_page": 483,
              "printed_page": 401,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Long lasting absorbable monofilament suture (e.g., Maxon® or PDS®) should be used to close the diaphragm in a full-thickness simple continuous pattern.",
              "pdf_page": 483,
              "printed_page": 401,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Care should be taken around caval foramen, esophageal hiatus, and aortic hiatus.",
              "pdf_page": 483,
              "printed_page": 401,
              "column": 2
            }
          ]
        },
