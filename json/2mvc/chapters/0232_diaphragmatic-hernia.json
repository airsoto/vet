        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory distress—due to concurrent",
              "pdf_page": 483,
              "printed_page": 401,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "injury or pneumothorax.",
              "pdf_page": 483,
              "printed_page": 401,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reexpansion pulmonary edema (RPE) is uncommon but often fatal complication; to minimize risk of RPE, avoid aggressive positive-pressure ventilation following reduction of herniated organs, and avoid aggressive evacuation of pleural space in postoperative period.",
              "pdf_page": 483,
              "printed_page": 401,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Recurrence uncommon, but most often associated with inadequate surgical repair.",
              "pdf_page": 483,
              "printed_page": 401,
              "column": 3
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "If animal survives for first 12–24 hours after surgery, prognosis is excellent. Reported survival rates range from 80 to 90%. Death most often due to concurrent injury.",
              "pdf_page": 483,
              "printed_page": 401,
              "column": 3
            }
          ]
        }
