        "SURGICAL CONSIDERATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "SURGICAL CONSIDERATIONS",
          "canonical_heading": "SURGICAL CONSIDERATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Early, aggressive, en bloc surgical excision is",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "treatment of choice.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Microscopically, cancer cells extend beyond gross tumor borders.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pseudocapsule composed of compressed",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "cancer cells is common.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Excise tumor en bloc; if peeled out, healthy bed of cancer cells (pseudocapsule) is left as residual disease.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Submit entire sample to pathologist for surgical margin evaluation; applying ink to",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "surgical borders is advised.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Limb amputation may be necessary with tumors affecting appendicular extremities that may",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "be otherwise unresectable.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rib resection or abdominal wall resection may be required for tumors of trunk.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Radiation Therapy Considerations",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Adjuvant radiation therapy should be",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2,
              "subheading": "Radiation Therapy Considerations"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "considered following either planned",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2,
              "subheading": "Radiation Therapy Considerations"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "marginal resection or unplanned incomplete",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2,
              "subheading": "Radiation Therapy Considerations"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "resection.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2,
              "subheading": "Radiation Therapy Considerations"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Radiation therapy most effective",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2,
              "subheading": "Radiation Therapy Considerations"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "when directed at microscopic disease—",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2,
              "subheading": "Radiation Therapy Considerations"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "either preoperatively or as postoperative",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2,
              "subheading": "Radiation Therapy Considerations"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "full-course fractionated protocol.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2,
              "subheading": "Radiation Therapy Considerations"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "As single",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2,
              "subheading": "Radiation Therapy Considerations"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "modality treatment for macroscopic disease,",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2,
              "subheading": "Radiation Therapy Considerations"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "radiation therapy considered palliative—",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2,
              "subheading": "Radiation Therapy Considerations"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "may be used to decrease pain and slow",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2,
              "subheading": "Radiation Therapy Considerations"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "tumor growth.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2,
              "subheading": "Radiation Therapy Considerations"
            }
          ]
        },
