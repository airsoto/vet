    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other sarcomas such as fibrosarcoma, peripheral nerve sheath tumor, myxosarcoma, malignant fibrous histiocytoma, histiocytic",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "sarcoma, hemangiosarcoma.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lipoma and other subcutaneous tumors—benign and malignant.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
