        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Common in dogs, rare in cats.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "More common in large-breed than small-breed",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "dogs.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Middle-aged to older dogs and cats.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Typically, slow-growing, nonpainful,",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "fluctuant to firm mass (weeks to months).",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rapid growth uncommon unless high-grade",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "or associated with hemorrhage.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Local tumor",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "growth can interfere with limb function.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Subcutaneous soft tissue mass, more",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "frequently located on extremity than on",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "trunk.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Soft, fluctuant, or firm.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nonpainful unless ulcerated or invading",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "into deeper structures (muscle, nerve, bone).",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Generally adhered to underlying tissue.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Regional lymph node metastasis",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "uncommon.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
