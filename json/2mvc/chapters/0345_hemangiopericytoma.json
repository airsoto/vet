    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "If complete surgical resection achievable and tumor categorized as low-grade, tumor regrowth or metastases unlikely and continued patient monitoring may not be",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "necessity.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If surgical resection incomplete or tumor categorized as high-grade, further treatment should be considered and patient should be monitored for local regrowth and distant metastases, with repeat physical exam and thoracic radiographs every 3 months.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 3
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": []
        },
        "POSSIBLE COMPLICATIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": []
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Local recurrence, metastasis, and overall survival time greatly affected by surgical margin",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "assessment and histological grade.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cure from disease possible when surgery aggressive and surgical margins tumor-free, especially with grade I and II tumors—median survival approaches 2 years with low-grade (I) STSs of",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "extremities treated with surgery alone.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Local recurrence considered inevitable if treatment not aggressive; increased risk for metastatic disease",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "especially with high-grade (III) tumors.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Longterm tumor control with radiation therapy after surgically debulking tumor gives 1–5-year",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "control rates of 60–85%.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Incomplete surgical excision should be managed with either second aggressive surgery or radiation therapy as soon as possible; low-dosage chemotherapy (metronomic) is another option.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 3
            }
          ]
        }
      }
    },
