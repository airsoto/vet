        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiographs recommended before treatment, although metastasis uncommonly",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "identified.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Contrast-enhanced CT or MRI may be recommended to determine local extent of disease and optimize surgical treatment and radiation therapy planning.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Fine-needle aspiration and cytology may provide tentative diagnosis, though cells do not exfoliate well given mesenchymal origin.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Incisional biopsy and histopathology may be used to confirm diagnosis, determine grade of tumor, and plan treatment",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "approach.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Immunohistochemistry evaluation of biopsy can aid in differentiation from other mesenchymal",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "tumors.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Regional lymph node evaluation (cytology or histopathology) appropriate for high-grade tumors or if regional lymphadenomegaly detected.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
