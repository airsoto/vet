      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "A soft tissue sarcoma (STS) arising around",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "blood vessels in subcutaneous tissue.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Also",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "known as perivascular wall tumor.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Locally invasive—microscopic disease often extending beyond gross visible tumor margins.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metastasizes in less than 15% of patients with grade I/II (low/intermediate-grade) STS and less than 44% of patients with grade III (high-grade) STS.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 1
            }
          ]
        },
