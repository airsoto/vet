    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Doxorubicin-based chemotherapy not consistently reported as beneficial, but remains recommended after excision of",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "high-grade (grade III) tumor.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Low-dose chemotherapy (metronomic) with piroxicam and cyclophosphamide may help delay local recurrence when sarcoma incompletely",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "resected.",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Novel therapeutic options may be available—contact veterinary oncologist for",
              "pdf_page": 675,
              "printed_page": 593,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "potential updated treatments.",
              "pdf_page": 675,
