        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs and cats—all ages.",
              "pdf_page": 433,
              "printed_page": 351,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In northern United States, most cases occur in late summer and early autumn, based on time of emergence of adult egg-laying females in spring and early summer.",
              "pdf_page": 433,
              "printed_page": 351,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dermatologic—warble containing bot with protruding spiracles.",
              "pdf_page": 433,
              "printed_page": 351,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neurologic—ataxia, circling, paralysis, blindness, recumbency.",
              "pdf_page": 433,
              "printed_page": 351,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ophthalmic lesions—larva in conjunctiva.",
              "pdf_page": 433,
              "printed_page": 351,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory—eosinophilic respiratory disease.",
              "pdf_page": 433,
              "printed_page": 351,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs and cats with access to outdoors, where they contact eggs and larvae.",
              "pdf_page": 433,
              "printed_page": 351,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neonatal cats have been infected, presumably with larvae carried on queen’s fur.",
              "pdf_page": 433,
              "printed_page": 351,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory—allergies, lungworms, migrating ascarids or hookworms.",
              "pdf_page": 433,
              "printed_page": 351,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neurologic—rabies, distemper, angiostrongylosis.",
              "pdf_page": 433,
              "printed_page": 351,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ophthalmic lesions—larvalHypodermaor Oestrus.",
              "pdf_page": 433,
              "printed_page": 351,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dermatologic—mature warble unmistakable, young warble may present as pustule or papule.",
              "pdf_page": 433,
              "printed_page": 351,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
