    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Can remove maggots from subcutaneous lesions, eyes, or nares (see Web Video 1).",
          "pdf_page": 433,
          "printed_page": 351,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Manifestations of lung migration may be alleviated by corticosteroids.",
          "pdf_page": 433,
          "printed_page": 351,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Neurologic disease has poor prognosis.",
          "pdf_page": 433,
          "printed_page": 351,
          "column": 2
        }
