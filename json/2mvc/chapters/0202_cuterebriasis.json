    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ivermectin 0.2 mg/kg SC should kill migrating maggots; can be administered either to alleviate signs caused by maggots suspected of migrating in lungs, or to kill larvae in other tissues, including CNS; pretreatment with corticosteroids may mitigate inflammatory reaction to dying worms.",
              "pdf_page": 433,
              "printed_page": 351,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Products containing isoxazolines (i.e., afoxolaner, fluralaner, lotilaner, andsarolaner), when routinely given to cats and and dogs, may prevent migration and warble formation",
              "pdf_page": 433,
              "printed_page": 351,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "byCuterebraspp. Efficacy and potential side",
              "pdf_page": 433,
              "printed_page": 351,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "effects in patients with migrating maggots has",
              "pdf_page": 433,
              "printed_page": 351,
              "column": 2,
              "subheading": "byCuterebraspp. Efficacy and potential side"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "not been reported.",
              "pdf_page": 433,
              "printed_page": 351,
              "column": 2,
              "subheading": "byCuterebraspp. Efficacy and potential side"
            }
          ]
        },
