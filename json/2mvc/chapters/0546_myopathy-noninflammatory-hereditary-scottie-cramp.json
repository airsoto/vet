    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "paragraph",
          "level": 0,
          "text": "Behavioral modification and/or environmental changes—eliminate triggering situations (excitement, stress); may be adequate in controlling episodes.",
          "pdf_page": 1027,
          "printed_page": 945,
          "column": 2
        }
      ],
