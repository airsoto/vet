        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Mild to moderate—fair to good long-term prognosis; usually manageable disability by owners; nonprogressive.",
              "pdf_page": 1027,
              "printed_page": 945,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Severe—guarded prognosis.",
