        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Young Scottish terriers, typically <1 year of age. Clinical signs may be seen in puppies as early as 6–8 weeks of age.",
              "pdf_page": 1027,
              "printed_page": 945,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No known sex predilection. Females may be overrepresented.",
              "pdf_page": 1027,
              "printed_page": 945,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Normal at rest and on initial exercise.",
              "pdf_page": 1027,
              "printed_page": 945,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Further exercise or excitement—abduction of the thoracic limbs; arching (kyphosis) of the thoracolumbar vertebral column; stiffening or overflexion of the pelvic limbs (goose-stepping gait).",
              "pdf_page": 1027,
              "printed_page": 945,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Patient may fall, with tail and pelvic limbs flexed tightly against the body.",
              "pdf_page": 1027,
              "printed_page": 945,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiration—may cease for a short time.",
              "pdf_page": 1027,
              "printed_page": 945,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Facial muscles—may be contracted.",
              "pdf_page": 1027,
              "printed_page": 945,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No loss of consciousness.",
              "pdf_page": 1027,
              "printed_page": 945,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Severity varies. Generalized spasticity may be seen during episodes or only hind limb spasticity and skipping.",
              "pdf_page": 1027,
              "printed_page": 945,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Episodes—may last up to 30 minutes.",
              "pdf_page": 1027,
              "printed_page": 945,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Inherited condition with probable autosomal recessive mode of transmission. Presence of dogs with cerebellar degeneration in the same pedigrees may suggest a more complex mode of inheritance than previously reported.",
              "pdf_page": 1027,
              "printed_page": 945,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Seizure disorder—distinguished on basis of family history, typical clinical signs with no loss of consciousness, and induction of signs with serotonin antagonists.",
              "pdf_page": 1027,
              "printed_page": 945,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cerebellar cortical degeneration described in Scottish terriers—clinical signs are not episodic and neurologic abnormalities are slowly progressive.",
              "pdf_page": 1027,
              "printed_page": 945,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
