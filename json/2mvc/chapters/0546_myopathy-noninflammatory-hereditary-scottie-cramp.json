        "CONTRAINDICATIONS/POSSIBLE INTERACTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Serotonin antagonists—increase severity of clinical signs.",
              "pdf_page": 1027,
              "printed_page": 945,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Aspirin, indomethacin, phenylbutazone, flunixin meglumine (Banamine), and penicillin—may exacerbate clinical signs.",
              "pdf_page": 1027,
              "printed_page": 945,
              "column": 2
            }
          ]
        },
