              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Diagnosis usually made on clinical presentation. Clinical signs may be induced by giving the serotonin antagonist methysergide (0.3 mg/kg PO). Cramping is evident in 2 hours and may last for 8 hours.",
              "pdf_page": 1027,
              "printed_page": 945,
              "column": 2
            }
          ]
        },
