        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "DNA test available for episodic falling syndrome in cavalier King Charles spaniels. Genetic abnormality associated with other hypertonicity disorders not yet determined.",
              "pdf_page": 1027,
              "printed_page": 945,
              "column": 2
            }
          ]
        },
