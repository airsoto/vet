        "APPROPRIATE HEALTH CARE": {
          "present": true,
          "status": "content",
          "source_heading": "APPROPRIATE HEALTH CARE",
          "canonical_heading": "APPROPRIATE HEALTH CARE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Asystole is a frequently fatal rhythm requiring immediate aggressive treatment.",
              "pdf_page": 1495,
              "printed_page": 1413,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Artificial pacing with a transvenous or transthoracic pacemaker may succeed if myocardium is mechanically responsive.",
              "pdf_page": 1495,
              "printed_page": 1413,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "DC electrical conversion is not effective unless the rhythm can first be converted to ventricular fibrillation with",
              "pdf_page": 1495,
              "printed_page": 1413,
              "column": 3
            }
          ]
        },
        "NURSING CARE": {
          "present": true,
          "status": "content",
