    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Institute cardiopulmonary resuscitation.",
              "pdf_page": 1495,
              "printed_page": 1413,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Epinephrine 0.2 mg/kg IV, intratracheal (IT), or intralingual (IL) (double the dose for IT administration and deliver with equal volume of saline).",
              "pdf_page": 1495,
              "printed_page": 1413,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Atropine 0.05 mg/kg IV, IT, or IL (double the dose for IT administration and deliver with equal volume of saline).",
              "pdf_page": 1495,
              "printed_page": 1413,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sodium bicarbonate 1 mEq/kg IV for each 10 minutes of cardiac arrest.",
              "pdf_page": 1495,
              "printed_page": 1413,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dexamethasone and dopamine may be helpful in patients with electrical–mechanical dissociation.",
              "pdf_page": 1495,
              "printed_page": 1413,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Ventricular asystole in a cat with severe hyperkalemia (11 mEq/L) from urethral obstruction. No P waves or QRS complexes are seen after four wide and bizarre QRS complexes (atrial standstill with delayed ventricular conduction). Lead II, 50 mm/s, 1 cm = 1 mV.) (Source: From Tilley LP. Essentials of Canine and Feline Electrocardiography, 3rd ed. Baltimore: Williams & Wilkins, 1992. Reprinted with permission of Wolters Kluwer.)",
              "pdf_page": 1496,
              "printed_page": 1414,
              "column": 1
            }
