          "canonical_heading": "NURSING CARE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Treat any treatable problems such as hypothermia, hyperkalemia, and acid–base disorders.",
              "pdf_page": 1495,
              "printed_page": 1413,
              "column": 3
            }
          ]
        },
