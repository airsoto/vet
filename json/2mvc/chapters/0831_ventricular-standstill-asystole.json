        "DEFINITION": {
          "present": true,
          "status": "content",
          "source_heading": "DEFINITION",
          "canonical_heading": "DEFINITION",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Absence of ventricular complexes on the ECG or absence of ventricular activity (electrical– mechanical dissociation).",
              "pdf_page": 1495,
              "printed_page": 1413,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "ECG Features",
              "pdf_page": 1495,
              "printed_page": 1413,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Ventricular asystole can result from severe",
              "pdf_page": 1495,
              "printed_page": 1413,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "sinoatrial block or arrest or by third-degree",
              "pdf_page": 1495,
              "printed_page": 1413,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "atrioventricular (AV) block without a",
              "pdf_page": 1495,
              "printed_page": 1413,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "junctional or ventricular escape rhythm; ECG",
              "pdf_page": 1495,
              "printed_page": 1413,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "features include:",
              "pdf_page": 1495,
              "printed_page": 1413,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "P waves present if patient has complete AV",
              "pdf_page": 1495,
              "printed_page": 1413,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "block (Figure 1).",
              "pdf_page": 1495,
              "printed_page": 1413,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "P waves absent during asystole if patient has",
              "pdf_page": 1495,
              "printed_page": 1413,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "severe sinoatrial block or arrest.",
              "pdf_page": 1495,
              "printed_page": 1413,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No QRS complexes.",
              "pdf_page": 1495,
              "printed_page": 1413,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Electrical–mechanical dissociation—a",
              "pdf_page": 1495,
              "printed_page": 1413,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "recorded ECG cardiac rhythm (P-QRS-T)",
              "pdf_page": 1495,
              "printed_page": 1413,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and no effective cardiac output or palpable",
              "pdf_page": 1495,
              "printed_page": 1413,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "femoral pulse.",
              "pdf_page": 1495,
              "printed_page": 1413,
              "column": 1,
              "subheading": "ECG Features"
            }
          ]
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Ventricular asystole represents cardiac arrest; if the ventricular rhythm is not restored in 3–4 minutes, irreversible brain injury can occur.",
              "pdf_page": 1495,
              "printed_page": 1413,
              "column": 1
            }
          ]
        },
