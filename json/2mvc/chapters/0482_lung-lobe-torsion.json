              "printed_page": 843,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "predisposing factors.",
              "pdf_page": 925,
              "printed_page": 843,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic or diaphrag",
              "pdf_page": 925,
              "printed_page": 843,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "matic surgery.",
              "pdf_page": 925,
              "printed_page": 843,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Spontaneous or idiopathic.",
              "pdf_page": 925,
              "printed_page": 843,
              "column": 1
            }
          ]
        }
