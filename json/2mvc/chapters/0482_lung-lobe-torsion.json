    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Observe for recurrence of pleural effusion.",
          "pdf_page": 925,
          "printed_page": 843,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Reexpansion pulmonary edema—can be a serious problem (especially in cats) if large volumes of pleural fluid are withdrawn quickly or if chronically compressed lungs are",
          "pdf_page": 925,
          "printed_page": 843,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "acutely inflated at surgery.",
          "pdf_page": 925,
          "printed_page": 843,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Thoracic radiographs—before discharge; as needed",
          "pdf_page": 925,
          "printed_page": 843,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "thereafter.",
          "pdf_page": 925,
          "printed_page": 843,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Prognosis—fair to good if no underlying abnormality remains.",
          "pdf_page": 925,
          "printed_page": 843,
          "column": 3
        }
      ],
