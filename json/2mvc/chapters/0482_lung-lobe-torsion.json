              "printed_page": 843,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "chylothorax, but this is rarely seen.",
              "pdf_page": 925,
              "printed_page": 843,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Any",
              "pdf_page": 925,
              "printed_page": 843,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "age.",
              "pdf_page": 925,
              "printed_page": 843,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "More common in males.",
              "pdf_page": 925,
              "printed_page": 843,
              "column": 1
            }
          ]
        },
