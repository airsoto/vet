        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Viral—FeLV, feline immunodeficiency virus (FIV), parvovirus.",
              "pdf_page": 1010,
              "printed_page": 928,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neoplasia—lymphoma, multiple myeloma.",
              "pdf_page": 1010,
              "printed_page": 928,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Autoimmune—immune-mediated hemolytic anemia, immune-mediated thrombocytopenia.",
              "pdf_page": 1010,
              "printed_page": 928,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Drugs—chemotherapeutics, estrogen, chloramphenicol, cephalosporins, phenylbutazone, trimethoprim-sulfadiazine, quinidine, thiacetarsamide, griseofulvin, albendazole.",
              "pdf_page": 1010,
              "printed_page": 928,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Iron deficiency, folic acid deficiency.",
              "pdf_page": 1010,
              "printed_page": 928,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lead toxicity.",
              "pdf_page": 1010,
              "printed_page": 928,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infectious—ehrlichiosis, bacterial septicemia, and endotoxemia.",
              "pdf_page": 1010,
              "printed_page": 928,
              "column": 1
            }
          ]
        }
      }
