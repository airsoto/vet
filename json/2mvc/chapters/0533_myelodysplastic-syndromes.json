  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Category of diseases characterized by nonregenerative anemias or cytopenias and dysplastic features in the blood or bone marrow.",
              "pdf_page": 1010,
              "printed_page": 928,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary myelodysplastic syndromes (MDS) result from a clonal expansion of a genetically altered pluripotent stem cell resulting in a hypercellular bone marrow with maturation arrest as a consequence of apoptosis.",
              "pdf_page": 1010,
              "printed_page": 928,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Subcategorized as MDS with excessive blasts, which may progress to acute myeloid leukemia, MDS with refractory cytopenia, and MDS with erythroid predominance.",
              "pdf_page": 1010,
              "printed_page": 928,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary MDS in dogs is associated with neoplasia (lymphoma, multiple myeloma), drug or toxin exposure, immune-mediated disease, infections, or ionizing radiation exposure.",
              "pdf_page": 1010,
              "printed_page": 928,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary MDS in cats is typically associated with feline leukemia virus (FeLV) infection.",
              "pdf_page": 1010,
              "printed_page": 928,
              "column": 1
            }
          ]
        },
