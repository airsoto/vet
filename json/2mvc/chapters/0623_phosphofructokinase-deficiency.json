        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "English springer spaniel, American cocker spaniel, mixed-breed, whippet, and wachtelhund dogs are overrepresented.",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Transmitted as an autosomal recessive trait.",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affected homozygous animals generally not recognized as abnormal before age 1.",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Some animals exhibit mild clinical signs that go unrecognized for years; others regularly exhibit episodes of severe illness.",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Depression or weakness concomitant with episodes of pigmenturia.",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mild lethargy with slight fever during mild hemolytic episodes.",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Marked lethargy, weakness, pale or icteric mucous membranes, mild hepatosplenomegaly, and fever as high as 106°F (41°C) during severe hemolytic crises.",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intravascular hemolysis can be caused by hyperventilation-induced alkalemia associated with exercise or excitement.",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Signs of muscle dysfunction—usually limited to exercise intolerance and slightly diminished muscle mass, but muscle cramping and severe progressive myopathy can occur.",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Two affected whippets had progressive cardiac disease in addition to muscle cramping after exercise.",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Heterozygous carrier animals appear clinically normal.",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Deficiency of the muscle-type subunit of phosphofructokinase—markedly reduced total activity in RBCs and skeletal muscle.",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other causes of hemolytic anemia— immune-mediated hemolytic anemia,",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hemotropic mycoplasmosis, babesiosis, Heinz body anemia, microangiopathic hemolytic anemia, and pyruvate kinase deficiency.",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affected dogs—negative Coombs’ test, no",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infrequently, affected dogs may die during a parasites or Heinz bodies in stained blood hemolytic crisis because of anemia or renal",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "films, seronegative forBabesiaspp., and no",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "failure.",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 2,
              "subheading": "films, seronegative forBabesiaspp., and no"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "evidence of disseminated intravascular",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 2,
              "subheading": "films, seronegative forBabesiaspp., and no"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affected animals can have a normal lifespan",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 2,
              "subheading": "films, seronegative forBabesiaspp., and no"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "coagulation or heartworm disease.",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 2,
              "subheading": "films, seronegative forBabesiaspp., and no"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "if properly managed.",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 2,
              "subheading": "films, seronegative forBabesiaspp., and no"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Differentiated from pyruvate kinase",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 2,
              "subheading": "films, seronegative forBabesiaspp., and no"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Owners should avoid placing affected dogs",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 2,
              "subheading": "films, seronegative forBabesiaspp., and no"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "deficiency by specific enzyme assays or DNA",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 2,
              "subheading": "films, seronegative forBabesiaspp., and no"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "in stressful situations or subjecting them to",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 2,
              "subheading": "films, seronegative forBabesiaspp., and no"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "test.",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 2,
              "subheading": "films, seronegative forBabesiaspp., and no"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "strenuous exercise, excitement, or high",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 2,
              "subheading": "films, seronegative forBabesiaspp., and no"
            }
          ]
        },
