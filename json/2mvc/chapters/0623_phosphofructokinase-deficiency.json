  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Phosphofructokinase is the most important rate-controlling enzyme in glycolysis, and red blood cells (RBCs) and intensely exercising skeletal muscles depend heavily on anaerobic glycolysis for energy.",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affected dogs have compensated hemolytic anemia and mild myopathy caused by markedly reduced total phosphofructokinase activity in both tissues.",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anemia develops because of insufficient generation of ATP to maintain normal RBC shape, ionic composition, and deformability and because RBCs from affected dogs are alkaline fragile and lyse when blood pH is slightly high.",
              "pdf_page": 1160,
              "printed_page": 1078,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
