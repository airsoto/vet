          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—placenta retained beyond the immediate postpartum period; placentas usually passed within 15 minutes of birth of a puppy; may develop acute metritis secondary to retained placenta.",
              "pdf_page": 1274,
              "printed_page": 1192,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—may retain placentas for days without signs of illness.",
              "pdf_page": 1274,
              "printed_page": 1192,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Extremely uncommon.",
              "pdf_page": 1274,
              "printed_page": 1192,
              "column": 1
            }
          ]
        },
