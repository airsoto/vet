          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Postpartum metritis—physical examination and vaginal cytologic examination show no signs of infection with uncomplicated retained placenta; metritis may develop concurrently.",
              "pdf_page": 1274,
              "printed_page": 1192,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Retained fetus—differentiated by radiography or ultrasonography.",
              "pdf_page": 1274,
              "printed_page": 1192,
              "column": 1
            }
          ]
        },
