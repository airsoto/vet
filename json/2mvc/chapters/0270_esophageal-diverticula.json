            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Periesophageal mass—esophagram or esophagoscopy should differentiate the presence of a mass causing luminal narrowing.",
              "pdf_page": 546,
              "printed_page": 464,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Esophagitis.",
