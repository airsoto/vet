          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Rare; more common in dog than cat.",
              "pdf_page": 546,
              "printed_page": 464,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Congenital or acquired (no genetic basis proven).",
              "pdf_page": 546,
              "printed_page": 464,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No important breed or sex predisposition.",
              "pdf_page": 546,
              "printed_page": 464,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Postprandial regurgitation, dysphagia, anorexia, coughing.",
              "pdf_page": 546,
              "printed_page": 464,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Weight loss, respiratory distress.",
              "pdf_page": 546,
              "printed_page": 464,
              "column": 1
            }
          ]
        },
