          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Esophageal redundancy—barium contrast accumulation in the region of the thoracic inlet can occur normally in young dogs (especially brachycephalic breeds and Chinese Shar-Pei).",
