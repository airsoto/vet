  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Pouch-like sacculations of the esophageal wall that accumulate fluids and ingesta.",
              "pdf_page": 546,
              "printed_page": 464,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diverticula may be congenital or acquired and are rare.",
              "pdf_page": 546,
              "printed_page": 464,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pulsion diverticula occur secondary to increased intraluminal pressure. Seen with esophageal obstructive disorders such as foreign body or mass lesions.",
              "pdf_page": 546,
              "printed_page": 464,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Traction diverticula occur secondary to periesophageal inflammation where fibrosis contracts and pulls out the wall of the esophagus into a pouch.",
              "pdf_page": 546,
              "printed_page": 464,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Localized inflammation around (esophagitis) and lining the diverticulum may be present.",
              "pdf_page": 546,
              "printed_page": 464,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Potential complications include ingesta impaction, mechanical obstruction (large diverticulum), and/or esophageal hypomotility.",
              "pdf_page": 546,
              "printed_page": 464,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Organ systems affected include gastrointestinal (regurgitation), musculoskeletal (weight loss), and respiratory (aspiration pneumonia).",
              "pdf_page": 546,
              "printed_page": 464,
              "column": 1
            }
          ]
        },
