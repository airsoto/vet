        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Surgical excisional biopsies—more accurate than punch biopsy specimens in most cases.",
              "pdf_page": 1115,
              "printed_page": 1033,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Panniculitis—lobular or diffuse infiltrate (granulomatous, pyogranulomatous, suppurative, eosinophilic, necrotizing, or fibrosing) of panniculus; may identify if vasculitis",
              "pdf_page": 1115,
              "printed_page": 1033,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "present.",
              "pdf_page": 1115,
              "printed_page": 1033,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Steatitis—lumpy, granular fat, normal to yellowish-orange coloration of body fat.",
              "pdf_page": 1115,
              "printed_page": 1033,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "subheading",
          "level": 0,
          "text": "Sterile Nodular Panniculitis",
          "pdf_page": 1115,
          "printed_page": 1033,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Systemic treatment with corticosteroids;",
          "pdf_page": 1115,
          "printed_page": 1033,
          "column": 3,
          "subheading": "Sterile Nodular Panniculitis"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "prednisolone 2.2 mg/kg daily in dogs or",
          "pdf_page": 1115,
          "printed_page": 1033,
          "column": 3,
          "subheading": "Sterile Nodular Panniculitis"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "4.4 mg/kg daily in cats: taper based on response:",
          "pdf_page": 1115,
          "printed_page": 1033,
          "column": 3,
          "subheading": "Sterile Nodular Panniculitis"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "may require low dose to maintain remission.",
          "pdf_page": 1115,
          "printed_page": 1033,
          "column": 3,
          "subheading": "Sterile Nodular Panniculitis"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Azathioprine (dogs: 1 mg/kg PO daily",
          "pdf_page": 1115,
          "printed_page": 1033,
          "column": 3,
          "subheading": "Sterile Nodular Panniculitis"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "initially)—used with corticosteroids if",
          "pdf_page": 1115,
          "printed_page": 1033,
          "column": 3,
          "subheading": "Sterile Nodular Panniculitis"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "insufficient response.",
          "pdf_page": 1115,
          "printed_page": 1033,
          "column": 3,
          "subheading": "Sterile Nodular Panniculitis"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Oral vitamin E 200 IU",
          "pdf_page": 1115,
          "printed_page": 1033,
          "column": 3,
          "subheading": "Sterile Nodular Panniculitis"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "q12h <10 kg, 400 IU q12h>10 kg.",
          "pdf_page": 1115,
          "printed_page": 1033,
          "column": 3,
          "subheading": "Sterile Nodular Panniculitis"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Cyclosporine beneficial in some dogs (initially",
          "pdf_page": 1115,
          "printed_page": 1033,
          "column": 3,
          "subheading": "Sterile Nodular Panniculitis"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "5 mg/kg q24h for 4–8 weeks, then tapered).",
          "pdf_page": 1115,
          "printed_page": 1033,
          "column": 3,
          "subheading": "Sterile Nodular Panniculitis"
        },
        {
          "type": "subheading",
          "level": 0,
          "text": "Steatitis",
          "pdf_page": 1115,
          "printed_page": 1033,
          "column": 3
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "Oral vitamin E 200 IU q12h <10 kg, 400 IU",
          "pdf_page": 1115,
          "printed_page": 1033,
          "column": 3,
          "subheading": "Steatitis"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "q12h >10 kg; corticosteroids at an anti-",
          "pdf_page": 1115,
          "printed_page": 1033,
          "column": 3,
          "subheading": "Steatitis"
        },
        {
          "type": "subheading",
          "level": 0,
          "text": "inflammatory dosage;S-adenosylmethionine",
          "pdf_page": 1115,
          "printed_page": 1033,
          "column": 3
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "PO on an empty stomach.",
          "pdf_page": 1115,
          "printed_page": 1033,
          "column": 3,
          "subheading": "inflammatory dosage;S-adenosylmethionine"
        }
      ],
