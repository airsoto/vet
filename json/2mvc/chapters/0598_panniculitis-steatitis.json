              "pdf_page": 1115,
              "printed_page": 1033,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "of sterile nodular panniculitis.",
              "pdf_page": 1115,
              "printed_page": 1033,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Special stains of histopathologic samples—may help identify causative agent.",
              "pdf_page": 1115,
              "printed_page": 1033,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
