      "content_blocks": [
        {
          "type": "paragraph",
          "level": 0,
          "text": "protocol with weekly vincristine (0.5–7 mg/m2IV) and cytoxan (250 mg/m2PO) or dacarbazine (200–250 mg/m2IV q24h for 5 days or 600–1000 mg/m2IV bolus q3 weeks)",
          "pdf_page": 681,
          "printed_page": 599,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Metronomic cyclophosphamide (12.5– 15 mg/m2PO q24h) in combination with a nonsteroidal anti‐inflammatory drug (NSAID; e.g., piroxicam 0.3 mg/kg PO q24h) may be used concurrent to or as an alternative to doxorubicin.",
          "pdf_page": 681,
          "printed_page": 599,
          "column": 1
        }
      ],
