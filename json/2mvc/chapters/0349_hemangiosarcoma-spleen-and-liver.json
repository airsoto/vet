          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Prognosis poor to grave.",
              "pdf_page": 681,
              "printed_page": 599,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Less than 10% of dogs will live 1 year or longer from diagnosis.",
              "pdf_page": 681,
              "printed_page": 599,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Median survival time with surgery alone (dogs): 1–3 months.",
              "pdf_page": 681,
              "printed_page": 599,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Median survival time with surgery plus chemotherapy (dogs): 4.5–8 months.",
              "pdf_page": 681,
              "printed_page": 599,
              "column": 2
            }
          ]
        }
