        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Spleen is most common primary tumor location; liver is fourth most common location.",
              "pdf_page": 680,
              "printed_page": 598,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary tumor rupture leads to acute hemorrhage, collapse, and often sudden death.",
              "pdf_page": 680,
              "printed_page": 598,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Highly metastatic tumor that spreads early in the course of disease via hematogenous and intra‐abdominal implantation routes.",
              "pdf_page": 680,
              "printed_page": 598,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metastasis can be to any organ including lungs, kidneys, muscle, peritoneum, omentum, lymph nodes, mesentery, adrenal glands, spinal cord, brain, subcutaneous tissue, and diaphragm.",
              "pdf_page": 680,
              "printed_page": 598,
              "column": 1
            }
          ]
        },
