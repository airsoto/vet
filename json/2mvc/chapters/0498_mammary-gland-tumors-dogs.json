        "DEFINITION": {
          "present": true,
          "status": "content",
          "source_heading": "DEFINITION",
          "canonical_heading": "DEFINITION",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Benign or malignant tumors of the mammary glands in dogs.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 1
            }
          ]
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Estrogen can exert direct genotoxic effects on mammary epithelium leading to mutations and aneuploidy.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Progesterone may increase growth hormone and growth hormone receptor expression by the mammary gland, leading to increased insulin-like growth factor-1 (IGF-1) which is associated with proliferation and survival.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most dogs develop multiple tumors due to entire mammary tissue exposed to sex hormones during puberty, i.e., “field carcinogenesis.”",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mammary gland tumors are a continuum from benign to malignant.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Obesity decreases sex hormone-binding globulin, leading to increased concentration of free estrogen.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 1
            }
          ]
        },
        "SYSTEMS AFFECTED": {
          "present": true,
          "status": "content",
          "source_heading": "SYSTEMS AFFECTED",
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Reproductive.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metastasis—lymphatic, respiratory, skeletal, nervous, and other systems.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 1
            }
          ]
        },
        "GENETICS": {
          "present": true,
          "status": "content",
          "source_heading": "GENETICS",
          "canonical_heading": "GENETICS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Germline mutations ofBRCA-1and -2and",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "CDK5RAP2genes reported in English",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "springer spaniels.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 1,
              "subheading": "CDK5RAP2genes reported in English"
            }
          ]
        },
        "INCIDENCE/PREVALENCE": {
          "present": true,
          "status": "content",
          "source_heading": "INCIDENCE/PREVALENCE",
          "canonical_heading": "INCIDENCE/PREVALENCE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Constitute 50–70% of all tumors in female dogs; 71% of all female beagles developed at least one mammary neoplasm.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 1
            }
          ]
        },
