        "ALTERNATIVE DRUG(S)": {
          "present": true,
          "status": "content",
          "source_heading": "ALTERNATIVE DRUG(S)",
          "canonical_heading": "ALTERNATIVE DRUG(S)",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Carboplatin, mitoxantrone, gemcitabine, fluorouracil (5-FU), cyclophosphamide have been reported with varying impact on clinical outcome.",
              "pdf_page": 950,
              "printed_page": 868,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Perioperative desmospressin for grade 2–3 carcinoma may improve survival.",
              "pdf_page": 950,
              "printed_page": 868,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tamoxifen—helpful in some humans with breast cancer; ineffective in dogs and has serious side effects (e.g., pyometra); do not use in dogs.",
              "pdf_page": 950,
              "printed_page": 868,
              "column": 1
            }
          ]
        }
      }
