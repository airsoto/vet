    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Always consult a veterinary oncologist for updated information.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nonsteroidal anti-inflammatory drug (NSAID) as sole adjuvant therapy.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Doxorubicin 30 mg/m2IV (dogs >15 kg)",
              "pdf_page": 949,
