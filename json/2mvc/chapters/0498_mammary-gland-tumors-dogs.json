        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Spayed before first estrous cycle—0.5% lifetime risk of developing tumor.",
              "pdf_page": 950,
              "printed_page": 868,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Spayed before second estrous cycle—8.0% lifetime risk.",
              "pdf_page": 950,
              "printed_page": 868,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Spayed after second estrus—26% lifetime risk.",
              "pdf_page": 950,
              "printed_page": 868,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Spayed after 2.5 years of age—no sparing effect on risk.",
              "pdf_page": 950,
              "printed_page": 868,
              "column": 1
            }
          ]
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Infection or dehiscence with surgery.",
              "pdf_page": 950,
              "printed_page": 868,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Myelosuppression with chemotherapy.",
              "pdf_page": 950,
              "printed_page": 868,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Disseminated intravascular coagulation (DIC) with some (especially inflammatory carcinomas) types.",
              "pdf_page": 950,
              "printed_page": 868,
              "column": 1
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "50–70% of canine mammary tumors are malignant.",
              "pdf_page": 950,
              "printed_page": 868,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "50% of malignant tumors metastasize.",
              "pdf_page": 950,
              "printed_page": 868,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "58–70% of dogs will develop another tumor in the ipsilateral chain.",
              "pdf_page": 950,
              "printed_page": 868,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tumor diameter is strong predictor of local recurrence and distant metastasis and is a negative, independent prognosticator of survival.",
              "pdf_page": 950,
              "printed_page": 868,
              "column": 1
            }
          ]
        }
      }
