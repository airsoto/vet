        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiography may detect metastasis and three views are advised.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CT is more sensitive for detection of pulmonary metastasis than are plain radiographs.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CT lymphography could aid in the assessment of sentinel lymph node metastasis.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal radiography may detect metastasis to regional lymph nodes or vertebrae.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal sonography to evaluate for regional or distant metastasis.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Fine-needle aspirate cytology—67.5–93% correlation with histopathology; 88% sensitivity and 96% specificity for malignancy.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fine-needle aspirate cytology of local lymph node(s).",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Histologic evaluation for definitive diagnosis. Request margin evaluation.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "There is a wide histologic spectrum of mammary tumors. Dogs may have concurrent benign and malignant tumors. Histologic examination of all excised masses is indicated.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Histologic grading 1 (well-differentiated) to 3 (poorly differentiated) based on tubule formation, nuclear pleomorphism, and mitotic index valid for epithelial tumors only.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Stromal invasion, vascular/lymphatic invasion, and lymph node status important.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Complex carcinoma is more common than simple carcinoma.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
