        "APPROPRIATE HEALTH CARE": {
          "present": true,
          "status": "content",
          "source_heading": "APPROPRIATE HEALTH CARE",
          "canonical_heading": "APPROPRIATE HEALTH CARE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Surgery—primary mode of treatment. Completeness of excision is prognostic.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chemotherapy—may be effective and indicated for patients with high risk of metastasis or recurrence: histologic high grade or subtype, lymphatic/vascular invasion, stage III or higher.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 3
            }
          ]
        },
        "NURSING CARE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "NURSING CARE",
          "content_blocks": []
        },
        "ACTIVITY": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "ACTIVITY",
          "content_blocks": []
        },
        "DIET": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIET",
          "content_blocks": []
        },
        "CLIENT EDUCATION": {
          "present": true,
          "status": "content",
          "source_heading": "CLIENT EDUCATION",
          "canonical_heading": "CLIENT EDUCATION",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Advise client that a mammary lump should be evaluated by a veterinary health professional.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inform client that early surgical intervention is best.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Advise ovariohysterectomy at time of tumor removal.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 3
            }
          ]
        },
        "SURGICAL CONSIDERATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "SURGICAL CONSIDERATIONS",
          "canonical_heading": "SURGICAL CONSIDERATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Type of surgery determined by therapeutic intent: curative intent with wide excision; preventative with chain mastectomy; palliative intent for advanced disease.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Consider age, tumor size, number of tumors, history of prior tumors, and clinical stage.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most patients with inflammatory carcinoma are poor surgical candidates due to profound diffuse microscopic disease, advanced stage, systemic illness, and local coagulopathies.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "58% of dogs treated with regional mastectomy will develop a new tumor in the ipsilateral chain; increased risk if initial tumor is malignant (>70%).",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Current recommendations for single tumor of unknown histology: wide excision to achieve complete removal is the adequate surgical “dose,” i.e., 2 cm lateral margins and 1 fascial plane deep.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Extirpation of the draining lymph node is advised. Immunohistochemistry may be indicated to detect occult metastasis.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ovariohysterectomy (OHE) concurrent with tumor removal may decrease the risk of relapse in dogs with grade 2, estrogen receptor-positive tumors, or dogs with increased presurgical serum estradiol.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Remove tumor following abdominal closure if performing concurrent OHE to avoid tumor seeding of abdomen or incision.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 3
            }
          ]
        },
