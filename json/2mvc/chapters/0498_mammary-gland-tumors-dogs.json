          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Breed Predilections",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Toy and miniature poodle, English springer",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "spaniel, Brittany spaniel, cocker spaniel,",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "English setter, boxer, English pointer, German",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "shepherd dog, Maltese, Samoyed, schnauzer,",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Doberman pinscher, shih tzu, and Yorkshire",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "terrier.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Mean Age and Range",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Uncommon in dogs <5 years; mean age 9–11",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 1,
              "subheading": "Mean Age and Range"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "years (malignant) and 7–9 years (benign).",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 1,
              "subheading": "Mean Age and Range"
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "70% of patients have multiple tumors.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Caudal mammary glands more commonly affected.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Discrete, well-circumscribed mass in systemically healthy patient.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inflammatory carcinoma—diffuse edematous, warm, painful mammary chains.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inflammatory carcinoma associated with distant metastasis and systemic illness.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES",
          "canonical_heading": "CAUSES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Unknown; likely hormonal.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 2
            }
          ]
        },
        "RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "RISK FACTORS",
          "canonical_heading": "RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Age.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Breed—more common in small breeds than in large breeds.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hormone influence (see Prevention/Avoidance).",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Obesity during puberty increases risk. Underweight at 9–12 months of age associated with protective effect.",
              "pdf_page": 949,
              "printed_page": 867,
              "column": 2
            }
          ]
        },
