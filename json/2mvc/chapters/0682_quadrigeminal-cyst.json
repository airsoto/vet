          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Dog and cat.",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 1
            },
            {
