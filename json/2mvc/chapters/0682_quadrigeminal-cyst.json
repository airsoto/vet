              "printed_page": 1177,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "patients—shih tzu, Maltese, pug, cavalier",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "King Charles, Yorkshire terrier, Lhasa apso,",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Chihuahua, Pekingese, Pomeranian and",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "bulldog.",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Mean Age and Range",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Mean—5 years; range—2 months–10 years.",
