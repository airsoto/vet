            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Seizures.",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abnormal behavior.",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If associated with hydrocephalus, could manifest with disorientation, behavioral changes, cortical blindness, compulsive circling, head pressing.",
