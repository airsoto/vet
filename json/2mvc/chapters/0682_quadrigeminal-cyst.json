    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Repeat neurologic examination periodically",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "(every 2–4 weeks).",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Corticosteroid may be necessary for a long period or for life. The goal is to find the dose that keeps the clinical signs",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "controlled with minimal side effects.",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Evaluate phenobarbital levels after 4–5 weeks of starting",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "therapy.",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If phenobarbital is continued, recheck biochemical profile and bile acids to assess hepatic function every 6 months.",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 3
            }
          ]
        },
