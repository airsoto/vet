        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Disturbance of embryogenesis where splitting of the primitive arachnoid membrane",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "leads to fluid accumulation.",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inflammatory conditions affecting the meninges.",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Postsurgical trauma (intervertebral disc",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "disease, spinal tumor).",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neoplasia and",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "hemorrhage.",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intracystic hemorrhage secondary to trauma may result in expansion of the cyst and subsequent compression of the adjacent brain parenchyma.",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 1
            }
          ]
        }
      }
    },
