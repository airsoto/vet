    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Glucocorticosteroids—dexamethasone 0.1 mg/kg IV or PO q24h for 3 days followed by prednisone 0.25–0.5 mg/kg PO q24h for 10 days, then reassess response and adjust dose. To prevent gastrointestinal ulceration, add omeprazole 0.5 mg/kg PO q24h or famotidine 0.5–1 mg/kg IV or PO q12h to",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "steroid therapy.",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Antiepileptic drugs— phenobarbital 2 mg/kg IV or PO q12h, levetiracetam 20 mg/kg PO q8–12h, or zonisamide 5–10 mg/kg PO q12h.",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diuretic—acetazolamide 10 mg/kg q6–8h as a carbonic anhydrase inhibitor that may",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "help reduce CSF production and intracranial pressure. Omeprazole may act as an agent to reduce CSF production and provide gastric protection during steroid therapy.",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 3
            }
          ]
        },
