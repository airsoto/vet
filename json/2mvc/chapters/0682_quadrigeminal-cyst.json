              "level": 0,
              "text": "Breed Predilections",
              "pdf_page": 1259,
              "printed_page": 1177,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Mainly in small breeds and brachycephalic",
