      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Myxedema coma is a rare, life-threatening manifestation of severe hypothyroidism and an endocrine emergency.",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The development of myxedema coma requires a precipitating event (often infection) that overwhelms normal homeostatic mechanisms.",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The greatest challenge with myxedema coma is recognition. Once recognized, immediate and intensive supportive care is necessary. Successful treatment requires treatment of the underlying cause, if present. Mortality rates can be high.",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1
            }
          ]
        },
