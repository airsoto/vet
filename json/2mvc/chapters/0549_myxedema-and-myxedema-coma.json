            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The most common findings are changes in",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "mental status, altered thermoregulation, and",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "nonpitting skin edema.",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mentation changes are due to brain edema,",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "ranging from altered alertness to obtundation.",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Mental depression is the most common",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "mental status. Coma is rarely reported.",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other signs consistent with hypothyroidism.",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prior diagnosis of hypothyroidism.",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypothermia, nonpitting edema, tachypnea,",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "alopecia, dehydration, dermatitis, otitis.",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mental dullness is common and decreased",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "postural reactions may be present.",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In humans, classic signs of myxedema coma",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "include mental dullness, bradycardia,",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hypothermia, hypoventilation, and hypo",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "tension. These signs have been reported in",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "dogs, but most do not present with all of them.",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Myxedema coma results from chronic untreated severe primary hypothyroidism.",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Both forms of primary hypothyroidism (lymphocytic thyroiditis and idiopathic thyroid atrophy) have been associated with the development of myxedema coma.",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "A secondary precipitating event is usually associated with the onset of a myxedema crisis.",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Precipitating events can include infections, respiratory disease, heart failure, and hypovolemia.",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exposure to cold temperatures may be a precipitating event.",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "cardiovascular collapse; correction of hypothermia should be passive and occur over a number of hours.",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 2
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Weakness may be associated with cardio vascular disease, neurologic disease, and other endocrinopathies.",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Definitive immediate treatment—",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mild nonregenerative anemia. levothyroxine 5μg/kg (0.005 mg/kg) IV",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypercholesterolemia. q12h.",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypertriglyceridemia.",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "A more conservative dose should be used",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypoglycemia. when there is concern about cardiac function,",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyponatremia. and the heart’s ability to deal with a rapid",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urinalysis is normal. increase in metabolic rate. Decrease",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
