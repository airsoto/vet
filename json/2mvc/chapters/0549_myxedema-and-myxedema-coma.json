        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "levothyroxine dose by 50–75% in these cases.",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Once the patient’s condition has stabilized",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thyroid function tests—severe hypo and the patient is able to swallow, oral thyroidism with low total thyroxine (T4), low levothyroxine therapy should be initiated at free T4, and elevated thyroid-stimulating 0.02 mg/kg PO q12h. hormone (TSH) levels.",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Blood gas analysis may note hypoxemia or",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "CONTRAINDICATIONS/POSSIBLE",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hypercarbia.",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 2,
              "subheading": "CONTRAINDICATIONS/POSSIBLE"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "INTERACTIONS",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diagnostics are aimed at identifying an",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lower IV levothyroxine dose in patients",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "underlying cause.",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "with cardiac disease.",
              "pdf_page": 1032,
              "printed_page": 950,
              "column": 2,
              "subheading": "INTERACTIONS"
            }
          ]
        },
        "IMAGING": {
          "present": true,
