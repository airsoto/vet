    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "There is no specific pharmacologic therapy for DIC per se.",
              "pdf_page": 496,
              "printed_page": 414,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Heparin may be used in patients that have overt thrombosis or in those at high risk of thrombosis with normal coagulation times. Unfractionated heparin is preferred to low molecular weight heparin in human patients with DIC.",
              "pdf_page": 496,
              "printed_page": 414,
              "column": 1
            },
            {
              "type": "bullet",
