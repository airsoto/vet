        "APPROPRIATE HEALTH CARE": {
          "present": true,
          "status": "content",
          "source_heading": "APPROPRIATE HEALTH CARE",
          "canonical_heading": "APPROPRIATE HEALTH CARE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Requires intensive inpatient treatment.",
              "pdf_page": 495,
              "printed_page": 413,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Aggressive treatment of the primary disease is essential (e.g., antimicrobials for sepsis).",
              "pdf_page": 495,
              "printed_page": 413,
              "column": 3
            }
          ]
        },
        "NURSING CARE": {
          "present": true,
          "status": "content",
          "source_heading": "NURSING CARE",
          "canonical_heading": "NURSING CARE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Maintain tissue perfusion and oxygenation using fluids, transfusions, and oxygen therapy.",
              "pdf_page": 496,
              "printed_page": 414,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Restore depleted factors by blood/plasma transfusions. Use fresh frozen plasma (10–20 mL/kg) to correct bleeding due to factor deficiency.",
              "pdf_page": 496,
              "printed_page": 414,
              "column": 1
            }
          ]
        },
        "ACTIVITY": {
          "present": true,
          "status": "content",
          "source_heading": "ACTIVITY",
          "canonical_heading": "ACTIVITY",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Limited by disease severity.",
              "pdf_page": 496,
              "printed_page": 414,
              "column": 1
            }
          ]
        },
        "DIET": {
          "present": true,
          "status": "content",
          "source_heading": "DIET",
          "canonical_heading": "DIET",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Maintain nutritional support as appropriate for the clinical condition of the patient.",
              "pdf_page": 496,
              "printed_page": 414,
              "column": 1
            }
          ]
        },
        "CLIENT EDUCATION": {
          "present": true,
          "status": "content",
          "source_heading": "CLIENT EDUCATION",
          "canonical_heading": "CLIENT EDUCATION",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Inform the owner that the condition is life-threatening with a guarded to poor prognosis.",
              "pdf_page": 496,
              "printed_page": 414,
              "column": 1
            }
          ]
        },
        "SURGICAL CONSIDERATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "SURGICAL CONSIDERATIONS",
          "canonical_heading": "SURGICAL CONSIDERATIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Related to primary disease. Plasma or whole blood transfusion to restore clotting factors is a presurgical consideration. Surgery may be contraindicated with uncontrolled bleeding.",
              "pdf_page": 496,
              "printed_page": 414,
              "column": 1
            }
          ]
        },
