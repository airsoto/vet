            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Vary with the primary disease and with DIC-associated organ dysfunction.",
              "pdf_page": 495,
              "printed_page": 413,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Petechiae.",
              "pdf_page": 495,
              "printed_page": 413,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bleeding from venipuncture sites, mucosa, or into body cavities.",
              "pdf_page": 495,
              "printed_page": 413,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bleeding is infrequent in cats, possibly leading to underdiagnosis.",
              "pdf_page": 495,
              "printed_page": 413,
              "column": 2
            }
          ]
        },
        "CAUSES": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES",
          "canonical_heading": "CAUSES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Gastric dilatation-volvulus.",
              "pdf_page": 495,
              "printed_page": 413,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Heart failure.",
              "pdf_page": 495,
              "printed_page": 413,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Heartworm disease.",
              "pdf_page": 495,
              "printed_page": 413,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Heat stroke.",
              "pdf_page": 495,
              "printed_page": 413,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hemolysis, especially immune mediated.",
              "pdf_page": 495,
              "printed_page": 413,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hemorrhagic gastroenteritis.",
              "pdf_page": 495,
              "printed_page": 413,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infectious diseases, systemic (especially endotoxemia).",
              "pdf_page": 495,
              "printed_page": 413,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inflammation, severe—regardless of underlying cause.",
              "pdf_page": 495,
              "printed_page": 413,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Liver disease, severe.",
              "pdf_page": 495,
              "printed_page": 413,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Malignancies, especially hemangiosarcoma, mammary carcinoma, and pulmonary adenocarcinoma in dogs and lymphoma in cats.",
              "pdf_page": 495,
              "printed_page": 413,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pancreatitis.",
              "pdf_page": 495,
              "printed_page": 413,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Protein-losing nephropathy.",
              "pdf_page": 495,
              "printed_page": 413,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Shock, hypoxia, acidosis.",
              "pdf_page": 495,
              "printed_page": 413,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thrombocytopenia, especially immunemediated.",
              "pdf_page": 495,
              "printed_page": 413,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Transfusion incompatibility.",
              "pdf_page": 495,
              "printed_page": 413,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Trauma.",
              "pdf_page": 495,
              "printed_page": 413,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Envenomation.",
              "pdf_page": 495,
              "printed_page": 413,
              "column": 2
            }
          ]
        },
