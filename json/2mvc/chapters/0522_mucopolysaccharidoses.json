        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—MPS I and VII (domestic shorthair [DSH]); MPS VI (Siamese and DSH).",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—MPS I, Plott hounds; MPS II, Labrador retrievers; MPS IIIA, wire-haired dachshunds and Huntaways; MPS VI, miniature pinschers, miniature schnauzers, miniature poodles, and Welsh corgis; MPS VII, mixed breeds and Belgian, White Swiss, and German shepherd dogs.",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Both sexes equally affected by MPS I, III, VI, and VII; primarily males affected by MPS II.",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical signs apparent at 2–4 months of age.",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affected animals may live several years, but locomotor difficulty is progressive.",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Skeletal abnormalities more severe in cats with MPS VI than in those with MPS I; some MPS VI cats develop posterior paresis from spinal cord compression.",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dwarfism (except cats with MPS I).",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Severe bone disease (dysostosis multiplex), degenerative joint disease, facial dysmorphia.",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hepatomegaly (except cats with MPS VI).",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Corneal clouding–~8 weeks of age.",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Enlarged tongue (dogs).",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Heart valve thickening, resulting in left- or right-sided heart failure.",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Excess urinary excretion of GAG.",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Manipulation of the head or neck usually painful.",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
