        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "MPS transmission is autosomal recessive, except MPS II, which is X-linked recessive.",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In-breeding increases risk.",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "leukocytes provide missing enzyme to various tissues; when performed at a very early age, affected animals lead near-normal lives; not as",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 2
            }
          ]
        }
      }
    },
