  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Mucopolysaccharidoses (MPS) are characterized by the accumulation of glycosaminoglycans (GAGs) in cells, and result from the impaired function of 1 of 11 enzymes required for normal GAG degradation.",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Undegraded GAGs are stored in lysosomes, resulting in progressive tissue and organ dysfunction.",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Types of MPS Reported in Dogs",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "and Cats",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "MPS I—α-l-iduronidase deficiency:",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1,
              "subheading": "and Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "dermatan and heparan sulfate stored.",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1,
              "subheading": "and Cats"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "MPS II—iduronate sulfatase deficiency:",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1,
              "subheading": "and Cats"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "MPS IIIA—heparanN-sulfatase deficiency:",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1,
              "subheading": "and Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "heparan sulfate stored.",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1,
              "subheading": "and Cats"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "MPS VI—arylsulfatase B deficiency:",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1,
              "subheading": "and Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "dermatan sulfate stored.",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1,
              "subheading": "and Cats"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "MPS VII—β-glucuronidase deficiency:",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1,
              "subheading": "and Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "dermatan, heparan, and chondroitin sulfate",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1,
              "subheading": "and Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "stored.",
              "pdf_page": 990,
              "printed_page": 908,
              "column": 1,
              "subheading": "and Cats"
            }
          ]
        },
