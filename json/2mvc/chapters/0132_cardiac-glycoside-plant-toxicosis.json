              "text": "ECG monitoring for cardiac arrhythmias.",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Sudden death is common. Plant pieces are often found in the stomach and small intestine. Clotted blood may be present in the ventricles with a mottled appearance to the epicardium. Histopathology findings are similar to digoxin toxicosis.",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Emesisquickly after ingestion.",
          "pdf_page": 307,
          "printed_page": 225,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Activated charcoal(1–2 g/kg)with a cathartic × 1, followed by activated charcoal without a cathartic every 6–8 hours × 2 doses.",
          "pdf_page": 307,
          "printed_page": 225,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Asymptomatic animals—hospitalize and monitor for 12 hours.",
          "pdf_page": 307,
          "printed_page": 225,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Symptomatic animals—hospitalize and monitor with an ECG for 24 hours; administer appropriate IV fluids (dependent on serum potassium) to maintain blood pressure but not overload the CV system; monitor blood pressure closely, as hypotension may be persistent.",
          "pdf_page": 307,
          "printed_page": 225,
          "column": 2
        }
      ],
