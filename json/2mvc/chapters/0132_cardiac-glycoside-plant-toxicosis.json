    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Digoxin-specific fragment antigen binding (Fab; Digibind®) may be useful in some cases, especially oleander toxicosis.",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Antiemetics if vomiting is severe or persistent— maropitant 1 mg/kg SC/IV/PO q24h in dogs and cats; ondansetron 0.5–1 mg/kg IV, SC, PO q8–12h in dogs and cats.",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bradycardia—atropine 0.02–0.04 mg/kg IV/IM/SC in dogs and cats; repeat q4–6h as needed.",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Antiarrhythmics may be necessary in patients with ventricular dysrhythmias, evidence of poor perfusion, or who remain tachycardic despite IV fluid therapy— lidocaine: dogs, 2–4 mg/kg IV to effect.",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "GI protectants as needed—H2 blockers such as famotidine (0.5–1 mg/kg PO/SC/IM/IV q12h); omeprazole (0.5 mg/kg PO daily); or sucralfate (0.25–1 g PO q8h).",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 2
            }
          ]
        },
