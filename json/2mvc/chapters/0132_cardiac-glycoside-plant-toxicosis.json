        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats are more sensitive to some of the plant toxins than dogs.",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs with the ABCB1-1Δgene mutation maybe more sensitive to toxins.",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "All plant parts, fresh or dry, are considered toxic, but the concentration varies depending on specific plant and plant part.",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Plants are best identified by scientific name.",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Common plants includeAdenium obesum (desert rose);Apocynum cannabinum(dogbane); Asclepiasspp. (milkweed);Calatropisspp.",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "(giant milkweed);Convallaria majalis(lily of",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "the valley);Digitalis lanata(wooly foxglove);",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 1,
              "subheading": "(giant milkweed);Convallaria majalis(lily of"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Digitalis purpurea(common or purple",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "foxglove);Kalanchoespp. (mother of millions);",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 1,
              "subheading": "Digitalis purpurea(common or purple"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Nerium oleander(oleander);Ornithogalum",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "umbellatum(star of Bethlehem);Thevetia",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "peruviana(yellow oleander).",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 1,
              "subheading": "umbellatum(star of Bethlehem);Thevetia"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CV—bradycardia (rarely tachycardia), atrioventricular (AV) block, all forms of arrhythmias, death from asystole.",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "GI (most frequent)—hypersalivation, vomiting ± blood, diarrhea ± blood.",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neuromuscular—coma, tremors, seizures (rarely); may be related to decreased cardiac output.",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cardiac glycoside–containing plants inhibit the ATPase sodium/potassium pump, resulting in an increase in intracellular sodium and a decrease in intracellular potassium; increased intracellular (myocyte) calcium results in increased cardiac contractions.",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Animals with a prior history of cardiac or renal disease and receiving digoxin or other cardiac glycoside drugs are at risk.",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Beta blocker or calcium channel blocker toxicosis.",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cardiac disease in general.",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Digoxin/digitoxin toxicosis.",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ingestion of medications with known cardiac effects.",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ingestion of other plants with known cardiac effects such asTaxusspp. (yew), Rhododendronspp. (azalea, rhododendron),",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Kalmiaspp. (mountain laurel, lambkill), and",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Pieris japonica(Japanese pieris).",
              "pdf_page": 307,
              "printed_page": 225,
              "column": 1,
              "subheading": "Kalmiaspp. (mountain laurel, lambkill), and"
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
