    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "No antidote.",
          "pdf_page": 1293,
          "printed_page": 1211,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "The goal of treatment with recent, asymptomatic patients is to safely",
          "pdf_page": 1293,
          "printed_page": 1211,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "decontaminate.",
          "pdf_page": 1293,
          "printed_page": 1211,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Administration of a liquid antacid such as magnesium hydroxide, aluminum hydroxide, calcium carbonate, or even a 5% sodium bicarbonate solution may help to increase the gastric pH and thus",
          "pdf_page": 1293,
          "printed_page": 1211,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "decrease phosphine gas production.",
          "pdf_page": 1293,
          "printed_page": 1211,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Emesis induction with apomorphine, hydrogen peroxide, or gastric lavage for gastric",
          "pdf_page": 1293,
          "printed_page": 1211,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "emptying.",
          "pdf_page": 1293,
          "printed_page": 1211,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Activated charcoal may help decrease toxicity but should be given only if",
          "pdf_page": 1293,
          "printed_page": 1211,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "the patient’s clinical status allows.",
          "pdf_page": 1293,
          "printed_page": 1211,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "IV fluid therapy with monitoring for any clinical signs or progression of signs for at least 18 hours.",
          "pdf_page": 1293,
          "printed_page": 1211,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Supplemental oxygen for hypoxemia.",
          "pdf_page": 1293,
          "printed_page": 1211,
          "column": 2
        }
      ],
