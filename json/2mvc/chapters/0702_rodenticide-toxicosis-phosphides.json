    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "GI protectants—famotidine 0.5–1 mg/kg IV/PO q12–24h, omeprazole 0.5–1 mg/kg PO q12–24h, sucralfate 0.25–1 g PO q8–12h, or possibly misoprostol 2–5μg/kg",
          "pdf_page": 1293,
          "printed_page": 1211,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "PO q8h.",
          "pdf_page": 1293,
          "printed_page": 1211,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Tremors—methocarbamol 44–220 mg/kg IV or to effect; do not exceed",
          "pdf_page": 1293,
          "printed_page": 1211,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "330 mg/kg/day.",
          "pdf_page": 1293,
          "printed_page": 1211,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Seizures—diazepam 0.5–1 mg/kg IV, phenobarbital 4–16 mg/kg IV to effect, levetiracetam 30–60 mg/kg IV, or propofol 1–8 mg/kg or to effect, followed",
          "pdf_page": 1293,
          "printed_page": 1211,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "by a CRI at 0.1–0.6 mg/kg/h.",
          "pdf_page": 1293,
          "printed_page": 1211,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Liver effects—",
          "pdf_page": 1293,
          "printed_page": 1211,
          "column": 2
        },
        {
          "type": "subheading",
          "level": 0,
          "text": "hepatoprotectants (S-adenosylmethionine",
          "pdf_page": 1293,
          "printed_page": 1211,
          "column": 2
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "18 mg/kg PO q24h, silymarin/milk thistle",
          "pdf_page": 1293,
          "printed_page": 1211,
          "column": 3,
          "subheading": "hepatoprotectants (S-adenosylmethionine"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "50–250 mg/day PO q24h. If associated",
          "pdf_page": 1293,
          "printed_page": 1211,
          "column": 3,
          "subheading": "hepatoprotectants (S-adenosylmethionine"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "coagulopathy—vitamin K12–3 mg/kg PO",
          "pdf_page": 1293,
          "printed_page": 1211,
          "column": 3,
          "subheading": "hepatoprotectants (S-adenosylmethionine"
        },
        {
          "type": "bullet",
          "level": 0,
