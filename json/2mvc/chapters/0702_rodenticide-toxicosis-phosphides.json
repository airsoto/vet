              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Post-mortem samples from the liver, kidney.",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "If respiratory signs, thoracic radiographs to assess for pulmonary edema.",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 2
            }
          ]
        },
