        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "No known age, breed, or sex predilection.",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Within 15 minutes to 4 hours but can be",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "delayed up to 18 hours.",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "GI—anorexia,",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "vomiting, and melena.",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cardiovascular— direct myocardial damage, arrhythmias, decreased inotropy, hypotension.",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory—pulmonary edema, pleural",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "effusion.",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hemic/lymphatic/immune— methemoglobinemia, Heinz body production.",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nervous—ataxia, weakness, tremors,",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "hyperesthesia, and seizures.",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Renal/urologic—",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "azotemia, acute renal failure.",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hepatobiliary— increased alanine transaminase (ALT), aspartate transferase (AST), and total bilirubin.",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Endocrine/metabolic—metabolic acidosis,",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "electrolyte imbalance.",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Musculoskeletal— weakness, ataxia.",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Increased hydrolysis in a moist, acidic environment; thus, recent food ingestion lowers gastric pH and increases hydrolysis. Owner should be instructed not to feed their pet.",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Owners and veterinary staff are at risk for inhalation exposure if the animal vomits in a poorly ventilated area. Owners should be told to lower their windows on the way to the clinic.",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Organophosphate.",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metaldehyde.",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Serotonin syndrome.",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nonsteroidal anti-inflammatory drug (NSAID) toxicosis.",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tremorgenic mycotoxins.",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute GI disease (hemorrhagic gastroenteritis [HGE],",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "gastroenteritis, parvovirus).",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Congestive",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "heart failure.",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory disease (noncardiogenic pulmonary edema— secondary to electrocution, near drowning, seizures, or acute respiratory distress",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "syndrome [ARDS]).",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metabolic disease (renal, hepatic, pancreatitis).",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "May see increased liver enzymes (ALT, AST, and total bilirubin); can be delayed 3–5 days.",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Electrolyte alterations (decreased potassium",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "or magnesium).",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Methemoglobinemia, Heinz body formation, and subsequent hemolysis.",
              "pdf_page": 1293,
              "printed_page": 1211,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
