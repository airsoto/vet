              "text": "staining can aid specific diagnosis.",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Liver and regional lymph node biopsies may reveal metastasis.",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 2
            }
          ]
        }
