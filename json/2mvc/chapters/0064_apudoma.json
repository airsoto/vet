        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Serum gastrin concentration—normal or high normal if gastrinoma. Antacid treatment increases serum gastrin, resulting in falsepositive diagnosis of gastrinoma; withdrawal of drugs for at least 7 days returns gastrin concentrations to baseline in dogs without",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "gastrinoma.",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Induced gastrin secretion— increased gastrin concentration after IV calcium gluconate or secretin suggests gastrinoma; rarely reported in veterinary medicine.",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Abdominal ultrasound may demonstrate pancreatic mass or evidence of gastrointestinal ulceration/thickened gastric wall; frequently, the primary mass is too small to be detected.",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "CT or MRI to identify pancreatic masses",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "and/or metastatic lesions.",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Endoscopy with",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "gastric and duodenal biopsy.",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Aspirate any detectable masses (rule out mast cell disease).",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 2
            }
          ]
        },
