    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Most apudomas are malignant and have metastasized by the time of diagnosis;",
          "pdf_page": 193,
          "printed_page": 111,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "long-term control is difficult.",
          "pdf_page": 193,
          "printed_page": 111,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Aggressive medical management can palliate signs for",
          "pdf_page": 193,
          "printed_page": 111,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "months to years.",
          "pdf_page": 193,
          "printed_page": 111,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgical exploration and excisional biopsy/surgical debulking of a pancreatic mass are important both",
          "pdf_page": 193,
          "printed_page": 111,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "diagnostically and therapeutically.",
          "pdf_page": 193,
          "printed_page": 111,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Medical management for gastric hyperacidity.",
          "pdf_page": 193,
          "printed_page": 111,
          "column": 2
        }
      ],
