              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal pain.",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hematemesis,",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "hematochezia.",
              "pdf_page": 193,
