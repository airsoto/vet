              "type": "bullet",
              "level": 0,
              "text": "Endoscopic biopsy—gastrointestinal",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "ulceration.",
