        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Gastrinoma—rare in dogs, very rare in cats; age range 3–12 years, mean 7.5 years (dogs).",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pancreatic polypeptidoma—extremely rare in dogs.",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Vomiting.",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Weight loss.",
              "pdf_page": 193,
