              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diarrhea.",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lethargy, depression.",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Melena.",
