        "CONTRAINDICATIONS/POSSIBLE INTERACTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Because sucralfate may be less effective in an alkaline environment and may reduce absorption of other drugs, it should be given as a suspension, 1–2 hours prior to antacid drugs.",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 3
            }
          ]
        },
