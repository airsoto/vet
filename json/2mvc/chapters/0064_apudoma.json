              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "ulceration:",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Uremia.",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Hepatic failure.",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Drug-induced ulceration, e.g., nonsteroidal",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "anti-inflammatory drugs (NSAIDs) or",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "steroids.",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Inflammatory gastritis.",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Stress-",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "induced ulceration.",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 1
            },
            {
