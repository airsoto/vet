    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Omeprazole—proton pump inhibitor; potent inhibitor of gastric acid secretion; preferred.",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Histamine H2-receptor antagonists— cimetidine, ranitidine, famotidine; decrease acid",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "secretion by gastric parietal cells.",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sucralfate— adheres to ulcerated gastric mucosa and protects from acid; promotes healing by binding pepsin and bile acids and stimulating local prosta",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "glandins.",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Octreotide–somatostatin analog—",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "used successfully in 2 dogs and 1 cat with gastrinoma.",
              "pdf_page": 193,
              "printed_page": 111,
              "column": 3
            }
          ]
        },
