              "printed_page": 186,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "but can be delayed.",
              "pdf_page": 268,
              "printed_page": 186,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Can occur with administration of any blood‐derived product.",
              "pdf_page": 268,
              "printed_page": 186,
              "column": 1
            }
          ]
        },
