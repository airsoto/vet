        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Predisposition in intact dogs of either sex, however, routes of nonsexually contact transmission permits disease manifestation in neutered and spayed dogs.",
              "pdf_page": 1434,
              "printed_page": 1352,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Red, friable, lobulated mass on the mucosa of the vagina, penis or other nonreproductive organ mucous membranes.",
              "pdf_page": 1434,
              "printed_page": 1352,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Oral and nasal mucosa may be affected.",
              "pdf_page": 1434,
              "printed_page": 1352,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Owners may report blood dripping from the affected area or excessive licking of the genital area.",
              "pdf_page": 1434,
              "printed_page": 1352,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Proliferative or exophytic tumor protrusion may be noticed.",
              "pdf_page": 1434,
              "printed_page": 1352,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Direct transplantation of tumor cells onto abraded mucosa, either by coitus, oral, or nasal transmission.",
              "pdf_page": 1434,
              "printed_page": 1352,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intact, free-roaming dogs are at greater than average risk.",
              "pdf_page": 1434,
              "printed_page": 1352,
              "column": 1
            }
          ]
        }
      }
    },
