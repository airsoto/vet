        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiographs, although this tumor type is rarely metastatic.",
              "pdf_page": 1434,
              "printed_page": 1352,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal ultrasonography to evaluate mesenteric lymph nodes.",
              "pdf_page": 1434,
              "printed_page": 1352,
              "column": 1
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Careful palpation of regional lymph nodes, and perform aspirates with cytology when clinically indicated.",
              "pdf_page": 1434,
              "printed_page": 1352,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Examination of impression smears or aspirates of the tumor reveals homogenous sheets of round to oval cells with prominent",
              "pdf_page": 1434,
              "printed_page": 1352,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "nucleoli, scant cytoplasm, and multiple clear cytoplasmic vacuoles.",
              "pdf_page": 1434,
              "printed_page": 1352,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Biopsy offers definitive diagnosis.",
              "pdf_page": 1434,
              "printed_page": 1352,
              "column": 2
            }
          ]
        },
