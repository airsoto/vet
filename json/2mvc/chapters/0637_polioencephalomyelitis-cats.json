  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Subacute to chronic nonsuppurative encephalomyelitis with a predominance of pathologic changes in the gray matter, mainly affecting the medulla oblongata and the spinal cord.",
              "pdf_page": 1182,
              "printed_page": 1100,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "This disease is considered rare, with a prevalence of less than 1% in cats presented with spinal cord diseases.",
              "pdf_page": 1182,
              "printed_page": 1100,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
