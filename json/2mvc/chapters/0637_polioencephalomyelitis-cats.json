        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "There is no breed or sex predilection.",
              "pdf_page": 1182,
              "printed_page": 1100,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats of any age can be affected.",
              "pdf_page": 1182,
              "printed_page": 1100,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The disease is sporadic but has been observed worldwide, especially in northern Europe.",
              "pdf_page": 1182,
              "printed_page": 1100,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ataxia, paresis, and decreased postural reactions of pelvic or all four limbs.",
              "pdf_page": 1182,
              "printed_page": 1100,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lower motor neuron signs may be also possible (muscle atrophy and decreased to absent segmental spinal reflexes).",
              "pdf_page": 1182,
              "printed_page": 1100,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intracranial signs (seizures, cerebellar signs, and cranial nerve deficits) are uncommon.",
              "pdf_page": 1182,
              "printed_page": 1100,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The progression is subacute to chronic (over weeks to months) but may also stabilize.",
              "pdf_page": 1182,
              "printed_page": 1100,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "The underlying cause remains still unknown but pathologic findings are highly suggestive of a viral agent.",
              "pdf_page": 1182,
              "printed_page": 1100,
              "column": 1
            }
          ]
        }
      }
    },
