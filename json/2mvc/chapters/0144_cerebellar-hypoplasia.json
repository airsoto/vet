      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Caused by incomplete development of parts of the cerebellum owing to intrinsic (inherited) or extrinsic (infectious, toxic, or nutritional) factors.",
              "pdf_page": 330,
              "printed_page": 248,
              "column": 1
            }
          ]
        },
