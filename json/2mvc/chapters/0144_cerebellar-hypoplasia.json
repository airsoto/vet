        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Symptoms may not be visible until puppies and kittens begin to stand/walk (usually by 6 weeks old).",
              "pdf_page": 330,
              "printed_page": 248,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hereditary in Airedale, chow chow, Boston terrier, Labrador retriever, Weimaraner, shih tzu, miniature schnauzer, and bull terrier.",
              "pdf_page": 330,
              "printed_page": 248,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Symmetric, nonprogressive cerebellar disorder—head bobbing; limb tremors; aggravated by movement or eating and disappear during sleep (intention tremors).",
              "pdf_page": 330,
              "printed_page": 248,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cerebellar ataxia, wide-base stance.",
              "pdf_page": 330,
              "printed_page": 248,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dysmetria and disequilibrium—falling, flipping over.",
              "pdf_page": 330,
              "printed_page": 248,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—usually transplacental or perinatal infection with panleukopenia virus (wild or from modified live virus used in some vaccines), which selectively attacks rapidly dividing cells, e.g., external germinal layer of the cerebellum at birth and for 2 weeks postnatal.",
              "pdf_page": 330,
              "printed_page": 248,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—hereditary in some breeds (autosomal recessive).",
              "pdf_page": 330,
              "printed_page": 248,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Age, breed, history, typical symmetric and nonprogressive symptoms—usually sufficient for tentative diagnosis.",
              "pdf_page": 330,
              "printed_page": 248,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Early cerebellar abiotrophy—postnatal degeneration after normal development; slow progression of signs over weeks to months; neonatal onset (beagle, Samoyed, Rhodesian ridgeback, Irish setter, Jack Russell terrier, miniature poodle) or postnatal onset (Australian kelpie at 5–6 weeks; Kerry blue terrier at 8–16 weeks; rough-coated collie at 4–8 weeks; bullmastiff at 4–9 weeks).",
              "pdf_page": 330,
              "printed_page": 248,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neuroaxonal dystrophy—slowly progressive cerebellar signs starting around 5 weeks of age in cats and 7 weeks in Chihuahuas.",
              "pdf_page": 330,
              "printed_page": 248,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cerebellar sequels of systemic canine herpesvirus infection—follow systemic illness.",
              "pdf_page": 330,
              "printed_page": 248,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Concomitant seizures or other cerebral signs—suggest other malformations, such as lissencephaly (wirehaired fox terrier and Irish setter) or hydrocephalus.",
              "pdf_page": 330,
              "printed_page": 248,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Care",
              "pdf_page": 330,
              "printed_page": 248,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Final diagnosis possible only at necropsy.",
              "pdf_page": 330,
              "printed_page": 248,
              "column": 2,
              "subheading": "Care"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Restrict environment to prevent injuries",
              "pdf_page": 330,
              "printed_page": 248,
              "column": 2,
              "subheading": "Care"
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
