          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Use NSAIDs cautiously in all cats and in",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "dogs with renal insufficiency.",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Do not combine NSAIDs with corticosteroids.",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 2
