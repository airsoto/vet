        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—medium- to large-breed dogs, with mixed-breed dogs, golden retrievers, boxers, and German shepherd dogs overrepresented; median age is 8 years (range: 1–15 years).",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—median age is 9 years (range: 2–18 years), with males twice as likely to be affected.",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Patients often present with a visible mass at",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "the affected site.",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "History of lameness if",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "involvement of weight-bearing bone.",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rarely,",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "CSA of the rib may be associated with",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "respiratory signs.",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Additional clinical signs",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "vary with site of involvement.",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Findings depend on anatomic location.",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "A firm to hard mass often is palpable, with",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "variable degrees of pain elicited on palpation.",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CSA of the rib occurs most commonly at",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "the costochondral junction; dyspnea is rare",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and associated with space-occupying effect.",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
        "CAUSES": {
          "present": false,
