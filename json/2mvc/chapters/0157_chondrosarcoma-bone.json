        "OTHER LABORATORY TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": []
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Radiographs of affected area show features of aggressive bone lesion (cortical lysis, nonhomogenous reactive bone formation,",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "ill-defined zone of transition).",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiographs recommended to screen for",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "pulmonary metastasis.",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CT recommended for axial tumors to more accurately stage local disease and plan for surgery and/or radiation therapy; concurrent CT imaging of thorax recommended as more sensitive way to screen",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "for pulmonary metastasis.",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "MRI, alone or in combination with CT, may be recommended for treatment planning for vertebral CSA.",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Histopathology needed for definitive diagnosis.",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fine-needle aspirate bone cytology may provide supportive diagnosis; differentiation of CSA from other sarcomas may be challenging if sample contains sparse amounts of matrix.",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 2
            }
          ]
        },
