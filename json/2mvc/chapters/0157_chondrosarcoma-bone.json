        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Etiology largely unknown.",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Osteochondromatosis (multiple cartilaginous exostosis) lesions can transform into CSA.",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other primary bone tumors (osteosarcoma, fibrosarcoma, hemangiosarcoma).",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metastatic bone tumors (transitional cell, prostatic, mammary, thyroid, apocrine gland,",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "anal sac carcinomas).",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tumors that locally invade adjacent bone (especially oral, nasal,",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "digital, and joint tumors).",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fungal osteomyelitis.",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Usually normal.",
              "pdf_page": 351,
              "printed_page": 269,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
