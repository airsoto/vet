    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Amputation recommended for appendicu-",
          "pdf_page": 351,
          "printed_page": 269,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "lar tumors.",
          "pdf_page": 351,
          "printed_page": 269,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "For axial tumors, wide surgical excision recommended whenever possible.",
          "pdf_page": 351,
          "printed_page": 269,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Stereotactic radiation therapy provides effective local control for canine osteosarcoma and might be alternative to surgery for",
          "pdf_page": 351,
          "printed_page": 269,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "patients with CSA.",
          "pdf_page": 351,
          "printed_page": 269,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Palliative therapy recommended for patients with nonresectable local disease or gross metastasis, or when definitive therapy is declined; palliative care focuses on pain control.",
          "pdf_page": 351,
          "printed_page": 269,
          "column": 2
        }
      ],
