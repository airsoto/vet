      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cannot be differentiated from other encephalitides solely on clinical signs; CSF",
              "pdf_page": 978,
              "printed_page": 896,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "analysis must be done.",
              "pdf_page": 978,
              "printed_page": 896,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Idiopathic EME— negative serologic test results; marked CSF eosinophilic pleocytosis (20–95%); usually",
              "pdf_page": 978,
              "printed_page": 896,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "steroid-responsive.",
              "pdf_page": 978,
              "printed_page": 896,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infectious diseases— identified on presence of systemic signs, blood work, fecal sample, CSF, serum/CSF serology, and imaging.",
              "pdf_page": 978,
              "printed_page": 896,
              "column": 1
            }
          ]
        },
