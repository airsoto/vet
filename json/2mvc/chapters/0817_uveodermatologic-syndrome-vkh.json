  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Rare canine syndrome similar to Vogt– Koyanagi–Harada (VKH) in humans.",
              "pdf_page": 1472,
              "printed_page": 1390,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic granulomatous inflammatory condition of unknown etiology.",
              "pdf_page": 1472,
              "printed_page": 1390,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affects the meninges, eyes then skin.",
              "pdf_page": 1472,
              "printed_page": 1390,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical signs reflect melanin as the target of inflammation.",
              "pdf_page": 1472,
              "printed_page": 1390,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Likely an autoimmune process against antigenic components of melanocytes, suspected tyrosinase and related proteins; involves T-cells and macrophages for skin lesions and B-cells and macrophages for ocular lesions.",
              "pdf_page": 1472,
              "printed_page": 1390,
              "column": 1
            }
          ]
        },
        "SYSTEMS AFFECTED": {
          "present": true,
          "status": "content",
          "source_heading": "SYSTEMS AFFECTED",
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ophthalmic.",
              "pdf_page": 1472,
              "printed_page": 1390,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Skin/exocrine.",
              "pdf_page": 1472,
              "printed_page": 1390,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nervous (rarely).",
              "pdf_page": 1472,
              "printed_page": 1390,
              "column": 1
            }
          ]
        },
        "GENETICS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GENETICS",
          "content_blocks": []
        },
        "INCIDENCE/PREVALENCE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "INCIDENCE/PREVALENCE",
          "content_blocks": []
        },
        "GEOGRAPHIC DISTRIBUTION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GEOGRAPHIC DISTRIBUTION",
          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Akita, Samoyed, Siberian husky, Alaskan Malamute, old English sheepdog, and chow chow predisposed.",
              "pdf_page": 1472,
              "printed_page": 1390,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other breeds and mixed breeds reported.",
              "pdf_page": 1472,
              "printed_page": 1390,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Suspected heritability: canine leukocyte antigen DLA-DQA1*00201 has been associated with an increased risk for uveodermatological syndrome.",
              "pdf_page": 1472,
              "printed_page": 1390,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No sex predilection.",
              "pdf_page": 1472,
              "printed_page": 1390,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mean age of onset 6 months–6 years.",
              "pdf_page": 1472,
              "printed_page": 1390,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ophthalmic signs almost always precede dermatologic signs.",
              "pdf_page": 1472,
              "printed_page": 1390,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sudden-onset uveitis (photophobia, blepharospasm, conjunctival inflammation, pain).",
              "pdf_page": 1472,
              "printed_page": 1390,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary changes include glaucoma, cataracts, bullous retinal detachment, and progression to blindness.",
              "pdf_page": 1472,
              "printed_page": 1390,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Unilateral uveitis may be seen in dogs with heterochromic irides.",
              "pdf_page": 1472,
              "printed_page": 1390,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Concurrent or subsequent leukoderma of the nose, lips, and eyelids.",
              "pdf_page": 1472,
              "printed_page": 1390,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Depigmented nasal planum may develop crusting and ulceration.",
              "pdf_page": 1472,
              "printed_page": 1390,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Concurrent or subsequent striking leukotrichia of the muzzle and periorbital regions.",
              "pdf_page": 1472,
              "printed_page": 1390,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Footpads, scrotum, vulva, anus, and oral cavity (hard palate) may also depigment.",
              "pdf_page": 1472,
              "printed_page": 1390,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neurologic symptoms (meningoencephalitis,) possible, but very rare.",
              "pdf_page": 1472,
              "printed_page": 1390,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
