        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Exact cause is unknown.",
              "pdf_page": 1472,
              "printed_page": 1390,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most likely an inherited autoimmune disorder.",
              "pdf_page": 1472,
              "printed_page": 1390,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Skin trauma or infectious agent (e.g., virus) are possible triggers.",
              "pdf_page": 1472,
              "printed_page": 1390,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exposure to sunlight can exacerbate the symptoms.",
              "pdf_page": 1472,
              "printed_page": 1390,
              "column": 2
            }
          ]
        }
      }
    },
