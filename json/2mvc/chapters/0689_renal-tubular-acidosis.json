  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperchloremic metabolic acidosis due to decreased bicarbonate reabsorption in the proximal renal tubule (proximal or type 2 renal tubular acidosis [RTA]) or decreased hydrogen ion secretion in the distal tubule (distal or type 1 RTA) in patients with normal or near normal glomerular filtration rate and absence of diarrhea.",
              "pdf_page": 1269,
              "printed_page": 1187,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Aldosterone deficiency or resistance can cause type 4 distal RTA and hyperkalemia.",
              "pdf_page": 1269,
              "printed_page": 1187,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Proximal RTA has not been documented as an isolated entity in dogs but has been observed as part of Fanconi syndrome.",
              "pdf_page": 1269,
              "printed_page": 1187,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In distal RTA urine cannot be maximally acidified despite moderately to markedly decreased plasma bicarbonate concentration as a consequence of impaired hydrogen secretion in the collecting ducts. Urine pH typically is >6.0 (urine pH should be 4.5–5.0 in the presence of systemic acidosis).",
              "pdf_page": 1269,
              "printed_page": 1187,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
