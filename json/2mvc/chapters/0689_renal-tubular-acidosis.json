    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Serial blood gas with electrolyte analyses (e.g., every 3–5 days) until acid–base status has normalized.",
          "pdf_page": 1269,
          "printed_page": 1187,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Long-term prognosis depends on the nature and severity of associated conditions; may be reasonably good in patients without other diseases, little information exists on the longterm course of this disease.",
          "pdf_page": 1269,
          "printed_page": 1187,
          "column": 3
        }
      ],
