    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Acidosis—depending on the serum potassium concentration give potassium citrate alone ± sodium citrate; or sodium bicarbonate.",
              "pdf_page": 1269,
              "printed_page": 1187,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Potassium supplementation—potassium gluconate if hypokalemia does not resolve with potassium citrate therapy alone.",
              "pdf_page": 1269,
              "printed_page": 1187,
              "column": 3
            }
          ]
        },
        "CONTRAINDICATIONS": {
          "present": false,
          "status": "missing",
