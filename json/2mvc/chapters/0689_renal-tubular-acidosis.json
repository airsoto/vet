        },
        "CONTRAINDICATIONS/POSSIBLE INTERACTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Citrate should be avoided in patients receiving aluminum hydroxide; citrate can lead to excessive aluminum absorption.",
              "pdf_page": 1269,
              "printed_page": 1187,
              "column": 3
            }
          ]
        },
        "ALTERNATIVE DRUG(S)": {
