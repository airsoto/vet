          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Opportunistic bacterial infections caused by branching Gram-positive bacteria that cause clinically similar suppurative-togranulomatous inflammation:",
              "pdf_page": 99,
              "printed_page": 17,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Actinomycesspp. (anaerobic-to-",
              "pdf_page": 99,
              "printed_page": 17,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "microaerophilic, normal flora of mucous membranes, gastrointestinal and urogenital tracts).",
              "pdf_page": 99,
              "printed_page": 17,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Nocardiaspp. (aerobic soil saprophytes).",
              "pdf_page": 99,
              "printed_page": 17,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Organ systems affected may include:",
              "pdf_page": 99,
              "printed_page": 17,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Skin and subcutaneous.",
              "pdf_page": 99,
              "printed_page": 17,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Respiratory.",
              "pdf_page": 99,
