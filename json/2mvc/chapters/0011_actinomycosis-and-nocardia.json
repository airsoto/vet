    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Prolonged antimicrobial therapy is required.",
          "pdf_page": 99,
          "printed_page": 17,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgical debridement or excision of infected tissue (e.g., lung lobe, body wall mass) may improve outcome.",
          "pdf_page": 99,
          "printed_page": 17,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Exudative fluid (thorax, abdomen, subcut aneous tissue) should be drained and the infected cavity lavaged.",
          "pdf_page": 99,
          "printed_page": 17,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "A thoracostomy tube with intermittent or continuous drainage is usually needed for cats with pyothorax; dogs may benefit from surgical exploration of thorax prior to thoracostomy tube placement to attempt foreign body removal.",
          "pdf_page": 99,
          "printed_page": 17,
          "column": 2
        }
      ],
