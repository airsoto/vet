          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Common in young dogs and cats, although it may occur at any age.",
              "pdf_page": 514,
              "printed_page": 432,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No breed or sex predilection.",
              "pdf_page": 514,
              "printed_page": 432,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Pruritus is usually present, but can be minimal.",
              "pdf_page": 514,
              "printed_page": 432,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pruritus primarily located around the ears, head, and neck; occasionally generalized.",
              "pdf_page": 514,
              "printed_page": 432,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thick, red-brown, or black otic exudate (“coffee grounds” appearance)—usually seen in the outer ear.",
              "pdf_page": 514,
              "printed_page": 432,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Otic exudate and pruritus demonstrate individual variability.",
              "pdf_page": 514,
              "printed_page": 432,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Crusting and scales may occur on the neck, rump, and tail (dogs).",
              "pdf_page": 514,
              "printed_page": 432,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Excoriations on the convex surface of the pinnae often occur, owing to the intense pruritus.",
              "pdf_page": 514,
              "printed_page": 432,
              "column": 1
            }
          ]
        },
