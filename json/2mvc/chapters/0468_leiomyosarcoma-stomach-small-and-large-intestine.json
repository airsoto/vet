        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "LMS often metastasize to liver and regional lymph nodes.",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Older case series:",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Small intestine: median survival time",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(MST) 12 months.",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Cecum: MST 7.5 months, but most died",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "of other diseases.",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Gastric: rare, high rate of metastasis,",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "short survival.",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Even dogs with metastasis can have prolonged survivals; MST 21.7 months in one study of dogs with metastatic LMS.",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "One report showed similar survival times between dogs with leiomyoma, LMS, GIST, and GIST-like tumors:",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "42 dogs, small intestinal tumors treated",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "surgically: 1- and 2-year survivals of 62.6% and 52.3%.",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "19 dogs, cecal tumors treated surgically:",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "1- and 2-year survivals of 84.2% and 66%.",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mitotic index <9 and histological grade were prognostic for survival in abdominal visceral soft tissue sarcomas (mostly spleen and small intestine).",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 3
            }
          ]
        }
      }
