      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Uncommon malignant tumor arising from smooth muscle of stomach or intestines.",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Locally invasive; metastatic rate up to 50%, usually intra-abdominal sites, especially lymph nodes and liver.",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prognosis fair to guarded.",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In large intestine the cecum is often affected.",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Analyses reclassified many leiomyosarcomas to gastrointestinal stromal tumors (GISTs) or GIST-like tumors; differentiate with immunohistochemistry.",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "True leiomyosarcomas (LMS) rare; this chapter discusses GISTs with LMS.",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 1
            }
          ]
        },
