          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Relate to GI tract.",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Stomach—vomiting; weight loss.",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Small intestine—vomiting; weight loss;",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "diarrhea; borborygmus; flatulence.",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Large intestine and rectum—tenesmus,",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "may lead to rectal prolapse; hematochezia.",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Stomach—nonspecific.",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Small intestine—may feel mid-abdominal",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "mass; sometimes distended, painful loops of",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "small bowel.",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Large intestine and rectum—may feel mass",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "per rectum.",
              "pdf_page": 905,
              "printed_page": 823,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
