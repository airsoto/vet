              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "benefit (3 complete response, 1 partial response, 1 stable disease); median progression-free survival = 110 weeks.",
              "pdf_page": 905,
              "printed_page": 823,
