        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Untreated carcinomas (all types)—median survival 3 months; epistaxis carries a worse prognosis.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Definitive radiotherapy (all carcinomas)— median survival 12–18 months (dogs and cats); 10.4 months with stereotactic radiotherapy.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Coarse-fraction radiation therapy (all tumor types)—improved clinical signs in ~90% of dogs; median survival 4.8–10 months; median survival 10–12 months (cats).",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Local recurrence with extension to the brain can occur.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Re-irradiation is possible, reduces clinical signs, extends survival time.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 3
            }
          ]
        }
      }
    },
