    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cisplatin—dogs only, 60–70 mg/m2IV q3 weeks for 4 treatments.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Carboplatin—dogs, 300 mg/m2IV q3 weeks; cats, 180–250 mg/m2IV q3–4 weeks for 4–5 treatments.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mitoxantrone—dogs/cats, 5–6 mg/m2IV q3 weeks for 4–5 treatments.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Toceranib phosphate (Palladia)—dogs/cats, 2.5–3.25 mg/kg PO q48h.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Piroxicam—0.3 mg/kg PO q24h (dogs), q48h (cats).",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 3
            }
          ]
        },
