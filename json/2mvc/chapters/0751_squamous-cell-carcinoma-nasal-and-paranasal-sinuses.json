      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Local invasion of neoplastic squamous epithelium from the nasal cavity and/or paranasal sinuses.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Slowly progressive (months) and commonly bilateral.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Low metastatic rate.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prevalence—15–17% of nasal neoplasia in cats and dogs.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1
            }
          ]
        },
