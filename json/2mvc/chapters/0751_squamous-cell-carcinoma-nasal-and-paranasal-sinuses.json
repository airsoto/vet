        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "More common in dog than in cat.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—median age, 9–10 years, male predilection; cats—median 10–12 years, male predilection.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—predilection for sinonasal tumors in medium and large breeds.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intermittent, progressive unilateral to",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "bilateral epistaxis and/or mucopurulent nasal",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "discharge.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Epiphora.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sneezing.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Halitosis.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anorexia.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dyspnea.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Seizures secondary to cribriform plate",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "invasion.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nasal discharge (epistaxis, mucopurulent,",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and/or serosanguinous).",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Facial deformity.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ocular—epiphora, decreased retropulsion,",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "elevated third eyelid, exophthalmus.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pain on nasal/paranasal sinus palpation.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Obstructed nasal airflow.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
