    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Definitive radiotherapy—best clinical control in dogs and cats; exenteration does not add benefit.",
          "pdf_page": 1369,
          "printed_page": 1287,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Coarse-fraction radiotherapy beneficial in dogs and cats for palliation.",
          "pdf_page": 1369,
          "printed_page": 1287,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Adjunctive chemotherapy—responses in dogs reported; recommended for palliation of clinical signs, metastasis, and as an adjuvant to radiation therapy.",
          "pdf_page": 1369,
          "printed_page": 1287,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Analgesics for pain control.",
          "pdf_page": 1369,
          "printed_page": 1287,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Anecdotally, nasal hydropulsion may palliate clinical signs.",
          "pdf_page": 1369,
          "printed_page": 1287,
          "column": 2
        }
      ],
