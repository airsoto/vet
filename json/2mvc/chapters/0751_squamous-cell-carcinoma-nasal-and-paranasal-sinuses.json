        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "If epistaxis, perform coagulation profile and blood pressure to rule out hypertension and coagulopathy prior to intranasal biopsy.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Skull radiography—asymmetrical osteolysis of caudal turbinates; superimposition of soft tissue mass; fluid density in the frontal sinuses; loss of teeth; displacement of midline structures; involvement of hard palate.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiography—detect pulmonary metastasis (uncommon).",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CT scan—recommended imaging modalities for the identification of soft tissue density mass, loss of turbinate detail, soft tissue/fluid opacity in sinus; best method for assessing tumor invasiveness, including bony invasion, invasion of cribriform plate or orbit.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Rhinoscopy—mass effect, may be obscured by exudates.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytology—obtained by aspiration or squash preparation; may be limited by inflammation or secondary infection.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Biopsy with histopathology—necessary for definitive diagnosis; methods include nasal hydropulsion, transnostril blind biopsy with forceps or bone curette, fiberoptic-guided biopsy, percutaneous biopsy of facial deformities; biopsy via dental extraction site, rhinotomy.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Precautions must be taken to minimize risk of penetrating the cribriform plate.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytology and/or biopsy of regional lymph nodes—detect metastatic disease (uncommon).",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
