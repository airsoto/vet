    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other intranasal neoplasia—adenocarcinoma, undifferentiated carcinoma, lymphoma (cats), sarcomas (dogs).",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tooth root abscess.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Viral infection—cats.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cryptococcosis—cats.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Aspergillosis.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Foreign body.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Trauma.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Oronasal fistula.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Coagulopathy.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypertension.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bacterial sinusitis—uncommon.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lymphocytic—plasmacytic rhinitis.",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inflammatory polyps (cats).",
              "pdf_page": 1369,
              "printed_page": 1287,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
