        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Depend on enzymatic defect.",
              "pdf_page": 655,
              "printed_page": 573,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Type Ia (Maltese puppies)—failure to thrive; mental depression; hypoglycemia; abdominal distention; hepatomegaly; death or euthanasia",
              "pdf_page": 655,
              "printed_page": 573,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "by 60 days of age.",
              "pdf_page": 655,
              "printed_page": 573,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Type II (Lapland dogs)— vomiting and regurgitation related to megaesophagus; progressive muscle weakness; cardiac changes; death before 2 years of age.",
              "pdf_page": 655,
              "printed_page": 573,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Type III (German shepherds, curly-coated retrievers)—depression; weakness; stunted; abdominal distention from hepatomegaly; mild hypoglycemia, high liver enzymes and",
              "pdf_page": 655,
              "printed_page": 573,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "creatine kinase.",
              "pdf_page": 655,
              "printed_page": 573,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Type IV (Norwegian forest cats)—perinatal death common; intermittent fever; generalized muscle tremors; muscle",
              "pdf_page": 655,
              "printed_page": 573,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "atrophy, weakness progressing to tetraplegia; sudden death from myocardial degeneration and terminal dysrhythmia; glucose administration can enable cats to survive to",
              "pdf_page": 655,
              "printed_page": 573,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "adulthood.",
              "pdf_page": 655,
              "printed_page": 573,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Type VII (English springer spaniels)—compensated hemolytic anemia; episodic weakness, exercise-induced with intravascular hemolysis; hemoglobinuria; one patient with a progressive myopathy at 11 years of age: no liver effect.",
              "pdf_page": 655,
              "printed_page": 573,
              "column": 2
            }
          ]
        },
