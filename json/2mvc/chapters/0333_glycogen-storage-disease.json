          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Type Ia—emaciation; massive hepatomegaly due to hepatocyte glycogen and lipid vacuolation and similar change in renal",
              "pdf_page": 655,
              "printed_page": 573,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "tubular epithelium.",
              "pdf_page": 655,
              "printed_page": 573,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Type II—glycogen accumulation in skeletal, smooth, and cardiac",
              "pdf_page": 655,
              "printed_page": 573,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "muscle.",
              "pdf_page": 655,
              "printed_page": 573,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Type III—hepatomegaly due to hepatic glycogen accumulation; also in",
              "pdf_page": 655,
              "printed_page": 573,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "skeletal muscle.",
              "pdf_page": 655,
              "printed_page": 573,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Type IV—generalized muscle atrophy; glycogen accumulation: skeletal muscle, CNS, and peripheral nervous",
              "pdf_page": 655,
              "printed_page": 573,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "system.",
              "pdf_page": 655,
              "printed_page": 573,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Type VII—polysaccharide deposits in skeletal muscle.",
              "pdf_page": 655,
              "printed_page": 573,
              "column": 3
            }
          ]
        }
      }
    },
