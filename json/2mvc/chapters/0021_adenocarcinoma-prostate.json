        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs and rarely cats.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Medium- to large-breed intact or neutered male dogs.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Median age of 9–10 years.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tenesmus (with the production of",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "ribbon-like stool).",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Weight loss.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Stranguria and dysuria.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rear limb lameness.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lethargy.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exercise intolerance.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "A firm, asymmetric, and immobile prostate",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "gland.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prostatomegaly is common, but is not",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "always present.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pain may be elicited in response to",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "abdominal or rectal palpation.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Caudal abdominal mass, cachexia, pyrexia,",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and dyspnea may also be identified.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
