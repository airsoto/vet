        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Neutered males are at increased risk for prostatic neoplasia.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other primary neoplasia (i.e., squamous cell carcinoma, transitional cell carcinoma).",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metastatic or locally invasive neoplasia (i.e., transitional cell carcinoma).",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute or chronic prostatitis, benign prostatic hypertrophy, and prostatic cysts are possible differentials in intact male dogs, but are highly unlikely in neutered dogs.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Inflammatory leukogram possible.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Alkaline phosphatase may be high.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Postrenal azotemia may be present if urethral obstruction exists.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "It is prudent to evaluate urine samples via cystocentesis and free-catch techniques, as hematuria, pyuria, and malignant epithelial cells may be observed in free-catch samples, but are unusual in samples obtained by cystocentesis.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Serum and seminal plasma markers such as acid phosphatase, prostate-specific antigen, and canine prostate-specific esterase are not elevated in dogs with PAC.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiography—metastases may appear as pulmonary nodules or increased interstitial markings.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal radiography—sublumbar lymphadenomegaly, mineralization of the prostate, and lytic lesions to the lumbar vertebrae or pelvis may be seen.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal ultrasonography—focal to multifocal hyperechogenicity with asymmetry and irregular prostatic outline, ± prostatic mineralization.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Contrast cystography may help differentiate prostatic from urinary bladder disease.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Prostatic aspirate (percutaneous or transrectal).",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prostatic wash.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prostatic biopsy performed percutaneously or surgically.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Percutaneous biopsy has been associated with tumor seeding along the biopsy tract.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
