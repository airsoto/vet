              "printed_page": 35,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pain relief with nonsteroidal anti-inflammatory drugs (NSAIDs), morphine-derived drugs.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Stool softeners to relieve tenesmus.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 2
            }
