  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Prostatic adenocarcinoma (PAC) is a malignant tumor that occurs in both neutered and intact male dogs.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Although this neoplasm represents <1% of all canine malignancies, it is the most common prostatic disorder in neutered male dogs.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metastases to regional lymph nodes, lungs, and the lumbosacral skeleton are common.",
              "pdf_page": 117,
              "printed_page": 35,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
