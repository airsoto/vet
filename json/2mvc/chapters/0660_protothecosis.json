    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Amphotericin B—use for localized disease after surgical excision; 0.25–0.5 mg/kg IV three times weekly until 8 mg/kg cumulative dose; lipid formulation 1 mg/kg every other day until 12 mg/kg cumulative dose.",
              "pdf_page": 1223,
              "printed_page": 1141,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Concurrent administration of tetracycline or amikacin may provide synergistic effect.",
              "pdf_page": 1223,
              "printed_page": 1141,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Itraconazole 5–10 mg/kg PO twice daily— used with amphotericin B, or as sole agents for less life-threatening disease.",
              "pdf_page": 1223,
              "printed_page": 1141,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Clotrimazole.",
              "pdf_page": 1223,
              "printed_page": 1141,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Potassium iodide.",
              "pdf_page": 1223,
              "printed_page": 1141,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Amphotericin B cream or clotrimazole",
              "pdf_page": 1223,
              "printed_page": 1141,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "enemas for colitis.",
              "pdf_page": 1223,
              "printed_page": 1141,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nystatin 100,000– 150,000 IU PO q8h for at least 90 days.",
              "pdf_page": 1223,
              "printed_page": 1141,
              "column": 3
            }
          ]
        },
