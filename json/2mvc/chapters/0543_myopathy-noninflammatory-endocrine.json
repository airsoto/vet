        "ACTIVITY": {
          "present": true,
          "status": "content",
          "source_heading": "ACTIVITY",
          "canonical_heading": "ACTIVITY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical corticosteroid myopathy (humans)— inactivity worsens condition; increased muscle activity may partially prevent atrophy.",
              "pdf_page": 1023,
              "printed_page": 941,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Physical therapy—may help prevent and treat muscle weakness and wasting in dogs receiving glucocorticoids.",
              "pdf_page": 1023,
              "printed_page": 941,
              "column": 3
            }
          ]
        },
        "DIET": {
          "present": true,
          "status": "content",
          "source_heading": "DIET",
          "canonical_heading": "DIET",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Regurgitation and megaesophagus—feed from an elevation.",
              "pdf_page": 1023,
              "printed_page": 941,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dysphagia and esophageal dilation—give food with the best-tolerated consistency.",
              "pdf_page": 1023,
              "printed_page": 941,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gastric feeding tube—if oral feeding is not tolerated.",
              "pdf_page": 1023,
              "printed_page": 941,
              "column": 3
