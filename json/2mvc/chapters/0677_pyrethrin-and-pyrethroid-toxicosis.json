        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "More frequently in cats; small dogs; and young, old, sick, anemic, or debilitated animals.",
              "pdf_page": 1252,
              "printed_page": 1170,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Result from immune-mediated allergic hypersensitivity and anaphylactic reactions, genetic-based idiosyncratic reactions, and",
              "pdf_page": 1252,
              "printed_page": 1170,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "neurotoxic reactions.",
              "pdf_page": 1252,
              "printed_page": 1170,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mild—hypersalivation; paw flicking; ear twitching; mild depression;",
              "pdf_page": 1252,
              "printed_page": 1170,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "vomiting; diarrhea.",
              "pdf_page": 1252,
              "printed_page": 1170,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Moderate—protracted vomiting and diarrhea; marked depression;",
              "pdf_page": 1252,
              "printed_page": 1170,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "ataxia; muscle tremors.",
              "pdf_page": 1252,
              "printed_page": 1170,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Extreme dermal or oral overdose—may produce seizures or death.",
              "pdf_page": 1252,
              "printed_page": 1170,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—sensitive to pyrethroids. Cats inappropriately treated with permethrincontaining products for use on dogs, often develop muscle tremors, ataxia, seizures, hyperthermia, and death within hours if not",
              "pdf_page": 1252,
              "printed_page": 1170,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "treated.",
              "pdf_page": 1252,
              "printed_page": 1170,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs may develop tremors following exposure to liquid or granular lawn products",
              "pdf_page": 1252,
              "printed_page": 1170,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "containing bifenthrin.",
              "pdf_page": 1252,
              "printed_page": 1170,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Allergic reactions— urticaria; hyperemia; pruritus; anaphylaxis; shock; respiratory distress; (rarely) death.",
              "pdf_page": 1252,
              "printed_page": 1170,
              "column": 1
            }
          ]
        },
