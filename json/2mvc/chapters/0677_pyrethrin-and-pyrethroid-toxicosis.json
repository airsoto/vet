          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—more sensitive; less-efficient metabolic pathways, combined with grooming habits. Direct contact with permethrin spot-on treated",
              "pdf_page": 1252,
              "printed_page": 1170,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "dogs.",
              "pdf_page": 1252,
              "printed_page": 1170,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Patients with subnormal body temperatures after bathing, anesthesia, or sedation—predisposed to clinical signs.",
              "pdf_page": 1252,
              "printed_page": 1170,
              "column": 1
            }
          ]
        }
      }
