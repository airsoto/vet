        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Visual examination of the clean, dry tooth surface under good light and with the aid of magnification.",
              "pdf_page": 447,
              "printed_page": 365,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exploration with a sharp dental explorer— the explorer will sink into carious dentin and stick, providing the sensation of “tug-back” upon withdrawal.",
              "pdf_page": 447,
              "printed_page": 365,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Subgingival exploration—reveals irregularities in the root surface.",
              "pdf_page": 447,
              "printed_page": 365,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Caries detection dyes have been used by human and veterinary dentists to aid in the differentiation between sound and carious dentinal tissue. However, their use may lead to false-positive results and overtreatment through the removal of excess tissue. Reliance on visual, tactile, and radiographic findings is preferable.",
              "pdf_page": 447,
              "printed_page": 365,
              "column": 1
            }
          ]
        },
