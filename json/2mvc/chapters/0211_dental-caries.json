    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Examine and radiograph treated teeth 6 months postoperatively, then annually or as the opportunity presents.",
              "pdf_page": 447,
              "printed_page": 365,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Evaluate the integrity of the restorations, assess for further decay at the margins or under the restorations, assess for the development of endodontic disease.",
              "pdf_page": 447,
              "printed_page": 365,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "As affected individuals frequently have more than one caries, examine all teeth",
              "pdf_page": 447,
              "printed_page": 365,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "carefully (clinically and radiographically) at any opportunity to monitor for the development of new lesions.",
              "pdf_page": 447,
              "printed_page": 365,
              "column": 3
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Avoidance of diet and treats high in refined carbohydrates may reduce the risk of the development of further caries.",
              "pdf_page": 447,
              "printed_page": 365,
              "column": 3
            }
          ]
        },
        "POSSIBLE COMPLICATIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": []
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "If a lesion has been properly debrided and restored it should have an excellent prognosis. Appropriate staging and case selection, thorough removal of all carious tissues, and adherence to restorative principles are essential.",
              "pdf_page": 447,
              "printed_page": 365,
              "column": 3
            }
          ]
        }
      }
