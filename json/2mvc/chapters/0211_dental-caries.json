      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Postoperative broad-spectrum antibiotics— may be indicated if there is pulp involvement necessitating endodontic treatment or extraction.",
              "pdf_page": 447,
              "printed_page": 365,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Postoperative analgesia with nonsteroidal anti-inflammatory drugs and/or narcotics is indicated following endodontic or exodontic treatment or extensive restorative work of vital teeth.",
              "pdf_page": 447,
              "printed_page": 365,
              "column": 2
            }
          ]
