        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Stress or stimulus (trauma) at time of development can alter tooth formation.",
              "pdf_page": 1424,
              "printed_page": 1342,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infection, trauma to tooth buds, or traumatic extraction of deciduous teeth during permanent tooth formation can significantly alter the structure.",
              "pdf_page": 1424,
              "printed_page": 1342,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Genetic or familial tendencies not known for most conditions.",
              "pdf_page": 1424,
              "printed_page": 1342,
              "column": 1
            }
          ]
        },
