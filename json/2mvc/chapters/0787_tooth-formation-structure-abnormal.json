        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Fusion—fused crown will be larger than a single tooth. There will be a reduced number of teeth (two counted as one).",
              "pdf_page": 1424,
              "printed_page": 1342,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gemination tooth—actual number of teeth will be unaltered, but one tooth will be larger, with duplication of part of the crown (and possibly roots radiographically); “Siamese twin.”",
              "pdf_page": 1424,
              "printed_page": 1342,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dilacerated teeth:",
              "pdf_page": 1424,
              "printed_page": 1342,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Any variation in structure or form—extra",
              "pdf_page": 1424,
              "printed_page": 1342,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "root, curved root.",
              "pdf_page": 1424,
              "printed_page": 1342,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Each tooth must be evaluated for",
              "pdf_page": 1424,
              "printed_page": 1342,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "integrity of the pulp system, as any disruption in the continuity of the crown and roots may result in exposure of the pulp to the external environment.",
              "pdf_page": 1424,
              "printed_page": 1342,
              "column": 1
            }
          ]
        },
