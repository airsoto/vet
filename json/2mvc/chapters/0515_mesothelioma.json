        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Prognosis—variable and anecdotal:",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Intracavitary cisplatin (dogs)—range 8",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "months to >3 years.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Intracavitary carboplatin (cats) with",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "piroxicam—6 months.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Surgery and intracavitary cisplatin and",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "IV doxorubicin—>27 months.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Reported survival with surgery alone—",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "4–9 months.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 2
            }
          ]
        }
      }
    },
    "MISCELLANEOUS": {
