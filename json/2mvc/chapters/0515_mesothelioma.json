    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Pericardiectomy or mass removal if possible.",
          "pdf_page": 981,
          "printed_page": 899,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Symptomatic pericardiocentesis or thoracocentesis.",
          "pdf_page": 981,
          "printed_page": 899,
          "column": 2
        }
      ],
