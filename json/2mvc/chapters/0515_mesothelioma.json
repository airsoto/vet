  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Rare tumor in dogs and cats arising from the mesothelial cells of the serosal lining of the pleural, pericardial, or peritoneal cavities.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Also has been reported in dogs to arise from the tunica vaginalis of the testes.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
