          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Older animals—dog and cat.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sclerosing subtype more common in males.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "German shepherd dogs overrepresented.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Pleural effusion—dyspnea, tachypnea, exercise intolerance, coughing, gagging, cyanosis.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pericardial effusion—lethargy, anorexia, weakness, collapse, respiratory distress, exercise intolerance, distended abdomen, vomiting.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ascites—distended abdomen, anorexia, vomiting, lethargy, abdominal discomfort.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Swollen testes.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sclerosing subtype signs are secondary to restriction around affected organs—vomiting, urinary issues.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Increased risk with asbestos exposure.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Possible increased risk in golden retrievers with idiopathic hemorrhagic pericardial effusion.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Other causes of effusions—hypoproteinemia, vasculitis, neoplasia (e.g., lymphoma, chemodectomas, hemangiosarcoma, carcinomatosis), idiopathic, congestive heart failure, liver disease, infectious/inflammatory.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "not_applicable",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "N/A",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": []
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiography—identification of pleural effusion, evaluation of cardiac silhouette (i.e., globoid heart consistent with pericardial effusion).",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Echocardiography—identification of pericardial effusion; rule out primary cardiac neoplasia.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic and abdominal ultrasonography— evaluation of effusions.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CT—identification of mass lesions and evaluation of lungs in the face of pleural effusion.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 1
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytology of effusions to rule out infectious causes or lymphoma—difficult to diagnose mesothelioma on cytology as mesothelial cells",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "are typically shed into effusions and can be highly reactive.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exploratory surgery (open or via thoracoscopic or laparoscopic examination) with biopsies.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fibronectin levels in effusions—not specific for mesothelioma but typically elevated in neoplastic effusions.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": false,
