        },
        "CONTRAINDICATIONS/POSSIBLE INTERACTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Chemotherapy can cause gastrointestinal, bone marrow, cardiac, and other toxicities— seek advice if unfamiliar with cytotoxic drugs.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cisplatin in particular is nephrotoxic. Do not use in cats; causes fatal pulmonary edema.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 2
            }
          ]
        },
        "ALTERNATIVE DRUG(S)": {
          "present": false,
          "status": "missing",
