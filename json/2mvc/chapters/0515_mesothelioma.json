    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Intracavitary chemotherapy:",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Cisplatin (dog only) 50–70 mg/m2every",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "3 weeks with saline diuresis.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Carboplatin (cat) 180–200 mg/m2every",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "3–4 weeks.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Carboplatin (dog) 300 mg/m2every 3 weeks.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Mitoxantrone (dog) 5.0–5.5 mg/m2every",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "3 weeks.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "IV chemotherapy—doxorubicin 30 mg/m2 (dog >10 kg) or 1 mg/kg (dog <10 kg or cat), or mitoxantrone (4.5–5.5 mg/m2dog and cat) once every 3 weeks.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 2
            }
          ]
        },
