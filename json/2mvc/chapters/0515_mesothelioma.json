          "type": "paragraph",
          "level": 0,
          "text": "It is not recommended to breed animals with cancer. Chemotherapy is teratogenic—do not give to pregnant animals.",
          "pdf_page": 981,
          "printed_page": 899,
          "column": 3
        }
