    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Blood tests—especially CBC to monitor for bone marrow suppression secondary to chemotherapy and renal values to monitor for renal toxicity if treating with cisplatin.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Serial thoracic radiography and/or ultra sounds of heart, thoracic cavity, or abdominal cavity to monitor for recurrence of effusions and to monitor tumor response.",
              "pdf_page": 981,
              "printed_page": 899,
              "column": 2
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": false,
          "status": "missing",
