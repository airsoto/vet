        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": ">22 months. Lesions may vary in appearance depending on",
              "pdf_page": 1370,
              "printed_page": 1288,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Strontium-90 plesiotherapy (cats, superficial)— stage of disease in cats; typically ulcerative in 98% response rate; median progression-free cats; more likely proliferative in dogs. interval of 4.5 years; median survival >8 years.",
              "pdf_page": 1370,
              "printed_page": 1288,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Photodynamic therapy (cats, superficial)— 96% response rate; often need multiple treatments; does not appear as effective as",
              "pdf_page": 1370,
              "printed_page": 1288,
              "column": 2
            }
          ]
        }
      }
