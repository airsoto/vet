              "level": 0,
              "text": "Prostatic abscess—distinguished by ultrasound and semen culture.",
              "pdf_page": 1213,
              "printed_page": 1131,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Distended urinary bladder—distinguished by cystocentesis, imaging.",
              "pdf_page": 1213,
              "printed_page": 1131,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Caudal abdominal mass of undetermined origin—distinguished by imaging.",
              "pdf_page": 1213,
              "printed_page": 1131,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
