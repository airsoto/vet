        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Male intact dogs; rare occurrence in castrated dogs.",
              "pdf_page": 1213,
              "printed_page": 1131,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Age range 2–12 years, mean age 8 years.",
              "pdf_page": 1213,
              "printed_page": 1131,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Large dogs more commonly affected than small dogs.",
              "pdf_page": 1213,
              "printed_page": 1131,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Asymptomatic.",
              "pdf_page": 1213,
              "printed_page": 1131,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lethargy and anorexia.",
              "pdf_page": 1213,
              "printed_page": 1131,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal distention.",
              "pdf_page": 1213,
              "printed_page": 1131,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tenesmus if the cyst compresses the rectum.",
              "pdf_page": 1213,
              "printed_page": 1131,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dysuria if the cyst compresses the urethra.",
              "pdf_page": 1213,
              "printed_page": 1131,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sanguinous urethral discharge in the presence of BPH.",
              "pdf_page": 1213,
              "printed_page": 1131,
              "column": 1
            }
          ]
        },
