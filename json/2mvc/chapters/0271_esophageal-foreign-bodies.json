              "level": 0,
              "text": "Esophageal Stricture. is fed to the pet.",
              "pdf_page": 548,
              "printed_page": 466,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Regurgitation.",
              "pdf_page": 548,
