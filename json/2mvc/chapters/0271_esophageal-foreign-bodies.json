    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Examine the esophagus closely via endoscopy for mucosal damage after foreign body removal.",
              "pdf_page": 548,
              "printed_page": 466,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mild erythema/erosions are not uncommon and tend to heal uneventfully.",
              "pdf_page": 548,
              "printed_page": 466,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If an esophageal laceration/perforation is detected—gastrostomy tube feedings allow esophageal rest and healing.",
              "pdf_page": 548,
              "printed_page": 466,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Advise post-procedural survey thoracic radiographs to assess for pneumomediastinum/pneumothorax.",
              "pdf_page": 548,
              "printed_page": 466,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Monitor at least 2–3 weeks for evidence of stricture formation.",
              "pdf_page": 548,
              "printed_page": 466,
              "column": 1
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Esophageal Diverticula. Carefully monitor the environment and what",
