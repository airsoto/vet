        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Esophagoscopy allows removal of most (80%) foreign bodies using retrieval forceps. It also allows for visual inspection of the mucosa for trauma after foreign body removal. Use of an endoscope with an accessory channel diameter of >2.8 mm will allow use of the largest types of retrieval forceps.",
              "pdf_page": 547,
              "printed_page": 465,
              "column": 2
            }
          ]
        },
