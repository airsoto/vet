          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Ingestion of foreign material or foodstuffs too large to pass through the esophagus, causing partial or complete luminal obstruction.",
              "pdf_page": 547,
              "printed_page": 465,
              "column": 1
            }
          ]
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Esophageal foreign bodies cause mechanical obstruction, mucosal inflammation with edema, and possibly ischemic necrosis and esophageal perforation.",
              "pdf_page": 547,
              "printed_page": 465,
              "column": 1
            }
          ]
        },
