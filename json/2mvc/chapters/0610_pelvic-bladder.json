        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal radiographs may reveal a caudally displaced bladder, but this should be interpreted carefully without bladder distension.",
              "pdf_page": 1136,
              "printed_page": 1054,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Excretory urography may allow visualization of the kidneys, ureteral terminations, urinary bladder, and urethra but does not provide",
              "pdf_page": 1136,
              "printed_page": 1054,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "bladder distension. Without bladder distension, interpretation of bladder neck location should be made with caution.",
              "pdf_page": 1136,
              "printed_page": 1054,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Retrograde vaginourethography or urethrocystography allows visualization of the",
              "pdf_page": 1136,
              "printed_page": 1054,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "than DES. Estrogenic effects may also be seen.",
              "pdf_page": 1136,
              "printed_page": 1054,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neurologic exam should be normal.",
              "pdf_page": 1136,
              "printed_page": 1054,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urodynamic procedures—consider cystometrography and urethral pressure profilometry to evaluate urinary bladder and urethral function, as well as urethral length.",
              "pdf_page": 1136,
              "printed_page": 1054,
              "column": 2
            }
          ]
        },
