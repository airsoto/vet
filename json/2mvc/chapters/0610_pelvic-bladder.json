          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs and rarely cats.",
              "pdf_page": 1136,
              "printed_page": 1054,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Primarily young female dogs (<1 year of age).",
              "pdf_page": 1136,
              "printed_page": 1054,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "May be asymptomatic.",
              "pdf_page": 1136,
              "printed_page": 1054,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Incontinence can be continuous or intermittent.",
              "pdf_page": 1136,
              "printed_page": 1054,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Conscious voiding patterns often present.",
              "pdf_page": 1136,
              "printed_page": 1054,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Perineum stained/soaked with urine, urine scalding, wet vulva/prepuce.",
              "pdf_page": 1136,
              "printed_page": 1054,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urgency with small volume elimination may be seen.",
              "pdf_page": 1136,
              "printed_page": 1054,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "The position of the bladder in incontinent female dogs has been shown to be more intrapelvic and associated with a shorter urethral length, suggesting that an intrapelvic bladder neck and a short urethra together encourage urinary incontinence. It is hypothesized that this could result from an unbalanced distribution of the pressure exerted by the abdominal organs between the bladder and urethra.",
              "pdf_page": 1136,
              "printed_page": 1054,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Urinary incontinence—ectopic ureter, USMI, inappropriate urination, urge incontinence, urinary tract infection (UTI), neurogenic incontinence, overflow incontinence.",
              "pdf_page": 1136,
              "printed_page": 1054,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Often associated with ectopic ureters.",
              "pdf_page": 1136,
              "printed_page": 1054,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "CBC and biochemistry typically unremarkable.",
              "pdf_page": 1136,
              "printed_page": 1054,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urinalysis may reveal evidence of a UTI (including pyuria, bacteriuria, and hematuria) or polyuria (urine specific gravity [USG] <1.035).",
              "pdf_page": 1136,
              "printed_page": 1054,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urine culture and sensitivity via a cystocentesis should be performed.",
              "pdf_page": 1136,
              "printed_page": 1054,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
