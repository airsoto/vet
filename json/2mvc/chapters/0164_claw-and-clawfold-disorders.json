    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Onychomycosis—griseofulvin (50–150 mg/kg PO/day) or ketoconazole (5–l0 mg/kg PO q12h) for 6–12 months until negative cultures; itraconazole (10 mg/kg PO q24h) for 3 weeks and then pulse therapy until resolved.",
          "pdf_page": 365,
          "printed_page": 283,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Onychomadesis—determined by cause; immunomodulation therapy for immunemediated diseases (e.g., SLO); options include essential fatty acid supplementation; cycline antibiotics: tetracycline 250 mg PO TID for dogs <10 kg; 500 mg PO TID dogs >10 kg); doxycycline 10 mg/kg PO q24h; minocycline 5 mg/kg PO BID, often administered with niacinamide 250 mg PO for dogs <10 kg and 500 mg PO for dogs >10 kg; pentoxifylline 10–15 mg/kg PO BID to TID; corticosteroids and cyclosporine 5 mg/kg PO q24h; vitamin E; appropriate chemotherapeutic agents (e.g., azathioprine, chlorambucil).",
          "pdf_page": 365,
          "printed_page": 283,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Nonsteroidal anti-inflammatory drugs (NSAIDs) or tramadol if pain is present.",
          "pdf_page": 365,
          "printed_page": 283,
          "column": 1
        }
      ],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "usually have other skin lesions in addition to",
              "pdf_page": 364,
              "printed_page": 282,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bacterial paronychia—systemic antibiotics claw or ungual fold lesions. based on culture and sensitivity.",
              "pdf_page": 364,
              "printed_page": 282,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Yeast paronychia—CandidaorMalassezia",
              "pdf_page": 364,
              "printed_page": 282,
              "column": 2
            }
          ]
        },
        "CONTRAINDICATIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CONTRAINDICATIONS",
          "content_blocks": []
        },
        "PRECAUTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "PRECAUTIONS",
          "canonical_heading": "PRECAUTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Griseofulvin—teratogenic; may cause bone marrow suppression, anorexia, vomiting, and diarrhea; absorption enhanced if given with a high-fat meal.",
              "pdf_page": 365,
              "printed_page": 283,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ketoconazole—avoid use in cats; may cause anorexia, gastric irritation, hepatic toxicity, and lightening of the hair coat.",
              "pdf_page": 365,
              "printed_page": 283,
              "column": 1
            }
          ]
        },
