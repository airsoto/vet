        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Slow claw growth cycle may require 6–8 months of therapy to fully correct an abnormality; improvement may be noted after 6–8 weeks of appropriate treatment.",
              "pdf_page": 365,
              "printed_page": 283,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bacterial or yeast paronychia and onychomycosis—treatment may be prolonged and response may be influenced by underlying factors; weight reduction in obese patients.",
              "pdf_page": 365,
              "printed_page": 283,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Onychorrhexis—may require amputation of the third phalanx for resolution.",
              "pdf_page": 365,
              "printed_page": 283,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Onychomadesis—prognosis determined by underlying cause; immune-mediated diseases and vascular problems carry a more guarded prognosis than do trauma or infectious causes.",
              "pdf_page": 365,
              "printed_page": 283,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neoplasia—excised by amputation of the digit; malignant tumors metastasize by the time of diagnosis.",
              "pdf_page": 365,
              "printed_page": 283,
              "column": 2
            }
          ]
        }
      }
