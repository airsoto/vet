          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Esophageal strictures and gastrointestinal disease have been reported in cats following doxycycline administration.",
              "pdf_page": 689,
              "printed_page": 607,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fluroquinolones, including marbofloxacin, may cause arthropathy in young dogs and retinotoxicity in cats.",
              "pdf_page": 689,
              "printed_page": 607,
              "column": 3
            }
          ]
        },
