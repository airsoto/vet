    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Doxycycline (5 mg/kg PO q12h) should be given for minimum of 4 weeks.",
              "pdf_page": 689,
              "printed_page": 607,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If PCR remains positive or bacteremia reoccurs after doxycycline therapy, antibiotic treatment should be switched to marbofloxacin (2 mg/kg PO q24h) for 2 weeks.",
              "pdf_page": 689,
              "printed_page": 607,
              "column": 3
            }
          ]
        },
