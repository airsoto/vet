        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Routine blood stains (e.g., Wright-Giemsa) to identify organisms in blood films.",
              "pdf_page": 689,
              "printed_page": 607,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Organism may detach from RBCs in stored blood anticoagulated with EDTA.",
              "pdf_page": 689,
              "printed_page": 607,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reticulocyte stains cannot be used to",
              "pdf_page": 689,
              "printed_page": 607,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "identifyMycoplasmaorganisms because",
              "pdf_page": 689,
              "printed_page": 607,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "punctate reticulocytes in cats appear similar",
              "pdf_page": 689,
              "printed_page": 607,
              "column": 2,
              "subheading": "identifyMycoplasmaorganisms because"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "to the parasites.",
              "pdf_page": 689,
              "printed_page": 607,
              "column": 2,
              "subheading": "identifyMycoplasmaorganisms because"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Organisms must be differentiated from",
              "pdf_page": 689,
              "printed_page": 607,
              "column": 2,
              "subheading": "identifyMycoplasmaorganisms because"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "precipitated stain, refractile drying, or fixation",
              "pdf_page": 689,
              "printed_page": 607,
              "column": 2,
              "subheading": "identifyMycoplasmaorganisms because"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "artifacts, poorly staining Howell-Jolly bodies,",
              "pdf_page": 689,
              "printed_page": 607,
              "column": 2,
              "subheading": "identifyMycoplasmaorganisms because"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and basophilic stippling.",
              "pdf_page": 689,
              "printed_page": 607,
              "column": 2,
              "subheading": "identifyMycoplasmaorganisms because"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Feline organisms—small blue-staining cocci,",
              "pdf_page": 689,
              "printed_page": 607,
              "column": 3,
              "subheading": "identifyMycoplasmaorganisms because"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "rings, or rods on RBCs, often many parasites",
              "pdf_page": 689,
              "printed_page": 607,
              "column": 3,
              "subheading": "identifyMycoplasmaorganisms because"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "forM. haemofelis; small rods or coccoid",
