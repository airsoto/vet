    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Without therapy, mortality withM. haemofelisinfection may reach 30% in cats.",
          "pdf_page": 689,
          "printed_page": 607,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Outpatient treatment unless severely anemic or moribund.",
          "pdf_page": 689,
          "printed_page": 607,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Blood transfusions required when anemia is considered life-threatening.",
          "pdf_page": 689,
          "printed_page": 607,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Shock should be treated with IV administration of isotonic crystalloid fluids, with or without glucose supplementation.",
          "pdf_page": 689,
          "printed_page": 607,
          "column": 3
        }
      ],
