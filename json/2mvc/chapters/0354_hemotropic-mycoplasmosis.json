          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog and cat.",
              "pdf_page": 689,
              "printed_page": 607,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute disease most common in young cats, chronic form most common in adults.",
              "pdf_page": 689,
              "printed_page": 607,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "More common in outdoor and male cats.",
              "pdf_page": 689,
              "printed_page": 607,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute disease in splenectomized dogs, chronic disease in nonsplenectomized dogs.",
              "pdf_page": 689,
              "printed_page": 607,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Kennel-raised beagles at increased risk for infection.",
              "pdf_page": 689,
              "printed_page": 607,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No sex prevalence in dogs.",
              "pdf_page": 689,
              "printed_page": 607,
              "column": 1
            }
          ]
        },
