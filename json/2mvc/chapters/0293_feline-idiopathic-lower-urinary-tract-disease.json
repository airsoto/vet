          "source_heading": "INCIDENCE/PREVALENCE",
          "canonical_heading": "INCIDENCE/PREVALENCE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Incidence of hematuria, dysuria, and/or urethral obstruction (UO) in domestic cats has been previously reported to be ~0.5–1% per year.",
              "pdf_page": 586,
              "printed_page": 504,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hospital morbidity rate for FIC in cats with lower urinary tract signs is ~65%; it is the single most common cause of lower urinary tract signs in cats.",
              "pdf_page": 586,
              "printed_page": 504,
              "column": 1
            }
          ]
        },
