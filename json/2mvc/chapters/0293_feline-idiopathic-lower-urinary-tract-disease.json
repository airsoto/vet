          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Do not perform perineal urethrostomy to minimize recurrent UO without localizing obstructive disease to penile urethra by contrast urethrography.",
              "pdf_page": 587,
              "printed_page": 505,
              "column": 1
            }
          ]
        },
