          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Phimosis—inability to protrude the penis beyond the preputial orifice.",
              "pdf_page": 1127,
              "printed_page": 1045,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Paraphimosis—inability for exteriorized penis to retract into the sheath.",
              "pdf_page": 1127,
              "printed_page": 1045,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Priapism—prolonged extrusion of an erect penis not associated with sexual arousal.",
              "pdf_page": 1127,
              "printed_page": 1045,
              "column": 1
            }
          ]
        },
