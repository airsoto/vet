        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Penile blood-gas analysis differentiates forms of priapism:",
              "pdf_page": 1127,
              "printed_page": 1045,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Ischemic (i.e., veno-occlusive)—pH",
              "pdf_page": 1127,
              "printed_page": 1045,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "<7.25, Po2<30 mmHg, Pco2>60 mmHg; may respond to phenylephrine therapy (see Medications).",
              "pdf_page": 1127,
              "printed_page": 1045,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Nonischemic (i.e., arterial)—pH of 7.4,",
              "pdf_page": 1127,
              "printed_page": 1045,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Po2>90 mmHg, Pco2<40 mmHg.",
              "pdf_page": 1127,
              "printed_page": 1045,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": false,
