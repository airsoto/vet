        {
          "type": "paragraph",
          "level": 0,
          "text": "orifice patency for urine flow required if urinary",
          "pdf_page": 1127,
          "printed_page": 1045,
          "column": 2,
          "subheading": "Paraphimosis and Priapism"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "catheter not maintained); surgically enlarge",
          "pdf_page": 1127,
          "printed_page": 1045,
          "column": 2,
          "subheading": "Paraphimosis and Priapism"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "preputial orifice, if necessary.",
          "pdf_page": 1127,
          "printed_page": 1045,
          "column": 2,
          "subheading": "Paraphimosis and Priapism"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Recurrent paraphimosis may require",
          "pdf_page": 1127,
          "printed_page": 1045,
          "column": 2,
          "subheading": "Paraphimosis and Priapism"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "phallopexy.",
          "pdf_page": 1127,
          "printed_page": 1045,
          "column": 2,
          "subheading": "Paraphimosis and Priapism"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Aspiration of penile blood may provide",
