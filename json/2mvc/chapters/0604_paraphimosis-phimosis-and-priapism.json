        },
        {
          "type": "subheading",
          "level": 0,
          "text": "Paraphimosis and Priapism",
          "pdf_page": 1127,
          "printed_page": 1045,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Main goal—detumesce (priapism) and",
          "pdf_page": 1127,
          "printed_page": 1045,
          "column": 2,
          "subheading": "Paraphimosis and Priapism"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "replace the penis within the prepuce.",
          "pdf_page": 1127,
          "printed_page": 1045,
          "column": 2,
          "subheading": "Paraphimosis and Priapism"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Castration not effective; not testosterone-",
          "pdf_page": 1127,
          "printed_page": 1045,
          "column": 2,
          "subheading": "Paraphimosis and Priapism"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "dependent.",
          "pdf_page": 1127,
          "printed_page": 1045,
          "column": 2,
          "subheading": "Paraphimosis and Priapism"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "At times only lubrication required",
          "pdf_page": 1127,
          "printed_page": 1045,
          "column": 2,
          "subheading": "Paraphimosis and Priapism"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "(paraphimosis).",
          "pdf_page": 1127,
          "printed_page": 1045,
          "column": 2,
          "subheading": "Paraphimosis and Priapism"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Penile amputation and urethrostomy",
          "pdf_page": 1127,
          "printed_page": 1045,
          "column": 2,
          "subheading": "Paraphimosis and Priapism"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "required if excessive damage present.",
          "pdf_page": 1127,
          "printed_page": 1045,
          "column": 2,
          "subheading": "Paraphimosis and Priapism"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "If urethral patency is in question place an",
          "pdf_page": 1127,
          "printed_page": 1045,
          "column": 2,
          "subheading": "Paraphimosis and Priapism"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "indwelling urinary catheter.",
          "pdf_page": 1127,
          "printed_page": 1045,
          "column": 2,
          "subheading": "Paraphimosis and Priapism"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Under sedation, apply firm pressure wrap",
          "pdf_page": 1127,
          "printed_page": 1045,
          "column": 2,
          "subheading": "Paraphimosis and Priapism"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "soaked with hypertonic glucose solution",
          "pdf_page": 1127,
          "printed_page": 1045,
          "column": 2,
          "subheading": "Paraphimosis and Priapism"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "(decrease edema), firmly replace within prepuce",
          "pdf_page": 1127,
          "printed_page": 1045,
          "column": 2,
          "subheading": "Paraphimosis and Priapism"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "once able; temporary preputial stay sutures may",
          "pdf_page": 1127,
          "printed_page": 1045,
          "column": 2,
          "subheading": "Paraphimosis and Priapism"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "be required for continued reduction (preputial",
