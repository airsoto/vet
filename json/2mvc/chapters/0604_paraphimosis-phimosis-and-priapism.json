          "level": 0,
          "text": "analgesia and prove diagnostic (blood gas",
          "pdf_page": 1127,
          "printed_page": 1045,
          "column": 2,
          "subheading": "Paraphimosis and Priapism"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "analysis).",
          "pdf_page": 1127,
          "printed_page": 1045,
          "column": 2,
          "subheading": "Paraphimosis and Priapism"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Intrapenile phenylephrine may enhance",
          "pdf_page": 1127,
          "printed_page": 1045,
          "column": 3,
          "subheading": "Paraphimosis and Priapism"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "venous outflow if veno-occlusive priapism.",
          "pdf_page": 1127,
          "printed_page": 1045,
          "column": 3,
          "subheading": "Paraphimosis and Priapism"
        },
        {
          "type": "bullet",
