      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Antibiotic ointments—prevent penile adhesions with prepuce.",
              "pdf_page": 1127,
              "printed_page": 1045,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Phenylephrine (priapism)—intracavernosal infusion of 100–500μg diluted in 1 mL of 0.9% saline.",
              "pdf_page": 1127,
