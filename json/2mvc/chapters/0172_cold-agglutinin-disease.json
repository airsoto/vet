          "content_blocks": []
        },
        "GEOGRAPHIC DISTRIBUTION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GEOGRAPHIC DISTRIBUTION",
          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Rare; genetics, age, breed, and sex predilections unknown.",
              "pdf_page": 379,
              "printed_page": 297,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Low titer of cold agglutinins (1 : 32 or less) may be found in healthy pets without clinical significance.",
              "pdf_page": 379,
              "printed_page": 297,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "More likely to occur following exposure to cold temperatures.",
              "pdf_page": 379,
              "printed_page": 297,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cyanosis of the extremities associated with sludging of erythrocyte agglutinates in microvasculature.",
              "pdf_page": 379,
              "printed_page": 297,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Erythema, skin ulceration with secondary crusting.",
              "pdf_page": 379,
              "printed_page": 297,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dry, gangrenous necrosis of ear tips, tail tip, nose, and feet.",
              "pdf_page": 379,
              "printed_page": 297,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anemia may cause signs of pallor, tachycardia, tachypnea, icterus, and pigmenturia.",
              "pdf_page": 379,
              "printed_page": 297,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Idiopathic; cold exposure is a risk factor.",
              "pdf_page": 379,
              "printed_page": 297,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary disease—associated with upper respiratory infection (cats), neonatal isoerythrolysis, lead intoxication (dogs), Mycoplasmapneumonia, and neoplasia.",
              "pdf_page": 379,
              "printed_page": 297,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Skin lesions—vasculitis, hepatocutaneous syndrome, toxic epidermal necrolysis, dermatomyositis, systemic lupus erythematosus",
              "pdf_page": 379,
              "printed_page": 297,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(SLE), lymphoma, frostbite, lead poisoning, and pemphigus.",
              "pdf_page": 379,
              "printed_page": 297,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other causes of anemia (including hemolytic anemias).",
              "pdf_page": 379,
              "printed_page": 297,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Laboratory abnormalities secondary to hemolysis, if present.",
              "pdf_page": 379,
              "printed_page": 297,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Autoagglutination of RBCs may be observed at room temperature.",
              "pdf_page": 379,
              "printed_page": 297,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cold agglutinins should be suspected when blood in heparin or EDTA on a glass slide agglutinates spontaneously at room temperature with enhancement at 39 °F (3.9 °C), and the erythrocytes disperse again upon warming to 99 °F (37.2 °C).",
              "pdf_page": 379,
              "printed_page": 297,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If no agglutination can be induced in vitro, it will not occur in vivo in extremities.",
              "pdf_page": 379,
              "printed_page": 297,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Coombs’ test at 99 °F—cold agglutinins usually not detected because they may be eluted off the erythrocytes during washing; thus test requires the use of anti-complement factor serum.",
              "pdf_page": 379,
              "printed_page": 297,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Coombs’ test at 39 °F—incidence of a positive result in healthy dogs has been reported to be >50%, which may be caused by unspecific binding of the reagent itself or by binding of naturally occurring nonpathogenic low-titer cold agglutinins.",
              "pdf_page": 379,
              "printed_page": 297,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The globulin class can be established by immunoelectrophoresis of the patient’s erythrocytes, which may be important for prognosis and treatment.",
              "pdf_page": 379,
              "printed_page": 297,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "IMAGING",
          "content_blocks": []
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": []
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dermal necrosis and ulceration with possible opportunistic infections.",
              "pdf_page": 379,
              "printed_page": 297,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vascular thrombosis, ischemic necrosis.",
              "pdf_page": 379,
              "printed_page": 297,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Hospitalization in a warm environment until the disease is nonprogressive.",
          "pdf_page": 379,
          "printed_page": 297,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Supportive care and wound management.",
          "pdf_page": 379,
          "printed_page": 297,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Splenectomy is of little benefit in patients with IgM-mediated hemolysis, but may be helpful in those with IgG-mediated hemolysis.",
          "pdf_page": 379,
          "printed_page": 297,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Inform the client to keep the patient in a warm environment at all times to prevent relapse.",
          "pdf_page": 379,
          "printed_page": 297,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Exercise restriction.",
          "pdf_page": 379,
          "printed_page": 297,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "In humans, plasmapheresis, IV gamma globulins, and rituximab with or without fludarabine have been tried.",
          "pdf_page": 379,
          "printed_page": 297,
          "column": 2
        }
      ],
