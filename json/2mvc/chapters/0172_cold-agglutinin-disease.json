    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Keep patient in warm environments.",
          "pdf_page": 379,
          "printed_page": 297,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Cold agglutinin disease usually characterized by acute onset and rapid progression.",
          "pdf_page": 379,
          "printed_page": 297,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Prognosis is guarded to fair; recovery may take weeks.",
          "pdf_page": 379,
          "printed_page": 297,
          "column": 3
        }
      ],
