        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Dogs and less commonly cats, birds, and small mammals. Young animals are more often affected.",
              "pdf_page": 490,
              "printed_page": 408,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Occur within 15 minutes to 24 hours after ingestion.",
              "pdf_page": 490,
              "printed_page": 408,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ingestion—consistent with FBO and may include gagging, retching, vomiting, anorexia, abdominal distension, abdominal pain; hematemesis in prolonged or severe cases.",
              "pdf_page": 490,
              "printed_page": 408,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inhalation—coughing, sneezing, increased secretions within 4–8 hours.",
              "pdf_page": 490,
              "printed_page": 408,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dermal—irritation, redness, rash.",
              "pdf_page": 490,
              "printed_page": 408,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
