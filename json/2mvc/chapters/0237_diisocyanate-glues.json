  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Diisocyanate glues include wood glue, construction glue, and some “high-strength or extra strength” glues.",
              "pdf_page": 490,
              "printed_page": 408,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gorilla Glue is one popular brand name. There are non-Gorilla brand glue types that contain diisocyanate as the active ingredient and not all types of Gorilla Glue contain diisocyanates. Confirm the actual product with the owner, using the packaging if necessary.",
              "pdf_page": 490,
              "printed_page": 408,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Typically, the owner finds a chewed bottle of glue or glue stuck on the animal.",
              "pdf_page": 490,
              "printed_page": 408,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diisocyanate glue rapidly expands in the moist environment of the stomach, causing bloat and foreign body obstruction (FBO). The glue is not absorbed and does not cause systemic toxicity. Ingestions as small as 2 oz (56 g) can require surgical intervention to resolve obstruction.",
              "pdf_page": 490,
              "printed_page": 408,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Glue is also adhesive and an irritant to the paws, oral cavity, and stomach lining.",
              "pdf_page": 490,
              "printed_page": 408,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inhalation may cause irritation to the lungs.",
              "pdf_page": 490,
              "printed_page": 408,
              "column": 1
            }
          ]
        },
