      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "History of exposure and clinical signs generally facilitate diagnosis.",
              "pdf_page": 490,
              "printed_page": 408,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Presenting signs are consistent with gastric dilatation-volvulus (GDV), bloat, pancreatitis, inflammatory bowel disease, and other causes of FBO.",
              "pdf_page": 490,
              "printed_page": 408,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Radiographs are highly suggestive of FBO (see Web Figure 1).",
              "pdf_page": 490,
              "printed_page": 408,
              "column": 1
            }
          ]
        },
