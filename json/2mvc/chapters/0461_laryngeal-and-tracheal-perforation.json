          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Dog and cat—no breed, age, or sex predilection.",
              "pdf_page": 892,
              "printed_page": 810,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Onset: immediate or up to 1 week after injury.",
              "pdf_page": 892,
              "printed_page": 810,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "SC emphysema and respiratory distress are most common.",
              "pdf_page": 892,
              "printed_page": 810,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other signs—respiratory distress, may have stridor, anorexia, lethargy, exercise intolerance, gagging, ptyalism, vomiting, coughing, hemoptysis, upper airway obstruction, and shock. May have dysphonia (voice change) and/or dysphagia.",
              "pdf_page": 892,
              "printed_page": 810,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
