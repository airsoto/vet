        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Access to outside while unsupervised causing increased risk of all types of trauma.",
              "pdf_page": 892,
              "printed_page": 810,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exposure to other animals causing increased risk of bite wounds.",
              "pdf_page": 892,
              "printed_page": 810,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Penetrating cervical wounds—bite wounds, impalement, projectile missiles, foreign bodies.",
              "pdf_page": 892,
              "printed_page": 810,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Iatrogenic perforation during endotracheal intubation, transtracheal wash, jugular venipuncture, cervical surgery, radiation therapy, tracheal stent fracture, or failure to deflate cuff or to stabilize the tube while repositioning patient. Overinflation of endotracheal cuff can cause a linear tear in the trachealis muscle at thoracic inlet or intrathoracic trachea. Occurs most often with dental procedures.",
              "pdf_page": 892,
              "printed_page": 810,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Blunt trauma can cause intrathoracic tracheal avulsion.",
              "pdf_page": 892,
              "printed_page": 810,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Blunt trauma to the cervical region can cause laryngeal avulsion or fracture.",
              "pdf_page": 892,
              "printed_page": 810,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hospitalization is indicated.",
              "pdf_page": 892,
              "printed_page": 810,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Oxygen supplementation with 95% O2for 4 hours will decrease SC emphysema.",
              "pdf_page": 892,
              "printed_page": 810,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Minimal handling to reduce stress; most",
              "pdf_page": 892,
              "printed_page": 810,
              "column": 2
            }
          ]
        }
      }
    },
