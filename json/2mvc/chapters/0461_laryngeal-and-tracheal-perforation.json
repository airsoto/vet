    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Monitor respiratory rate and effort, mucous membrane color, capillary refill time, pulse quality, and heart rate, and auscult frequently.",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pulse oximetry and/or arterial blood gases.",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiographs to monitor pneumomediastinum, pneumothorax, and help detect tracheal stenosis. Tracheoscopy required in some cases.",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tracheostomy care if tracheostomy is needed.",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory rate and effort, respiratory noise, and exercise tolerance, during and after the recovery stage.",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 2
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Use of 3 mL syringe for cuff inflation for cats and small dogs to prevent overinflation of cuff.",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "High-volume low-pressure endotracheal tube cuff may also reduce risk of tracheal damage.",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Disconnect endotracheal tube from anesthetic circuit when repositioning animal during anesthesia.",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Selection of appropriate endotracheal tube and endoscope size along with use of lubrication will reduce iatrogenic tracheal and laryngeal trauma.",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Direct visualization of the larynx for intubation can reduce risk of iatrogenic trauma.",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Long-term intubation for positive-pressure ventilation can be maintained by temporary tracheostomy to prevent laryngeal damage.",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 2
            }
          ]
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Tracheal stricture and stenosis at site of perforation or repair.",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Laryngeal paralysis from damage to recurrent laryngeal nerve.",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dehiscence of tracheal anastomosis site.",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Stenosis or stricture resulting in airway compromise.",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infection from trauma, or post operatively.",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sepsis (rare).",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Obstruction of temporary or permanent tracheostomy with mucus.",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Death, particularly at induction of anesthesia with complete tracheal avulsion, or with complete airway obstruction.",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 2
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Most cases respond well to appropriate therapy.",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Complete tracheal avulsion—guarded prognosis. Without surgery—extremely poor prognosis due to stricture formation.",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prognosis depends on severity of trauma, concurrent injuries, and treatment.",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If severe laryngeal trauma is present and veterinary care can be quickly obtained, permanent tracheostomy can allow for fair to good prognosis (with the exception of cats and very small dogs, where stoma obstruction with mucus may be recurrent and severe).",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 3
            }
          ]
        }
      }
    },
    "MISCELLANEOUS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "ASSOCIATED CONDITIONS": {
          "present": true,
          "status": "content",
          "source_heading": "ASSOCIATED CONDITIONS",
          "canonical_heading": "ASSOCIATED CONDITIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "With tracheal perforation caused by blunt trauma, can have pulmonary contusions, pneumothorax, rib fractures, and hemothorax.",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 3
            }
          ]
        },
