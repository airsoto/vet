        },
        "CONTRAINDICATIONS/POSSIBLE INTERACTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Sedation—use with caution, can decrease respiratory drive.",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Corticosteroids are not indicated unless there is a large degree of upper airway swelling or concern for postoperative swelling.",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 1
            }
          ]
        },
