          "content_blocks": []
        },
        "SYSTEMS AFFECTED": {
          "present": true,
          "status": "content",
          "source_heading": "SYSTEMS AFFECTED",
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory—compromise of airway, possible pneumomediastinum and pneumothorax. Laryngeal swelling may result in upper airway obstruction.",
              "pdf_page": 892,
              "printed_page": 810,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cardiovascular—pneumothorax and tension pneumothorax can decrease venous return and cardiac output.",
              "pdf_page": 892,
              "printed_page": 810,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nervous, musculoskeletal—depends on severity of hypoxia.",
              "pdf_page": 892,
              "printed_page": 810,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Skin—SC emphysema, initially cervical but can affect entire body.",
              "pdf_page": 892,
              "printed_page": 810,
              "column": 1
            }
          ]
        },
