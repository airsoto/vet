      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Broad-spectrum antibiotic therapy if caused by bite wounds.",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Antibiotics after obtaining cultures from contaminated wounds; continue 1–2 weeks in the postoperative period. Empirical selections while awaiting culture results could include:",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Ampicillin 22 mg/kg IV q8h (both dogs",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and cats) and enrofloxacin 10–15 mg/kg diluted and given slowly IV or PO q24h in dogs (5 mg/kg q24h in cats).",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Clindamycin 10 mg/kg IV or PO q8h and",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "either amoxicillin/clavulanic acid 15 mg/kg PO q12h or enrofloxacin, as listed above.",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Corticosteroids (dexamethasone sodium",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "phosphate 0.1–0.2 mg/kg IV) at time of surgery to reduce inflammation; may repeat at a dose of 0.05–0.1 mg/kg IV q24h for first 24–48 hours.",
              "pdf_page": 893,
              "printed_page": 811,
              "column": 1
            }
          ]
        },
        "CONTRAINDICATIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CONTRAINDICATIONS",
          "content_blocks": []
        },
        "PRECAUTIONS": {
