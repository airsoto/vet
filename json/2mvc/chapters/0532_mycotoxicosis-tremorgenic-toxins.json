        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs and rarely cats.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Poisoning by penitrem A and roquefortine has been reported in dogs of various ages and breeds soon after the ingestion of moldy foods or compost.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Moderate to severe muscle tremors and seizures—begin minutes to hours (0.5–4 hours in case reports) after ingestion of moldy food or compost.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affected dogs may be hyperresponsive to external stimuli.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Early signs—may include panting, hyperactivity, vomiting, ataxia, incoordination, weakness, tachycardia, and/or rigidity.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prolonged muscle tremors or seizures—may lead to hyperthermia, hypoglycemia, dehydration, and anorexia.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Severe cases—may result in death.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Liver necrosis—has been reported experimentally.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs (and potentially cats) are exposed to penitrem A and roquefortine when they ingest moldy food or decomposing organic matter (compost).",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Experimentally, doses of 0.125 mg/kg penitrem A produced tremors within 30 minutes. Doses of 0.5 mg/kg of penitrem A resulted in acute onset of tremors, severe liver necrosis, and death.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Toxic causes of seizures—strychnine; insecticides (e.g., organophosphate, carbamate, organochlorine, nicotine, pyrethroid); metaldehyde; zinc phosphide; bromethalin; methylxanthines (theobromine and caffeine); amphetamines; cocaine; sago palm; xylitol.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nontoxic causes of seizures—inflammation; congenital abnormal myelin formation; metabolic conditions (e.g., hepatic or uremic encephalopathy).",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "CBC, biochemistry, and urinalysis to assess the patient’s status and to help rule out other causes of tremors and seizures.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
