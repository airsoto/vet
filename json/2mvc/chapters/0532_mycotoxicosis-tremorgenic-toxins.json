    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Diazepam 0.25–1 mg/kg IV PRN—to control tremors/seizures.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Methocarbamol 50–220 mg/kg IV to control tremors/seizures; do not exceed 330 mg/kg/day. Give 1/2 rapidly and administer rest to effect.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Barbiturates phenobarbital 2–5 mg/kg IV PRN—if tremors and seizures cannot be controlled with diazepam.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sodium bicarbonate—may be required if an acid–base imbalance exists.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other symptomatic and supportive therapy—as indicated.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 2
            }
          ]
        },
