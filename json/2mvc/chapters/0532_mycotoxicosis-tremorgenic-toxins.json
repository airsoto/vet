        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Penitrem A—produced by the fungus",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Penicillium crustosum(and perhaps other",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Penicilliumspp.); poisoning by this toxin has",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "been reported in dogs ingesting moldy bread,",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 1,
              "subheading": "Penicilliumspp.); poisoning by this toxin has"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "cheese, and English walnuts.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 1,
              "subheading": "Penicilliumspp.); poisoning by this toxin has"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Roquefortine—produced byPenicillium",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 1,
              "subheading": "Penicilliumspp.); poisoning by this toxin has"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "roquefortii(and perhaps otherPenicillium",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "spp.); has been reported to cause poisoning in",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 1,
              "subheading": "roquefortii(and perhaps otherPenicillium"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "dogs through ingestion of moldy cheese or",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 1,
              "subheading": "roquefortii(and perhaps otherPenicillium"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "decaying organic material (compost).",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 1,
              "subheading": "roquefortii(and perhaps otherPenicillium"
            }
          ]
        },
