    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Patients should be monitored for occurrence of tremors or seizures, hyperthermia, dehydration,",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "acid–base imbalances, liver damage, rhabdomyolysis, and respiratory difficulties.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 3
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Prevent animals from eating moldy food items, garbage, or compost.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 3
            }
          ]
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Seizures—may not be controlled with diazepam.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acid–base imbalances—may develop.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hepatic damage and rhabdomyolysis—may occur.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Aspiration pneumonia has been reported as a sequelae to vomiting and/or gastric lavage.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exposure can be fatal if lethal doses are consumed and are absorbed before gastrointestinal decontamination and therapy are instituted.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 3
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Very good if appropriate therapy is promptly instituted, the toxin is removed from the gastrointestinal tract, and the seizures are controlled with diazepam, methocarbamol or barbiturates.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Recovery in most clinical cases is reported to be complete within 24–48 hours.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In a few reported cases, signs of weakness, muscle rigidity, and incoordination were persistent and slowly resolved over 1–2 weeks.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "A few severe cases have been reported to be fatal.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 3
            }
          ]
        }
      }
    },
