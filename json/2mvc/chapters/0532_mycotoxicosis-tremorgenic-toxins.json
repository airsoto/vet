        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "High-pressure liquid chromatography/mass spectroscopy—analysis of vomitus, stomach contents, and gastric lavage washings for penitrem A or roquefortine.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The presence of roquefortine C in vomitus or stomach contents can serve as a sensitive biomarker for penitrem A intoxication.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bile analysis—reported to be of value.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "There are no pathognomonic lesions associated with penitrem A or roquefortine toxicosis.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "High doses of penitrem A have been reported to cause severe liver damage experimentally.",
              "pdf_page": 1009,
              "printed_page": 927,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Remove contaminated food or organic material.",
          "pdf_page": 1009,
          "printed_page": 927,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Induce vomiting (if patient is not at risk of aspirating vomitus) or institute gastric lavage followed by administration of activated charcoal.",
          "pdf_page": 1009,
          "printed_page": 927,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Control seizures.",
          "pdf_page": 1009,
          "printed_page": 927,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Thermoregulation as indicated.",
          "pdf_page": 1009,
          "printed_page": 927,
          "column": 2
        }
      ],
