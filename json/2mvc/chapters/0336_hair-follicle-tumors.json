              "pdf_page": 660,
              "printed_page": 578,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "one dog and multiple infundibular keratinizing",
              "pdf_page": 660,
              "printed_page": 578,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "acanthomas in some dogs.",
              "pdf_page": 660,
              "printed_page": 578,
              "column": 2
            },
            {
              "type": "bullet",
