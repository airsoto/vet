        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog and cat.",
              "pdf_page": 660,
              "printed_page": 578,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Age—usually>5 years.",
              "pdf_page": 660,
              "printed_page": 578,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No",
              "pdf_page": 660,
              "printed_page": 578,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "sex predisposition.",
              "pdf_page": 660,
              "printed_page": 578,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Trichoepithelioma— common in dogs; rare in cats; golden retrievers, basset hounds, German shepherds, cocker spaniels, Irish setters, English springer spaniels, miniature schnauzers, and standard poodles may be predisposed; Persian and",
              "pdf_page": 660,
              "printed_page": 578,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Siamese cats.",
              "pdf_page": 660,
              "printed_page": 578,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Trichoblastoma—common in dogs; common in cats; poodles and cocker spaniels may be predisposed; no known breed",
              "pdf_page": 660,
              "printed_page": 578,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "predisposition in cats.",
              "pdf_page": 660,
              "printed_page": 578,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infundibular keratinizing acanthoma—uncommon in dogs and cats; Norwegian elkhound, keeshond, and German shepherd dog may be predisposed; no known breed predisposition in cats.",
              "pdf_page": 660,
              "printed_page": 578,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tricholemmoma—uncommon in dogs and cats; Afghan hounds may be predisposed; no known breed predisposition in cats.",
              "pdf_page": 660,
              "printed_page": 578,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pilomatricoma—uncommon in dogs and cats; Kerry blue terriers, Old English sheepdogs, and miniature poodles may be predisposed; no known breed predisposition in cats.",
              "pdf_page": 660,
              "printed_page": 578,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually a solitary mass.",
              "pdf_page": 660,
              "printed_page": 578,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Trichoepithelioma— common on the lateral thorax and dorsal lumbar area (dogs) and head (cats).",
              "pdf_page": 660,
              "printed_page": 578,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Trichoblastoma—common on the head and neck, especially the base of the ear (dogs) and",
              "pdf_page": 660,
              "printed_page": 578,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "cranial half of the trunk (cats).",
              "pdf_page": 660,
              "printed_page": 578,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infundibular keratinizing acanthoma—common on the back,",
              "pdf_page": 660,
              "printed_page": 578,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "neck, and limbs (dogs).",
              "pdf_page": 660,
              "printed_page": 578,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tricholemmoma— common on the head and neck (dogs).",
              "pdf_page": 660,
              "printed_page": 578,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pilomatricoma—common on the back,",
              "pdf_page": 660,
              "printed_page": 578,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "limbs, shoulders, flanks, and tail.",
              "pdf_page": 660,
              "printed_page": 578,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Firm, round, elevated, well-circumscribed, often hairless, or ulcerated dermoepithelial masses or nodules.",
              "pdf_page": 660,
              "printed_page": 578,
              "column": 1
            }
          ]
        },
