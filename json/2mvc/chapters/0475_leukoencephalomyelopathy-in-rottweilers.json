  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Neurodegenerative disorder that affects the white matter of young adult Rottweilers leading to chronic progressive ataxia of the limbs.",
              "pdf_page": 915,
              "printed_page": 833,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The clinical signs are primarily associated to involvement of the cervical spinal cord, but white matter lesions are also present in the brainstem, cerebellum, and subcortical white matter.",
              "pdf_page": 915,
              "printed_page": 833,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Occurs worldwide.",
              "pdf_page": 915,
              "printed_page": 833,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Probably autosomal recessive inheritance.",
              "pdf_page": 915,
              "printed_page": 833,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
