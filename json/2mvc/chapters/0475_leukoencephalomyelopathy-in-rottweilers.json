    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Neurologic examination—monitor monthly to assess progression.",
          "pdf_page": 915,
          "printed_page": 833,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Avoid bed sores and urine and fecal scalding by keeping the patient on a clean, dry, and cushioned pad (e.g., synthetic sheepskin).",
          "pdf_page": 915,
          "printed_page": 833,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Severe tetraparesis—within 6–12 months after onset of clinical signs.",
          "pdf_page": 915,
          "printed_page": 833,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Euthanasia—because of severe debility.",
          "pdf_page": 915,
          "printed_page": 833,
          "column": 3
        }
      ],
