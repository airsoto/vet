        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Rottweiler—either sex; onset in adult dogs 1.5–4 years old.",
              "pdf_page": 915,
              "printed_page": 833,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Insidious, nonpainful, progressive onset.",
              "pdf_page": 915,
              "printed_page": 833,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cervical spinal cord signs prevail despite widespread demyelinating process.",
              "pdf_page": 915,
              "printed_page": 833,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Proprioceptive ataxia of the thoracic (delayed protraction with overreaching of the limb) and pelvic limbs, with upper motor neuron weakness.",
              "pdf_page": 915,
              "printed_page": 833,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Front limbs are more severely affected than hind limbs. Mild asymmetry between right and left limbs may be present.",
              "pdf_page": 915,
              "printed_page": 833,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nail scuffing in all limbs.",
              "pdf_page": 915,
              "printed_page": 833,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Proprioceptive positioning and hopping delayed to absent in all limbs.",
              "pdf_page": 915,
              "printed_page": 833,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Spinal reflexes normal to exaggerated.",
              "pdf_page": 915,
              "printed_page": 833,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Autosomal recessive inheritance suspected.",
              "pdf_page": 915,
              "printed_page": 833,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inbreeding.",
              "pdf_page": 915,
              "printed_page": 833,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cervical compressive lesions such as cervical vertebral spondylomyelopathy (wobbler), cervical subarachnoid diverticula, fibrotic stenosis, spinal cord tumors—difficult to differentiate on clinical signs alone; all can have an insidious onset; MRI necessary for diagnosis.",
              "pdf_page": 915,
              "printed_page": 833,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neuroaxonal dystrophy and distal sensori motor polyneuropathy—neurologic disorders reported in Rottweilers; differentiated on the basis of neurologic deficits; neuroaxonal dystrophy: deficits relate to the cerebellum; distal sensorimotor polyneuropathy: tetraparesis associated with lower motor neuron signs.",
              "pdf_page": 915,
              "printed_page": 833,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Discospondylitis, fracture/luxation, inter vertebral disc disease—neck pain; disc disease rarely seen in large-breed dogs at a young age.",
              "pdf_page": 915,
              "printed_page": 833,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Normal",
              "pdf_page": 915,
