  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Bromethalin is a neurotoxic rodenticide that produces cerebral edema and elevated CSF pressure, resulting in progressive CNS depression, coma, paresis, and paralysis.",
              "pdf_page": 1290,
              "printed_page": 1208,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical signs and death have been reported in dogs and cats exposed to bromethalin at doses as low as 0.36 and 0.24 mg/kg, respectively.",
              "pdf_page": 1290,
              "printed_page": 1208,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Trade names include Tomcat, Fastrac, Top Gun, Gladiator, and others. Bromethalin concentrations in products can vary from 0.01 to 0.025%.",
              "pdf_page": 1290,
              "printed_page": 1208,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
