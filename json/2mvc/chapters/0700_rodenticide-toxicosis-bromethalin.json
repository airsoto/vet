        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "reaction to the emulsion.",
              "pdf_page": 1290,
              "printed_page": 1208,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Histologic lesions are generally confined to the CNS and include spongy degeneration in the cerebrum, cerebellum, brainstem, spinal cord, and optic nerve white matter due to myelin edema.",
              "pdf_page": 1290,
              "printed_page": 1208,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gross evidence of cerebral edema is",
              "pdf_page": 1290,
              "printed_page": 1208,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May require several weeks to recover from generally mild. mild poisoning.",
              "pdf_page": 1290,
              "printed_page": 1208,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prognosis is poor for the severely affected animals.",
              "pdf_page": 1290,
              "printed_page": 1208,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prevent ongoing rodenticide ingestion.",
              "pdf_page": 1290,
              "printed_page": 1208,
              "column": 2
            }
          ]
        }
      }
    },
