        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs and cats. Other species including humans may be affected.",
              "pdf_page": 1290,
              "printed_page": 1208,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Any breed or age may be affected.",
              "pdf_page": 1290,
              "printed_page": 1208,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ingestion most often results in a delayed neurotoxic syndrome that develops within 2–7 days of ingestion; however, delays of up to 2 weeks may occur.",
              "pdf_page": 1290,
              "printed_page": 1208,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Common clinical signs include anorexia, progressive ataxia, paresis, and hind limb paralysis, moderate to severe central nervous system depression, fine muscle tremors, and focal motor or generalized seizures.",
              "pdf_page": 1290,
              "printed_page": 1208,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Forelimb extensor rigidity and decerebrate postures are often seen.",
              "pdf_page": 1290,
              "printed_page": 1208,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ingestion of high doses of bromethalin less commonly results in an acute onset (within 1–2 hours) of CNS excitation, muscle tremors, and seizures.",
              "pdf_page": 1290,
              "printed_page": 1208,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Bromethalin ingestion most often occurs in animals <1 year of age.",
              "pdf_page": 1290,
              "printed_page": 1208,
              "column": 1
            }
          ]
        }
      }
    },
