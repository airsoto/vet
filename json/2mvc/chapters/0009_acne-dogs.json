        "GEOGRAPHIC DISTRIBUTION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GEOGRAPHIC DISTRIBUTION",
          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs, often younger, sometimes puppies.",
              "pdf_page": 97,
              "printed_page": 15,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Predisposed short-coated breeds—boxer, Doberman pinscher, English bulldog, Great Dane, Weimaraner, mastiff, Rottweiler, German shorthaired pointer, pit bull terrier.",
              "pdf_page": 97,
              "printed_page": 15,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ventral chin and lip margins may have few to numerous erythematous papules and sometimes bullae. These may coalesce to form plaques.",
              "pdf_page": 97,
              "printed_page": 15,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Initial lesions are inflammatory and sterile; bacteria may not be isolated and lesions may not respond to antibiotics.",
              "pdf_page": 97,
              "printed_page": 15,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Advanced lesions may contain pus or blood, indicating secondary deep bacterial folliculitis and furunculosis.",
              "pdf_page": 97,
              "printed_page": 15,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lesions may be pruritic, some are painful on palpation, but most are nonpainful and nonpruritic.",
              "pdf_page": 97,
              "printed_page": 15,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic and pruritic lesions may become hyperpigmented, lichenified, scarred, and alopecic.",
              "pdf_page": 97,
              "printed_page": 15,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Several short-coated breeds appear to be genetically predisposed to acne. Lesions may be worse in allergic individuals.",
              "pdf_page": 97,
              "printed_page": 15,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
