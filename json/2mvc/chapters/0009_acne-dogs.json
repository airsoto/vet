  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Also (more correctly) muzzle folliculitis and furunculosis.",
              "pdf_page": 97,
              "printed_page": 15,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic inflammatory disorder of the chin and lips of mostly young animals.",
              "pdf_page": 97,
              "printed_page": 15,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Characterized by folliculitis and furunculosis; almost never comedogenic as seen in “true acneiform” lesions of human beings.",
              "pdf_page": 97,
              "printed_page": 15,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Recognized almost exclusively in shortcoated breeds.",
              "pdf_page": 97,
              "printed_page": 15,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Genetic predisposition, local trauma, and allergic disease often play a role.",
              "pdf_page": 97,
              "printed_page": 15,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
