        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Impression cytology will help determine if bacteria or yeast are present.",
              "pdf_page": 97,
              "printed_page": 15,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Skin scrape—demodicosis.",
              "pdf_page": 97,
              "printed_page": 15,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dermatophyte culture—dermatophytosis.",
              "pdf_page": 97,
              "printed_page": 15,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bacterial culture and sensitivity testing—in patients with suppurative folliculitis and furunculosis that are nonresponsive to initial antibiotic selection.",
              "pdf_page": 97,
              "printed_page": 15,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Biopsy—histologic confirmation for cases in which diagnosis is in question.",
              "pdf_page": 97,
              "printed_page": 15,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical signs and histopathologic findings are diagnostic.",
              "pdf_page": 97,
              "printed_page": 15,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Characterized histopathologically by folliculitis and furunculosis.",
              "pdf_page": 97,
              "printed_page": 15,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bacteria—not always isolated from lesions in early stages.",
              "pdf_page": 97,
              "printed_page": 15,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "As disease progresses, papules enlarge and rupture, promoting a suppurative folliculitis and furunculosis.",
              "pdf_page": 97,
              "printed_page": 15,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Reduce behavioral trauma to the chin (e.g., rubbing on the carpet, chewing bones that increase salivation).",
          "pdf_page": 97,
          "printed_page": 15,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Frequent cleaning with chlorhexidinecontaining pads, shampoos, or solutions can be helpful, but instruct owners not to scrub at the area.",
          "pdf_page": 97,
          "printed_page": 15,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Gentamicin/steroid-containing ointments for the ears work well on the chin when applied twice daily.",
          "pdf_page": 97,
          "printed_page": 15,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "If topicals are not helpful by themselves, add oral antibiotics based on positive cytology and culture and sensitivity testing.",
          "pdf_page": 97,
          "printed_page": 15,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Severe cases may necessitate short courses of oral steroids.",
          "pdf_page": 97,
          "printed_page": 15,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Evaluate for underlying allergic/atopic disease and institute proper therapy for diagnosis and control of these diseases; control of allergic disease may permit resolution of muzzle folliculitis and furunculosis.",
          "pdf_page": 97,
          "printed_page": 15,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Instruct owners to avoid squeezing the lesions; trauma may make inflammation worse.",
          "pdf_page": 97,
          "printed_page": 15,
          "column": 2
        }
      ],
