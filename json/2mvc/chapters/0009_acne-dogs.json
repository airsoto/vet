              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Juvenile cellulitis.",
              "pdf_page": 97,
              "printed_page": 15,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Contact dermatitis.",
              "pdf_page": 97,
              "printed_page": 15,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "With other symptoms, consider allergic/atopic disease as playing a role.",
              "pdf_page": 97,
              "printed_page": 15,
              "column": 1
            }
          ]
        },
