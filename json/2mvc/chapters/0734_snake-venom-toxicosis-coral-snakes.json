          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Onset of clinical signs may be delayed several hours (up to 18 hours).",
              "pdf_page": 1347,
              "printed_page": 1265,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Localized signs generally absent.",
              "pdf_page": 1347,
              "printed_page": 1265,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Generalized weakness and ataxia.",
              "pdf_page": 1347,
              "printed_page": 1265,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bulbar paralysis—affecting cranial motor nerves, respiratory tract, and skeletal muscles; acute flaccid quadriplegia.",
              "pdf_page": 1347,
              "printed_page": 1265,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Salivation—caused by dysphagia.",
              "pdf_page": 1347,
              "printed_page": 1265,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dyspnea.",
              "pdf_page": 1347,
              "printed_page": 1265,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dysphonia.",
              "pdf_page": 1347,
              "printed_page": 1265,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyporeflexive spinal reflexes.",
              "pdf_page": 1347,
              "printed_page": 1265,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Seizures.",
              "pdf_page": 1347,
              "printed_page": 1265,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urinary incontinence.",
              "pdf_page": 1347,
              "printed_page": 1265,
              "column": 1
            }
          ]
