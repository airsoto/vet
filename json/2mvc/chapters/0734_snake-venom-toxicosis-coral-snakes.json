    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "First aid—generally avoid; most effective measure is rapid transport to a veterinary facility for antivenom administration; Australian technique for elapid bites is a pressure wrap of the bitten limb with ace-type bandage to decrease blood flow and venom uptake.",
          "pdf_page": 1347,
          "printed_page": 1265,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Caution: do not wait for onset of clinical signs to initiate treatment.",
          "pdf_page": 1347,
          "printed_page": 1265,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Inpatient—hospitalize for a minimum of 48 hours.",
          "pdf_page": 1347,
          "printed_page": 1265,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Monitor CNS and respiratory function closely for 24 hours.",
          "pdf_page": 1347,
          "printed_page": 1265,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Specific antivenin is extremely limited for",
          "pdf_page": 1347,
          "printed_page": 1265,
          "column": 2
        },
        {
          "type": "subheading",
          "level": 0,
          "text": "M. fulviusenvenomations in the United States",
          "pdf_page": 1347,
          "printed_page": 1265,
          "column": 2
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "and typically not accessible for veterinary use.",
          "pdf_page": 1347,
          "printed_page": 1265,
          "column": 2,
          "subheading": "M. fulviusenvenomations in the United States"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "However, protective crossreactivity occurs",
          "pdf_page": 1347,
          "printed_page": 1265,
          "column": 2,
          "subheading": "M. fulviusenvenomations in the United States"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "with the following antivenins: Coralmyn",
          "pdf_page": 1347,
          "printed_page": 1265,
          "column": 2,
          "subheading": "M. fulviusenvenomations in the United States"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "(Fab2 equine origin) (Instituto Bioclon,",
          "pdf_page": 1347,
          "printed_page": 1265,
          "column": 2,
          "subheading": "M. fulviusenvenomations in the United States"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "Mexico), Costa Rican coral snake antivenin",
          "pdf_page": 1347,
          "printed_page": 1265,
          "column": 2,
          "subheading": "M. fulviusenvenomations in the United States"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "(Instituto Clodomiro Picado, Costa Rica), and",
          "pdf_page": 1347,
          "printed_page": 1265,
          "column": 2,
          "subheading": "M. fulviusenvenomations in the United States"
        },
        {
          "type": "subheading",
          "level": 0,
          "text": "Australian tiger snakeNotechis scutatus(CSL",
          "pdf_page": 1347,
          "printed_page": 1265,
          "column": 2
        },
        {
          "type": "paragraph",
