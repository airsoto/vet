    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "M. fulviusreactive antivenin (see Treatment)—indicated if the history includes recent coral snake interaction; evidence of puncture wounds; clinical signs consistent with coral snake envenomation; administer 1–2 vials; additional vials may be necessary (technique same as for pit viper antivenin).",
              "pdf_page": 1347,
              "printed_page": 1265,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Broad-spectrum antibiotics are not routinely recommended and should only be used if there is indication of infection.",
              "pdf_page": 1347,
              "printed_page": 1265,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neostigmine – may be useful to reverse neuromuscular blockade if antivenin not available. Has been used successfully to treat M. frontalisenvenomation in Brazil.",
              "pdf_page": 1347,
              "printed_page": 1265,
              "column": 2
            }
          ]
        },
