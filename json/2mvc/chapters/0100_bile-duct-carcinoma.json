          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Potential association between canine cholangiocarcinoma and trematode (hookworms, whipworms) infection.",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Canine biliary carcinoma has been experimentally induced by N-ethyl-N′-nitro-N-nitrosoguanidine.",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 1
            }
          ]
        }
      }
