          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Periodic physical examination, lab work, abdominal ultrasonography, and thoracic radiography after tumor resection.",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 3
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Anthelmintic therapy is warranted due to potential association between canine bile duct carcinoma and infection with hookworms or whipworms.",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 3
            }
          ]
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Tumor rupture/hemorrhage, esp. if the",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "massive form.",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Biliary obstruction.",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 3
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Aggressive tumor with a guarded to poor",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "prognosis, especially if nonresectable.",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "High rate of metastasis (up to 88%) in both dogs and cats; widespread intraperitoneal carcino-",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "matosis common in cats.",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most patients die within 6 months of surgery due to local recurrence or metastasis.",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 3
            }
          ]
        }
      }
