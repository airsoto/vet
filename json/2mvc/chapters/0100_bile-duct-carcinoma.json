        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "α-fetoprotein (an oncofetal glycoprotein) is elevated in 55% of dogs with bile duct carcinoma; may differentiate neoplastic from",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "non-neoplastic lesions in dogs.",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Coagulation profile (prothrombin time [PT], partial thromboplastin time [PTT]) recommended before biopsy or surgical procedures.",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pre- and postprandial bile acids can help assess hepatobiliary function.",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal radiography—may localize a mass to the liver, show displacement of the stomach, or demonstrate loss of detail in",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "patients with peritoneal effusion.",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal ultrasonography—can be used to assess location and character of lesion, detect and sample peritoneal effusion, and guide tumor",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "biopsy.",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiography—should be used to screen for pulmonary metastasis.",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CT and MRI—more sensitive techniques that are more likely to detect smaller lesions not visible on ultrasound and radiography.",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominocentesis and cytologic evaluation",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "of peritoneal fluid.",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytology or needle core (Tru-Cut®) biopsy samples via ultrasound",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "guidance.",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Laparoscopy or laparotomy may be needed to obtain larger samples for definitive diagnosis.",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Gross findings—morphologic types include massive (37–46%), nodular (0–21%), or diffuse (17–54%). Can be intrahepatic (most common in dogs), extrahepatic, or within the",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "gall bladder (rare).",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Histopathology findings—histologic subtypes include solid (cholangiocarcinoma) and cystic (biliary cystadenocarcinoma); subtype does not influence prognosis; immunohistochemistry (hepatocyte paraffin-1 and Claudin-7) can distinguish poorly differentiated hepatocellular carcinoma from biliary carcinoma.",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Complete surgical excision is treatment of choice; surgery not applicable for nodular/",
          "pdf_page": 255,
          "printed_page": 173,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "diffuse forms.",
          "pdf_page": 255,
          "printed_page": 173,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Up to 80% of liver can be resected if remaining liver tissue is functional.",
          "pdf_page": 255,
          "printed_page": 173,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Interventional techniques (chemoembolization) may be utilized as palliative procedures for nonresectable solitary tumors.",
          "pdf_page": 255,
          "printed_page": 173,
          "column": 2
        }
      ],
