  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Epithelial neoplasia that arises from the cells lining the biliary ducts or gallbladder.",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Second most common malignant hepatic tumor in dogs, representing 22–41% of all",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "malignant canine liver tumors.",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most common malignant hepatobiliary tumor in cats, but less common than benign biliary",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "cystadenoma.",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Benign biliary cystadenomas may undergo malignant transformation into cystadenocarcinomas, although time period over",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "which this occurs is unknown.",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Common metastatic sites include lungs, regional lymph nodes, and peritoneum (carcinomatosis); other metastatic sites include intestine, pancreas, heart, spleen, kidney, spinal cord, urinary bladder, bone, and rarely bone marrow.",
              "pdf_page": 255,
              "printed_page": 173,
              "column": 1
            }
          ]
        },
