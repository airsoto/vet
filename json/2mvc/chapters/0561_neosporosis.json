        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—puppies and adults.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—experimentally infected; antibodies in domestic and wild cats without known",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "disease;N. caninummyocarditis reported in",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "adult lion.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 1,
              "subheading": "disease;N. caninummyocarditis reported in"
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Young dogs (4 weeks to 6 months of age)—ascending lower motor neuron paralysis, myositis, muscle atrophy, fibrous muscle contracture, and arthrogryposis; may progress to tetraparesis/plegia, trismus, dysphagia, hypoventilation; subclinical disease of other organ systems possible; less common: meningoencephalomyelitis, hepatitis, myocarditis, pneumonia, acute dyspnea, sudden death.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Adult dogs—meningoencephalomyelitis and/or polymyositis; lesions can be found anywhere in CNS but have predilection for the cerebellum, resulting in slowly progressive cerebellar ataxia ± other cerebellovestibular signs; uncommonly affects other organs.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nodular dermatitis, particularly in immunosuppressed dogs.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
