  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Neospora caninum—obligate, intracellular, coccidial, protozoan.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Domestic and wild canids excrete infective oocysts in feces; numerous ruminant intermediate hosts.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Transmission—vertical (transplacental or transmammary), ingestion of sporulated oocysts in dog feces, or ingestion of infected tissues from intermediate hosts.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Disease caused by necrosis and inflammation from cyst rupture and tachyzoite invasion.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neurologic disease in dogs; other organ systems less commonly affected.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
