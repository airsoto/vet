    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ideal treatment unknown; clindamycin most commonly used but bradyzoites persist despite treatment.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Clindamycin 10–20 mg/kg PO q12h.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Trimethoprim-sulfadiazine (TMS) 15 mg/kg PO q12h.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Combination therapy—clindamycin and TMS, clindamycin and pyrimethamine (1 mg/kg PO q24h), or TMS and pyrimethamine.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 3
            }
          ]
        },
