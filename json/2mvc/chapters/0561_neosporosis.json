        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Nonsuppurative encephalomyelitis.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Severe nonsuppurative inflammation of cerebellar leptomeninges and cortex (more severe than that caused byT. gondii); cerebellar atrophy.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Myositis, myofibrosis.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Polyradiculoneuritis.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pneumonia, cerebellar atrophy, multifocal necrotizing myocarditis, and nodular dermatitis possible.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ulcerative and pyogranulomatous dermatitis.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Histology—differentiate by location in host",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "cell cytoplasm (T. gondiiwithin a parasito-",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "phorous vacuole).",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2,
              "subheading": "cell cytoplasm (T. gondiiwithin a parasito-"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tissue cysts—those ofN. caninumhave",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2,
              "subheading": "cell cytoplasm (T. gondiiwithin a parasito-"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "thicker walls; differentiated fromT. gondiiby",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "immunohistochemistry.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2,
              "subheading": "thicker walls; differentiated fromT. gondiiby"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Electron microscopy—rhoptries ofN.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2,
              "subheading": "thicker walls; differentiated fromT. gondiiby"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "caninumtachyzoites electron dense; those of",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "T. gondiihoneycomb.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2,
              "subheading": "caninumtachyzoites electron dense; those of"
            }
          ]
        }
      }
