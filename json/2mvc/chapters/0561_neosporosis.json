    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Long treatment period (min. 8 weeks); continue treatment 2 weeks beyond plateau of clinical improvement.",
          "pdf_page": 1051,
          "printed_page": 969,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Consider treatment of all puppies with infected littermates.",
          "pdf_page": 1051,
          "printed_page": 969,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Avoid immunosuppression if possible.",
          "pdf_page": 1051,
          "printed_page": 969,
          "column": 2
        }
      ],
