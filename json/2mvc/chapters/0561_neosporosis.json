        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "CSF analysis—normal to markedly increased total nucleated cell count; mononuclear pleocytosis more common than neutrophilic or eosinophilic; elevated total protein.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Serologic testing (IFA, ELISA, and immunoprecipitation)—CSF or serum.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Antibodies do not crossreact with",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Toxoplasma gondii, but do withNeospora",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hughesi, an equine protozoan.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2,
              "subheading": "Toxoplasma gondii, but do withNeospora"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Organism detection—oocysts in feces; must",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2,
              "subheading": "Toxoplasma gondii, but do withNeospora"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "distinguish fromHammondiaspp.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2,
              "subheading": "Toxoplasma gondii, but do withNeospora"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tachyzoites in aspirates, smears, or biopsies",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2,
              "subheading": "Toxoplasma gondii, but do withNeospora"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "need to be differentiated from those of",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2,
              "subheading": "Toxoplasma gondii, but do withNeospora"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Toxoplasma(immunohistochemistry).",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2,
              "subheading": "Toxoplasma gondii, but do withNeospora"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "PCR—diagnostic tool, distinguishes",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2,
              "subheading": "Toxoplasma gondii, but do withNeospora"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "between other parasites.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2,
              "subheading": "Toxoplasma gondii, but do withNeospora"
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "MRI of adult dogs—moderate to marked cerebellar atrophy with or without meningeal contrast enhancement; single or multifocal T2-weighted hyperintensities that contrast enhance within the CNS or muscles.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Muscle biopsy in dogs with myositis can identify organism by microscopy or PCR.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
