        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Raw meat may be a risk factor; should be avoided.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Other infectious disease (toxoplasmosis, sarcocystosis, hepatozoonosis, mycoses, rabies, canine distemper), neuronal storage diseases, noninfectious meningoencephalomyelitis or polymyositis, or immune-mediated neuromuscular disease, neoplasia.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dependent on the organ system involved.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Muscle involvement—creatine phospho kinase and aspartate aminotransferase activities increased.",
              "pdf_page": 1051,
              "printed_page": 969,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
