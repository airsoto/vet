    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Progression of clinical disease might cease with treatment.",
          "pdf_page": 1051,
          "printed_page": 969,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Once muscle contracture or ascending paralysis has occurred, prognosis for clinical improvement is poor.",
          "pdf_page": 1051,
          "printed_page": 969,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Serologically test dam or other in-contact dogs and cattle.",
          "pdf_page": 1051,
          "printed_page": 969,
          "column": 3
        }
      ],
