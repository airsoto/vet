      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Excitement and submissive urination occur as distinct behavioral presentations but may overlap in some patients.",
              "pdf_page": 1387,
              "printed_page": 1305,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Submissive urination is related to fearful responses—animal perceives potential threat or danger during interaction and displays submissive behavior, including urination, as appeasement gesture to abort potential escalation of aggressive interactions.",
              "pdf_page": 1387,
              "printed_page": 1305,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Generally seen in interaction with people; however, submissive urination may occur during interactions with other animals, especially conspecifics.",
              "pdf_page": 1387,
              "printed_page": 1305,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
