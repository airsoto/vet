        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Onset as puppy in dogs of either sex: generally <1 year old.",
              "pdf_page": 1387,
              "printed_page": 1305,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anecdotally higher incidence in some small breeds, e.g., dachshund, cocker spaniel.",
              "pdf_page": 1387,
              "printed_page": 1305,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Not observed in cats.",
              "pdf_page": 1387,
              "printed_page": 1305,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Excitement—loss of urine control in situations of high arousal, e.g., greeting people, anticipation of activities such as walks or car rides; no actual urination posturing seen—urine is expelled while dog is engaged in activities such as jumping up or play; dog does not necessarily show submissive behavior.",
              "pdf_page": 1387,
              "printed_page": 1305,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Submissive/fear—expelling small amounts of urine during interactions with people or other animals or in frightening situations; partial or full squatting position; dog may lift one hind leg partially for inguinal presentation.",
              "pdf_page": 1387,
              "printed_page": 1305,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs may be excited and aroused yet also submissive or fearful during greeting—when there are competing motivations this might therefore be described as conflict induced; the approach may be active with tail wagging and crouching/low body posture.",
              "pdf_page": 1387,
              "printed_page": 1305,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Administration of medications that reduce urethral competence or increase urine production (e.g., corticosteroids, sedatives).",
              "pdf_page": 1387,
              "printed_page": 1305,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Domineering training styles or interaction patterns.",
              "pdf_page": 1387,
              "printed_page": 1305,
              "column": 1
            }
          ]
        }
      }
    },
