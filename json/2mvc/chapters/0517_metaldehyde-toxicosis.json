        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Generally, within 3-4 hours but may occur in <30 minutes.",
              "pdf_page": 984,
              "printed_page": 902,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anxiety, panting, restlessness.",
              "pdf_page": 984,
              "printed_page": 902,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Salivation, gastrointestinal upset.",
              "pdf_page": 984,
              "printed_page": 902,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tachycardia.",
              "pdf_page": 984,
              "printed_page": 902,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tachypnea, dyspnea.",
              "pdf_page": 984,
              "printed_page": 902,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperthermia up to 108°F (42.2°C).",
              "pdf_page": 984,
              "printed_page": 902,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperesthesia.",
              "pdf_page": 984,
              "printed_page": 902,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ataxia, tremors, seizures (intermittent then continuous).",
              "pdf_page": 984,
              "printed_page": 902,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mydriasis, nystagmus (especially in cats).",
              "pdf_page": 984,
              "printed_page": 902,
              "column": 1
            }
          ]
        },
