          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Toxins capable of neurologic signs— amphetamines, bromethalin, blue-green algae, chocolate, hops, ivermectin, lead, neurotoxic mushrooms, organophosphate and some carbamate insecticides, pyrethroids, salt (ornaments, playdough), strychnine, tremorgenic mycotoxins, xylitol, and zinc phosphide.",
              "pdf_page": 984,
              "printed_page": 902,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nontoxic causes.",
              "pdf_page": 984,
              "printed_page": 902,
              "column": 1
            }
          ]
        },
