  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Form of acetaldehyde; primarily affects the nervous system.",
              "pdf_page": 984,
              "printed_page": 902,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mainly found in slug and snail baits; sometimes in solid fuel for camp stoves.",
              "pdf_page": 984,
              "printed_page": 902,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Crosses the blood–brain barrier and disrupts GABAergic inhibitory action, facilitating neuronal excitation and increasing potential for convulsions.",
              "pdf_page": 984,
              "printed_page": 902,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Systems affected include: neuromuscular (seizures and muscle tremors), hepatobiliary (delayed hepatotoxicosis reported in dogs only), and multiple organ failure (secondary to seizures and hyperthermia).",
              "pdf_page": 984,
              "printed_page": 902,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Incidence/prevalence—depends on presence and accessibility; weather resistant: persists in the environment for >14 days.",
              "pdf_page": 984,
              "printed_page": 902,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "More frequent in coastal, low-lying, temperate and subtropical regions of United States. Snails and slugs are common pests in those locations.",
              "pdf_page": 984,
              "printed_page": 902,
              "column": 1
            }
          ]
        },
