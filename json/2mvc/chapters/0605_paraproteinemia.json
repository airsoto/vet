              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "middle to old aged.",
              "pdf_page": 1128,
              "printed_page": 1046,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No sex predilection.",
              "pdf_page": 1128,
              "printed_page": 1046,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Lethargy and weakness.",
              "pdf_page": 1128,
              "printed_page": 1046,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lameness,",
              "pdf_page": 1128,
              "printed_page": 1046,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "paresis.",
              "pdf_page": 1128,
              "printed_page": 1046,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bleeding.",
              "pdf_page": 1128,
              "printed_page": 1046,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Blindness or retinal",
              "pdf_page": 1128,
              "printed_page": 1046,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "hemorrhage.",
              "pdf_page": 1128,
              "printed_page": 1046,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Polyuria and polydipsia.",
              "pdf_page": 1128,
              "printed_page": 1046,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Seizures.",
              "pdf_page": 1128,
              "printed_page": 1046,
              "column": 1
            }
          ]
        },
