    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Monoclonal gammopathy—extramedullary plasmacytoma, lymphoma, lymphocytic leukemia, ehrlichiosis, leishmaniasis, bartonellosis, dirofilariasis, plasmacytic",
              "pdf_page": 1128,
              "printed_page": 1046,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "gastroenteritis, feline stomatitis, feline",
              "pdf_page": 1128,
              "printed_page": 1046,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "infectious peritonitis (FIP).",
              "pdf_page": 1128,
              "printed_page": 1046,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Polyclonal gammopathy—chronic infectious/inflammatory disorders, stomatitis, chronic autoimmune disease, and neoplasia.",
              "pdf_page": 1128,
              "printed_page": 1046,
              "column": 2
            }
          ]
        },
