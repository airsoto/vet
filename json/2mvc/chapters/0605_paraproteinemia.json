        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Multiple myeloma—genetic predisposition, viral infections, chronic immune stimulation,",
              "pdf_page": 1128,
              "printed_page": 1046,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "and carcinogen exposure.",
              "pdf_page": 1128,
              "printed_page": 1046,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lymphoma or leukemia linked to retroviral infections in cats.",
              "pdf_page": 1128,
              "printed_page": 1046,
              "column": 1
            }
          ]
        }
      }
