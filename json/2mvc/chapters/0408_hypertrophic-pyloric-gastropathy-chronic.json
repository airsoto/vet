        "DEFINITION": {
          "present": true,
          "status": "content",
          "source_heading": "DEFINITION",
          "canonical_heading": "DEFINITION",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Pyloric stenosis or chronic hypertrophic pyloric gastropathy is an obstructive narrowing of the pyloric canal resulting from varying degrees of muscular hypertrophy or mucosal hyperplasia.",
              "pdf_page": 796,
              "printed_page": 714,
              "column": 1
            }
          ]
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Can result from a congenital lesion composed primarily of hypertrophy of the smooth muscle or be one of three types of acquired form—primarily circular muscle hypertrophy (type 1), a combination of muscular hypertrophy and mucosal hyperplasia (type 2), or primarily mucosal hyperplasia (type 3).",
              "pdf_page": 796,
              "printed_page": 714,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The cause is unknown; proposed factors include increased gastrin concentrations (which have a trophic effect on the muscle and mucosa) or changes in the myenteric plexus that lead to chronic antral distension and its associated effects.",
              "pdf_page": 796,
              "printed_page": 714,
              "column": 1
            }
          ]
        },
        "SYSTEMS AFFECTED": {
          "present": true,
          "status": "content",
          "source_heading": "SYSTEMS AFFECTED",
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Gastrointestinal (GI)—chronic intermittent vomiting; regurgitation has also been reported.",
              "pdf_page": 796,
              "printed_page": 714,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Musculoskeletal—weight loss.",
              "pdf_page": 796,
              "printed_page": 714,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory—possible aspiration pneumonia.",
              "pdf_page": 796,
              "printed_page": 714,
              "column": 1
            }
          ]
        },
