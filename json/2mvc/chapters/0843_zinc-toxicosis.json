    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Rapid removal of the zinc object by endoscopy or laparotomy/gastrotomy.",
          "pdf_page": 1519,
          "printed_page": 1437,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "IV fluid therapy—maintain hydration and",
          "pdf_page": 1519,
          "printed_page": 1437,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "diuresis.",
          "pdf_page": 1519,
          "printed_page": 1437,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Severe intravascular hemolysis may require blood transfusion(s)/packed RBCs/oxygen-carrying substances.",
          "pdf_page": 1519,
          "printed_page": 1437,
          "column": 2
        }
      ],
