  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Toxicity results from the ingestion of",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "zinc-containing material.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Many zinc compounds: zinc carbonate and zinc gluconate (dietary supplements), zinc chloride (deodorants), zinc pyrithione (shampoos), zinc acetate (throat lozenges), zinc oxide (sunblock, Desitin, calamine lotion), zinc sulfide (paints), metallic zinc (coins).",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Causes gastrointestinal (GI) inflammation and intravascular hemolytic anemia; may cause multiple organ failure (e.g., renal, hepatic, pancreatic, and cardiac), disseminated intravascular coagulation (DIC), and cardiopulmonary arrest.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
        "PATHOPHYSIOLOGY": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": []
        },
        "SYSTEMS AFFECTED": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": []
        },
        "GENETICS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GENETICS",
          "content_blocks": []
        },
        "INCIDENCE/PREVALENCE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "INCIDENCE/PREVALENCE",
          "content_blocks": []
        },
        "GEOGRAPHIC DISTRIBUTION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GEOGRAPHIC DISTRIBUTION",
          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Most frequently reported in small-breed dogs less than 30 pounds (small pylorus retains zinc object or dose response); can occur in all species, all sizes.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Onset of signs varies depending on the form of zinc, stomach acidity, and nutritional status",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "of the patient.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Initial signs due to the irritant nature of the zinc chloride salts on the GI mucosa, causing vomiting, diarrhea, anorexia",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "and lethargy.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Later signs associated with intravascular hemolysis and potential pancreatic, hepatic and renal damage; may include continued vomiting/diarrhea/anorexia, pale or icteric mucous membranes, dehydration, tachypnea, pigmenturia, abdominal discomfort, orange-tinged feces, melena.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Toxic doses not well defined; unreferenced median lethal oral dose of “zinc salts” is 100",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "mg/kg.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Toxicities result from ingestion of zinc-containing material: US pennies minted after 1982 (most common source), hardware (e.g., nuts, bolts), staples, galvanized metal (e.g., nails), boardgame pieces, zippers, toys, jewelry, holiday garland, bra clasps and hooks, animal identification tags, fixtures, buttons.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Brass—alloy of copper and zinc.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Organic forms of zinc (e.g., zinc oxide) generally cause GI inflammation and self-limiting vomiting.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Stomach acidity promotes rapid leaching of zinc from the ingested substance, allowing zinc to be absorbed.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "GI upset—viral, bacterial, parasitic, immune-mediated, foreign body, liver or",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "renal disease, pancreatitis.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intravascular hemolysis—immune-mediated hemolytic",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "anemia,Babesia,Alliumspp. (onion, garlic, chive, leek, shallot), copper, mothball toxicosis (naphthalene), caval syndrome, acetaminophen, coral snake venom, pit viper venom, brown recluse spider venom, mushrooms, overhydration, skunk spray, propylene glycol.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Hemolytic anemia, with possible Heinz body formation (30% of cases)—PCV drops",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "rapidly.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Regeneration will occur if enough",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "time.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Target cells.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Spherocytosis—mild and often inconsistent (20% of cases).",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hemoconcentration due to dehydration",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "(prior to hemolysis).",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Leukocytosis with",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "neutrophilia.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hemoglobinemia.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bilirubinemia.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "High AST, ALP; less common elevations in GGT and ALT.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Elevated amylase and lipase.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Proteinuria,",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "granular casts.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pigmenturia.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Azotemia— (prerenal or renal).",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Serum zinc levels often >5 ppm (normal dog/cat range: 0.70–2 ppm). Use non-zinccontaminated blood tubes for collection.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Coagulation panel: may indicate DIC.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Frequent monitoring of PCV.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal imaging:mayreveal metallic",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "object(s) in the GI tract.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Often the zinc object has passed by the time the patient is admitted.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "ECG—may reveal arrhythmias and ST-segment abnormalities.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": false,
