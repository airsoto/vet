    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Chelation therapy shouldnotbe warranted once the source of the zinc is removed. Zinc levels drop fairly rapidly (few to several days) via excretion into bile, pancreatic secretions,",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "and urine.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CaEDTA 100 mg/kg diluted in 5% dextrose SC, divided into 4 doses per day (as for lead poisoning) if clinical improvement or reduced serum zinc is not accomplished by removal of zinc objects. Not commonly used and is potentially nephro-",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "toxic.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Penicillamine 110 mg/kg/day PO",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "q6–8h for 5–14 days (as for lead poisoning) if clinical improvement or reduced serum zinc is not accomplished by removal of zinc objects.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Safer chelator to use.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Heparin 150 U/kg SC",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "q6h, for DIC.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "H2-receptor antagonists (e.g., cimetidine, ranitidine, famotidine), proton pump inhibitors (e.g., omeprazole), sucralfate, and antacids used alone or in combination may help reduce irritation and stomach acidity and the rate of release and absorption of zinc.",
              "pdf_page": 1519,
              "printed_page": 1437,
              "column": 3
            }
          ]
        },
