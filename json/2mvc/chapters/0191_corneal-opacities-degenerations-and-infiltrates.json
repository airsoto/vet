        },
        "GENETICS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GENETICS",
          "content_blocks": []
        },
        "INCIDENCE/PREVALENCE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "INCIDENCE/PREVALENCE",
          "content_blocks": []
        },
        "GEOGRAPHIC DISTRIBUTION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GEOGRAPHIC DISTRIBUTION",
          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Primarily in dogs, uncommon in cats. Lipid deposition most common in geriatric dogs. May be associated with systemic hyperlipoproteinemia.",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Lipid deposits—gray-white or crystalline;",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "band-shaped, irregular, or circular.",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Calcium deposits—dense white to crystalline; irregular, punctate to band-shaped lesions in the",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "superficial stroma.",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Frequently associated with inflammatory disorders such as keratitis or",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "uveitis.",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Corneal vascularization, edema, and",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "pigmentation often present.",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "With progression the cornea may develop a roughened appearance; disruption of epithelium can lead",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "to ulceration.",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Associated ocular conditions that may lead to corneal degeneration—corneal scars, keratoconjunctivitis sicca (KCS), exposure keratitis, chronic uveitis, episcleritis, phthisis bulbi, chronic topical steroid therapy,",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "limbal neoplasia.",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "When lipid deposition occurs secondary to hyperlipoproteinemia, perilimbal annular ring may form with clear zone between affected cornea and limbus; often bilateral but may be asymmetric; vascularization is variable.",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Lipid—hyperlipoproteinemia may increase risk or worsen existing deposits; can be secondary to hypothyroidism, diabetes mellitus, hyperadrenocorticism, diet, pancreatitis, nephrotic syndrome, liver disease, hyperlipidemia of miniature",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "schnauzers.",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Calcium—hypercalcemia, hyperphosphatemia, hypervitaminosis D,",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "hyperadrenocorticism, uremia.",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lipid and calcium deposits are frequently seen together.",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Corneal scar—nonpainful lesion, gray to white; fluorescein negative; relatively smooth",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "corneal surface; distinct margins.",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Corneal stromal dystrophies—bilateral, often symmetric foci of gray to white deposition, distinct margins; heritable, not associated with ocular inflammation; do not retain fluorescein stain; often occur away from the",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "limbus.",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Edema—bluish to gray; usually",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "CONTRAINDICATIONS/POSSIBLE",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "homogeneous; varies in size depending on",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 2,
              "subheading": "CONTRAINDICATIONS/POSSIBLE"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "severity; indistinct margins; can retain",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 2,
              "subheading": "CONTRAINDICATIONS/POSSIBLE"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "COMPLICATIONS",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "fluorescein stain if corneal erosion/ulceration",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 2,
              "subheading": "COMPLICATIONS"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Topical corticosteroids—not recom-",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 2,
              "subheading": "COMPLICATIONS"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "present.",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 2,
              "subheading": "COMPLICATIONS"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Corneal ulcer—ocular pain, retains",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 2,
              "subheading": "COMPLICATIONS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "mended, may worsen severity; contraindi-",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 2,
              "subheading": "COMPLICATIONS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "fluorescein stain, varying degrees of edema",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 2,
              "subheading": "COMPLICATIONS"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "cated with corneal ulceration.",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 2,
              "subheading": "COMPLICATIONS"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Topical",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 2,
              "subheading": "COMPLICATIONS"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "around the lesion.",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 2,
              "subheading": "COMPLICATIONS"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inflammatory cell",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 2,
              "subheading": "COMPLICATIONS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "atropine—contraindicated with KCS,",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 2,
              "subheading": "COMPLICATIONS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "infiltrates—ocular pain, gray to tan to yellow",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 2,
              "subheading": "COMPLICATIONS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "glaucoma, lens luxations.",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 2,
              "subheading": "COMPLICATIONS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "with indistinct margins; cytologic examination",
              "pdf_page": 418,
