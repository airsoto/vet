  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Acquired corneal disorder characterized by lipid or calcium deposition. May be unilateral or bilateral, have distinct margins, and occur secondary to other ocular or systemic disorders.",
              "pdf_page": 418,
              "printed_page": 336,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
