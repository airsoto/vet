              "subheading": "INTERACTIONS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "oxidase inhibitors, clonidine, anticonvulsants,",
              "pdf_page": 98,
              "printed_page": 16,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "furunculosis, perihidradenitis, hidradenitis,",
              "pdf_page": 98,
              "printed_page": 16,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "oral anticoagulants, steroid hormones, anti-",
              "pdf_page": 98,
