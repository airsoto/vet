        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Anything causing local irritation or lesion may initiate lick–itch cycle.",
              "pdf_page": 98,
              "printed_page": 16,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Associated diseases: staphylococcal furunculosis, hypersensitivity, endocrinopathy, demodicosis, dermatophytosis, foreign body reaction, neoplasia, underlying joint disease or arthritis, trauma, neuropathy, psychogenic, or sensory nerve dysfunction.",
              "pdf_page": 98,
              "printed_page": 16,
              "column": 1
            }
          ]
        }
      }
    },
