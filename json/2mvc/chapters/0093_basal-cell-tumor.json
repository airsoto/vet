    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Complete surgical excision is usually curative and associated with an excellent prognosis.",
          "pdf_page": 247,
          "printed_page": 165,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Majority of tumors are locally confined and nonmetastatic. Long-term follow-up is generally unnecessary.",
          "pdf_page": 247,
          "printed_page": 165,
          "column": 2
        }
      ],
