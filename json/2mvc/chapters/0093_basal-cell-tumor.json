  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Originates from the basal epithelial cells of both epidermal and adnexal origin.",
              "pdf_page": 247,
              "printed_page": 165,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Majority of them are benign (e.g., basal cell epithelioma and basaloid tumor), with smaller occurrences of malignant (e.g., basal cell carcinoma) tumors.",
              "pdf_page": 247,
              "printed_page": 165,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metastasis is rare with the benign forms, and uncommon with malignant.",
              "pdf_page": 247,
              "printed_page": 165,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
        "PATHOPHYSIOLOGY": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": []
        },
        "SYSTEMS AFFECTED": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": []
        },
        "GENETICS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GENETICS",
          "content_blocks": []
        },
        "INCIDENCE/PREVALENCE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "INCIDENCE/PREVALENCE",
          "content_blocks": []
        },
        "GEOGRAPHIC DISTRIBUTION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GEOGRAPHIC DISTRIBUTION",
          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Most common skin tumor in cats (10–26%) and second to third most common skin tumor in dogs (4–12%).",
              "pdf_page": 247,
              "printed_page": 165,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Median age—dogs, 6–9 years; cats, 10–11 years.",
              "pdf_page": 247,
              "printed_page": 165,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cocker spaniels, Kerry blue terriers, Siberian huskies, English springer spaniels, and poodles are predisposed for dogs. Persian, British Blue, Norwegian Forest Cat, Himalayan, and Siamese are predisposed for cats.",
              "pdf_page": 247,
              "printed_page": 165,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Solitary, well-circumscribed, firm, often hairless, intradermal raised mass, typically located on the head, neck, limbs, or shoulders.",
              "pdf_page": 247,
              "printed_page": 165,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Can vary greatly in size from a few millimeters to many centimeters in diameter.",
              "pdf_page": 247,
              "printed_page": 165,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Feline basal cell tumors are frequently heavily pigmented, and occasionally cystic or ulcerated.",
              "pdf_page": 247,
              "printed_page": 165,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Breed (see Signalment).",
              "pdf_page": 247,
              "printed_page": 165,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Contrary to human basal cell tumors, chronic ultraviolet exposure does not appear to play a role in pets.",
              "pdf_page": 247,
              "printed_page": 165,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Possible association with papillomavirus in dogs and cats.",
              "pdf_page": 247,
              "printed_page": 165,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other skin tumors including mast cell tumor, extramedullary plasmacytoma, melanoma, hemangioma, hemangiosarcoma, histiocytoma.",
              "pdf_page": 247,
              "printed_page": 165,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Melanoma is an especially important differential with the pigmented feline basal cell tumors.",
              "pdf_page": 247,
              "printed_page": 165,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intradermal cysts.",
              "pdf_page": 247,
              "printed_page": 165,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
