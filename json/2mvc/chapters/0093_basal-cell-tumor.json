        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytologic evaluation of fine-needle aspiration sample reveals aggregates of round cells with basophilic cytoplasm; mitoses are not uncommon despite benign nature. In basal cell carcinomas, mitotic activity may be low to high with atypical mitotic figures.",
              "pdf_page": 247,
              "printed_page": 165,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "When clinically indicated, fine-needle aspiration of draining lymph nodes to confirm or deny the presence of regional metastases.",
              "pdf_page": 247,
              "printed_page": 165,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Histopathologic examination required for definitive diagnosis; when highly pigmented, immunohistochemistry occasionally required to differentiate from melanoma.",
              "pdf_page": 247,
              "printed_page": 165,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Histologic cellular patterns vary from solid to cystic to ribbon appearance.",
              "pdf_page": 247,
              "printed_page": 165,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tumor cells may contain melanin pigment ation; may have a fine eosinophilic stroma.",
              "pdf_page": 247,
              "printed_page": 165,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nuclear criteria might help predict risk of local recurrence in feline basal cell carcinomas.",
              "pdf_page": 247,
              "printed_page": 165,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgical excision treatment of choice and generally curative for fully resectable tumors.",
          "pdf_page": 247,
          "printed_page": 165,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Cryosurgery or plesiotherapy with strontium-90 can be used for smaller, superficial lesions (<1 cm).",
          "pdf_page": 247,
          "printed_page": 165,
          "column": 2
        }
      ],
