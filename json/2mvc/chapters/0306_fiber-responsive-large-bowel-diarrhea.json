    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Patient monitoring requires periodic assessment of stool quality, performed during recheck office examinations or via telephone interviews.",
          "pdf_page": 611,
          "printed_page": 529,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "If stresses were initially identified, stress reduction should be attempted.",
          "pdf_page": 611,
          "printed_page": 529,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "If abnormal personality traits were initially identified, they should be modified.",
          "pdf_page": 611,
          "printed_page": 529,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Dietary soluble fiber supplementation can occasionally produce excessive flatulence, which can be managed by reduction in fiber dosage.",
          "pdf_page": 611,
          "printed_page": 529,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Prognosis is very favorable, as approximately 85% of dogs have excellent or very good long-term response to fiber supplementation.",
          "pdf_page": 611,
          "printed_page": 529,
          "column": 3
        }
      ],
