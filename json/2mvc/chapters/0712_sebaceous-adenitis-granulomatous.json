  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "A destructive inflammatory disease process directed against cutaneous adnexal structures (sebaceous glands).",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May be genetically inherited, immunemediated, or metabolic.",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Initial defect—a keratinization disorder or an abnormality in lipid metabolism (accumulation of toxic intermediate metabolites).",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
