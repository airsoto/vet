          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Young adult to middle-aged dogs; very rare in cats.",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Two forms—long- and short-coated breeds (short-coated form now called “idiopathic pyogranulomatous periadnexal dermatitis”).",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Predisposed—standard poodle, Akita, Samoyed, German shepherd dog, Havanese, Bernese Mountain dog and vizsla.",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Long-Coated Breeds",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Symmetrical, partial alopecia.",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1,
              "subheading": "Long-Coated Breeds"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dull, brittle hair.",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1,
              "subheading": "Long-Coated Breeds"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tightly adherent silver-white scale.",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1,
              "subheading": "Long-Coated Breeds"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Follicular casts around hair shaft (“keratin-",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1,
              "subheading": "Long-Coated Breeds"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "collaring”).",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1,
              "subheading": "Long-Coated Breeds"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Small tufts of matted hair.",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1,
              "subheading": "Long-Coated Breeds"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lesions—often first observed along dorsal",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1,
              "subheading": "Long-Coated Breeds"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "midline and dorsum of the head.",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1,
              "subheading": "Long-Coated Breeds"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Severe—secondary bacterial folliculitis,",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1,
              "subheading": "Long-Coated Breeds"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "pruritus, and malodor.",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1,
              "subheading": "Long-Coated Breeds"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Akitas—often relatively severely affected;",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1,
              "subheading": "Long-Coated Breeds"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "morbidity associated with deep secondary",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1,
              "subheading": "Long-Coated Breeds"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "bacterial infections.",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1,
              "subheading": "Long-Coated Breeds"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Standard poodles—affected dogs frequently",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1,
              "subheading": "Long-Coated Breeds"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "described as having excellent hair coats prior",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1,
              "subheading": "Long-Coated Breeds"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "to developing lesions; secondary bacterial",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1,
              "subheading": "Long-Coated Breeds"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "folliculitis rare; most patients do not exhibit",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1,
              "subheading": "Long-Coated Breeds"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "systemic illness.",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1,
              "subheading": "Long-Coated Breeds"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Short-Coated Breeds",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Alopecia—moth-eaten, circular, or diffuse.",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1,
              "subheading": "Short-Coated Breeds"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mild scaling.",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1,
              "subheading": "Short-Coated Breeds"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lesions often plaque-like.",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1,
              "subheading": "Short-Coated Breeds"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affects the trunk, head, and pinnae.",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1,
              "subheading": "Short-Coated Breeds"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary bacterial folliculitis rare.",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1,
              "subheading": "Short-Coated Breeds"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lesions can produce significant scarring.",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 1,
              "subheading": "Short-Coated Breeds"
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
