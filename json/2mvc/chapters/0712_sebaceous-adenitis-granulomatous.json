              "printed_page": 1224,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bacterial folliculitis. needed for maintenance; rarely used.",
              "pdf_page": 1306,
              "printed_page": 1224,
              "column": 2
            },
            {
              "type": "bullet",
