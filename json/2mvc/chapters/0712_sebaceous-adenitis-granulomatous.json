      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "paragraph",
          "level": 0,
          "text": "500 mg PO q8h>10 kg with vitamin E.",
          "pdf_page": 1306,
          "printed_page": 1224,
          "column": 2
        }
      ],
      "subsections": {
