        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cryptorchidism.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Testicular neoplasia (most commonly Sertoli cell tumors and seminomas).",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "High physical exertion.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exuberant libido and expression of sexual behaviors.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            }
          ]
        }
      }
