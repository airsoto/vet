        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Intact male animals.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Higher incidence in cryptorchid males.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rare in dogs.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Very rare (but reported) in cats.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mean age 6–8 years (dogs).",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cases of testicular torsion in both young (<10 months) and old (>10 years) dogs have been reported.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal pain.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyporexia/anorexia.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vomiting.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lethargy.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hind limb lameness.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pyrexia.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dysuria.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hematuria.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diarrhea.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Scrotal edema.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inguinal swelling.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bilateral symmetric alopecia (secondary to Sertoli cell tumor).",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Feminization (secondary to Sertoli cell tumor).",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            }
          ]
        },
