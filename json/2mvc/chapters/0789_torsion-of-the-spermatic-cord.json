        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Abdominal Ultrasonography",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary to torsion, the affected testis",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 2,
              "subheading": "Abdominal Ultrasonography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "typically appears hypoechoic in comparison",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 2,
              "subheading": "Abdominal Ultrasonography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "to the contralateral (unaffected) testis.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 2,
              "subheading": "Abdominal Ultrasonography"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The diameter of the spermatic cord may be",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 2,
              "subheading": "Abdominal Ultrasonography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "enlarged.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 2,
              "subheading": "Abdominal Ultrasonography"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The affected testis may be spherical in",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 2,
              "subheading": "Abdominal Ultrasonography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "shape, as opposed to ovoid.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 2,
              "subheading": "Abdominal Ultrasonography"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Color Doppler ultrasound is very useful to",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 2,
              "subheading": "Abdominal Ultrasonography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "visualize blood flow (or lack thereof).",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 2,
              "subheading": "Abdominal Ultrasonography"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Abdominal Radiographs",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Nonspecific for diagnosing testicular torsion",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 2,
              "subheading": "Abdominal Radiographs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "but valuable in assessing differential",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 2,
              "subheading": "Abdominal Radiographs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "diagnoses.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 2,
              "subheading": "Abdominal Radiographs"
            }
          ]
