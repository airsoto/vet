  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Testicular torsion (also known as torsion of the spermatic cord) results from twisting of the spermatic cord which leads to occlusion of venous outflow from the testis.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prolonged occlusion leads to ischemia, infarction, and necrosis.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominally retained testes are at greater risk of torsion, thought to be because of increased range of motion as compared to testes confined to the scrotum.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neoplastic testes, with increased weight, also have a greater likelihood of undergoing torsion.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Torsion of descended (scrotal) testes has also been described.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Systems affected—reproductive.",
              "pdf_page": 1427,
              "printed_page": 1345,
              "column": 1
            }
          ]
        },
