        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Hemorrhage is the only associated abnormality. Morbidity and mortality are caused by blood loss or hemorrhage into critical sites (i.e., CNS, respiratory tract).",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 3
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Transfusion of fresh whole blood, fresh plasma, fresh frozen plasma, and cryopreci pitate will supply VWF.",
          "pdf_page": 1511,
          "printed_page": 1429,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Component therapy (fresh frozen plasma, 10–12 mL/kg, IV) or cryoprecipitate (1 unit per 10 kg body weight, IV) is best for surgical prophylaxis and non-anemic patients, to prevent red cell sensitization and volume overload.",
          "pdf_page": 1511,
          "printed_page": 1429,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Patients with severe VWD may require repeated transfusions to control or prevent hemorrhage.",
          "pdf_page": 1511,
          "printed_page": 1429,
          "column": 3
        }
      ],
