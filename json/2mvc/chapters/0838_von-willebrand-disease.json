              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "a single type predominates within each",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "affected breed.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Type 1 VWD (mild to moderate signs)—",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "quantitative deficiency. Low VWF concentra-",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "tion (VWF:Ag )with proportionate decrease",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "in VWF function. Type 1 is the most",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "common classification:",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Breeds—Airedale terrier, Akita, basset",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hound, Bernese mountain dog, dachshund,",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Doberman pinscher, German shepherd dog,",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "golden retriever, greyhound, Irish wolfhound,",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Manchester terrier, miniature pinscher,",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Pembroke Welsh corgi, poodle, and",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "sporadic cases in other purebred and",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "mixed-breed dogs.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 1,
              "subheading": "Breed Predilections"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Type 2 VWD (severe signs)—quantitative",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and functional protein defect; low VWF:Ag",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "with profound lack of activity due to absence",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "of high MW multimers:",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2,
              "subheading": "Breed Predilections"
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Breeds—German wirehaired and",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "shorthaired pointers.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2,
              "subheading": "Breed Predilections"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Type 3 VWD (severe signs)—complete lack",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "of plasma VWF:",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2,
              "subheading": "Breed Predilections"
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Breeds—Chesapeake Bay retriever, Dutch",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "kooiker, Scottish terrier, Shetland sheepdog,",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2,
              "subheading": "Breed Predilections"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and sporadic cases in dogs of other breeds.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2,
              "subheading": "Breed Predilections"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Mean Age and Range",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Severe (types 2 and 3 VWD) typically",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2,
              "subheading": "Mean Age and Range"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "manifests by 3–6 months of age.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2,
              "subheading": "Mean Age and Range"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Milder forms typically demonstrate",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2,
              "subheading": "Mean Age and Range"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "abnormal bleeding after surgery or trauma, or",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2,
              "subheading": "Mean Age and Range"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "in association with another condition that",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2,
              "subheading": "Mean Age and Range"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "impairs hemostasis.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2,
              "subheading": "Mean Age and Range"
            }
          ]
        },
