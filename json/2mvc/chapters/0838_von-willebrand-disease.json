              "printed_page": 1429,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hematuria, vaginal hemorrhage, gingival",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hemorrhage.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prolonged bleeding after surgery or trauma.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
