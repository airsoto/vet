        "DEFINITION": {
          "present": true,
          "status": "content",
          "source_heading": "DEFINITION",
          "canonical_heading": "DEFINITION",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary hemostatic defect caused by a quantitative or functional deficiency of von Willebrand factor (VWF).",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical expression varies from a mild to severe bleeding diathesis.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 1
            }
          ]
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "VWF is an adhesive plasma protein required for platelet binding at sites of small vessel injury. In addition, plasma VWF is a carrier protein for coagulation factor VIII.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "A lack of VWF impairs platelet adhesion and aggregation, especially at vascular sites under high shear stress (e.g., arterial vessels). The largest molecular weight (MW) forms of VWF demonstrate highest reactivity in supporting platelet–collagen interactions.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 1
            }
          ]
        },
        "SYSTEMS AFFECTED": {
          "present": true,
          "status": "content",
          "source_heading": "SYSTEMS AFFECTED",
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "VWF deficiency may cause spontaneous hemorrhage, prolonged post-traumatic hemorrhage, and ultimately blood-loss anemia.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Spontaneous hemorrhage—typically manifests as bleeding from mucosal surfaces.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 1
            }
          ]
        },
        "GENETICS": {
          "present": true,
          "status": "content",
          "source_heading": "GENETICS",
          "canonical_heading": "GENETICS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "An autosomal trait; both males and females express and transmit the defect with equal frequency.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Expression pattern of severe forms (types 2 and 3 von Willebrand disease [VWD]) is recessive; the milder form (type 1 VWD) appears to be recessive or incomplete dominant.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 1
            }
          ]
        },
        "INCIDENCE/PREVALENCE": {
          "present": true,
          "status": "content",
          "source_heading": "INCIDENCE/PREVALENCE",
          "canonical_heading": "INCIDENCE/PREVALENCE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "The most common hereditary hemostatic defect in dogs.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rarely reported in cats.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 1
            }
          ]
        },
