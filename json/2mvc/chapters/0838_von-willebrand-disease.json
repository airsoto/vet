    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Thrombocytopenia.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acquired coagulation factor deficiency (often associated with liver disease, vitamin K deficiency, or disseminated intravascular coagulation [DIC]).",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acquired platelet function defects (often associated with drug therapy, uremia, hyperproteinemia).",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hereditary coagulation factor deficiencies (see Coagulation Factor Deficiency).",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hereditary platelet function defects (see Thrombocytopathies).",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Regenerative anemia develops after blood loss.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Platelet count is normal unless the patient has experienced acute, massive bleeding.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Coagulation screening tests (activated clotting time, activated partial thromboplastin time, prothrombin time, thrombin clot time,",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "fibrinogen concentration)—within reference intervals.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical diagnosis based on specific measurement of plasma VWF:Ag:",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "VWF:Ag <50% indicates VWF",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "deficiency, but clinical signs of abnormal bleeding typically develop in animals with VWF:Ag<25%.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Types 1 and 2 VWD are characterized by",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "low VWF:Ag, whereas type 3 VWD is defined as a complete absence of detectable protein (VWF:Ag <0.1%).",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Types 1 and 2 VWD are differentiated with functional and/or structural VWF analyses:",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Von Willebrand factor collagen binding",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "assay (VWF:CBA) is a functional measure of VWF/collagen affinity. Dogs with type 2 VWD have a relative lack of VWF:collagen binding activity (CBA) compared to VWF:Ag, resulting in a protein concentration to function ratio >2:1. Dogs with type 1 VWD have proportionate protein concentration and function.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "VWF multimer structure is visualized on Western blots. Dogs with type 2 VWD lack the highest MW forms.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 3
            }
          ]
        },
        "IMAGING": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "IMAGING",
          "content_blocks": []
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Buccal mucosal bleeding time (BMBT) and the platelet function analyzer-100 are point-of-care screening tests whose endpoints are prolonged in patients with platelet aggregation defects or VWF deficiency. Prolongation is also found in patients with thrombocytopenia, anemia, or changes in blood viscosity.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "BMBT (expected values 2–4 minutes)— typical values for type 1 VWD = 5–10 minutes, types 2 and 3 VWD >12 minutes.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "PFA-100 closure times (expected ADP/collagen closure time <120 seconds): typical values for type 1 VWD = 150–300 seconds, types 2 and 3 VWD >300 seconds.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 3
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
