    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Desmopressin acetate (DDAVP) is a vasopressin analogue that can be given preoperatively to dogs with mild to moderate type 1 VWD to enhance surgical hemostasis. Dosage is 1μg/kg SC, given 30 minutes before surgery.",
              "pdf_page": 1512,
              "printed_page": 1430,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Response is variable; transfusion should be available if DDAVP alone does not prevent bleeding.",
              "pdf_page": 1512,
              "printed_page": 1430,
              "column": 1
            }
          ]
        },
        "CONTRAINDICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS",
          "canonical_heading": "CONTRAINDICATIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Avoid drugs with anticoagulant or antiplatelet effects: NSAIDs, sulfonamide antibiotics, heparin, wafarin, hetastarches, estrogen, cytotoxic drugs.",
              "pdf_page": 1512,
              "printed_page": 1430,
              "column": 1
            }
          ]
        },
