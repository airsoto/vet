              "subheading": "Physical Examination Findings"
            }
          ]
        },
        "CAUSES": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES",
          "canonical_heading": "CAUSES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Hereditary VWD is caused by mutations that impair VWF synthesis, release, or stability.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2
            }
          ]
        },
        "RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "RISK FACTORS",
          "canonical_heading": "RISK FACTORS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Acquired disease conditions or drug therapy that impair platelet function may exacerbate clinical signs of VWD.",
              "pdf_page": 1511,
              "printed_page": 1429,
              "column": 2
            }
          ]
        },
