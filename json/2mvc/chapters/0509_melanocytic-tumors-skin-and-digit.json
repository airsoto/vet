        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—around 5% of all skin tumors.",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—<5% of all skin tumors.",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs, mean age 9 years, certain breeds more common—terriers (Scottish, Boston, and Airedale), schnauzers, cocker and springer spaniels, Irish setter, chow chow, retriever",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "breeds, poodles, Doberman pinschers.",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats, mean age 10–13 years, no breed predilection.",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Skin mass with variable growth rates, may be ulcerated and friable, usually solitary.",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Develops anywhere; in dogs more common on face, trunk, feet, and scrotum; in cats more common on head, digit, pinna, and nose.",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Benign—brown to black; varies from macules and plaques to firm, dome-shaped nodules, 0.5–2 cm in diameter, well",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "demarcated.",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Malignant—amelanotic to dark brown, gray, or black, often >2 cm in diameter and more invasive in surrounding tissues.",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lameness and pain if digit is involved and associated with infection or bone lysis.",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Regional lymphadenomegaly possible.",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 1
            }
          ]
        },
