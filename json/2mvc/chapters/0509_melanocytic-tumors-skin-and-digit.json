        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiography recommended for",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "evaluation of distant metastasis.",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Advanced imaging (CT scan) is more sensitive to detect",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "smaller distant metastases.",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "With digital melanoma, radiography of the lesion is recommended to determine if underlying bone (P3) is involved; bone lysis is less common with nailbed melanoma (approximately 10%) compared with squamous cell carcinoma (approximately 75%).",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 1
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytologic examination of fine-needle aspirates (primary mass, draining lymph",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "nodes).",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Draining lymph nodes should be evaluated with cytology, regardless of their",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 2
            }
          ]
        },
