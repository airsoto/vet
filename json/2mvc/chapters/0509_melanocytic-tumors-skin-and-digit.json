      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Benign or malignant neoplasm arising from melanocytes within the epidermis or the nail",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "bed.",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anatomic site is highly predictive of",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "invasiveness and metastatic propensity:",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Digit",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and mucocutaneous junction melanomas tend",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "to be malignant.",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Melanomas of haired-skin",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "tend to behave in benign manner.",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "When malignant—occasionally invades bone (e.g., third phalanx) and metastasizes (lymph node, lungs, and other sites).",
              "pdf_page": 970,
              "printed_page": 888,
              "column": 1
            }
          ]
        },
