    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Mildly affected (alert and appetent)—may resolve with appropriate carbohydrate intake; feed an energy-dense diet ad libitum.",
          "pdf_page": 1207,
          "printed_page": 1125,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Moderately affected (clinically ill)— dextrose IV (0.5 g/kg IV bolus, may also be added to isotonic crystalloid fluids to a total concentration of 2.5% or 5% dextrose, and administer as constant IV infusion); tailor therapy to maintain euglycemia and prevent swings in blood glucose; taper treatment slowly as patient oral intake increases.",
          "pdf_page": 1207,
          "printed_page": 1125,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Severely affected (nonresponsive to above therapy)—termination of pregnancy or cesarean section.",
          "pdf_page": 1207,
          "printed_page": 1125,
          "column": 2
        }
      ],
