      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Fibrosarcoma (FSA) is a malignant tumor of spindle cells that produce varying amounts of collagenous (fibrous) extracellular matrix and associated stroma.",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In dogs, FSA accounts for up to 5% of all canine sinonasal tumors.",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nasal FSA uncommon in cats.",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1
            }
          ]
        },
