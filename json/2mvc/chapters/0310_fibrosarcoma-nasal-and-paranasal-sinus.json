        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "In dogs, no breed or gender predilections identified. Median age 9 years (range: 1–16 years).",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Uncommon in cats—no identified predilections.",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intermittent unilateral epistaxis and/or",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "mucopurulent discharge, may progress to",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "bilateral involvement.",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sneezing, stertorous breathing, and/or facial",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "deformity.",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Decreased appetite and/or halitosis",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "secondary to oral cavity invasion.",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Seizures, behavior changes, and/or obtundation",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "secondary to cranial invasion (uncommon).",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Epistaxis and/or nasal discharge, initially",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "unilateral but can progress to bilateral.",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Decreased nasal air flow (unilateral or bilateral).",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pain on nasal or paranasal sinus palpation",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "or percussion.",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Facial deformity decreased ocular",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "retropulsion, exophthalmia, or epiphora.",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Visible mass effect protruding through",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "palate into oral cavity.",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
