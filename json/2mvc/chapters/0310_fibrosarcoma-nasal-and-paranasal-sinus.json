    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other nasal tumors—adenocarcinoma, squamous cell carcinoma, chondrosarcoma, osteosarcoma, lymphoma, transmissible venereal tumor (dogs), nasopharyngeal polyp (cats).",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fungal rhinitis—aspergillosis and penicilliosis (dogs),Cryptococcus(cats), sporotrichosis (both).",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rhinosporidiosis (dogs).",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Foreign body.",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thrombocytopenia or other coagulopathy.",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tooth root abscess or oronasal fistula.",
              "pdf_page": 616,
              "printed_page": 534,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
