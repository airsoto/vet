    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "If bacterial urinary tract infection persists or recurs despite proper antimicrobial therapy, the status of the diverticulum should be reevaluated by contrast radiography.",
              "pdf_page": 1503,
              "printed_page": 1421,
              "column": 2
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Avoid diagnostic procedures or treatments that alter normal host urinary tract defenses and predispose to urinary tract infection.",
              "pdf_page": 1503,
              "printed_page": 1421,
              "column": 2
            }
          ]
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Persistent congenital macroscopic diverticula are risk factors for recurrent bacterial urinary tract infection.",
              "pdf_page": 1503,
              "printed_page": 1421,
              "column": 3
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Congenital microscopic diverticula are usually clinically silent unless complicated by concurrent lower urinary tract disease.",
              "pdf_page": 1503,
              "printed_page": 1421,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acquired macroscopic diverticula typically heal in 2–3 weeks after amelioration of clinical signs of lower urinary tract disease.",
              "pdf_page": 1503,
              "printed_page": 1421,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diverticulectomy and appropriate antimicrobial therapy usually associated with resolution of recurrent urinary tract infections in patients with persistent congenital macroscopic diverticula.",
              "pdf_page": 1503,
              "printed_page": 1421,
              "column": 3
            }
          ]
        }
      }
    },
