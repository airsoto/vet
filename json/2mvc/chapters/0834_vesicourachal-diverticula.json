        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog and cat.",
              "pdf_page": 1503,
              "printed_page": 1421,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Frequently encountered in cats with acquired lower urinary tract diseases; twice as common in male cats as in female cats.",
              "pdf_page": 1503,
              "printed_page": 1421,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No breed or age predisposition.",
              "pdf_page": 1503,
              "printed_page": 1421,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Depend on concomitant disorders predisposing to formation of macroscopic vesicourachal diverticula.",
              "pdf_page": 1503,
              "printed_page": 1421,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Persistent congenital microscopic diverticula—cause unknown.",
              "pdf_page": 1503,
              "printed_page": 1421,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Congenital microscopic diverticula—risk factors for acquired macroscopic diverticula.",
              "pdf_page": 1503,
              "printed_page": 1421,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diseases associated with increased bladder intraluminal pressure (e.g., bacterial urinary tract infection, uroliths, urethral plugs, and idiopathic disease)—risk factors for acquired macroscopic diverticula.",
              "pdf_page": 1503,
              "printed_page": 1421,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Persistent (or patent) urachus; rare— characterized by inappropriate loss of urine through the umbilicus.",
              "pdf_page": 1503,
              "printed_page": 1421,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Persistent urachal ligaments are nonpatent fibrous remnants of the urachus, connecting the bladder vertex to the umbilicus.",
              "pdf_page": 1503,
              "printed_page": 1421,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urachal cysts are focal accumulations of fluid in isolated segments of the urachus. They may be aseptic or septic.",
              "pdf_page": 1503,
              "printed_page": 1421,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Abnormal findings are related to the underlying disorder that causes vesicourachal diverticula, unless complicated by concurrent acquired lower urinary tract diseases.",
              "pdf_page": 1503,
              "printed_page": 1421,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abnormal findings related to secondary urinary tract infection.",
              "pdf_page": 1503,
              "printed_page": 1421,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": []
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Congenital and acquired macroscopic diverticula—best identified by positivecontrast urethrocystography.",
              "pdf_page": 1503,
              "printed_page": 1421,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Radiographs obtained with the bladder completely then partially distended with contrast medium may facilitate detection of small diverticula.",
              "pdf_page": 1503,
              "printed_page": 1421,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "not_applicable",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "N/A",
              "pdf_page": 1503,
              "printed_page": 1421,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Extramural macroscopic diverticula appear as convex or conical luminal projections from the bladder vertex.",
              "pdf_page": 1503,
              "printed_page": 1421,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intramural microscopic diverticula appear as transitional epithelium-lined lumens persisting at the bladder vertex from the level of the submucosa to subserosa.",
              "pdf_page": 1503,
              "printed_page": 1421,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Many macroscopic diverticula in cats (and probably dogs) are acquired and self-limiting if the underlying disease is eliminated.",
          "pdf_page": 1503,
          "printed_page": 1421,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Direct treatment efforts toward eliminating underlying cause(s) of lower urinary tract disease.",
          "pdf_page": 1503,
          "printed_page": 1421,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Consider diverticulectomy if a macroscopic diverticulum persists in a patient with persistent or recurrent bacterial urinary tract infection despite appropriate antimicrobial therapy.",
          "pdf_page": 1503,
          "printed_page": 1421,
          "column": 2
        }
      ],
