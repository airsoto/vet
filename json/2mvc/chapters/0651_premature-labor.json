        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Gravid female dog or cat; no age or breed predilection.",
              "pdf_page": 1208,
              "printed_page": 1126,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Early—often no signs, fetal resorption evident ultrasonographically.",
              "pdf_page": 1208,
              "printed_page": 1126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Late—vulvar discharge: hemorrhagic or lochia, abortion.",
              "pdf_page": 1208,
              "printed_page": 1126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "History of unexplained loss of pregnancy.",
              "pdf_page": 1208,
              "printed_page": 1126,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Often idiopathic; genetics can play a role. Secondary luteolysis results without intervention.",
              "pdf_page": 1208,
              "printed_page": 1126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Myometrial activity inappropriate for stage of pregnancy precedes luteolysis.",
              "pdf_page": 1208,
              "printed_page": 1126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary luteal insufficiency has not been documented.",
              "pdf_page": 1208,
              "printed_page": 1126,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Term gestation, onset of normal labor.",
              "pdf_page": 1208,
              "printed_page": 1126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pathologic loss of pregnancy (see Miscellaneous).",
              "pdf_page": 1208,
              "printed_page": 1126,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually normal.",
              "pdf_page": 1208,
              "printed_page": 1126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anemia of pregnancy can be present, and rarely signs of hemorrhage.",
              "pdf_page": 1208,
              "printed_page": 1126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inflammatory leukogram possible.",
              "pdf_page": 1208,
              "printed_page": 1126,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Serum progesterone: will be <2 ng/mL when resorption/abortion occurs.",
              "pdf_page": 1208,
              "printed_page": 1126,
              "column": 1
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ultrasonographic evaluation of fetal heart rate (stress evidenced by heart rates consistently <170 bpm).",
              "pdf_page": 1208,
              "printed_page": 1126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abnormal morphologic appearance of fetuses in uterus following death (see Web Figures 1 and 2).",
              "pdf_page": 1208,
              "printed_page": 1126,
              "column": 1
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Tocodynamometry is diagnostic—finding >0–2 contractions/hour is not normal for preterm (earlier than 8th week) gestation.",
              "pdf_page": 1208,
              "printed_page": 1126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Progesterone measurement with a quantitative (chemiluminescence, fluorescence enzyme immunoassay) progesterone assay or accurate in house equipment should be performed to detect levels <2.0 ng/mL.",
              "pdf_page": 1208,
              "printed_page": 1126,
              "column": 1
            }
          ]
        },
