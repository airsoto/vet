          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Stress—greatest risk; sporadic outbreaks have occurred in dogs attending shows, in kennels where new dogs frequently intro duced; crowding and unsanitary conditions promote illness.",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "For CCoV, CPCoV—feces primary source of infection; virus shed for 2 weeks.",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "For CRCoV—respiratory secretions, fomites likely sources of infection.",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 2
            }
          ]
        }
      }
