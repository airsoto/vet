      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Canine enteric coronavirus (CCoV)— sporadic outbreaks of enteritis in dogs; worldwide distribution.",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Canine pantropic coronavirus (CPCoV)— variant of CCoV, fatal disease in dogs <6 months, described principally in Europe.",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CCoV, CPCoV—closely related to feline infectious peritonitis (FIP) virus, feline enteric coronavirus.",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Canine respiratory coronavirus (CRCoV)— associated with canine infectious respiratory disease complex (kennel cough); worldwide distribution; genetically and serologically distinct from CCoV.",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Incubation period 1–3 days.",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CCoV infection—usually inapparent; mild to severe enteritis possible; death reported in young pups; infects upper two-thirds of small intestine and associated lymph nodes; crypt cells spared.",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Simultaneous infection with canine parvovirus (CPV)-2 possible; severe, often fatal.",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CPCoV—infects intestinal tract, after short viremia distributes to organs like spleen, lungs, brain.",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Coronaviruses undergo rapid evolution, are highly variable; differences in virulence likely between isolates.",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1
            }
          ]
        },
