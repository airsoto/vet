          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs of all ages, breeds; disease more severe in young.",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CRCoV infections more common in winter, in shelters.",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Vary greatly—CPCoV virulent isolates cause systemic disease.",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Adults—most infections inapparent.",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Puppies—mild to severe, occasionally fatal, enteritis.",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diarrhea—may be explosive; yellow-green or orange; loose or liquid; typically malodorous",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "(characteristic); may persist for days to>3",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "weeks; may recur; young dogs may suffer",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1,
              "subheading": "(characteristic); may persist for days to>3"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "severe, protracted diarrhea, dehydration.",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1,
              "subheading": "(characteristic); may persist for days to>3"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vomiting.",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1,
              "subheading": "(characteristic); may persist for days to>3"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Coughing, dyspnea—CRCoV associated",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1,
              "subheading": "(characteristic); may persist for days to>3"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "with kennel cough complex.",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1,
              "subheading": "(characteristic); may persist for days to>3"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anorexia, lethargy.",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1,
              "subheading": "(characteristic); may persist for days to>3"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "For CPCoV—pyrexia, anorexia, depression,",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1,
              "subheading": "(characteristic); may persist for days to>3"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "vomiting, hemorrhagic enteritis, respiratory",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1,
              "subheading": "(characteristic); may persist for days to>3"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "distress, and leukopenia that persists>1 week;",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1,
              "subheading": "(characteristic); may persist for days to>3"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "ataxia, seizures, and death also possible.",
              "pdf_page": 290,
              "printed_page": 208,
              "column": 1,
              "subheading": "(characteristic); may persist for days to>3"
            }
          ]
        },
