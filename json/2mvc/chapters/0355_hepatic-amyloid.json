          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Episodic fever and swollen hocks—shar-pei.",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Episodic polyarthropathy, pain, and signs of",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "meningitis—Akita.",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute lethargy, cyclic.",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anorexia and vomiting, episodic.",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Polyuria and polydipsia.",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pallor.",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal effusion—hemorrhage or",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "ascites.",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Jaundice—unusual.",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hepatomegaly with amyloid deposition.",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Edema—due to hypoalbuminemia",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "secondary to pathologic proteinuria.",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Joint pain—Akita, shar-pei syndromes.",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nonlocalized pain, meningeal pain, and",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "abdominal discomfort—with different",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "inflammatory disorders promoting amyloid.",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 2,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
