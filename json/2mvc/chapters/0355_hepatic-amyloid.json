    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Warn client that hepatic amyloidosis is difficult to treat; guarded to poor prognosis.",
          "pdf_page": 691,
          "printed_page": 609,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Dictated by severity of clinical signs.",
          "pdf_page": 691,
          "printed_page": 609,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "No curative treatment; manage underlying disease; colchicine as described below may reduce organ amyloid deposition.",
          "pdf_page": 691,
          "printed_page": 609,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Fluids—for dehydration.",
          "pdf_page": 691,
          "printed_page": 609,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Blood transfusion—for acute blood loss; essential in cats with hepatic amyloid-induced liver lobe rupture.",
          "pdf_page": 691,
          "printed_page": 609,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Diet—individually tailored to organ function.",
          "pdf_page": 691,
          "printed_page": 609,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Liver failure—consider measures appropriate for hepatic encephalopathy as appropriate.",
          "pdf_page": 691,
          "printed_page": 609,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Pathologic proteinuria—see Nephrotic Syndrome.",
          "pdf_page": 691,
          "printed_page": 609,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgical intervention—hepatic lobe resection as emergency measure for catastrophic bleeding from fractured liver lobe in cats; histologic features may describe centrilobular necrosis due to anemia-induced hypoxia; amyloid may be overlooked without special stains.",
          "pdf_page": 692,
          "printed_page": 610,
          "column": 1
        }
      ],
