        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Anemia secondary to hepatic hemorrhage or liver lobe rupture or chronic inflammation.",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Leukocytosis with a left shift during febrile episodes in shar-pei and Akita.",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Normal or high—liver enzymes, total bilirubin, and serum bile acids; may be normal with severe hepatic amyloid deposition.",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Azotemia with severe renal infiltration— glomeruli targeted in dogs (proteinuria), renal interstitium targeted in cats (azotemia).",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Proteinuria—dogs: glomerular amyloid.",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dilute urine—renal involvement or failure.",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Feline systemic amyloidosis—involves multiple organ systems: thyroid, cardiac, renal, intestine, pancreatic, bone marrow, lymph nodes, adrenals.",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 2
            }
          ]
        },
