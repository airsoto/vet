        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—Chinese Shar-Pei, with cyclic “shar-pei fever syndrome”; Akita with cyclic fever and polyarthropathy; collie with “gray collie syndrome”; usually develop renal signs first, although some develop hepatic insufficiency.",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—oriental shorthair, Siamese, Devon",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Rex, domestic shorthair cats; usually<5 years",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "of age when first symptomatic (hepatic signs",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 1,
              "subheading": "Rex, domestic shorthair cats; usually<5 years"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and coagulopathies predominate); familial in",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 1,
              "subheading": "Rex, domestic shorthair cats; usually<5 years"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Abyssinians (renal signs predominate). Upper",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 1,
              "subheading": "Rex, domestic shorthair cats; usually<5 years"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "respiratory viral infection proposed to trigger",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 1,
              "subheading": "Rex, domestic shorthair cats; usually<5 years"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "amyloidosis in Siamese. Cats naturally",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 1,
              "subheading": "Rex, domestic shorthair cats; usually<5 years"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "infected with feline immunodeficiency virus",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 1,
              "subheading": "Rex, domestic shorthair cats; usually<5 years"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(FIV) have been described to have systemic",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 1,
              "subheading": "Rex, domestic shorthair cats; usually<5 years"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "amyloid deposition, with kidneys, liver, and",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 1,
              "subheading": "Rex, domestic shorthair cats; usually<5 years"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "spleen most affected.",
              "pdf_page": 691,
              "printed_page": 609,
              "column": 1,
              "subheading": "Rex, domestic shorthair cats; usually<5 years"
            }
          ]
        },
        "SIGNS": {
          "present": true,
