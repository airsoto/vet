        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog and cat.",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Middle-aged to older animals.",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Teratoma may develop in young patients.",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Bilaterally symmetrical alopecia; pancyto penia; masculinization (hormone-secreting tumors with associated paraneoplastic manifestation).",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Malignant ascites or pleural.",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Effusion (carcinomatosis)—occasionally.",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other signs associated with mass effects of the tumor (abdominal discomfort, compression of adjacent organs).",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Intact sexual status.",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—pointer, English bulldog, boxer, German shepherd dog, and Yorkshire terrier at risk.",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other causes of abdominal effusion including vasculitis and pancreatitis.",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other mid-abdominal masses or gossypiboma (foreign body granuloma).",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ovarian cysts, paraovarian cysts, cystic rete tubules, vascular hematomas, metastatic neoplasia.",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "No consistent abnormalities.",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pancytopenia in dogs with functional estrogen-secreting tumors.",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Serum progesterone—levels >2 mg/mL with functional tumors.",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 1
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal radiography—may reveal unilateral or bilateral mid-abdominal mass at the caudal pole of the kidney or effusion, mineralization of tumor may be seen.",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal ultrasonography—confirm abdominal radiographic findings and provide greater certainty for the origin of mass effect.",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Advanced imaging—CT or MRI can provide detailed assessment for origin and associated tissues that might be involved in disease process.",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiography—may reveal distant metastasis (rare).",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytologic evaluation of pleural or abdominal fluid—may be diagnostic for malignant effusion (carcinomatosis).",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytologic evaluation of tumor—tumor cells may readily implant on the body wall via fine-needle aspirate. Therefore, excisional biopsy is often recommended over fine-needle aspirate of the mass.",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Histopathologic examination—necessary for definitive diagnosis.",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": []
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Ovariohysterectomy—treatment of choice for a solitary mass.",
          "pdf_page": 1101,
          "printed_page": 1019,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Peritoneal transplantation during surgical removal is possible; change gloves and surgical instruments during procedure.",
          "pdf_page": 1101,
          "printed_page": 1019,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Laparoscopic-assisted ovariohysterectomy may be possible for smaller tumors.",
          "pdf_page": 1101,
          "printed_page": 1019,
          "column": 2
        }
      ],
