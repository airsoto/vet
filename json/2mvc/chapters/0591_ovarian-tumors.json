    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Chemotherapy—little information for dogs and cats, no standard therapy.",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cisplatin—successful treatment reported in three dogs and treatment of choice for comparative tumors in human beings.",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 2
            }
          ]
        },
