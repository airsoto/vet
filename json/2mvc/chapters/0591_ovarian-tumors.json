      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Abdominal ultrasonography and thoracic radiography—every 3 months; monitor for recurrence and metastasis.",
          "pdf_page": 1101,
          "printed_page": 1019,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Ovariohysterectomy—prevention.",
          "pdf_page": 1101,
          "printed_page": 1019,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Prognosis—guarded.",
          "pdf_page": 1101,
          "printed_page": 1019,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Chemotherapy—has potential to lengthen survival.",
