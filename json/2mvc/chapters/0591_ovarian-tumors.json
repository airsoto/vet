  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Epithelial (carcinoma), germ cell (dysgerminoma and teratoma), and sex cord stromal (granulosa cell tumor, Sertoli–Leydig cell tumor, thecoma, and luteoma) tumors.",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—rare (0.5–1.2% of tumors); 40% carcinomas, 10% germ cell, and 50% sex cord.",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—rare (0.7–3.6% of tumors); 15% germ cell, and 85% sex cord.",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metastasis common for malignant epithelial and germ cell tumors in the dog and all tumors in cats.",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Some tumors produce hormones resulting in paraneoplastic syndromes.",
              "pdf_page": 1101,
              "printed_page": 1019,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
