        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Serum/plasma cardiac troponin I levels are increased in patients with cardiac hemangiosarcoma and might have utility for the detection of other myocardial neoplasms.",
              "pdf_page": 1016,
              "printed_page": 934,
              "column": 1
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiography—may reveal a globoid heart suggestive of pericardial",
              "pdf_page": 1016,
              "printed_page": 934,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "effusion, masses in the area of the atria, or metastatic lesions in the lungs.",
              "pdf_page": 1016,
              "printed_page": 934,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Echocardiography—helpful in finding primary masses; positive predictive value of 92%, negative predictive values 64%.",
              "pdf_page": 1016,
              "printed_page": 934,
              "column": 2
            }
          ]
        },
