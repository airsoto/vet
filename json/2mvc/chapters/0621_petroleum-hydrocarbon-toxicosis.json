    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Monitor patients for 3–4 days to ensure that ingested hydrocarbons have cleared the gastrointestinal tract and no pulmonary sequelae will occur.",
              "pdf_page": 1157,
              "printed_page": 1075,
              "column": 3
            }
          ]
        },
