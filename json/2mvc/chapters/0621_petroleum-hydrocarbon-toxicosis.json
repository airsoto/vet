        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "The diversity of this class of products precludes absolute prediction, but most hydrocarbon exposures respond well to conservative, supportive therapy.",
              "pdf_page": 1157,
              "printed_page": 1075,
              "column": 3
            }
          ]
        }
