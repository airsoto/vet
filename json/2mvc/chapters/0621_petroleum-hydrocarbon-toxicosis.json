          "canonical_heading": "CLIENT EDUCATION",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Pet owners should be educated about proper storage and use of petroleum products.",
              "pdf_page": 1157,
              "printed_page": 1075,
              "column": 2
            }
          ]
        },
