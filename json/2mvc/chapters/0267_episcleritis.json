  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Focal or diffuse infiltration of episclera and/or scleral stroma by inflammatory cells and fibroblasts.",
              "pdf_page": 540,
              "printed_page": 458,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary—affects only the eye; probably immune mediated; appears either as a perilimbal episcleral/scleral nodule (nodular episcleritis) or as a diffuse thickening of the episclera (diffuse episcleritis); nodular form may affect cornea and third eyelid with nodules.",
              "pdf_page": 540,
              "printed_page": 458,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary—usually diffuse; from spillover of inflammatory cells into the episclera from other ocular disorders (e.g., endophthalmitis and panophthalmitis); may affect virtually any other organ system.",
              "pdf_page": 540,
              "printed_page": 458,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
