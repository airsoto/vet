        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog.",
              "pdf_page": 540,
              "printed_page": 458,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Young to middle-aged collie, Shetland sheepdog.",
              "pdf_page": 540,
              "printed_page": 458,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Nodular—typically appears as a smooth, painless, localized, raised, pink-tan, firm episcleral/scleral mass.",
              "pdf_page": 540,
              "printed_page": 458,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diffuse—less common; appears as a diffuse reddening and thickening of the entire episclera/sclera; accompanied by variable amounts of ocular pain.",
              "pdf_page": 540,
              "printed_page": 458,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary—uveitis often pronounced.",
              "pdf_page": 540,
              "printed_page": 458,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Conjunctiva—usually moves freely over the surface of the lesion.",
              "pdf_page": 540,
              "printed_page": 458,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nodules—tend to be slowly progressive, bilateral, and prone to recurrence.",
              "pdf_page": 540,
              "printed_page": 458,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Nodular and diffuse primary—idiopathic; believed to be immune mediated.",
              "pdf_page": 540,
              "printed_page": 458,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary—may result from deep fungal or bacterial ocular infection, lymphoma, systemic histiocytosis in Bernese mountain dogs, chronic glaucoma, and ocular trauma.",
              "pdf_page": 540,
              "printed_page": 458,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other causes of a red eye—differentiated by complete ophthalmic examination.",
              "pdf_page": 540,
              "printed_page": 458,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other mass-like lesions—differentiated by biopsy or cytologic examination.",
              "pdf_page": 540,
              "printed_page": 458,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neoplasia—lymphoma, squamous cell carcinoma, extension of intraocular mass, other tumors.",
              "pdf_page": 540,
              "printed_page": 458,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Granuloma—deep fungal infection, retained foreign body.",
              "pdf_page": 540,
              "printed_page": 458,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Granulation tissue—trauma, healing corneal ulcer, globe perforation with uveal prolapse.",
              "pdf_page": 540,
              "printed_page": 458,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually normal if lesion is confined to eye or adnexa.",
              "pdf_page": 540,
              "printed_page": 458,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary—may see abnormalities",
              "pdf_page": 540,
              "printed_page": 458,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Azathioprine—may induce potentially fatal consistent with systemic disease. myelosuppression, hepatotoxicosis.",
              "pdf_page": 540,
              "printed_page": 458,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Niacin—do not substitute for niacinamide.",
              "pdf_page": 540,
              "printed_page": 458,
              "column": 2
            }
