    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "All animals in the same household must be treated.",
          "pdf_page": 339,
          "printed_page": 257,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Clip long coats to facilitate treatment.",
          "pdf_page": 339,
          "printed_page": 257,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Weekly baths to remove scale, followed by rinses with an insecticide.",
          "pdf_page": 339,
          "printed_page": 257,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Lime-sulfur rinses—cats, kittens, dogs, and puppies.",
          "pdf_page": 339,
          "printed_page": 257,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Routine flea sprays—not always effective: treat all animals in the home before introducing a new pet.",
          "pdf_page": 339,
          "printed_page": 257,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Environmental treatment with frequent cleanings and insecticide sprays—reduces possibility of reinfestation.",
          "pdf_page": 339,
          "printed_page": 257,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Continue treatment for at least 6–8 weeks to prevent reinfestation from shed eggs.",
          "pdf_page": 339,
          "printed_page": 257,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Combs, brushes, and grooming tools— discard or thoroughly disinfect before reuse.",
          "pdf_page": 339,
          "printed_page": 257,
          "column": 2
        }
