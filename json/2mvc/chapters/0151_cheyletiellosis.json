        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Partial host specificity—dogs:C. yasguri. Cats:C. blakei. Rabbits:C. parasitovorax.",
              "pdf_page": 339,
              "printed_page": 257,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cheyletiellosis should be considered in every animal that shows scaling, with or without pruritus.",
              "pdf_page": 339,
              "printed_page": 257,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Contagion by direct contact or by fomites.",
              "pdf_page": 339,
              "printed_page": 257,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Common sources of infestation—animal shelters, breeders, and grooming facilities.",
              "pdf_page": 339,
              "printed_page": 257,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Adult female mites may survive in the environment up to 10 days.",
              "pdf_page": 339,
              "printed_page": 257,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Eggs can be found on shed hair.",
              "pdf_page": 339,
              "printed_page": 257,
              "column": 1
            }
          ]
        }
      }
