    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "In dogs developing renal insufficiency, monitor renal values until they return to normal.",
          "pdf_page": 659,
          "printed_page": 577,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Some dogs may develop irreversible renal injury requiring lifelong management.",
          "pdf_page": 659,
          "printed_page": 577,
          "column": 3
        },
        {
