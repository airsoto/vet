    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Gastrointestinal decontamination (induction of emesis, administration of activated charcoal) should follow ingestion of grapes or raisins by dogs.",
          "pdf_page": 659,
          "printed_page": 577,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Fluid diuresis (2–3 times maintenance) for minimum of 48 hours is recommended, longer if renal failure develops. Fluid choice may vary with circumstance, but 0.9% NaCl is most commonly recommended.",
          "pdf_page": 659,
          "printed_page": 577,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Monitor serum chemistry values, particularly renal values, for minimum of 72 hours, longer if renal failure develops.",
          "pdf_page": 659,
          "printed_page": 577,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Correct fluid imbalances (e.g., dehydration).",
          "pdf_page": 659,
          "printed_page": 577,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Monitor fluid in/out.",
          "pdf_page": 659,
          "printed_page": 577,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Diuretics (e.g., furosemide, mannitol, dopamine) if oliguria or anuria develops.",
          "pdf_page": 659,
          "printed_page": 577,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Hemodialysis or peritoneal dialysis may be required in anuric patients.",
          "pdf_page": 659,
          "printed_page": 577,
          "column": 2
        }
      ],
