        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs are the only species in which toxicosis has been well described.",
              "pdf_page": 659,
              "printed_page": 577,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No breed, sex, or age predisposition noted.",
              "pdf_page": 659,
              "printed_page": 577,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anecdotal reports of toxicosis in cats and ferrets exist, but data are lacking to confirm.",
              "pdf_page": 659,
              "printed_page": 577,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Vomiting within 24 hours of ingestion; vomitus frequently contains ingested fruit.",
              "pdf_page": 659,
              "printed_page": 577,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diarrhea, anorexia, lethargy, and abdominal pain may occur; stools may contain ingested fruit.",
              "pdf_page": 659,
              "printed_page": 577,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Within 24 hours to several days, dehydration with oliguria or anuria occurs.",
              "pdf_page": 659,
              "printed_page": 577,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Death due to anuric renal failure or euthanasia.",
              "pdf_page": 659,
              "printed_page": 577,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
