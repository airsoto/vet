              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "evidence of renal injury.",
              "pdf_page": 659,
              "printed_page": 577,
              "column": 1,
              "subheading": "toVitis viniferahave resulted in clinical"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ingestion of sultanas, Zante currants, and",
              "pdf_page": 659,
              "printed_page": 577,
