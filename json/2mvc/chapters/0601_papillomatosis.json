    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "α-Interferon—20,000iu PO q24h; various reports of efficacy for the treatment of persistent COPV but studies are lacking regarding dosage and protocol for",
              "pdf_page": 1121,
              "printed_page": 1039,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "administration.",
              "pdf_page": 1121,
              "printed_page": 1039,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Imiquimod—applied to",
              "pdf_page": 1121,
              "printed_page": 1039,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "lesions 3 times/week for 4 weeks.",
              "pdf_page": 1121,
              "printed_page": 1039,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Azithromycin 10 mg/kg PO q24h × 14 days.",
              "pdf_page": 1121,
              "printed_page": 1039,
              "column": 3
            }
          ]
        },
