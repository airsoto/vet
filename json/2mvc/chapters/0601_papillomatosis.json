          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—prognosis good; incubation period 1–8 weeks; regression usually 1–5 months;",
              "pdf_page": 1121,
              "printed_page": 1039,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "lesions persist 24 months or more.",
              "pdf_page": 1121,
              "printed_page": 1039,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats— long-term prognosis for plaques and BISC depends on concurrent diseases.",
              "pdf_page": 1121,
              "printed_page": 1039,
              "column": 3
            }
          ]
        }
