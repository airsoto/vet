          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dependent upon syndrome; all lesions share cytopathic effects of papillomavirus infection: hyperkeratosis, acanthosis, koilocytes in stratum spinosum, abnormal, large keratohyalin granules in stratum",
              "pdf_page": 1121,
              "printed_page": 1039,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "granulosum.",
              "pdf_page": 1121,
              "printed_page": 1039,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Viral pigmented plaques may lack koilocytes and viral inclusion bodies.",
              "pdf_page": 1121,
              "printed_page": 1039,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Usually regress spontaneously (especially",
          "pdf_page": 1121,
          "printed_page": 1039,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "oral forms).",
          "pdf_page": 1121,
          "printed_page": 1039,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgery if needed (excision,",
          "pdf_page": 1121,
          "printed_page": 1039,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "cryosurgery, or electrosurgery).",
          "pdf_page": 1121,
          "printed_page": 1039,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Persistent disease (dogs)—COPV vaccine reported to induce epithelial tumors and SCC at vaccination sites; latency period 11–34 months; autogenous vaccination: treatment",
          "pdf_page": 1121,
          "printed_page": 1039,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "controversial.",
          "pdf_page": 1121,
          "printed_page": 1039,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Cats—diagnosis for visceral diseases, causes of immunosuppression.",
          "pdf_page": 1121,
          "printed_page": 1039,
          "column": 2
        }
      ],
