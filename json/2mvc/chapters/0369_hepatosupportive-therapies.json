          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Goals of treatment of hepatobiliary disease involve identifying and treating the underlying cause and attenuating pathophysiologic mechanisms common to many hepatobiliary diseases, including inflammation, oxidative damage, and fibrosis.",
              "pdf_page": 724,
              "printed_page": 642,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hepatosupportive agents, including prescription drugs and dietary supplements (vitamins, minerals, and nutraceuticals), have received much attention for their concomitant role in treatment of hepatic disease.",
              "pdf_page": 724,
              "printed_page": 642,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "These medications purportedly enhance natural defense mechanisms to inhibit inflammation and fibrosis, prevent hepatocyte apoptosis, and protect against oxidant injury.",
              "pdf_page": 724,
              "printed_page": 642,
              "column": 1
            }
          ]
        },
