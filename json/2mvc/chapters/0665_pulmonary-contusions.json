    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Hemothorax—auscult dull lung sounds",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "ventrally.",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pneumothorax—auscult dull",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "lung sounds dorsally.",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diaphragmatic hernia—distinguished radiographically.",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Coagulopathy can result in pulmonary hemorrhage; identified by abnormal",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "coagulation tests or platelet count.",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute onset of pulmonary hemorrhage—can be seen with neoplasia or pulmonary infarction from bacterial endocarditis or heartworm disease.",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Expectoration of bloody fluid (not frank hemorrhage) can occur in animals with acute respiratory distress syndrome (ARDS) or",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "congestive heart failure.",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If no known history of trauma, pneumonia or edema (cardiogenic and noncardiogenic) are possible differentials.",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
