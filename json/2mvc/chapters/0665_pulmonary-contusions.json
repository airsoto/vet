      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Hemorrhage in the lung parenchyma caused by tearing and crushing from direct",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "thoracic trauma.",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Relatively small volumes of blood in the parenchyma markedly",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "compromise lung function.",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fluid resuscitation for treatment of shock can exacerbate lung dysfunction from secondary edema.",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            }
          ]
        },
