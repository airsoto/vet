        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Thoracic Radiography",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually a patchy alveolar pattern—focal or",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1,
              "subheading": "Thoracic Radiography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "asymmetrical, but can be generalized.",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1,
              "subheading": "Thoracic Radiography"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Contusions generally worse in the area of",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1,
              "subheading": "Thoracic Radiography"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "rib fractures if present.",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1,
              "subheading": "Thoracic Radiography"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Always perform",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1,
              "subheading": "Thoracic Radiography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "thoracic radiographs in trauma patients after",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1,
              "subheading": "Thoracic Radiography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "stabilization to rule out hemothorax,",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1,
              "subheading": "Thoracic Radiography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "pneumothorax, and diaphragmatic hernia.",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1,
              "subheading": "Thoracic Radiography"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Thoracic Focused Assessment",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "with hypoxemia or traumatic myocarditis.",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 2,
              "subheading": "Thoracic Focused Assessment"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Radiographs—repeated if clinically indicated.",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 2,
              "subheading": "Thoracic Focused Assessment"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "with Sonography for Trauma (TFAST®)",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Development of a moist productive cough and failure to improve within 48 hours—",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Coagulation tests for coagulopathy or",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "suspect pneumonia.",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Patients with severe",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "disseminated intravascular coagulation.",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pulse shock can develop ARDS (less common). oximetry or arterial blood gas analysis—can",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "confirm hypoxemia.",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Examination of tracheal",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 2
            }
          ]
        },
