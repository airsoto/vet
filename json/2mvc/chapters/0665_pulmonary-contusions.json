    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "paragraph",
          "level": 0,
          "text": "improve clinically after 48 hours, evaluate for complications or concurrent disease.",
          "pdf_page": 1230,
          "printed_page": 1148,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Usually inpatient for stabilization.",
          "pdf_page": 1230,
          "printed_page": 1148,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Support respiratory function, stabilize cardiovascular",
          "pdf_page": 1230,
          "printed_page": 1148,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "function.",
          "pdf_page": 1230,
          "printed_page": 1148,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "If pneumothorax suspected,",
          "pdf_page": 1230,
          "printed_page": 1148,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "thoracocentesis should be performed.",
          "pdf_page": 1230,
          "printed_page": 1148,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Assess and",
          "pdf_page": 1230,
          "printed_page": 1148,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "treat injuries to other organ systems.",
          "pdf_page": 1230,
          "printed_page": 1148,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Restrict activity, minimize stress, and monitor carefully for",
          "pdf_page": 1230,
          "printed_page": 1148,
          "column": 2
        }
      ],
