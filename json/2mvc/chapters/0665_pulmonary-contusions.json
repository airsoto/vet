        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "History of trauma.",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tachypnea.",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abnormal respiratory effort.",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Postural",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "adaptations to respiratory distress.",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cyanotic",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "or pale mucous membranes.",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Auscultation of harsh bronchovesicular sounds or crackles.",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Expectoration of blood or blood-tinged",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "fluid.",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Additional injuries secondary to trauma and shock can also be noted.",
              "pdf_page": 1230,
              "printed_page": 1148,
              "column": 1
            }
          ]
        },
