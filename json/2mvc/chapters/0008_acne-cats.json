          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats may have a single episode, a life-long recurrent problem, or a continual disease.",
              "pdf_page": 96,
              "printed_page": 14,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Frequency and severity of each occurrence vary with the individual.",
              "pdf_page": 96,
              "printed_page": 14,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Comedones, mild erythematous papules, serous crusts, and dark keratin debris develop on the chin and less commonly on the lips.",
              "pdf_page": 96,
              "printed_page": 14,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Swelling of the chin.",
              "pdf_page": 96,
              "printed_page": 14,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Severe cases—nodules, hemorrhagic crusts, pustules, cysts, fistulae, severe erythema, alopecia, and pain.",
              "pdf_page": 96,
              "printed_page": 14,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pain often associated with bacterial furunculosis.",
              "pdf_page": 96,
              "printed_page": 14,
              "column": 1
            }
          ]
        },
