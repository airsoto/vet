        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Cerebrospinal fluid (CSF) analysis may show albumin-cytologic dissociation (high protein with low number of nucleated cells). The CSF analysis is indicated to exclude infectious etiology, not to diagnose astrocytoma.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "MRI of brain is ideal for mass lesion confirmation, as it is superior to CT scanning for detecting lesions in the middle and caudal fossae. MRI is more sensitive than CT for detection infarcts, bleeding, and",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "edema.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Brain MRI is useful in establishing a tentative differential diagnosis of a glial",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "tumor, based on tumor characteristics highlighted in specific sequences.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
