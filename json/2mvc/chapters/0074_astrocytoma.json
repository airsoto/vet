        "CONTRAINDICATIONS/POSSIBLE INTERACTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Prednisone and phenobarbital may cause polyphagia, polydipsia, and polyuria.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Phenobarbital may cause sedation for up to 2 weeks after initiation of treatment,",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and increase in hepatic enzymes on serum",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "biochemical panel.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CBC and platelet count are recommended 7–10 days after chemotherapy and immediately before each dose of chemotherapy to monitor",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "myelosuppression.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chemotherapy has the potential to be synergistic with radiation therapy. Timely referral to a specialty center with neurosurgery, radiation therapy, and medical oncology capabilities is important for patients seeking more than palliative care.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 3
            }
          ]
        },
