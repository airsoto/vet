            {
              "type": "bullet",
              "level": 0,
              "text": "Metastatic neoplasia with brain tropism such as hemangio-",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "sarcoma.",
