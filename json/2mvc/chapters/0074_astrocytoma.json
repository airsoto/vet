  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Glial cell neoplasm, most commonly affecting the brain and rarely the spinal cord.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neoplastic cells are of astrocytic origin.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The most common intraaxial (situated inside of the brain parenchyma) intracranial neoplasm of dogs,",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "but is rarely diagnosed in cats.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tumors are often located in the pyriform area of the temporal lobe, the cerebral hemispheres, the thalamus, hypo-",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "thalamus, or midbrain.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Biologic behavior of this tumor is dictated by the histopathologic grade (I–IV, from best to worst prognosis) and",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "anatomic involvement.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tumors typically do not penetrate the ventricular system or metastasize outside of the cranial vault.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            }
          ]
        },
