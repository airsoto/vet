              "column": 2,
              "subheading": "Tumor Control"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "the definitive treatment of the tumor.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 2,
              "subheading": "Tumor Control"
