          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog—often brachycephalic breeds>5 years of",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "age; no sex predilection reported.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cat—usually >9 years; no sex or breed predilection reported.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Location and growth kinetic dependent.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Seizures.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Behavioral changes.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Apathy toward normal activities, including eating, playing, and societal interactions.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Disorientation.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Loss of conscious",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "proprioception.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cranial nerve abnormal",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "ities.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Head muscle atrophy.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Upper motor neuron tetraparesis.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            }
          ]
        },
