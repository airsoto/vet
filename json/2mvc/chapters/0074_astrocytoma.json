              "printed_page": 129,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Granulomatous meningoencepha-",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "litis.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Trauma. Cerebrovascular infarction.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Meningitis.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 1
            }
          ]
        },
