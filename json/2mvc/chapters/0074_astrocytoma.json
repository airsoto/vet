    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgery.",
          "pdf_page": 211,
          "printed_page": 129,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Radiation therapy can be very effective in improving neurologic signs.",
          "pdf_page": 211,
          "printed_page": 129,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Chemotherapy with lomustine, procarbazine, or temozolomide might exert cyto-",
          "pdf_page": 211,
          "printed_page": 129,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "reductive activities.",
          "pdf_page": 211,
          "printed_page": 129,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Anti-inflammatory dosing with corticosteroids to reduce",
          "pdf_page": 211,
          "printed_page": 129,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "peritumoral edema.",
          "pdf_page": 211,
          "printed_page": 129,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Consultation with a neurosurgeon and a radiation oncologist is essential for appropriate patient management.",
          "pdf_page": 211,
          "printed_page": 129,
          "column": 2
        }
      ],
