            },
            {
              "type": "bullet",
              "level": 0,
              "text": "MRI.",
              "pdf_page": 211,
              "printed_page": 129,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CSF analysis.",
