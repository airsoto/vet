  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "A condition resulting from a defect in pituitary hormone synthesis; most frequently due to a genetic mutation.",
              "pdf_page": 823,
              "printed_page": 741,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Associated with low production of pituitary hormones including thyroid-stimulating hormone (TSH), luteinizing hormone, follicle-stimulating hormone, and growth hormone (GH). Adrenocorticotropic hormone (ACTH) synthesis is usually preserved in dogs with congenital hyposomato tropism (pituitary dwarfism).",
              "pdf_page": 823,
              "printed_page": 741,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypopituitarism due to transsphenoidal hypophysectomy to treat pituitary-dependent hypercortisolism can result in hypothyroidism, hypocortisolism, and possible GH deficiency.",
              "pdf_page": 823,
              "printed_page": 741,
              "column": 1
            }
          ]
        },
