            {
              "type": "paragraph",
              "level": 0,
              "text": "in housebreaking.",
              "pdf_page": 823,
              "printed_page": 741,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Slow growth noticed in first 2–3 months of life.",
