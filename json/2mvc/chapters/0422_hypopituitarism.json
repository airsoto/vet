    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "IGF-1 every 4–6 weeks initially, and then less frequently.",
              "pdf_page": 823,
              "printed_page": 741,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Blood and urinary glucose concentration.",
              "pdf_page": 823,
              "printed_page": 741,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Stop GH supplementation if glucosuria develops or blood glucose is>150 mg/dL.",
              "pdf_page": 823,
              "printed_page": 741,
              "column": 3
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": []
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Acromegaly and diabetes mellitus; pyometra in female dogs treated with progestins.",
              "pdf_page": 823,
              "printed_page": 741,
              "column": 3
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Skin and hair coat improve within 6–8 weeks of initiating GH and thyroid supplementation.",
              "pdf_page": 823,
              "printed_page": 741,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Generally no increase in stature because growth plates have usually closed by the time of diagnosis.",
              "pdf_page": 823,
              "printed_page": 741,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs often die at a young age (3–4 years) because of neurologic complications, renal failure, or infections.",
              "pdf_page": 823,
              "printed_page": 741,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
