              "column": 1,
              "subheading": "•Dogs."
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Simple autosomal recessive in German",
              "pdf_page": 823,
              "printed_page": 741,
              "column": 1,
              "subheading": "•Dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "shepherd dog and Karelian bear dog;",
              "pdf_page": 823,
              "printed_page": 741,
              "column": 1,
              "subheading": "•Dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "mutation of theLHX3gene.",
              "pdf_page": 823,
              "printed_page": 741,
              "column": 1,
              "subheading": "•Dogs."
            }
          ]
        },
