        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "GH and insulin-like growth factor (IGF) assays; GH assay not currently available in the United States; recommend measurement of IGF-1, which is low.",
              "pdf_page": 823,
              "printed_page": 741,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Adrenal function is usually preserved in dogs with theLHX3mutation.",
              "pdf_page": 823,
              "printed_page": 741,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "TSH response test; subnormal response to TSH.",
              "pdf_page": 823,
              "printed_page": 741,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ghrelin-stimulation test—monitors changes in GH levels in response to ghrelin; requires GH assay.",
              "pdf_page": 823,
              "printed_page": 741,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "DNA testing.",
              "pdf_page": 823,
              "printed_page": 741,
              "column": 2
            }
          ]
        },
