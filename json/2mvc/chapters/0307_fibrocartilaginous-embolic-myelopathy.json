          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Acute ischemic necrosis of the spinal cord caused when fibrocartilaginous emboli become lodged in the spinal vasculature.",
              "pdf_page": 612,
              "printed_page": 530,
              "column": 1
            }
          ]
        },
