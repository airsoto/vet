    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "No specific medications are indicated for the treatment of FCE. Use of steroids such as methylprednisolone sodium succinate is controversial and unlikely to be of benefit.",
              "pdf_page": 613,
              "printed_page": 531,
              "column": 1
            }
          ]
        },
        "CONTRAINDICATIONS": {
