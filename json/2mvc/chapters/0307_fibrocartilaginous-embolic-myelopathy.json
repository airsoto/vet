          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Nonsteroidal analgesics should not be administered with methylprednisolone sodium succinate.",
              "pdf_page": 613,
              "printed_page": 531,
              "column": 1
            }
