    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Sequential neurologic evaluations—during first 12–24 hours after initial examination.",
              "pdf_page": 613,
              "printed_page": 531,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neurologic status—at 2, 3, and 4 weeks after onset of clinical signs.",
              "pdf_page": 613,
              "printed_page": 531,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urinary incontinence—manually express bladder in patients who are not voluntarily urinating. Urinalysis and culture/sensitivity to detect urinary tract infection.",
              "pdf_page": 613,
              "printed_page": 531,
              "column": 1
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Recurrence highly unlikely but possible.",
              "pdf_page": 613,
              "printed_page": 531,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No known method of prevention in most cases.",
              "pdf_page": 613,
              "printed_page": 531,
              "column": 1
            }
          ]
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Fecal and urinary incontinence.",
              "pdf_page": 613,
              "printed_page": 531,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urinary tract infection.",
              "pdf_page": 613,
              "printed_page": 531,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urine scalding and pressure sores.",
              "pdf_page": 613,
              "printed_page": 531,
              "column": 2
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Generally good prognosis for recovery of ambulation.",
              "pdf_page": 613,
              "printed_page": 531,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most patients (85%) recover ambulation within 3 weeks (range: 3 days–12 weeks).",
              "pdf_page": 613,
              "printed_page": 531,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most patients retain some permanent neurologic deficits despite recovering",
              "pdf_page": 613,
              "printed_page": 531,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Paraplegia with loss of pain perception at presentation implies more guarded prognosis.",
              "pdf_page": 613,
              "printed_page": 531,
              "column": 2
            }
          ]
        }
      }
    },
