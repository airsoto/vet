          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Emboli—found in spinal cord vasculature; histologically and histochemically identical to nucleus pulposus of the intervertebral disc.",
              "pdf_page": 612,
              "printed_page": 530,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exact mechanism of entry into the spinal vasculature unknown.",
              "pdf_page": 612,
              "printed_page": 530,
              "column": 1
