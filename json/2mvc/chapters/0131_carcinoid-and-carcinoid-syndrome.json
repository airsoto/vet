          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Clinical signs depend on the location of the primary tumor or metastases and may include anorexia, vomiting, dyschezia, melena, collapse, ascites, weight loss, and signs of hepatic failure or gall bladder obstruction.",
              "pdf_page": 306,
              "printed_page": 224,
              "column": 1
            }
          ]
        },
