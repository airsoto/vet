      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "The role of chemotherapy for synovial sarcomas is not known; however, doxorubicin is commonly utilized for the treatment of sarcoma histologies.",
              "pdf_page": 1393,
              "printed_page": 1311,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pain management with analgesic drugs as necessary.",
              "pdf_page": 1393,
              "printed_page": 1311,
              "column": 2
            }
          ]
        },
