    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "paragraph",
          "level": 0,
          "text": "Limb amputation; forequarter, coxofemoral disarticulation or hemipelvectomy to minimize risk of local recurrence.",
          "pdf_page": 1393,
          "printed_page": 1311,
          "column": 2
        }
      ],
