    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other primary neoplasia (e.g., histiocytic sarcoma, chondrosarcoma, osteosarcoma).",
              "pdf_page": 1393,
              "printed_page": 1311,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metastatic neoplasia.",
              "pdf_page": 1393,
              "printed_page": 1311,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other bone or joint diseases (e.g., osteoarthritis, osteomyelitis).",
              "pdf_page": 1393,
              "printed_page": 1311,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
