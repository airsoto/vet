        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Radiographs of the affected joint often demonstrate both bone and joint involvement with periarticular soft tissue swelling and periosteal reaction or multiple punctate osteolytic changes in adjacent bone.",
              "pdf_page": 1393,
              "printed_page": 1311,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiographs should be obtained to screen for metastatic disease.",
              "pdf_page": 1393,
              "printed_page": 1311,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal ultrasonography should be performed to evaluate intra-abdominal lymph nodes in animals with tumors on the pelvic limbs.",
              "pdf_page": 1393,
              "printed_page": 1311,
              "column": 1
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Regional lymph nodes should be palpated and fine-needle aspirates performed.",
              "pdf_page": 1393,
              "printed_page": 1311,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Biopsy and immunohistochemistry to differentiate from histiocytic sarcoma (histiocytic sarcoma is CD18+).",
              "pdf_page": 1393,
              "printed_page": 1311,
              "column": 2
            }
          ]
        },
