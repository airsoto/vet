  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Synovial sarcoma (or synovial cell sarcoma) is a malignant neoplasm arising from type B synoviocytes of the joint capsule or tendon sheath.",
              "pdf_page": 1393,
              "printed_page": 1311,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Synovial sarcomas are locally aggressive and have moderate metastatic potential. At diagnosis up to 32% of dogs have metastases with the most common sites being the local lymph node and lungs.",
              "pdf_page": 1393,
              "printed_page": 1311,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The disease is seen most commonly in the appendicular skeleton, specifically affecting the elbow, stifle, and shoulder joints. Synovial sarcoma must be differentiated via immuno histochemistry from other types of joint tumors, namely histiocytic sarcoma, which has a more aggressive biologic behavior and a worse prognosis.",
              "pdf_page": 1393,
              "printed_page": 1311,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
