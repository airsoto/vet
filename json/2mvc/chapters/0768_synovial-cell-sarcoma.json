    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Monitor for local recurrence and pulmonary metastatic disease every 2–3 months for the first year; every 6 months thereafter.",
              "pdf_page": 1393,
              "printed_page": 1311,
              "column": 2
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
