        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog—often large-breed dogs of either sex, predisposition of flat-coated and golden retrievers, mean age of 9 years.",
              "pdf_page": 1393,
              "printed_page": 1311,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cat—rarely reported.",
              "pdf_page": 1393,
              "printed_page": 1311,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Slowly progressive lameness.",
              "pdf_page": 1393,
              "printed_page": 1311,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Palpable mass.",
              "pdf_page": 1393,
              "printed_page": 1311,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Weight loss.",
              "pdf_page": 1393,
              "printed_page": 1311,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anorexia.",
              "pdf_page": 1393,
              "printed_page": 1311,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical course may be protracted over months to years.",
              "pdf_page": 1393,
              "printed_page": 1311,
              "column": 1
            }
          ]
        },
