    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 1,
          "text": "Minimize pain; decrease inflammation.",
          "pdf_page": 1116,
          "printed_page": 1034,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 1,
          "text": "Symptomatic therapy has no bearing on",
          "pdf_page": 1116,
          "printed_page": 1034,
          "column": 3
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "the duration of the disease.",
          "pdf_page": 1116,
          "printed_page": 1034,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 1,
          "text": "Carprofen 2.2 mg/kg PO q12h or 4.4",
          "pdf_page": 1117,
          "printed_page": 1035,
          "column": 1
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "mg/kg PO q24h.",
          "pdf_page": 1117,
          "printed_page": 1035,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 1,
          "text": "Deracoxib 1–2 mg/kg PO q24h,",
          "pdf_page": 1117,
          "printed_page": 1035,
          "column": 1
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "chewable.",
          "pdf_page": 1117,
          "printed_page": 1035,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 1,
          "text": "Etodolac 10–15 mg/kg PO q24h.",
          "pdf_page": 1117,
          "printed_page": 1035,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 1,
          "text": "Firocoxib 5 mg/kg PO q24h.",
          "pdf_page": 1117,
          "printed_page": 1035,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 1,
          "text": "Grapiprant 2 mg/kg PO q24h, to",
          "pdf_page": 1117,
          "printed_page": 1035,
          "column": 1
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "animals >3.6 kg.",
          "pdf_page": 1117,
          "printed_page": 1035,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 1,
          "text": "Meloxicam—load 0.2 mg/kg PO, then",
          "pdf_page": 1117,
          "printed_page": 1035,
          "column": 1
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "0.1 mg/kg PO q24h—liquid.",
          "pdf_page": 1117,
          "printed_page": 1035,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 1,
          "text": "Tepoxalin—load 20 mg/kg, then 10 mg/",
          "pdf_page": 1117,
          "printed_page": 1035,
          "column": 1
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "kg PO q24h.",
          "pdf_page": 1117,
          "printed_page": 1035,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Glucocorticoids:",
          "pdf_page": 1117,
          "printed_page": 1035,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 1,
          "text": "May give anti-inflammatory dosage—",
          "pdf_page": 1117,
          "printed_page": 1035,
          "column": 1
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "prednisone 0.5–1 mg/kg PO.",
          "pdf_page": 1117,
          "printed_page": 1035,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 1,
          "text": "Potential side effects well documented.",
          "pdf_page": 1117,
          "printed_page": 1035,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 1,
          "text": "Goal for chronic use—low-dose and",
          "pdf_page": 1117,
          "printed_page": 1035,
          "column": 1
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "alternate-day therapy.",
          "pdf_page": 1117,
          "printed_page": 1035,
          "column": 1
        }
      ],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "around the nutrient foramen and later",
              "pdf_page": 1116,
              "printed_page": 1034,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nonsteroidal anti-inflammatory drugs throughout the diaphysis; widened cortex; (NSAIDs): thickened periosteum with increased opacity.",
              "pdf_page": 1116,
              "printed_page": 1034,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Late—during resolution, diminished overall opacity of the medullary canal (toward normal); a coarse trabecular pattern and some",
              "pdf_page": 1116,
              "printed_page": 1034,
              "column": 2
            }
          ]
        },
