          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "NSAIDs—do not use in conjunction with glucocorticoids; risk of gastrointestinal tract ulceration; consider appropriate washout times when switching from one NSAID to another.",
