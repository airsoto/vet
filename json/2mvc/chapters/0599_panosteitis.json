        "DEFINITION": {
          "present": true,
          "status": "content",
          "source_heading": "DEFINITION",
          "canonical_heading": "DEFINITION",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "A self-limiting, painful condition of uncertain etiology that typically affects juvenile dogs of large to giant breeds. It is characterized clinically by lameness and pain on palpation of one or more long bones, and radiograph ically by increased density of the marrow cavity of affected long bones.",
              "pdf_page": 1116,
              "printed_page": 1034,
              "column": 1
            }
          ]
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cause unknown.",
              "pdf_page": 1116,
              "printed_page": 1034,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Attempts to isolate microorganisms have failed.",
              "pdf_page": 1116,
              "printed_page": 1034,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Suggested metabolic, allergic, or endocrine aberrations are without support.",
              "pdf_page": 1116,
              "printed_page": 1034,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pain may be associated with the disturbance of endosteal and periosteal elements, vascular congestion, or high intramedullary pressure.",
              "pdf_page": 1116,
              "printed_page": 1034,
              "column": 1
            }
          ]
        },
