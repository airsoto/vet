              "printed_page": 1034,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Early, middle, and late radiographic lesions.",
              "pdf_page": 1116,
              "printed_page": 1034,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Early—trabecular pattern of the ends of the diaphysis becomes more prominent; may appear blurred; may see granular opacities.",
              "pdf_page": 1116,
              "printed_page": 1034,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Middle—patchy sclerotic opacities first",
              "pdf_page": 1116,
              "printed_page": 1034,
              "column": 2
            }
          ]
        },
