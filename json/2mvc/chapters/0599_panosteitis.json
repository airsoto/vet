        "ACTIVITY": {
          "present": true,
          "status": "content",
          "source_heading": "ACTIVITY",
          "canonical_heading": "ACTIVITY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Shifting leg lameness—immune-mediated",
              "pdf_page": 1116,
              "printed_page": 1034,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Limit activity to lessen pain; not shown to arthropathy; Lyme disease; bacterial hasten recovery. endocarditis.",
              "pdf_page": 1116,
              "printed_page": 1034,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Moderate to severe disease can cause pain that",
              "pdf_page": 1116,
              "printed_page": 1034,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Coccidioidomycosis. limits movement, leading to muscle atrophy.",
              "pdf_page": 1116,
              "printed_page": 1034,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bacterial osteomyelitis.",
              "pdf_page": 1116,
              "printed_page": 1034,
              "column": 2
            }
          ]
        },
