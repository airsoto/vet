  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Melanomas of anterior uvea (e.g., iris and ciliary body) and posterior uvea (choroid).",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most common primary intraocular neoplasm in dogs.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually benign and unilateral; often destructive to the eye but also can be very slow-growing.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most often affects anterior uvea. In a retrospective study of 1842 enucleated eyes with uveal melanoma, 79.2% were benign and 20.8% malignant.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anterior uveal—4% rate of vascular metastasis to lungs and viscera, but rare for malignant uveal melanoma to metastasize.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Choroidal—rarely metastasize.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
