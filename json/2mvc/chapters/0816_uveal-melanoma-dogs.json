          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "No breed or sex predilection.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anterior uveal—average age 8–10 years.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Choroidal melanoma—average age 6.5 years.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Range—2 months–17 years.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Anterior Uveal",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pigmented scleral or corneal mass.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1,
              "subheading": "Anterior Uveal"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pigmented mass visible in anterior chamber",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1,
              "subheading": "Anterior Uveal"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "or posterior to pupillary margin.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1,
              "subheading": "Anterior Uveal"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Irregular pupil.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1,
              "subheading": "Anterior Uveal"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Uveitis.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1,
              "subheading": "Anterior Uveal"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Glaucoma.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1,
              "subheading": "Anterior Uveal"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyphema.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1,
              "subheading": "Anterior Uveal"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No vision loss—unless mass obstructs pupil",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1,
              "subheading": "Anterior Uveal"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "or glaucoma has developed.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1,
              "subheading": "Anterior Uveal"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Choroidal",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Often missed because of tumor location;",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1,
              "subheading": "Choroidal"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "usually incidental finding.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1,
              "subheading": "Choroidal"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Posterior segment mass on funduscopy.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1,
              "subheading": "Choroidal"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Very slow-growing; rarely require",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1,
              "subheading": "Choroidal"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "enucleation.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1,
              "subheading": "Choroidal"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rare.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1,
              "subheading": "Choroidal"
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Idiopathic.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Potential transformation of flat, pigmented iris freckles into melanomas.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Labrador retrievers—presumed autosomal recessive inheritance.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Non-neoplastic uveal proliferations—iris freckles are not raised.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diffuse iris hyperpigmentation secondary to chronic uveitis, particularly in golden",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "retrievers (golden retriever pigmentary uveitis) and boxers.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ocular melanosis (Cairn terriers).",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Uveal cysts—transilluminate and move freely within the eye, unlike melanomas.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Granulomatous masses.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Iris bombé.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ocular perforation with uveal prolapse.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other ocular neoplastic conditions, especially conjunctival melanoma, which could be misinterpreted as extrascleral extension of uveal melanoma. Conjunctival melanoma is usually malignant and aggressive in dogs.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Outward scrolling of pupillary margin due to uveitis (ectropion uvea).",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Usually normal.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "not_applicable",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "N/A",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Ocular ultrasonography—may help determine extent of mass.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Slit-lamp biomicroscopy—determine size and location of mass.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Transillumination of mass.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tonometry.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Indirect ophthalmoscopy—with or without concomitant scleral indentation.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gonioscopy—evaluate drainage angle for tumor extension.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ocular ultrasonography—if cornea opaque and cannot visualize deeper ocular structures, or suspect ciliary body mass hidden by iris.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Restricted to enucleated globe; biopsy not practical in most patients.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Two cell types usually seen—plump cells filled with melanin, spindle cells.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mitotic index—most reliable criterion for malignancy:",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "<2 mitotic figures per 10 HPF: benign.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "4 mitotic figures per 10 HPF: clinically",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "malignant tumors.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Veterinary ocular pathologist should evaluate globe.",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Usually benign, may opt to monitor q3–6 months.",
          "pdf_page": 1471,
          "printed_page": 1389,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Young Labrador retrievers—aggressive growth, need surgery.",
          "pdf_page": 1471,
          "printed_page": 1389,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Counsel client about enucleation; surgery often causes client emotional distress:",
          "pdf_page": 1471,
          "printed_page": 1389,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 1,
          "text": "Emphasize unilateral condition, sparing",
          "pdf_page": 1471,
          "printed_page": 1389,
          "column": 2
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "of fellow eye, and that one-eyed animals function very well.",
          "pdf_page": 1471,
          "printed_page": 1389,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Indications for enucleation—rapid size increase, eye cannot be salvaged, mass spread diffusely within eye, visual function significantly impaired, extraocular invasion, secondary complications (e.g., glaucoma, pain, hemorrhage).",
          "pdf_page": 1471,
          "printed_page": 1389,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Enucleation—use gentle surgical technique to prevent showering of tumor cells into circulation, avoid tension on optic chiasm (could blind fellow eye), exenterate entire orbital contents if extrascleral extension.",
          "pdf_page": 1471,
          "printed_page": 1389,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Sector iridectomy for discrete small masses—infrequently used.",
          "pdf_page": 1471,
          "printed_page": 1389,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Laser treatment of small iris tumor.",
          "pdf_page": 1471,
          "printed_page": 1389,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Melanoma vaccine efficacy unknown; likely ineffective without enucleation. Consider vaccine if malignant melanoma is present, to try to prevent metastasis.",
          "pdf_page": 1471,
          "printed_page": 1389,
          "column": 3
        }
      ],
