    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Reseveratrol, a potent antioxidant derived from grapes, inhibited uveal tumor growth of",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 3
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "uveal melanomain vitro, but grape skins may",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "be toxic to dogs. Grapeseed extract is a safe",
              "pdf_page": 1471,
              "printed_page": 1389,
              "column": 3,
