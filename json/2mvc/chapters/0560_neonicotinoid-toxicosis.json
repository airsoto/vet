        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Primarily dogs—chewing up ant bait containers, collars, boxes of tablets, bags, liquid products.",
              "pdf_page": 1050,
              "printed_page": 968,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rarely reported in cats.",
              "pdf_page": 1050,
              "printed_page": 968,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Imidacloprid has low toxicity in mammals. Results of a chronic feeding study revealed no adverse effects in dogs given imidacloprid at a dose of 15 mg/kg/day for a year. Topical application in dogs and cats at a dose of 50 mg/kg also caused no adverse effects.",
              "pdf_page": 1050,
              "printed_page": 968,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most common adverse effects observed were decreased activity, tremors, mydriasis or miosis and uncoordinated gait; hypothermia was observed at higher doses.",
              "pdf_page": 1050,
              "printed_page": 968,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Alopecia and erythema have been reported following dermal application.",
              "pdf_page": 1050,
              "printed_page": 968,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Due to the large safety margin of safety margin in mammals, CNS signs are rarely seen.",
              "pdf_page": 1050,
              "printed_page": 968,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Oral toxicity is possible if the concentration or dose is excessively high.",
              "pdf_page": 1050,
              "printed_page": 968,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
