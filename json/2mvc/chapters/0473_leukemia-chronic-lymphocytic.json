        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Immunophenotyping by flow cytometry (peripheral blood) is becoming more common practice for classification of leukemias (noninvasive)—affords prognostic information.",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Immunocytochemical staining (bone marrow samples), flow cytometry of bone marrow aspirates, or PCR for antigen receptor rearrangement (PARR) may be useful for",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "classification of leukemias.",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytologic examination (bone marrow aspirate or core biopsy) may show high numbers of mature lymphocytes (especially B-cell chronic lymphocytic leukemia [CLL]); crowding",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "out of normal cell lines in advanced stages.",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If hyperglobulinemia, serum protein electrophoresis",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "to detect monoclonal gammopathy.",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Direct Coombs’ test may be positive with secondary",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Median survival time with therapy Radiography and ultrasonography may reveal approaches 18 months in dogs with B-cell splenomegaly or internal lymphadenomegaly. CLL, and surpasses 24 months in dogs with",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "T-cell CLL.",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Median survival time with",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bone marrow aspiration (cytology) or therapy in cats was >14 months in one study. marrow biopsy (histopathology) may be used",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "for immunophenotyping.",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lymph node and spleen cytology or histopathology may help differentiate CLL from leukemic phase of lymphoma.",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 2
            }
          ]
        },
