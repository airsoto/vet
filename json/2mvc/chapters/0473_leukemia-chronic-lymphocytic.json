        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "More frequent in dog than cat.",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No sex",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "predilection reported.",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—mean age 10",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "years (range 1.5–15 years).",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—median age 12.5 years (range 5–20 years).",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Nonspecific, often no clinical signs of",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "illness.",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lethargy, decreased appetite,",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "chronic weight loss.",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lymphadenomegaly,",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "splenomegaly.",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fever.",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Polydipsia/polyuria.",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            }
          ]
        },
