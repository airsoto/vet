      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Uncommon, lymphoproliferative disorder.",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Slowly progressive over months to years.",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Circulating neoplastic lymphocytes are",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "mature and well differentiated.",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May originate in spleen or bone marrow.",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            }
          ]
        },
