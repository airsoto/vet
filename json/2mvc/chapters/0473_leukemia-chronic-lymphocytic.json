    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Lymphoma—may have a leukemic phase",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "(stage V).",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute lymphoblastic leukemia.",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Immune-mediated hematologic diseases.",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic antigenic stimulation (reactive",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "lymphocytosis)—ehrlichiosis.",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute viral infection-associated lymphocytosis.",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Lymphocytosis—range 5,000 to >500,000 cells/μL; typically small, mature lymphocytes.",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Larger size cells (intermediate-size or blasts) may be observed, especially with progression",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "to blast crisis (advanced stage).",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mild-tomoderate normocytic, normochromic anemia",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "(nonregenerative).",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Normal-to-low platelet",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "count (uncommon).",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Normal-to-low",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "neutrophil count (uncommon).",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Normal-tomildly increased serum globulins.",
              "pdf_page": 912,
              "printed_page": 830,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
