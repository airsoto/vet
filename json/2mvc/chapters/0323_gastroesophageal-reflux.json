          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog and cats; male or female.",
              "pdf_page": 640,
              "printed_page": 558,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No breed predilections reported.",
              "pdf_page": 640,
              "printed_page": 558,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May be associated with congenital hiatal hernia seen in Chinese Shar-Pei dogs and brachycephalic breeds.",
              "pdf_page": 640,
              "printed_page": 558,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Occurs at any age; younger animals may be at increased risk because of developmental immaturity of the gastroesophageal sphincter.",
              "pdf_page": 640,
              "printed_page": 558,
              "column": 1
            }
          ]
        },
