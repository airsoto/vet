          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Trauma to epididymal duct causing release of sperm antigens into the surrounding tissue.",
              "pdf_page": 1354,
              "printed_page": 1272,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Epithelial hyperplasia of the epididymis as documented in dogs of increasing age.",
              "pdf_page": 1354,
              "printed_page": 1272,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Congenital occlusion of epididymal duct.",
              "pdf_page": 1354,
              "printed_page": 1272,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Complication of surgical vasectomy.",
              "pdf_page": 1354,
              "printed_page": 1272,
              "column": 1
            }
          ]
        }
