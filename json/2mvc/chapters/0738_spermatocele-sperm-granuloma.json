              "printed_page": 1272,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Alkaline phosphatase concentration of",
              "pdf_page": 1354,
              "printed_page": 1272,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "seminal plasma—concentration<5,000 U/L",
              "pdf_page": 1354,
              "printed_page": 1272,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "consistent with bilateral epididymal blockage",
