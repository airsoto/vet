          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Spermatocele—a local, cystic distension of the efferent ductules or epididymis.",
              "pdf_page": 1354,
              "printed_page": 1272,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sperm granuloma—a chronic inflammatory reaction resulting from the immune response following sperm leakage from the efferent ductules or epididymal duct.",
              "pdf_page": 1354,
              "printed_page": 1272,
              "column": 1
            }
          ]
        },
