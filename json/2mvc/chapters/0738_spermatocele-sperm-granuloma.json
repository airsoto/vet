              "type": "bullet",
              "level": 0,
              "text": "Sperm granuloma—oligozoospermia or azoospermia if obstruction exists.",
              "pdf_page": 1354,
              "printed_page": 1272,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Spermatocele—cystic mass adjacent to the testicle, with or without discomfort.",
              "pdf_page": 1354,
              "printed_page": 1272,
              "column": 1
            }
          ]
        },
