  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Eversion or rolling out of the eyelid margin, resulting in exposure of the palpebral conjunctiva.",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Can be conformational/congenital (primary) or acquired (secondary).",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exposure and poor tear retention/distribution may predispose patient to irritation, recurrent infections, and sightthreatening corneal disease.",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
        "PATHOPHYSIOLOGY": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": []
        },
        "SYSTEMS AFFECTED": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": []
        },
        "GENETICS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GENETICS",
          "content_blocks": []
        },
        "INCIDENCE/PREVALENCE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "INCIDENCE/PREVALENCE",
          "content_blocks": []
        },
        "GEOGRAPHIC DISTRIBUTION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GEOGRAPHIC DISTRIBUTION",
          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs, seldom cats.",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Breeds with higher than average prevalence— sporting breeds (e.g., spaniels, hounds, and retrievers); giant breeds (e.g., Saint Bernard, mastiff); any breed with loose facial skin (especially bloodhounds).",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary—genetic predisposition in listed breeds; may occur in dogs<1 year old.",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acquired—noted in other breeds; occurs late in life secondary to age-related loss of facial muscle tone and skin laxity.",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intermittent—caused by fatigue; may be observed after strenuous exercise or when drowsy.",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Eversion of the lower eyelid with lack of contact of the lower lid to the globe and exposure of the palpebral conjunctiva and third eyelid.",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Often excessively long palpebral fissure",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(macroblepharon).",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Conjunctivitis and history of mucoid to",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "mucopurulent discharge caused by chronic exposure to air and debris. Debris generally located between lid and globe in inferior conjunctival cul-de-sac.",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Tear staining of periocular skin caused by",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "poor tear drainage.",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "History of bacterial conjunctivitis.",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary disease—most common due to breed-associated facial conformation and alterations in eyelid support.",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acquired disease—from marked weight loss or muscle mass loss about the head and orbits, tragic facial expression in hypothyroid dogs, and cicatricial ectropion from scarring of the eyelids secondary to injury or from surgical overcorrection of entropion.",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually clinically obvious.",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Look for any underlying disorder in nonpredisposed breeds and dogs with late-age onset.",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Loss of orbital or periorbital mass—may occur in patients with masticatory myositis.",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Facial nerve paralysis—associated with lack of muscle tone of orbicularis oculi muscles.",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "not_applicable",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "N/A",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Possible masticatory myositis—test for auto-antibodies against type 2M muscle fibers.",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Palpebral nerve paralysis or tragic facial expression—consider testing for hypothyroidism.",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "not_applicable",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "N/A",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Palpebral nerve paralysis—full neurologic evaluation; potential for hypothyroidism.",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary conjunctivitis—flush fornix and examine for follicles.",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fluorescein or rose Bengal staining of cornea and conjunctiva—to identify corneal ulcerations; may reveal severity of exposure problem.",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": []
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Supportive care (topical lubricant, rinsing eyes with eyewash after being outside to remove debris) and good ocular and facial hygiene—sufficient for most mild disease.",
          "pdf_page": 517,
          "printed_page": 435,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgical treatment—eyelid shortening or radical facelift; necessary for severely affected patients that have chronic ocular irritation.",
          "pdf_page": 517,
          "printed_page": 435,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Intermittent, fatigue-induced condition— do not treat surgically.",
          "pdf_page": 517,
          "printed_page": 435,
          "column": 2
        }
      ],
