    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Topical broad-spectrum ophthalmic antibiotics—bacterial conjunctivitis or corneal ulceration. Neomycin/polymyxin B/bacitracin (or based on culture and sensitivity) q6–8h.",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lubricant ointments (e.g., Puralube®)— reduce conjunctival and corneal desiccation secondary to exposure.",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypothyroid and masticatory myositisinduced conditions—may respond well to appropriate medical treatment of underlying disease.",
              "pdf_page": 517,
              "printed_page": 435,
              "column": 2
            }
          ]
        },
