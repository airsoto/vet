        "DEFINITION": {
          "present": true,
          "status": "content",
          "source_heading": "DEFINITION",
          "canonical_heading": "DEFINITION",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Normal sinus impulse formation characterized by a phasic variation in sinus cycle length. An irregular R-R interval is present that has more than 10% variation in sinus cycle length (or variability of 0.12 seconds [dog], 0.10 seconds [cat], or more exists between successive P waves) (Figure 1).",
              "pdf_page": 1336,
              "printed_page": 1254,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Two basic forms exist—respiratory sinus arrhythmia (RSA): P-P interval cyclically shortens during inspiration due primarily to reflex inhibition of vagal tone and lengthens during expiration; nonrespiratory sinus arrhythmia: phasic variation in P-P interval unrelated to the respiratory cycle.",
              "pdf_page": 1336,
              "printed_page": 1254,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "ECG Features",
              "pdf_page": 1336,
              "printed_page": 1254,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other than the irregular rhythm, all other",
              "pdf_page": 1336,
              "printed_page": 1254,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "criteria for sinus rhythm are present.",
              "pdf_page": 1336,
              "printed_page": 1254,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Normal heart rate.",
              "pdf_page": 1336,
              "printed_page": 1254,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Positive P wave in leads, I, II, III, and aVF,",
              "pdf_page": 1336,
              "printed_page": 1254,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "unless a wandering pacemaker is present,",
              "pdf_page": 1336,
              "printed_page": 1254,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "where the P waves may be positive, diphasic,",
              "pdf_page": 1336,
              "printed_page": 1254,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "or negative temporarily.",
              "pdf_page": 1336,
              "printed_page": 1254,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "A P wave is present for every QRS complex.",
              "pdf_page": 1336,
              "printed_page": 1254,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "A QRS complex is present for every P wave.",
              "pdf_page": 1336,
              "printed_page": 1254,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "PR interval is relatively constant.",
              "pdf_page": 1336,
              "printed_page": 1254,
              "column": 1,
              "subheading": "ECG Features"
            }
          ]
