    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Generally no therapy indicated; this is a normal rhythm.",
              "pdf_page": 1337,
              "printed_page": 1255,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infectious respiratory diseases require appropriate antibiotic therapy.",
              "pdf_page": 1337,
              "printed_page": 1255,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If associated with symptomatic sinus bradycardia or sinus arrest or block, anticholinergics may be indicated—atropine 0.02–0.04 mg/kg IV, IM, SC or glycopyrrolate 5–10μg/kg IV, IM, SC.",
              "pdf_page": 1337,
              "printed_page": 1255,
              "column": 2
            }
          ]
        },
        "CONTRAINDICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS",
          "canonical_heading": "CONTRAINDICATIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Discontinue digoxin if toxicity is a problem.",
              "pdf_page": 1337,
              "printed_page": 1255,
              "column": 2
            }
          ]
        },
        "PRECAUTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "PRECAUTIONS",
          "canonical_heading": "PRECAUTIONS",
          "content_blocks": [
