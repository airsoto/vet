        "SYNONYMS": {
          "present": true,
          "status": "content",
          "source_heading": "SYNONYMS",
          "canonical_heading": "SYNONYMS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Nonrespiratory sinus arrhythmia = nonphasic sinus arrhythmia; sinus irregularity.",
              "pdf_page": 1337,
              "printed_page": 1255,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory sinus arrhythmia = phasic sinus arrhythmia.",
              "pdf_page": 1337,
              "printed_page": 1255,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ventriculophasic sinus arrhythmia—form of nonphasic sinus arrhythmia in which atrial cycles containing ventricular complexes are shorter than those in which they are absent. That is, the P-P interval that includes the QRS complex is shorter than the P-P interval without a QRS complex. This can be seen with second-degree AV block, complete AV block or in the presence of ventricular premature complexes with a full compensatory pause.",
              "pdf_page": 1337,
              "printed_page": 1255,
              "column": 3
            }
          ]
        },
