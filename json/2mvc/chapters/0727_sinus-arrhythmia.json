          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Cats with chronic respiratory disease may be positive for feline leukemia virus or feline immunodeficiency virus.",
              "pdf_page": 1337,
              "printed_page": 1255,
              "column": 1
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Radiographs, CT, or MRI of head and neck to assess for abnormal anatomic conformation that might predispose to airway problems.",
              "pdf_page": 1337,
              "printed_page": 1255,
              "column": 1
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Pharyngoscopy/laryngoscopy if upper airway disease suspected.",
              "pdf_page": 1337,
              "printed_page": 1255,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Atropine challenge test (administer atropine 0.04 mg/kg IM followed by ECG in 30 minutes or 0.04 mg/kg atropine IV followed by ECG in 10 minutes) if associated with sinus bradycardia and primary dysfunction of sinus node is suspected. Subsequent heart rate should be greater than 150 bpm.",
              "pdf_page": 1337,
              "printed_page": 1255,
              "column": 1
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
