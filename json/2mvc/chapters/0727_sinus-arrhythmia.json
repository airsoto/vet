        "APPROPRIATE HEALTH CARE": {
          "present": true,
          "status": "content",
          "source_heading": "APPROPRIATE HEALTH CARE",
          "canonical_heading": "APPROPRIATE HEALTH CARE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Generally, specific treatment required only when associated with symptomatic sinus bradycardia; if not related to respiration, underlying cause is treated. If patient is suffering respiratory distress, appropriate inpatient management indicated until patient is stable.",
              "pdf_page": 1337,
              "printed_page": 1255,
              "column": 1
            }
          ]
        },
