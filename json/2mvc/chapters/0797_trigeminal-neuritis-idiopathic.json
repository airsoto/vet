        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Primarily adult dogs.",
              "pdf_page": 1440,
              "printed_page": 1358,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rare in cats.",
              "pdf_page": 1440,
              "printed_page": 1358,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute onset of a dropped jaw.",
              "pdf_page": 1440,
              "printed_page": 1358,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inability to close the mouth.",
              "pdf_page": 1440,
              "printed_page": 1358,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Drooling.",
              "pdf_page": 1440,
              "printed_page": 1358,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Difficulty in prehending food, messy eating.",
              "pdf_page": 1440,
              "printed_page": 1358,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Swallowing is intact when food and water are placed in the caudal portion of the mouth.",
              "pdf_page": 1440,
              "printed_page": 1358,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Approximately one-third of affected dogs will exhibit decreased facial sensation.",
              "pdf_page": 1440,
              "printed_page": 1358,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Few dogs have sympathetic involvement of the head (Horner’s syndrome).",
              "pdf_page": 1440,
              "printed_page": 1358,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Long-term muscle atrophy depending on degree of axonal involvement.",
              "pdf_page": 1440,
              "printed_page": 1358,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
