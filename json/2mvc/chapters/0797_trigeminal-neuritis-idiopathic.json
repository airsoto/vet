      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Sudden bilateral paralysis of trigeminal mandibular branches resulting in inability to close the mouth. Lesions are characterized by extensive nonsuppurative trigeminal neuritis, demyelination, and rare axonal degeneration affecting all portions of the trigeminal nerve and ganglion without brainstem involvement.",
              "pdf_page": 1440,
              "printed_page": 1358,
              "column": 1
            }
          ]
        },
