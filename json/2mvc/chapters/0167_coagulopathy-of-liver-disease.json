  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "The liver is the sole/primary site of synthesis of procoagulant, anticoagulant, and fibrinolytic proteins, except factors V, VIII, von Willebrand factor (vWF), tissue plasminogen activator (TPA).",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Some patients develop prolonged in vitro clotting times, but few exhibit spontaneous bleeding.",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Causes of hemostatic imbalance:",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "reduced synthesis or activation of",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "procoagulant proteins;",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "vitamin K deficiency;",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "dysfibrinogenemia due to abnormal",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "fibrin polymerization;",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "reduced clearance of fibrin/fibrinogen",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "degradation products (FDP);",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "thrombocytopenia or thrombocytopathy;",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "enhanced fibrinolysis.",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vitamin K deficiency—linked to severe intra- or extrahepatic cholestasis, steatorrhea, or prolonged oral antibiotic administration.",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 1
            }
          ]
        },
