          "column": 2,
          "subheading": "Biopsy"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "venipuncture or catheter placement,",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2,
          "subheading": "Biopsy"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Iatrogenic hemorrhage—grave prognosis if",
