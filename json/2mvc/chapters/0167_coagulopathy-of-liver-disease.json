          "column": 2,
          "subheading": "Biopsy"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "spontaneous bleeding with undetermined",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2,
          "subheading": "Biopsy"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "tendencies.",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2,
          "subheading": "Biopsy"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "cause.",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2,
          "subheading": "Biopsy"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Hemostasis support—postprocedure",
