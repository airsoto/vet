      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Heart rate, blood pressure, mucous membrane color and refill, packed cell volume (PCV), and total solids to monitor response if active bleeding.",
