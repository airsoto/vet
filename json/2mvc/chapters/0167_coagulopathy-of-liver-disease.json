        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "enteric bile acid uptake. Hemostatic tests—thrombocytopenia;",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "DIC—correct primary disease; consider prolonged APTT (activated clotting time heparin for overt thrombosis (unfractionated [ACT]), prothrombin time (PT), thrombin heparin [UFH]: 200 U/kg q6–12h; or low clotting time (TCT), and proteins induced by molecular weight heparin [enoxaparin]: 1 mg/vitamin K absence (PIVKA); low fibrinogen kg q12–24h), dose titration based on clinical and coagulation factors; low anticoagulant status and laboratory monitoring (ACT, factors (antithrombin [AT], protein C); high APTT [UFH], heparin anti-Xa activity [all FDP and D-dimer. heparins]).",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Blood products—fresh whole blood:",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "12–20 mL/kg q24h; fresh frozen plasma:",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Abdominal Ultrasonography",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "10–20 mL/kg q12h; plasma cryosupernatant",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 2,
              "subheading": "Abdominal Ultrasonography"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Effusion (ascites, hemorrhage).",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 2,
              "subheading": "Abdominal Ultrasonography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(albumin, vitamin K–dependent factors):",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 2,
              "subheading": "Abdominal Ultrasonography"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Liver changes—variable.",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 2,
              "subheading": "Abdominal Ultrasonography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "10–20 mL/kg q12h; cryoprecipitate",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 2,
              "subheading": "Abdominal Ultrasonography"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abnormal enteric motility, thickening in",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 2,
              "subheading": "Abdominal Ultrasonography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(fibrinogen, vWF, factor VIII): 1 U/10 kg or",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 2,
              "subheading": "Abdominal Ultrasonography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "area of bleeding.",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 2,
              "subheading": "Abdominal Ultrasonography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "dose to effect.",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 2,
              "subheading": "Abdominal Ultrasonography"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Desmopressin acetate (DDAVP)—",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 2,
              "subheading": "Abdominal Ultrasonography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "0.5–1μg/kg IV in saline; may increase",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 2,
              "subheading": "Abdominal Ultrasonography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "coagulation factors, shortens bleeding times,",
              "pdf_page": 370,
