          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "tendencies observed.",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "provoke emesis and spontaneous bleeding,",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "subheading",
          "level": 0,
          "text": "Biopsy",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "High-volume transfusion in citrate-based",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2,
          "subheading": "Biopsy"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "High risk for bleeding—PIVKA, PT,",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2,
          "subheading": "Biopsy"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "anticoagulants (especially in animals <5 kg)",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2,
          "subheading": "Biopsy"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "APTT, or ACT prolonged by>50%;",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2,
          "subheading": "Biopsy"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "may induce symptomatic hypocalcemia.",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2,
          "subheading": "Biopsy"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "thrombocytopenia <50,000/μL; prolonged",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2,
          "subheading": "Biopsy"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Avoid provocative procedures—e.g., jugular",
