    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "paragraph",
          "level": 0,
          "text": "reduces bleeding tendencies; empirically used",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Not necessary unless invasive procedures for biopsy-induced bleeding. planned or spontaneous hemorrhage noted.",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Antifibrinolytics—epsilon aminocaproic",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Fresh whole blood—provides replacement acid (EACA): 100 mg/kg loading, 30 mg/of red cells, coagulation factors, functional kg/h up to 8h; tranexamic acid: 25 mg/kg platelets. q8h; if evidence of hyperfibrinolysis.",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Fresh frozen plasma—provides coagulation",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2
        },
        {
          "type": "subheading",
          "level": 0,
          "text": "CONTRAINDICATIONS/POSSIBLE",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "factors, other hemostatic proteins, and",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2,
          "subheading": "CONTRAINDICATIONS/POSSIBLE"
        },
        {
          "type": "subheading",
          "level": 0,
          "text": "INTERACTIONS",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "reduces risk of red cell sensitization or volume",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Stored whole blood—may provoke hepatic",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "overload.",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "encephalopathy (HE).",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Cryoprecipitate—for severe hypofibrino-",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Vitamin K1(cats)—high dose causes Heinz",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "genemia or bleeding with coexistent von",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "body hemolysis and oxidant liver injury.",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "Willebrand’s disease (vWD).",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Aspirin or other nonsteroidal anti-",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Platelet-rich plasma—rarely indicated.",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "inflammatory drugs (NSAIDs)—may",
          "pdf_page": 370,
          "printed_page": 288,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Avoid synthetic colloids if bleeding",
