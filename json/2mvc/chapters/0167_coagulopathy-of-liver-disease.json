      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Laparoscopy—affords visibility and allows",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "PT, PIVKA (limited availability), factor hemostasis (cautery, Gelfoam pack biopsy VII—most sensitive coagulation tests to detect site). vitamin K deficiency; if no improvement after",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Laparotomy—wedge biopsy; ill-advised in 48h of vitamin K1injection, unlikely correction patients with overt bleeding. by further dosing.",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 2
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Well-balanced diet replete with vitamins.",
              "pdf_page": 371,
              "printed_page": 289,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Consider impaired vitamin K availability or synthesis from chronic oral antimicrobials.",
              "pdf_page": 371,
              "printed_page": 289,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Invasive procedures—anticipate bleeding; pretreat with vitamin K1; give DDAVP within 20 min of anticipated biopsy or if bleeding tendencies persist despite vitamin K1therapy (repeated DDAVP of no use); fresh frozen plasma for factor/fibrinogen replacement and active bleeding; avoid volume overload and increased CVP.",
              "pdf_page": 371,
              "printed_page": 289,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Eliminate enteric parasitism.",
              "pdf_page": 371,
              "printed_page": 289,
              "column": 1
            }
          ]
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Hemorrhage, anemia, hypovolemia, HE.",
              "pdf_page": 371,
              "printed_page": 289,
              "column": 2
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Spontaneous hemorrhage, refractory coagulopathy, and DIC—poor prognosis.",
              "pdf_page": 371,
              "printed_page": 289,
              "column": 2
            }
          ]
        }
      }
