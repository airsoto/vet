          "printed_page": 289,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Biopsy site—observe immediately and sequentially (ultrasonography) for hemorrhage.",
          "pdf_page": 371,
          "printed_page": 289,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Sample abdominal effusion to differentiate hemorrhage from ascites.",
          "pdf_page": 371,
          "printed_page": 289,
          "column": 1
        }
