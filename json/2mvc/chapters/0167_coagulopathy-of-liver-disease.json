        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Dog and cat of any age, breed, or sex.",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Often minor or absent.",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Melena, hematemesis, hematochezia, hematuria.",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prolonged bleeding if provoked—venipuncture, cystocentesis, biopsy, surgical wounds.",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Spontaneous bruising/hematomas—rare unless severe vitamin K deficiency or fulminant disseminated intravascular coagulation (DIC).",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Severe hepatic failure of any etiology.",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute viral liver disease.",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Extrahepatic bile duct obstruction (EHBDO).",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic liver disease—especially cirrhosis.",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Concurrent small bowel disease (e.g., cats with cholangiohepatitis or hepatic lipidosis) predisposing to vitamin K deficiency.",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "High central venous pressure (CVP) and portal hypertension.",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Portosystemic vascular anomaly (PSVA)— asymptomatic factor deficiency common; overt bleeding uncommon.",
              "pdf_page": 370,
              "printed_page": 288,
              "column": 1
            }
          ]
        }
      }
    },
