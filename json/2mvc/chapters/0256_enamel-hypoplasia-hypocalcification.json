    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Treatment depends upon extent of lesions and equipment and materials available.",
          "pdf_page": 523,
          "printed_page": 441,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Goal is to provide the smoothest surface possible.",
          "pdf_page": 523,
          "printed_page": 441,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Enamel hypoplasia typically does not require treatment as the enamel is normal, just decreased in thickness. Enamel hypocalcification typically benefits from treatment.",
          "pdf_page": 523,
          "printed_page": 441,
          "column": 2
        },
        {
          "type": "subheading",
          "level": 0,
          "text": "Optimal Treatment",
          "pdf_page": 523,
          "printed_page": 441,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Gently remove diseased enamel (enamel",
          "pdf_page": 523,
          "printed_page": 441,
          "column": 2,
          "subheading": "Optimal Treatment"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "scrub) with white stone burs or finishing",
          "pdf_page": 523,
          "printed_page": 441,
          "column": 2,
          "subheading": "Optimal Treatment"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "disks on high-speed handpiece (adequate",
          "pdf_page": 523,
          "printed_page": 441,
          "column": 2,
          "subheading": "Optimal Treatment"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "water coolant).",
          "pdf_page": 523,
          "printed_page": 441,
          "column": 2,
          "subheading": "Optimal Treatment"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Take care not to damage the tooth—excess",
          "pdf_page": 523,
          "printed_page": 441,
          "column": 2,
          "subheading": "Optimal Treatment"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "enamel/dentin removal; hyperthermic damage",
          "pdf_page": 523,
          "printed_page": 441,
          "column": 2,
          "subheading": "Optimal Treatment"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "to pulp.",
          "pdf_page": 523,
          "printed_page": 441,
          "column": 2,
          "subheading": "Optimal Treatment"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Focal defects may be amenable to",
          "pdf_page": 523,
          "printed_page": 441,
          "column": 2,
          "subheading": "Optimal Treatment"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "composite restoration; many restorative",
          "pdf_page": 523,
          "printed_page": 441,
          "column": 2,
          "subheading": "Optimal Treatment"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "materials (bonding agents, composites)",
          "pdf_page": 523,
          "printed_page": 441,
          "column": 2,
          "subheading": "Optimal Treatment"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "require use of light-curing units and",
