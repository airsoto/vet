          "printed_page": 441,
          "column": 2,
          "subheading": "Optimal Treatment"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "significantly malformed; extraction or root canal",
          "pdf_page": 523,
          "printed_page": 441,
          "column": 2,
          "subheading": "Optimal Treatment"
