              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually a cutaneous marker for advanced liver disease with or without concurrent diabetes mellitus.",
              "pdf_page": 1388,
              "printed_page": 1306,
              "column": 1
            }
          ]
        },
