        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Shih tzu, Shetland sheepdog, West Highland white terrier, cocker spaniel overrepresented.",
              "pdf_page": 1388,
              "printed_page": 1306,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Older dogs.",
              "pdf_page": 1388,
              "printed_page": 1306,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Skin—lesions may precede clinical evidence of internal disease by weeks or months; erythema, crusts, and erosions/ulcerations affecting the muzzle, mucocutaneous areas of the face, pinna, distal limbs (especially elbows and hocks), feet, perineum, perianal area, and external genitalia.",
              "pdf_page": 1388,
              "printed_page": 1306,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Footpads—hyperkeratotic with fissures and ulcerations; pain when walking.",
              "pdf_page": 1388,
              "printed_page": 1306,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pruritus absent to severe.",
              "pdf_page": 1388,
              "printed_page": 1306,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary bacterial and/or yeast infection.",
              "pdf_page": 1388,
              "printed_page": 1306,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Feline—alopecia and scaling of the limbs and trunk (two cases); erythema, ulceration, crusting, and alopecia of the limbs and trunk (one case); crusts and hyperkeratosis of paw pads (one case).",
              "pdf_page": 1388,
              "printed_page": 1306,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Specific cause unknown.",
              "pdf_page": 1388,
              "printed_page": 1306,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cutaneous nutritional deprivation— probably hypoaminoacidemia and/or deficiencies in essential fatty acids and zinc; due to metabolic abnormalities caused by hyperglucagonemia, liver dysfunction, or a combination.",
              "pdf_page": 1388,
              "printed_page": 1306,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually associated with advanced liver disease with or without concurrent diabetes mellitus.",
              "pdf_page": 1388,
              "printed_page": 1306,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rarely associated with pancreatic or extrapancreatic glucagon-secreting tumor, ingestion of mycotoxins, or long-term phenobarbital and phenytoin therapies.",
              "pdf_page": 1388,
              "printed_page": 1306,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Feline—one case each of pancreatic carcinoma, hepatic carcinoid, hepatopathy, and hepatopathy and intestinal lymphoma.",
              "pdf_page": 1388,
              "printed_page": 1306,
              "column": 1
            }
          ]
        }
      }
    },
