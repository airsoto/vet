            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inappetence.",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Weight loss.",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Polyuria and/or polydipsia (PU/PD).",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hematuria.",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Depression, diarrhea, vomiting associated",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "with uremia in patients with bilateral",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hydronephrosis or with compromised",
