    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other causes for renal pelvic dilation—e.g., ureteral obstruction (stone, stricture, tumor), pyelonephritis, pyelonephrosis, IV fluid therapy, chronic kidney disease, PU/PD.",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other causes of renomegaly—e.g., neoplasia, cysts, and perinephric pseudocysts (cats).",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other causes of abdominal pain—e.g., pancreatitis and peritonitis.",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intervertebral disc disease leading to lumbar pain.",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other causes for azotemia—e.g., acute kidney injury, chronic kidney disease, dehydration, urethral obstruction.",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Normal in some patients.",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Loss of urine-concentrating ability (first abnormality detected), hematuria, pyuria.",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Azotemia, hyperphosphatemia, hyperkalemia, thrombocytopenia, and acidemia with either bilateral ureteral obstructions, concurrent renal parenchymal disease, or obstructive pyonephrosis.",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 2
            }
          ]
        },
