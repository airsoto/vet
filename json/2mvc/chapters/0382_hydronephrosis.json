    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Emergency intervention is required for ureteral obstruction; metabolic and electrolyte abnormalities should be corrected prior to intervention. If severe enough then hemo dialysis may be indicated.",
          "pdf_page": 747,
          "printed_page": 665,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Treat as an inpatient.",
          "pdf_page": 747,
          "printed_page": 665,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Start supportive care (e.g., fluids ± antibiotics) while performing diagnostic tests.",
          "pdf_page": 747,
          "printed_page": 665,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Correct fluid and electrolyte deficits conservatively with IV fluid therapy over 12–24 hours, followed by maintenance fluids as needed. Patients with extreme PU may need higher maintenance fluid rates to maintain hydration. Do not fluid overload patients.",
          "pdf_page": 747,
          "printed_page": 665,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Pending reestablishment of urinary patency, relieve lower urinary tract obstruction by catheterization, serial cystocentesis, or tube cystostomy as soon as possible.",
          "pdf_page": 747,
          "printed_page": 665,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Specific treatment (e.g., interventional or surgical) depends on the cause and whether there is concurrent kidney disease or other disease processes (e.g., bilateral uroliths affecting contralateral kidney and/or ureter, metastatic neoplasia, etc.).",
          "pdf_page": 747,
          "printed_page": 665,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Nephrectomy is rarely ever indicated (e.g., neoplasia).",
          "pdf_page": 747,
          "printed_page": 665,
          "column": 3
        }
      ],
