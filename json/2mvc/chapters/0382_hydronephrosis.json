              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "function in the contralateral kidney.",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May be referable to the cause of the",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "obstruction (e.g., abdominal pain).",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most dogs and cats with a ureteral",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "obstruction will continue to produce urine",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "due to the unilateral nature of the condition",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "or the presence of a partial, rather than",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "complete, ureteral obstruction.",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Normal in some patients.",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Renomegaly.",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Big kidney–little kidney syndrome",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "associated with a previous ureteral obstruction.",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Renal, abdominal, or lumbar pain.",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal mass—bladder or prostate.",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Trigonal, prostatic, vaginal or urethral mass",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "palpable on rectal exam.",
              "pdf_page": 747,
              "printed_page": 665,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
