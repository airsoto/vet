        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Dogs and cats equally affected.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Acute Exposure",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute signs progress within minutes to hours.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1,
              "subheading": "Acute Exposure"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neurologic signs—lethargy or agitation,",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1,
              "subheading": "Acute Exposure"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "weakness, ataxia, depressed mentation,",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1,
              "subheading": "Acute Exposure"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "deafness, coma, seizures.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1,
              "subheading": "Acute Exposure"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory—tachypnea and dyspnea.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1,
              "subheading": "Acute Exposure"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cardiovascular—tachycardia, dysrhythmias,",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1,
              "subheading": "Acute Exposure"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hypotension.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1,
              "subheading": "Acute Exposure"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperemic skin and mucous membranes",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1,
              "subheading": "Acute Exposure"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "are rarely apparent in animals.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1,
              "subheading": "Acute Exposure"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Chronic Exposure",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nausea, vomiting, decreased activity, and",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1,
              "subheading": "Chronic Exposure"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "cough; may mimic other diseases.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1,
              "subheading": "Chronic Exposure"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Disturbance of postural and position",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1,
              "subheading": "Chronic Exposure"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "reflexes and gait.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1,
              "subheading": "Chronic Exposure"
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Housed in areas with blocked exhaust vents, furnaces, appliances, or chimneys; exposure to automobile exhaust or kerosene heaters in closed spaces with poor ventilation.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Trapped in house or kennel fires.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Animals with impaired cardiac or pulmonary function.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Sedatives, ethanol, ethylene glycol, petroleum hydrocarbons, lead poisoning; cyanide or hydrogen sulfide gas toxicosis.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Smoke inhalation, primary neurologic disease, and severe metabolic disease.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Biochemistry—may see liver and kidney value elevations secondary to hypoxia.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Carboxyhemoglobin can be measured via co-oximetry; may return to normal within hours after removal from CO source. Available at human hospital or veterinary specialty/diagnostic lab.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Blood gas—metabolic acidosis due to lactic acidosis; arterial blood gas may have normal partial pressure of oxygen (PaO2).",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Thoracic radiographs—evaluate for pulmonary injury and rule out other causes of respiratory signs.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Pulse oximetry may overestimate hemo globin saturation (SpO2); COHb and oxyhemoglobin absorb light at the same wavelength.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "ECG—sinus tachycardia or cardiac dysrhythmia, ST-T depression with myocardial hypoxia/anoxia.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Blood pressure—hypotension common in shock.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": []
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Supplemental oxygen (flow-by, mask, nasal, oxygen cage, or intubation ± mechanical ventilation)—improves oxygen delivery to vital organs, especially brain and heart; decreases half-life of COHb.",
          "pdf_page": 305,
          "printed_page": 223,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Hyperbaric oxygen therapy use is controversial and not readily available in veterinary medicine, but will further reduce half-life of COHb.",
          "pdf_page": 305,
          "printed_page": 223,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "IV fluid therapy for hydration and perfusion and to correct metabolic acidosis.",
          "pdf_page": 305,
          "printed_page": 223,
          "column": 2
        }
      ],
