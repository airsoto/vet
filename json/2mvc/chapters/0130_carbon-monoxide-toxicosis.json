    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Patient monitoring—neurologic status, BP and ECG during hospitalization; frequency depends on stability of patient.",
          "pdf_page": 305,
          "printed_page": 223,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Possible complications—delayed neurologic signs within days to weeks of initial improvement; deafness may occur/persist in survivors.",
          "pdf_page": 305,
          "printed_page": 223,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Expected course and prognosis—respond and improve rapidly to oxygen therapy (within 30–60 minutes); prognosis guarded to poor with persistent or worsening respiratory and neurologic signs.",
          "pdf_page": 305,
          "printed_page": 223,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Prevention—use adequate ventilation with use of kerosene heaters in kennels and use CO detectors.",
          "pdf_page": 305,
          "printed_page": 223,
          "column": 3
        }
      ],
