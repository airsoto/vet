    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Sedatives and anxiolytics may be needed to allow oxygen supplementation—diazepam 0.1–0.5 mg/kg IV q6–8h.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Short-acting opioids such as fentanyl (2–5μg/kg IV followed by CRI 2–5μg/kg/h) can be used for pain and sedation.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 2
            }
          ]
        },
        "CONTRAINDICATIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CONTRAINDICATIONS",
          "content_blocks": []
        },
        "PRECAUTIONS": {
          "present": false,
