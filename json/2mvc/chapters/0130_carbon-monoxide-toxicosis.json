          "content_blocks": []
        },
        "POSSIBLE INTERACTIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "POSSIBLE INTERACTIONS",
          "content_blocks": []
        },
        "CONTRAINDICATIONS/POSSIBLE INTERACTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Limit 100% oxygen to <24 hours to avoid oxygen toxicosis.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 2
            }
          ]
        },
        "ALTERNATIVE DRUG(S)": {
          "present": false,
          "status": "missing",
