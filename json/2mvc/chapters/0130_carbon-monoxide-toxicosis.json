    "MISCELLANEOUS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "ASSOCIATED CONDITIONS": {
          "present": true,
          "status": "content",
          "source_heading": "ASSOCIATED CONDITIONS",
          "canonical_heading": "ASSOCIATED CONDITIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Animals in house fires may have dermal burns, thermal and smoke inhalation injury to the airways, corneal ulcerations, or other injuries.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 3
            }
          ]
        },
        "AGE-RELATED FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "AGE-RELATED FACTORS",
          "content_blocks": []
        },
        "ZOONOTIC POTENTIAL": {
          "present": true,
          "status": "content",
          "source_heading": "ZOONOTIC POTENTIAL",
          "canonical_heading": "ZOONOTIC POTENTIAL",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "People and other pets in the same CO-contaminated environment are at risk.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 3
            }
          ]
        },
        "PREGNANCY/FERTILITY/BREEDING": {
          "present": true,
          "status": "content",
          "source_heading": "PREGNANCY/FERTILITY/BREEDING",
          "canonical_heading": "PREGNANCY/FERTILITY/BREEDING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "CO reduces oxygen-carrying ability of maternal blood, producing fetal hypoxia, abortion, or neurologic impairment of the fetus, often with minimal effects on the dam.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 3
            }
          ]
        },
        "SYNONYMS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "SYNONYMS",
          "content_blocks": []
        },
        "SEE ALSO": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "SEE ALSO",
          "content_blocks": []
        },
        "ABBREVIATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "ABBREVIATIONS",
          "canonical_heading": "ABBREVIATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "COHb = carboxyhemoglobin.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "PaO2= partial pressure of oxygen.",
