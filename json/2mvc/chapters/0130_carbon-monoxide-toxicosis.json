  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Carbon monoxide (CO)—odorless, colorless, nonirritating gas produced by inefficient combustion of carbon fuels.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Common sources are fires, automotive exhaust, leaking coal, oil, or natural gas/propane furnaces, gas appliances or fireplaces, and some paint strippers and sprays.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CO is absorbed into the blood, forming carboxyhemoglobin (COHb).",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affinity of CO for hemoglobin is approx imately 240 times that of oxygen.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "COHb cannot bind oxygen and impairs oxyhemoglobin from releasing oxygen to the tissues.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Major effect is acute cellular hypoxia, leading to death.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Survivors may have cardiac damage, acute and delayed neurotoxicity.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lethal concentration is approximately 1,000 ppm (0.1%) for 1 hour.",
              "pdf_page": 305,
              "printed_page": 223,
              "column": 1
            }
          ]
        },
