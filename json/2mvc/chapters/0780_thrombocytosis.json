        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Platelets are produced by megakaryocytes in the bone marrow and circulate for approx imately 5–7 days. Approximately 30% of the circulating platelet mass resides transiently in the spleen and may be released suddenly with splenic contraction.",
              "pdf_page": 1413,
              "printed_page": 1331,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Platelet production is stimulated by thrombopoietin (TPO).",
              "pdf_page": 1413,
              "printed_page": 1331,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thrombocytosis can be physiologic or reactive. Causes include physiologic redistribution, inflammation, and neoplasia.",
              "pdf_page": 1413,
              "printed_page": 1331,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In humans, specific gene mutations have been associated with the development of essential thrombocytosis.",
              "pdf_page": 1413,
              "printed_page": 1331,
              "column": 1
            }
          ]
        },
        "SYSTEMS AFFECTED": {
          "present": true,
          "status": "content",
          "source_heading": "SYSTEMS AFFECTED",
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Hematologic—high circulating platelet count may impair ordinary hemostatic processes (especially von Willebrand factor-mediated platelet adhesion).",
              "pdf_page": 1413,
              "printed_page": 1331,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cardiovascular—thrombosis or hemorrhage: uncommon.",
              "pdf_page": 1413,
              "printed_page": 1331,
              "column": 1
            }
          ]
        },
