          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Use to identify underlying causes of reactive or neoplastic thrombocytosis. A diagnosis of essential thrombocytosis is generally one of exclusion.",
              "pdf_page": 1413,
              "printed_page": 1331,
              "column": 3
            }
          ]
        },
        "IMAGING": {
          "present": false,
          "status": "missing",
          "source_heading": null,
