              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypertension and tachycardia anticipated.",
              "pdf_page": 1356,
              "printed_page": 1274,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May note bronchorrhea, hypersalivation,",
