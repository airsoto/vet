        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Unerupted teeth.",
              "pdf_page": 448,
              "printed_page": 366,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Odontogenic keratocyst—cyst of the jaw demonstrating aggressive expansion that may, or may not, be associated with unerupted teeth.",
              "pdf_page": 448,
              "printed_page": 366,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Primordial cyst—cystic degeneration of a tooth bud before enamel/dentin formation (cyst without a tooth).",
              "pdf_page": 448,
              "printed_page": 366,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Oral mass—odontoma (complex or compound): tooth structures (enamel, dentin, cementum, and pulp) sometimes contained within cystic structure, but with different levels of organization.",
              "pdf_page": 448,
              "printed_page": 366,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Transformation to ameloblastomas have been reported in humans; histologic evaluation of the cyst lining is highly recommended.",
              "pdf_page": 448,
              "printed_page": 366,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "No abnormalities typically found.",
              "pdf_page": 448,
              "printed_page": 366,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Preoperative diagnostics where appropriate for safe administration of general anesthesia.",
              "pdf_page": 448,
              "printed_page": 366,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
