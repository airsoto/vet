        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Any breed that is at an increased risk for impaired eruption.",
              "pdf_page": 448,
              "printed_page": 366,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Boxers, bulldogs—mandibular first premolars, often bilateral.",
              "pdf_page": 448,
              "printed_page": 366,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Unerupted teeth at 6–7 months of age, but cystic development may not occur until much later, if at all.",
              "pdf_page": 448,
              "printed_page": 366,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cystic changes may be initially unapparent without diagnostic imaging.",
              "pdf_page": 448,
              "printed_page": 366,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "“Missing” tooth.",
              "pdf_page": 448,
              "printed_page": 366,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Formation of a soft swelling at the site of a missing tooth, often fluctuant with fluid.",
              "pdf_page": 448,
              "printed_page": 366,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Patient may present, with no previous indication of a problem, for a pathologic fracture of the mandible due to cystic destruction of the surrounding bone.",
              "pdf_page": 448,
              "printed_page": 366,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
