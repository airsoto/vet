        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Definitive diagnosis from radiography.",
              "pdf_page": 448,
              "printed_page": 366,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Radiographs are essential in any instance of missing or unerupted teeth.",
              "pdf_page": 448,
              "printed_page": 366,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Radiographically—radiolucent cyst originating from the remnant enamel organ at the neck of the tooth and encompassing the crown (a halo).",
              "pdf_page": 448,
              "printed_page": 366,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CT studies of the head should evaluate for presence of unerupted teeth.",
              "pdf_page": 448,
              "printed_page": 366,
              "column": 1
            }
          ]
        },
