        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog and cat.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rarely detected in animals <1 years old.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CPC uroliths occur primarily in female dogs (72%).",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Depend on location, size, and number of",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "uroliths.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pollakiuria, dysuria, hematuria,",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "and urethral obstruction.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nephroureteroliths— typically asymptomatic but may have persistent hematuria or signs referable to concomitant renal failure (primarily cats).",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "CPC—commonly a minor component of struvite and calcium oxalate uroliths.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pure CP uroliths—usually associated with metabolic disorders, e.g., primary hyperparathyroidism, renal tubular acidosis, and excessive dietary calcium and phosphorus.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urinary tract infections—increased calcium excretion in combination with urinary tract infection with urease producing bacteria may",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "be risk factors favoring CPC.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nephroliths, urocystoliths, and urethroliths composed of blood clots mineralized with CP suggest dystrophic mineralization of tissue, in contrast to metastatic mineralization reflecting abnormal calcium and phosphorus",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "metabolism.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other risk factors—see Urolithiasis, Calcium Oxalate. Table 1 Calcium phosphate uroliths submitted to the Minnesota Urolith Center (MUC) in 2013. Calcium phosphate carbonate form (CPC) Calcium phosphate apatite form (CAP) Calcium hydrogen phosphate dihydrate (Brushite)",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other common causes of hematuria, dysuria, and pollakiuria, with or without urethral obstruction, include urinary tract infection and",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "urinary tract neoplasia.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other radiodense uroliths—magnesium ammonium phosphate,",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "calcium oxalate, and silica.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metastatic or dystrophic mineralization of urinary tract parenchyma may resemble uroliths.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually unremarkable.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypercalcemia or azotemia rarely detected; postrenal azotemia in some animals with complete urinary outflow",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "obstruction.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urinary sediment analysis— amorphous crystals in some patients; brushite (calcium hydrogen phosphate dihydrate) forms are elongated, rectangular, lath-shaped crystals.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Quantitative analysis of retrieved uroliths is necessary to confirm their mineral composi-",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "tion.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Serum concentrations of parathyroid hormone, parathyroid hormone–related peptide, and hydroxycholecalciferol may help establish underlying causes.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "CP uroliths are radiodense (as dense as bone) and are often detected by survey radiography.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CP uroliths may be detected by ultrasonography.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "CP uroliths in the urethra and bladder may be detected by cystoscopy.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": false,
