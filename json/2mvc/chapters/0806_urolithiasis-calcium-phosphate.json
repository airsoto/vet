  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Calcium phosphate (CP) uroliths within the urinary tract and associated clinical conditions.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Forms of CP identified in dogs and cats include: calcium phosphate apatite (CAP), calcium phosphate carbonate (CPC), calcium hydrogen phosphate dihydrate (brushite), and uncommon minerals—tricalcium phosphate",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "(whitlockite) and octacalcium phosphate.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CP uroliths represent a small fraction (dogs <1.0%, cats <0.5%) of all uroliths submitted to the Minnesota Urolith Center (MUC) from 1981",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "to 2018 (Table 1).",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "More CP uroliths are found in the upper tract (kidney and ureter) (2.5% cats, 3.5% dogs), than in the lower tract",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "(bladder and urethra).",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CP uroliths (excluding brushite) do not have a characteristic shape. Brushite uroliths are typically round and",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "smooth.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CP uroliths are usually cream or tan in color. Blood clots mineralized with CP are typically black.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 1
            }
          ]
        },
