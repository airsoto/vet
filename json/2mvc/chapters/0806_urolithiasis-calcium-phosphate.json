    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Radiography after surgery to verify complete urolith removal is a standard of practice.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal radiography or ultrasonography every 3–5 months to enhance early detection of urolith recurrence and prevention of the need for repeated",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "surgery.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Small uroliths are easily removed by voiding urohydropropulsion or catheter retrieval.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 3
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "A high-moisture (canned) diet formulated to prevent formation of calcium oxalate",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "uroliths may help prevent recurrence.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Foods for older dogs that are lower in protein, phosphorus, and calcium, and which do not promote acidic urine are usually associated with decreased calcium and phosphorus excretion. Hill’s Prescription Diet canned g/d",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "is one example.",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Because of the high moisture content of canned foods and their tendency to promote dilute urine, canned diets are more effective than dry diets in",
              "pdf_page": 1457,
              "printed_page": 1375,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "preventing recurrence.",
