      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary bone fibrosarcoma (FSA) arises from stromal elements within the marrow cavity and is characterized by malignant spindle cells that produce varying amounts of collagen but not any osteoid or cartilage.",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In dogs, FSA accounts for<8% of all primary bone tumors, with 60% occurring in the axial skeleton and 40% arising in the appendicular skeleton.",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bone tumors are rare in cats. FSA is the second most common bone tumor in cats and can involve the maxilla, mandible, humerus, scapula, carpus, digits, ribs, and sacrum.",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1
            }
          ]
        },
