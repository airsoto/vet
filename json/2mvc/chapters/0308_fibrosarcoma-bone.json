          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other primary bone tumors (osteosarcoma, chondrosarcoma, hemangiosarcoma, histiocytic sarcoma, etc.).",
