        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog and cat; no obvious breed or gender predilections in either species.",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mean age of dogs 9.7 years (range: 2–15 years).",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affected cats tended to be older, but have been reported as young as 1.5 years old.",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Appendicular FSA",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lameness, usually progressive, but occasionally",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1,
              "subheading": "Appendicular FSA"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "acute if there is a pathologic fracture.",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1,
              "subheading": "Appendicular FSA"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "A palpable swelling may be present.",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1,
              "subheading": "Appendicular FSA"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Axial FSA",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Localized swelling with or without pain is",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1,
              "subheading": "Axial FSA"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "common; however, anatomic site dependent.",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1,
              "subheading": "Axial FSA"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tumors arising from the mandible or",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1,
              "subheading": "Axial FSA"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "maxilla can be associated with halitosis,",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1,
              "subheading": "Axial FSA"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "dysphagia, pain on opening the mouth, or",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1,
              "subheading": "Axial FSA"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "nasal discharge.",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1,
              "subheading": "Axial FSA"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vertebral tumors may induce neurologic",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1,
              "subheading": "Axial FSA"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "deficits secondary to spinal cord compression.",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1,
              "subheading": "Axial FSA"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rib tumors are rarely associated with",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1,
              "subheading": "Axial FSA"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "respiratory signs unless large and causing",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1,
              "subheading": "Axial FSA"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "space-occupying effects. Rib tumors can grow",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1,
              "subheading": "Axial FSA"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "asymmetrically, with majority of growth",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1,
              "subheading": "Axial FSA"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "occurring within the intrathoracic space.",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1,
              "subheading": "Axial FSA"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "For appendicular FSA, lameness and a",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "palpable swelling may be present.",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Physical examination findings may be",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "variable for FSA for the axial skeleton",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "depending on the size and location of the",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "tumor; a mass may be visible or palpable.",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
