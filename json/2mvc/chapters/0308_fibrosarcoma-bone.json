              "printed_page": 532,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "carcinoma, melanoma, fibrosarcoma,",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 2,
              "subheading": "CONTRAINDICATIONS/POSSIBLE"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "INTERACTIONS",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "ameloblastoma; synovial sarcoma; histiocytic",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Use NSAIDs cautiously in all cats and in",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "sarcoma; digital squamous cell carcinoma,",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "dogs with renal insufficiency.",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "melanoma).",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Do not combine NSAIDs with corticosteroids.",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hematopoietic tumors (myeloma,",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "lymphoma).",
              "pdf_page": 614,
              "printed_page": 532,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
