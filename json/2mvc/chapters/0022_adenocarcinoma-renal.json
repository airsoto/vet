        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Adenocarcinoma—older (8–9 years) dogs, 1.6 : 1 male-to-female ratio, no breed predilection.",
              "pdf_page": 118,
              "printed_page": 36,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cystadenocarcinoma—German shepherd dogs, often female.",
              "pdf_page": 118,
              "printed_page": 36,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Adenocarcinoma—insidious, nonspecific signs such as weight loss, inappetance, lethargy, hematuria, and pale mucous membranes.",
              "pdf_page": 118,
              "printed_page": 36,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cystadenocarcinoma—may present for nodular dermatofibrosis, a syndrome of painless, firm, fibrous lesions of the skin and subcutaneous tissues.",
              "pdf_page": 118,
              "printed_page": 36,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Adenocarcinoma—unknown.",
              "pdf_page": 118,
              "printed_page": 36,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cystadenocarcinoma—heritable in German shepherd dogs.",
              "pdf_page": 118,
              "printed_page": 36,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other primary neoplasia (i.e., lymphoma, nephroblastoma).",
              "pdf_page": 118,
              "printed_page": 36,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metastatic neoplasia (i.e., hemangiosarcoma).",
              "pdf_page": 118,
              "printed_page": 36,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Renal adenoma or cyst.",
              "pdf_page": 118,
              "printed_page": 36,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pyelonephritis.",
              "pdf_page": 118,
              "printed_page": 36,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "CBC may show paraneoplastic polycythemia or leukocytosis, or anemia.",
              "pdf_page": 118,
              "printed_page": 36,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Biochemistry may be normal, or may reveal azotemia. Marked gamma-glutamyltransferase (GGT) elevation may be prognostic.",
              "pdf_page": 118,
              "printed_page": 36,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urinalysis may show hematuria, proteinuria, bacteriuria, or casts.",
              "pdf_page": 118,
              "printed_page": 36,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Urine culture and sensitivity.",
              "pdf_page": 118,
              "printed_page": 36,
              "column": 1
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiographs—metastatic disease reported in up to 16% of patients.",
              "pdf_page": 118,
              "printed_page": 36,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal radiographs—mass visualized in 81% of patients.",
              "pdf_page": 118,
              "printed_page": 36,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal ultrasonography, CT, or contrast radiography—useful in identifying and staging the disease.",
              "pdf_page": 118,
              "printed_page": 36,
              "column": 1
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "neutrophilic leukocytosis have been reported",
              "pdf_page": 118,
              "printed_page": 36,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Renal biopsy (ultrasound guided or in isolated cases. surgical) for definitive diagnosis.",
              "pdf_page": 118,
              "printed_page": 36,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Renal failure.",
              "pdf_page": 118,
              "printed_page": 36,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mitotic index found to be prognostic in 70",
              "pdf_page": 118,
              "printed_page": 36,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nodular dermatofibrosis and uterine dogs treated with nephrectomy. leiomyomas are commonly associated with cystadenocarcinoma.",
              "pdf_page": 118,
              "printed_page": 36,
              "column": 2
            }
          ]
        },
