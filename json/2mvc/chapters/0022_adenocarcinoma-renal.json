      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Accounts for <1% of all reported neoplasms in dogs.",
              "pdf_page": 118,
              "printed_page": 36,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Renal tumors tend to be highly metastatic, locally invasive, and often bilateral.",
              "pdf_page": 118,
              "printed_page": 36,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Renal cystadenocarcinoma, a rare heritable syndrome with a less aggressive behavior and better long-term prognosis than renal adenocarcinoma, has been described in German shepherd dogs.",
              "pdf_page": 118,
              "printed_page": 36,
              "column": 1
            }
          ]
        },
