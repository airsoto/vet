          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Rapid development of myocardial necrosis resulting from sustained, complete reduction of blood flow to a portion of the myocardium, caused by thrombus formation.",
              "pdf_page": 1015,
              "printed_page": 933,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Uncommon as a naturally occurring disease",
              "pdf_page": 1015,
              "printed_page": 933,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "in dogs.",
              "pdf_page": 1015,
              "printed_page": 933,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Microscopic intramural myocardial infarctions and focal areas of myocardial fibrosis are common in dogs with acquired",
              "pdf_page": 1015,
              "printed_page": 933,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "cardiovascular disease.",
              "pdf_page": 1015,
              "printed_page": 933,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Consistent electro cardiogram (ECG) characteristics of spontaneous myocardial infarction are not well characterized in dogs and cats.",
              "pdf_page": 1015,
              "printed_page": 933,
              "column": 1
            }
          ]
        },
