      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "A focal, light brown to black, plaque-like area of stromal coagulation necrosis usually located axially.",
              "pdf_page": 420,
              "printed_page": 338,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually caused by chronic corneal ulceration, trauma, or exposure.",
              "pdf_page": 420,
              "printed_page": 338,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Synonym—keratitis nigrum.",
              "pdf_page": 420,
              "printed_page": 338,
              "column": 1
            }
          ]
        },
