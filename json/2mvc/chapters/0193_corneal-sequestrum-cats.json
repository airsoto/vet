        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—any breed, age.",
              "pdf_page": 420,
              "printed_page": 338,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Brachycephalic breeds, Siamese predisposed.",
              "pdf_page": 420,
              "printed_page": 338,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Colorpoints may be genetically predisposed.",
              "pdf_page": 420,
              "printed_page": 338,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Unilateral or bilateral, focal round to oval, variably sized areas of corneal discoloration ranging from translucent golden-brown (early) to opaque black (chronic).",
              "pdf_page": 420,
              "printed_page": 338,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Often with chronic nonhealing corneal ulcer.",
              "pdf_page": 420,
              "printed_page": 338,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Corneal vascularization and edema.",
              "pdf_page": 420,
              "printed_page": 338,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "History of feline herpesvirus-1 (FHV-1) keratoconjunctivitis.",
              "pdf_page": 420,
              "printed_page": 338,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Blepharospasm or ocular discharge.",
              "pdf_page": 420,
              "printed_page": 338,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Conjunctival hyperemia and chemosis.",
              "pdf_page": 420,
              "printed_page": 338,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Miotic pupil.",
              "pdf_page": 420,
              "printed_page": 338,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May be static for long periods or may rapidly progress.",
              "pdf_page": 420,
              "printed_page": 338,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "With chronicity, corneal vascularization may extrude plaque.",
              "pdf_page": 420,
              "printed_page": 338,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Thought to involve chronic mechanical corneal irritation or ulceration with corneal necrosis and desiccation.",
              "pdf_page": 420,
              "printed_page": 338,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Risk factors include chronic corneal ulceration, chronic trichiasis or entropion, brachycephalic conformation, lagophthalmia, keratoconjunctivitis sicca (KCS), qualitative tear film disorders (lipid or mucin deficiency), FHV-1 infection, topical corticosteroids, and iatrogenic trauma (grid keratotomy).",
              "pdf_page": 420,
              "printed_page": 338,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Corneal perforation/iris prolapse—protruding iris is fleshy and yellow to light brown.",
              "pdf_page": 420,
              "printed_page": 338,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Corneal foreign body.",
              "pdf_page": 420,
              "printed_page": 338,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Corneal pigmentation—rare in cats.",
              "pdf_page": 420,
              "printed_page": 338,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Corneal neoplasia—melanocytoma occurs at limbus and is typically nonpainful.",
              "pdf_page": 420,
              "printed_page": 338,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
