        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Schirmer tear test—very low values suggest KCS, but some normal cats have low values.",
              "pdf_page": 420,
              "printed_page": 338,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Corneal culture and cytology to rule out corneal infection.",
              "pdf_page": 420,
              "printed_page": 338,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fluorescein stain.",
              "pdf_page": 420,
              "printed_page": 338,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tear film breakup time (TBUT)—normal time to breakup of fluorescein-stained tear film is 21 seconds; TBUT may be decreased in cats with sequestra or FHV-1 due to mucin",
              "pdf_page": 420,
              "printed_page": 338,
              "column": 2
            }
          ]
        },
