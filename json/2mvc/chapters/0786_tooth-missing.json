        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Any breed, size or gender, but smaller breeds predominate.",
              "pdf_page": 1423,
              "printed_page": 1341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Some familial tendencies, breed prevalence.",
              "pdf_page": 1423,
              "printed_page": 1341,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Tooth not present (crown and root).",
              "pdf_page": 1423,
              "printed_page": 1341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Alveolar bone and gingival margin at site is regular, smooth, even slightly “scalloped” appearance.",
              "pdf_page": 1423,
              "printed_page": 1341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No tooth structure present radiographically.",
              "pdf_page": 1423,
              "printed_page": 1341,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog/cat.",
              "pdf_page": 1423,
              "printed_page": 1341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Total and partial anodontia—typically hereditary and may be associated with ectodermal dysplasia (Chinese crested dogs).",
              "pdf_page": 1423,
              "printed_page": 1341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bilateral patterns of missing teeth may be indicative of a genetic or familial tendency, as opposed to a single missing tooth.",
              "pdf_page": 1423,
              "printed_page": 1341,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Delayed eruption.",
              "pdf_page": 1423,
              "printed_page": 1341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Unerupted teeth (see Dentigerous Cyst).",
              "pdf_page": 1423,
              "printed_page": 1341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Invulsed tooth.",
              "pdf_page": 1423,
              "printed_page": 1341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Extracted or lost due to periodontal disease or trauma.",
              "pdf_page": 1423,
              "printed_page": 1341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fusion tooth—if two teeth have fused, there will be reduction in the tooth number (see Tooth Formation/Structure, Abnormal).",
              "pdf_page": 1423,
              "printed_page": 1341,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Typically not affected.",
              "pdf_page": 1423,
              "printed_page": 1341,
              "column": 2
            }
          ]
        },
