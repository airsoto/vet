        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Intraoral radiographs essential.",
              "pdf_page": 1423,
              "printed_page": 1341,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Determine if teeth are truly missing, and/or if permanent teeth are present, if deciduous teeth are persistent/retained.",
              "pdf_page": 1423,
              "printed_page": 1341,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pre-purchase full-mouth radiographs on 8- to 10-week-old puppies can identify if permanent tooth structures are present (though there is no guarantee they will erupt).",
              "pdf_page": 1423,
              "printed_page": 1341,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Complete oral examination.",
              "pdf_page": 1423,
              "printed_page": 1341,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Appropriate preoperative diagnostics when indicated prior to procedure.",
              "pdf_page": 1423,
              "printed_page": 1341,
              "column": 2
            }
          ]
        },
