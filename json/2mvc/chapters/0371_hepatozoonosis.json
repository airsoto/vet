    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Mostly palliative, as no treatments have been shown to clear infection.",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Combination therapy (TCP) initially:",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Trimethoprim/sulfadiazine—15 mg/kg",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "PO q12h for 14 days.",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Clindamycin—10 mg/kg PO q8h for 14 days.",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Pyrimethamine—0.25 mg/kg PO q24h",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "for 14 days.",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Followed with long-term therapy— decoquinate 10–20 mg/kg PO q12h for up to 33 months (possibly indefinite).",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ponazuril 10 mg/mg PO q12h for 28 days has shown promise as an alternative initial treatment; long-term therapy with decoquinate is still necessary.",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Glucocorticoids—may give temporary relief, but are not routinely recommended.",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nonsteroidal anti-inflammatory drugs (NSAIDs) may provide analgesia.",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 2
            }
          ]
        },
