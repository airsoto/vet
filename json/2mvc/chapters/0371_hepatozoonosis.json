        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Neutrophilic leukocytosis, usually profound (20,000–200,000 white blood cells [WBC]/μL), sometimes with a left shift.",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anemia—mild to moderate, usually nonregenerative.",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually have a normal platelet count unless there is a coinfection.",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "High serum alkaline phosphatase (ALP)",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 1
            }
          ]
        },
