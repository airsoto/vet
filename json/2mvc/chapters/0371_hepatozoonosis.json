              "printed_page": 645,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "canine hepatozoonosis.",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 1,
              "subheading": "americanum—the primary cause of American"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hepatozoon canisis less prevalent in the",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 1,
              "subheading": "americanum—the primary cause of American"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "United States thanHepatozoon americanum; it",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "is also less virulent and infections are typically",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 1,
              "subheading": "United States thanHepatozoon americanum; it"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "subclinical.",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 1,
              "subheading": "United States thanHepatozoon americanum; it"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infection typically involves muscle and bone.",
