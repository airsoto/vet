        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs and rarely cats.",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No age, breed, or sex predilections.",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Lameness and stiff gait.",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Waxing and waning fever.",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mucopurulent ocular discharge.",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperesthesia.",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Weight loss and cachexia.",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Polyuria and polydipsia in some cases if glomerulonephritis is present.",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 1
            }
          ]
        },
