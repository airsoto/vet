              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Hepatozoon canis; here the focus is on",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "systemic infection withHepatozoon",
              "pdf_page": 727,
              "printed_page": 645,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "americanum—the primary cause of American",
