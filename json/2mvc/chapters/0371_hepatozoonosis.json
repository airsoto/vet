    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Inpatient—for severe pain; provide symptomatic relief.",
          "pdf_page": 727,
          "printed_page": 645,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Pain management—as for any musculoskeletal disease.",
          "pdf_page": 727,
          "printed_page": 645,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "General activity level and appetite—depend on pain level.",
          "pdf_page": 727,
          "printed_page": 645,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Most dogs will require lifelong treatment to maintain clinical remission.",
          "pdf_page": 727,
          "printed_page": 645,
          "column": 2
        }
      ],
