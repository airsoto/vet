    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Brown recluse spider bite is frequently misdiagnosed in regions of the country that do not have endemic populations of the spider.",
          "pdf_page": 1357,
          "printed_page": 1275,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Epidemiologic history of bite including site of lesion, progression timeline of signs, and visualization of small puncta assist with",
          "pdf_page": 1357,
          "printed_page": 1275,
          "column": 2
        }
      ],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
