        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Dogs and cats.",
              "pdf_page": 1357,
              "printed_page": 1275,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical signs are not completely defined in canine and feline envenomations.",
              "pdf_page": 1357,
              "printed_page": 1275,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In humans:",
              "pdf_page": 1357,
              "printed_page": 1275,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Local pain and stinging (may last 6–8",
              "pdf_page": 1357,
              "printed_page": 1275,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hours); followed by pruritus and soreness.",
              "pdf_page": 1357,
              "printed_page": 1275,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Classic target lesion—ischemic area with a",
              "pdf_page": 1357,
              "printed_page": 1275,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "dark central eschar on an uneven erythematous background; after 2–5 weeks, central eschar may slough, leaving a deep, nonhealing ulcer that usually spares muscle tissue.",
              "pdf_page": 1357,
              "printed_page": 1275,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Not all skin lesions develop necrosis.",
              "pdf_page": 1357,
              "printed_page": 1275,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Less common—hemolytic anemia with",
              "pdf_page": 1357,
              "printed_page": 1275,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hemoglobinuria in the first 24 hours; secondary renal complications.",
              "pdf_page": 1357,
              "printed_page": 1275,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Skin lesion severity and hemolysis are not",
              "pdf_page": 1357,
              "printed_page": 1275,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "linked.",
              "pdf_page": 1357,
              "printed_page": 1275,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Other possible systemic manifestations",
              "pdf_page": 1357,
              "printed_page": 1275,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "within the first 2–3 days after envenomation: fever; chills; rash; weakness; leukocytosis; nausea; arthralgia.",
              "pdf_page": 1357,
              "printed_page": 1275,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Envenomations to fatty areas develop",
              "pdf_page": 1357,
              "printed_page": 1275,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "more significant lesions; those occurring in loose tissue more likely to be edematous.",
              "pdf_page": 1357,
              "printed_page": 1275,
              "column": 1
            }
          ]
        },
