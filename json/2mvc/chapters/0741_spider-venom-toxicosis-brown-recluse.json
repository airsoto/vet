    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Tetracycline can be applied topically as a matrix metalloproteinase inhibitor.",
              "pdf_page": 1357,
              "printed_page": 1275,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperbaric oxygen—some evidence indicates that hyperbaric oxygen treatment may be beneficial for reducing size of the skin lesion.",
              "pdf_page": 1357,
              "printed_page": 1275,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dapsone—mixed results in various studies; 1 mg/kg q8h orally for 10 days; for dermatonecrotic lesions; leukocyte inhibitor; proposed to minimize inflammatory component of envenomation; repeat if needed. Efficacy against brown recluse envenomation has not been studied in the dog and cat.",
              "pdf_page": 1357,
              "printed_page": 1275,
              "column": 3
            }
          ]
        },
