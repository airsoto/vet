              "text": "Third-degree burn.",
              "pdf_page": 1357,
              "printed_page": 1275,
              "column": 2,
              "subheading": "methicillin-resistantStaphylococcus aureusby a"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hemolytic anemia.",
              "pdf_page": 1357,
              "printed_page": 1275,
              "column": 2,
              "subheading": "methicillin-resistantStaphylococcus aureusby a"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Jaundice.",
              "pdf_page": 1357,
              "printed_page": 1275,
              "column": 2,
              "subheading": "methicillin-resistantStaphylococcus aureusby a"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Necrotizing vasculitis.",
              "pdf_page": 1357,
              "printed_page": 1275,
              "column": 2,
              "subheading": "methicillin-resistantStaphylococcus aureusby a"
            },
            {
              "type": "bullet",
              "level": 0,
