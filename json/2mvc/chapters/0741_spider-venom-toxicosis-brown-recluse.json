    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Routine wound care—may need aggressive supportive care.",
          "pdf_page": 1357,
          "printed_page": 1275,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Supportive care—may include fluid therapy; secondary infections are infrequent; blood transfusion (rarely).",
          "pdf_page": 1357,
          "printed_page": 1275,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Mild, local envenomation—usually responds to cool compresses as sphingomyelinase D activity is temperature dependent.",
          "pdf_page": 1357,
          "printed_page": 1275,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Necrotic lesions—may need debridement after erythema has subsided.",
          "pdf_page": 1357,
          "printed_page": 1275,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Severe envenomation—may require skin grafting after the lesion reaches full maturity.",
          "pdf_page": 1357,
          "printed_page": 1275,
          "column": 2
        }
      ],
