          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Megaesophagus ± aspiration pneumonia.",
              "pdf_page": 501,
              "printed_page": 419,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Distended bowel loops with no peristalsis.",
