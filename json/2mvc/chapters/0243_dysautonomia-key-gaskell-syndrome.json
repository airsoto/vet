            },
            {
              "type": "bullet",
              "level": 0,
              "text": "occasionally constipation.",
              "pdf_page": 501,
              "printed_page": 419,
              "column": 1,
              "subheading": "Presenting Complaints"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Straining to",
