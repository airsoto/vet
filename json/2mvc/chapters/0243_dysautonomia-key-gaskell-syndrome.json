              "type": "bullet",
              "level": 0,
              "text": "cholinergic or adrenergic drugs.",
              "pdf_page": 501,
              "printed_page": 419,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Great care must be exercised in using such drugs, particularly adrenergic drugs that could precipitate fatal tachyarrhythmias; best to",
              "pdf_page": 501,
              "printed_page": 419,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "start at<10% of low end of dose range when",
              "pdf_page": 501,
              "printed_page": 419,
              "column": 2
