              "type": "paragraph",
              "level": 0,
              "text": "using direct-acting drugs and escalate dose as",
              "pdf_page": 501,
              "printed_page": 419,
              "column": 2,
              "subheading": "start at<10% of low end of dose range when"
            },
            {
              "type": "paragraph",
