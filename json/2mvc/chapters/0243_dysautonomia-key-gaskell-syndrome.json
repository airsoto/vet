              "printed_page": 419,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sensory or motor deficits are minimal.",
              "pdf_page": 501,
              "printed_page": 419,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Presenting Complaints",
              "pdf_page": 501,
              "printed_page": 419,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most commonly gastrointestinal (GI) signs",
