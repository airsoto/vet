              "column": 1,
              "subheading": "Presenting Complaints"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "of vomiting or regurgitation, diarrhea, or",
              "pdf_page": 501,
              "printed_page": 419,
              "column": 1,
