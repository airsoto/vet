        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "If pupils affected, 0.05% pilocarpine drops in one eye will produce miosis within 60 minutes; rules out anticholinergic toxicity.",
              "pdf_page": 501,
              "printed_page": 419,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Atropine (0.03 mg/kg IV) may not produce expected rise in heart rate; suggests loss of",
              "pdf_page": 501,
              "printed_page": 419,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "vagal tone.",
              "pdf_page": 501,
              "printed_page": 419,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intradermal histamine may produce no response or wheal but no flare; demonstrates loss of sympathetic innervation of arterioles.",
              "pdf_page": 501,
              "printed_page": 419,
              "column": 2
            }
          ]
        },
