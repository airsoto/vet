    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Antibiotics as needed to treat secondary",
              "pdf_page": 501,
              "printed_page": 419,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "infections.",
              "pdf_page": 501,
              "printed_page": 419,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prokinetic drug such as metoclopramide if GI motility affected.",
              "pdf_page": 501,
              "printed_page": 419,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bethanechol to stimulate lacrimation and urination (start at 0.05 mg/kg q8–12h and adjust dose based on response); manual expression of bladder more reliable.",
              "pdf_page": 501,
              "printed_page": 419,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ocular pilocarpine to relieve photophobia.",
              "pdf_page": 501,
              "printed_page": 419,
              "column": 2
            },
