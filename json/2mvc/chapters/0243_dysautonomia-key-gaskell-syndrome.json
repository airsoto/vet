          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute to subacute onset (5–14 days).",
              "pdf_page": 501,
              "printed_page": 419,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Various combinations of signs may be present, but both sympathetic and para sympathetic signs in various organs are necessary to be confident of diagnosis.",
