        "DEFINITION": {
          "present": true,
          "status": "content",
          "source_heading": "DEFINITION",
          "canonical_heading": "DEFINITION",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Optic neuritis—inflammation of one or both optic nerves, resulting in reduction of visual function.",
              "pdf_page": 1080,
              "printed_page": 998,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Papilledema is edema of the optic nerve head that does not obviously affect the function of the optic nerve.",
              "pdf_page": 1080,
              "printed_page": 998,
              "column": 1
            }
          ]
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Optic neuritis may be a primary disease or secondary to CNS disease because the optic nerve communicates with the subarachnoid space.",
              "pdf_page": 1080,
              "printed_page": 998,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Papilledema occurs when intracranial pressure (ICP) is elevated.",
              "pdf_page": 1080,
              "printed_page": 998,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Papilledema may occur separately from optic neuritis.",
              "pdf_page": 1080,
              "printed_page": 998,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Optic neuritis may also feature papilledema.",
              "pdf_page": 1080,
              "printed_page": 998,
              "column": 1
            }
          ]
        },
