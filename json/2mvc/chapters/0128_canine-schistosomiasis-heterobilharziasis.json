              "text": "Bacterial diarrhea.",
              "pdf_page": 301,
              "printed_page": 219,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Viral enteritis.",
              "pdf_page": 301,
              "printed_page": 219,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hepatopathies.",
              "pdf_page": 301,
              "printed_page": 219,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "CBC—anemia, lymphopenia, eosinopenia or eosinophilia, thrombocytopenia.",
              "pdf_page": 301,
              "printed_page": 219,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Biochemistry—elevated liver enzyme activities, azotemia, hypercalcemia, hyper natremia, hyperglobulinemia, hypoalbuminemia.",
              "pdf_page": 301,
              "printed_page": 219,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urinalysis—proteinuria.",
              "pdf_page": 301,
              "printed_page": 219,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Elevated parathyroid hormone-related protein (PTH-rp) reported in dogs with hypercalcemia.",
              "pdf_page": 301,
              "printed_page": 219,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "PCR on feces (Texas A&M Gastrointestinal Laboratory).",
              "pdf_page": 301,
              "printed_page": 219,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Contrast radiographs and ultrasound may reveal thickened bowel walls; calcified eggs disseminated into tissues may give the false impression of soft tissue mineralization.",
              "pdf_page": 301,
              "printed_page": 219,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Eggs with miracidia can be identified in feces, but feces must be kept in saline (not water) or miracidia will spontaneously hatch, making diagnosis impossible.",
              "pdf_page": 301,
              "printed_page": 219,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fecal direct or sedimentation methods are preferred to fecal flotation; routine fecal flotation will not detect these heavy eggs; if used, requires flotation with sugar solution with specific gravity of 1.3.",
              "pdf_page": 301,
              "printed_page": 219,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Histopathology—trematode eggs in multiple organs (especially liver, intestine, pancreas, lymph nodes); lymphoplasmacytic, histiocytic, and eosinophilic to granuloma tous enteritis, hepatitis with possible peri-portal fibrosis, dystrophic mineralization of multiple tissues.",
              "pdf_page": 301,
              "printed_page": 219,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
