        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Vary in severity. Normal neurologic examination does not rule out spinal dysraphism.",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Dogs",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Associated physical exam findings include",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "indentation of the epaxial muscles, abnormal",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hair streams in the dorsal cervical area (a",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "desired trait in the Rhodesian ridgeback),",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "kinking of the undocked tail, scoliosis, and",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Without sophisticated imaging techniques,",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "koilosternia (depression of the sternum).",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "an antemortem diagnosis may be impossible",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In the Weimaraner, gait is characterized by",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "except in Weimaraner and Manx cat.",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "simultaneous flexion and extension of pelvic",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "limbs (bunny hopping). Proprioceptive",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "deficits, base wide stance, and crouched pelvic",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "limb posture are also often present.",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In animals with syringomyelia (e.g., cavalier",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mildly affected animals may be acceptable",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "King Charles spaniel with COMS), any",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "pets.",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "combination of neck or head pain, progressive",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Severely affected, nonsurgical animals may",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "forelimb weakness, paraparesis, imbalance,",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "benefit from a canine cart; consider euthanasia.",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "paroxysmal involuntary flank or neck",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Surgical options include foramen magnum",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "scratching may be present.",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "remodeling (with occipital malformation) or",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Dogs"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Cats",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "ventriculoperitoneal shunt placement;",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "In affected Manx cats, pelvic limb paresis or",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "laminectomy, ± syringo-subarachnoid",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "paralysis, urinary and fecal retention,",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "shunting. These procedures may reduce pain",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "abnormal or absent caudal vertebrae, and",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "or lead to improvement in neurologic signs.",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "structural abnormalities in the sacrum may be",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "However, sensory disturbances such as",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "present.",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "scratching infrequently resolve, and",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "recurrence is possible.",
              "pdf_page": 1358,
              "printed_page": 1276,
              "column": 2,
              "subheading": "Cats"
            }
          ]
        },
