          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Any patient with advanced CKD—juvenile or acquired.",
              "pdf_page": 162,
              "printed_page": 80,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Anemia contributes to anorexia, weight loss, fatigue, lethargy, depression, weakness, and behavior changes characterizing CKD.",
              "pdf_page": 162,
              "printed_page": 80,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pallor.",
              "pdf_page": 162,
              "printed_page": 80,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tachypnea.",
              "pdf_page": 162,
              "printed_page": 80,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tachycardia.",
              "pdf_page": 162,
              "printed_page": 80,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Systolic murmur.",
              "pdf_page": 162,
              "printed_page": 80,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
