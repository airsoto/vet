      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Anemia of chronic infectious, inflammatory, or neoplastic disease; myeloproliferative disease; chronic blood loss; aplastic anemia; endocrine disease; drug reaction; chronic immune-mediated, toxic, viral, rickettsial, or parasitic anemia; hemodilution.",
              "pdf_page": 162,
              "printed_page": 80,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Regenerative anemia excludes diagnosis of anemia of CKD.",
              "pdf_page": 162,
              "printed_page": 80,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Normocytic, normochromic, hypoproliferative anemia.",
              "pdf_page": 162,
              "printed_page": 80,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reticulocytes—low corrected indices and absolute counts (≤10,000/μL).",
              "pdf_page": 162,
              "printed_page": 80,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Typically, IRIS stage 3 or greater CKD.",
              "pdf_page": 162,
              "printed_page": 80,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dosage—0.8–1.0μg/kg SC once weekly",
              "pdf_page": 162,
              "printed_page": 80,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "High blood urea nitrogen (BUN) : creatinine ratio may predict until PCV reaches low end of target, then concurrent GI bleeding. decrease to q2-4 weeks as needed to maintain target; check PCV first to avoid overtreatment.",
              "pdf_page": 162,
              "printed_page": 80,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
