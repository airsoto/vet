          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "All inherited, congenital, and acquired forms of CKD.",
              "pdf_page": 162,
              "printed_page": 80,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exacerbated by iron deficiency, inflammatory or neoplastic disease, GI bleeding, hemolysis, and myeloproliferative disorders.",
              "pdf_page": 162,
              "printed_page": 80,
              "column": 1
            }
          ]
        }
      }
