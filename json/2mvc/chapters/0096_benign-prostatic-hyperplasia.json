          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Age-related pathologic change in prostate gland, making it nonpainfully large.",
              "pdf_page": 250,
              "printed_page": 168,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Occurs in two phases, glandular and complex.",
              "pdf_page": 250,
              "printed_page": 168,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Glandular phase characterized by high number of large prostatic cells and symmetri cally large prostate gland.",
              "pdf_page": 250,
              "printed_page": 168,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Complex phase characterized by glandular hyperplasia and atrophy, small cyst formation, chronic inflammation, and squamous metaplasia of epithelium.",
              "pdf_page": 250,
              "printed_page": 168,
              "column": 1
            }
          ]
        },
