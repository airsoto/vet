      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute bacterial prostatitis—fever, depression, pain on rectal palpation, neutrophilia, pyuria, and bacteriuria; occurs concurrently with and secondary to benign prostatic hyperplasia (BPH).",
              "pdf_page": 250,
              "printed_page": 168,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic bacterial prostatitis—recurrent lower urinary tract infections and subfertility; occurs concurrently with and secondary to BPH.",
              "pdf_page": 250,
              "printed_page": 168,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prostatic adenocarcinoma—poor appetite, weight loss, hind limb weakness, dysuria, hematuria, and dyschezia; may see carcinoma cells in urine sediment.",
              "pdf_page": 250,
              "printed_page": 168,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prostatic and paraprostatic cysts—can cause palpable abdominal cystic mass filled with yellow to orange fluid.",
              "pdf_page": 250,
              "printed_page": 168,
              "column": 1
            }
          ]
        },
