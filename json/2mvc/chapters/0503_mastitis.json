          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Bacterial infection of one or more lactating mammary glands.",
              "pdf_page": 958,
              "printed_page": 876,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Result of ascending infection, trauma to the gland, or hematogenous spread.",
              "pdf_page": 958,
              "printed_page": 876,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Escherichia coli, staphylococci, andβ-hemolytic streptococci most commonly involved; Mycobacteriumand blastomycosis reported.",
              "pdf_page": 958,
              "printed_page": 876,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Potentially life-threatening infection; may lead to sepsis if systemic involvement.",
              "pdf_page": 958,
              "printed_page": 876,
              "column": 1
            }
          ]
