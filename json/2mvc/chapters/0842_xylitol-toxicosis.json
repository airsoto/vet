          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Ingestion of xylitol or xylitol-containing products.",
              "pdf_page": 1518,
              "printed_page": 1436,
              "column": 1
            }
          ]
        }
