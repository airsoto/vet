        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—no breed, age, or sex predilection.",
              "pdf_page": 1518,
              "printed_page": 1436,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—toxicity not expected.",
              "pdf_page": 1518,
              "printed_page": 1436,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Vomiting may develop within 15–30 minutes of exposure.",
              "pdf_page": 1518,
              "printed_page": 1436,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypoglycemia may develop in as little as 2 hours after ingestion, with signs including progressive lethargy, weakness, ataxia, collapse, and seizures.",
              "pdf_page": 1518,
              "printed_page": 1436,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hepatic failure with signs of icterus as well as possible hemorrhage including petechiae, ecchymosis, and gastrointestinal and abdominal bleeding may be seen within 24–48 hours after ingestion.",
              "pdf_page": 1518,
              "printed_page": 1436,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypoglycemia may not occur prior to onset of hepatic failure.",
              "pdf_page": 1518,
              "printed_page": 1436,
              "column": 1
            }
          ]
        },
        "CAUSES": {
