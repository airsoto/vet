  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Xylitol—a 5-carbon sugar alcohol used most commonly as a sweetener; present in many sugar-free gums, candies, toothpastes, mouthwashes, chewable over-the-counter medications and supplements, nasal sprays, liquid medications, specialty foods, and baked goods. It is also available as a granulated powder for cooking and baking.",
              "pdf_page": 1518,
              "printed_page": 1436,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ingestion by dogs can cause vomiting, weakness, ataxia, seizures, hypokalemia, and hypoglycemia due to excess insulin release.",
              "pdf_page": 1518,
              "printed_page": 1436,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mild to moderate elevations of alanine aminotransferase (ALT) can be seen within 4 hours of ingestion.",
              "pdf_page": 1518,
              "printed_page": 1436,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dosages >0.1 g/kg may cause hypoglycemia.",
              "pdf_page": 1518,
              "printed_page": 1436,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hepatic failure may occur at dosages >0.5 g/kg, with secondary coagulopathy possible due to hepatic necrosis.",
              "pdf_page": 1518,
              "printed_page": 1436,
              "column": 1
            }
          ]
        },
