        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Persian and related breeds (e.g., exotic shorthair, Himalayan, British shorthair) more commonly affected.",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog breeds affected include Cairn terriers and beagles.",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cysts are clinically silent until their increasing size and number contribute to azotemia or abdominal enlargement.",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May detect bosselated (lumpy) kidneys by abdominal palpation.",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most renal cysts are not painful when palpated, but acute secondary infection may cause rapid distension of the renal capsule and pain.",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 1
            }
          ]
        },
