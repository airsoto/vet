    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Monitor every 2–6 months for progressive disease (e.g., CKD, renal infection, and pain).",
          "pdf_page": 1187,
          "printed_page": 1105,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "In the absence of sepsis, the short-term prognosis is favorable.",
          "pdf_page": 1187,
          "printed_page": 1105,
          "column": 3
        }
      ],
