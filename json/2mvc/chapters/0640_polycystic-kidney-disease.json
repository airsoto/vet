        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Genetic tests are available to identify the autosomal dominant polycystic kidney disease (AD-PKD) type 1 mutation in cats. This test is useful to screen kittens less than 3–4 months old when ultrasonography may be less sensitive, as well as in breeding cats.",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Other mutations may also cause inherited kidney cysts.",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cyst fluid can be clear, cloudy, or hemorrhagic, and the fluid from two cysts in the same kidney can differ.",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bacterial culture of cyst fluid aids in diagnosing infection.",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Radiography",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Survey radiography and IV contrast urography",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 2,
              "subheading": "Radiography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "are insensitive methods of confirming cystic",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 2,
              "subheading": "Radiography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "disease.",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 2,
              "subheading": "Radiography"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Ultrasonography",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reveals anechoic cavitating lesions",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 2,
              "subheading": "Ultrasonography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "characterized by sharply marginated smooth",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 2,
              "subheading": "Ultrasonography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "walls and distal enhancement.",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 2,
              "subheading": "Ultrasonography"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Can usually detect cysts >2 mm in diameter.",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 2,
              "subheading": "Ultrasonography"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cysts have been detected in cats as young as",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 2,
              "subheading": "Ultrasonography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "7 weeks; screening cats younger than 6",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 2,
              "subheading": "Ultrasonography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "months is associated with higher false-",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 2,
              "subheading": "Ultrasonography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "negative results.",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 2,
              "subheading": "Ultrasonography"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypoechoic cystic cavities may be seen in",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 2,
              "subheading": "Ultrasonography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "some cysts infected with bacteria.",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 2,
              "subheading": "Ultrasonography"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Detection of cysts in other organs which",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 2,
              "subheading": "Ultrasonography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "helps to differentiate AD-PKD from other",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 2,
              "subheading": "Ultrasonography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "inherited or acquired multicystic disorders of",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 2,
              "subheading": "Ultrasonography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "the kidneys.",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 2,
              "subheading": "Ultrasonography"
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
