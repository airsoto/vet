            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Renal cystadenocarcinoma associated with nodular fibrosis in German shepherd dogs.",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Renal cysts associated with chronic kidney disease (CKD) or renal dysplasia.",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Renal neoplasia.",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hydronephrosis.",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Perirenal pseudocysts.",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mycotic or bacterial nephritis.",
              "pdf_page": 1187,
              "printed_page": 1105,
              "column": 1
            }
          ]
        },
