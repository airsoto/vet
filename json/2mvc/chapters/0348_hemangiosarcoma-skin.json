              "column": 1,
              "subheading": "Subcutaneous/Intramuscular"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "inguinal region, and cervical region are most",
              "pdf_page": 678,
              "printed_page": 596,
              "column": 1,
