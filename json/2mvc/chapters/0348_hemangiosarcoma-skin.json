      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUGS",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Cytology",
              "pdf_page": 678,
              "printed_page": 596,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Often unrewarding due to insufficient cell",
              "pdf_page": 678,
              "printed_page": 596,
              "column": 2,
              "subheading": "Cytology"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Doxorubicin—dogs: 30 mg/m2IV>15 kg;",
              "pdf_page": 678,
              "printed_page": 596,
              "column": 2,
              "subheading": "Cytology"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "numbers and blood contamination.",
              "pdf_page": 678,
              "printed_page": 596,
              "column": 2,
              "subheading": "Cytology"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "1 mg/kg IV<15 kg, q2–3 weeks for 5 cycles;",
              "pdf_page": 678,
              "printed_page": 596,
              "column": 2,
              "subheading": "Cytology"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neoplastic cells are spindle to stellate with",
              "pdf_page": 678,
              "printed_page": 596,
              "column": 2,
              "subheading": "Cytology"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "cats: 1 mg/kg IV q3 weeks for 5 cycles.",
              "pdf_page": 678,
              "printed_page": 596,
              "column": 2,
              "subheading": "Cytology"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "anisocytosis and anisokaryosis, single round,",
              "pdf_page": 678,
              "printed_page": 596,
              "column": 2,
              "subheading": "Cytology"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metronomic cyclophosphamide",
              "pdf_page": 678,
              "printed_page": 596,
              "column": 2,
              "subheading": "Cytology"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "oval, pleomorphic nuclei with prominent",
              "pdf_page": 678,
              "printed_page": 596,
              "column": 2,
              "subheading": "Cytology"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(12.5–15 mg/m2PO q24h) in combination",
              "pdf_page": 678,
              "printed_page": 596,
              "column": 2,
              "subheading": "Cytology"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "nucleoli, low nuclear cytoplasmic ratio, and",
              "pdf_page": 678,
              "printed_page": 596,
              "column": 2,
              "subheading": "Cytology"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "with a nonsteroidal anti-inflammatory drug",
              "pdf_page": 678,
              "printed_page": 596,
              "column": 2,
              "subheading": "Cytology"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "moderate to abundant basophilic and usually",
              "pdf_page": 678,
              "printed_page": 596,
              "column": 2,
              "subheading": "Cytology"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(NSAID; e.g., piroxicam 0.3 mg/kg PO",
              "pdf_page": 678,
              "printed_page": 596,
              "column": 2,
              "subheading": "Cytology"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "vacuolated cytoplasm.",
              "pdf_page": 678,
              "printed_page": 596,
