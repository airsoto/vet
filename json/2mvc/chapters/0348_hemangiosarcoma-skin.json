              "printed_page": 597,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "undergoing surgery alone.",
              "pdf_page": 679,
              "printed_page": 597,
              "column": 1,
              "subheading": "alone; disease-free interval>450 days for cats"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Higher risk of locoregional recurrence and",
              "pdf_page": 679,
              "printed_page": 597,
              "column": 1,
              "subheading": "alone; disease-free interval>450 days for cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "distant metastasis with stage II (SC) and III",
              "pdf_page": 679,
              "printed_page": 597,
              "column": 1,
              "subheading": "alone; disease-free interval>450 days for cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(IM) HSA.",
              "pdf_page": 679,
              "printed_page": 597,
              "column": 1,
              "subheading": "alone; disease-free interval>450 days for cats"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Subcutaneous HSA—prognosis can be",
              "pdf_page": 679,
              "printed_page": 597,
              "column": 2,
              "subheading": "alone; disease-free interval>450 days for cats"
            },
