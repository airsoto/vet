        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dermal HSA is associated with UV radiation via induction of actinic keratosis, especially along the ventral abdomen/inguinal region in sparsely haired and lightly pigmented dogs that sunbathe.",
              "pdf_page": 678,
              "printed_page": 596,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Subcutaneous HSA may be secondary to prior ionizing radiation therapy.",
              "pdf_page": 678,
              "printed_page": 596,
              "column": 1
            }
          ]
        }
      }
