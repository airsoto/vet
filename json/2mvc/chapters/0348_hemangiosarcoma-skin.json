        "DEFINITION": {
          "present": true,
          "status": "content",
          "source_heading": "DEFINITION",
          "canonical_heading": "DEFINITION",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "A highly metastatic malignant tumor of endothelial cell precursors.",
              "pdf_page": 678,
              "printed_page": 596,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary tumor develops within dermal or subcutaneous/intramuscular tissues.",
              "pdf_page": 678,
              "printed_page": 596,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Accounts for ~14% of all hemangiosarcomas (HSAs) in dogs.",
              "pdf_page": 678,
              "printed_page": 596,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metastatic risk dependent upon grade and location within the tissues (stage).",
              "pdf_page": 678,
              "printed_page": 596,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Subcutaneous/intramuscular lesions may represent metastasis from a primary visceral tumor.",
              "pdf_page": 678,
              "printed_page": 596,
              "column": 1
            }
          ]
        },
