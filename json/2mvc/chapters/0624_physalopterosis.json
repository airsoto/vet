  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Physalopteraspp. are parasitic nematodes that occur in dogs and cats; adults attach to stomach mucosa; no larval migration occurs outside the gastrointestinal tract.",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infection can be asymptomatic or cause gastritis and vomiting.",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Typically, few worms are present; singleworm or all-female infections are common.",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Transmitted by ingestion of infective larvae in intermediate hosts (e.g., coprophagous grubs, beetles, cockroaches, crickets) or in paratenic hosts (e.g., birds, rodents, frogs, snakes, lizards).",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
        "PATHOPHYSIOLOGY": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": []
        },
        "SYSTEMS AFFECTED": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": []
        },
        "GENETICS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GENETICS",
          "content_blocks": []
        },
        "INCIDENCE/PREVALENCE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "INCIDENCE/PREVALENCE",
          "content_blocks": []
        },
        "GEOGRAPHIC DISTRIBUTION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GEOGRAPHIC DISTRIBUTION",
          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Dogs and cats; any breed, age, or sex. Infected animals often undergo extensive workups for suspected inflammatory bowel disease/ulcers, only for the nematodes to be discovered via endoscopy.",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Vomiting, often chronic and intermittent; occasionally find worms in vomitus.",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Weight loss can occur, especially with chronic infection.",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Signs can occur without egg production during prepatent period, single-worm, or female-only infections.",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Possible melena, especially in cats.",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Outdoor exposure—access to insect intermediate hosts or small vertebrate transport hosts.",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Access to habitat occupied by wildlife species (raccoon, fox, coyote, bobcat, cougar, badger, skunk) infected withPhysaloptera.",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other infectious causes of vomiting including parasite, viral, or bacterial infections.",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Spirocerca, the esophageal worm—produces similar but smaller eggs (11–15 × 30–37μm).",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ollulanus, a trichostrongylid nematode, can cause chronic vomiting; seen mainly in colony and feral cats; larvae and adults (<1 mm long) but no eggs present in vomitus or feces.",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Roundworms (ascarids) in puppies and kittens—worms can be present in feces and",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "vomitus; larger thanPhysaloptera; character",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "ized by three lips and cervical alae.",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 1,
              "subheading": "vomitus; larger thanPhysaloptera; character"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other noninfectious causes of vomiting",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 1,
              "subheading": "vomitus; larger thanPhysaloptera; character"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "including dietary indiscretion, foreign objects",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 1,
              "subheading": "vomitus; larger thanPhysaloptera; character"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "in the stomach, noxious substances",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 1,
              "subheading": "vomitus; larger thanPhysaloptera; character"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "accidentally ingested, gastrointestinal",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 2,
              "subheading": "vomitus; larger thanPhysaloptera; character"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "neoplasia, metabolic diseases.",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 2,
              "subheading": "vomitus; larger thanPhysaloptera; character"
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Mild anemia and eosinophilia can occur.",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 2
            }
          ]
        },
