    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Pyrantel pamoate (dogs/cats) 20 mg/kg PO every 2 weeks for at least 3 treatments; repeat if signs persist; treatment of choice.",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fenbendazole (dogs) 50 mg/kg PO q24h for 3–5 days; repeat if signs persist.",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ivermectin (cats) 0.2 mg/kg PO, SC, once.",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Medication to reduce gastritis—histamine H2-antagonists (e.g., famotidine 0.5 mg/kg PO q12h); sucralfate 0.25–1 g PO q8–12h.",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 2
            }
          ]
        },
