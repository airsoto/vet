    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Recheck 1–2 weeks post treatment and re-treat with anthelmintic if eggs still present on fecal exam and/or if vomiting persists.",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 2
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Prompt removal and disposal of feces to prevent infection of arthropod intermediate hosts.",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prevent exposure to arthropod intermediate",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No products approved specifically for Physalopteraspp. prevention or control; monthly intestinal parasite control likely effective to limit infections.",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 3
            }
          ]
        },
