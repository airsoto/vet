          "printed_page": 1079,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Anthelmintic use is extra-label and anecdotal.",
          "pdf_page": 1161,
          "printed_page": 1079,
          "column": 2
        }
      ],
