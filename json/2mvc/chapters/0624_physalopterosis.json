        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Abdominal radiography and ultrasonography, to eliminate other causes of vomiting.",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Endoscopy (gastroscopy) to visualize and remove worms, usually attached to stomach or duodenal mucosa; careful, thorough exam necessary to detect all worms; typically few are present and they can be hidden by mucus, ingesta, stomach rugae; pinpoint hemorrhages from prior attachment sites can be seen:",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Physalopteraspp. are small (2.5–5 cm",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "long), stout, white or pink, with an anterior cuticular collar; male and female",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "P. praeputialishave a posterior prepuce-like",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "cuticular sheath.",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 2,
              "subheading": "P. praeputialishave a posterior prepuce-like"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Direct smear, wet mount, or fecal flotation",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 2,
              "subheading": "P. praeputialishave a posterior prepuce-like"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "to detect eggs in vomitus or feces; prepatent",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 2,
              "subheading": "P. praeputialishave a posterior prepuce-like"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "period is 2–5 months; eggs are dense and can",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 2,
              "subheading": "P. praeputialishave a posterior prepuce-like"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "be difficult to detect by fecal flotation using",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 2,
              "subheading": "P. praeputialishave a posterior prepuce-like"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "low specific gravity solutions; use flotation",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 2,
              "subheading": "P. praeputialishave a posterior prepuce-like"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "solution with specific gravity >1.25:",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 2,
              "subheading": "P. praeputialishave a posterior prepuce-like"
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Eggs are small (42–58 × 29–42μm),",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 2,
              "subheading": "P. praeputialishave a posterior prepuce-like"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "thick-shelled, larvated, ovoid to ellipsoidal,",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 2,
              "subheading": "P. praeputialishave a posterior prepuce-like"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "often clear and colorless.",
              "pdf_page": 1161,
              "printed_page": 1079,
              "column": 2,
              "subheading": "P. praeputialishave a posterior prepuce-like"
            }
          ]
        },
