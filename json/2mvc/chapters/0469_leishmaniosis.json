        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—purebred dogs (except Ibizan hounds) more susceptible; no sex or age predilection.",
              "pdf_page": 906,
              "printed_page": 824,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—no breed, sex, or age predilection.",
              "pdf_page": 906,
              "printed_page": 824,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Similar in dogs and cats.",
              "pdf_page": 906,
              "printed_page": 824,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lymphadenomegaly.",
              "pdf_page": 906,
              "printed_page": 824,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nonpruritic, exfoliative, erosive–ulcerative, nodular, papular, or pustular dermal and",
              "pdf_page": 906,
              "printed_page": 824,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "mucocutaneous lesions.",
              "pdf_page": 906,
              "printed_page": 824,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Blepharitis, conjunctivitis, keratoconjunctivitis, uveitis.",
              "pdf_page": 906,
              "printed_page": 824,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Polyuria, polydipsia.",
              "pdf_page": 906,
              "printed_page": 824,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyporexia, weight loss, vomiting, diarrhea, melena.",
              "pdf_page": 906,
              "printed_page": 824,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Splenomegaly, hepatomegaly.",
              "pdf_page": 906,
              "printed_page": 824,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lameness.",
              "pdf_page": 906,
              "printed_page": 824,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Epistaxis.",
              "pdf_page": 906,
              "printed_page": 824,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fever (rare).",
              "pdf_page": 906,
              "printed_page": 824,
              "column": 1
            }
          ]
        },
