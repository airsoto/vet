          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Establishment of a hereditary pattern typically an academic exercise, but potentially useful.",
              "pdf_page": 1135,
              "printed_page": 1053,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No additional diagnostic procedures are indicated to diagnose PHA.",
              "pdf_page": 1135,
              "printed_page": 1053,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Additional diagnostics are warranted if an underlying disease is suspected to cause a severe left shift.",
