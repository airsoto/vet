        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—Pelger–Huët anomaly (PHA) has been reported in mixed-breed dogs as well as numerous pure-breed animals. Overall the incidence is low; however, Australian shepherd dogs have been shown to have a 9.8% incidence rate.",
              "pdf_page": 1135,
              "printed_page": 1053,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—PHA has only been reported in domestic shorthair cats. The overall incidence in cats is unknown; however, it is likely rare when compared to dogs.",
              "pdf_page": 1135,
              "printed_page": 1053,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "An autosomal dominant mode of inheritance is likely; however, incomplete penetrance has been seen in Australian shepherd dogs.",
              "pdf_page": 1135,
              "printed_page": 1053,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "No clinical signs are associated with heterozygous animals, as the leukocytes are fully functional.",
              "pdf_page": 1135,
              "printed_page": 1053,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "In humans, caused by an inherited defect of the lamin B receptor.",
              "pdf_page": 1135,
              "printed_page": 1053,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Australian shepherd dogs are over represented in reported canine cases.",
              "pdf_page": 1135,
              "printed_page": 1053,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "subheading",
          "level": 0,
          "text": "DIFFERENTIAL DIAGNOSES",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "The primary differential diagnosis to rule",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 1,
          "subheading": "DIFFERENTIAL DIAGNOSES"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "out is a severe left shift, indicating severe",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 1,
          "subheading": "DIFFERENTIAL DIAGNOSES"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "inflammation or infection.",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 1,
          "subheading": "DIFFERENTIAL DIAGNOSES"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "An inflammatory leukogram may show a",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 1,
          "subheading": "DIFFERENTIAL DIAGNOSES"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "leukocytosis or leukopenia. Immature",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 1,
          "subheading": "DIFFERENTIAL DIAGNOSES"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "leukocytes exhibit an open, pale chromatin",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 1,
          "subheading": "DIFFERENTIAL DIAGNOSES"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "pattern.",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 1,
          "subheading": "DIFFERENTIAL DIAGNOSES"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Toxic changes (Döhle bodies, blue foamy",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 2,
          "subheading": "DIFFERENTIAL DIAGNOSES"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "cytoplasm, toxic granulation, etc.) are",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 2,
          "subheading": "DIFFERENTIAL DIAGNOSES"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "frequently seen with severe inflammation, but",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 2,
          "subheading": "DIFFERENTIAL DIAGNOSES"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "not PHA.",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 2,
          "subheading": "DIFFERENTIAL DIAGNOSES"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Pelger–Huët cells have a nucleus that shows",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 2,
          "subheading": "DIFFERENTIAL DIAGNOSES"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "a mature, condensed chromatin pattern and",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 2,
          "subheading": "DIFFERENTIAL DIAGNOSES"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "exhibit no toxic changes.",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 2,
          "subheading": "DIFFERENTIAL DIAGNOSES"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Animals with PHA are clinically healthy,",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 2,
          "subheading": "DIFFERENTIAL DIAGNOSES"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "whereas animals with severe left shifts tend to",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 2,
          "subheading": "DIFFERENTIAL DIAGNOSES"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "be systemically ill.",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 2,
          "subheading": "DIFFERENTIAL DIAGNOSES"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Pseudo- or acquired PHA is an acquired",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 2,
          "subheading": "DIFFERENTIAL DIAGNOSES"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "condition that results in granulocyte",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 2,
          "subheading": "DIFFERENTIAL DIAGNOSES"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "hyposegmentation, secondary to",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 2,
          "subheading": "DIFFERENTIAL DIAGNOSES"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "myelodysplastic conditions or drug therapy.",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 2,
          "subheading": "DIFFERENTIAL DIAGNOSES"
        },
        {
          "type": "subheading",
          "level": 0,
          "text": "CBC/SERUM BIOCHEMISTRY/",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 2
        },
        {
          "type": "subheading",
          "level": 0,
          "text": "URINALYSIS",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "The blood smear reveals a persistent varying",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 2,
          "subheading": "URINALYSIS"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "hyposegmentation of all granulocytes and",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 2,
          "subheading": "URINALYSIS"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "often monocytes.",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 2,
          "subheading": "URINALYSIS"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Granulocyte nuclei have mature, condensed",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 2,
          "subheading": "URINALYSIS"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "chromatin and may be round, oval, peanut,",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 2,
          "subheading": "URINALYSIS"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "dumbbell, horseshoe, and bilobed in shape.",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 2,
          "subheading": "URINALYSIS"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "The serum biochemistry profile and",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 2,
          "subheading": "URINALYSIS"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "urinalysis are unremarkable.",
          "pdf_page": 1135,
          "printed_page": 1053,
          "column": 2,
          "subheading": "URINALYSIS"
        }
      ],
