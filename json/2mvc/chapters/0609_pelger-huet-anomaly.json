  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Congenital hereditary disorder that has been seen in several breeds of dogs and domestic shorthair cats.",
              "pdf_page": 1135,
              "printed_page": 1053,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Results in nuclear hyposegmentation of many to all granulocytes (neutrophils, eosinophils, and basophils).",
              "pdf_page": 1135,
              "printed_page": 1053,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypolobulation of monocytes and megakaryocytes has also been reported.",
              "pdf_page": 1135,
              "printed_page": 1053,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chromatin patterns of leukocytes are normochromatic, or occasionally hyper chromatic, rather than the open, immature chromatin of immature leukocytes.",
              "pdf_page": 1135,
              "printed_page": 1053,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytoplasm of cells is unremarkable (i.e., no toxic changes are observed).",
              "pdf_page": 1135,
              "printed_page": 1053,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cell function is unaffected in heterozygotes;",
              "pdf_page": 1135,
              "printed_page": 1053,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "homozygotes are usually stillborn or diein",
              "pdf_page": 1135,
              "printed_page": 1053,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "utero.",
              "pdf_page": 1135,
              "printed_page": 1053,
              "column": 1,
              "subheading": "homozygotes are usually stillborn or diein"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Care should be taken not to misinterpret as",
              "pdf_page": 1135,
              "printed_page": 1053,
              "column": 1,
              "subheading": "homozygotes are usually stillborn or diein"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "a severe left shift.",
              "pdf_page": 1135,
              "printed_page": 1053,
              "column": 1,
              "subheading": "homozygotes are usually stillborn or diein"
            }
          ]
        },
