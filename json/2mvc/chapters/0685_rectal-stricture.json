        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog and cat.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Any age, breed, or gender.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Vary with severity.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tenesmus.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dyschezia.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Constipation.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hematochezia.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mucoid feces.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Large bowel diarrhea.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary megacolon can develop.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Inflammatory—rectoanal abscess, anal sacculitis, perianal fistulae, proctitis, histoplasmosis, pythiosis.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Traumatic— foreign body, laceration.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neoplastic—rectal adenocarcinoma, leiomyoma, or polyps.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Iatrogenic—rectal anastomosis, mass excision, or biopsy.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Congenital—atresia ani.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Space-occupying processes that lead to diminished rectal capacity (extraluminal compression [e.g., prostatic disease, pelvic fractures], intraluminal obstruction [e.g., pseudocoprostasis, foreign body]) and functional constriction (muscle spasms).",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Differentiate by rectal palpation and imaging.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually unremarkable.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May have an inflammatory leukogram.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "not_applicable",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "N/A",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 1
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Survey abdominal radiography and contrast studies (e.g., barium, air, or double-contrast enema and barium gastrointestinal series) may reveal consistent narrowing of the rectal lumen.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal ultrasonography may reveal thickening and altered architecture if",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "infiltrative rectocolonic disease is present (e.g., pythiosis, neoplasia).",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Digital rectal palpation.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Proctoscopy/colonoscopy to visualize stricture, determine extent, and procure biopsy specimens.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Colonic scrapings may aid in cytologic diagnosis of fungal (histoplasmosis) and neoplastic diseases.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Biopsy to classify the disease process and establish a prognosis.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": []
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Treat the underlying cause when possible.",
          "pdf_page": 1263,
          "printed_page": 1181,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Medical treatment for palliation (stool softeners/enemas) or the elimination of infective agents or inflammatory conditions.",
          "pdf_page": 1263,
          "printed_page": 1181,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Fluid therapy to optimize hydration prior to administering an enema to constipated or obstipated patients.",
          "pdf_page": 1263,
          "printed_page": 1181,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Anesthesia may be necessary for enema administration.",
          "pdf_page": 1263,
          "printed_page": 1181,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Balloon dilation of non-neoplastic and postoperative strictures—multiple procedures may be needed.",
          "pdf_page": 1263,
          "printed_page": 1181,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgical reconstruction of focal strictures (plasty procedures).",
          "pdf_page": 1263,
          "printed_page": 1181,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Resection and anastomosis may be necessary for extensive lesions and recurrent strictures.",
          "pdf_page": 1263,
          "printed_page": 1181,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Colorectal stent placement may relieve obstruction due to nonresectable neoplasms and non-neoplastic lesions.",
          "pdf_page": 1263,
          "printed_page": 1181,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Radiotherapy and/or chemotherapy for some neoplasms.",
          "pdf_page": 1263,
          "printed_page": 1181,
          "column": 2
        }
      ],
