          "source_heading": null,
          "canonical_heading": "POSSIBLE INTERACTIONS",
          "content_blocks": []
        },
        "CONTRAINDICATIONS/POSSIBLE INTERACTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Corticosteroids when infection is possible.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Corticosteroids may slow healing after surgical correction.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 3
            }
          ]
        },
        "ALTERNATIVE DRUG(S)": {
