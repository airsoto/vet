  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Diminution in the size of the rectal or anal lumen either from cicatricial contracture or scarring as a result of wound healing or chronic inflammation or from proliferative neoplastic disease.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gastrointestinal function is compromised because of outflow obstruction.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
