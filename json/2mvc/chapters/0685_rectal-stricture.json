    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Stool softeners—docusate sodium; lactulose.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Corticosteroids—prednisone to treat inflammatory conditions (0.5–1 mg/kg PO q24h or divided q12h) and after balloon dilation to prevent stricture recurrence. Intralesional injection of triamcinolone prior to dilatation may prevent recurrence.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chemotherapy or antifungal therapy if indicated.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Broad-spectrum perioperative antimicrobial therapy (e.g., cefoxitin sodium 30 mg/kg IV) with balloon dilation or surgical therapy.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Antibiotics continued after dilation if mucosal tearing occurs.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 2
            }
          ]
        },
        "CONTRAINDICATIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CONTRAINDICATIONS",
          "content_blocks": []
        },
