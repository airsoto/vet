    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical signs.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Recurrence or metastasis of neoplastic lesions.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Following balloon dilation patients should be reevaluated for stricture reformation 7–14 days after the procedure to determine the need for additional dilation procedures.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 3
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": []
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Medical treatment—can include inefficacy, diarrhea, and adverse effects of medications.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Balloon dilation can result in deep rectal tears, hemorrhage, or possibly full-thickness perforation. Stricture recurrence is common following balloon dilation. Multiple dilations may be needed.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Surgical treatment—fecal incontinence, secondary stricture formation, and wound dehiscence.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 3
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Varies with the severity of the stricture.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Patients with benign strictures that are readily managed medically or with balloon dilation or bougienage may have a good long-term outcome.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Surgical resection has more guarded prognosis because of the frequency of complications.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most patients with recognizable clinical signs due to neoplasia have a guarded-to-poor prognosis for complete resolution.",
              "pdf_page": 1263,
              "printed_page": 1181,
              "column": 3
            }
          ]
        }
      }
    },
    "MISCELLANEOUS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "ASSOCIATED CONDITIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "ASSOCIATED CONDITIONS",
