    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Physical examination and thoracic radiography at regular intervals following",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "therapy (every 3–4 months) is recommended for the first year postoperatively.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Serial CT or MRI to monitor for local tumor regrowth may be recommended.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 3
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": []
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Permanent or transient Horner’s syndrome secondary to surgery.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Permanent or transient facial paralysis following surgery (more frequent in cats).",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 3
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Median survival after lateral ear resection is around 10 months for both dogs and cats.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Median survival after TECABO is >3 years in both dogs and cats.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Median survival after radiation therapy is >3 years, but published information is on small numbers only.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Poor prognosis associated with extensive tumor involvement (advanced stage), preoperative neurologic signs, and conservative therapy (e.g., lateral ear canal ablation alone).",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 3
            }
          ]
        }
      }
    },
