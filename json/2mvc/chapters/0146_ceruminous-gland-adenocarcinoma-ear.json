  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Most common primary malignant tumor of the external ear canal, arising from modified apocrine sweat glands (ceruminous glands).",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Often locally invasive, but associated with a low metastatic rate.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
