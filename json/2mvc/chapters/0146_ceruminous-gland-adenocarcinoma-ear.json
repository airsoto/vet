          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": []
        },
        "SYSTEMS AFFECTED": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": []
        },
        "GENETICS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GENETICS",
          "content_blocks": []
        },
        "INCIDENCE/PREVALENCE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "INCIDENCE/PREVALENCE",
          "content_blocks": []
        },
        "GEOGRAPHIC DISTRIBUTION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GEOGRAPHIC DISTRIBUTION",
          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Uncommon overall, but the most common malignant tumor of the ear canal in both dogs and cats, followed by carcinoma of undetermined origin and squamous cell carcinoma.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cocker spaniels and German shepherd dogs are overrepresented.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mean age—dogs, 10 years; cats, 11 years.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No known sex predisposition.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Progressive hearing loss.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Similar to chronic, recurrent otitis externa— discharge, odor, pruritus, inflammation.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Early appearance—pale pink, friable, ulcerative, bleeding nodular mass(es) within the external ear canal.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Late appearance—large mass(es) filling the canal and invading through canal wall into surrounding structures.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Regional lymph node enlargement.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neurologic signs (vestibular signs, Horner’s syndrome) may be present secondary to middle ear involvement.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Signs of pain and discomfort; pain upon opening the mouth.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Chronic inflammation and ceruminous gland hyperplasia/dysplasia appear to play a role in tumor development.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Proliferative chronic otitis externa with ceruminous gland hyperplasia.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inflammatory polyps.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other tumors including squamous cell carcinoma, basal cell tumor, mast cell tumor, papilloma, sebaceous gland tumor, ceruminous gland adenoma.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Usually normal.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ear swab cytology for bacteria and yeast.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bacterial culture and sensitivity as needed.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 1
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Skull radiography to assess potential involvement of the tympanic bulla, but this is",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "difficult to interpret due to superimposition of bones in the skull.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiography to evaluate for pulmonary metastasis.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CT or MRI is most useful for loco-regional staging and before surgery and radiation therapy, providing greater detail than with radiographs.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytologic examination of aspirate from regional lymph nodes.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytologic examination of fine-needle aspirate from mass.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Biopsy and histopathology.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytology from fine-needle aspirate—round to polygonal epithelial cells arranged both singly and in large clusters with deep blue to lavender-gray cytoplasm and a variable quantity of black, intracytoplasmic granular material; unable to differentiate adenocarcinoma from adenoma consistently with cytology.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Histopathologic characteristics—apocrine type differentiation from ceruminous glands and local invasion into stroma; neoplastic cells show moderate to marked nuclear atypia with frequent mitotic figures.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Total ear canal ablation and lateral bulla osteotomy (TECABO) is the preferred surgical approach over lateral ear resection.",
          "pdf_page": 333,
          "printed_page": 251,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Radiation therapy may be considered for either large (palliative intent) or incompletely excised masses (curative intent).",
          "pdf_page": 333,
          "printed_page": 251,
          "column": 2
        }
      ],
