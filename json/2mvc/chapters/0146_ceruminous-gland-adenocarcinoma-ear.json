              "type": "bullet",
              "level": 0,
              "text": "Multimodal therapy incorporating corticosteroids or nonsteroidal anti-inflammatory drugs (NSAIDs) and other analgesics.",
              "pdf_page": 333,
              "printed_page": 251,
              "column": 2
            }
          ]
        },
