        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Scottish, Cairn, and West Highland white",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "terrier breeds—most common.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Labrador retrievers, Great Danes, Boston terriers, Doberman pinschers, Irish setters, English bulldogs, bullmastiffs, Shetland sheepdogs, and",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "boxers—may be affected.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually growing",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "puppies 4–8 months of age.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No gender",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "predilection.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neutering may increase incidence.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually relate to pain around the mouth",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and difficulty opening the mouth progres-",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "sively worsening.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Difficulty in prehension",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and mastication—may lead to starvation.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Temporal and masseter muscle atrophy—",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "common.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Palpable irregular thickening of",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "mandibular rami and/or temporomandibular",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "joint (TMJ) region.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inability to fully open jaw,",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "even under general anesthesia.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intermittent",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "pyrexia.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bilateral exophthalmos.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
        "CAUSES": {
          "present": false,
