      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "A non-neoplastic, noninflammatory proliferative disease of the bones of the head.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary bones affected—mandibular rami; occipital and parietal; tympanic bullae; zygomatic",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "portion of the temporal.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bilateral symmetric",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "involvement most common.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affects musculoskeletal system.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            }
          ]
        },
