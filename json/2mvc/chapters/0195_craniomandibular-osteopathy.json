        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Believed to be hereditary—occurs in certain",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "breeds and families.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "West Highland white",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "terriers—autosomal recessive trait.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Scottish",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "terriers—possible predisposition.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Young terrier with periosteal long bone disease— monitor for disease.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Osteomyelitis—bones not symmetrically affected; generally not as extensive; lysis; lack of breed predilection; history of penetrating",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "wound.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Traumatic periostitis—bones not symmetrically affected; generally not as",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "extensive; history of trauma.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neoplasia— mature patient; not symmetrically affected;",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "more lytic bone reaction; metastatic disease. Calvarial hyperostosis—young patient: frontal, parietal, and occipital bones; does not involve mandible; may have long bone involvement.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Serum alkaline phosphatase (ALP) and",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "inorganic phosphate—may be high.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May note hypogammaglobulinemia or α2-hyperglobulinemia.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Serology—rule out fungal agents; indicated in atypical cases.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Skull radiography—reveals uneven, bead-like osseous proliferation of the mandible or tympanic bullae (bilateral); extensive, periosteal new bone formation (exostoses) affecting one or more bones around the TMJ; may show fusion of the tympanic bullae and angular",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "process of the mandible.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CT—may help evaluate osseous involvement of TMJ.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Bone biopsy and culture (bacterial and fungal)—necessary only in atypical cases; rule out neoplasia and osteomyelitis.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Bone biopsy—reveals normal lamellar bone being replaced by enlarged coarse-fiber bone and osteoclastic osteolysis of periosteal or subperiosteal",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "region.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bone marrow—replaced by vascular",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "fibrous-type stroma.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inflammatory cells— occasionally seen at periphery of bony lesion.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Palliative only.",
          "pdf_page": 423,
          "printed_page": 341,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgical excision of exostoses—results in regrowth within weeks.",
          "pdf_page": 423,
          "printed_page": 341,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "High-calorie, protein-rich gruel diet—helps",
          "pdf_page": 423,
          "printed_page": 341,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "maintain nutritional balance.",
          "pdf_page": 423,
          "printed_page": 341,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgical placement of pharyngostomy, esophagostomy, or gastrostomy tube—considered to help maintain nutritional balance.",
          "pdf_page": 423,
          "printed_page": 341,
          "column": 2
        }
      ],
