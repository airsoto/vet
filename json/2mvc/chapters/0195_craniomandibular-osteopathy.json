    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Analgesics and anti-inflammatory drugs—palliative use warranted.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nonsteroidal anti-inflammatory drugs (NSAIDs)—inhibit cyclooxygenase",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "enzymes.",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Deracoxib (1–2 mg/kg PO",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "q24h, chewable).",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Carprofen (2.2 mg/kg",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "PO q12h or 4.4 mg/kg q24h).",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Meloxicam (load 0.2 mg/kg PO, then 0.1 mg/kg PO",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "q24h, liquid).",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Grapiprant (2 mg/kg PO",
              "pdf_page": 423,
              "printed_page": 341,
              "column": 2
