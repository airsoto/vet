      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "A systemic autoimmune disease characterized by keratoconjunctivitis sicca, xerostomia, and lymphoplasmacytic adenitis.",
              "pdf_page": 1342,
              "printed_page": 1260,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Underlying mechanism unknown; however, autoantibodies directed against glandular tissues have been identified.",
              "pdf_page": 1342,
              "printed_page": 1260,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Associated with other autoimmune or immune-mediated diseases, such as rheumatoid arthritis and pemphigus.",
              "pdf_page": 1342,
              "printed_page": 1260,
              "column": 1
            }
          ]
        },
