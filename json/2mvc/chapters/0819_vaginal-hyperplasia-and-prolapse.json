  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Protrusion of spherical or donut-shaped mass from vulva during proestrus or estrus, rarely during gestation, parturition, or after administration of estrogenic drugs:",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Type I—slight eversion of vaginal floor",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "cranial to the urethral orifice but no protrusion through vulva.",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Type II—vaginal tissue prolapses through",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "vulvar opening (tongue-shaped mass).",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Type III—donut-shaped eversion of the",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "entire circumference of vaginal wall, including the urethral orifice, seen ventrally on the prolapsed tissue.",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exaggerated response of vaginal mucosa to estrogen; some affected animals have follicular cysts.",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Despite the name, the change seen histopathologically is edema rather than hyperplasia or hypertrophy if occurring during proestrus or estrus.",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Severe prolapse—may occlude urethra and prevent normal urination.",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "True vaginal prolapse without hyperplasia or edema occurs rarely pre- or postpartum and may include uterine body and horns.",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1
            }
          ]
        },
