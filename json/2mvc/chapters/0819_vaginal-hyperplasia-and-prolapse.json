        "SURGICAL CONSIDERATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "SURGICAL CONSIDERATIONS",
          "canonical_heading": "SURGICAL CONSIDERATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ovariohysterectomy—prevents recurrence; may hasten resolution.",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Severe condition—requires surgical reduction or resection; identify and catheterize urethra, 25% recurrence at next cycle after",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 2
            }
          ]
        },
        "MEDICAL": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "MEDICAL",
          "content_blocks": []
        },
        "SURGERY": {
          "present": true,
          "status": "content",
          "source_heading": "SURGERY",
          "canonical_heading": "SURGERY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "With dystocia, cesarean section required, ovariohysterectomy may be necessary.",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "When occurring during pregnancy, both resection of prolapse and surgical reduction with accompanying hysteropexy have been successfully reported. Vaginal delivery with concurrent vaginal prolapse has been reported; close monitoring for obstructive dystocia is recommended.",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 2
            }
          ]
        },
