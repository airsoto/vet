        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Young (most 18–22 months, range 6 months–4.6 years), large-breed bitches.",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Predisposed breeds—large and brachycephalic breeds (boxer, mastiff, English bulldog, Saint Bernard); Labrador and Chesapeake Bay retrievers; German shepherd dog; English springer spaniel; Walker hound; Airedale terrier; American pit bull terrier.",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hereditary component probable—increased incidence in some family lines.",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Onset of proestrus or estrus.",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Although rare, can be seen during diestrus or",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "at parturition (8–12% of cases occur at",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "parturition); or after administration of estrogenic",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "drugs or exposure to exogenous estrogens.",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Licking of vulvar area.",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Failure to allow copulation.",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dysuria.",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Previous occurrence.",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Protrusion of round, tongue-shaped, or",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "donut-shaped tissue mass from the vulva.",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vaginal examination—locate lumen and",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "urethral orifice; types I and II: vaginal lumen",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "is dorsal to the prolapse; type III: lumen is",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "central to the prolapse; urethral orifice is",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "ventral to the prolapse with all three types.",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
