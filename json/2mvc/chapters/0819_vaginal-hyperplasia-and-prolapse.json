    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Gonadotropin-releasing hormone (GnRH) 2.2μg/kg IM or human chorionic gonadotropin (hCG) 1,000 IU IM—if breeding not planned that cycle; may hasten ovulation and resolution by a couple of days; not effective if given after ovulation (progesterone >8–10 ng/mL).",
              "pdf_page": 1475,
              "printed_page": 1393,
              "column": 3
            }
          ]
        },
