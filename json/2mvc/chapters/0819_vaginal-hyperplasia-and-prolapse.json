    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Outpatient; unless urethral obstruction.",
          "pdf_page": 1475,
          "printed_page": 1393,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Breeding—possible by artificial insemination (discuss potential heritability).",
          "pdf_page": 1475,
          "printed_page": 1393,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Prolapsed tissue—keep clean and lubricated with sterile water-soluble lubricant.",
          "pdf_page": 1475,
          "printed_page": 1393,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Use of sugar or a 50% dextrose solution on edematous tissue may help to shrink prolapse.",
          "pdf_page": 1475,
          "printed_page": 1393,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Elizabethan collar and clean indoor environment—minimize tissue trauma.",
          "pdf_page": 1475,
          "printed_page": 1393,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Instruct client to monitor patient’s ability to urinate.",
          "pdf_page": 1475,
          "printed_page": 1393,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "If urethral obstruction present, place indwelling urinary catheter.",
          "pdf_page": 1475,
          "printed_page": 1393,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Regression—usually begins in late estrus; should be resolved during early diestrus.",
          "pdf_page": 1475,
          "printed_page": 1393,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Recurrence rate—66–100% at next estrous cycle.",
          "pdf_page": 1475,
          "printed_page": 1393,
          "column": 2
        }
      ],
