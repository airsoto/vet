          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Chloride is the most abundant anion in extracellular fluid.",
              "pdf_page": 758,
              "printed_page": 676,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperchloremia is associated with free water loss or excessive NaCl intake (oral or parenteral).",
              "pdf_page": 758,
              "printed_page": 676,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Serum chloride concentration varies inversely to bicarbonate concentration; high bicarbonate loss (i.e., vomiting or renal wasting) is followed by renal chloride resorption and hyperchloremia.",
              "pdf_page": 758,
              "printed_page": 676,
              "column": 1
            }
          ]
        },
