    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Initially, monitor PCV and morphologic features of RBCs on a blood smear every 24 hours to evaluate effectiveness of treatment and bone marrow responsiveness; polychromasia may be seen as regenerative response starts.",
              "pdf_page": 173,
              "printed_page": 91,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "As regeneration becomes apparent, recheck every 3–5 days.",
              "pdf_page": 173,
              "printed_page": 91,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "During and following transfusion, monitor for transfusion reactions (see Blood Transfusion Reactions).",
              "pdf_page": 173,
              "printed_page": 91,
              "column": 3
            }
          ]
        },
