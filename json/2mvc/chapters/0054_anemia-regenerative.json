        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Reticulocytosis may be absent in the first 3–5 days after onset of blood loss or hemolysis.",
              "pdf_page": 173,
              "printed_page": 91,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Direct antiglobulin test (Coombs’ test) is indicated when IMHA is suspected, in the absence of agglutination; a positive test is confirmatory.",
              "pdf_page": 173,
              "printed_page": 91,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The rapid osmotic fragility test detects erythrocyte membrane defects and can help to discriminate hemolytic from nonhemolytic conditions.",
              "pdf_page": 173,
              "printed_page": 91,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Coagulation testing may be indicated in cases of blood loss.",
              "pdf_page": 173,
              "printed_page": 91,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "PCR is more sensitive for diagnosis of",
              "pdf_page": 173,
              "printed_page": 91,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Babesiaand hemotropicMycoplasmathan",
              "pdf_page": 173,
              "printed_page": 91,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "microscopic blood smear exam; can",
              "pdf_page": 173,
              "printed_page": 91,
              "column": 1,
              "subheading": "Babesiaand hemotropicMycoplasmathan"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "differentiate between species.",
              "pdf_page": 173,
              "printed_page": 91,
              "column": 1,
              "subheading": "Babesiaand hemotropicMycoplasmathan"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "PCR for PK deficiency.",
              "pdf_page": 173,
              "printed_page": 91,
              "column": 1,
              "subheading": "Babesiaand hemotropicMycoplasmathan"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "PCR for PFK deficiency.",
              "pdf_page": 173,
              "printed_page": 91,
              "column": 1,
              "subheading": "Babesiaand hemotropicMycoplasmathan"
            }
          ]
        },
