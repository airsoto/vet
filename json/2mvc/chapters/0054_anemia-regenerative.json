        "DEFINITION": {
          "present": true,
          "status": "content",
          "source_heading": "DEFINITION",
          "canonical_heading": "DEFINITION",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Decreased circulating red blood cell (RBC) mass (indicated by low packed cell volume [PCV] or hematocrit [HCT], hemoglobin, and total RBC count) accompanied by appropriate, compensatory increase in RBC production by the bone marrow.",
              "pdf_page": 172,
              "printed_page": 90,
              "column": 1
            }
          ]
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Caused by blood loss or hemolysis.",
              "pdf_page": 172,
              "printed_page": 90,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hemolysis—caused by intrinsic RBC defects (e.g., congenital RBC membrane defects or enzyme deficiencies) or extrinsic factors (e.g., RBC parasites, oxidative injury, hemolysins, osmotic changes, immunemediated RBC destruction, hemophagocytic neoplasia, heat stroke, and severe hypophosphatemia).",
              "pdf_page": 172,
              "printed_page": 90,
              "column": 1
            }
          ]
        },
        "SYSTEMS AFFECTED": {
          "present": true,
          "status": "content",
          "source_heading": "SYSTEMS AFFECTED",
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cardiovascular—murmurs with marked anemia; tachycardia.",
              "pdf_page": 172,
              "printed_page": 90,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hemic/lymph/immune—erythroid hyperplasia in bone marrow; splenic extramedullary hematopoiesis (EMH).",
              "pdf_page": 172,
              "printed_page": 90,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hepatic—decreased oxygen delivery causes centrilobular degeneration of liver.",
              "pdf_page": 172,
              "printed_page": 90,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Renal—severe intravascular hemolysis rarely leads to pigmentary nephropathy and acute renal failure.",
              "pdf_page": 172,
              "printed_page": 90,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Musculoskeletal—progressive osteoclerosis seen in pyruvate kinase (PK)-deficient dogs.",
              "pdf_page": 172,
              "printed_page": 90,
              "column": 1
            }
          ]
        },
