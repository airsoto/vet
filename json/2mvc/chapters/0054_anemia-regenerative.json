        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "PK deficiency—basenji, beagle, cairn terrier, Chihuahua, dachshund, Labrador retriever, labradoodle, miniature poodle, pug, West Highland white terrier, and American Eskimo; Somali, Abyssinian, domestic shorthair cats.",
              "pdf_page": 172,
              "printed_page": 90,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "PFK deficiency—Australian labradoodle, English springer spaniel, American cocker spaniel, cockapoo, English cocker spaniel, whippet, wachtelhund, and mixed breed dogs with spaniel parentage.",
              "pdf_page": 172,
              "printed_page": 90,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Marked RBC osmotic fragility—English springer spaniel; Abyssinian, Somali, Siamese, and domestic shorthair cats.",
              "pdf_page": 172,
              "printed_page": 90,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Feline congenital porphyria—Siamese and domestic shorthair cats.",
              "pdf_page": 172,
              "printed_page": 90,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Heritable coagulopathies (e.g., factor VIII or IX deficiency), von Willebrand disease.",
              "pdf_page": 172,
              "printed_page": 90,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Immune-mediated hemolytic anemia (IMHA)—middle-aged female dogs, especially American cocker spaniels, English springer spaniels, Irish setters, Old English sheepdogs, poodles, and Shetland sheepdogs.",
              "pdf_page": 172,
              "printed_page": 90,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hemophagocytic histiocytic sarcoma— Bernese mountain dog, Rottweiler, golden retriever, and flat-coated retriever.",
              "pdf_page": 172,
              "printed_page": 90,
              "column": 1
            }
          ]
        },
