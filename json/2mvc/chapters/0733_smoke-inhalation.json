  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Injury secondary to direct heat damage to upper airway and nasal mucosa. Inhalation of toxins directly irritates the airway, and particulate matter adheres to the airways",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "and alveoli.",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Carbon monoxide decreases tissue oxygen delivery by preferentially",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "binding to hemoglobin.",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cyanide interferes with oxygen usage in oxidative",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "phosphorylation.",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Extent of damage depends on the degree and duration of exposure and the material that was burning.",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Serious lung injury possible with little",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "external evidence of burning.",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lung reaction—initially bronchoconstriction, airway edema, mucus production and airway occlusion; then an inflammatory response, necrotizing tracheobronchitis, and pulmonary fluid accumulation due to",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "increased capillary permeability. dysfunction typically progresses during",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "initial 2–3 days.",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary bacterial infections—common cause of morbidity late in the disease.",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            }
          ]
        },
