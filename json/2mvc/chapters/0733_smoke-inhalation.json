        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Historical findings consistent with",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "exposure.",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Smoky odor.",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tachypnea and",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "increased respiratory effort.",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inspiratory effort suggests upper airway obstruction by",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "edema.",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Postural adaptations to hypoxemia.",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mucous membranes can be cherry red (from carboxyhemoglobin), pale, or cyanotic.",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Auscultation of wheezes, harsh broncho",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "vesicular sounds, or crackles.",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cough.",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Burns, shriveled whiskers, conjunctival",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "edema, corneal ulcers.",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neurologic signs indicate carbon monoxide or cyanide toxicity.",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cardiac arrhythmias and hypotension can be seen secondary to hypoxemia, smoke and carbon monoxide inhalation, and burn injuries.",
              "pdf_page": 1346,
              "printed_page": 1264,
              "column": 1
            }
          ]
        },
