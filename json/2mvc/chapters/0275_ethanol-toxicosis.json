    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dextrose—0.5–1.5 ml/kg 50% dextrose diluted 1 : 4 in 0.9% NaCl as a bolus for immediate correction of severe hypoglycemia; 2.5–5% dextrose supplementation in fluids for hypoglycemia.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fomepizole (4-methylpyrazole)—not specifically cleared for use in ethanol intoxication",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sodium bicarbonate (if needed)—mEq of bicarbonate required = 0.5 × bodyweight in kg × (desired total CO2mEq/L − measured CO2mEq/L); give half the total calculated dose slowly over 3–4 hours IV; recheck blood gases and clinical status of the animal.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 3
            }
          ]
        },
