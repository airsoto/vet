        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Most common in dogs.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No breed or sex predilections.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Young, curious animals more susceptible.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "CNS—develop within 15–30 minutes after ingestion on an empty stomach or 1–2 hours on a full stomach; ataxia, reduced reflexes, behavioral changes, excitement, depression.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cardiovascular—cardiac arrest.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gastrointestinal—flatulence (bread dough).",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory—respiratory depression, narcosis.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urologic—polyuria, incontinence.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypothermia.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory depression—provide artificial ventilation.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "IV isotonic crystalloid fluids—correct dehydration.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acidosis—sodium bicarbonate if pH <7.0, BE <15 mmHg, HCO3<11 mmHg.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cardiac arrest—cardiac therapy (see Cardiopulmonary Arrest).",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hemodialysis—may aid in elimination of ethanol after life-threatening exposure.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Yohimbine may be effective for CNS depression.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 2
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
