  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ethanol (CH3CH2OH)—short-chain alcohol; highly miscible with water; less volatile than comparable hydrocarbons (e.g., ethane); solvent for medications; component of alcoholic beverages; metabolized to acetaldehyde.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Used intravenously to treat ethylene glycol poisoning.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Denatured forms may contain other toxic fractions (e.g., acetone, benzene, camphor, castor oil, phthalates, kerosene, sulfuric acid, terpinols); may complicate effects.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ethanol concentration—expressed as proof (twice the % concentration).",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute oral lowest toxic dosage—5–8 mL/kg as pure alcohol; consider % alcohol in specific product consumed.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other alcohols—toxicity of methanol is similar to that of ethanol; the LD50of 70% isopropanol is 2 mL/kg.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cell membrane damage; impaired sodium and potassium nerve conduction.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May inhibit glutamate receptors in brain with reduction of cyclic guanosine monophosphate (GMP).",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 1
            }
          ]
        },
