    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Activated charcoal—not effective.",
          "pdf_page": 555,
          "printed_page": 473,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Emesis or gastric lavage—only in very recent exposures (less than 15 minutes) due to rapid absorption and rapid onset of clinical",
          "pdf_page": 555,
          "printed_page": 473,
          "column": 2
        }
      ],
