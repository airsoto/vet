          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Alcoholic beverages, either accidental or intentional, are most common source.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exposure to deicers, sanitizers, mouthwash, dyes, inks, some fuels, paint, varnishes, perfume, pharmaceuticals.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exposure to rising bread doughs containing active yeast.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fermented products—rotten apples, garbage.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dermal exposure—alcohol-containing products.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other alcohols—methanol, isopropanol, butanol.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Human drugs of abuse—marijuana, barbiturates, benzodiazepines.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Early stages of ethylene glycol (antifreeze) toxicosis.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Early stages of xylitol toxicosis.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Halogenated or aliphatic hydrocarbon solvents.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypoglycemia inducing metabolic and neurologic disorders.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pesticides—amitraz, macrolide antiparasiticides.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "PCV and total solids.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Monitor for hypoglycemia; blood glucose <60 mg/dL considered serious.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metabolic acidosis likely from ethanol-induced lactic acidemia.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 2
            }
          ]
        },
