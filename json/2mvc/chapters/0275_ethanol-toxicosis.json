        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Blood ethanol levels routinely available at reference labs—clinical signs in puppies at >0.6 mg/mL and in adults at>1–4 mg/mL.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Blood methanol and isopropanol levels available at some reference labs.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Blood gases and increased anion gap— evaluate potential acidosis.",
              "pdf_page": 555,
              "printed_page": 473,
              "column": 2
            }
          ]
        },
