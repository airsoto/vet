        "OTHER LABORATORY TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": []
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "CT or MRI—visualize lesion; rarely needed for diagnosis.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical—history of trauma with sudden",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "onset of typical neurologic deficits.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Define involved spinal nerve roots—map motor and sensory deficits; note signs of Horner’s syndrome; determine if cutaneous trunci",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "reflex is present.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Electromyography (EMG) and nerve conduction studies (NCS) may help further define deficits and detect signs of recovery—from 5–7 days post injury, EMG shows denervation in affected muscles.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ventral and dorsal root avulsions— intradurally at level of root–spinal cord junction (most fragile area because it lacks",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "protective perineurium).",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neuroma formation may develop over time on pial surface of spinal cord.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "GENERAL": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GENERAL",
          "content_blocks": []
        },
        "APPROPRIATE HEALTH CARE": {
          "present": true,
          "status": "content",
          "source_heading": "APPROPRIATE HEALTH CARE",
          "canonical_heading": "APPROPRIATE HEALTH CARE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "No specific treatment.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Outcome depends",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "on initial damage.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Amputation of limb— may be necessary for patients showing complications (infections/self-mutilation, likely as a result of paresthesia) and no",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "improvement.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Carpal fusion (arthrodesis) and transposition of biceps muscle tendon— consider only with adequate function of triceps and musculocutaneous muscles.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            }
          ]
        },
        "NURSING CARE": {
          "present": true,
          "status": "content",
          "source_heading": "NURSING CARE",
          "canonical_heading": "NURSING CARE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Protective wrap or boot to protect distal paw if patient walks a lot/walks on rough surfaces—increased skin fragility and lack of protective reflexes due to sensory deficits can result in severe excoriations when animal",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "walks on affected limb.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Early and sustained physical therapy—crucial to prevent severe muscle atrophy and tendon contraction to keep joints and muscles mobile during recovery of reversible injuries; passive range of",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "motion, massage therapy.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Monitor noncomplicated cases for 4–6 months before considering amputation.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 3
            }
          ]
        },
