        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs and cats.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No age, sex, or breed predilection.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Depend on the extent and distribution of",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "rootlet damage.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Motor signs—paresis/weakness (partial damage) to paralysis",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "(complete ventral root avulsion).",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sensory signs—decreased to absent pain perception",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "(dorsal root damage).",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Muscle atrophy—",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "begins within a week of injury.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Complete avulsion—spinal nerves C5 to T2; most common; combines cranial and caudal avulsion",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "deficits.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cranial avulsion—C5 to C7 nerves: supraspinatus and infraspinatus muscle atrophy, loss of shoulder and elbow movement flexion (dropped elbow), analgesia of craniodorsal scapula and medial forearm, possible diaphragm hemiplegia detected by fluoroscopy (phrenic nerve roots C5 to C7); if roots C8 to T2 are preserved, weight bearing remains almost",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "normal.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Caudal avulsion—spinal nerves C7 to T2: inability to bear weight with knuckling over dorsum of paw; if C5 to C7 are spared, the limb is held in a flexed position and there is analgesia distal to the elbow (except for a small area on the medial aspect of the forearm); T1 to T2 involvement causes an ipsilateral partial Horner’s syndrome (anisocoria only) and lack of ipsilateral cutaneous trunci reflex (reflex",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "present contralaterally).",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bilateral avulsion— rarely encountered, caused by a significant fall with sternal landing and splaying of limbs.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Over time, complications of self-trauma may occur as a result of paresthesia in the most severe cases.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
