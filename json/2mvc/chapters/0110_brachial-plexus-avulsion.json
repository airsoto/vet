        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Trauma—road accident; hung by foot; dragged; fall.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Brachial plexus trauma without avulsion— rare; temporary deficit owing to root",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "contusion (neurapraxia).",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Brachial plexus tumor—usually chronic, progressive onset.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Brachial plexus neuritis or neuropathy— rare, bilateral deficits, unknown etiology;",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "acute onset; no trauma.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fibrocartilaginous embolic myelopathy—deficits of ipsilateral hind limb and mild deficits of contralateral forelimb and hind limb are usually present.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Migrating foreign body – slow onset and no",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "history of trauma.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pure radial nerve paralysis caused by fracture of humerus or",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "first rib—no nerve root sign.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lateralized intervertebral disc protrusion.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
