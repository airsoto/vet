        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Skin excoriation and secondary infection—",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "from trauma to unprotected paw.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Trophic ulcers—thin, traumatized skin, especially over",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "arthrodesis sites.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Paresthesia may lead to self-mutilation.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 3
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Preserved pain sensation (dorsal roots intact)—suggests less severe injury to ventral",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "nerve roots.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cranial avulsion—better prognosis with preserved sensation to distal",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "limb and ability to bear weight.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Complete avulsion—poor prognosis for recovery,",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "amputation likely.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rarely, mild cases may resolve after 2–3 months.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 3
            }
          ]
        }
      }
