  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Trauma with traction and/or severe abduction of a forelimb causes avulsion of nerve rootlets from their spinal cord attach-",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "ment.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ventral (motor) nerve roots are more",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "susceptible than dorsal (sensory) roots.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "It is important to rule out nerve root avulsions in traumatized animals that are not able to bear weight on a forelimb, especially before surgical repair of orthopedic injuries.",
              "pdf_page": 271,
              "printed_page": 189,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
