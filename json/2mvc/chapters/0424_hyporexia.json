    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Numerous medications are anecdotally reported to improve food intake in companion animals, but most are not licensed for this purpose and there are limited efficacy and safety data.",
          "pdf_page": 825,
          "printed_page": 743,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Practitioners are encouraged to use FDA-approved appetite stimulants before considering alternative approaches.",
          "pdf_page": 825,
          "printed_page": 743,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "The administration of an appetite stimulant should not delay efforts to identify and address the underlying cause(s) of hyporexia.",
          "pdf_page": 825,
          "printed_page": 743,
          "column": 2
        }
      ],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Capromorelin—dogs: 3 mg/kg PO q24h; a ghrelin receptor agonist, FDA-approved as an appetite stimulant for dogs (feline product under development).",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Mimics actions of ghrelin, the “hunger",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hormone,” a peptide secreted by gastric mucosa.",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Receptors located in hypothalamus;",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "activation promotes feelings of hunger and food-seeking behavior.",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Ghrelin also triggers release of growth",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hormone, increasing muscle mass and lean weight gain.",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mirtazapine—dogs: 3.75–30 mg/dog PO q24h; cats: 1.9 mg/cat PO q48h; used off-label for many years as an appetite stimulant; mechanism is likely related to increased central norepinephrine levels. Transdermal formulation approved for cats (2 mg/cat q24h).",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 2
            }
          ]
        },
        "CONTRAINDICATIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CONTRAINDICATIONS",
          "content_blocks": []
