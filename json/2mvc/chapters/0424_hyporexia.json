        "GEOGRAPHIC DISTRIBUTION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GEOGRAPHIC DISTRIBUTION",
          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Dogs and cats of all ages; no breed or sex predilections.",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Patients may refuse all food (anorexia) or consume a portion of their caloric needs.",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Preferential appetite may be reported for treats or highly desirable foods, but not a balanced diet.",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Signs suggesting nausea (e.g., drooling or gagging) may be reported, and severely affected animals may avoid food or try to hide it.",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sustained hyporexia results in weight loss, and may be accompanied by a decrease in lean muscle mass as well as fat.",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Any metabolic derangement (endocrine, renal, hepatic) or organic compromise (e.g., respiratory or cardiovascular or gastro intestinal disease).",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Systemic inflammation (infectious, sterile, neoplastic).",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Medications, pain/discomfort, or psychologic issues (fear, anxiety).",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lesions in the hypothalamus or affecting smell.",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Must be differentiated from ‘pseudoinappetence’, i.e., limited intake due to oral pathology, prehension disorders or palatability issues.",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Influenced by underlying cause(s), but can be normal despite inadequate intake.",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sustained and severe hyporexia in cats may result in hepatic lipidosis, characterized by an increase in alkaline phosphatase activity and hyperbilirubinemia.",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
