    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Monitor food intake and bodyweight carefully, and modify therapy for both underlying disease and hyporexia as necessary.",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 3
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Prompt recognition and management of conditions that may impact food intake.",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 3
            }
          ]
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats with sustained, substantial hyporexia may develop hepatic lipidosis.",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyporexia impacts outcome and mortality in hospitalized people and it likely has a similar impact in companion animals.",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 3
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Response to appetite stimulants is variable; some animals require enteral feeding devices.",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Underlying cause(s) of hyporexia ultimately determines prognosis.",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 3
            }
          ]
        }
      }
    },
    "MISCELLANEOUS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "ASSOCIATED CONDITIONS": {
          "present": true,
          "status": "content",
          "source_heading": "ASSOCIATED CONDITIONS",
          "canonical_heading": "ASSOCIATED CONDITIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Sarcopenia (i.e., age-related loss of muscle) and cachexia (i.e., rapid/extreme weight loss and muscle wasting) are associated with or exacerbated by hyporexia.",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 3
            }
          ]
        },
        "AGE-RELATED FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "AGE-RELATED FACTORS",
          "canonical_heading": "AGE-RELATED FACTORS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "None (unless related to underlying cause).",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 3
            }
          ]
        },
