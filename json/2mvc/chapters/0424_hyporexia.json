          "content_blocks": []
        },
        "CONTRAINDICATIONS/POSSIBLE INTERACTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Mirtazapine has relatively narrow therapeutic window; should be dosed cautiously in small patients and those with renal compromise. Side effects can include vocalization, behavior changes, and tremors.",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Serotonin syndrome may occur with concurrent administration of monoamine oxidase inhibitors, metoclopramide, ondansetron, or tramadol.",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 2
            }
          ]
        },
        "ALTERNATIVE DRUG(S)": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "ALTERNATIVE DRUG(S)",
          "content_blocks": []
