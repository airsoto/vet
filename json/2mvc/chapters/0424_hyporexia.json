  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Spontaneous decrease in food intake, and implies inadequate caloric intake.",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Triggered by numerous conditions and reflects a derangement in hypothalamic processes that govern satiety and hunger.",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prolonged hyporexia results in weight loss and contributes to sarcopenia and cachexia.",
              "pdf_page": 825,
              "printed_page": 743,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
        "PATHOPHYSIOLOGY": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": []
        },
        "SYSTEMS AFFECTED": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": []
        },
        "GENETICS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GENETICS",
          "content_blocks": []
        },
        "INCIDENCE/PREVALENCE": {
          "present": false,
          "status": "missing",
