        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—Dalmatian, bull terrier, boxer, bulldog, basset hound, beagle, whippet, American Staffordshire terrier, Australian shepherd (nasal solar dermatitis).",
              "pdf_page": 466,
              "printed_page": 384,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—white cats.",
              "pdf_page": 466,
              "printed_page": 384,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—glabrous areas especially axillae, flanks, ventral abdomen, lateral extremities.",
              "pdf_page": 466,
              "printed_page": 384,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—pinnae, nasal planum, dorsal muzzle, eyelids.",
              "pdf_page": 466,
              "printed_page": 384,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Solar dermatitis—photodermatitis.",
              "pdf_page": 466,
              "printed_page": 384,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Nasal—erythema and scaling at junction",
              "pdf_page": 466,
              "printed_page": 384,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "of haired and hairless skin of nose; expands caudally followed by scarring.",
              "pdf_page": 466,
              "printed_page": 384,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Truncal—erythema, scaling, and lichenifi-",
              "pdf_page": 466,
              "printed_page": 384,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "cation; gradual palpable thickening of white areas (adjacent dark areas are normal), comedones; secondary deep pyoderma.",
              "pdf_page": 466,
              "printed_page": 384,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Actinic keratosis— premalignant epithelial dysplasia capable of becoming invasive squamous cell carcinomas (SCC); indurated, crusted, hyperkeratotic plaques.",
              "pdf_page": 466,
              "printed_page": 384,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hemangioma—well-circumscribed plaques or nodules, firm to fluctuant, bluish to purplish.",
              "pdf_page": 466,
              "printed_page": 384,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hemangiosarcoma—poorly circumscribed dermal dark red to purple, fluctuant nodules; may become large; commonly ulcerate and bleed; subcutaneous hemangiosarcomas usually not solar induced.",
              "pdf_page": 466,
              "printed_page": 384,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "SCC—proliferative and ulcerated plaques; easily traumatized; secondary pyoderma common; locally invasive and slow to metastasize.",
              "pdf_page": 466,
              "printed_page": 384,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Solar-induced thermal burn (dorsal thermal necrosis)—alopecia, erythema, ulceration, eschars/necrosis, and crusts on the dorsal parts of the body; dogs with dark shorthair coats at increased risk.",
              "pdf_page": 466,
              "printed_page": 384,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cutaneous horns—firm hornlike projections, may originate from actinic keratoses, SCC, or other neoplasia; the base of a horn must be inspected for underlying cause.",
              "pdf_page": 466,
              "printed_page": 384,
              "column": 1
            }
          ]
        },
