    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Many cases quickly become serious and referral to a 24-hour critical care center",
          "pdf_page": 245,
          "printed_page": 163,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "should be considered.",
          "pdf_page": 245,
          "printed_page": 163,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Treatment focused on decontamination and supportive care.",
          "pdf_page": 245,
          "printed_page": 163,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Induce emesis following recent (<1 hour) ingestion in asymptomatic patients only if have not already vomited; consider gastric",
          "pdf_page": 245,
          "printed_page": 163,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "lavage for very large ingestions.",
          "pdf_page": 245,
          "printed_page": 163,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "One dose of",
          "pdf_page": 245,
          "printed_page": 163,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "activated charcoal with sorbitol.",
          "pdf_page": 245,
          "printed_page": 163,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "IV fluid crystalloids at 1.5–2.5 × maintenance to support organ perfusion and enhance elimination.",
          "pdf_page": 245,
          "printed_page": 163,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Monitor for cardiac arrhythmias, hypo ventilation, and aspiration pneumonia.",
          "pdf_page": 245,
          "printed_page": 163,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Oxygen if respiratory depression; ventilator support if severe respiratory depression/failure.",
          "pdf_page": 245,
          "printed_page": 163,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Monitor body temperature and provide warming/cooling measures as needed.",
          "pdf_page": 245,
          "printed_page": 163,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Hemodialysis and hemoperfusion have successfully shortened elimination half-life and led to full recovery.",
          "pdf_page": 245,
          "printed_page": 163,
          "column": 2
        }
      ],
