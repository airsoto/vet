          "canonical_heading": "GEOGRAPHIC DISTRIBUTION",
          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Accidental exposure in dogs is more frequently reported than in cats, but any animal may be at risk for poisoning.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats are extremely sensitive to baclofen.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Signs begin within 15–90 minutes of ingestion but, rarely, may be delayed several",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "hours.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Common signs—vocalization, vomiting, ataxia, disorientation, hypersalivation, depression, weakness, coma, flaccid paralysis, recumbency, seizures, and hypothermia.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Life-threatening signs—dyspnea, respiratory depression, and arrest secondary to diaphragmatic/intercostal muscle paralysis.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Pet owners with medical conditions such as multiple sclerosis, cerebral palsy, and spinal disorders are more likely to have baclofen in the home.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Toxic—barbiturates, benzodiazepines, depressants, ethanol, ethylene glycol, cannabis/marijuana, illicit drugs (LSD, phencyclidine [PCP], hallucinogenic mushrooms), methanol, opioids, propylene glycol, tranquilizers, xylitol.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lower motor neuron disease (e.g., botulism,",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Neospora, tick paralysis,Toxoplasma).•Metabolic",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(e.g., hepatic encephalopathy, hypoglycemia, etc.).",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1,
              "subheading": "Neospora, tick paralysis,Toxoplasma).•Metabolic"
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "No specific abnormalities expected, but should be used to rule out other causes.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Arterial blood gas analysis (hypoxemia, oxygenation, and ventilation).",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pulse oximetry (hypoxemia).",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "End tidal CO2(hypercapnia or hypoventilation).",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Baclofen serum or urine concentrations to confirm exposure; not helpful for case management.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Thoracic radiographs (aspiration pneumonia secondary to severe sedation).",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": false,
