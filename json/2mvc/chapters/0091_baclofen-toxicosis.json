    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Serious cases require intense, consistent patient monitoring including vital signs, blood pressure, blood gas analysis, pulse oximetry, and",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "end tidal CO2.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nursing care should include turning/repositioning q6h, ocular lubrication, keeping patient dry/clean, passive range of motion of limbs, and soft bedding.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 3
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Educate pet owners about risks of leaving prescription drugs accessible to pets.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 3
            }
          ]
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Aspiration pneumonia due to combination of vomiting, sedation, seizures, and paralysis of diaphragm/intercostal muscles.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 3
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Patients suffering serious intoxications may",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "take 5–7 days to fully recover.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Recovery often occurs with no residual effects.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prognosis good with early and appropriate care, but becomes poor if medical care delayed; seizures and aspiration pneumonia associated with guarded prognosis.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 3
            }
          ]
        }
      }
    },
