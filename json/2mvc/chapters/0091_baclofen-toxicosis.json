  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Baclofen is centrally acting skeletal muscle relaxant used to prevent spasticity in people with multiple sclerosis, cerebral palsy, and spinal",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "disorders.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Binds to gamma-aminobutyric acid (GABAB) receptors and prevents release of inhibitory neurotransmitters and substances.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Has been used extra-label in dogs to reduce urethral resistance (1–2 mg/kg PO q8h), but is rarely recommended due to narrow margin of",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "safety; use in cats not recommended.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Oral doses as low as 0.7 mg/kg in dogs have caused",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "depression, dyspnea, and hypothermia.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Death has been documented in dogs at 2.3 mg/kg, but",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "more likely at 8–16 mg/kg.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "These organ systems are predominantly affected:",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Cardiovascular.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Gastrointestinal.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Musculoskeletal.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Nervous.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Respiratory.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 1
            }
          ]
        },
