        },
        "CONTRAINDICATIONS/POSSIBLE INTERACTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Use acepromazine cautiously due to risk of",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "hypotension.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Use all sedatives cautiously as",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "baclofen also causes sedation.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Avoid drugs that cause respiratory depression (e.g., phenobarbital).",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 3
            }
          ]
        },
        "ALTERNATIVE DRUG(S)": {
          "present": false,
          "status": "missing",
