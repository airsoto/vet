    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Atropine for bradycardia (0.02–0.04 mg/kg",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "IM/IV/SC PRN for dogs or cats).",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Antiemetics as needed (e.g., maropitant 1 mg/kg SC q24h).",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diazepam (0.25–1.0 mg/kg IV to effect) or midazolam (0.1–0.3 mg/kg IV/IM) for seizures;",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "use lowest effective dose.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "For seizures refractory to bolus diazepam or midazolam, use CRI of diazepam (0.1–0.5 mg/kg/h), midazolam (0.05–0.5 mg/kg/h), levetiracetam (dogs, 30–60 mg/kg IV; cats, 20 mg/kg IV), propofol (1–8 mg/kg IV to effect, followed by CRI dose of 0.1–0.6 mg/kg IV for dogs or cats), or",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "inhalant anesthesia.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Agitation may be treated with diazepam or midazolam; acepromazine (0.05–0.2 mg/kg IV/IM/SC PRN for cats or dogs) should be used with caution.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cyproheptadine for vocalization/disorientation (dogs, 1.1 mg/kg PO or rectally q4–6h; cats,",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "2–4 mg total dose q4–6h).",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "IV lipid emulsion (ILE) has successfully treated dogs suffering from baclofen intoxication; should be reserved for critical cases; doses vary; using 20% emulsion, give 1.5 mL/kg IV bolus followed by CRI of 0.25 mL/kg/min for 30–60 min; if initial bolus fails to produce desired effect,",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "consideradditionaldoses of 1.5 mL/kg IV",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "q4–6h for initial 24 hours; if after 3–5 boluses",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 3,
              "subheading": "consideradditionaldoses of 1.5 mL/kg IV"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "no clinical response is seen, discontinue use; do",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 3,
              "subheading": "consideradditionaldoses of 1.5 mL/kg IV"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "not exceed 8 mL/kg/day.",
              "pdf_page": 245,
              "printed_page": 163,
              "column": 3,
              "subheading": "consideradditionaldoses of 1.5 mL/kg IV"
            }
          ]
        },
