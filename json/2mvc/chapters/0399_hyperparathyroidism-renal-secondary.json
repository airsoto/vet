    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypercalcemic nephropathy—kidney disease caused by ionized hypercalcemia; can be difficult to differentiate from longstanding RSHPT, in which hyperplasia of the parathyroid glands disrupts the normal feedback arc between PTH release and ionized calcium (tertiary hyperparathyroidism).",
              "pdf_page": 778,
              "printed_page": 696,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ionized serum calcium concentration is usually low or normal with RSHPT, but high with hypercalcemic nephropathy.",
              "pdf_page": 778,
              "printed_page": 696,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Low serum PTH and PTH-related protein (PTHrP) high in animals with hypercalcemia of malignancy.",
              "pdf_page": 778,
              "printed_page": 696,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary hyperparathyroidism— characterized by hypercalcemia, normal or low serum phosphorus, and inappropriate PTH concentration; kidney function is initially normal but may become compromised later.",
              "pdf_page": 778,
              "printed_page": 696,
              "column": 1
            }
          ]
        },
