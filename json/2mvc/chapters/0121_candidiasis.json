          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Candida—dimorphic fungus with the yeast",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "phase (Candidaspp.) being part of the normal",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "flora of the mouth, nose, ears, and gastrointestinal",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1,
              "subheading": "phase (Candidaspp.) being part of the normal"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(GI) and urogenital tracts of dogs and cats.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1,
              "subheading": "phase (Candidaspp.) being part of the normal"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "C. albicansandC. parapsilosismost",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1,
              "subheading": "phase (Candidaspp.) being part of the normal"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "commonly cultured from clinically healthy",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1,
              "subheading": "phase (Candidaspp.) being part of the normal"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "dogs.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Recovery from mucosal surfaces does not",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "imply disease; organisms may cause oppor",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "tunistic infection, colonize damaged tissues, or",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "invade normal tissues of immunosuppressed",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "animals.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pathogenic role determined by infiltration",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "of organisms into tissues, or detection of",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "organisms in presumed sterile sites (e.g.,",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "urinary bladder, peritoneal cavity).",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Organ systems most affected include GI,",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "renal/urologic, skin, and respiratory.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Conditions that suppress the immune",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "system (e.g., feline immunodeficiency virus",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "[FIV] infection) increase the likelihood of",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "isolation in asymptomatic animals.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1,
              "subheading": "dogs."
            }
          ]
        },
