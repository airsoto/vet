    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Topical therapy (mucosal lesions)—nystatin or amphotericin B.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fluconazole—5 mg/kg PO q12h; very effective and excreted unchanged in urine (high concentration in commonly infected sites).",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Itraconazole—5–10 mg/kg PO q12h; effective, can use if organism resistant to fluconazole; not recommended for urinary tract infection (poor urinary excretion).",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In lower urinary tractCandidainfections resistant to fluconazole—infuse 10–30 mL of 1% clotrimazole into the bladder every other day for three treatments.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Candidamay develop drug resistance— consider drug sensitivity testing if suspected.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Caspofungin—may be option for resistant isolates.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 3
            }
          ]
        },
