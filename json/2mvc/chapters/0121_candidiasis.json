        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Infection—rare; associated with neutro penia, parvovirus or FIV infection, endocrinopathies, glucocorticoid therapy, gastrotomy tubes, indwelling urinary catheters/urethrostomy, IV catheters, and incomplete bladder emptying.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lower urinary tract disease may predispose to candiduria.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Administration of antibiotics in prior 30 days.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Occasionally local or systemic infection is seen in animals without predisposing conditions.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Skin damaged by burns, trauma, or necrotizing dermatitis.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Otitis (dogs)—culture ofCandidaspp. or identification of yeast or mycelial elements on ear cytology suggests diagnosis.",
          "pdf_page": 289,
          "printed_page": 207,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "In febrile patients, culture catheter tips.",
          "pdf_page": 289,
          "printed_page": 207,
          "column": 2
        }
      ],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Considered whenever the primary condition does not respond as expected.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Reflect underlying inflammation and organ involvement (unless neutropenic).",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urinalysis—may show yeast or clumps of mycelial elements (pseudohyphae) with inflammatory cells; concurrent bacterial urinary tract infection common.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytology—spherical to oval yeast cells 5–7μm in diameter; pseudohyphae and septate hyphae 3–5μm wide.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Culture—grows well on blood agar and often is isolated from specimens submitted for bacterial culture; more easily isolated from urine than blood.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "PCR and antigen tests available.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "IMAGING",
          "content_blocks": []
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Lesions—to determine ifCandidais truly a pathogen, requires demonstration of organisms penetrating the tissues.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urine sample—cystocentesis; culture of",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "multiple colonies ofCandidasupports",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "White caseous foci in the infected tissue.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Large numbers of both yeast and pseudohyphae in tissues surrounded by necrosis and suppurative inflammatory reaction.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May be pyogranulomatous in more chronic infections.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Treat underlying causes of immunosuppression.",
          "pdf_page": 289,
          "printed_page": 207,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Remove indwelling catheters, if possible.",
          "pdf_page": 289,
          "printed_page": 207,
          "column": 2
        }
      ],
