    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Fluconazole and itraconazole—hepatic toxicity; monitor serum alanine aminotransferase (ALT) activity monthly initially and check if patient becomes anorexic.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "After signs have resolved—reculture sites of infection; continue treatment for 2 weeks beyond negative culture; repeat cultures 2 weeks after completion of treatment and again if signs recur.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 3
            }
          ]
        },
