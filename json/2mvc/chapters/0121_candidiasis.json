        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Cats and dogs—any age and breed.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Nonhealing ulcers in the oral, upper respiratory, GI, or urogenital mucosa—signs reflect location/extent of disease:",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Cystitis—hematuria, stranguria, and",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "pollakiuria.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Otitis—head shaking, scratching.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Oral cavity—drooling.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inflammation around IV catheters or gastrotomy tubes.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ulcerative, red skin lesions.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Systemic disease with fever, cardiac and/or neurologic abnormalities can be seen.",
              "pdf_page": 289,
              "printed_page": 207,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
