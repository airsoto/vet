  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic limb extension associated with pelvic limb paralysis or paresis after acute and usually severe spinal cord lesion caudal to the cervical intumescence, best observed when the patient is in lateral recumbency.",
              "pdf_page": 1304,
              "printed_page": 1222,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Posture—caused by damage to the border cells or their ascending processes, which are interneurons located in the lumbar spinal cord (mainly L2–4) and normally inhibit the extensor motor neurons of the cervical intumescence.",
              "pdf_page": 1304,
              "printed_page": 1222,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
