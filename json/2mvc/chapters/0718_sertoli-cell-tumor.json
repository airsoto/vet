    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Recurrence of feminization may be associated with metastasis.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Serum hormone levels may be correlated with resolution of clinical signs.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 2
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": []
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Irreversible bone marrow ablation resulting in life-threatening hemorrhage and recurrent infection.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 2
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Good in most patients.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Guarded if cytopenias exist at diagnosis.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Poor prognosis if aplastic anemia present.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical signs of hyperestrogenism expected to resolve within 1–3 months following castration; however, bone marrow hypoplasia might be irreversible.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 2
            }
          ]
        }
      }
