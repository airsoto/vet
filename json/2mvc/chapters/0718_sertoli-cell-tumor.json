        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Median age, 10 years.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Boxer, German shepherd dog, Afghan hound, Weimaraner, Shetland sheepdog, collie, and Maltese may be at increased risk.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "8–33% of all testicular tumors in dogs, extremely rare in cats.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually none. Fertility issues in breeding",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "dogs.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "4–20% of dogs will have more than one",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "type of testicular tumor.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Up to 50% of dogs will have bilateral",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "tumors, only 12% of contralateral tumors will",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "be palpable.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "bullet",
              "level": 0,
              "text": ">50% of dogs will have hyperestrogenism.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Most common clinical signs include: bilateral",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "symmetric alopecia and hyperpigmentation,",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "pendulous prepuce, gynecomastia, galactor-",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "rhea, atrophy of the penis, squamous",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "metaplasia of the prostate.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical signs associated with severe",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "pancytopenia include weakness, hemorrhage,",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and febrile episodes.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1,
              "subheading": "dogs."
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal mass—if patient is cryptorchid.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1,
              "subheading": "dogs."
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cryptorchid testicles 12.7 per 1000 dog-years (vs. 0 for scrotally located testicles).",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cryptorchid and ≥6 years of age, 68.1 per 1000 dog-years.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Interstitial cell tumor.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Seminoma.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperadrenocorticism.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypothyroidism.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "More likely to have an abdominal location than other testicular tumors; high testicular temperature in the abdominal location may destroy spermatogenic cells and leave Sertoli cells unregulated.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Transient neutrophilia followed by progressive neutropenia, thrombocytopenia, and non-regenerative anemia.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Low testosterone-to-estradiol ratio.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Testicular and abdominal sonography to aid in differential diagnosis and identify retained testicles and comorbidities.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 1
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Histopathologic examination of testicular mass.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Immunohistochemistry may be necessary to identify cell of origin.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Serum anti-müllerian hormone may differentiate testicular tumors.",
              "pdf_page": 1319,
              "printed_page": 1237,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
