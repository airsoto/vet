          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 111,
              "printed_page": 29,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Signs may be due to physical presence of",
              "pdf_page": 111,
              "printed_page": 29,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "primary tumor (visible mass near anus,",
              "pdf_page": 111,
              "printed_page": 29,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "tenesmus, scooting behaviors) or lymph",
              "pdf_page": 111,
              "printed_page": 29,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "nodes enlarged due to metastasis (tenesmus,",
              "pdf_page": 111,
              "printed_page": 29,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "obstipation, stranguria), or systemic",
              "pdf_page": 111,
              "printed_page": 29,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "manifestations due to hypercalcemia",
              "pdf_page": 111,
              "printed_page": 29,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(polyuria/polydipsia, anorexia).",
              "pdf_page": 111,
              "printed_page": 29,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 111,
              "printed_page": 29,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mass associated with anal sac; may be quite",
              "pdf_page": 111,
              "printed_page": 29,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "small relative to significant metastatic disease",
              "pdf_page": 111,
              "printed_page": 29,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "burdens.",
              "pdf_page": 111,
              "printed_page": 29,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Caudal abdominal lymphadenopathy—on",
              "pdf_page": 111,
              "printed_page": 29,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "rectal or abdominal palpation.",
              "pdf_page": 111,
              "printed_page": 29,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
