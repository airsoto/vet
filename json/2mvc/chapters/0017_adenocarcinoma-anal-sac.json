    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgical resection is treatment of choice.",
          "pdf_page": 111,
          "printed_page": 29,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Resection of primary tumor and enlarged lymph nodes prolongs survival—both at initial diagnosis and upon relapse.",
          "pdf_page": 111,
          "printed_page": 29,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "If mass is large and locally invasive at diagnosis, surgery will be palliative, not curative.",
          "pdf_page": 111,
          "printed_page": 29,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Debulking all disease present may control hypercalcemia until tumor recurrence.",
          "pdf_page": 111,
          "printed_page": 29,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgery may not be possible if primary mass is very large.",
          "pdf_page": 111,
          "printed_page": 29,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Adjuvant radiation for microscopic disease may help delay local recurrence and evidence of lymph node metastases.",
          "pdf_page": 111,
          "printed_page": 29,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Hypofractionated radiation can provide benefit in cases of advanced or inoperable disease, with about one-third of dogs showing partial response to radiation, and about two-thirds of dogs having improvement or resolution of their clinical signs.",
          "pdf_page": 111,
          "printed_page": 29,
          "column": 3
        }
      ],
