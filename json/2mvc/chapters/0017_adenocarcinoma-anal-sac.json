        "DEFINITION": {
          "present": true,
          "status": "content",
          "source_heading": "DEFINITION",
          "canonical_heading": "DEFINITION",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Malignant neoplasm derived from the apocrine glands of the anal sac.",
              "pdf_page": 111,
              "printed_page": 29,
              "column": 1
            }
          ]
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Locally invasive.",
              "pdf_page": 111,
              "printed_page": 29,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "High metastatic rate (~50–80% at diagnosis), often to locoregional lymph nodes including medial iliac (MILN), internal iliac, sacral, less frequently to distant sites including liver, spleen, or lungs.",
              "pdf_page": 111,
              "printed_page": 29,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Frequently associated with hypercalcemia, secondary to parathyroid hormone–related peptide (PTH-rP) secretion.",
              "pdf_page": 111,
              "printed_page": 29,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prognosis good to guarded with appropriate treatment intervention.",
              "pdf_page": 111,
              "printed_page": 29,
              "column": 1
            }
          ]
        },
        "SYSTEMS AFFECTED": {
          "present": true,
          "status": "content",
          "source_heading": "SYSTEMS AFFECTED",
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Gastrointestinal.",
              "pdf_page": 111,
              "printed_page": 29,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Endocrine/metabolic.",
              "pdf_page": 111,
              "printed_page": 29,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hemic/lymphatic/immune.",
              "pdf_page": 111,
              "printed_page": 29,
              "column": 1
            }
          ]
        },
        "GENETICS": {
          "present": true,
          "status": "content",
          "source_heading": "GENETICS",
          "canonical_heading": "GENETICS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "English cocker spaniels significantly overrepresented, springer and Cavalier King Charles spaniels also overrepresented.",
              "pdf_page": 111,
              "printed_page": 29,
              "column": 1
            }
          ]
        },
        "INCIDENCE/PREVALENCE": {
          "present": true,
          "status": "content",
          "source_heading": "INCIDENCE/PREVALENCE",
          "canonical_heading": "INCIDENCE/PREVALENCE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Relatively uncommon—17% of perianal tumors, 2% of all skin/subcutaneous tumors.",
              "pdf_page": 111,
              "printed_page": 29,
              "column": 1
            }
          ]
        },
