          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Causes of lower urinary tract disease including bacterial UTI, cystolithiasis, sterile cystitis, urethritis, and bladder and urethral neoplasia.",
              "pdf_page": 922,
              "printed_page": 840,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary funguria must be differentiated from systemic infections with secondary funguria.",
              "pdf_page": 922,
              "printed_page": 840,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Contamination of urine samples during collection may occur in animals with cutaneous or mucocutaneous yeast overgrowth.",
              "pdf_page": 922,
              "printed_page": 840,
              "column": 1
            }
          ]
        },
