              "text": "Dog and cat.",
              "pdf_page": 922,
              "printed_page": 840,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "German shepherd dogs and female dogs are overrepresented in systemic aspergillosis.",
              "pdf_page": 922,
              "printed_page": 840,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dysuria, stranguria, and pollakiuria; gross hematuria is rare.",
              "pdf_page": 922,
              "printed_page": 840,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Many animals are asymptomatic.",
              "pdf_page": 922,
              "printed_page": 840,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
