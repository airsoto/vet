      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Funguria is usually due to ascending infection of normal commensal flora of the skin and mucosa, or environmentally ubiquitous organisms (primary funguria).",
              "pdf_page": 922,
              "printed_page": 840,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Candida albicansis the most common isolate; otherCandidaspp. are less common, and non-Candidaspp. fungi are rare.",
              "pdf_page": 922,
              "printed_page": 840,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urinary shedding may occur with systemic fungal infections (secondary funguria).",
              "pdf_page": 922,
              "printed_page": 840,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Organ system affected—renal/urologic.",
              "pdf_page": 922,
              "printed_page": 840,
              "column": 1
            }
          ]
        },
