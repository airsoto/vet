        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Fungal urinary tract infections (UTIs) are associated with immunosuppression or immunocompromised disease states.",
              "pdf_page": 922,
              "printed_page": 840,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Suspected risk factors—diabetes mellitus, urinary tract stomata (perineal urethrostomy, cystotomy tubes, indwelling urinary catheters), lower urinary tract disease (transitional cell carcinoma, chronic bacterial UTI), recent or chronic antibiotic or immunosuppressive therapy.",
              "pdf_page": 922,
              "printed_page": 840,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
