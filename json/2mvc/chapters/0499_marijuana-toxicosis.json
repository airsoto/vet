      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Marijuana is a general term that typically",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "refers toCannabis sativaorC. indicaplants",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and is synonymous with cannabis. Its legal",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "status in North America has changed",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "substantially in the past decade and varies",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "based on the country and state.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Of the 100+",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "cannabinoids in marijuana, the primary",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "psychoactive compound (i.e., induces a",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "“high”) isδ-9-tetrahydrocannabinol (THC).",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "THC is likely responsible for the clinical signs",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "of poisoning in pets.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "THC extracts can be",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "added to foods or sold in a wide variety of",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "products such as tinctures, capsules, oils,",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "sublingual sprays, topical creams, bath bombs,",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "even suppositories, or made into “concen-",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "trates”—wax-like formulations which are",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "smoked or vaped.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The minimum lethal dose",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "of marijuana plant material is greater than 3 g/",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "kg for dogs.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "THC binds to endocannabinoid",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "receptors CB1 and CB2.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cannabidiol (CBD),",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "a cannabinoid commonly used in medical",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "cannabis or sold as a “supplement” for pets",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and people, is not psychoactive although,",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "depending on the quality of the product, some",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "may inadvertently contain THC.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Commonly affected organ systems are",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "cardiovascular, gastrointestinal, nervous,",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "ophthalmic, respiratory, renal/urologic.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1,
              "subheading": "refers toCannabis sativaorC. indicaplants"
            }
          ]
        },
