        "CONTRAINDICATIONS/POSSIBLE INTERACTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Use acepromazine cautiously due to risk of",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "hypotension.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Use phenobarbital cautiously due to the risk of severe sedation and respiratory depression.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 3
            }
          ]
