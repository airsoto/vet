    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Monitor temperature, pulse, and respiration q2–3h until normal. Monitor blood pressure in severe cases (hypotension).",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 3
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Educate pet owners about the risks of leaving cannabis products, especially food, accessible to pets. Stress that pets will readily",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "consume such products.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Keep pets confined during parties.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 3
            }
          ]
        },
        "POSSIBLE COMPLICATIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": []
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical signs may last up to 24 hours in mild cases and may be monitored at home.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical signs may persist for several days in severe cases, especially if a large dose were",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "ingested.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The prognosis is excellent with",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "appropriate care.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Death is rare but has been reported in dogs ingesting foods made with marijuana butter.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 3
            }
          ]
        }
      }
    },
