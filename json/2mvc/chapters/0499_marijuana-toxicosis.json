      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Antiemetics (e.g., maropitant 1 mg/kg SQ,",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "IV q24h dogs or cats) as needed.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diazepam (0.5–1 mg/kg IV PRN dogs or cats) or butorphanol (0.1–0.4 mg/kg IM or IV dogs or cats) for CNS stimulation, anxiety, agitation.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 2
            }
          ]
        },
