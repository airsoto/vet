        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Younger animals may be overrepresented due to an increased tendency to ingest foreign items.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Often begin 0.5–2 hours after ingestion; may begin in minutes following inhalation.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lethargy, ataxia, vomiting, glazed eyes, mydriasis, depression, hypothermia, trembling,",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "urinary incontinence.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Higher doses may cause bradycardia, hypotension, and coma. Nystagmus, vocalization, sinus tachycardia, seizures, and hyperthermia may also occur.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Intoxication occurs via ingestion of foods containing THC, medical cannabis products, marijuana “concentrates,” or inhalation of marijuana smoke. Pets in homes of recreational or medical marijuana users are at",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "greater risk for exposure.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Of the cases reported to Pet Poison Helpline, an animal poison control center, about 65% involve food products, the majority of which also contain chocolate. Such foods may contain other toxic ingredients such as raisins,",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "macadamia nuts, xylitol, etc.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Regions with marijuana dispensaries correlate to increased exposures.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other illicit drugs—LSD (lysergic acid diethylamide), PCP (phencyclidine),",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "hallucinogenic mushrooms.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Opioids (greater cardiac/respiratory depression, miosis, reversed with naloxone), benzodiazepines, muscle relaxants, ethanol, ethylene glycol (metabolic acidosis, crystalluria), methanol, diethylene glycol, propylene glycol, tranquilizers, depressants, xylitol (hypoglycemia).",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "No specific abnormalities but should be used to rule out other causes.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Human urine drug tests are generally unreliable and may result in false negatives. A positive result can typically be considered a",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "true positive.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Serum, stomach contents and/or urine can be submitted to diagnostic labs for confirmatory testing.",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "No specific abnormalities but abdominal radiography is useful if an obstruction is suspected (e.g., ingestion of a baggie containing marijuana, packaging of a food product).",
              "pdf_page": 951,
              "printed_page": 869,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": []
        },
