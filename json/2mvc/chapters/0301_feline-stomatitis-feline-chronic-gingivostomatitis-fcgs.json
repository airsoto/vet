    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Medication and other therapies have been used with limited long-term success; lack of permanent response to conventional oral hygiene, antibiotics, anti-inflammatory drugs, and immunosuppressive drugs is typical; medications should not be regarded as primary method to control oropharyngeal inflammation.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Antibiotics—clindamycin 5 mg/kg q12h, metronidazole, amoxicillin, ampicillin, enrofloxacin, tetracycline.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Corticosteroids—prednisone 2 mg/kg initially daily, followed by every other day; methylprednisolone acetate 2 mg/kg q7–30 days may also help control inflammation.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gold salts—Solganal 1 mg/kg IM weekly until improvement (up to 4 months), then every 14–35 days.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chlorambucil—2 mg/m2PO every other day or 20 mg/m2every other week.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bovine lactoferrin—40 mg/kg applied to oral mucous membranes.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Interferon—alpha or omega 30 IU/day 7 days on, 7 days off, indefinitely.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CO2laser to decrease inflamed tissue.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cyclosporine—2 mg/kg BID.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 3
            }
          ]
        },
