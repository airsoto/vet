  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Inflammatory response affecting the oral cavity in cats.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "FCGS oropharyngeal inflammation is classified by location as:",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Alveolar mucositis (alveolar stomatitis)—",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "inflammation of alveolar mucosa (i.e., mucosa overlying the alveolar process and extending from the mucogingival junction without obvious demarcation to the vestibular sulcus and to the floor of the mouth).",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Caudal mucositis—inflammation of",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "mucosa of the caudal oral cavity, bordered medially by the palatoglossal folds and fauces, dorsally by the hard and soft palate, and rostrally by alveolar and buccal mucosa.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Glossitis—inflammation of mucosa of the",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "dorsal and/or ventral surface of the tongue.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Stomatitis—inflammation of the mucous",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "lining of any of the structures in the mouth; in clinical use the term should be reserved to describe widespread oral inflammation (beyond gingivitis and periodontitis) that may also extend into submucosal tissues.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 1
            }
          ]
        },
