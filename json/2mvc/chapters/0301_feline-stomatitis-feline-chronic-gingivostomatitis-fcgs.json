            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Soft diet should be encouraged for 2 weeks postoperatively, though some cats may not accept any dietary changes well.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 3
            }
          ]
        },
