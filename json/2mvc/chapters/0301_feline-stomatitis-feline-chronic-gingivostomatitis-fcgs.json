        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "•Cats.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Purebred breeds predisposed—Abyssinian,",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 1,
              "subheading": "•Cats."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Persian, Himalayan, Burmese, Siamese, and",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 1,
              "subheading": "•Cats."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Somali.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 1,
              "subheading": "•Cats."
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ptyalism.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Halitosis.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dysphagia.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anorexia—and/or prefers soft food.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Weight loss.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Scruffy hair coat from lack of grooming.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Erythematous, ulcerative, proliferative lesions affecting gingiva, glossopalatine arches, tongue, lips, buccal mucosa, and/or hard palate.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gingival inflammation commonly completely surrounds the tooth, compared with gingivitis, which usually occurs on buccal and labial surfaces.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May extend to glossopharyngeal arches as well as palate.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cause unknown; bacterial, viral, and immunologic etiologies suspected.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Significant findings of feline calicivirus; however, calicivirus load does not correlate with degree of inflammation or prognosis of positive therapy.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Immunosuppression from feline leukemia virus (FeLV) or feline immunodeficiency virus (FIV) can also lead to poorly responsive infections; most affected cats are negative for FeLV. Concomitant FIV infection is not uncommon.",
              "pdf_page": 601,
              "printed_page": 519,
              "column": 1
            }
          ]
        }
      }
    },
