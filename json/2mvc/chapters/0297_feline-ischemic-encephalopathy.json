        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "May continue to have uncontrolled seizures.",
              "pdf_page": 595,
              "printed_page": 513,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May continue to circle compulsively/propulsively.",
              "pdf_page": 595,
              "printed_page": 513,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May have behavioral changes such as aggression, especially in cats with damage to piriform lobe.",
              "pdf_page": 595,
              "printed_page": 513,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May stop meowing/develop aphasia in some cats.",
              "pdf_page": 595,
              "printed_page": 513,
              "column": 2
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "After initial onset, many patients improve and become acceptable pets; there may be persistent deficits, seizures, circling, and undesirable behavior such as aggression; may develop aphasia; persistent clinical signs depend on damage caused by infarction and parasitic migration.",
              "pdf_page": 595,
              "printed_page": 513,
              "column": 2
            }
          ]
        }
      }
