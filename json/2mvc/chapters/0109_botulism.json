        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Paralytic illness caused by preformed neurotoxin produced by bacterium",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Clostridium botulinum(Gram +, anaerobe)",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "contained in uncooked food, carrion, and",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Clostridium botulinum(Gram +, anaerobe)"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "contaminated or improperly stored silage.",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Clostridium botulinum(Gram +, anaerobe)"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most cases in dogs caused byClostridium",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Clostridium botulinum(Gram +, anaerobe)"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "botulinumneurotoxin serotype C; neurotoxin",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "interferes with release of acetylcholine at",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "botulinumneurotoxin serotype C; neurotoxin"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "neuromuscular junction, resulting in diffuse",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "botulinumneurotoxin serotype C; neurotoxin"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "lower motor neuron signs.",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "botulinumneurotoxin serotype C; neurotoxin"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Heavy molecular",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "botulinumneurotoxin serotype C; neurotoxin"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "weight of the toxin seems to preclude its",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "botulinumneurotoxin serotype C; neurotoxin"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "transfer to placenta.",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "botulinumneurotoxin serotype C; neurotoxin"
            }
          ]
        },
