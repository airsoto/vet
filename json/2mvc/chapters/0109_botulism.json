        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Signs appear a few hours to 6 days after",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "toxin ingestion.",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other dogs living in the",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "same environment may be affected.",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute,",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "symmetric, progressive weakness develops,",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "starting in the pelvic limbs and ascending to",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "the trunk, thoracic limbs, neck, and muscles",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "innervated by the cranial nerves; severe",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "tetraparesis or tetraplegia ensues.",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Possible increased or decreased heart rate.",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Physical Examination"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In severe cases—diaphragmatic respiration.",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Physical Examination"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Neurologic Examination Findings",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mental status—normal.",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Neurologic Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cranial nerves—",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Neurologic Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "may reveal sluggish pupillary light reflexes",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Neurologic Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(PLR), diminished palpebral reflexes,",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Neurologic Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "decreased jaw tone, decreased gag reflex,",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Neurologic Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "salivation, and dysphonia.",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Neurologic Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gait and",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Neurologic Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "posture—a stiff, short-stride gait (no ataxia) is",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Neurologic Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "initially observed until recumbence develops",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Neurologic Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "(usually within 12–24 hours).",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Neurologic Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Spinal",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Neurologic Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "reflexes—decreased to absent with decreased",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Neurologic Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "muscle tone (to atonia) and muscle atrophy.",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Neurologic Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Autonomic signs—mydriasis with decreased",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Neurologic Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "PLR, decreased lacrimation, ileus, and urine",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Neurologic Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "retention or frequent voiding of small",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Neurologic Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "volumes.",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Neurologic Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No hyperesthesia.",
              "pdf_page": 270,
              "printed_page": 188,
              "column": 1,
              "subheading": "Neurologic Examination Findings"
            }
          ]
        },
