    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "paragraph",
          "level": 0,
          "text": "usually occurs within 1–3 weeks, and requires the",
          "pdf_page": 270,
          "printed_page": 188,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "If recent ingestion—gastric lavage, formation of new nerve terminals and functional cathartics (avoid agents containing neuromuscular junctions. magnesium), or enemas may be useful.",
          "pdf_page": 270,
          "printed_page": 188,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Mildly affected dogs recover over a period of several days with supportive treatment including physical therapy, frequent turning, good bedding (to prevent decubital sores), bladder care (catheterization),",
          "pdf_page": 270,
          "printed_page": 188,
          "column": 2
        }
      ],
