          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Telephone follow-up within 2 weeks after consultation, repeat as needed to monitor progress and assess response to treatment.",
              "pdf_page": 953,
              "printed_page": 871,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "ECG if concerns about cardiac status.",
              "pdf_page": 953,
              "printed_page": 871,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CBC and biochemistry profile 3–4 weeks after initiating medical therapy and then q6–12 months.",
              "pdf_page": 953,
              "printed_page": 871,
              "column": 2
            }
          ]
