              "column": 1,
              "subheading": "Marking"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "pramine 0.25–1.0 mg/kg PO q24h; side",
              "pdf_page": 953,
              "printed_page": 871,
              "column": 1,
              "subheading": "Marking"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "effects include sedation, anticholinergic",
              "pdf_page": 953,
              "printed_page": 871,
              "column": 1,
              "subheading": "Marking"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "effects, arrhythmias, and gastrointestinal",
              "pdf_page": 953,
