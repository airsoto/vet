              "printed_page": 871,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Do not combine a TCA with an SSRI or other drugs that might increase serotonin.",
              "pdf_page": 953,
              "printed_page": 871,
              "column": 2
