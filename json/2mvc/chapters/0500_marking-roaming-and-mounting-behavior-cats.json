        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Response to therapy within 4 weeks.",
              "pdf_page": 953,
              "printed_page": 871,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Continue drug therapy for minimum 8 weeks if response noted; continue 1 month beyond resolution.",
              "pdf_page": 953,
              "printed_page": 871,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "When behavior is stable, wean dose by 25% per week.",
              "pdf_page": 953,
              "printed_page": 871,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If behavior recurs, reinstitute lowest effective dose.",
              "pdf_page": 953,
              "printed_page": 871,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Some cats may need to be maintained on medication indefinitely.",
              "pdf_page": 953,
              "printed_page": 871,
              "column": 3
            }
          ]
        }
