        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Mutation of theneuoncogene was identified",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "in some cases.",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1,
              "subheading": "Mutation of theneuoncogene was identified"
            }
          ]
        }
      }
