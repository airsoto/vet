        "ABBREVIATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "ABBREVIATIONS",
          "canonical_heading": "ABBREVIATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Electromyography (EMG)—to differentiate",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "EMG = electromyography. neurogenic from disuse muscle atrophy.",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 2
            },
            {
