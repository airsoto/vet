  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Tumors of the peripheral nerves, spinal",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "nerves, or nerve roots.",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Malignant peripheral nerve sheath tumor is the recommended denomination for these tumors, instead of schwannoma, neurilemmoma, or neuro fibroma, since determination of the cell of",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "origin is often impossible.",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most tumors (80%) occur in the thoracic limb of dogs.",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Approximately 50% of the tumors are located in the plexus or peripheral nerve region and 50% in the nerve root region.",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            }
          ]
        },
