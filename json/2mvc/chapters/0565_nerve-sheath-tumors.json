        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—no breed or gender predisposition.",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mean age in dogs—7.9 years; uncommon",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "in dogs younger than 3 years.",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rare in cats.",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic progressive thoracic limb lameness.",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Muscle atrophy (neurogenic atrophy) often present, more severe than that observed with",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "orthopedic disorders.",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Decreased muscle tone and decreased flexor reflex can be",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "observed.",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Axillary palpation detects a mass",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "in less than 30% of cases.",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Axillary pain",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "upon palpation occasionally.",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Horner’s syndrome can be seen in tumors involving the",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "T1–T3 nerve roots.",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ataxia, paresis, and asymmetric proprioceptive deficits can be seen if the tumor compresses the spinal cord.",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cutaneous trunci reflex may be poor to",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "absent on the affected side.",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In lumbosacral tumors, rectal palpation can be useful for",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "mass detection.",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Self-mutilation is occasionally observed.",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
