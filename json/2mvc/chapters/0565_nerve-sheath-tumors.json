    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Orthopedic conditions causing thoracic or pelvic limb lameness. Differentiate by orthopedic examination, radiographs, scintigraphy, CT, or MRI and response to rest and anti-inflammatory drugs. The severity of",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "muscle atrophy also useful.",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lateralized nerve root compression by intervertebral disc disease, lumbosacral disease (cauda equina syndrome), or spinal neoplasia. Intervertebral disc disease and lumbosacral disease are usually associated with spinal pain. Advanced imaging (CT or MRI) is required to",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "distinguish these diseases.",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary nerve neoplasia—lymphoma, histiocytic sarcoma, chondrosarcoma. Fine-needle or core biopsy needed to differentiate these conditions.",
              "pdf_page": 1058,
              "printed_page": 976,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
