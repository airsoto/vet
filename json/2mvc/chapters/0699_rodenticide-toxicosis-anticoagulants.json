    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "PT (preferred) test 2–3 days after the last dose of vitamin K1 to assess duration of therapy. If the PT is prolonged, administer another 1–3 weeks of vitamin K1 and retest.",
              "pdf_page": 1289,
              "printed_page": 1207,
              "column": 2
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Prevent pet’s access to anticoagulant rodenticides by using bait stations and keeping stored bait in a secure location.",
              "pdf_page": 1289,
              "printed_page": 1207,
              "column": 2
            }
          ]
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary bacterial pneumonia may occur following intrapulmonary hemorrhage.",
              "pdf_page": 1289,
              "printed_page": 1207,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intracranial and intra-articular hemorrhage may occur.",
              "pdf_page": 1289,
              "printed_page": 1207,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pregnant animals can abort due to placental hemorrhage and detachment.",
              "pdf_page": 1289,
              "printed_page": 1207,
              "column": 2
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "If the patient survives the first 48–72 hours of acute coagulopathy, the prognosis improves.",
              "pdf_page": 1289,
              "printed_page": 1207,
              "column": 2
            }
          ]
        }
      }
    },
