        "DEFINITION": {
          "present": true,
          "status": "content",
          "source_heading": "DEFINITION",
          "canonical_heading": "DEFINITION",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Anticoagulant rodenticide intoxication results in a delayed-onset (3–5 days) coagulopathy caused by the reduction of vitamin K1-dependent clotting factors (II, VII, IX, X).",
              "pdf_page": 1288,
              "printed_page": 1206,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "There are two primary types of anticoagulant rodenticides: first- and second-generation. First-generation anticoagulants, such as warfarin, are generally less toxic and shorter acting than second-generation which tend to persist longer in the liver and require 3–4 weeks of antidote therapy.",
              "pdf_page": 1288,
              "printed_page": 1206,
              "column": 1
            }
          ]
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Anticoagulant rodenticides inhibit vitamin K1 epoxide reductase, DT-diaphorase, and possibly other enzymes involved in the reduction of vitamin K1 epoxide to vitamin K1.",
              "pdf_page": 1288,
              "printed_page": 1206,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vitamin K1 is required for carboxylation of clotting factors II, VI, IX, and X; uncarboxylated clotting factors do not bind calcium sufficiently to participate in clot formation.",
              "pdf_page": 1288,
              "printed_page": 1206,
              "column": 1
            }
          ]
        },
        "SYSTEMS AFFECTED": {
          "present": true,
          "status": "content",
          "source_heading": "SYSTEMS AFFECTED",
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Hemic/lymphatic/immune.",
              "pdf_page": 1288,
              "printed_page": 1206,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory.",
              "pdf_page": 1288,
              "printed_page": 1206,
              "column": 1
            }
          ]
        },
        "GENETICS": {
