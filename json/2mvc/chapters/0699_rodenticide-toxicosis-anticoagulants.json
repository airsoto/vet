    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Vitamin K1, 2.5–5.0 mg/kg PO q12h for 5–7 days for most first-generation",
              "pdf_page": 1289,
              "printed_page": 1207,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "anticoagulants and PO q24h for 4–6 weeks for most second-generation anticoagulants; bioavailability may be enhanced by the concurrent feeding of a small amount of fat, such as canned dog food.",
              "pdf_page": 1289,
              "printed_page": 1207,
              "column": 2
            }
          ]
        },
        "CONTRAINDICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS",
          "canonical_heading": "CONTRAINDICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Vitamin K3 is not efficacious in the treatment of anticoagulant rodenticide toxicosis and should not be used.",
              "pdf_page": 1289,
              "printed_page": 1207,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "IV vitamin K1 has been reported to cause anaphylactoid reactions. Avoid this route of administration.",
              "pdf_page": 1289,
              "printed_page": 1207,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Minimize stress, trauma, jugular venipuncture, and cystocentesis due to the risk of acute and catastrophic hemorrhage.",
              "pdf_page": 1289,
              "printed_page": 1207,
              "column": 2
            }
          ]
        },
        "PRECAUTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "PRECAUTIONS",
          "canonical_heading": "PRECAUTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Avoid large-bore hypodermic needles, unnecessary surgical procedures, and parenteral injections.",
              "pdf_page": 1289,
              "printed_page": 1207,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Use the smallest possible needle when giving an injection or collecting samples.",
              "pdf_page": 1289,
              "printed_page": 1207,
              "column": 2
            }
          ]
        },
        "POSSIBLE INTERACTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE INTERACTIONS",
          "canonical_heading": "POSSIBLE INTERACTIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Sulfonamides and phenylbutazone may displace anticoagulant rodenticides from plasma binding sites, leading to freer toxicant and increased risk of toxicosis.",
              "pdf_page": 1289,
              "printed_page": 1207,
              "column": 2
            }
          ]
        },
        "CONTRAINDICATIONS/POSSIBLE INTERACTIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": []
