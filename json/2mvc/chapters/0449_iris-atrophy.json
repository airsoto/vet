              "type": "paragraph",
              "level": 0,
              "text": "associated abnormalities.",
              "pdf_page": 872,
              "printed_page": 790,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Senile—may continue to progress with age.",
              "pdf_page": 872,
              "printed_page": 790,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
