        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog—common aging change; all breeds, but affects small breeds (e.g., miniature and toy poodles, miniature schnauzers, Chihuahuas) more commonly.",
              "pdf_page": 872,
              "printed_page": 790,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cat—uncommon; most common with blue irides.",
              "pdf_page": 872,
              "printed_page": 790,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary—any breed of dog or cat.",
              "pdf_page": 872,
              "printed_page": 790,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 872,
              "printed_page": 790,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Large or dyscoric pupil in one or both eyes.",
              "pdf_page": 872,
              "printed_page": 790,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Photophobia.",
              "pdf_page": 872,
              "printed_page": 790,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Previous episodes of uveitis.",
              "pdf_page": 872,
              "printed_page": 790,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 872,
              "printed_page": 790,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Incomplete or absent pupillary light reflex",
              "pdf_page": 872,
              "printed_page": 790,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "accompanied by normal menace response and",
              "pdf_page": 872,
              "printed_page": 790,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "dazzle reflex.",
              "pdf_page": 872,
              "printed_page": 790,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anisocoria may be present with unilateral",
              "pdf_page": 872,
              "printed_page": 790,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "or asymmetric presentation.",
              "pdf_page": 872,
              "printed_page": 790,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Irregular, scalloped edge to pupillary",
              "pdf_page": 872,
              "printed_page": 790,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "margin; dyscoria (see Web Figures 1 and 2).",
              "pdf_page": 872,
              "printed_page": 790,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tapetal reflex visible through thin or absent",
              "pdf_page": 872,
              "printed_page": 790,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "areas of the iris on transillumination—",
              "pdf_page": 872,
              "printed_page": 790,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "translucent patches or holes within the iris",
              "pdf_page": 872,
              "printed_page": 790,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "stroma: may resemble additional pupils.",
              "pdf_page": 872,
              "printed_page": 790,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Strands of iris arising from free pupillary",
              "pdf_page": 872,
              "printed_page": 790,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "margin occasionally remain, spanning across",
              "pdf_page": 872,
              "printed_page": 790,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "portions of the pupil (Web Figures 1 and 2).",
              "pdf_page": 872,
              "printed_page": 790,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary—may be accompanied by any",
              "pdf_page": 872,
              "printed_page": 790,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "sign associated with chronic uveitis.",
              "pdf_page": 872,
              "printed_page": 790,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
