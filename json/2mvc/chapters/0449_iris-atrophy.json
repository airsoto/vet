              "printed_page": 790,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "lens zonules and indentation of the lens",
              "pdf_page": 872,
              "printed_page": 790,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
