        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Depends on underlying condition.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypercoagulability is symptomless; thrombosis causes site-dependent signs.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pulmonary thromboembolism (PTE)— acute severe dyspnea and tachypnea.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Arterial thromboembolism (ATE)—acute paresis/paralysis, limb pain (ischemic myopathy), decreased pulse and cold limbs; onset in dogs may be gradual vs. peracute in cats.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Portal vein or caudal vena cava thrombosis—ascites.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Immune-mediated hemolytic anemia (IMHA).",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Protein-losing nephropathy.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypoproteinemia.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Systemic inflammation.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neoplasia.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cardiac disease.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperadrenocorticism or corticosteroid therapy.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "PTE may mimic pneumonia, pulmonary edema, dirofilariasis.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Distal ATE—other causes of paraparesis and paraplegia (e.g., neurologic).",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Reflect underlying disease or effects of thrombosis in specific organs. Animals with protein-losing nephropathy have proteinuria and elevated urine protein : creatinine ratio, possibly signs of nephrotic syndrome.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "D-dimer—sensitive for fibrinolysis; thrombosis unlikely if normal; nonspecific for cause.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Antithrombin (AT)—decreased activity increases risk of thrombosis.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prothrombin time (PT), activated partial thromboplastin time (APTT)—shortened clotting times are unreliable markers for thrombophilia.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thromboelastography, thromboelastometry, rotational thromboelastometry—can potentially identify hypercoagulability.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Arterial blood gas, pulse oximetry— hypoxemia.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ultrasonography—confirm presence of arterial or venous thrombi.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Echocardiography—identify cardiac disease, intracardiac thrombi, or spontaneous echocontrast (“smoke”); pulmonary hypertension associated with PTE.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Angiography (standard or CT angiography).",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nuclear perfusion scintigraphy—can support diagnosis of PTE.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": false,
          "status": "missing",
