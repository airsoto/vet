  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypercoagulability (aka thrombophilia) is an imbalance between procoagulant and anticoagulant factors that favors thrombosis.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thrombus formation occurs in the presence of endothelial injury, altered blood flow, and/or hypercoagulability (Virchow’s triad).",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypercoagulability may result from platelet hyperaggregability, increased amounts or activation of clotting factors, reduced or inhibited anticoagulant proteins, or defective fibrinolysis.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Common sites of thrombosis—pulmonary arteries, distal aorta, cranial vena cava, intestinal/mesenteric vessels, portal vein.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
