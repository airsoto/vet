          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": []
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Inpatient—supportive care, analgesia, anticoagulation.",
          "pdf_page": 759,
          "printed_page": 677,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Supportive care—ensure hydration, maintain perfusion, minimize vascular stasis, correct and monitor acid-base and electrolyte abnormalities, use venous catheters appropriately.",
          "pdf_page": 759,
          "printed_page": 677,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Oxygen therapy for hypoxemia.",
          "pdf_page": 759,
          "printed_page": 677,
          "column": 2
        }
      ],
