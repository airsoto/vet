    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Anticoagulants",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Unfractionated heparin for initial therapy,",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2,
              "subheading": "Anticoagulants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "starting dose: 150–200 IU/kg SC q6-8h;",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2,
              "subheading": "Anticoagulants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "titrate to achieve 1.5-fold increase in APTT;",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2,
              "subheading": "Anticoagulants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "check APTT daily (4h post heparin dose).",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2,
              "subheading": "Anticoagulants"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Low molecular weight heparin—",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2,
              "subheading": "Anticoagulants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "enoxaparin: 1 mg/kg (1,000 U/kg) SC",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2,
              "subheading": "Anticoagulants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "q6–12h; dalteparin: 150 mg/kg SC q 6–8h.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2,
              "subheading": "Anticoagulants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Monitor anti-Xa activity.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2,
              "subheading": "Anticoagulants"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rivaroxaban—0.5 mg/kg PO q24h for",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2,
              "subheading": "Anticoagulants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "chronic therapy; no reversal agents available.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2,
              "subheading": "Anticoagulants"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Warfarin for chronic therapy, starting dose:",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2,
              "subheading": "Anticoagulants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "0.1–0.2 mg/kg PO q24h; adjust dose based",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2,
              "subheading": "Anticoagulants"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "on international normalized ratio.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2,
              "subheading": "Anticoagulants"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Platelet Inhibition",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Clopidogrel—prophylaxis, prevents repeat",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2,
              "subheading": "Platelet Inhibition"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "thrombosis; dogs: 0.5–1 mg/kg PO q24h;",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2,
              "subheading": "Platelet Inhibition"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "cats: 18.75 mg PO q24h; more effective than",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2,
              "subheading": "Platelet Inhibition"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "aspirin in preventing recurrence of ATE in",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2,
              "subheading": "Platelet Inhibition"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "cats.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Aspirin—prophylaxis, after thrombosis;",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 3,
              "subheading": "cats."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "dogs: 0.5–5.0 mg/kg PO q12–24h.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 3,
              "subheading": "cats."
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Thrombolysis",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Severe side effects possible. Reperfusion",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 3,
              "subheading": "Thrombolysis"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "injury is common.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 3,
              "subheading": "Thrombolysis"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tissue plasminogen activator (tPA)—1 mg/",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 3,
              "subheading": "Thrombolysis"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "kg incrementally IV once; most effective in",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 3,
              "subheading": "Thrombolysis"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "first 3–6 hours after thromboembolism.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 3,
              "subheading": "Thrombolysis"
            }
          ]
        },
