        "CONTRAINDICATIONS/POSSIBLE INTERACTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Do not treat with warfarin initially; overlap with heparin therapy for 2 days.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reassess coagulation with any medication changes.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If bleeding occurs, discontinue and administer protamine or vitamin K and plasma as indicated to correct hemorrhage.",
              "pdf_page": 759,
              "printed_page": 677,
              "column": 3
            }
          ]
        },
        "ALTERNATIVE DRUG(S)": {
          "present": false,
