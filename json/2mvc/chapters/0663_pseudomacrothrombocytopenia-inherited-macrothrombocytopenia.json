  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "A common cause of thrombocytopenia and increased mean platelet volume (MPV) in cavalier King Charles spaniels (CKCS), and infrequently in other breeds.",
              "pdf_page": 1227,
              "printed_page": 1145,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Caused by an inherited mutation that impairs platelet maturation, resulting in the early release of platelets from the bone marrow. The released platelets are significantly larger than normal.",
              "pdf_page": 1227,
              "printed_page": 1145,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Overall platelet mass (product of platelet number and average size) is unaffected, therefore clinical signs of hypocoagulability are not seen.",
              "pdf_page": 1227,
              "printed_page": 1145,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
        "PATHOPHYSIOLOGY": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": []
        },
        "SYSTEMS AFFECTED": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": []
        },
        "GENETICS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GENETICS",
          "content_blocks": []
        },
        "INCIDENCE/PREVALENCE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "INCIDENCE/PREVALENCE",
          "content_blocks": []
        },
        "GEOGRAPHIC DISTRIBUTION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GEOGRAPHIC DISTRIBUTION",
          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—primarily CKCS with infrequent reports in Norfolk terriers, Cairn terriers, English toy spaniels, and Jack Russell terriers; other breeds also sporadically affected.",
              "pdf_page": 1227,
              "printed_page": 1145,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "A similar condition is also reported in Akitas, although a specific mutation has not yet been identified in this breed.",
              "pdf_page": 1227,
              "printed_page": 1145,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The condition is present from birth, but is often not detected until a CBC is performed. The mutation is autosomal, therefore there is no sex predilection.",
              "pdf_page": 1227,
              "printed_page": 1145,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Not associated with clinical signs; often incidentally noted on a CBC performed for other reasons.",
              "pdf_page": 1227,
              "printed_page": 1145,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Caused by point mutations in the gene encodingβ1-tubulin, which is involved in platelet formation. The mutations impair the formation of microtubules in the megakaryocyte (platelet precursor) and result in the release of lower numbers of platelets that are larger than normal.",
              "pdf_page": 1227,
              "printed_page": 1145,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The condition is inherited in an autosomal fashion, with homozygotes exhibiting moderate to marked thrombocytopenia and moderate to marked increases in MPV. Heterozygotes are less severely affected and may have a mild thrombocytopenia and/or mild increase in MPV.",
              "pdf_page": 1227,
              "printed_page": 1145,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In the United States, it has been estimated that approximately 47% of CKCS are homozygous for the mutation and 45% are heterozygous.",
              "pdf_page": 1227,
              "printed_page": 1145,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Must be differentiated from causes of pathologic thrombocytopenia such as immune-mediated thrombocytopenia, disseminated intravascular coagulation, infectious diseases (especially tick-borne",
              "pdf_page": 1227,
              "printed_page": 1145,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "diseases), and causes of decreased platelet production (i.e., bone marrow disease).",
              "pdf_page": 1227,
              "printed_page": 1145,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Breed (especially CKCS), absence of clinical signs, and a normal plateletcrit (PCT) (see CBC/Biochemistry/Urinalysis) are strongly suggestive of inherited macrothrombocytopenia.",
              "pdf_page": 1227,
              "printed_page": 1145,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Blood smear evaluation is also",
              "pdf_page": 1227,
              "printed_page": 1145,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "recommended to rule outin vitroplatelet",
              "pdf_page": 1227,
              "printed_page": 1145,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "clumping, which artifactually induces a",
              "pdf_page": 1227,
              "printed_page": 1145,
              "column": 2,
              "subheading": "recommended to rule outin vitroplatelet"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "decreased platelet count and increased MPV.",
              "pdf_page": 1227,
              "printed_page": 1145,
              "column": 2,
              "subheading": "recommended to rule outin vitroplatelet"
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "CBC—moderate to marked thrombo cytopenia (40,000–200,000/μL) with significantly increased MPV; PCT expected to be within reference interval (RI = 0.129–0.403%).",
              "pdf_page": 1227,
              "printed_page": 1145,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "PCT—a numeric representation of overall platelet mass (product of platelet number and average size). Some automated analyzers calculate the value automatically. If not provided, PCT can be calculated using the following formula: PCT=(PLT×MPV)/10,000 where PLT is platelet count and MPV is mean platelet volume.",
              "pdf_page": 1227,
              "printed_page": 1145,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "If definitive diagnosis is desired, genetic testing to confirm the presence of the mutation can be performed; currently, this is available through the Auburn University Hemostasis Laboratory.",
              "pdf_page": 1227,
              "printed_page": 1145,
              "column": 2
            }
          ]
        },
