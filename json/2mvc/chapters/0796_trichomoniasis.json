          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Enteric, pear-shaped, motile (flagellated)",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "protozoa similar toGiardia—inhabits large",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "intestine of cats; similar organisms live in",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1,
              "subheading": "protozoa similar toGiardia—inhabits large"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "intestinal tract of many mammals",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1,
              "subheading": "protozoa similar toGiardia—inhabits large"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tritrichomonas foetus(sometimes referred to",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1,
              "subheading": "protozoa similar toGiardia—inhabits large"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "asT. blagburni) causes diarrhea in cats:",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Transmitted via fecal–oral route,",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1,
              "subheading": "asT. blagburni) causes diarrhea in cats:"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "ingestion of trophozoites via grooming.",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1,
              "subheading": "asT. blagburni) causes diarrhea in cats:"
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Parasites colonize terminal ileum, cecum,",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1,
              "subheading": "asT. blagburni) causes diarrhea in cats:"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and colon leading to large bowel diarrhea.",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1,
              "subheading": "asT. blagburni) causes diarrhea in cats:"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Coinfection withGiardia—common.",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1,
              "subheading": "asT. blagburni) causes diarrhea in cats:"
            }
          ]
        },
