        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Young, often purebred cats—usually under 1 year (range 3 months–13 years); particularly high prevalence in catteries.",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Cats",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May or may not have symptoms of infection.",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intermittent large bowel diarrhea, malodorous,",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "occasionally contains blood and mucus.",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anus—may become edematous,",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "erythematous, and painful in kittens.",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rectal prolapse—if anal irritation becomes",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "severe.",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diarrhea—improves with antibiotic",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "treatment but reoccurs following course of",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "treatment; may also show waxing and waning",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "course without treatment.",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Median length of time of diarrhea is about",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "9 months, with resolution in most cats by 2",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "years; number of cats cohabitating will impact",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "duration of clinical signs.",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Persistence of infection after resolution of",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "diarrhea is common.",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1,
              "subheading": "Cats"
            }
          ]
        },
