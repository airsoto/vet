    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Most cats spontaneously resolve their diarrhea but may take years (range 4 months–2 years).",
          "pdf_page": 1439,
          "printed_page": 1357,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Relapses of diarrhea are common and often precipitated by dietary changes, stress, treatments of other conditions.",
          "pdf_page": 1439,
          "printed_page": 1357,
          "column": 3
        }
      ],
