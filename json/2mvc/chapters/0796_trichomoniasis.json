      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Cats",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Dietary indiscretion, inflammatory bowel",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "disease, neoplasia (especially gastrointestinal",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "lymphoma), drugs (antibiotics), toxins (lead),",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "parasites (cryptosporidiosis,Giardia, hookworms,",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "roundworms), bacterial agents (salmonellosis,",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "intestinal bacterial overgrowth, clostridia),",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "systemic organ dysfunction (renal, hepatic,",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "pancreatic, cardiac), and metabolic",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(hyperthyroidism).",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2,
              "subheading": "Cats"
            }
          ]
        },
