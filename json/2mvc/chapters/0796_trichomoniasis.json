      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "No approved treatments.",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "T.foetus—poor treatment responses are common.",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Ronidazole 30 mg/kg PO q24h for",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "14 days; currently preferred treatment.",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Metronidazole 30–50 mg/kg PO q12h,",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "3–14 days.",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "P. hominis—metronidazole 20 mg/kg PO q12h for 7 days.",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2
            }
          ]
        },
