        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Direct fecal smear—very low sensitivity:",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Method—dilute fresh feces 50:50 in",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "saline, cover slip, examine at 40× objective with condenser lowered to increase contrast.",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Distinguish fromGiardia(concave ventral",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "disc, spiral forward motion)—T.foetushas",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "jerky forward motion, spindle-shaped,",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2,
              "subheading": "disc, spiral forward motion)—T.foetushas"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "undulating membranes.",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2,
              "subheading": "disc, spiral forward motion)—T.foetushas"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "T. foetustrophozoites not seen on fecal",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2,
              "subheading": "disc, spiral forward motion)—T.foetushas"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "flotation, will not survive refrigeration.",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2,
              "subheading": "disc, spiral forward motion)—T.foetushas"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fecal protozoal culture—use commercial",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2,
              "subheading": "disc, spiral forward motion)—T.foetushas"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "media in 37°C incubator (e.g., InPouch® TF);",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2,
              "subheading": "disc, spiral forward motion)—T.foetushas"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "inoculate with 0.05 g fresh feces, examine for",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2,
              "subheading": "disc, spiral forward motion)—T.foetushas"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "motile trophozoites daily for 12 days:",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2,
              "subheading": "disc, spiral forward motion)—T.foetushas"
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "GiardiaandP. hominis—do not grow",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2,
              "subheading": "disc, spiral forward motion)—T.foetushas"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "after 24 hours in InPouch system.",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2,
              "subheading": "disc, spiral forward motion)—T.foetushas"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "PCR (feces)—more sensitive than fecal culture.",
              "pdf_page": 1439,
              "printed_page": 1357,
              "column": 2,
              "subheading": "disc, spiral forward motion)—T.foetushas"
            }
          ]
        },
