      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Discourage breeding of affected animals. Other inherited myopathies such as centronu-",
              "pdf_page": 1020,
              "printed_page": 938,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Do not repeat dam–sire matings that result clear X-linked myotubular myopathies,",
              "pdf_page": 1020,
              "printed_page": 938,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "in affected offspring.",
              "pdf_page": 1020,
              "printed_page": 938,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Consider DNA testing infectious (especially protozoal), immuneof breeding animals where tests are available. mediated, or metabolic myopathies.",
              "pdf_page": 1020,
              "printed_page": 938,
              "column": 2
            }
          ]
        },
