        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Seen primarily in neonate and young dogs (<1",
              "pdf_page": 1020,
              "printed_page": 938,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "year).",
              "pdf_page": 1020,
              "printed_page": 938,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Described in cats.",
              "pdf_page": 1020,
              "printed_page": 938,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Muscular dystrophy due to dystrophin deficiency primarily affects",
              "pdf_page": 1020,
              "printed_page": 938,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "males.",
              "pdf_page": 1020,
              "printed_page": 938,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Several dog breeds known to be affected. Best described in golden retrievers.",
              "pdf_page": 1020,
              "printed_page": 938,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Females—usually carriers of dystrophin gene defect, but dystrophin-deficient females may exhibit muscle weakness, tremors, limb",
              "pdf_page": 1020,
              "printed_page": 938,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "deformities, and exercise intolerance.",
              "pdf_page": 1020,
              "printed_page": 938,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Muscular dystrophy due to other muscle protein or unclassified defects may be seen in young male or female dogs and cats of any breed.",
              "pdf_page": 1020,
              "printed_page": 938,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Dogs",
              "pdf_page": 1020,
              "printed_page": 938,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Golden retrievers—exercise intolerance;",
              "pdf_page": 1020,
              "printed_page": 938,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "stilted gait; bunny-hopping pelvic limb gait;",
              "pdf_page": 1020,
              "printed_page": 938,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "plantigrade stance; partial trismus; muscle",
              "pdf_page": 1020,
              "printed_page": 938,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "atrophy (especially the truncal and temporalis",
              "pdf_page": 1020,
              "printed_page": 938,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "muscles); hypertrophy of some muscles",
              "pdf_page": 1020,
              "printed_page": 938,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(especially the tongue); kyphosis; lordosis;",
              "pdf_page": 1020,
              "printed_page": 938,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "drooling; dysphagia; aspiration pneumonia (due",
              "pdf_page": 1020,
              "printed_page": 938,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "to pharyngeal and/or esophageal involvement).",
              "pdf_page": 1020,
              "printed_page": 938,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other breeds—similar; include vomiting and",
              "pdf_page": 1020,
              "printed_page": 938,
              "column": 1,
              "subheading": "Dogs"
            }
          ]
        },
