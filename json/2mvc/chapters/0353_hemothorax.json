        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Trauma—bleeding artery or vein of the thoracic wall, mediastinum, or thoracic spine; damaged heart, lungs, thymus, or diaphragm; herniated abdominal viscera (liver or spleen).",
              "pdf_page": 688,
              "printed_page": 606,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neoplasia—involving any structure adjacent to the pleural cavity; rib tumors are particularly",
              "pdf_page": 688,
              "printed_page": 606,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "common.",
              "pdf_page": 688,
              "printed_page": 606,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Coagulopathies—can be congenital or acquired; rodenticide ingestion common.",
              "pdf_page": 688,
              "printed_page": 606,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lung lobe torsion.",
              "pdf_page": 688,
              "printed_page": 606,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute thymic hemor-",
              "pdf_page": 688,
              "printed_page": 606,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "rhage in young animals.",
              "pdf_page": 688,
              "printed_page": 606,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dirofilaria immitis, Spirocerca lupi,Angiostrongylus vasorum.",
              "pdf_page": 688,
              "printed_page": 606,
              "column": 1
            }
          ]
        }
      }
