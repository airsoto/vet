        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Any age, breed, or sex of dog and cat; younger dogs more commonly affected with anticoagulant rodenticide and trauma, older dogs more commonly affected with cancer.",
              "pdf_page": 688,
              "printed_page": 606,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Peracute to acute onset—hypovolemic signs can occur before sufficient blood volume accumulates in the pleural space to impair",
              "pdf_page": 688,
              "printed_page": 606,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "respiration.",
              "pdf_page": 688,
              "printed_page": 606,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In chronic cases, larger volumes",
              "pdf_page": 688,
              "printed_page": 606,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "of blood may accumulate.",
              "pdf_page": 688,
              "printed_page": 606,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory distress, tachypnea; honking cough is possible in dogs with rodenticide poisoning; ecchymoses along ventral cervical and thoracic inlet",
              "pdf_page": 688,
              "printed_page": 606,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "areas.",
              "pdf_page": 688,
              "printed_page": 606,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pale mucous membranes.",
              "pdf_page": 688,
              "printed_page": 606,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Weakness",
              "pdf_page": 688,
              "printed_page": 606,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "and collapse.",
              "pdf_page": 688,
              "printed_page": 606,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Weak, rapid pulse.",
              "pdf_page": 688,
              "printed_page": 606,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
