        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiography—may detect lung metastasis (rare).",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal ultrasonography—evaluate and monitor sublumbar lymph nodes if skin disease involves the caudal half of the patient.",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytology or histopathology of lesion— ulceration, inflammation, and secondary infection may limit diagnostic utility of cytology. A deep wedge or punch biopsy is often needed to definitively diagnose cutaneous SCC. Multiple samples recommended as actinic form may encompass spectrum from actinic changes to carcinoma.",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytology of lymph nodes to identify presence of regional metastasis.",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
