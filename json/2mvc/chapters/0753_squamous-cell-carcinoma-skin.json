    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Imiquimod 5% cream for MSCCIS—topically to affected lesions q24–48h; most cats respond but develop new lesions in other sites.",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cisplatin—dogs, 60 mg/m2IV q3 or 4 weeks for 4 treatments.",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Carboplatin—dogs, 300 mg/m2IV q3 weeks; cats, 200–250 mg/m2IV q3–4 weeks for 4–5 treatments.",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mitoxantrone—dogs and cats, 5–6 mg/m2 IV q3 weeks for 4–5 treatments.",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 3
            }
          ]
        },
