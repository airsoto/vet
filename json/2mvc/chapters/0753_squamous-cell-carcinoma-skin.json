      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Physical examination 1 month after resolution of tumor, then every 3 months after treatment.",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiography and lymph node evaluation at each 3-month recheck examination; abdominal ultrasound if the lesion is on the caudal portion of the patient.",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 3
            }
          ]
        },
