        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats, mean age 9–10 years; often have light/unpigmented skin.",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs, mean age 8 years; Scottish terrier, Pekingese, boxer, poodle, Norwegian elkhound, Dalmatian, beagle, whippet, and white English bull terrier may be predisposed.",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Proliferative or erosive skin lesions.",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Solar-induced lesions in cats—nasal planum, eyelids, lips, and pinna.",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "MSCCIS may occur in any site, unrelated to sun exposure or skin pigmentation; may note 2–30+ lesions on the head, digits, neck, thorax, shoulders, and ventral abdomen; hair in the lesion epilates easily; crusts cling to the epilated hair shaft.",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—most commonly affects toes, scrotum, nose, legs, and anus.",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
