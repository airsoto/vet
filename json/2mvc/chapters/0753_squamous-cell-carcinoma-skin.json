      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Malignant tumor of squamous epithelium.",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Multicentric squamous cell carcinomain",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "situ(MSSCIS)- also called Bowen’s-like",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "disease or Bowenoid carcinomain situ(cats).",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 1,
              "subheading": "situ(MSSCIS)- also called Bowen’s-like"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Local disease may progress from carcinoma",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 1,
              "subheading": "situ(MSSCIS)- also called Bowen’s-like"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "in situto invasive carcinoma.",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 1,
              "subheading": "situ(MSSCIS)- also called Bowen’s-like"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metastasis is uncommon—most common",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 1,
              "subheading": "situ(MSSCIS)- also called Bowen’s-like"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "sites are regional lymph nodes and lungs.",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 1,
              "subheading": "situ(MSSCIS)- also called Bowen’s-like"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Systems affected—skin/exocrine.",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 1,
              "subheading": "situ(MSSCIS)- also called Bowen’s-like"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Represents 9–25% of all skin tumors in",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 1,
              "subheading": "situ(MSSCIS)- also called Bowen’s-like"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "cats; 4–18% in dogs.",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 1,
              "subheading": "situ(MSSCIS)- also called Bowen’s-like"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Solar-induced (actinic) SCC is more",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 1,
              "subheading": "situ(MSSCIS)- also called Bowen’s-like"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "prevalent in sunny climates and high altitudes.",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 1,
              "subheading": "situ(MSSCIS)- also called Bowen’s-like"
            }
          ]
        },
