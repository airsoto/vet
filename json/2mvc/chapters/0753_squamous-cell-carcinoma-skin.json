        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ultraviolet irradiation (actinic form).",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Papillomaviruses may play a role.",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Light/nonpigmented skin.",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Previous thermal injury.",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Risk factors for MSCCIS in cats are undetermined but may be associated with immunosuppression.",
              "pdf_page": 1371,
              "printed_page": 1289,
              "column": 1
            }
          ]
        }
      }
    },
