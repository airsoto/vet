          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Calcipotriene, also known as calcipotriol, is a synthetic analogue of calcitriol, an active",
              "pdf_page": 286,
              "printed_page": 204,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "metabolite of Vitamin D3.",
              "pdf_page": 286,
              "printed_page": 204,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Calcitriol activity:",
              "pdf_page": 286,
              "printed_page": 204,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anti-psoriatic—increases epithelial cell differentiation and decreases keratinocyte",
              "pdf_page": 286,
              "printed_page": 204,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "proliferation.",
              "pdf_page": 286,
              "printed_page": 204,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Promotes calcium retention— triggers intestinal absorption, renal reabsorption, and mobilization of bone resorption of",
              "pdf_page": 286,
              "printed_page": 204,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "calcium.",
              "pdf_page": 286,
              "printed_page": 204,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Toxic exposure leads to hypercalcemia with soft tissue mineralization (hypercalcemic nephropathy), cardiac conduction disturbance, and gastrointestinal",
              "pdf_page": 286,
              "printed_page": 204,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "ulceration.",
              "pdf_page": 286,
              "printed_page": 204,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cream, ointment, foam, and solution formulation for treatment of human psoriasis; common tradenames—Calcitrene®,",
              "pdf_page": 286,
              "printed_page": 204,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dovonex®, Sorilux®, Taclonex®.",
              "pdf_page": 286,
              "printed_page": 204,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Very low",
              "pdf_page": 286,
              "printed_page": 204,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "margin of safety—considerallexposures",
              "pdf_page": 286,
              "printed_page": 204,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "toxic.",
              "pdf_page": 286,
              "printed_page": 204,
              "column": 1,
              "subheading": "margin of safety—considerallexposures"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Organ systems affected—",
              "pdf_page": 286,
