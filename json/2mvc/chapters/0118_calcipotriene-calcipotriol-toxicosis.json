        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Early (0–24 hours)—vomiting, anorexia, diarrhea, depression, polyuria, polydipsia.",
              "pdf_page": 286,
              "printed_page": 204,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Late (18–72 hours)—hypercalcemia, hyperphosphatemia, azotemia/acute renal",
              "pdf_page": 286,
              "printed_page": 204,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "injury.",
              "pdf_page": 286,
              "printed_page": 204,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other—bradycardia, arrhythmias, hematemesis, melena, abdominal pain,",
              "pdf_page": 286,
              "printed_page": 204,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "oliguria.",
              "pdf_page": 286,
              "printed_page": 204,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "End stage—anuria, acute renal failure/dystrophic calcification of soft tissue, coma, death.",
              "pdf_page": 286,
              "printed_page": 204,
              "column": 1
            }
          ]
        },
