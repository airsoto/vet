    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "After surgery, restrict activity for the rest of",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "the day.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Analgesia (nonsteroidal anti-inflammatory drug [NSAID]) for 24–36 hours",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "postop.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Soft diet for 3 days—canned food or",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "moistened dry kibble.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No chew toys for",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "3 days; no “tug of war” for 1 week.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Oral",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "chlorhexidine rinse for 3–5 days.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Continue daily tooth brushing after 24 hours.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 3
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "May be prevalent in certain breeds and lines—avoid similar breeding.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 3
            }
          ]
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Malocclusion that results after full eruption of permanent teeth may require treatment.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Linguoversion of one or both mandibular",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "canine teeth.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mesioversion of one or both maxillary canine teeth.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 3
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Once extracted, there should be no further",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "problems.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Resulting malocclusion needs",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "further evaluation.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gingiva generally heals uneventfully.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 3
            }
          ]
        }
      }
