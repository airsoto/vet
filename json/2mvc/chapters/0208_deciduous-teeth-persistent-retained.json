            {
              "type": "bullet",
              "level": 0,
              "text": "Inform owners that you will be evaluating for exfoliation of deciduous teeth as well as for proper eruption of permanent teeth.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 2
            }
          ]
        },
        "SURGICAL CONSIDERATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "SURGICAL CONSIDERATIONS",
          "canonical_heading": "SURGICAL CONSIDERATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Extract the deciduous tooth as soon as the permanent tooth has erupted through the",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "gingiva.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pain management - local/regional",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "and systemic.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intraoral radiographs.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "General anesthesia with endotracheal tube",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "in place and cuff inflated.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Elevation of",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "deciduous tooth.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Careful, gentle elevation is critical; excessive force or pressure can damage the developing permanent tooth (and",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "other underlying structures).",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "A fractured or retained root may need to be removed with a",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "gingival flap.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If a permanent tooth has",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "erupted in an abnormal position, full root extraction of the deciduous tooth is necessary.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If the deciduous root has undergone resorption, it may not need to be extracted.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 3
            }
          ]
        },
