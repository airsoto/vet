            {
              "type": "subheading",
              "level": 0,
              "text": "General Comments",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Persistent deciduous teeth can cause the",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "permanent teeth to erupt in an abnormal",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "position resulting in a malocclusion; early",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "recognition and intervention are essential.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Maxillary canine teeth erupt mesial (rostral)",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "to the persistent deciduous canine teeth; this",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "can result in a diastema (space) between the",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "maxillary canine tooth and the third incisor",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "that is too narrow to accommodate the crown",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "zcanine position is referred to as mesiover-",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "sion.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mandibular canine teeth erupt",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "lingual to the persistent deciduous teeth; this",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "can result in a narrow space between the",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "lower canines resulting in impingement on",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "the soft tissue of the hard palate. The",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "mandibular canine position is referred to as",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "linguoversion.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "All permanent incisors",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "erupt lingual to the persistent deciduous",
