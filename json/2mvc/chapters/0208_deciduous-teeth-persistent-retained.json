          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "More common in dogs than cats.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "More common in small-breed dogs (e.g., Maltese, poodle, Yorkshire terrier, Pomeranian, etc.).",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Occurs during permanent tooth eruption phase, which begins at 3 months of age for incisors and 5–7 months of age for canine",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "teeth and molars.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Persistent deciduous teeth may not be detected or diagnosed until later",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "in life.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No sex predilection.",
              "pdf_page": 441,
              "printed_page": 359,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
