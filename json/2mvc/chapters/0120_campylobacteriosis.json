      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Campylobacter jejuni—fastidious, microaerophilic, Gram-negative curved bacteria; often isolated from healthy dogs and cats; may cause superficial erosive entero",
              "pdf_page": 288,
              "printed_page": 206,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "colitis.",
              "pdf_page": 288,
              "printed_page": 206,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infection—fecal–oral route from contaminated food, water, raw meat (especially chicken), environment; localized in crypts of intestine; motile; produces",
              "pdf_page": 288,
              "printed_page": 206,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "multiple enterotoxins.",
              "pdf_page": 288,
              "printed_page": 206,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Invasion of gut mucosa—hematochezia, inflammation, ulceration, edema; bacteria shed in feces for",
              "pdf_page": 288,
              "printed_page": 206,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "weeks to months.",
              "pdf_page": 288,
              "printed_page": 206,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Up to 49% of dogs without diarrhea and 45% of normal cats carryC. jejuniand shed it in feces.",
              "pdf_page": 288,
              "printed_page": 206,
              "column": 1
            }
          ]
        },
