              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prevalence— higher in puppies and kittens up to 6 months.",
              "pdf_page": 288,
              "printed_page": 206,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Can cause chronic disease.",
              "pdf_page": 288,
              "printed_page": 206,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
