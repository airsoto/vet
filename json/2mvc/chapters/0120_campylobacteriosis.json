          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Diarrhea—varies; mucoid and watery,",
              "pdf_page": 288,
              "printed_page": 206,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "hemorrhagic; may be chronic.",
              "pdf_page": 288,
              "printed_page": 206,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tenesmus.",
              "pdf_page": 288,
              "printed_page": 206,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fever, anorexia, intermittent vomiting",
              "pdf_page": 288,
              "printed_page": 206,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "possible.",
              "pdf_page": 288,
              "printed_page": 206,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Adults—may be asymptomatic",
              "pdf_page": 288,
              "printed_page": 206,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "carriers.",
              "pdf_page": 288,
