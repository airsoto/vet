  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "May occur as a separate entity or in association with gastric dilatation and volvulus (GDV) syndrome.",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute or chronic.",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pathophysiology—unknown.",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Systems affected—hemic/lymphatic/immune and cardiovascular.",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Isolated splenic torsion uncommon.",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 1
            }
          ]
        },
