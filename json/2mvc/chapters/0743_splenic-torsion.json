              "printed_page": 1278,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Elevated liver enzyme activities.",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pigmenturia/hemoglobinuria.",
              "pdf_page": 1360,
