          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other splenic disease (e.g., neoplasia, thrombosis, immune-mediated disease).",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute gastrointestinal disease with abdominal pain (acute abdomen).",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
