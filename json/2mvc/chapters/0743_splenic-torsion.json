        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Coagulation testing—prolongation of activated partial thromboplastin time",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(aPTT) or both prothrombin time (PT) and aPTT, with thrombocytopenia may indicate disseminated intravascular coagulation (DIC).",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 2
            }
          ]
        },
