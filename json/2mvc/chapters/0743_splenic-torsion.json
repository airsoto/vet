        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "More common in large-breed, deep-chested dogs, such as the German shepherd dog and Great Dane. English bulldogs are also predisposed.",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No sex predilection.",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute—cardiovascular collapse and",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "abdominal pain.",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic—intermittent anorexia, vomiting,",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "weight loss, and possibly hemoglobinuria.",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pale mucous membranes, tachycardia, weak",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "femoral pulses, other signs of hypoperfusion.",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Palpable abdominal mass (spleen).",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Irregular heart rate or dropped pulses if",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "arrhythmias present.",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Large-breed and deep-chested dogs.",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prior stretching of gastrosplenic, phrenico splenic, and splenocolic ligaments (e.g., prior GDV).",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Historical gastric dilatation.",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Excessive exercise, rolling, and retching may contribute.",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nervousness and anxiety have been associated with an increased risk of GDV but not of isolated splenic torsion.",
              "pdf_page": 1360,
              "printed_page": 1278,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
