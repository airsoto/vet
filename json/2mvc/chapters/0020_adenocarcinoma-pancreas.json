          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal radiographs may reveal a mass or loss of serosal detail associated with concurrent pancreatitis or peritoneal effusion.",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ultrasonography may reveal one or more",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Surgical biopsy—definitive.",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fine-needle aspirate cytology—supportive. In many cases, where the tumor is not resectable, the fine-needle aspirates may provide strong enough evidence to start",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 2
            }
          ]
        },
