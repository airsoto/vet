          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Malignant tumor of ductal or acinar origin arising from the exocrine pancreas.",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually metastatic by the time of diagnosis, affecting regional lymph nodes and visceral abdominal organs (liver) and associated peritoneal cavity.",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 1
            }
          ]
        },
