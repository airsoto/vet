            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Biliary obstruction peripancreatic fat). Pancreatic thickening,",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pancreatic abscess abdominal effusion, and single to multiple",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Peritonitis nodules of varying size may be identified.",
              "pdf_page": 116,
