        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Rare in dogs—0.5–1.8% of all tumors.",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rare in cats—2.8% of all tumors.",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Older female dogs and Airedale terriers at higher risk than others.",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Median age (dogs)—9.2 years.",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mean age (cats)—11.6 years.",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Nonspecific—fever; vomiting; weakness; anorexia; icterus; malabsorption syndrome; weight loss.",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal pain—variable.",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal effusion—malignant.",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metastasis to bone and soft tissue common.",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pathologic fractures secondary to metastasis reported.",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Palpable abdominal mass (cats).",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Paraneoplastic syndromes of epidermal necrosis, hyperinsulinemia, and hyperglucagonemia may be present.",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Average duration of clinical signs (cats): 41 days, range 2–180 days.",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 1
            }
          ]
        },
