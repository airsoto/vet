    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary pancreatitis; may be concurrent and complicate or delay early diagnosis.",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pancreatic pseudocyst.",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pancreatic nodular hyperplasia.",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hepatic neoplasia.",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other causes of vomiting and icterus.",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Peritoneal carcinomatosis.",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other causes of abdominal effusion in cats.",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually nonspecific changes (e.g., mild anemia and neutrophilia).",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperamylasemia less reliable than hyperlipasemia.",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lipase concentrations are often markedly elevated and may serve as a noninvasive biochemical marker of neoplasia in dogs.",
              "pdf_page": 116,
              "printed_page": 34,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
