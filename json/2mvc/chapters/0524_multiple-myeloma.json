              "type": "subheading",
              "level": 0,
              "text": "Dogs",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hemogram—nonregenerative anemia",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(66%); neutropenia (25%); thrombocytopenia",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "(33%).",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chemistry—hyperglobulinemia,",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hypercalcemia (10–25%), azotemia (33%).",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urinalysis: proteinuria, isosthenuria,",
