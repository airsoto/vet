        "CLIENT EDUCATION": {
          "present": true,
          "status": "content",
          "source_heading": "CLIENT EDUCATION",
          "canonical_heading": "CLIENT EDUCATION",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Inform client that chemotherapy is palliative",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "but long remissions are possible.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Warn",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "client that relapse will occur.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Discuss side effects, which depend on the drugs used.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            }
          ]
        },
        "SURGICAL CONSIDERATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "SURGICAL CONSIDERATIONS",
          "canonical_heading": "SURGICAL CONSIDERATIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Areas nonresponsive to chemotherapy or solitary lesions can be removed surgically.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Radiation Therapy",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Radiation therapy can be palliative and highly",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2,
              "subheading": "Radiation Therapy"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "effective for managing osteolytic bone cancer",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2,
              "subheading": "Radiation Therapy"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "pain. Indications include painful bone lesions,",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2,
              "subheading": "Radiation Therapy"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "spinal cord compression, pathologic fractures",
              "pdf_page": 993,
              "printed_page": 911,
