        "APPROPRIATE HEALTH CARE": {
          "present": true,
          "status": "content",
          "source_heading": "APPROPRIATE HEALTH CARE",
          "canonical_heading": "APPROPRIATE HEALTH CARE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Hospitalization if azotemia, hypercalcemia, bleeding disorder, or bacterial infection.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Plasmapheresis lowers protein burden—for symptomatic patient, withdraw a volume of venous blood, centrifuge, discard plasma, and return red blood cells to patient in IV crystalloid",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "fluids.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Phlebotomy for hyperviscosity; replace with an equal volume of isotonic fluids IV.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Always consult a veterinary oncologist for latest information regarding treatment.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            }
          ]
        },
