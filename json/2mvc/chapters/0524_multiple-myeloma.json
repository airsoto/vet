        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Improvement in clinical signs and laboratory abnormalities expected within",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "3–6 weeks.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Radiographic abnormalities could take longer and be partial.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 3
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Dogs",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Median survival with alkylating agent and",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 3,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "prednisone—18–30 months.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 3,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Overall",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 3,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "response rate >90%.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 3,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypercalcemia,",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 3,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "extensive bone lysis, or Bence-Jones",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 3,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "proteinuria may have shorter survival.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 3,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Death typically due to kidney failure,",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 3,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "secondary infections, or bone/spinal pain.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 3,
              "subheading": "Dogs"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Cats",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Survival with alkylating agents and",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 3,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "prednisone—2–9 months.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 3,
              "subheading": "Cats"
            }
          ]
        }
