          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "CBC and chemistry every 2 weeks for 2",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "months, then monthly.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Serum electro phoresis and/or Bence Jones proteinuria monthly until at least 50% decrease in baseline values, then once every 2–3 months.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 3
            }
          ]
        },
