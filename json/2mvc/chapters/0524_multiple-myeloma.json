      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Defined as malignant plasma cells in the",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "bone marrow.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diagnosis requires documen tation of bone marrow plasmacytosis, osteolytic bone lesions, and serum or urine myeloma proteins (M-component).",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Proliferation of malignant plasma cells that produce immunoglobulins or subunits.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Immunoglobulins may polymerize and",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "increase serum viscosity.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bleeding disorders due to paraprotein coating of platelets, thrombocytopenia, hyperviscosity, or interference with coagulation factors.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nephrotoxicity due to protein deposition of amyloid or direct effect of the protein on",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "renal tubular epithelial cells.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypercalcemia due to osteoclast activation and bone lysis.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1
            }
          ]
        },
        "SYSTEMS AFFECTED": {
          "present": true,
          "status": "content",
          "source_heading": "SYSTEMS AFFECTED",
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Musculoskeletal—multiple punctate areas of bone lysis in the absence of bony proliferation.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nervous, cardiovascular, and respiratory— abnormalities secondary to hyperviscosity.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Soft tissues—neoplastic infiltration.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1
            }
          ]
        },
        "GENETICS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GENETICS",
          "content_blocks": []
        },
        "INCIDENCE/PREVALENCE": {
          "present": true,
          "status": "content",
          "source_heading": "INCIDENCE/PREVALENCE",
          "canonical_heading": "INCIDENCE/PREVALENCE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—1% of all malignancies; <8% of hematopoietic malignancies; 3.6% of all bone",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "tumors.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—<1% of hematopoietic tumors.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1
            }
          ]
        },
        "GEOGRAPHIC DISTRIBUTION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GEOGRAPHIC DISTRIBUTION",
          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Dogs and cats; 6–13 years.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Due to bone infiltration and lysis, immuno globulins produced, and infiltration of organ(s).",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Dogs",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lethargy, weakness (62%).",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lameness",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "(47%).",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bleeding diathesis (37%): gingiva",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "and epistaxis.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Funduscopic abnormalities",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "including retinal hemorrhage or detachment",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and tortuous vessels (35%).",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Cats",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Anorexia, weight loss, malaise, polydipsia,",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "polyuria.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 1,
              "subheading": "Cats"
            }
          ]
        },
