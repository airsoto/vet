        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Serum protein electrophoresis— monoclonal gammopathy in the beta or gamma region, and occasionally a biclonal",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "gammopathy will be present.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urine protein electrophoresis—Bence-Jones proteins in",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "25–40%.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Coagulation profile—∼50% will have abnormal coagulation values.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Radiography (dogs)—25–66% have multifocal, lytic lesions or diffuse osteoporosis.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Radiography (cats)—bony lesions rare, more common for visceral organ infiltration (myeloma-",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "related disorder).",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ultrasonography—detect changes in visceral organs.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Diagnosis depends on identifying at least 3",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "of 4 pathologies:",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Monoclonal gammopathy.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Lytic bone lesions.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Bence Jones proteinuria.",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Bone marrow cytology:>20% plasma cells",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "or>5% malignant plasma cells. • For cats—",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "bone marrow involvement is rare, and hence",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2,
              "subheading": "or>5% malignant plasma cells. • For cats—"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "diagnosis is based upon the identification of",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2,
              "subheading": "or>5% malignant plasma cells. • For cats—"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "malignant plasma cells within the visceral",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2,
              "subheading": "or>5% malignant plasma cells. • For cats—"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "organs (myeloma-related disorder).",
              "pdf_page": 993,
              "printed_page": 911,
              "column": 2,
              "subheading": "or>5% malignant plasma cells. • For cats—"
            }
          ]
        },
