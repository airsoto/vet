  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Infection with the protozoanCytauxzoon felis.",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affects vascular system of lungs, liver, spleen, kidneys, and brain; bone marrow and developmental stages of red blood cells (RBCs) affected as well.",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Uncommon in most regions, but common during the spring and summer in endemic regions.",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affects feral and domestic cats in southcentral, southeastern, and mid-Atlantic United States; range appears to be expanding towards eastern and northeastern United States.",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "RelatedCytauxzoonspp. have been identified in Europe and Asia, but have not been associated with classic Cytauxzoonosis (see Signs) as seen in North America.",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 1
            }
          ]
        },
