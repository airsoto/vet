        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Domestic cats of all ages.",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Wild felids are also at risk.",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No breed or sex predilection, although most cases are diagnosed in young cats that have access to outdoors.",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Most cats have severe illness at presentation.",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pale mucous membranes.",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Depression.",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anorexia.",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dehydration.",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "High fever.",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Icterus.",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Splenomegaly.",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hepatomegaly.",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Some cats may be infected but asymptomatic.",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "PCR assay is commercially available.",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Without treatment, most cats with acute",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Blood type in all cats prior to transfusion. cytauxzoonosis have died within 5 days of",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 2
            }
          ]
        },
