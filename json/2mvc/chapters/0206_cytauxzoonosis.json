    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other causes of pancytopenia such as sepsis and panleukopenia.",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other causes of fever and jaundice such as pancreatitis, hepatitis, and cholangitis.",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Bicytopenia or pancytopenia are the most common findings; thrombocytopenia is almost always present.",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Moderate hyperbilirubinemia and bilirubinuria.",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mild hyperglycemia.",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If present, anemia is believed to be secondary to hemolysis.",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
