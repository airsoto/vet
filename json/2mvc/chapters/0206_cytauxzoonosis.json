          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Bite of infected tick (primarilyAmblyomma americanumorDermacentor variabilis).",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Roaming in areas shared by reservoir hosts (bobcats).",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Living in same household/region as cat diagnosed with cytauxzoonosis.",
              "pdf_page": 438,
              "printed_page": 356,
              "column": 1
            }
          ]
        }
