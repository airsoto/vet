              "printed_page": 171,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prognosis depends on dose ingested and response to therapy, but generally good.",
              "pdf_page": 253,
              "printed_page": 171,
              "column": 3
            }
          ]
        }
