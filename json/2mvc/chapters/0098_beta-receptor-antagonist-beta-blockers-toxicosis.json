          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ingestion of immediate release preparations typically result in clinical signs in 6 hours.",
              "pdf_page": 253,
              "printed_page": 171,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sustained release (SR) or ER preparations may take 12–24 hours for clinical signs to develop.",
