    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Emesis if asymptomatic and recent ingestion (<2 hours).",
          "pdf_page": 253,
          "printed_page": 171,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Consider gastric lavage if decreased mental status and large number of pills ingested.",
          "pdf_page": 253,
          "printed_page": 171,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Volume resuscitation with IV fluid bolus over 15–20 minutes for hypotension—cats, 10–20 mL/kg for cats; dogs, 20–30 mL/kg.",
          "pdf_page": 253,
          "printed_page": 171,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Consider temporary cardiac pacing and hemodialysis (drug removal) in severe intoxications.",
          "pdf_page": 253,
          "printed_page": 171,
          "column": 2
        }
      ],
