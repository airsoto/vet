      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Beta receptor antagonists—class II antidysrhythmics used to treat hypertrophic or hypertrophic obstructive cardiomyopathy in cats and hypertension and tachydysrhythmias in dogs and cats.",
              "pdf_page": 253,
              "printed_page": 171,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "β1receptors—primarily located in heart, eye, and kidney.",
              "pdf_page": 253,
              "printed_page": 171,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "β2receptors—primarily located in bronchial smooth muscle, gastrointestinal tract, pancreas, liver, skeletal muscle, vascular smooth muscle, and endothelium.",
              "pdf_page": 253,
              "printed_page": 171,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Systems affected include:",
              "pdf_page": 253,
              "printed_page": 171,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Cardiovascular—bradycardia, hypotension.",
              "pdf_page": 253,
              "printed_page": 171,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Respiratory—bronchospasm.",
              "pdf_page": 253,
              "printed_page": 171,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Nervous—decreased mentation, seizures.",
              "pdf_page": 253,
              "printed_page": 171,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Endocrine/metabolic—hypoglycemia,",
              "pdf_page": 253,
              "printed_page": 171,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "metabolic acidosis secondary to hypoperfusion.",
              "pdf_page": 253,
              "printed_page": 171,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Renal/urologic—acute kidney injury",
              "pdf_page": 253,
              "printed_page": 171,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "secondary to prolonged hypoperfusion.",
              "pdf_page": 253,
              "printed_page": 171,
              "column": 1
            }
          ]
        },
