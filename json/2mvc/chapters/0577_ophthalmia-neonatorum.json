    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Warm compresses—may be necessary for a few days to keep the eyelids from readhering.",
              "pdf_page": 1077,
              "printed_page": 995,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Topical antibiotics—continued for a minimum of 7 days.",
              "pdf_page": 1077,
              "printed_page": 995,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Observe littermates that are not initially affected.",
              "pdf_page": 1077,
              "printed_page": 995,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Treat vaginal infections in the dam with appropriate medications.",
              "pdf_page": 1077,
              "printed_page": 995,
              "column": 2
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Keep the external environment and the dam’s nipples clean.",
              "pdf_page": 1077,
              "printed_page": 995,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Treat vaginal infection in the dam before delivery, if possible.",
              "pdf_page": 1077,
              "printed_page": 995,
              "column": 2
            }
          ]
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Severe keratitis with scarring and symblepharon.",
              "pdf_page": 1077,
              "printed_page": 995,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rupture of the cornea with secondary phthisis; blindness may be irreversible.",
              "pdf_page": 1077,
              "printed_page": 995,
              "column": 2
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Favorable with correct and timely diagnosis and treatment and if no major complications occur.",
              "pdf_page": 1077,
              "printed_page": 995,
              "column": 3
            }
          ]
        }
