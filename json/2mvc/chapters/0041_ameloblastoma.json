        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dental radiographs may show bone lysis deep to the superficial mass. Not particularly useful for diagnostic or treatment planning.",
              "pdf_page": 153,
              "printed_page": 71,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Regional and distant metastasis has not been described.",
              "pdf_page": 153,
              "printed_page": 71,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CT is ideal for planning surgery or radiation therapy, especially in large or caudal tumors.",
              "pdf_page": 153,
              "printed_page": 71,
              "column": 1
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Deep tissue biopsies are necessary and recommended for definitive diagnosis.",
              "pdf_page": 153,
              "printed_page": 71,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Squamous cell carcinoma may be misdiagnosed as ameloblastoma.",
              "pdf_page": 153,
              "printed_page": 71,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
