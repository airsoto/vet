      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Common oral tumor of odontogenic (tooth structure) ectoderm origin.",
              "pdf_page": 153,
              "printed_page": 71,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Biologically these tumors are benign histologically, but possess locally invasive properties.",
              "pdf_page": 153,
              "printed_page": 71,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tumors may arise anywhere within the dental arcade.",
              "pdf_page": 153,
              "printed_page": 71,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Several histologic subtypes exist with similar invasive behavior.",
              "pdf_page": 153,
              "printed_page": 71,
              "column": 1
            }
          ]
        },
