        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Middle-aged and old dogs.",
              "pdf_page": 153,
              "printed_page": 71,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rare in cats.",
              "pdf_page": 153,
              "printed_page": 71,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs may present with a smooth, firm, gingival mass that is usually nonulcerated.",
              "pdf_page": 153,
              "printed_page": 71,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May be incidental finding during dental prophylaxis/procedures. If involving rostral dental arcade, incisor teeth can be displaced and enveloped by proliferative tissue.",
              "pdf_page": 153,
              "printed_page": 71,
              "column": 1
            }
          ]
        },
