    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgical excision such as hemi- or total mandibulectomy or maxillectomy with",
          "pdf_page": 153,
          "printed_page": 71,
          "column": 2
        },
        {
          "type": "subheading",
          "level": 0,
          "text": ">1–2 cm margins is recommended as a",
          "pdf_page": 153,
          "printed_page": 71,
          "column": 2
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "curative treatment option. Always submit",
          "pdf_page": 153,
          "printed_page": 71,
          "column": 2,
          "subheading": ">1–2 cm margins is recommended as a"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "resected tissue for histopathology, in order to",
          "pdf_page": 153,
          "printed_page": 71,
          "column": 2,
          "subheading": ">1–2 cm margins is recommended as a"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "confirm the original diagnosis, and evaluate",
          "pdf_page": 153,
          "printed_page": 71,
          "column": 2,
          "subheading": ">1–2 cm margins is recommended as a"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "soft tissue and bone margins.",
          "pdf_page": 153,
          "printed_page": 71,
          "column": 2,
          "subheading": ">1–2 cm margins is recommended as a"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Radiation therapy may provide long-term",
          "pdf_page": 153,
          "printed_page": 71,
          "column": 2,
          "subheading": ">1–2 cm margins is recommended as a"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "control in large tumors, or when owners",
          "pdf_page": 153,
          "printed_page": 71,
          "column": 2,
          "subheading": ">1–2 cm margins is recommended as a"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "decline surgery.",
          "pdf_page": 153,
          "printed_page": 71,
          "column": 2,
          "subheading": ">1–2 cm margins is recommended as a"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Intralesional chemotherapy with bleomycin",
          "pdf_page": 153,
          "printed_page": 71,
          "column": 2,
          "subheading": ">1–2 cm margins is recommended as a"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "has been reported, but results are generally",
          "pdf_page": 153,
          "printed_page": 71,
          "column": 2,
          "subheading": ">1–2 cm margins is recommended as a"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "inferior to those of surgery or radiation.",
          "pdf_page": 153,
          "printed_page": 71,
          "column": 2,
          "subheading": ">1–2 cm margins is recommended as a"
        }
      ],
