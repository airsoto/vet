              "printed_page": 357,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Use of ototoxic drugs, recent anesthesia, or chronic ear disease—suggests acquired causes.",
              "pdf_page": 439,
              "printed_page": 357,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Evaluate for brain disease.",
              "pdf_page": 439,
              "printed_page": 357,
              "column": 3
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Usually normal.",
              "pdf_page": 439,
              "printed_page": 357,
              "column": 3
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
