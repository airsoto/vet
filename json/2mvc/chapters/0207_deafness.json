        "SURGICAL CONSIDERATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "SURGICAL CONSIDERATIONS",
          "canonical_heading": "SURGICAL CONSIDERATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Directed toward acquired causes; congenital deafness irreversible.",
              "pdf_page": 440,
              "printed_page": 358,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Otitis externa, media, or interna—medical or surgical approaches depend on culture and sensitivity test results, response to antibiotics, and imaging findings. Conduction may improve as otitis externa or media resolves.",
              "pdf_page": 440,
              "printed_page": 358,
              "column": 1
            }
          ]
        },
