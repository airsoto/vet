        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog—any breed; West Highland white terrier, poodle, basset hound, cocker spaniel, and dachshund predisposed.",
              "pdf_page": 942,
              "printed_page": 860,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cat—less common; associated with internal neoplasia in aged cats; affects all breeds; young Rex cats predisposed.",
              "pdf_page": 942,
              "printed_page": 860,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Pruritus variable; erythema, alopecia, scale, and greasiness of lips, ears, feet, axillae, inguinal area, and ventral neck; malodor.",
              "pdf_page": 942,
              "printed_page": 860,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperpigmentation and lichenification— chronic cases.",
              "pdf_page": 942,
              "printed_page": 860,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Concurrent black waxy to seborrheic otitis—frequent.",
              "pdf_page": 942,
              "printed_page": 860,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Frenzied facial pruritus—uncommon but characteristic.",
              "pdf_page": 942,
              "printed_page": 860,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Often an allergy history that worsens and develops glucocorticoid tachyphylaxis.",
              "pdf_page": 942,
              "printed_page": 860,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Concurrent bacterial folliculitis, hypersensitivity, endocrine and seborrheic dermatitis.",
              "pdf_page": 942,
              "printed_page": 860,
              "column": 1
            }
          ]
        },
