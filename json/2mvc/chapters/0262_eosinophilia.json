  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Eosinophilia refers to an increased number of circulating eosinophils.",
              "pdf_page": 532,
              "printed_page": 450,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reference intervals may be difficult to accurately determine, as numbers do not tend to have normal (Gaussian) distribution. Absolute counts >1.5 x 103/μl often indicate clinically significant eosinophilia.",
              "pdf_page": 532,
              "printed_page": 450,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diseases associated with eosinophilia are highly variable. However, they often involve those causing release of cytokines including IL-5, IL-2, IL-3, and/or GM-CSF.",
              "pdf_page": 532,
              "printed_page": 450,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prevalence varies; 4.8% of cats and 10% of dogs have been identified with eosinophilia in large retrospective studies.",
              "pdf_page": 532,
              "printed_page": 450,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
