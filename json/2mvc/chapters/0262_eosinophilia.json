        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Breed and sex predilections are directly correlated to the characteristics of specific diseases.",
              "pdf_page": 532,
              "printed_page": 450,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rottweilers and German shepherd dogs show the highest overall prevalence of eosinophilia.",
              "pdf_page": 532,
              "printed_page": 450,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical signs directly associated with eosinophilia per se are lacking.",
              "pdf_page": 532,
              "printed_page": 450,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Specific clinical signs are dependent on the disease causing the eosinophilia.",
              "pdf_page": 532,
              "printed_page": 450,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Diseases associated with eosinophilia are widely variable and can be categorized in many ways.",
              "pdf_page": 532,
              "printed_page": 450,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infectious diseases typically involve tissues rather than peripheral blood, and are more likely to be parasitic than bacterial.",
              "pdf_page": 532,
              "printed_page": 450,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tissues involved are frequently those that contain abundant mast cells, such as skin, lungs, and intestine, and often involve hypersensitivity.",
              "pdf_page": 532,
              "printed_page": 450,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metabolic—hypoadrenocortisim.",
              "pdf_page": 532,
              "printed_page": 450,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neoplastic—mast cell tumor; eosinophilic leukemia; lymphoma (both T-cell and B-cell); thymoma; mammary carcinoma; oral fibrosarcoma; transitional cell carcinoma.",
              "pdf_page": 532,
              "printed_page": 450,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Immune mediated—hypereosinophilic syndrome (HES); idiopathic HES in Rottweilers; feline asthma; eosinophilic bronchopneumopathy; feline gastro intestinal eosinophilic sclerosing fibroplasia; flea bite allergy; eosinophilic granuloma complex.",
              "pdf_page": 532,
              "printed_page": 450,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infectious—Angiostrongylus vasorum; heartworm disease (Dirofilaria immitis); Ehrlichiaspp. infections;Anaplasmaspp. infections; histoplasmosis; sarcocytosis;",
              "pdf_page": 532,
              "printed_page": 450,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Aelurostrongylusspp.; larval migration of",
              "pdf_page": 532,
              "printed_page": 450,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "various parasites.",
              "pdf_page": 532,
              "printed_page": 450,
              "column": 1,
              "subheading": "Aelurostrongylusspp.; larval migration of"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Toxic methimazole therapy.",
              "pdf_page": 532,
              "printed_page": 450,
              "column": 1,
              "subheading": "Aelurostrongylusspp.; larval migration of"
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "paragraph",
          "level": 0,
          "text": "Dependent on cause.",
          "pdf_page": 532,
          "printed_page": 450,
          "column": 2
        }
      ],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "HES represents an idiopathic response that may be due to an occult immunologic stimulus.",
              "pdf_page": 532,
              "printed_page": 450,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Eosinophilic leukemia is a myeloproliferative disease that often has immature forms in circulation and in the bone marrow. Dependent on cause.",
              "pdf_page": 532,
              "printed_page": 450,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Differentiation between HES and eosinophilic leukemia can be extremely difficult and is somewhat controversial.",
              "pdf_page": 532,
              "printed_page": 450,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Caution should be taken in interpreting the results of some in-house hematology",
              "pdf_page": 532,
