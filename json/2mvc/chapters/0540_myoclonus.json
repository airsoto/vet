        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "MRI—may help determine diagnosis in acute acquired disease.",
              "pdf_page": 1019,
              "printed_page": 937,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Acute onset—CSF analysis, serologic testing, imaging to determine the cause if other physical or neurologic signs present. Electroencephalography and electromyo graphy—may help differentiate myoclonic epilepsy and peripheral nervous system disease from myoclonus.",
              "pdf_page": 1019,
              "printed_page": 937,
              "column": 3
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": []
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Active encephalomyelitis—inpatient; establish a diagnosis and initiate treatment.",
          "pdf_page": 1019,
          "printed_page": 937,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Exercise—as tolerated.",
          "pdf_page": 1019,
          "printed_page": 937,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Diet—ensure proper nutrition with active CNS disease; modify, if necessary, with vomiting or",
          "pdf_page": 1019,
          "printed_page": 937,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "diarrhea.",
          "pdf_page": 1019,
          "printed_page": 937,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Familial reflex myoclonus— clinical signs in Labrador retriever and Dalmatian are severe and usually not compatible with quality of life.",
          "pdf_page": 1019,
          "printed_page": 937,
          "column": 3
        }
      ],
