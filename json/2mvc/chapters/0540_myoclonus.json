    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "With chronic, inactive canine distemper— treatment often unnecessary; alleviation may be obtained with procainamide 125–250 mg/",
              "pdf_page": 1019,
              "printed_page": 937,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "dog PO q6–12h.",
              "pdf_page": 1019,
              "printed_page": 937,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gabapentin 10–20 mg/kg q8h reported beneficial in tremor syndrome.",
              "pdf_page": 1019,
              "printed_page": 937,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Clorazepate 0.6–2 mg/kg PO q8h—familial reflex myoclonus; may see improvement.",
              "pdf_page": 1019,
              "printed_page": 937,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Active encephalomyelitis—treat accordingly.",
              "pdf_page": 1019,
              "printed_page": 937,
              "column": 3
            }
          ]
        },
