    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Monitor CNS disease.",
          "pdf_page": 1019,
          "printed_page": 937,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Myoclonus usually persists indefinitely; spontaneous remission",
          "pdf_page": 1019,
          "printed_page": 937,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "may occur.",
          "pdf_page": 1019,
          "printed_page": 937,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Active distemper virus infection—",
          "pdf_page": 1019,
          "printed_page": 937,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "poor-to-grave prognosis.",
          "pdf_page": 1019,
          "printed_page": 937,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Chronic distemper—myoclonus persists but patient otherwise healthy.",
          "pdf_page": 1019,
          "printed_page": 937,
          "column": 3
        }
