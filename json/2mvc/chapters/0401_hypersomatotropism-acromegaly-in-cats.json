        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Median age—11 years (range: 9.5–13 years).",
              "pdf_page": 782,
              "printed_page": 700,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Male : female ratio is 2 : 1.",
              "pdf_page": 782,
              "printed_page": 700,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No breed predisposition.",
              "pdf_page": 782,
              "printed_page": 700,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical signs of diabetes mellitus (DM; e.g., polyuria, polydipsia, and polyphagia) occur from GH-induced IR. IR can be variable or persistent, which makes the DM difficult to control.",
              "pdf_page": 782,
              "printed_page": 700,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Many (~40%) diabetics with hypersomato tropism (HST) lose weight due to poorly controlled DM; a small proportion (~17%) gain weight.",
              "pdf_page": 782,
              "printed_page": 700,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anabolic state—patients may present with polyphagia (without DM), or soft tissue growth resulting in upper airway obstruction, broad facial features, or clubbed feet.",
              "pdf_page": 782,
              "printed_page": 700,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "A small proportion (~2%) develop neurologic signs due to pituitary adenoma.",
              "pdf_page": 782,
              "printed_page": 700,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "GH-secreting pituitary adenoma or somatotroph hyperplasia.",
              "pdf_page": 782,
              "printed_page": 700,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In dogs, but not cats, progestins can result in increased GH concentration.",
              "pdf_page": 782,
              "printed_page": 700,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Uncomplicated DM.",
              "pdf_page": 782,
              "printed_page": 700,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pituitary-dependent hyperadrenocorticism.",
              "pdf_page": 782,
              "printed_page": 700,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Causes of polyphagia such as exocrine pancreatic insufficiency, gastrointestinal inflammatory diseases, hyperthyroidism, and inflammatory liver diseases. Cats with HST and polyphagia but without DM typically gain weight, unlike other differentials.",
              "pdf_page": 782,
              "printed_page": 700,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
