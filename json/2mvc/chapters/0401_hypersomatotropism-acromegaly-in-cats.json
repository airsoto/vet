  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Caused by excessive growth hormone (GH) secretion from the anterior pituitary by an adenoma or somatotroph hyperplasia.",
              "pdf_page": 782,
              "printed_page": 700,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "GH induces hepatic insulin-like growth factor-1 (IGF-1) secretion. The combination of increased GH and IGF-1 causes lipolysis, protein synthesis, impaired carbohydrate metabolism, and insulin resistance (IR).",
              "pdf_page": 782,
              "printed_page": 700,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prevalence in Europe ranges from 1 : 3 to 1 : 5.5 diabetic cats.",
              "pdf_page": 782,
              "printed_page": 700,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
