        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Serum IGF-1 concentration using validated assays is test of choice.",
              "pdf_page": 782,
              "printed_page": 700,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Positive predictive value of IGF-1",
              "pdf_page": 782,
              "printed_page": 700,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": ">1000 ng/mL (131 nmol/L) of 95%.",
              "pdf_page": 782,
              "printed_page": 700,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Roughly one-third of cats with HST have",
              "pdf_page": 782,
              "printed_page": 700,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "a low IGF-1 at diagnosis, which increases to >1000 ng/mL after insulin therapy.",
              "pdf_page": 782,
              "printed_page": 700,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "IGF-1 concentrations between 700 and",
              "pdf_page": 782,
              "printed_page": 700,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "See Medical Management. 1000 ng/mL (92–131 nmol/L) is a “gray” zone—many non-HST diabetic cats are in this range.",
              "pdf_page": 782,
              "printed_page": 700,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "There is no commercially available GH assay.",
              "pdf_page": 782,
              "printed_page": 700,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Depends on treatment modality.",
              "pdf_page": 782,
              "printed_page": 700,
              "column": 2
            }
          ]
        },
