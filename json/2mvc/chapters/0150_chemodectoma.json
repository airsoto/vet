    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "paragraph",
          "level": 0,
          "text": "It is not recommended to breed animals with",
          "pdf_page": 338,
          "printed_page": 256,
          "column": 2
        },
        {
          "type": "subheading",
          "level": 0,
          "text": "Aortic Body Tumors",
          "pdf_page": 338,
          "printed_page": 256,
          "column": 2
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "cancer. Chemotherapy is teratogenic—do not",
          "pdf_page": 338,
          "printed_page": 256,
          "column": 2,
          "subheading": "Aortic Body Tumors"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgical removal of mass—if possible.",
          "pdf_page": 338,
          "printed_page": 256,
          "column": 2,
          "subheading": "Aortic Body Tumors"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "give to pregnant animals.",
          "pdf_page": 338,
          "printed_page": 256,
          "column": 2,
          "subheading": "Aortic Body Tumors"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Subphrenic pericardectomy has been shown",
