        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Chronic hypoxia may play a role in the development of this disease in brachycephalic breeds.",
              "pdf_page": 338,
              "printed_page": 256,
              "column": 1
            }
          ]
        }
      }
    },
