      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Chemodectomas are tumors arising from the chemoreceptor cells (such as in the aortic body and the carotid body).",
              "pdf_page": 338,
              "printed_page": 256,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other names—aortic body tumors, cardiac paraganglioma, APUDoma (amine precursor uptake decarboxylase), and glomus body tumor.",
              "pdf_page": 338,
              "printed_page": 256,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Aortic body tumors more common (80–90%) in dogs than carotid body tumors (10–20%).",
              "pdf_page": 338,
              "printed_page": 256,
              "column": 1
            }
          ]
        },
