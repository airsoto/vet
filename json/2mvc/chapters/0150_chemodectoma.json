        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Rare in cats.",
              "pdf_page": 338,
              "printed_page": 256,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—age 6–15 years.",
              "pdf_page": 338,
              "printed_page": 256,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Any breeds—but brachycephalic breeds predisposed, especially boxers, Boston terriers, English bulldogs, and German shepherd dogs.",
              "pdf_page": 338,
              "printed_page": 256,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Males predisposed for aortic body tumors; no sex predilection for carotid body tumors.",
              "pdf_page": 338,
              "printed_page": 256,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Nonspecific and dependent upon tumor size and anatomic localization, and can include lethargy, anorexia, weakness, collapse, coughing, respiratory distress, exercise intolerance, distended abdomen, vomiting, sudden death.",
              "pdf_page": 338,
              "printed_page": 256,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Carotid body tumor—may notice neck mass, regurgitation, dyspnea, Horner’s syndrome, head tilt, facial nerve paralysis, or laryngeal paralysis.",
              "pdf_page": 338,
              "printed_page": 256,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May be associated with pericardial effusion and cardiac tamponade—muffled heart sounds, poor pulses, tachycardia, tachypnea, weak pulses, slow capillary refill time, ascites.",
              "pdf_page": 338,
              "printed_page": 256,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May be associated with cranial vena cava syndrome (edema of head, neck, and forelimbs).",
              "pdf_page": 338,
              "printed_page": 256,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May be associated with ascites secondary to right heart failure.",
              "pdf_page": 338,
              "printed_page": 256,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May be associated with pleural effusion— decreased lung sounds ventrally, cyanosis.",
              "pdf_page": 338,
              "printed_page": 256,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cardiac arrhythmias with pulse deficits.",
              "pdf_page": 338,
              "printed_page": 256,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
