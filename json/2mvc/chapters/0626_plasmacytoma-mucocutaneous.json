          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Excellent in most patients.",
              "pdf_page": 1163,
              "printed_page": 1081,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Long-term survival expected for GI EMP treated with surgery ± chemotherapy.",
              "pdf_page": 1163,
              "printed_page": 1081,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reported 15-month median survival time for colorectal form with surgery alone.",
              "pdf_page": 1163,
              "printed_page": 1081,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "5% local recurrence rate with conservative surgery for the majority of EMP.",
              "pdf_page": 1163,
              "printed_page": 1081,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metastasis reported in 2% of patients with EMP.",
              "pdf_page": 1163,
              "printed_page": 1081,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "2% of patients will developde novoEMP.",
              "pdf_page": 1163,
              "printed_page": 1081,
              "column": 2
