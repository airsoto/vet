              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Poorly differentiated carcinoma.",
              "pdf_page": 1163,
              "printed_page": 1081,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Amelanotic melanoma.",
              "pdf_page": 1163,
              "printed_page": 1081,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
