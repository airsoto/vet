      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Tumor of plasma cell origin.",
              "pdf_page": 1163,
              "printed_page": 1081,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Typically benign and local therapy can be curative.",
              "pdf_page": 1163,
              "printed_page": 1081,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rarely (<1%) part of multiple myeloma process.",
              "pdf_page": 1163,
              "printed_page": 1081,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gastrointestinal extramedullary plasma cytoma (GI EMP) may be more aggressive.",
              "pdf_page": 1163,
              "printed_page": 1081,
              "column": 1
            }
          ]
        },
