        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Bone marrow aspirate cytology and serum electrophoresis may be indicated for GI EMP.",
              "pdf_page": 1163,
              "printed_page": 1081,
              "column": 1
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Colonoscopy recommended for colorectal EMP.",
              "pdf_page": 1163,
              "printed_page": 1081,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiographs and abdominal ultrasound may be indicated for GI EMP.",
              "pdf_page": 1163,
              "printed_page": 1081,
              "column": 1
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytologic examination of fine-needle aspirate reveals moderate to marked cellularity with round to polyhedral individual tumor cells with discrete margins, abundant royal blue cytoplasm, paranuclear clear zone, eccentric round nucleus, and clumped chromatin. Multinuclearity is common.",
              "pdf_page": 1163,
              "printed_page": 1081,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Histologic evaluation—classified into mature, hyaline, cleaved, asynchronous, monomorphous blastic, and polymorphous blastic cell types. However, no prognostic",
              "pdf_page": 1163,
              "printed_page": 1081,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "significance has been associated with this classification.",
              "pdf_page": 1163,
              "printed_page": 1081,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Immunohistochemistry may be necessary to distinguish from other neoplasms.",
              "pdf_page": 1163,
              "printed_page": 1081,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
