        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog, rarely cat.",
              "pdf_page": 1163,
              "printed_page": 1081,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cocker spaniel, West Highland white terrier, boxer, German shepherd dog, Airedale.",
              "pdf_page": 1163,
              "printed_page": 1081,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Median age 9–10 years.",
              "pdf_page": 1163,
              "printed_page": 1081,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "86% are cutaneous, 9% affect mucous membranes, 4% colorectal, 1% noncutaneous/non-oral.",
              "pdf_page": 1163,
              "printed_page": 1081,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Solitary, smooth, raised pink nodules, typically 1–2 cm in diameter.",
              "pdf_page": 1163,
              "printed_page": 1081,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bleeding, hematochezia, tenesmus, rectal prolapse if colorectal form.",
              "pdf_page": 1163,
              "printed_page": 1081,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vague, nonspecific signs if GI EMP.",
              "pdf_page": 1163,
              "printed_page": 1081,
              "column": 1
            }
          ]
        },
