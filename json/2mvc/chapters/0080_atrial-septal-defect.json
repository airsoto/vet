            {
              "type": "bullet",
              "level": 0,
              "text": "Congenital defect in which interatrial septum fails to develop normally, resulting in communication between atria. Unknown cause; genetic basis suspected. Acquired atrial septal defects (ASD) secondary to atrial rupture reported with canine degenerative mitral valve disease.",
              "pdf_page": 223,
              "printed_page": 141,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Comprises 0.7–3.7% of congenital heart",
              "pdf_page": 223,
              "printed_page": 141,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "defects in dogs,<10% of congenital heart",
              "pdf_page": 223,
              "printed_page": 141,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "defects in cats. Significantly higher incidence",
              "pdf_page": 223,
              "printed_page": 141,
              "column": 1,
              "subheading": "defects in dogs,<10% of congenital heart"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "(37.7%) noted in one study.",
              "pdf_page": 223,
              "printed_page": 141,
              "column": 1,
              "subheading": "defects in dogs,<10% of congenital heart"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Three major",
              "pdf_page": 223,
              "printed_page": 141,
              "column": 1,
              "subheading": "defects in dogs,<10% of congenital heart"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "types of ASD classified based on the location",
              "pdf_page": 223,
              "printed_page": 141,
              "column": 1,
              "subheading": "defects in dogs,<10% of congenital heart"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "of the defect within the interatrial septum—",
              "pdf_page": 223,
              "printed_page": 141,
              "column": 1,
              "subheading": "defects in dogs,<10% of congenital heart"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "ostium primum ASD (most apical portion of",
