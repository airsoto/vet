        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Most dogs develop arrhythmias at approximately 12 weeks of age (identified as young as 6 weeks). Number and severity of arrhythmias tend to peak between 5–9 months. By approximately 18–24 months most dogs have only a few arrhythmias.",
              "pdf_page": 1486,
              "printed_page": 1404,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No sex predilection.",
              "pdf_page": 1486,
              "printed_page": 1404,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Signs are very rare (e.g., in >500 dogs examined only 1 had syncope) since VT is often nonsustained until, in some dogs, it degenerates into ventricular fibrillation resulting in death (usually between 5 and 9 months of age).",
              "pdf_page": 1486,
              "printed_page": 1404,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Arrhythmias often detected during routine",
              "pdf_page": 1486,
              "printed_page": 1404,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "examination before neutering.",
              "pdf_page": 1486,
              "printed_page": 1404,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Death is associated with sleep, rest after exercise, or excitement after sleep, particularly in early morning.",
              "pdf_page": 1486,
              "printed_page": 1404,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Genetic mutation(s) responsible has not",
              "pdf_page": 1486,
              "printed_page": 1404,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "been identified.",
              "pdf_page": 1486,
              "printed_page": 1404,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Multiple electrophysiologic abnormalities have been identified—early and delayed afterdepolarizations, heterogeneous and altered action potential duration, as well as changes in ion channel current density, calcium cycling, and sympathetic innervation.",
              "pdf_page": 1486,
              "printed_page": 1404,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "VT tends to be most frequent with slow heart rates (drug-induced [e.g. fentanyl] or during sleep).",
              "pdf_page": 1486,
              "printed_page": 1404,
              "column": 1
            }
          ]
        }
      }
    },
