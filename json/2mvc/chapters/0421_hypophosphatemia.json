    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Prevention is preferred.",
          "pdf_page": 821,
          "printed_page": 739,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Asymptomatic patients with low (1.5–2.5 mg/dL), but not depleted, phosphorus concen trations may not need phosphate treatment. Cats are more likely to have hemolysis with marked hypophosphatemia.",
          "pdf_page": 821,
          "printed_page": 739,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "If caused by insulin administration or hyperalimentation, administer supplemental phosphorus.",
          "pdf_page": 821,
          "printed_page": 739,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Severe hypophosphatemia (<1.5 mg/dL)— patients need hospitalization and monitoring for hemolysis or hemolytic crisis. Administer isotonic crystalloid solution without calcium, IV, supplemented with potassium phosphate.",
          "pdf_page": 821,
          "printed_page": 739,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Packed red blood cell transfusion for severe hemolytic crisis.",
          "pdf_page": 821,
          "printed_page": 739,
          "column": 3
        }
      ],
