          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Phosphate—0.01–0.12 mMol/kg/h IV. Monitor serum phosphorus every 6–8 hours.",
              "pdf_page": 822,
              "printed_page": 740,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Potassium phosphate (3 mMol phosphate/",
              "pdf_page": 822,
              "printed_page": 740,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "mL and 4.4 mEq potassium/mL) IV.",
              "pdf_page": 822,
              "printed_page": 740,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Sodium phosphate (3 mMol phosphate/",
              "pdf_page": 822,
              "printed_page": 740,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "mL and 4 mEq sodium/mL) IV.",
              "pdf_page": 822,
              "printed_page": 740,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Discontinue therapy when serum phosphorus concentration reaches 2 mg/dL in order to avoid iatrogenic hyperphosphatemia and hypocalcemia.",
              "pdf_page": 822,
              "printed_page": 740,
              "column": 1
            }
          ]
        },
