    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Concurrent hyperglycemia, glucosuria, ketonuria, and high anion gap metabolic acidosis—rule out diabetic ketoacidosis.",
              "pdf_page": 821,
              "printed_page": 739,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Concurrent glucosuria, normoglycemia, isosthenuria with or without azotemia—rule out renal tubular defects.",
              "pdf_page": 821,
              "printed_page": 739,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Concurrent hypercalcemia and proteinuria, hematuria, with or without bacteria—rule out primary hyperparathyroidism with cystic calculi or nephroliths.",
              "pdf_page": 821,
              "printed_page": 739,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Concurrent hypocalcemia—rule out puerperal tetany.",
              "pdf_page": 821,
              "printed_page": 739,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Concurrent panhypoproteinemia—rule out intestinal malabsorption.",
              "pdf_page": 821,
              "printed_page": 739,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "LABORATORY FINDINGS",
