          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 821,
              "printed_page": 739,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Usually consistent with the primary condition",
              "pdf_page": 821,
              "printed_page": 739,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "responsible for the hypophosphatemia;",
              "pdf_page": 821,
              "printed_page": 739,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "however, evidence of severe hypophosphatemia",
              "pdf_page": 821,
              "printed_page": 739,
              "column": 2,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(e.g., hemolysis) is usually not observed unless",
              "pdf_page": 821,
              "printed_page": 739,
              "column": 2,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "serum concentrations decrease to 1.0 mg/dL",
              "pdf_page": 821,
              "printed_page": 739,
              "column": 2,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "or less.",
              "pdf_page": 821,
              "printed_page": 739,
              "column": 2,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 821,
              "printed_page": 739,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hemolytic anemia (especially in cats) causes",
              "pdf_page": 821,
              "printed_page": 739,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "pallor, tachypnea, dyspnea, and/or hemoglob-",
              "pdf_page": 821,
              "printed_page": 739,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "inuria.",
              "pdf_page": 821,
              "printed_page": 739,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Skeletal and respiratory muscle weakness.",
              "pdf_page": 821,
              "printed_page": 739,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mental dullness.",
              "pdf_page": 821,
              "printed_page": 739,
              "column": 2,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
        "CAUSES": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES",
          "canonical_heading": "CAUSES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Maldistribution (translocation)— treatment of diabetic ketoacidosis, insulin administration or carbohydrate load, total parenteral nutrition or nutritional recovery, hyperventilation or respiratory alkalosis.",
              "pdf_page": 821,
              "printed_page": 739,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reduced renal reabsorption (increased renal loss)—primary hyperparathyroidism, renal tubular disorders (e.g., Fanconi syndrome), proximal tubule diuretics (e.g., carbonic anhydrase inhibitors), eclampsia (puerperal tetany), hyperadrenocorticism (corticosteroids promote renal phosphate loss), sodium bicarbonate administration.",
              "pdf_page": 821,
              "printed_page": 739,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reduced intestinal absorption (decreased intake)—phosphorus-deficient diets, vitamin D deficiency, malabsorption disorders, phosphate binders.",
              "pdf_page": 821,
              "printed_page": 739,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Laboratory error—hemolysis, icterus, osmotic diuretic administration.",
              "pdf_page": 821,
              "printed_page": 739,
              "column": 2
            }
          ]
        },
        "RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "RISK FACTORS",
          "canonical_heading": "RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Phosphorus-deficient diets or parenteral nutrition (refeeding syndrome).",
              "pdf_page": 821,
              "printed_page": 739,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diabetes mellitus.",
              "pdf_page": 821,
              "printed_page": 739,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prolonged anorexia, malnutrition, or starvation.",
              "pdf_page": 821,
              "printed_page": 739,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary hyperparathyroidism.",
              "pdf_page": 821,
              "printed_page": 739,
              "column": 2
            }
          ]
        },
