          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Temporary acute side effects (e.g., moist dermatitis and alopecia) may be expected with radiation therapy, and consultation with a radiation oncologist is recommended regarding specific, anatomic site-related side effects.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 3
            }
          ]
        },
