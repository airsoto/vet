        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "More commonly reported in cats than in dogs.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Similar biologic behavior in both species.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mean age—cats: 9 years (range 2–12 years); dogs: 8 years (range <1–10 years).",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No proven breed or sex predilection, although flat-coated retrievers, Rottweilers, and golden retrievers appear overrepresented and may be predisposed.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anorexia, weight loss, and lethargy may occur.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Depend on site of involvement.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Firm, invasive tumor arising in subcutane-",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "ous tissue.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May exhibit deep extension into underlying",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "skeletal muscle.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May develop adjacent to bone and induce",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "bone destruction and proliferation.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most common sites—dorsal thoracic and",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "scapular area, limbs, and pelvic region.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May also be a primary splenic tumor in",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "dogs; palpable splenomegaly may be found.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Distant metastasis—common.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
