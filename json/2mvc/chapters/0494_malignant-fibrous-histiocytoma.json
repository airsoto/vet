        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Unknown.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Can be induced with carcinogens in laboratory animal species.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Injection sites in cats.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other forms of soft tissue sarcoma (e.g., fibrosarcoma, leiomyosarcoma).",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chondrosarcoma.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Osteosarcoma (extraskeletal).",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Liposarcoma.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Peripheral nerve sheath tumors.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Histiocytic diseases, such as histiocytic sarcoma or systemic histiocytosis.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mast cell neoplasia.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "CBC—may vary; may be normal; may see regenerative or nonregenerative anemia.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Biochemistry—variably abnormal.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urinalysis—usually normal.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Cytologic examination of aspirate—may reveal histiocyte- and fibroblast-like cells.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Radiography—reveals soft tissue dense mass; may note bone proliferation or destruction.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Three-view thoracic radiography to check for lung metastasis.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "MRI or CT may be superior for delineating extent of tumor invasion into surrounding tissues.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ultrasonography may detect abnormalities consistent with abdominal metastasis (most common in lymph nodes and liver).",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Histologic examination of biopsy specimen— necessary for definitive diagnosis.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Classification—considerable debate exists among pathologists regarding use of the term maligant fibrous histiocytoma, which may account for the apparent differences in behavior reported in the literature.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Storiform-pleomorphic (may be called inflammatory) and giant cell (also called osteoclast-like) are the two major variants reported. Myxoid variant also described.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Many are histologically high grade.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Specialized immunohistologic stains, such as CD18, vimentin, desmin, alpha-smooth muscle actin, extra domain 1 (ED1), and/or azan (for collagen) may aid classification. Definitive staining patterns have not been clearly identified.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Recent report of considerable overlapping histopathologic characteristics with histiocytic diseases in the splenic form.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgical excision—difficult owing to local invasive nature; recurrence rate is high.",
          "pdf_page": 943,
          "printed_page": 861,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Amputation of an affected limb—may be appropriate, however considerable metastatic risk; thoracic and abdominal radiographs and abdominal ultrasound critical for evaluating detectable metastasis before surgical treatment.",
          "pdf_page": 943,
          "printed_page": 861,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Radiotherapy may be helpful as adjuvant treatment for localized tumor not amenable to complete surgical resection. Expected local tumor control rates may be similar to other high-grade soft tissue sarcomas.",
          "pdf_page": 943,
          "printed_page": 861,
          "column": 2
        }
      ],
