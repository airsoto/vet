    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Chemotherapy—may be helpful in residual, high-grade tumor or metastatic disease setting; doxorubicin-based protocols are most popular (dose for canine patients >10 kg, 30 mg/m2IV every 3 weeks; patients <10 kg, 1 mg/kg IV every 3 weeks).",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 3
            }
          ]
        },
