      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Reexamination—metastatic potential would suggest physical examination and possible imaging; monthly for 3 months, then every 3 months thereafter.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 3
            }
          ]
        },
