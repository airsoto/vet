  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Name based on histologic features of fibroblast- and histiocyte-like cells.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "A group of primitive pleomorphic mesenchymal neoplasms, but definitive cellular origin unknown; likely possibilities include fibroblasts, histiocytes, and undifferentiated mesenchymal cells.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Several histologic variants.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Storiform-pleomorphic and giant cell—two major variants; both locally invasive; firm, subcutaneous, or visceral masses on examination.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Despite previous reports to the contrary, metastatic potential in dogs appears to be moderate to high.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Have been reported as injection site-related sarcomas of cats.",
              "pdf_page": 943,
              "printed_page": 861,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
