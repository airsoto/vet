        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Consistent pathologic lesions include",
              "pdf_page": 844,
              "printed_page": 762,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diarrhea and weight loss usually show uniform thickening of small bowel, initial improvement with treatment, but generalized lymphoplasmacytic infiltration of",
              "pdf_page": 844,
              "printed_page": 762,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "recurrence of signs is common.",
              "pdf_page": 844,
              "printed_page": 762,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Long-term intestinal lamina propria, lacteal dilation, prognosis is poor over course of months to a crypt abscesses, and blunting and fusion of few years.",
              "pdf_page": 844,
              "printed_page": 762,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "villous tips.",
              "pdf_page": 844,
              "printed_page": 762,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May be gastric rugal fold hypertrophy, lymphocytic gastritis, oxyntic gland hyperplasia, and/or gastric mucosal",
              "pdf_page": 844,
              "printed_page": 762,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
