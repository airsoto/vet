    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Outpatient treatment with anthelmintic for most cases.",
          "pdf_page": 1517,
          "printed_page": 1435,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Severe cases with dehydration and electrolyte disturbances require inpatient fluid therapy in addition to anthelmintic.",
          "pdf_page": 1517,
          "printed_page": 1435,
          "column": 2
        }
      ],
