              "printed_page": 1435,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Milbemycin oxime—0.5 mg/kg PO q30 days in dogs.",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Moxidectin/imidacloprid—label dose in",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 2
            },
            {
              "type": "subheading",
