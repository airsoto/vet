    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Repeat fecal examination for trichurid eggs and/or retreat with anthelmintic at 3 weeks and at 3 months following initial treatment or once a month for 3 months to detect and eliminate recently matured adults.",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 2
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Prompt removal and disposal of feces to prevent environmental contamination with infective eggs.",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anthelmintic treatment of infected dogs to prevent shedding of eggs and contamination of environment.",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 3
            }
          ]
        },
