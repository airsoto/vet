  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "The whipworm,Trichuris, infects the",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "cecum of dogs (T. vulpis) and cats",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "(T. campanulaandT. serrata); feline",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "trichuriasis is extremely rare in continental",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1,
              "subheading": "(T. campanulaandT. serrata); feline"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "United States.",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1,
              "subheading": "(T. campanulaandT. serrata); feline"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Life cycle is direct; infection is acquired by",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1,
              "subheading": "(T. campanulaandT. serrata); feline"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "ingestion of larvated eggs; infective eggs can",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1,
              "subheading": "(T. campanulaandT. serrata); feline"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "persist in environment for months to years.",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1,
              "subheading": "(T. campanulaandT. serrata); feline"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infection can be asymptomatic or cause",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1,
              "subheading": "(T. campanulaandT. serrata); feline"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "bloody diarrhea and large bowel inflammation.",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1,
              "subheading": "(T. campanulaandT. serrata); feline"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical signs can occur before patency, i.e.,",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1,
              "subheading": "(T. campanulaandT. serrata); feline"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "before eggs are shed in feces; prepatent period",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1,
              "subheading": "(T. campanulaandT. serrata); feline"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "is approximately 70–90 days.",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1,
              "subheading": "(T. campanulaandT. serrata); feline"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No extraintestinal migration occurs.",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1,
              "subheading": "(T. campanulaandT. serrata); feline"
            }
          ]
        },
