        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs and cats.",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No age, breed, or sex predilections.",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Range from asymptomatic to severe.",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intermittent large bowel diarrhea often containing mucus and fresh blood (hematochezia).",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bloody diarrhea with dehydration, anemia, and weight loss in severe cases.",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Signs can occur before eggs detectable in feces.",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute to chronic debilitation.",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ingestion of infective (larvated) eggs from fecally contaminated environment.",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Eggs accumulate in environment and remain infective for months to years, especially in soil in moist, shady areas.",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Return of dog to an environment contaminated with infective eggs after anthelmintic treatment will result in reinfection.",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Bacterial (spirochaetal) infections of cecum.",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hookworm infection—identify eggs in feces; signs include anemia, pale mucous membranes, melena rather than hematochezia.",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inflammatory bowel disease.",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gastrointestinal ulcers.",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dietary indiscretion.",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Capillarid infections (Pearsonema,",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Eucoleus)—eggs similar in appearance but",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "smaller with roughened surface; infect urinary",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1,
              "subheading": "Eucoleus)—eggs similar in appearance but"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "or respiratory tracts, respectively, rather than",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1,
              "subheading": "Eucoleus)—eggs similar in appearance but"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "gastrointestinal tract; usually asymptomatic.",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1,
              "subheading": "Eucoleus)—eggs similar in appearance but"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary pseudo-hypoadrenocorticism in",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1,
              "subheading": "Eucoleus)—eggs similar in appearance but"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "severe trichuriasis with metabolic acidosis,",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1,
              "subheading": "Eucoleus)—eggs similar in appearance but"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hyponatremia, hyperkalemia, and dehydra-",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1,
              "subheading": "Eucoleus)—eggs similar in appearance but"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "tion; adrenocorticotropic hormone (ACTH)",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1,
              "subheading": "Eucoleus)—eggs similar in appearance but"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "stimulation response is normal in cases of",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1,
              "subheading": "Eucoleus)—eggs similar in appearance but"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "trichuriasis.",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 1,
              "subheading": "Eucoleus)—eggs similar in appearance but"
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Usually normal; hyponatremia, hyperkalemia, and metabolic acidosis can occur in severe cases.",
              "pdf_page": 1517,
              "printed_page": 1435,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
