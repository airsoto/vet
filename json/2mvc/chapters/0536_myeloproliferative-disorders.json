        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats and dogs—more common in cats.",
              "pdf_page": 1014,
              "printed_page": 932,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May be more common in large-breed dogs than small-breed dogs.",
              "pdf_page": 1014,
              "printed_page": 932,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Pale mucous membranes.",
              "pdf_page": 1014,
              "printed_page": 932,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Petechiation.",
              "pdf_page": 1014,
              "printed_page": 932,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lethargy.",
              "pdf_page": 1014,
              "printed_page": 932,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inappetance.",
              "pdf_page": 1014,
              "printed_page": 932,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Weight loss.",
              "pdf_page": 1014,
              "printed_page": 932,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hepatosplenomegaly.",
              "pdf_page": 1014,
              "printed_page": 932,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Peripheral lymphadenomegaly— occasionally.",
              "pdf_page": 1014,
              "printed_page": 932,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neurologic signs—disorientation, ataxia, seizure.",
              "pdf_page": 1014,
              "printed_page": 932,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
