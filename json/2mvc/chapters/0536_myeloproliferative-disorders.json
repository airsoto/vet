        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—most commonly associated with feline leukemia virus (FeLV) infection; when recovering from panleukopenia or hemo bartonellosis, may be a relatively higher risk of developing a mutant cell line induced by FeLV.",
              "pdf_page": 1014,
              "printed_page": 932,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—has been experimentally induced with chronic low-dose radiation exposure.",
              "pdf_page": 1014,
              "printed_page": 932,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute lymphocytic leukemia—usually differentiated by special staining techniques (immunohistochemistry or immuno cytochemistry for lymphoid markers) or PCR for antigen receptor rearrangement (PARR).",
              "pdf_page": 1014,
              "printed_page": 932,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Leukemoid response secondary to inflammation.",
              "pdf_page": 1014,
              "printed_page": 932,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other causes of eosinophilia—parasitism; allergic disease; eosinophilic gastroenteritis; mast cell neoplasia; differentiate from eosinophilic leukemia.",
              "pdf_page": 1014,
              "printed_page": 932,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Relative and secondary absolute polycythemia.",
              "pdf_page": 1014,
              "printed_page": 932,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reactive thrombocytosis—secondary to inflammation, hemolytic or iron-deficiency anemia, splenectomy, rebound from immune-",
              "pdf_page": 1014,
              "printed_page": 932,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "CONTRAINDICATIONS/POSSIBLE",
              "pdf_page": 1014,
              "printed_page": 932,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "mediated thrombocytopenia, and drug-",
              "pdf_page": 1014,
              "printed_page": 932,
              "column": 2,
              "subheading": "CONTRAINDICATIONS/POSSIBLE"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "induced (e.g., vincristine).",
              "pdf_page": 1014,
              "printed_page": 932,
              "column": 2,
              "subheading": "CONTRAINDICATIONS/POSSIBLE"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "INTERACTIONS",
              "pdf_page": 1014,
              "printed_page": 932,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Chemotherapy can be toxic; seek advice",
              "pdf_page": 1014,
              "printed_page": 932,
              "column": 2,
              "subheading": "INTERACTIONS"
            }
          ]
        },
