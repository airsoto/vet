    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Treat clinically important bradyarrhythmias with atropine or a temporary transvenous pacemaker.",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Treat clinically important ventricular arrhythmias with lidocaine or phenytoin; phenytoin also reverses high-degree AV block.",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Digoxin-binding antibodies (e.g., Digibind®) rapidly drop digoxin concentration in critically ill animals; the use of these products is limited in veterinary practice by their exorbitant cost.",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thyroxin supplementation if hypothyroidism confirmed.",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 2
            }
          ]
        },
        "CONTRAINDICATIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CONTRAINDICATIONS",
          "content_blocks": []
        },
        "PRECAUTIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PRECAUTIONS",
          "content_blocks": []
        },
        "POSSIBLE INTERACTIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "POSSIBLE INTERACTIONS",
          "content_blocks": []
        },
        "CONTRAINDICATIONS/POSSIBLE INTERACTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Avoid or discontinue drugs that slow digoxin elimination or metabolism (e.g., quinidine, verapamil, and diltiazem).",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Avoid drugs that could worsen conduction disturbances (e.g., beta blockers and calcium channel blockers).",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Class 1A antiarrhythmic drugs (e.g., quinidine and procainamide) may worsen AV block.",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 2
            }
          ]
        },
        "ALTERNATIVE DRUG(S)": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "ALTERNATIVE DRUG(S)",
          "content_blocks": []
        }
      }
    },
    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Inform owner that reduction in appetite is an early indication of digoxin toxicity.",
          "pdf_page": 489,
          "printed_page": 407,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Monitor renal function and electrolytes frequently in patients receiving digoxin; lower digoxin dose if renal disease develops.",
          "pdf_page": 489,
          "printed_page": 407,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Monitor serum digoxin concentration periodically.",
          "pdf_page": 489,
          "printed_page": 407,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Monitor ECG periodically to assess for arrhythmias or conduction disturbances that may suggest digoxin toxicity.",
          "pdf_page": 489,
          "printed_page": 407,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Monitor bodyweight frequently; alter digoxin dosage accordingly; patients with congestive heart failure often lose weight.",
          "pdf_page": 489,
          "printed_page": 407,
          "column": 3
        }
      ],
