        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Renal disease—impairs digoxin elimination.",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic pulmonary disease—results in hypoxia and acid-base disturbances.",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Obesity—if dosage not calculated on lean bodyweight.",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Drugs and conditions that alter digoxin metabolism or elimination (e.g., quinidine and hypothyroidism).",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rapid IV digitalization.",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Overdosage or accidental ingestion of owner’s medication.",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Administration of diuretic leading to hypokalemia.",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Arrhythmias and conduction disturbances—may reflect structural heart disease, not digoxin toxicity.",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anorexia—common in animals with heart failure.",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Animals with hypokalemia, hypercalcemia, hypomagnesemia, and renal failure are predisposed to toxicity.",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Consider checking thyroid status.",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Obtain digoxin serum concentration 8–10 hours after an oral dose—therapeutic range is 0.5–1.5 ng/mL. A recent study in humans found digoxin levels greater than 1 mg/ml were associated with increased mortality; not",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "all patients with concentrations>1.5 ng/mL",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "have signs of toxicity; some with values in the",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 2,
              "subheading": "all patients with concentrations>1.5 ng/mL"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "normal range have signs of toxicity, especially",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 2,
              "subheading": "all patients with concentrations>1.5 ng/mL"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "if hypokalemic. To minimize the risk of",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 2,
              "subheading": "all patients with concentrations>1.5 ng/mL"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "toxicity, the author aims to achieve a digoxin",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 2,
              "subheading": "all patients with concentrations>1.5 ng/mL"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "level between 0.5 and 1 ng/mL.",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 2,
              "subheading": "all patients with concentrations>1.5 ng/mL"
            }
          ]
        },
