              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anorexia.",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vomiting.",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diarrhea.",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lethargy.",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Depression.",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Heart rate may range from severe bradycardia",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "to severe tachycardia.",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
        "CAUSES": {
          "present": false,
