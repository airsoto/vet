    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Discontinue digoxin until signs of toxicity resolve (24–72 hours); reevaluate need for the medication; if necessary, resume treatment at a dosage based on the serum digoxin concentration.",
          "pdf_page": 489,
          "printed_page": 407,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Maintain hydration and correct any electrolyte disturbance (especially hypokalemia) with parenteral fluid administration.",
          "pdf_page": 489,
          "printed_page": 407,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Discontinue drugs that slow digoxin metabolism or elimination (e.g., quinidine, verapamil, amiodarone).",
          "pdf_page": 489,
          "printed_page": 407,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Severe arrhythmias (ventricular tachycardia) and conduction disturbances—can be lifethreatening; require hospitalization for treatment and monitoring.",
          "pdf_page": 489,
          "printed_page": 407,
          "column": 2
        }
      ],
