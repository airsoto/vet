          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Not uncommon in patients treated with digoxin due to digoxin’s narrow therapeutic index and prevalence of renal impairment in elderly patients with cardiac disease. Becoming less common in clinical practice as use of digoxin has decreased in management of heart failure.",
              "pdf_page": 489,
              "printed_page": 407,
              "column": 1
            }
          ]
        },
