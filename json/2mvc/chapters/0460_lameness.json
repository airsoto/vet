        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Severe, sharp pain—limited limb movement during all phases of locomotion, little to no load bearing in motion or at rest.",
              "pdf_page": 890,
              "printed_page": 808,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Milder, dull, or aching pain—reduced loading and ground contact time during all phases of locomotion.",
              "pdf_page": 890,
              "printed_page": 808,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pain produced only during certain phases of movement—patient adjusts its motion and gait to minimize discomfort.",
              "pdf_page": 890,
              "printed_page": 808,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anatomic dysfunction resulting in certain normal motions being altered or impossible.",
              "pdf_page": 890,
              "printed_page": 808,
              "column": 1
            }
          ]
        },
