  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute, progressive, ischemic and hemorrhagic necrosis of the spinal cord after acute spinal cord injury (SCI).",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "First appears at the site of injury; then may progress cranially and caudally.",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Overall prevalence: 2% in dogs with acute thoracolumbar intervertebral disc herniation (IVDH), up to about 15% in more severely affected cases with paraplegia and loss of pain perception.",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Death usually caused by respiratory paralysis.",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
        "PATHOPHYSIOLOGY": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": []
        },
        "SYSTEMS AFFECTED": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": []
        },
        "GENETICS": {
