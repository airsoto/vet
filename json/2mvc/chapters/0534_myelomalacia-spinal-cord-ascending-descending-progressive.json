          "canonical_heading": "GENETICS",
          "content_blocks": []
        },
        "INCIDENCE/PREVALENCE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "INCIDENCE/PREVALENCE",
          "content_blocks": []
        },
        "GEOGRAPHIC DISTRIBUTION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GEOGRAPHIC DISTRIBUTION",
          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Any age or breed.",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Because of the close association between acute (type I) IVDH and myelomalacia, chondrodystrophic breeds, particularly dachshunds, are more commonly affected because of their predisposition to the former.",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "French bulldogs were at higher risk than dachshunds in one study.",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Not clinically recognizable in acute phase of SCI—suggestive clinical signs usually seen within 48 hours after presentation, but a delayed onset up to 2 weeks after injury has been reported.",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute onset of paraplegia—initial clinical sign.",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pain perception—usually absent caudal to the lesion (i.e., pelvic limbs and tail).",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracolumbar injury—pelvic limbs paralysis with normal to exaggerated spinal reflexes in the pelvic limbs; some dogs might present with absent spinal reflexes (lesion at the lumbosacral intumescence or secondary to spinal shock).",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Involvement of the lumbosacral spinal cord segments within 12–72 hours, causing pelvic limb areflexia and atonia, loss of abdominal and anal tone and flaccid urinary bladder.",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic and cervical spinal cord segments may be involved within 24 hours to 10 days after initial injury, causing loss of cutaneous trunci muscle reflex, progression to tetraplegia, bilateral Horner syndrome, hypoventilation, and death.",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Extensive subarachnoid hemorrhage may cause hyperthermia and diffuse meningeal pain.",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute intervertebral disc herniation — herniation at the lumbosacral intumescence associated with higher risk.",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute, severe, spinal cord trauma.",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fibrocartilaginous embolism or acute noncompressive nucleus pulposus extrusion.",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "On presentation, cannot be differentiated from spinal shock (acute paralysis with initial areflexia improving after a few hours to days post injury) following acute SCI.",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diagnosis based on hind limb upper motor neuron paralysis with absent nociception progressing to a lower motor neuron paralysis and rostrally advancing line of analgesia and cutaneous trunci reflex.",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually normal.",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Possible degenerative left‐shift caused by massive spinal cord necrosis.",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Serum glial fibrillary acidic protein (GFAP)— elevated; experimental only.",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Spinal survey radiographs—evidence of calcified, herniated disc, narrowed intervertebral disc space; vertebral fracture or luxation.",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Myelography—cord compression; edema; contrast medium infiltration into the spinal parenchyma.",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "MRI—extensive parenchymal T2 hyper intensity and spinal cord swelling; associated with other evidence of SCI.",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "CSF—unspecific results; hemorrhagic, neutrophilic pleocytosis and high protein concentration.",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Extensive, multifocal, necrosis of the spinal cord parenchyma with ischemic changes and multifocal hemorrhages.",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "None to reverse spinal cord damage and stop disease progression.",
          "pdf_page": 1011,
          "printed_page": 929,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Rapid spinal cord decompression— indicated for IVDH as delayed surgical treatment on dogs with complete sensori motor loss can alter chances of recovery; if performed less than 12 hours following loss of ambulation the risk of myelomalacia is decreased.",
          "pdf_page": 1011,
          "printed_page": 929,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgery does not always prevent its occurrence, especially if delayed: inform the owners of the risk of myelomalacia post operatively despite rapid intervention.",
          "pdf_page": 1011,
          "printed_page": 929,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Strong suspicion of myelomalacia—poor outcome, consider euthanasia.",
          "pdf_page": 1011,
          "printed_page": 929,
          "column": 2
        }
      ],
