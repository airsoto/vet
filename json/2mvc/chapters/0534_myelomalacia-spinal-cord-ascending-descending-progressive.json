            {
              "type": "subheading",
              "level": 0,
              "text": "FOLLOW‐UP",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "In rare cases, condition progresses only",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 3,
              "subheading": "FOLLOW‐UP"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "caudally; paralysis is permanent, but",
              "pdf_page": 1011,
              "printed_page": 929,
              "column": 3,
              "subheading": "FOLLOW‐UP"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "respiratory compromise does not occur.",
