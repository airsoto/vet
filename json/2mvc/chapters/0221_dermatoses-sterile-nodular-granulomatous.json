              "printed_page": 382,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Occasionally painful.",
              "pdf_page": 464,
              "printed_page": 382,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Overlying epidermis may be normal to ulcerated.",
              "pdf_page": 464,
              "printed_page": 382,
              "column": 1
            }
          ]
        },
