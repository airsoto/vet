    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Patients on long-term immunosuppressive therapy should have CBC, chemistry screen, urinalysis, and urine culture performed at least every 6 months.",
              "pdf_page": 465,
              "printed_page": 383,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs treated with DMSO for calcinosis cutis should have calcium levels checked every 7–14 days for first month of therapy if large areas are affected.",
              "pdf_page": 465,
              "printed_page": 383,
              "column": 2
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": []
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Long-term use of immunosuppressive therapy (especially glucocorticosteroids) may make patients more susceptible to other dermatoses such as bacterial folliculitis, demodicosis, and dermatophytosis, as well as systemic side effects.",
              "pdf_page": 465,
              "printed_page": 383,
              "column": 2
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Systemic amyloidosis, malignant histiocytosis, systemic reactive histiocytosis, and nodular dermatofibrosis—invariably fatal.",
              "pdf_page": 465,
              "printed_page": 383,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Many of the other conditions have a guarded prognosis; many require lifelong immunosuppressive therapy to remain in remission.",
              "pdf_page": 465,
              "printed_page": 383,
              "column": 3
            }
          ]
        }
      }
    },
    "MISCELLANEOUS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "ASSOCIATED CONDITIONS": {
          "present": true,
          "status": "content",
          "source_heading": "ASSOCIATED CONDITIONS",
          "canonical_heading": "ASSOCIATED CONDITIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Calcinosis cutis—hyperglucocorticoidism, chronic renal failure, and diabetes mellitus.",
              "pdf_page": 465,
              "printed_page": 383,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Calcinosis circumscripta—(occasionally) hypertrophic osteodystrophy and idiopathic polyarthritis.",
              "pdf_page": 465,
              "printed_page": 383,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Collagenous nevi—renal cystadenoma/cystadenocarcinoma and uterine, leiomyoma/leiomyosarcoma.",
              "pdf_page": 465,
              "printed_page": 383,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cutaneous xanthoma—diabetes mellitus and hyperlipoproteinemia.",
              "pdf_page": 465,
              "printed_page": 383,
              "column": 3
            }
          ]
        },
