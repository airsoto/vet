        "CONTRAINDICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS",
          "canonical_heading": "CONTRAINDICATIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Corticosteroids and other immunosuppressive drugs should be avoided, if possible, in any animal with secondary bacterial folliculitis.",
              "pdf_page": 465,
              "printed_page": 383,
              "column": 2
            }
          ]
        },
        "PRECAUTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "PRECAUTIONS",
          "canonical_heading": "PRECAUTIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "DMSO—handle with care; monitor serum calcium levels if used to treat calcinosis cutis.",
              "pdf_page": 465,
              "printed_page": 383,
              "column": 2
            }
          ]
        },
