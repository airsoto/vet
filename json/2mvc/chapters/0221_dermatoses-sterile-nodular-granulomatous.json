              "printed_page": 382,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inflammation is typically, but not always, granulomatous to pyogranulomatous.",
              "pdf_page": 464,
              "printed_page": 382,
              "column": 1
            }
          ]
        },
