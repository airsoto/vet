  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Inherited disorders caused by partial or complete deficiency of a lysosomal enzyme or an enzyme-activator protein, which leads to intracellular accumulation (storage) of the",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "substrate of that enzyme.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Storage products—proteins, carbohydrates, lipids, or a",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "combination.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Classes of diseases—proteinoses, glycoproteinoses, oligosaccharidoses, sphingolipidoses, mucopolysaccharidoses.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Many different types reported in dogs and",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "cats.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inheritance is autosomal recessive.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1
            }
          ]
        },
