        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog—German shepherd dog, German shorthaired pointer, English setter, beagle, Cairn terrier, bluetick hound, West Highland white terrier, Sydney silky terrier, English springer spaniel, Portuguese water dog, Japanese spaniel, Labrador retriever, American bulldog, Irish",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "setter, mixed-breed dogs, many others.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cat— Persian, Siamese, Korat, Balinese, domestic",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "shorthair.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most affected animals <1 year old; a few adult-onset diseases described, with onset as late as 2 years old, or older.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "General Comments",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vary with severity of the enzyme deficiency.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In certain diseases, carrier animals can be",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "affected with a milder form of the disease.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Many organ systems are affected, but",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "neurologic signs tend to predominate.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affected animals are normal at birth.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fail to",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "thrive and may manifest skeletal malformations,",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "particularly in the mucopolysaccharidoses.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neurologic signs within the first few months",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "of life suggest multifocal neurologic disease.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical/Neurologic Examination",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cerebellar dysfunction common—intention",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1,
              "subheading": "Physical/Neurologic Examination"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "tremors, nystagmus, dysmetria.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1,
              "subheading": "Physical/Neurologic Examination"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Peripheral",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1,
              "subheading": "Physical/Neurologic Examination"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "neuropathy occurs in some diseases—weakness,",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1,
              "subheading": "Physical/Neurologic Examination"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "hyporeflexia or areflexia, muscle wasting.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1,
              "subheading": "Physical/Neurologic Examination"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1,
              "subheading": "Physical/Neurologic Examination"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "neurologic signs—ataxia; exercise intolerance;",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1,
              "subheading": "Physical/Neurologic Examination"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "seizures; behavioral changes; visual deficits,",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1,
              "subheading": "Physical/Neurologic Examination"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "deafness, stereotypical behaviors, proprioceptive",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1,
              "subheading": "Physical/Neurologic Examination"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "deficits, tremors.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1,
              "subheading": "Physical/Neurologic Examination"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Non-neurologic signs—may",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1,
              "subheading": "Physical/Neurologic Examination"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "see organomegaly or skeletal malformations.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1,
              "subheading": "Physical/Neurologic Examination"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Ocular pathology in some diseases—corneal",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1,
              "subheading": "Physical/Neurologic Examination"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "opacification, cataract formation.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1,
              "subheading": "Physical/Neurologic Examination"
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Genetic—deletion or mutation involving a single gene that causes an absolute or partial deficiency of a lysosomal enzyme or activator protein; deficient production of enzymes that do not have normal biologic activity.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Susceptible breed.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Metabolic encephalopathy—usually episodic clinical signs; results of CBC, biochemistry,",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "and urinalysis often diagnostic.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Toxicities— acute onset of clinical signs; history of",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "exposure.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cerebellar hypoplasia—onset at",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "3–6 weeks of age; nonprogressive.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cerebellar abiotrophy—deficits limited to the cerebellum; may be difficult to differentiate in the early",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "stages without specific tests.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prenatal or neonatal infections (especially viral) resulting in meningoencephalomyelitis—differentiated by CSF analysis; may be other signs, such as",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "chorioretinitis.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metabolic diseases—especially organic and amino acidurias.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Regular blood smears and CSF analysis— cytoplasmic vacuolation of leukocytes caused by accumulation of storage products is",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "present in some cases.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urine—may find abnormal accumulation of substances (e.g., oligosaccharide inα-mannosidosis).",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": []
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Radiography—bony malformation may be present in diseases in which skeletal pathology is a feature (e.g., mucopolysaccharidoses).",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "MRI—used in one case to reveal diffuse white matter pathology in the brain of a dog with globoid cell leukodystrophy.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Molecular genetic testing—available for the diagnosis of many lysosomal storage diseases; may be used to identify potential carriers.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Aspirates or biopsies of parenchymal organs, particularly the liver and spleen—may reveal",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "intracellular storage material.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Biochemical tests—diagnosis may be made by demonstrating low enzyme activity or presence of accumulated substrate or metabolic intermediates in preparations of serum, brain, viscera, leukocytes, or skin fibroblasts.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Electromyography and nerve conduction studies—abnormal in diseases in which peripheral neuropathy or myopathy is a",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "feature.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Biopsy of peripheral nerve or skeletal muscle—may demonstrate specific pathology.",
              "pdf_page": 941,
              "printed_page": 859,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": []
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Outpatient—unless severe deficits preclude",
          "pdf_page": 941,
          "printed_page": 859,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "nursing care at home.",
          "pdf_page": 941,
          "printed_page": 859,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Activity—restrict to",
          "pdf_page": 941,
          "printed_page": 859,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "safe areas; avoid stairs.",
          "pdf_page": 941,
          "printed_page": 859,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Diet and fluids— ensure proper intake in patients often debilitated; parenteral fluid therapy and",
          "pdf_page": 941,
          "printed_page": 859,
          "column": 2
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "enteral or parenteral nutritional support may",
          "pdf_page": 941,
          "printed_page": 859,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "be needed with severe disease.",
          "pdf_page": 941,
          "printed_page": 859,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Bone marrow transplantation—used experimentally",
          "pdf_page": 941,
          "printed_page": 859,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "with some success.",
          "pdf_page": 941,
          "printed_page": 859,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Gene therapy—area of intense research that may offer hope for",
          "pdf_page": 941,
          "printed_page": 859,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "specific treatment.",
          "pdf_page": 941,
          "printed_page": 859,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Enzyme replacement therapy—intrathecal enzyme replacement has shown some efficacy in an experimental",
          "pdf_page": 941,
          "printed_page": 859,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "setting.",
          "pdf_page": 941,
          "printed_page": 859,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Primary treatment—preventive; control of breeding; genetic counseling.",
          "pdf_page": 941,
          "printed_page": 859,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Patients may be at risk of developing secondary infection; initiate appropriate treatment if infection develops.",
