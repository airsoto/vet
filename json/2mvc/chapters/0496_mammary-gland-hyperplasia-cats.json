        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Young, intact, cycling, or pregnant queens.",
              "pdf_page": 946,
              "printed_page": 864,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats of either gender after gonadectomy (rare in tom).",
              "pdf_page": 946,
              "printed_page": 864,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats of either gender that are receiving exogenous progestogen (e.g., megestrol acetate).",
              "pdf_page": 946,
              "printed_page": 864,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Less often in older (9–12 years) pregnant queens.",
              "pdf_page": 946,
              "printed_page": 864,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Localized or diffuse rapid (2–5 weeks) enlargement of one or more mammary glands.",
              "pdf_page": 946,
              "printed_page": 864,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Firm and nonpainful masses in uncomplicated cases.",
              "pdf_page": 946,
              "printed_page": 864,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No concurrent signs of systemic illness.",
              "pdf_page": 946,
              "printed_page": 864,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Exaggerated proliferation secondary to an endogenous progesterone influence (pregnancy, pseudopregnancy) or exogenous progestogens (megestrol or medroxyprogesterone acetate).",
              "pdf_page": 946,
              "printed_page": 864,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May develop after gonadectomy; pathogenesis may involve progesterone, growth hormone, prolactin, insulin-like growth factors. Suspect ovarian remnant syndrome.",
              "pdf_page": 946,
              "printed_page": 864,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reported in one male with adrenocortical carcinoma producing steroid hormones.",
              "pdf_page": 946,
              "printed_page": 864,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Mastitis—lactating queen; mammary glands erythematous and painful; systemic illness with fever and immature neutrophilia; inflammatory cells and bacteria in fluid expressed from the affected gland(s).",
              "pdf_page": 946,
              "printed_page": 864,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mammary neoplasia—old queens (>6 years); gross appearance may be indistinguishable; irregular shape and margins, heterogeneous echogenicity on ultrasound; differentiated by biopsy or fine-needle aspirate of affected tissue.",
              "pdf_page": 946,
              "printed_page": 864,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Normal; leukocytosis possible if secondary mastitis present.",
              "pdf_page": 946,
              "printed_page": 864,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
