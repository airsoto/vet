    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Intestinal form—may treat as inpatient to prevent environmental contamination with eggs and to ensure proper disposal (as biohazard) or destruction (incineration) of fecal material and worms after treatment.",
          "pdf_page": 249,
          "printed_page": 167,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Larval form—no treatment to date.",
          "pdf_page": 249,
          "printed_page": 167,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Client education—alert owner of potential risk to people who may frequent similar habitats to raccoons.",
          "pdf_page": 249,
          "printed_page": 167,
          "column": 2
        }
      ],
