        "ZOONOTIC POTENTIAL": {
          "present": true,
          "status": "content",
          "source_heading": "ZOONOTIC POTENTIAL",
          "canonical_heading": "ZOONOTIC POTENTIAL",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Intestinal form—eggs are not infectious when passed, but can develop in the environment in several days; ingestion of eggs containing infective larvae by humans can cause severe disease, i.e., larval baylisascariasis.",
              "pdf_page": 249,
              "printed_page": 167,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Larval form—infected puppies pose no zoonotic threat.",
              "pdf_page": 249,
              "printed_page": 167,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Alert owner of potential risk to people who may frequent similar habitats to raccoons.",
              "pdf_page": 249,
              "printed_page": 167,
              "column": 3
            }
          ]
        },
