              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intestinal form—adult animals.",
              "pdf_page": 249,
              "printed_page": 167,
              "column": 1,
              "subheading": "•Dogs."
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Larval form—puppies; suspect only severe",
              "pdf_page": 249,
              "printed_page": 167,
              "column": 1,
              "subheading": "•Dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "cases have been reported; infection with only",
              "pdf_page": 249,
              "printed_page": 167,
              "column": 1,
              "subheading": "•Dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "a few larvae probably does not cause severe",
              "pdf_page": 249,
              "printed_page": 167,
              "column": 1,
              "subheading": "•Dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "disease in most puppies.",
              "pdf_page": 249,
              "printed_page": 167,
              "column": 1,
              "subheading": "•Dogs."
            }
          ]
        },
        "SIGNS": {
          "present": true,
