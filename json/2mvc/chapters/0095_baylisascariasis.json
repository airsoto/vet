  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Disease caused by the raccoon roundworm, Baylisascaris procyonis.",
              "pdf_page": 249,
              "printed_page": 167,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Two forms reported in dogs—intestinal infection occurring in adults; visceral disease caused by larval migration in puppies.",
              "pdf_page": 249,
              "printed_page": 167,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infection of raccoons occurs by ingestion of eggs or larvae in tissues of mammalian paratenic hosts.",
              "pdf_page": 249,
              "printed_page": 167,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs are infected by ingestion of infective eggs or paratenic hosts, from which they develop patent infections with adult worms in small intestine; puppies, probably infected by the ingestion of eggs, develop visceral disease.",
              "pdf_page": 249,
              "printed_page": 167,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs with intestinal infection are typically without signs; puppies with larval baylisascariasis show signs of neurologic disease.",
              "pdf_page": 249,
              "printed_page": 167,
              "column": 1
            }
          ]
        },
