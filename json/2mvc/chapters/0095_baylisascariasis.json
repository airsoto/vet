        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Larval form—based on lesions of toxocariasis or baylisascariasis in humans, lesions may appear on abdominal ultrasound or CT scans as small, single or multiple, ill-defined, oval or elongated, low-attenuating lesions in liver parenchyma.",
              "pdf_page": 249,
              "printed_page": 167,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In neurologic lesions, MRI reveals diffuse periventricular white matter disease with atrophy.",
              "pdf_page": 249,
              "printed_page": 167,
              "column": 1
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Intestinal form—direct fecal smear or fecal flotation (Web Figure 1).",
              "pdf_page": 249,
              "printed_page": 167,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Larval form—ophthalmoscopic examination may show migratory tracks in retina, may use advanced imaging methods to visualize lesions in soft tissue or brain.",
              "pdf_page": 249,
              "printed_page": 167,
              "column": 2
            }
          ]
        },
