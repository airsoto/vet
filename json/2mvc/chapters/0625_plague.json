      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Yersinia pestis—Gram-negative, bipolar staining rod; reservoir: wild rodents (sylvatic), ground squirrels, prairie dogs, rabbits,",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "bobcats, coyotes.",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Occurs worldwide; movement of animals results in occurrence in",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "non-endemic areas.",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "United States—",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Western states/Hawaii.",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Common May–",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "October.",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bacterium transmitted by infected fleas, also by ingestion of infected rodents; incubation period 2–7 days after infection.",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bacteria migrate from skin lymphatics to regional lymph nodes (LN), survive phagocytosis and multiply in LN; phagocytic",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "cells rupture.",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fever and painful lymphadenopathy (bubo); intense local inflammation results in bubonic plague; intermittent bacteremia; LN rupture; may become septicemic with or without LN",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "involvement.",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—severe fatal disease.",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—naturally resistant.",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Potential bioterrorist agent (beware of clusters of cases).",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            }
          ]
        },
