        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—exhibit mild fever/depression.",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—exhibit bubonic/pneumonic/",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "septicemic forms.",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bubonic (cats):",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Most common form.",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Buboes—head and",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "neck; marked lymphadenopathy; if patient survives long enough, LN abscess, rupture,",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "form fistulae to skin.",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Fever: 103–105°F",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "(39.5–40.5°C).",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Lethargy, ataxia, coma.",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Enlarged tonsils, oral ulcers.",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Vomiting,",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "diarrhea, anorexia.",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Dehydration.",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Ocular",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "discharge.",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Weight loss.",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Septicemic (cats):",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Rare.",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Septicemia without lymphadenopathy",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "or abscess formation.",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Other signs same as",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "bubonic.",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pneumonic (cats):",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Severe disease;",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "greatest risk for spread to humans (euthanasia strongly recommended to prevent zoonotic spread).",
              "pdf_page": 1162,
              "printed_page": 1080,
              "column": 1
            }
          ]
        },
