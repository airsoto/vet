            }
          ]
        },
        "CAUSES": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES",
          "canonical_heading": "CAUSES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Failure of the palatine shelves to fuse during development at 25–28 days of gestation.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Foreign body, vehicular, or bite trauma.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Oncologic surgery for neoplasms of the hard palate and/or lateral maxilla.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Wound dehiscence following maxillofacial reconstructive surgery.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 2
            }
          ]
        },
