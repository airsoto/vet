        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Consider aerobic bacterial culture and sensitivity of nasal tissue in cases of chronic rhinitis.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiographs are recommended to rule out aspiration pneumonia.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "MRI or CT imaging is recommended prior to oncologic surgery for imaging of the maxillary/palatal lesion.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Three-view thoracic radiographs are recommended to check for distant metastasis before operating patients with neoplasms.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Sedated oral examination.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary rhinitis is usually self-limiting and resolves following surgical repair.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Long-term (4–6 weeks) antimicrobial therapy based on culture and sensitivity may be necessary to treat the chronic rhinitis.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 2
            }
          ]
        }
      }
    },
