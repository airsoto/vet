        "DIET": {
          "present": true,
          "status": "content",
          "source_heading": "DIET",
          "canonical_heading": "DIET",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Preoperative diet should be small-dog food “meatballs” fed by hand or a diet with a consistency that does not cause potential aspiration pneumonia.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Postoperative diet should be a thick liquid consistency for the first 2 weeks.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 3
            }
          ]
        },
        "CLIENT EDUCATION": {
          "present": true,
          "status": "content",
          "source_heading": "CLIENT EDUCATION",
          "canonical_heading": "CLIENT EDUCATION",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "A palatal defect requires surgery for repair.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Multiple surgeries may be required to repair the palatal defect.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Medical management is ineffective and is only indicated when multiple surgical attempts to repair the palatal defect have failed.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "There is a higher surgical success rate in older puppies.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tube feeding may be required for the neonate patient until surgery, or until the patient can eat a diet of appropriate consistency.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary rhinitis is expected and self-limiting with clinical signs more of a nuisance than pathologic.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 3
            }
          ]
        },
        "SURGICAL CONSIDERATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "SURGICAL CONSIDERATIONS",
          "canonical_heading": "SURGICAL CONSIDERATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "The surgical goal is to provide a soft tissue barrier or layer to reestablish and segregate the oral and nasal cavities.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Congenital secondary cleft palate— recommend using a sliding bipedicle flap repair technique or an overlapping flap repair technique.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Traumatic palatal defect—recommend either a buccal mucosal flap repair technique or hard palate mucoperiosteal flap repair",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Palatal defect following oncologic surgery— recommend either a buccal mucosal flap repair technique and/or hard palate mucoperiosteal flap repair technique.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Palatal defect following maxillofacial reconstruction dehiscence—recommend and/or hard palate mucoperiosteal flap repair",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lavage the nasal cavity before surgery to remove any foreign material or debris that may have accumulated in the nose.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "A permanent silastic obturator may used to occlude small palatal defects in refractory cases where surgery has failed multiple times.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 3
            }
          ]
        },
