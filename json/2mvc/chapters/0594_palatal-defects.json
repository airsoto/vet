        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Difficulty nursing.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Regurgitation.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nasal discharge; often mucopurulent.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sneezing.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gagging when drinking water or eating.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Poor growth.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lethargy and depression in chronic cases with severe secondary rhinitis.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cough in cases of secondary aspiration pneumonia.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "General Comments",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Dogs with primary or secondary cleft palate",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "should be neutered since the condition is",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "considered to be inherited.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 1,
              "subheading": "General Comments"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Signs reported by the owner as above; or",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 2,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "following trauma or oncologic surgery.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 2,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hard and/or soft plate defect",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "communicating with the nasal cavity.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nasal discharge.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic auscultation for aspiration",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "pneumonia.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Patient is “poor doer.”",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 2,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Check for other congenital abnormalities.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 2,
