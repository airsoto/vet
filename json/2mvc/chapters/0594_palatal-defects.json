        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary to congenital cleft of the secondary palate to include the hard and/or soft palate.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary to a traumatic injury causing disruption of the lateral maxilla and/or hard palate.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary to resective surgery for neoplasms of the lateral maxilla and/or hard palate.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Secondary to extraction of maxillary canine and rostral premolar teeth (see Oronasal Fistula).",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 1
            }
          ]
        },
        "SYSTEMS AFFECTED": {
          "present": true,
          "status": "content",
          "source_heading": "SYSTEMS AFFECTED",
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Gastrointestinal (oral cavity).",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 1
            }
          ]
        },
        "GENETICS": {
          "present": true,
          "status": "content",
          "source_heading": "GENETICS",
          "canonical_heading": "GENETICS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "May be inherited or secondary to intrauterine abnormality.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 1
            }
          ]
        },
        "INCIDENCE/PREVALENCE": {
          "present": true,
          "status": "content",
          "source_heading": "INCIDENCE/PREVALENCE",
          "canonical_heading": "INCIDENCE/PREVALENCE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary cleft palate is an abnormality of the lip and premaxilla and is rarely associated with a palatal defect communicating with the nasal cavity.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Brachycephalic breeds are predisposed to primary cleft palate.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Breed predilection for congenital cleft of the secondary palate.",
              "pdf_page": 1107,
              "printed_page": 1025,
              "column": 1
            }
          ]
        },
        "GEOGRAPHIC DISTRIBUTION": {
          "present": false,
          "status": "missing",
