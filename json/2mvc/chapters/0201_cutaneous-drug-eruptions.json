          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Any drug.",
              "pdf_page": 432,
              "printed_page": 350,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Can occur after first dose or after weeks to months of administration.",
              "pdf_page": 432,
              "printed_page": 350,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exfoliative erythroderma—most often associated with shampoos and dips; also",
              "pdf_page": 432,
              "printed_page": 350,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "reaction to topical ear medications (in ear canals and on concave pinnae).",
              "pdf_page": 432,
              "printed_page": 350,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Eosinophilic dermatitis with edema— strong association with concurrent acute gastrointestinal disease.",
              "pdf_page": 432,
              "printed_page": 350,
              "column": 2
            }
          ]
        }
      }
