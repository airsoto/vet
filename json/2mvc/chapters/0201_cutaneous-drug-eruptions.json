        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs and cats.",
              "pdf_page": 432,
              "printed_page": 350,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May have a familial basis (e.g., rabies vaccine reactions in canine littermates).",
              "pdf_page": 432,
              "printed_page": 350,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Pruritus.",
              "pdf_page": 432,
              "printed_page": 350,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Macular and papular rashes—commonly accompany pruritus as nonspecific sign of inflammation.",
              "pdf_page": 432,
              "printed_page": 350,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exfoliative erythroderma—diffuse erythematous response caused by vasodilation; often leads to exfoliation (diffuse scaling).",
              "pdf_page": 432,
              "printed_page": 350,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urticaria/angioedema—immediate (type I) hypersensitivity; requires prior sensitization; increased vascular permeability leads to fluid leakage.",
              "pdf_page": 432,
              "printed_page": 350,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypersensitivity vasculitis—type III response; inflammation of cutaneous vasculature; results in poor blood flow and anoxic injury to recipient tissue.",
              "pdf_page": 432,
              "printed_page": 350,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Eosinophilic dermatitis with edema (Wells-like syndrome) of dogs—deeply erythematous plaques or macules (may be targetoid) accompanied by marked edema; localized, regional, or generalized distribution; clinical appearance of lesions may be indistinguishable from vasculitis and erythema multiforme (EM).",
              "pdf_page": 432,
              "printed_page": 350,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "EM—erythematous macules or plaques expand peripherally and may clear in center (targetoid); multiple shapes/forms noted.",
              "pdf_page": 432,
              "printed_page": 350,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Stevens-Johnson syndrome (SJS)—similar to toxic epidermal necrolysis (TEN) with less extensive epidermal detachment (<30%) and often involvement of oral mucosa.",
              "pdf_page": 432,
              "printed_page": 350,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "TEN—extensive (>30%) necrosis and sloughing of epidermis in sheets; results in moist and intensely inflamed skin surface.",
              "pdf_page": 432,
              "printed_page": 350,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Drug-induced pemphigus/pemphigoid— least common drug reaction in animals; can closely mimic autoimmune (spontaneous) disease; symptoms may persist after drug withdrawal.",
              "pdf_page": 432,
              "printed_page": 350,
              "column": 1
            }
          ]
        },
        "CAUSES": {
