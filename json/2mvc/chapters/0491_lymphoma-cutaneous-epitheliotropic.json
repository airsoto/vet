          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cutaneous epitheliotropic lymphoma— most common form of cutaneous T-cell lymphoma.",
              "pdf_page": 940,
              "printed_page": 858,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "An uncommon malignant neoplasia of dogs and cats.",
              "pdf_page": 940,
              "printed_page": 858,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sézary syndrome—rare; cutaneous lesions, invasion of peripheral lymph nodes by neoplastic lymphocytes, and leukemia occur simultaneously.",
              "pdf_page": 940,
              "printed_page": 858,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pagetoid reticulosis—rare; the lymphoid infiltrate is confined to the epidermis and adnexal structures in the early stages of the disease and extends to the dermis in the late stages.",
              "pdf_page": 940,
              "printed_page": 858,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Systems affected—hemic/lymphatic/immune; skin/exocrine.",
              "pdf_page": 940,
              "printed_page": 858,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Synonyms—mycosis fungoides, lymphoma epidermotropic.",
              "pdf_page": 940,
              "printed_page": 858,
              "column": 1
            }
          ]
        },
