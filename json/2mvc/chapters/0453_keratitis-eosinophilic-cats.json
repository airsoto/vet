    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Topical corticosteroids—1% prednisolone acetate or 0.1% dexamethasone sodium phosphate q6–12h for 5–7 days, then gradually taper to the lowest effective frequency of application or discontinue.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Topical 1–2% cyclosporine A q8–12h, then tapered to lowest effective frequency of application or discontinued. Can use in cats in which oral megestrol acetate and topical corticosteroids are contraindicated. May be irritating or cause blepharitis.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Topical 0.5% megestrol acetate q8–12h initially, then tapered to lowest effective frequency or discontinued.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Adjunctive topical or systemic antiviral therapy may be warranted in cases with history or clinical signs compatible with FHV-1 infection.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Subconjunctival corticosteroids— triamcinolone acetonide (0.1–0.2 mL q3–7 days); only in cats that are difficult to treat with topical medications.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Systemic prednisolone—2.2 mg/kg PO q12h and taper. Use only if a cat will not tolerate topical therapy or oral megestrol acetate.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Megestrol acetate—2.5 mg PO q24h for 3–5 days, then 2.5 mg PO q48h for 3–5 days, then gradually decrease frequency to the lowest effective frequency or discontinue.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 2
            }
          ]
        },
        "CONTRAINDICATIONS": {
          "present": false,
