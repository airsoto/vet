    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Response to therapy is usually rapid.",
          "pdf_page": 877,
          "printed_page": 795,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Complete resolution may take several days to months. May require long-term therapy.",
          "pdf_page": 877,
          "printed_page": 795,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Corneal vascularization and infiltrate may resolve completely with minimal corneal scarring.",
          "pdf_page": 877,
          "printed_page": 795,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Recurrences in both the short and long term are common.",
          "pdf_page": 877,
          "printed_page": 795,
          "column": 3
        }
      ],
