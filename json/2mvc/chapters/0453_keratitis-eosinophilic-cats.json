  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Presumed immune-mediated inflammation of the cornea characterized by perilimbal corneal vascularization, white-pink corneal infiltrate, and corneal edema.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Synonym—proliferative keratitis.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
