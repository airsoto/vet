          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Young adult to middle-aged cats.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Unilateral or bilateral.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Variable ocular pain, often minimal.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Serous to mucoid ocular discharge.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Limbal superficial corneal vascularization 90–360° (temporal or inferior nasal quadrants are first affected).",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "White to pink, flat or raised granular corneal infiltrate.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Multifocal, small, white gritty corneal deposits.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Corneal edema.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Corneal ulceration may be present.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Conjunctival and third eyelid hyperemia, chemosis, and thickening with possible cobblestone surface texture.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Feline herpesvirus-1 (FHV-1) may be associated, but exact role is unclear.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exact etiopathogenesis unknown; proposed theories are: (1) type I hypersensitivity with IgE-mediated mast cell and eosinophil degranulation, (2) type IV reaction where sensitized T-lymphocytes stimulate eosinophil-mediated corneal damage.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bacterial and fungal infection are not consistent etiologic causes, although secondary bacterial keratitis may occur.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic corneal ulceration with secondary corneal vascularization (granulation tissue).",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "FHV-1 stromal keratitis—appears similar, but lacks proliferative component, with more severe ocular pain and corneal ulceration.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Corneal neoplasia: (1) lymphoma— concurrent conjunctival and/or uveal infiltration is common, (2) squamous cell carcinoma—rarely involves cornea in cats.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chlamydia psittaciorMycoplasma felis— usually conjunctival diseases without corneal involvement.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Peripheral eosinophilia may be present.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "PCR for FHV-1 has limited diagnostic value since healthy cats may have positive results.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Immunofluorescent antibody test (IFA) testing forChlamydia psittaci.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "IMAGING",
          "content_blocks": []
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Corneal cytology provides definitive diagnosis and should be done first. Typically numerous eosinophils, free eosinophil granules and/or mast cells, neutrophils, lymphocytes, plasma cells, and epithelial cells are seen.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytology helps rule out chlamydia and mycoplasma.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fluorescein staining to evaluate for corneal ulceration.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Keratectomy and histopathology may confirm diagnosis in chronic or nonresponsive cases.",
              "pdf_page": 877,
              "printed_page": 795,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
