          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Urine Alkalinizers",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Consider in aciduric patients despite dietary",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 2,
              "subheading": "Urine Alkalinizers"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "therapy.",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 2,
              "subheading": "Urine Alkalinizers"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Potassium citrate or sodium bicarbonate—",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 2,
              "subheading": "Urine Alkalinizers"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "target urine pH of 7.0–7.5.",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 2,
              "subheading": "Urine Alkalinizers"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Allopurinol",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Adjust dosage of allopurinol in context of",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 2,
              "subheading": "Allopurinol"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "urine concentration of uric acid, and quantity",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 2,
              "subheading": "Allopurinol"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "of dietary purines (see Urolithiasis, Urate).",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 2,
              "subheading": "Allopurinol"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Allopurinol-induced uroliths may dissolve",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 2,
              "subheading": "Allopurinol"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "by discontinuing allopurinol therapy and",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 2,
              "subheading": "Allopurinol"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "feeding a low-purine diet.",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 2,
              "subheading": "Allopurinol"
            }
          ]
        },
