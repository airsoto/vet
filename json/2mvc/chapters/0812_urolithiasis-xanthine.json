  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Xanthine, a product of purine degradation, is converted to uric acid by xanthine oxidase. Naturally occurring or drug-induced impairment of xanthine oxidase results in hyperxanthinemia and xanthinuria.",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Naturally occurring xanthinuria is likely caused by a familial or congenital defect in xanthine oxidase activity. In cavalier King Charles spaniels, an autosomal recessive mode of inheritance has been found.",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acquired xanthinuria is a complication of allopurinol therapy. High-purine diets increase the risk of xanthinuria in these patients.",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Xanthine is the least soluble purine excreted in urine.",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
        "PATHOPHYSIOLOGY": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": []
        },
