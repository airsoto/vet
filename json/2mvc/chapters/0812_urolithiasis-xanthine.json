          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog and cat. Naturally occurring xanthinuria is more common in cats.",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Naturally occurring xanthinuria and xanthine uroliths have occurred in young cavalier King Charles spaniels.",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—adult males (66%) and females (33%) (mean age 3.3 years; range 2 months– 13 years). Most common in the domestic shorthair and domestic longhair breeds.",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dependent on stone location, size, and number; may be asymptomatic.",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pollakiuria, dysuria, hematuria, and voiding of small, smooth, yellow uroliths. Complete outflow obstruction may result in azotemia.",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nephroliths may be associated with hydro nephrosis and renal insufficiency.",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Xanthinuria.",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Genetic inheritance in some breeds.",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—uroliths often recur unless prophylactic therapy is initiated.",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Approximately 11% of cats have reoccurrence of xanthine uroliths. Urolith formation enhanced by aciduria, highly concentrated urine, and incomplete and infrequent micturition.",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In animals given excessive allopurinol, xanthinuria is enhanced by failure to appropriately restrict dietary purine precursors.",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other causes of pollakiuria, dysuria, hematuria, or outflow obstruction.",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Differentiate from other urolith types by urinalysis, radiography, and quantitative stone analysis.",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Xanthine crystals cannot be distinguished from urate by light microscopy; both are usually yellow-brown and may form varying sized spherules.",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Infrared spectroscopy, X-ray diffraction, or other quantitative techniques are required to differentiate xanthine from ammonium urate, sodium urate, and uric acid.",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "High-pressure liquid chromatography of urine to detect xanthine, hypoxanthine, and other purine metabolites.",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Genetic testing for xanthinuria type 2a, which involves a mutation in molybdenum cofactor sulfurase (performed at University of Minnesota).",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Radiography—similar density to soft tissue; stones cannot be reliably detected.",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ultrasonography, double contrast cysto graphy, and IV urography aid in detecting uroliths and their location.",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "OTHER DIAGNOSTIC PROCEDURES",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May be detected by urethrocystoscopy.",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 2,
              "subheading": "OTHER DIAGNOSTIC PROCEDURES"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Uroliths may be retrieved by aspiration via",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 2,
              "subheading": "OTHER DIAGNOSTIC PROCEDURES"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "a transurethral catheter or voiding",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 2,
              "subheading": "OTHER DIAGNOSTIC PROCEDURES"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "urohydropropulsion.",
              "pdf_page": 1467,
              "printed_page": 1385,
              "column": 2,
              "subheading": "OTHER DIAGNOSTIC PROCEDURES"
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": []
