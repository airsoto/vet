    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Medical dissolution protocols for xanthine uroliths have not been developed.",
          "pdf_page": 1467,
          "printed_page": 1385,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Remove small urocystoliths by voiding urohydropropulsion.",
          "pdf_page": 1467,
          "printed_page": 1385,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Minimally invasive surgery can remove larger active uroliths from the lower urinary tract.",
          "pdf_page": 1467,
          "printed_page": 1385,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Minimize further growth of existing uroliths by reducing dietary risk factors. Discontinue or reduce allopurinol dosages.",
          "pdf_page": 1467,
          "printed_page": 1385,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Consider canned renal-failure diets to increase urine volume, minimize purine precursors, and prevent aciduria in cats.",
          "pdf_page": 1467,
          "printed_page": 1385,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Consider perineal urethrostomy for recurrent urethral obstruction in male cats.",
          "pdf_page": 1467,
          "printed_page": 1385,
          "column": 2
        }
      ],
