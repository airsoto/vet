        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually middle-aged dogs.",
              "pdf_page": 917,
              "printed_page": 835,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No breed predilection definitively demonstrated; Labrador retrievers possibly overrepresented.",
              "pdf_page": 917,
              "printed_page": 835,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May be more common in females than in males.",
              "pdf_page": 917,
              "printed_page": 835,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Large, diffuse, soft tissue mass.",
              "pdf_page": 917,
              "printed_page": 835,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinically appears as localized muscle swelling and/or distended abdomen if abdominal component.",
              "pdf_page": 917,
              "printed_page": 835,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infiltration of pelvic, thigh, shoulder, sternal, and lateral cervical musculature most common; recent evidence suggests no clear site prediction.",
              "pdf_page": 917,
              "printed_page": 835,
              "column": 1
            }
          ]
        },
