    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Therapeutic recommendations— guided by size, anatomic location and quality of life to determine whether and when to recommend surgery and adjunctive radiation therapy for incomplete surgical margins.",
              "pdf_page": 917,
              "printed_page": 835,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reevaluations—schedule as dictated by tumor growth and choice of therapy.",
              "pdf_page": 917,
              "printed_page": 835,
              "column": 3
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": []
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Temporary acute side effects (e.g., moist dermatitis and alopecia) expected with radiation therapy; consultation with a radiation oncologist is recommended regarding specific, anatomic site-related side effects.",
              "pdf_page": 917,
              "printed_page": 835,
              "column": 3
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Surgical cure only possible if all affected tissues can be removed. Long-term control of tumor growth may be attained with external beam radiation therapy alone or in combination with surgery.",
              "pdf_page": 917,
              "printed_page": 835,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lack of metastatic potential affords a good prognosis if local tumor growth can be controlled.",
              "pdf_page": 917,
              "printed_page": 835,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If liposarcoma diagnosed, behavior is similar to other soft tissue sarcomas, therefore consult relevant literature on these tumors.",
              "pdf_page": 917,
              "printed_page": 835,
              "column": 3
            }
          ]
        }
      }
    },
