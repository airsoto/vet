  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Invasive, non-encapsulated, lipoma variant that does not metastasize.",
              "pdf_page": 917,
              "printed_page": 835,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "A benign neoplasm that infiltrates soft tissues, particularly muscles, and including fasciae, tendons, nerves, blood vessels, salivary glands, lymph nodes, and joint capsules, and occasionally bones.",
              "pdf_page": 917,
              "printed_page": 835,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Muscle infiltration typically extensive.",
              "pdf_page": 917,
              "printed_page": 835,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Surgical cure—possible but difficult to obtain. Radiation therapy has utility to control growth.",
              "pdf_page": 917,
              "printed_page": 835,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Occurs much less frequently than does lipoma.",
              "pdf_page": 917,
              "printed_page": 835,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
