          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Soft tissue sarcoma, particularly liposarcoma, hemangiopericytoma, myxosarcoma, rhabdomyosarcoma, and fibrosarcoma.",
              "pdf_page": 917,
              "printed_page": 835,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lipoma.",
              "pdf_page": 917,
              "printed_page": 835,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intermuscular lipoma.",
              "pdf_page": 917,
              "printed_page": 835,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mast cell neoplasia.",
              "pdf_page": 917,
              "printed_page": 835,
              "column": 1
            }
          ]
        },
