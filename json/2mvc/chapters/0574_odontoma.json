  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Odontoma—oral mass that arises from odontogenic epithelial and mesenchymal origin:",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Ameloblastic fibro-odontoma (AFO)",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(formerly ameloblastic odontoma)— radiolucent, mass with osteolysis and varying amounts of intralesional mineralization.",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Complex odontoma—radiodense mass",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "with fully differentiated dental components (more organized than AFO), but unorganized at the cellular level with no tooth-like structures.",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Compound odontoma—mass with fully",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "differentiated dental components resulting in the presence of denticles (tooth-like structures).",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hamartoma—proliferation of normal cellular components with an abnormal organization; not a true neoplasm (applicable to complex and compound odontoma types).",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "A definition to help delineate the three",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "types of odontoma, not a type in itself.",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
