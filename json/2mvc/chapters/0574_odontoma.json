        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Typically found in young animals.",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Oral swelling or mass.",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Delayed deciduous tooth exfoliation or delayed or abnormal tooth eruption at site.",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "AFO:",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Most lesions are radiolucent with single or",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "multiple (multilocular) expansile lesions of irregular configurations of dental components.",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Some lesions are associated with",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "impacted teeth.",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Neoplastic mechanism, may recur (World",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Health Organization [WHO]—benign neoplasm).",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Complex:",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Disorganized tissues within a thin,",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "fibrous capsule.",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Radiographically, often a radial structure",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "of hard tissue particles inside a radiolucent zone, embedded in the maxilla or mandible.",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Erupted teeth in that area may allow for",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "communication between the odontoma and oral cavity, with a potential for bacterial contamination and infection.",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Compound:",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "The presence of denticles is patho-",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "gnomonic.",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Small, rudimentary teeth with crown",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "formed, but the roots are often misshapen (dilacerated).",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Denticles often associated with",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "radiolucency.",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "May be embedded or have some extent of",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "eruption.",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 1
            }
          ]
        },
