        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "AFO:",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "AFO",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mixed odontogenic tumor with",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 2,
              "subheading": "AFO"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "differentiation of odontoblasts, ameloblasts",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 2,
              "subheading": "AFO"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and cementoblasts embedded in cellular",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 2,
              "subheading": "AFO"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Complex and compound odontoma:",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 2,
              "subheading": "AFO"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "mesenchymal tissue.",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 2,
              "subheading": "AFO"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reciprocal inductive interaction of",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 2,
              "subheading": "AFO"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "epithelial and mesenchymal tissues.",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 2,
              "subheading": "AFO"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "WHO classification as a benign neoplasm",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 2,
              "subheading": "AFO"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "with possible reoccurrence.",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 2,
              "subheading": "AFO"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Complex Odontoma",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Inductive processes resulting in dental",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 2,
              "subheading": "Complex Odontoma"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "components but not fully organized.",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 2,
              "subheading": "Complex Odontoma"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Compound Odontoma",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Differentiation of dental components into",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 2,
              "subheading": "Compound Odontoma"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "varying levels of organization—denticles.",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 2,
              "subheading": "Compound Odontoma"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "None indicated.",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 2,
              "subheading": "Compound Odontoma"
            }
          ]
        }
      }
    },
