          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 1,
              "text": "Ameloblastic fibroma—similar to AFO",
              "pdf_page": 1072,
              "printed_page": 990,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "but would contain no hard tissue. Recurrence, local infection, fragile jaw",
