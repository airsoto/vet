  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Rare condition characterized by cutaneous lesions that serve as markers of internal neoplasia.",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most affected cats have pancreatic adenocarcinoma with metastases to liver, lungs, pleura, and/or peritoneum; reports of other neoplasias.",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Link between internal malignancies and cutaneous lesions is unknown; may involve cytokines producing atrophy of hair follicles.",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
