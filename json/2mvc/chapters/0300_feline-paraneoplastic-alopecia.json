        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Domestic shorthair cats only reported cases. Median age—13 years; range: 7–16 years.",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Decrease in appetite followed by rapid weight loss and excessive shedding.",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pruritus—variable; sometimes with excessive grooming.",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hairs epilate easily leading to severe alopecia on ventral neck, abdomen, medial thighs; rapidly progressive.",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Stratum corneum may “peel,” leading to glistening appearance to skin.",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Alopecic skin is shiny, inelastic, and thin, but not fragile.",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gray lentigines may develop in alopecic areas.",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Footpads may be fissured and/or scaly; often painful.",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Majority of cases are associated with underlying pancreatic adenocarcinoma.",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other associated tumor types include cholangiocarcinoma, hepatocellular carcinoma, intestinal carcinoma, neuro endocrine pancreatic neoplasia, and hepatosplenic plasma cell tumor.",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperadrenocorticism—polyuria, polydipsia, and skin fragility.",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperthyroidism—polyphagia.",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Feline symmetrical alopecia—hair loss self-induced; not associated with easy epilation.",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thymoma—skin is thick, scaly, and fissured; lymphocytic interface dermatitis; radiographs reveal thoracic mass.",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Demodicosis—mites not associated with paraneoplastic alopecia.",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dermatophytosis—hair loss often associated with breakage, not spontaneous shedding; inappetence and weight loss rare.",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Alopecia areata—rarely involves entire ventral surface; inappetence and weight loss rare.",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Telogen effluvium—not associated with miniaturization of hair follicles.",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Skin fragility syndrome—markedly thin skin with lacerations; not always associated with exfoliation.",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "No consistent abnormalities; may be helpful in ruling out other differentials.",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
