        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Progressive deterioration.",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Endocrine (thyroid profiles and",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Supportive care—ultrasonography and dexamethasone suppression test)—endocrine thoracic radiographs may demonstrate disease. progression of metastatic disease.",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Skin scrapings—demodicosis.",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Death most often occurs within 2–20",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "KOH examination of hairs and/or fungal weeks after onset of skin lesions. culture—dermatophytosis.",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Skin cytology—possible secondary Malasseziainfection (causing pruritus).",
              "pdf_page": 600,
              "printed_page": 518,
              "column": 2
            }
          ]
        },
        "IMAGING": {
