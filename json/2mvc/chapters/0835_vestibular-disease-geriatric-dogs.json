        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Fluid and electrolyte imbalances and decompensation of preexistent renal insufficiency may follow vomiting and/or insufficient fluid and food intake.",
              "pdf_page": 1505,
              "printed_page": 1423,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pressure sores/abrasions.",
              "pdf_page": 1505,
              "printed_page": 1423,
              "column": 2
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Improvement of clinical signs usually starts within 72 hours with gradual resolution of vomiting and improvement of nystagmus and vestibular ataxia.",
              "pdf_page": 1505,
              "printed_page": 1423,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Head tilt and ataxia—significant improve ment usually occurs over 7–10 days; if no improvement other causes of peripheral vestibular disease should be pursued; mild head tilt may persist.",
              "pdf_page": 1505,
              "printed_page": 1423,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most patients return to normal within 2–3 weeks.",
              "pdf_page": 1505,
              "printed_page": 1423,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Recurrence—repeat episodes of geriatric vestibular disease can occur on the same or opposite side but are uncommon; brief return of signs may occur with stress (e.g., anesthesia).",
              "pdf_page": 1505,
              "printed_page": 1423,
              "column": 2
            }
          ]
        }
      }
    },
