        "CAUSES": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES",
          "canonical_heading": "CAUSES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Blepharitis.",
              "pdf_page": 1265,
              "printed_page": 1183,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Conjunctivitis.",
              "pdf_page": 1265,
              "printed_page": 1183,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Keratitis.",
              "pdf_page": 1265,
              "printed_page": 1183,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Episcleritis or scleritis.",
              "pdf_page": 1265,
              "printed_page": 1183,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anterior uveitis.",
              "pdf_page": 1265,
              "printed_page": 1183,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Glaucoma.",
              "pdf_page": 1265,
              "printed_page": 1183,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyphema.",
              "pdf_page": 1265,
              "printed_page": 1183,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Orbital disease—usually the orbital abnormality is more prominent.",
              "pdf_page": 1265,
              "printed_page": 1183,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Superficial (conjunctival) vessels—originate near the fornix, move with the conjunctiva, branch repeatedly, and blanch quickly with topical 2.5% phenylephrine or 1:100,000 epinephrine. Suggests ocular surface disorders (e.g., conjunctivitis, superficial keratitis, blepharitis).",
              "pdf_page": 1265,
              "printed_page": 1183,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Deep (episcleral) vessels—originate near the limbus, branch infrequently, do not move with the conjunctiva, and blanch slowly or incompletely with topical sympathomimetics. Suggests episcleritis or intraocular disease (e.g., anterior uveitis or glaucoma).",
              "pdf_page": 1265,
              "printed_page": 1183,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Discharge—mucopurulent to purulent: typical of ocular surface disorders and blepharitis; serous or none: typical of intraocular disorders.",
              "pdf_page": 1265,
              "printed_page": 1183,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Swollen or inflamed eyelids—suggest blepharitis.",
              "pdf_page": 1265,
              "printed_page": 1183,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Corneal opacification, neovascularization, or fluorescein stain retention—suggest keratitis.",
              "pdf_page": 1265,
              "printed_page": 1183,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Aqueous flare or cell (increased protein or cells in the anterior chamber)—confirms diagnosis of anterior uveitis.",
              "pdf_page": 1265,
              "printed_page": 1183,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pupil—miotic: common with anterior uveitis; dilated: common with glaucoma; normal: with blepharitis and conjunctivitis.",
              "pdf_page": 1265,
              "printed_page": 1183,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abnormally shaped or colored irides— suggest anterior uveitis.",
              "pdf_page": 1265,
              "printed_page": 1183,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Luxated or cataractous lenses—suggest glaucoma or anterior uveitis.",
              "pdf_page": 1265,
              "printed_page": 1183,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intraocular pressure (IOP)—high: diagnostic for glaucoma; low: suggests anterior uveitis.",
              "pdf_page": 1265,
              "printed_page": 1183,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Loss of vision—suggests glaucoma, anterior uveitis, or severe keratitis.",
              "pdf_page": 1265,
              "printed_page": 1183,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Glaucoma and anterior uveitis—may complicate hyphema.",
              "pdf_page": 1265,
              "printed_page": 1183,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ocular ultrasonography—if the ocular media are opaque; may define the extent and nature of intraocular disease or identify intraocular tumor.",
              "pdf_page": 1265,
              "printed_page": 1183,
              "column": 2
            }
          ]
        },
