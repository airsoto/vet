    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Depends on specific cause.",
              "pdf_page": 1265,
              "printed_page": 1183,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Generally, control ocular pain, inflammation, infection, and IOP.",
              "pdf_page": 1265,
              "printed_page": 1183,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Carprofen 2.2 mg/kg PO q12h or 4.4 mg/kg PO q24h to control mild inflammation and reduce pain",
              "pdf_page": 1265,
              "printed_page": 1183,
              "column": 3
            }
          ]
        },
        "CONTRAINDICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS",
          "canonical_heading": "CONTRAINDICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Topical corticosteroids—contraindicated if the cornea retains fluorescein stain.",
              "pdf_page": 1265,
              "printed_page": 1183,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Systemic corticosteroids—avoid until infectious systemic causes have been ruled out.",
              "pdf_page": 1265,
              "printed_page": 1183,
              "column": 3
            }
          ]
        },
        "PRECAUTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "PRECAUTIONS",
          "canonical_heading": "PRECAUTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Topical aminoglycosides—may be irritating; may impede reepithelization if used frequently or at high concentrations.",
              "pdf_page": 1266,
              "printed_page": 1184,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Topical solutions—may be preferable to ointments if corneal perforation is possible.",
              "pdf_page": 1266,
              "printed_page": 1184,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Atropine—may exacerbate keratoconjunctivitis sicca (KCS) and glaucoma.",
              "pdf_page": 1266,
              "printed_page": 1184,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nonsteroidal anti-inflammatory drugs (NSAIDs)—use with caution in hyphema.",
              "pdf_page": 1266,
              "printed_page": 1184,
              "column": 1
            }
          ]
        },
