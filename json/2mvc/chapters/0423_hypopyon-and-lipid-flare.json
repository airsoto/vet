              "printed_page": 742,
              "column": 1,
              "subheading": "Hypopyon"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Lipid Flare",
              "pdf_page": 824,
              "printed_page": 742,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diffuse milky appearance to anterior",
              "pdf_page": 824,
              "printed_page": 742,
              "column": 1,
              "subheading": "Lipid Flare"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "chamber.",
              "pdf_page": 824,
              "printed_page": 742,
              "column": 1,
              "subheading": "Lipid Flare"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Concurrent ophthalmic signs may",
