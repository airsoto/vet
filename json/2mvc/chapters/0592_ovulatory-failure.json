        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Intact bitch or queen of any age—greater predisposition in older females.",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reported in 1.2% of bitches presented for breeding management.",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No breed predisposition for anovulation; follicular cysts reported more commonly in German shepherd dog, Malamute, golden retriever, bouvier des Flandres, and Labrador retriever.",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Heritability unknown.",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Prolonged proestrus or estrus.",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Edematous vulva.",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sanguineous vulvar discharge (bitch).",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anestrus.",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Decreased interestrous interval.",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bilaterally symmetric alopecia (progressive, nonpruritic).",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If neoplasia—abdominal mass ± ascites.",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If chromosome abnormality—genitalia ranges from infantile or ambiguous to normal to enlarged clitoris or os clitoris; small stature; anestrus.",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Failure of release of gonadotropin-releasing hormone (GnRH) or luteinizing hormone (LH).",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Failure of receptors on the follicular wall to respond to LH.",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Failure of the follicles to produce adequate estrogen to elicit GnRH surge.",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Functional follicular cysts—may mimic normal estrous cycle initially, but estrus persists and ovulation does not occur.",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Immune-mediated oophoritis.",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cachexia or obesity.",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Stress (performance, travel, kennel).",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Adrenal disease.",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Prolonged proestrus (up to 30 days) or estrus (up to 30 days).",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Split heat—anovulatory cycle will be followed by a normal, fertile, ovulatory cycle in 1–8 weeks.",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypoluteoidism.",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Granulosa cell tumor or serous cystadenoma—abdominal mass; enlarged ovary on ultrasound; ± ascites; ± bilaterallysymmetric alopecia.",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ovarian senescence.",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Immune-mediated oophoritis.",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chromosomal abnormality—may develop follicles that either ovulate or regress.",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exogenous estrogen administration or exposure.",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
