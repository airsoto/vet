  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Breakdown in the process of ovulation, without normal corpus luteum formation and progesterone production.",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical signs of prolonged estrogen production; may develop estrogen toxicity.",
              "pdf_page": 1102,
              "printed_page": 1020,
              "column": 1
            }
          ]
        },
