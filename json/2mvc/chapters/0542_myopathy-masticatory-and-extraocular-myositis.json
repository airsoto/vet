          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Neuromuscular—muscles of mastication; extraocular muscles.",
              "pdf_page": 1021,
              "printed_page": 939,
              "column": 1
            }
          ]
        },
