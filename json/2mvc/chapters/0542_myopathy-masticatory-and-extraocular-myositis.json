          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Masticatory—return of jaw mobility and decreased serum creatine kinase activity.",
              "pdf_page": 1022,
              "printed_page": 940,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Extraocular—decreased swelling of extraocular muscles.",
              "pdf_page": 1022,
              "printed_page": 940,
              "column": 1
