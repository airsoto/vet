        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Corticosteroids—undesirable side effects.",
              "pdf_page": 1022,
              "printed_page": 940,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Recurrence of clinical signs—treatment stopped too early.",
              "pdf_page": 1022,
              "printed_page": 940,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Poor clinical response—inadequate dosages of corticosteroids.",
              "pdf_page": 1022,
              "printed_page": 940,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Restrictive strabismus (extraocular myositis).",
              "pdf_page": 1022,
              "printed_page": 940,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Note position of tongue—venous congestion and tongue protrusion may occur under anesthesia.",
              "pdf_page": 1022,
              "printed_page": 940,
              "column": 1
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Masticatory—jaw mobility should return to normal unless the condition is chronic and severe fibrosis develops; good prognosis if treated early with adequate dosages of corticosteroids.",
              "pdf_page": 1022,
              "printed_page": 940,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Extraocular—good response to cortico steroids; good prognosis unless chronic with restrictive strabismus.",
              "pdf_page": 1022,
              "printed_page": 940,
              "column": 1
            }
          ]
        }
      }
    },
