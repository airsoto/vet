        "DEFINITION": {
          "present": true,
          "status": "content",
          "source_heading": "DEFINITION",
          "canonical_heading": "DEFINITION",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Masticatory—focal inflammatory myopathy affecting the muscles of masti cation (temporalis, masseter, and pterygoid muscles) and sparing the limb muscles.",
              "pdf_page": 1021,
              "printed_page": 939,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Extraocular—selectively affects the extraocular muscles, sparing limb and masticatory muscles.",
              "pdf_page": 1021,
              "printed_page": 939,
              "column": 1
            }
          ]
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Masticatory—suspected immune-mediated cause owing to autoantibodies against type 2M fibers and a positive clinical response to immunosuppressive doses of corticosteroids.",
              "pdf_page": 1021,
              "printed_page": 939,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Extraocular—suspected immune-mediated cause owing to positive clinical response to corticosteroids.",
              "pdf_page": 1021,
              "printed_page": 939,
              "column": 1
            }
          ]
        },
        "SYSTEMS AFFECTED": {
