        },
        "PRECAUTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "PRECAUTIONS",
          "canonical_heading": "PRECAUTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Corticosteroids—watch for infection and undesirable side effects.",
              "pdf_page": 1021,
              "printed_page": 939,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical signs may recur if treatment is stopped too soon.",
              "pdf_page": 1021,
              "printed_page": 939,
              "column": 3
            }
          ]
        },
