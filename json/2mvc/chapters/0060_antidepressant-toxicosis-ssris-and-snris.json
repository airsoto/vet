          "printed_page": 102,
          "column": 3
        }
      ],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "[5-HTP], buspirone, bupropion,",
              "pdf_page": 184,
              "printed_page": 102,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Agitation: triptans, LSD).",
              "pdf_page": 184,
              "printed_page": 102,
              "column": 2
            }
          ]
        },
        "CONTRAINDICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS",
          "canonical_heading": "CONTRAINDICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "High risk of serotonin syndrome—other SSRIs, SNRIs, MAOIs, TCAs, amphetamines, 5-HTP, clarithromycin, dextromethorphan, lithium, St. John’s wort.",
              "pdf_page": 185,
              "printed_page": 103,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Low risk of serotonin syndrome—tramadol, fentanyl, amantadine, bupropion, carbamazepine, codeine.",
              "pdf_page": 185,
              "printed_page": 103,
              "column": 1
            }
          ]
        },
        "PRECAUTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "PRECAUTIONS",
          "canonical_heading": "PRECAUTIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Benzodiazepines (e.g., diazepam) are reported by some sources to exacerbate serotonin syndrome and their use for SSRI/SNRI toxicosis is not universally recommended.",
              "pdf_page": 185,
              "printed_page": 103,
              "column": 1
            }
          ]
        },
        "POSSIBLE INTERACTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE INTERACTIONS",
          "canonical_heading": "POSSIBLE INTERACTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Decreased metabolism of SSRIs/SNRIs— cimetidine, diuretics, quinidine, lithium.",
              "pdf_page": 185,
              "printed_page": 103,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Increased levels of medications (decreased metabolism)—theophylline, coumadin, digoxin.",
              "pdf_page": 185,
              "printed_page": 103,
              "column": 1
            }
          ]
        },
        "CONTRAINDICATIONS/POSSIBLE INTERACTIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": []
