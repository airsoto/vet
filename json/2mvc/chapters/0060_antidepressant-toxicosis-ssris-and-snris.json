    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Blood pressure, heart rate, urine color—mon itor hourly, then less frequently as the animal remains stable.",
              "pdf_page": 185,
              "printed_page": 103,
              "column": 1
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Keep medications out of the reach of animals.",
              "pdf_page": 185,
              "printed_page": 103,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Follow label directions when giving serotonergic drugs to animals.",
              "pdf_page": 185,
              "printed_page": 103,
              "column": 2
            }
          ]
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Renal failure secondary to myoglobinuria from rhabdomyolysis; disseminated intravas cular coagulation (DIC) secondary to hyperthermia.",
              "pdf_page": 185,
              "printed_page": 103,
              "column": 2
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Prognosis is good in most cases, with recovery in 12–24 hours.",
              "pdf_page": 185,
              "printed_page": 103,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Patients that present in status epilepticus or with severe hyperthermia have a guarded prognosis.",
              "pdf_page": 185,
              "printed_page": 103,
              "column": 2
            }
          ]
        }
      }
    },
