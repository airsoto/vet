          "canonical_heading": "GEOGRAPHIC DISTRIBUTION",
          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Indoor cats and dogs primarily, although pets may be exposed by houseplants moved outside during summer months.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs tend to chew and destroy the entire plant; cats nibble on leaves.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May occur more often in younger pets that are bored or inquisitive.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Rapid onset, often within minutes of exposure.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Oral—vocalization, pawing at muzzle, head shaking, hypersalivation, edema of lips, tongue or pharynx; rarely gagging, choking, and vomiting.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ocular—pawing at eyes, photophobia, conjunctival swelling.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory—rarely, dyspnea from pharyngeal swelling and inflammation.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Plants in environment.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Insoluble oxalate crystals are arranged in bundles called raphides that are contained in idioblasts within plant stems and leaves.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chewing or biting on plant material releases crystals from stems and leaves until idioblast is emptied.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Crystals act as miniature pins or mechanical irritants to mucous membranes, but are not absorbed systemically.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Potential for chemical irritation with release of prostaglandins, histamine, proteolytic enzymes.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 2
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Caustic agents (alkalis and acids in household products; drain cleaners).",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other agents causing oral irritation (capsaicin, detergents, topical spot-on flea and tick products.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Quaternary ammonium compounds (>2% in cats).",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Stinging nettle (Urtica dioica) ingestion.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Systemic disease-causing oral lesions.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
