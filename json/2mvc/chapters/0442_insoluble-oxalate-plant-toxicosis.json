  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Over 200 species of plants contain insoluble oxalate crystals.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most houseplants are in the Araceae family; many are found in homes and offices.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Common names vary; scientific names must be used for accurate identification.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Insoluble oxalate crystals are not absorbed systemically, and signs are often self-limiting.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Signs are generally limited to irritation of oral mucosa; other signs occur more rarely.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dieffenbachiaspp. (dumbcane) ingestion by dogs and cats has been associated with more serious outcomes, including death.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats ingestingPhilodendronspp. may exhibit more severe clinical signs.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Common plants include:",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Aglaonema commutatum(Chinese",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "evergreen).",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Anthuriumspp. (flamingo flower).",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Arisaema amurense(Jack-in-the-pulpit).",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Dieffenbachiaspp. (dumbcane).",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Epipremnumspp. (pothos, devil’s ivy,",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "variegated philodendron).",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Monstera deliciosa(fruit salad plant).",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Philodendronspp. (sweetheart vine, fiddle",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "leaf).",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Schefflera actionphylla(umbrella plant).",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Spathiphyllumspp. (peace lily).",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Syngoniumspp. (arrowhead vine).",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Zantedeschiaspp. (calla lily).",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 1
            }
          ]
        },
