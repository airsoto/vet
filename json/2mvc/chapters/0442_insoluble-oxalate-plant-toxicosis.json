          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Identify plants in household and keep away from pets.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 3
            }
          ]
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Corneal abrasion or ulcer from pawing at eyes.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Erosive ulcers in mouth and gastrointestinal tract.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pharyngeal edema and death (rare).",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 3
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Most signs are mild to moderate and of short duration, generally lasting 2–4 hours; less often signs last 12–24 hours.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Excellent prognosis as signs are generally self-limiting.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 3
            }
          ]
        }
