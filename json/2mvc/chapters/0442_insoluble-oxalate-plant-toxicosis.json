        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Death rarely occurs.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Few cases with severe erosive, ulcerative glossitis; oropharyngeal edema.",
              "pdf_page": 857,
              "printed_page": 775,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Generally limited to supportive care.",
          "pdf_page": 857,
          "printed_page": 775,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "IV fluids if dehydrated from excessive salivation or vomiting.",
          "pdf_page": 857,
          "printed_page": 775,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Oral—irrigation of oral cavity with copious amounts of cool fluids; small amounts of calcium-containing product (milk, yogurt, etc.) to bind oxalate crystals.",
          "pdf_page": 857,
          "printed_page": 775,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Ocular—lavage for 15 min with tepid water.",
          "pdf_page": 857,
          "printed_page": 775,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Respiratory—endotracheal tube or temporary tracheostomy if dyspnea severe.",
          "pdf_page": 857,
          "printed_page": 775,
          "column": 2
        }
      ],
