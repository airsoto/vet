          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Often confused with allergic or bacterial conjunctivitis.",
              "pdf_page": 882,
              "printed_page": 800,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs with keratoconjunctivitis sicca (KCS) may have concurrent bacterial overgrowth.",
              "pdf_page": 882,
              "printed_page": 800,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Differentiate with Schirmer tear test.",
              "pdf_page": 882,
              "printed_page": 800,
              "column": 1
            }
          ]
        },
