      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Deficiency of the aqueous layer of precorneal tear film.",
              "pdf_page": 882,
              "printed_page": 800,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Causes corneal/conjunctival drying and resultant surface inflammation.",
              "pdf_page": 882,
              "printed_page": 800,
              "column": 1
            }
          ]
        },
