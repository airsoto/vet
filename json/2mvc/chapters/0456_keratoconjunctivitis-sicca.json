        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Common in dog; rare in cat.",
              "pdf_page": 882,
              "printed_page": 800,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Predisposed dog breeds—many brachycephalic and spaniel breeds, miniature schnauzers, poodles, bloodhounds, Samoyeds, West Highland white terriers, and Yorkshire terriers.",
              "pdf_page": 882,
              "printed_page": 800,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inheritance—undefined.",
              "pdf_page": 882,
              "printed_page": 800,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Age of onset—variable and depends on inciting cause.",
              "pdf_page": 882,
              "printed_page": 800,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Conjunctival hyperemia.",
              "pdf_page": 882,
              "printed_page": 800,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mucoid to mucopurulent ocular discharge—intermittent to persistent depending on severity.",
              "pdf_page": 882,
              "printed_page": 800,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Blepharospasm.",
              "pdf_page": 882,
              "printed_page": 800,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Corneal changes—dryness, superficial vascularization, pigmentation, fibrosis, ulceration.",
              "pdf_page": 882,
              "printed_page": 800,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Blepharitis due to ocular exudates.",
              "pdf_page": 882,
              "printed_page": 800,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Severe disease—impaired vision or blindness.",
              "pdf_page": 882,
              "printed_page": 800,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats are less symptomatic than dogs.",
              "pdf_page": 882,
              "printed_page": 800,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Immune-mediated/idiopathic—most common, possibly associated with other immune-mediated diseases (e.g., atopy).",
              "pdf_page": 882,
              "printed_page": 800,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infectious—canine distemper virus; leishmaniasis; chronic blepharoconjunctivitis (e.g., feline herpesvirus).",
              "pdf_page": 882,
              "printed_page": 800,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Iatrogenic—removal of third eyelid gland (especially in at-risk breeds), radiation therapy.",
              "pdf_page": 882,
              "printed_page": 800,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Congenital—Yorkshire terriers overrepresented.",
              "pdf_page": 882,
              "printed_page": 800,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neurologic—loss of parasympathetic innervation to lacrimal gland, trigeminal nerve deficit, or dysautonomia; neurogenic parasym pathetic loss may have ipsilateral dry nose.",
              "pdf_page": 882,
              "printed_page": 800,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Traumatic—after ocular proptosis or orbit inflammation.",
              "pdf_page": 882,
              "printed_page": 800,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Systemic disease—diabetes mellitus, hyper adrenocorticism, hypothyroidism, or any debilitating disease.",
              "pdf_page": 882,
              "printed_page": 800,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Drug-induced—systemic sulfonamides (e.g., trimethoprim-sulfadiazine).",
              "pdf_page": 882,
              "printed_page": 800,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Transient—general anesthesia and atropine.",
              "pdf_page": 882,
              "printed_page": 800,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
