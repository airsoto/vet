    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Provide adequate alveolar ventilation.",
          "pdf_page": 757,
          "printed_page": 675,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Anesthesia—ventilation accomplished manually or mechanically with anesthesia ventilator.",
          "pdf_page": 757,
          "printed_page": 675,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Nonanesthetized patient with severe pulmonary or CNS disease—mechanical ventilation with critical care ventilator; generally requires heavy sedation.",
          "pdf_page": 757,
          "printed_page": 675,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Supplemental oxygen—need determined by primary disease; providing supplemental oxygen without providing ventilation will likely not correct hypercapnia.",
          "pdf_page": 757,
          "printed_page": 675,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Definitive treatment—treat primary cause; discontinue inhalation anesthesia or provide ventilation during anesthesia; diagnostics for neuromuscular disease.",
          "pdf_page": 757,
          "printed_page": 675,
          "column": 1
        }
      ],
