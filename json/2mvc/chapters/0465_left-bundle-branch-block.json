              "printed_page": 818,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Electrocardiogram (ECG) Features",
              "pdf_page": 900,
              "printed_page": 818,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "QRS prolonged—dogs >0.08 seconds; cats",
              "pdf_page": 900,
              "printed_page": 818,
              "column": 1,
              "subheading": "Electrocardiogram (ECG) Features"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": ">0.06 seconds.",
              "pdf_page": 900,
              "printed_page": 818,
              "column": 1,
              "subheading": "Electrocardiogram (ECG) Features"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "QRS wide and positive in",
              "pdf_page": 900,
              "printed_page": 818,
              "column": 1,
              "subheading": "Electrocardiogram (ECG) Features"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "leads I, II, III, and aVF.",
              "pdf_page": 900,
