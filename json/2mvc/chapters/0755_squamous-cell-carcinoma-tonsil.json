              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No known breed or sex predilection.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cough.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Enlarged lymph nodes.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dysphagia.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ptyalism.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Retching.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Halitosis.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Weight loss.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anorexia.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lethargy.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Enlarged tonsil(s).",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Widening or “fullness” of oropharyngeal space.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cervical lymphadenomegaly.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pain on opening jaw.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
