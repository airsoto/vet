      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Rapid and progressive invasion of neoplastic squamous epithelium arising from the tonsillar fossa into tonsillar lymphoid tissue.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "More common in dogs than cats— comprises 9% of canine oral tumors.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Highly locally invasive into soft tissues.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Early metastasis—70–90% eventually metastasize regardless of local control.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1
            }
          ]
        },
