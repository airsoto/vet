    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Carboplatin—dogs, 300 mg/m2IV q3–4 weeks; cats, 180–240 mg/m2IV q3–4 weeks for 4–5 treatments.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mitoxantrone—dogs and cats, 5–6 mg/m2 IV q2–3 weeks for 5 treatments.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Piroxicam—dogs, 0.3 mg/kg PO q24h, toceranib phosphate (Palladia) 2.75–3.25 mg/kg PO q48h.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Doxorubicin—dogs >10 kg, 30 mg/m2IV; dogs <10 kg and cats, 1 mg/kg q2–3 weeks for 5 treatments.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cisplatin—dogs, 60–70 mg/m2IV q3–4 weeks for 4 treatments.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 2
            }
          ]
        },
