    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Most patients euthanized within months for local progression or metastasis; patients with curative-intent therapies should be rechecked with physical examination and evaluated for metastasis (thoracic radiographs/CT) at 1–2 months, then every 3 months.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 3
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": []
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Postoperative complications—tumor recurrence, may need feeding tubes postoperatively.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 3
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Prognosis—poor owing to extensive local disease and high rate of recurrence (tongue, pharynx, lymph nodes) and metastasis.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Minimal information in cats; however, appear to carry a grave prognosis as with most oral squamous cell carcinomas in cats.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs: 11–40% 1-year survival (survival times increased if unilateral and no metastasis at diagnosis).",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Untreated (dogs) median survival 1–2 months vs. treated median survival 7–8 months.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Surgery alone has limited benefit—median survival 2–4 months (dogs).",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Palliative radiotherapy or chemotherapy (dogs)—75% response rate, 2–9 months median survival.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 3
            },
            {
