        "OTHER LABORATORY TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": []
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiography—three-view to detect lung metastasis; 5–20% positive for metastasis at presentation; 60–85% metastasis at death.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CT—evaluate local extension of primary tumor as well as mandibular and retropharyngeal",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "lymph node involvement; recommended prior to surgery or radiation therapy.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal ultrasound—evaluate abdominal organs; 20% disseminated metastasis to multiple organs at death (dogs).",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytology—inflammation and secondary infection may limit diagnostic utility of fine-needle aspirate samples but should still be attempted.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Histopathology—deep tissue biopsy may be needed to differentiate from other oral malignancies.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytology and/or biopsy of regional lymph nodes to evaluate for metastatic disease; in dogs 20–55% metastasis at diagnosis.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": []
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgery—many are inoperable; tonsillec tomy, when done, should be bilateral.",
          "pdf_page": 1373,
          "printed_page": 1291,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Postoperative care (esophagostomy or gastrotomy tube) by owner may be needed.",
          "pdf_page": 1373,
          "printed_page": 1291,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Other surgical methods (electrocautery and cryosurgery)—no advantage over conventional excision.",
          "pdf_page": 1373,
          "printed_page": 1291,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Regional radiation therapy is effective for local control and palliation of clinical signs.",
          "pdf_page": 1373,
          "printed_page": 1291,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Chemotherapy—anecdotal reports of cisplatin, carboplatin, doxorubicin being used with limited success.",
          "pdf_page": 1373,
          "printed_page": 1291,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Piroxicam and/or toceranib phosphate (Palladia) may have antineoplastic effects in canine carcinomas.",
          "pdf_page": 1373,
          "printed_page": 1291,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Analgesics for pain control; antibiotics for secondary bacterial infections may be indicated.",
          "pdf_page": 1373,
          "printed_page": 1291,
          "column": 2
        }
      ],
