    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Lymphoma (generally associated with lymphadenomegaly and bilateral disease).",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abscess.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metastatic neoplasm (oral melanoma, sarcoma).",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tonsillitis.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tonsillar crypt foreign body.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Salivary gland tumor.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thyroid carcinoma.",
              "pdf_page": 1373,
              "printed_page": 1291,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
