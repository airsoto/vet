        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Determine urine protein : creatinine ratio to evaluate magnitude of proteinuria.",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Perform urine culture to rule out urinary tract infection in patients with pyuria or WBC casts. Also consider ultrasound ± radiography to assess for pyelonephritis,",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "nephroliths, etc.",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Test for systemic infections",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "as indicated.",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If thrombocytopenic or RBC casts are present, perform coagulation studies to rule out consumptive coagulopathy such as disseminated intravascular coagulation.",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Disorders That May Alter Laboratory",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Results",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Delayed processing of urinalysis and",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2,
              "subheading": "Results"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "examination of urine sediment may result",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2,
              "subheading": "Results"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "in disappearance of casts; ideally should be",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2,
              "subheading": "Results"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "examined within 30 minutes of collection.",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2,
              "subheading": "Results"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Alkaline urine can cause dissolution of",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2,
              "subheading": "Results"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "casts.",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2,
              "subheading": "Results"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Low speed centrifugation necessary to",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2,
              "subheading": "Results"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "prevent cast destruction.",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2,
              "subheading": "Results"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Valid If Run in Human Laboratory?",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Yes",
              "pdf_page": 437,
