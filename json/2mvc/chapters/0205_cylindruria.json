      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cylindruria with azotemia and adequately concentrated urine (specific gravity >1.030 in dogs and >1.040 in cats)—consider prerenal",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "disorders such as dehydration.",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cylindruria with azotemia and inadequately concentrated",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "urine—consider renal failure. with leukocytosis—consider pyelonephritis or other infectious and inflammatory disorders.",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cylindruria with glucosuria and proteinuria—",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "consider renal tubular necrosis.",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Transient hyaline and/or granular casts can be seen after strenuous exercise.",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Casts classified by appearance and",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "quantified per low power field.",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Granular casts (fine or coarse) associated with tubular degeneration, inflammation, or necrosis.",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyaline casts can be seen with proteinuria,",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "dehydration, and after diuresis.",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Waxy casts usually seen with chronic kidney disease.",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Epithelial casts formed from degeneration of renal tubular epithelial cells; most commonly seen with acute tubular injury.",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "White blood cell (WBC) casts indicate renal inflammation (e.g., pyelonephritis).",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Red blood cell (RBC) casts indicate renal",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "hemorrhage.",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fatty casts suggest renal",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "tubular injury.",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chemistry profile may show",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "azotemia and hyperphosphatemia.",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CBC may show anemia, erythrocytosis, leukocytosis, and/or thrombocytopenia depending on underlying pathology.",
              "pdf_page": 437,
              "printed_page": 355,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
