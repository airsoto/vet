        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Common in various cereal grains, peanuts, other nuts, and potatoes.",
              "pdf_page": 1008,
              "printed_page": 926,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Postproduction contamination of improperly stored pet foods; foods with obvious mold spoilage; garbage ingestion.",
              "pdf_page": 1008,
              "printed_page": 926,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mycotoxin-producing molds grow at temperatures of 24–35°C, moisture of 18–20%.",
              "pdf_page": 1008,
              "printed_page": 926,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute signs have been seen in dogs ingesting food containing 60 ppb aflatoxin.",
              "pdf_page": 1008,
              "printed_page": 926,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Activated to toxic epoxide by liver cytochrome P450 enzymes.",
              "pdf_page": 1008,
              "printed_page": 926,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Depletes glutathione.",
              "pdf_page": 1008,
              "printed_page": 926,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Binds with nucleic acids, proteins, and cell and organelle membranes.",
              "pdf_page": 1008,
              "printed_page": 926,
              "column": 1
            }
          ]
        }
      }
    },
