        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Rarely reported in dogs but occurs periodically in large outbreaks associated with pet foods.",
              "pdf_page": 1008,
              "printed_page": 926,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reported experimentally in cats, rarely as field cases.",
              "pdf_page": 1008,
              "printed_page": 926,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Acute Onset",
              "pdf_page": 1008,
              "printed_page": 926,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most common presentation in small animals.",
              "pdf_page": 1008,
              "printed_page": 926,
              "column": 1,
              "subheading": "Acute Onset"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Refusal of contaminated feeds.",
              "pdf_page": 1008,
              "printed_page": 926,
              "column": 1,
              "subheading": "Acute Onset"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rapid onset of signs may develop up to",
              "pdf_page": 1008,
              "printed_page": 926,
              "column": 1,
              "subheading": "Acute Onset"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "3 weeks post exposure.",
              "pdf_page": 1008,
              "printed_page": 926,
              "column": 1,
              "subheading": "Acute Onset"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vomiting and diarrhea.",
              "pdf_page": 1008,
              "printed_page": 926,
              "column": 1,
              "subheading": "Acute Onset"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Icterus.",
              "pdf_page": 1008,
              "printed_page": 926,
              "column": 1,
              "subheading": "Acute Onset"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Coagulopathy and gastrointestinal",
              "pdf_page": 1008,
              "printed_page": 926,
              "column": 1,
              "subheading": "Acute Onset"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hemorrhage.",
              "pdf_page": 1008,
              "printed_page": 926,
              "column": 1,
              "subheading": "Acute Onset"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Chronic",
              "pdf_page": 1008,
              "printed_page": 926,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anorexia or feed refusal.",
              "pdf_page": 1008,
              "printed_page": 926,
              "column": 1,
              "subheading": "Chronic"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vomiting.",
              "pdf_page": 1008,
              "printed_page": 926,
              "column": 1,
              "subheading": "Chronic"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diarrhea.",
              "pdf_page": 1008,
              "printed_page": 926,
              "column": 1,
              "subheading": "Chronic"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Liver failure.",
              "pdf_page": 1008,
              "printed_page": 926,
              "column": 1,
              "subheading": "Chronic"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ascites.",
              "pdf_page": 1008,
              "printed_page": 926,
              "column": 1,
              "subheading": "Chronic"
            }
          ]
        },
