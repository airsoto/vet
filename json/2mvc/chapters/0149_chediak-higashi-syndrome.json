    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Provide ascorbic acid (vitamin C) to increase cyclic guanosine monophosphate (cGMP) concentration and to improve cell and platelet function (no controlled studies in cats).",
          "pdf_page": 337,
          "printed_page": 255,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Transfusion of platelet-rich plasma or fresh whole blood from healthy cats will temporarily normalize bleeding time in affected individuals.",
          "pdf_page": 337,
          "printed_page": 255,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Experimentally, bone marrow transplantation has restored neutrophil and platelet function in cats, but is impractical for general clinical use.",
          "pdf_page": 337,
          "printed_page": 255,
          "column": 2
        }
      ],
