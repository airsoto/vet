  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Autosomal recessive inherited disorder of Persian cats characterized by abnormalities in cellular morphology and pigment formation.",
              "pdf_page": 337,
              "printed_page": 255,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Large intracytoplasmic granules in circulating leukocytes and melanocytes formed by fusion of preexisting granules.",
              "pdf_page": 337,
              "printed_page": 255,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Storage pool deficiency of adenosine diphosphate (ADP), adenosine triphosphate (ATP), magnesium, and serotonin results from lack of platelet-dense granules.",
              "pdf_page": 337,
              "printed_page": 255,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prolonged bleeding from trauma, venipuncture, or minor surgery occurs because of impaired platelet aggregation and release reaction.",
              "pdf_page": 337,
              "printed_page": 255,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Normal coagulation times.",
              "pdf_page": 337,
              "printed_page": 255,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Depressed chemotaxis.",
              "pdf_page": 337,
              "printed_page": 255,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No change in rates of infection.",
              "pdf_page": 337,
              "printed_page": 255,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mildly depressed neutrophil count, but within reference interval.",
              "pdf_page": 337,
              "printed_page": 255,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In humans, it is associated with one of eight mutations in the LYST gene.",
              "pdf_page": 337,
              "printed_page": 255,
              "column": 1
            }
          ]
        },
