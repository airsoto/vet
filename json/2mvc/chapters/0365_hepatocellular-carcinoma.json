        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Three clinical subtypes of this tumor are described—massive, nodular, and diffuse.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nodular forms account for 30% and diffuse types account for 10% of all reported hepatocellular carcinomas in dogs, and both",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "types involve multiple liver lobes.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Massive form that is confined to one lobe accounts for about 60% of canine hepatocellular carci-",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "noma cases.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Presence of necrotic areas.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diffusely infiltrated tumors may not be grossly apparent other than hepatomegaly.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 2
            }
          ]
        }
      }
