    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal ultrasonography—2 weeks postoperative for baseline and every 3–4",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "months for the first year.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal CT appears more sensitive than ultrasonography for detection of small, recurrent lesions.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Monitor liver enzymes serially.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 3
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": false,
          "status": "missing",
