        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Aspiration cytology—to exclude other types of neoplasia (lymphoma, sarcoma, etc.); aspirate cytology cannot reliably differentiate between hepatocellular carcinoma and benign hepatocellular proliferation (adenoma,",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "hyperplasia).",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Surgical hepatic biopsy for",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "confirmation.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If tumor is not surgically resectable, ultrasound-guided needle biopsy may be useful in obtaining definitive diagnosis.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 2
            }
          ]
        },
