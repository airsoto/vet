          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "While toceranib administration has resulted in short-term tumor control for some dogs, no medical treatment options have been successful in reducing tumor recurrence or risk for metastasis.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 3
            }
