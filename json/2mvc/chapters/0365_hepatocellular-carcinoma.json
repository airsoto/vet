          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": []
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Risk of tumor necrosis and massive abdominal hemorrhage if unresected.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 3
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Massive forms treated with surgery have a better prognosis than do the nodular or",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "diffuse forms.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Median survival of dogs with massive form treated with surgery",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 3
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "may be>1,460 days.•Local tumor",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "recurrence or de novo tumor growth is not",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 3,
              "subheading": "may be>1,460 days.•Local tumor"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "uncommon.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 3,
              "subheading": "may be>1,460 days.•Local tumor"
            }
          ]
        }
      }
