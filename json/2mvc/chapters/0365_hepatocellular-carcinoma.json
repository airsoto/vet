        "SURGICAL CONSIDERATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "SURGICAL CONSIDERATIONS",
          "canonical_heading": "SURGICAL CONSIDERATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Complete excision (liver lobectomy) recommended when possible; excision with microscopically dirty margins can still afford durable tumor control and long survival",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "times.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Massive form is often amenable to",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "surgical resection.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nodular and diffuse forms are often not amenable to surgery.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Between 60% and 70% of the liver lobes can be resected if the patient is healthy and is given appropriate postoperative care.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 3
            }
          ]
        },
