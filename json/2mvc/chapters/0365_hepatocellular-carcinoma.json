          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Uncommon in dogs and rare in cats.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affected dogs commonly>10 years of age.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No breed predispositions, although golden retrievers, miniature schnauzers, and male dogs are overrepresented in some studies.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Typically absent until disease is advanced,",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "unless it causes biliary obstruction.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Many",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "times incidental finding.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lethargy.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Weakness.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anorexia.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Weight loss.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Polydipsia.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diarrhea.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vomiting.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hepatomegaly (asymmetric)—consistent; precedes development of overt clinical signs.",
              "pdf_page": 715,
              "printed_page": 633,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
