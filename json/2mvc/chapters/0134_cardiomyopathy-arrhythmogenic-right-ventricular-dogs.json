        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog.",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Specific to the boxer, although a similar presentation is infrequently observed in the English bulldog.",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually observed in mature dogs between 5 and 8 years of age. Dogs as young as 6 months have been reported and some affected dogs may not develop clinical signs until>10 years of age.",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually one of three presentations:",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Asymptomatic dog with ventricular",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "premature complexes (VPCs) detected on routine examination.",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Syncope with VPCs detected on ECG or",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Holter monitor.",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Signs of left heart failure (e.g., tachypnea,",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "coughing) or biventricular failure (e.g., ascites, tachypnea, coughing) with VPCs; this presentation is least common.",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sudden death may occur before develop ment of obvious clinical signs.",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Adult onset, inherited (autosomal dominant).",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "A genetic mutation (deletion) in a cardiac desmosomal gene (striatin) is associated with the development of the disease. Dogs that are homozygous for the striatin deletion appear to be more likely to be more severely affected with a higher number of VPCs, and are more likely to have cardiac dilation and myocardial dysfunction. Sudden death is more common. It is not yet known if this is the only genetic cause or if additional genetic mutations will be identified.",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "At least one family of boxers with VPCs, ventricular dilation, and systolic dysfunction was found to have decreased myocardial l-carnitine levels and demonstrated some clinical improvement when supplemented with l-carnitine. The cause and effect of this relationship is unclear, and response to this supplementation does not occur in all dogs with myocardial dysfunction.",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Aortic stenosis—moderate and severe forms can be associated with VPCs.",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Uncommon forms of acquired cardiac disease (neoplasia, endocarditis).",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal disease (especially splenic disease) can be associated with VPCs.",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Echocardiography and abdominal ultrasonography can be used to differentiate other causes of cardiac and abdominal disease.",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Genetic testing can now be performed to screen for the genetic mutation (https://cvm. ncsu.edu/genetics) associated with arrhythmo genic right ventricular cardiomyopathy. Submission samples can be either a blood sample in an EDTA tube or a buccal swab of the oral mucosal surface.",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Plasma l-carnitine levels may be evaluated in boxers with ventricular dilation and systolic dysfunction. However, plasma levels are not always reflective of myocardial levels. If plasma levels are not low, it is still possible to have low myocardial levels, and supplementation with l-carnitine might be considered.",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Thoracic Radiography",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Normal in most affected dogs.",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2,
              "subheading": "Thoracic Radiography"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs with ventricular dilation and systolic",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2,
              "subheading": "Thoracic Radiography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "dysfunction may have cardiac enlargement",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2,
              "subheading": "Thoracic Radiography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and evidence of heart failure (e.g., pulmonary",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2,
              "subheading": "Thoracic Radiography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "edema).",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2,
              "subheading": "Thoracic Radiography"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Echocardiography",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "A small percentage of dogs have ventricular",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2,
              "subheading": "Echocardiography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "dilation and systolic dysfunction, particularly",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2,
              "subheading": "Echocardiography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "if they are homozygous for the deletion",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2,
              "subheading": "Echocardiography"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "mutation.",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2,
              "subheading": "Echocardiography"
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "ECG",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Many dogs will not have VPCs on an ECG",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2,
              "subheading": "ECG"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "of brief duration since the arrhythmia can be",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2,
              "subheading": "ECG"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "intermittent. However, some dogs will have",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2,
              "subheading": "ECG"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "one or more upright VPCs on a brief lead",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2,
              "subheading": "ECG"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "II ECG.",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2,
              "subheading": "ECG"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In either case, if suspicion of disease is",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2,
              "subheading": "ECG"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "present, Holter monitoring is recommended",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2,
              "subheading": "ECG"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "to determine the severity and complexity of",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2,
              "subheading": "ECG"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "the arrhythmia and to have a baseline for",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2,
              "subheading": "ECG"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "comparison once treatment is started. If",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2,
              "subheading": "ECG"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Holter monitoring is not available and the",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2,
              "subheading": "ECG"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "dog is symptomatic with upright VPCs on an",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2,
              "subheading": "ECG"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "ECG, therapy should be considered.",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2,
              "subheading": "ECG"
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Gross pathology is nonspecific in most cases. In a small percentage of cases, left and right ventricular dilation may be observed.",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Histopathologic abnormalities include a fatty and fibrous infiltrate into the right ventricular (and sometimes interven tricular and left ventricular) free wall.",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "The goals of therapy include reduction of the number of VPCs, reduction of clinical signs, and reduction of the risk of sudden cardiac death. Unfortunately, there is no evidence that therapy can reduce the risk of sudden death. The decision to start therapy in the asymptomatic boxer with VPCs is controversial, since all antiarrhythmics have the potential to make the arrhythmia worse. However, dogs with as few as 300 VPCs/24 hours have been observed to die suddenly. In general, initiate antiarrhythmic drugs if there",
          "pdf_page": 309,
          "printed_page": 227,
          "column": 3
        },
        {
          "type": "subheading",
          "level": 0,
          "text": "are>1,000 VPCs/24 hours and/or significant",
          "pdf_page": 309,
          "printed_page": 227,
          "column": 3
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "runs of ventricular tachycardia or other signs",
          "pdf_page": 309,
          "printed_page": 227,
          "column": 3,
          "subheading": "are>1,000 VPCs/24 hours and/or significant"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "of arrhythmia complexity (e.g., bigeminy,",
          "pdf_page": 309,
          "printed_page": 227,
          "column": 3,
          "subheading": "are>1,000 VPCs/24 hours and/or significant"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "couplets), or clinical signs (syncope, exercise",
          "pdf_page": 309,
          "printed_page": 227,
          "column": 3,
          "subheading": "are>1,000 VPCs/24 hours and/or significant"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "intolerance) related to the VPCs.",
          "pdf_page": 309,
          "printed_page": 227,
          "column": 3,
          "subheading": "are>1,000 VPCs/24 hours and/or significant"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Syncope and sudden cardiac death may be",
          "pdf_page": 309,
          "printed_page": 227,
          "column": 3,
          "subheading": "are>1,000 VPCs/24 hours and/or significant"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "more frequently associated with stress and",
          "pdf_page": 309,
          "printed_page": 227,
          "column": 3,
          "subheading": "are>1,000 VPCs/24 hours and/or significant"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "excitement. Reduce stress and effort when",
          "pdf_page": 309,
          "printed_page": 227,
          "column": 3,
          "subheading": "are>1,000 VPCs/24 hours and/or significant"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "possible. There is no direct relationship",
          "pdf_page": 309,
          "printed_page": 227,
          "column": 3,
          "subheading": "are>1,000 VPCs/24 hours and/or significant"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "between exercise restriction and survivability.",
          "pdf_page": 309,
          "printed_page": 227,
          "column": 3,
          "subheading": "are>1,000 VPCs/24 hours and/or significant"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "Some dogs die while asleep. Thus, strict",
          "pdf_page": 309,
          "printed_page": 227,
          "column": 3,
          "subheading": "are>1,000 VPCs/24 hours and/or significant"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "exercise restriction is not recommended.",
          "pdf_page": 309,
          "printed_page": 227,
          "column": 3,
          "subheading": "are>1,000 VPCs/24 hours and/or significant"
        }
      ],
