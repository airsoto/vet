  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "A myocardial disease commonly character ized by ventricular tachyarrhythmias that can be accompanied by syncope or sudden death. A small percentage (<5%) develop congestive heart failure with systolic dysfunction, comparable to the dilated cardiomyopathy observed in other breeds.",
              "pdf_page": 309,
              "printed_page": 227,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
