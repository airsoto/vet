        "CAUSES": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES",
          "canonical_heading": "CAUSES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Any bacteria can become resistant to antimicrobials. Common AMR bacterial pathogens include:",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Methicillin-resistantStaphylococcus pseudintermedius(MRSP).",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Methicillin-resistantStaphylococcus aureus (MRSA).",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "MDREnterococcus faecalisandEnterococcus faecium.",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Extended-spectrum beta-lactamase (ESBL) producing Gram-negative bacteria including:",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "E. coli.",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Salmonella enterica.",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Klebsiella pneumoniae.",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Pseudomonas aeruginosa.",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Proteus mirabilis.",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Enterobacterspp.",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 2
            }
          ]
        },
