        "INCIDENCE/PREVALENCE": {
          "present": true,
          "status": "content",
          "source_heading": "INCIDENCE/PREVALENCE",
          "canonical_heading": "INCIDENCE/PREVALENCE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Due to a lack of robust surveillance, prevalence of MDR infections in dogs and cats is unknown; however, studies suggest between <1 and 50% of bacteria cultured from companion animals are MDR, depending on geographic region.",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 1
            }
          ]
        },
