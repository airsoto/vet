    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Bacterial infections, nonbacterial infections and other inflammatory diseases can mimic AMR bacterial infections, in that clinical response is not achieved with empiric antimicrobial therapy.",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Treating a microbe inherently resistant to empiric drug chosen (e.g., treating anaerobic infection with a drug ineffective against anaerobes) or using drug that does not penetrate site of infection.",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Viral, fungal, or protozoal infections.",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Immune-mediated disease.",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neoplasia.",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 3
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Findings are dependent on location of infection.",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CBC may lack abnormalities or range from leukocytosis and neutrophilia to neutropenia with degenerative left shift.",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chemistry abnormalities associated with site of infection (e.g., azotemia with pyelonephritis).",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urinalysis may reveal bacteriuria and pyuria in patients with urinary tract infections.",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 3
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Quantitative bacterial culture and susceptibility testing are required for identification of AMR and MDR infections.",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytologic examination using a Romanowsky-type stain (e.g., Diff-Quik) and/or Gram stain of samples obtained for culture may help with culture interpretation, especially if more than one organism is cultured or suspected.",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 3
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Imaging studies should identify source of infection and guide sampling for bacterial",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 3
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "culture and susceptibility testing.",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 3
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Sampling of site of infection is required for diagnosis and for guiding therapy; such procedures may include swabs of skin wounds or lesions, cystocentesis, thoracocentesis, abdominocentesis, pyelocentesis, airway samples (transtracheal, endotracheal wash or bronchoalveolar lavage).",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 3
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Findings are dependent on site of infection. In general, active infections would be expected to contain innate immune cells and intracellular bacteria.",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 3
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "GENERAL": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GENERAL",
          "content_blocks": []
        },
        "APPROPRIATE HEALTH CARE": {
          "present": true,
          "status": "content",
          "source_heading": "APPROPRIATE HEALTH CARE",
          "canonical_heading": "APPROPRIATE HEALTH CARE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "If hospitalization is required, patient should be isolated and proper personal protective equipment (gloves, gowns, eye or face shield, as indicated) utilized to prevent nosocomial infections of other patients and colonization of caregivers.",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Therapy dependent on location and type of infection.",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Treatment of underlying disease and addressing predisposing risk factor(s) is critical to clear infection and prevent recurrence (e.g., removal of urinary cystoliths to resolve bladder infection).",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Surgical debridement of wound infections may be necessary.",
              "pdf_page": 991,
              "printed_page": 909,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Topical antiseptic therapy for localized cutaneous infections, such as MRSP and MRSA, is recommended in lieu of systemic antimicrobials, when possible.",
              "pdf_page": 992,
              "printed_page": 910,
              "column": 1
            }
          ]
        },
        "NURSING CARE": {
          "present": true,
          "status": "content",
          "source_heading": "NURSING CARE",
          "canonical_heading": "NURSING CARE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "For cutaneous wounds, bandaging is recommended to protect wound and prevent spread of AMR organisms.",
              "pdf_page": 992,
              "printed_page": 910,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "For patients with urinary or gastrointestinal infections, patients should eliminate in areas amenable to disinfection.",
              "pdf_page": 992,
              "printed_page": 910,
              "column": 1
            }
          ]
        },
        "ACTIVITY": {
          "present": true,
          "status": "content",
          "source_heading": "ACTIVITY",
          "canonical_heading": "ACTIVITY",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Social activities such as daycare, boarding, grooming, dog parks, should be avoided until infection is resolved.",
              "pdf_page": 992,
              "printed_page": 910,
              "column": 1
            }
          ]
        },
        "DIET": {
          "present": true,
          "status": "content",
          "source_heading": "DIET",
          "canonical_heading": "DIET",
