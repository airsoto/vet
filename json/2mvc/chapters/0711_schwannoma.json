        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—median of 10 years, no sex predisposition, no known breed predilection.",
              "pdf_page": 1305,
              "printed_page": 1223,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats rarely affected.",
              "pdf_page": 1305,
              "printed_page": 1223,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Vary depending on tumor location, which can be peripheral (e.g., skin or tongue) or more central (e.g., axillary region).",
              "pdf_page": 1305,
              "printed_page": 1223,
              "column": 1
            }
          ]
        },
