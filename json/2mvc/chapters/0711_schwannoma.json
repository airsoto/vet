        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Myelography may be helpful in cases with dorsal or ventral nerve root involvement.",
              "pdf_page": 1305,
              "printed_page": 1223,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Contrast CT or, ideally, MRI provides the most information regarding extent and location of disease.",
              "pdf_page": 1305,
              "printed_page": 1223,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Electromyography consistently reveals abnormal, spontaneous electrical activity in muscles of the affected limb.",
              "pdf_page": 1305,
              "printed_page": 1223,
              "column": 2
            }
          ]
        },
