        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Recurrence common following incomplete surgical excision (up to 72% of cases).",
              "pdf_page": 1305,
              "printed_page": 1223,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The more distal the tumor, the better the possibility of a surgical cure.",
              "pdf_page": 1305,
              "printed_page": 1223,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "For tumors involving the brachial or lumbosacral plexus, median disease-free interval is 7.5 months.",
              "pdf_page": 1305,
              "printed_page": 1223,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "For tumors involving dorsal or ventral nerve roots, median disease-free interval is 1 month.",
              "pdf_page": 1305,
              "printed_page": 1223,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "High-histologic-grade tumors (e.g., grade 3) may metastasize to regional lymph nodes or lung.",
              "pdf_page": 1305,
              "printed_page": 1223,
              "column": 3
            }
          ]
        }
      }
