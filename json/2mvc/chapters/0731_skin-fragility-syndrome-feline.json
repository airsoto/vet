    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Medical management—may be useful for preparing patient for surgery and for minimizing postoperative complications (e.g., infections and poor wound healing).",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No known effective medical therapy for feline hyperadrenocorticism.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mitotane (1,1-(o,p′-dichlorodiphenyl)-2,2-",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 3
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "dichloroethane [o,p′-DDD]) 12.5–50 mg/kg",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "PO q12h; response has been equivocal; side",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 3,
              "subheading": "dichloroethane [o,p′-DDD]) 12.5–50 mg/kg"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "effects include anorexia, vomiting, and",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 3,
              "subheading": "dichloroethane [o,p′-DDD]) 12.5–50 mg/kg"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "diarrhea.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 3,
              "subheading": "dichloroethane [o,p′-DDD]) 12.5–50 mg/kg"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metyrapone 65 mg/kg PO q12h; clinical",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 3,
              "subheading": "dichloroethane [o,p′-DDD]) 12.5–50 mg/kg"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "improvement noted more often with this",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 3,
              "subheading": "dichloroethane [o,p′-DDD]) 12.5–50 mg/kg"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "drug than the others.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 3,
              "subheading": "dichloroethane [o,p′-DDD]) 12.5–50 mg/kg"
            }
          ]
        },
