    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "paragraph",
          "level": 0,
          "text": "Patients are often quite debilitated, making any form of treatment risky; close monitoring is required in all cases.",
          "pdf_page": 1343,
          "printed_page": 1261,
          "column": 3
        }
      ],
