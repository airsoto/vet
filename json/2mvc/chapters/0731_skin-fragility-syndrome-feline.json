  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "A disorder of multifactorial causes characterized by extremely fragile skin.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tends to occur in old cats that may have concurrent hyperadrenocorticism, diabetes mellitus, excessive use of megestrol acetate or other progesterone compounds, or as a paraneoplastic syndrome.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "A small number of cats have no biochemical alterations.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
