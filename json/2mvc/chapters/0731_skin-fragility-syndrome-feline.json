        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Naturally occurring disease tends to be recognized in old cats.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Iatrogenic cases have no age predilection.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No breed or sex predilection.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Historical Findings",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gradual onset of clinical signs.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Progressive alopecia (not always present).",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Often associated with weight loss, lusterless",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "coat, poor appetite, and lack of energy.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Skin becomes markedly thin and tears with",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "normal handling.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Skin rarely bleeds upon tearing.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Multiple lacerations (both old and new)",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "may be noted on close examination.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Partial to complete alopecia of the truncal",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "region may be noted.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sometimes associated with “rat tail,” pinnal",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "folding, pot-belly appearance.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Differentiated from cutaneous asthenia by",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "lack of hyperextensibility.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperadrenocorticism—pituitary- or adrenal-dependent.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Iatrogenic—secondary to excessive corticosteroid or progesterone drug administration.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diabetes mellitus—rare, unless associated with hyperadrenocorticism.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Possibly idiopathic or paraneoplastic syndrome.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cutaneous asthenia.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Feline paraneoplastic syndrome—pancreatic neoplasia, hepatic lipidosis, cholangiocarcinoma.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Little diagnostic significance in most cases.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Approximately 80% of cats with hyperadrenocorticism have concurrent diabetes mellitus (hyperglycemia, glucosuria).",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Adrenocorticotropic hormone (ACTH)stimulation test—70% of cats with hyperadrenocorticism have an exaggerated response.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Low-dose dexamethasone-suppression test—15–20% of normal cats may fail to decrease cortisol levels; typically unsuppressed with hyperadrenocorticism and nonadrenal illness.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "High-dose dexamethasone-suppression test—normal cats show decreases in cortisol concentrations; typically decreased with nonadrenal illnesses; considered by many clinicians to be the best screening test for hyperadrenocorticism; unreliable for discriminating between adrenal tumors and pituitary-dependent causes of hyperadrenocorticism, because both conditions fail to show suppression.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Endogenous ACTH levels—normal range for most labs is 20–100 pg/mL.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal ultrasonography—adrenal masses are often small until end-stage disease; cholangiocarcinoma and hepatic lipidosis have been reported.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CT and MRI—small pituitary tumors may be difficult to visualize; MRI may be more successful.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": []
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Histopathology—suggestive, not diagnostic; epidermis and dermis are thin; attenuated collagen fibers are evident.",
              "pdf_page": 1343,
              "printed_page": 1261,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Underlying metabolic disease should be ruled out.",
          "pdf_page": 1343,
          "printed_page": 1261,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Many patients are debilitated and require supportive care.",
          "pdf_page": 1343,
          "printed_page": 1261,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgical correction of the lacerations—difficult because the tissue cannot withstand pressure from sutures.",
          "pdf_page": 1343,
          "printed_page": 1261,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Protect skin—clothing; reduce activities that can traumatize the skin; remove sharp edges from the environment; prevent damage from interaction with other animals.",
          "pdf_page": 1343,
          "printed_page": 1261,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Discontinue exogenous corticosteroids if administered.",
          "pdf_page": 1343,
          "printed_page": 1261,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Hyperadrenocorticism—adrenalectomy is the preferred treatment.",
          "pdf_page": 1343,
          "printed_page": 1261,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Cobalt-60 radiation therapy—variable success in the treatment of pituitary tumors.",
          "pdf_page": 1343,
          "printed_page": 1261,
          "column": 2
        }
      ],
