    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "A urine culture should be performed 7–10 days after antimicrobial therapy is initiated, to confirm urine sterility. Follow-up urinalysis and urine cultures should also be performed by cystocentesis 7 days after antimicrobial therapy has ceased and 1 month post therapy.",
              "pdf_page": 1193,
              "printed_page": 1111,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ultrasonographic reevaluation of the urinary tract is recommended at 1, 3, and 6 months.",
              "pdf_page": 1193,
              "printed_page": 1111,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Persistent asymptomatic polyps are not treated.",
              "pdf_page": 1193,
              "printed_page": 1111,
              "column": 3
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Control of predisposing factors such as UTI, urolithiasis, urinary stenting.",
              "pdf_page": 1193,
              "printed_page": 1111,
              "column": 3
            }
          ]
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic UTIs.",
              "pdf_page": 1194,
              "printed_page": 1112,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Upper UTI.",
              "pdf_page": 1194,
              "printed_page": 1112,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Complete obstruction of ureters or urethra.",
              "pdf_page": 1194,
              "printed_page": 1112,
              "column": 1
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "The expected course is favorable and the prognosis good if the underlying cause is treated and eradicated.",
              "pdf_page": 1194,
              "printed_page": 1112,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rarely patients with polypoid cystitis develop TCC several years after initial diagnosis. It is unknown if some of these cases represent early carcinomain situ.",
              "pdf_page": 1194,
              "printed_page": 1112,
              "column": 1
            }
          ]
        }
      }
    },
