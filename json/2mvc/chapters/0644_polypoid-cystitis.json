    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Select an antimicrobic based on culture of urine and polyp tissue. Optimal duration of antibiotic therapy is unknown. Post-therapy urine cultures can be used to determine if longer courses of antimicrobs are needed.",
              "pdf_page": 1193,
              "printed_page": 1111,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Use of piroxicam and immunosuppressive drugs are suggested, but efficacy is variable.",
              "pdf_page": 1193,
              "printed_page": 1111,
              "column": 3
            }
          ]
        },
