          "canonical_heading": "ACTIVITY",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "No specific need for activity restriction; patients often have limited endurance.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 1
            }
          ]
        },
        "DIET": {
          "present": true,
          "status": "content",
          "source_heading": "DIET",
          "canonical_heading": "DIET",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ideal diets are protein and sodium restricted; prescription “renal” diets are most appropriate; home-prepared diets may be used after consultation with a nutritionist.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Feeding tubes allow for delivery of supplemental nutrition and medication.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 1
            }
          ]
        },
        "CLIENT EDUCATION": {
          "present": true,
          "status": "content",
          "source_heading": "CLIENT EDUCATION",
          "canonical_heading": "CLIENT EDUCATION",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Prognosis is guarded for azotemic patients; however, complete recovery may occur.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dialysis and plasma exchange may allow for more rapid control of disease and promote renal recovery.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 1
            }
          ]
        },
