    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "ICGN requires immunosuppression; mycophenolate (5–10 mg/kg q12h) is most commonly used; GI upset is most frequently observed side effect; peripheral edema is rare; short course of corticosteroids (prednisone 2 mg/kg/day) can be used as mycophenolate may require 2 weeks to take effect.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cyclophosphamide (50 mg/m24 days/week); sterile hemorrhagic cystitis and bone marrow suppression are side effects.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anti-proteinuric therapy includes angiotensin-converting enzyme (ACE) inhibitors (enalapril/benazepril 0.5–1 mg/kg q12h) or angiotensin receptor blockers (ARB; telmisartan 1–3 mg/kg q24h); these have modest antihypertensive effects; begin at low doses and increase if response is inadequate; cautious use in severely azotemic patients.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "HTN treated with amlodipine (0.25– 0.8 mg/kg q24h) or telmisartan (1–3 mg/kg q24h).",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Systemic anticoagulation to prevent TE— clopidogrel (1–4 mg/kg q24h) or aspirin",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(2–5 mg/kg q24h); newer direct factor X inhibitors may also be considered.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 2
            }
          ]
        },
        "CONTRAINDICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS",
          "canonical_heading": "CONTRAINDICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "ACE inhibitors and ARBs should not be used if patient is dehydrated or hypovolemic.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anticoagulation should be avoided in thrombocytopenic patients until platelet count is normal.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 2
            }
          ]
        },
        "PRECAUTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "PRECAUTIONS",
          "canonical_heading": "PRECAUTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "ACE inhibitors and ARBs should be used cautiously in patients with serum creatinine >3.5, as they may exacerbate uremia; 30% increase in serum creatinine is generally tolerated, if uremic symptoms do not occur; hyperkalemia may occur at higher doses.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypoalbuminemic patients poorly tolerate parenteral fluids; enteral hydration via feeding tube may be better tolerated.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Immunosuppression increases risk of opportunistic infections.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 2
            }
          ]
        },
        "POSSIBLE INTERACTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE INTERACTIONS",
          "canonical_heading": "POSSIBLE INTERACTIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Dual therapy of ACE inhibitor and ARB increases risk of hyperkalemia.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 2
            }
          ]
        },
        "CONTRAINDICATIONS/POSSIBLE INTERACTIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": []
        },
        "ALTERNATIVE DRUG(S)": {
          "present": true,
          "status": "content",
          "source_heading": "ALTERNATIVE DRUG(S)",
          "canonical_heading": "ALTERNATIVE DRUG(S)",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Corticosteroids not used for long-term management, but may be considered if other therapies cannot be afforded.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Patients who fail initial immunosuppressive therapy may benefit from alternative immunosuppression.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 2
            }
          ]
        }
      }
    },
    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Renal values, electrolytes, blood pressure, and urinalysis with UPC should be checked 1–2 weeks after starting therapy; reduction in proteinuria may take 4–6 weeks; subsequent rechecks should occur every 1–4 months.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Complete remission is obtaining UPC <0.5; partial remission is >50% reduction and therapeutic failure is <50% reduction in UPC.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Normalization of serum creatinine expected with complete response to therapy; many patients will have partial remission with improved but not normal serum creatinine.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Goal to obtain serum albumin >2.0 mg/dL.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Repeat renal biopsy can document resolution of immune complexes and guide duration of immunosuppression.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 2
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Avoiding exposure to fleas and ticks may reduce risk of vector-borne infections causing ICGN; preventative therapies should be used.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 2
            }
          ]
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "AKI or CKD.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "HTN.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "NS.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "TE.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 3
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Guarded prognosis. Short survival has been reported for azotemic proteinuric dogs. Disease may progress despite therapy. Complete resolution of disease may occur with immunosuppression.",
              "pdf_page": 649,
              "printed_page": 567,
              "column": 3
            }
          ]
        }
      }
    },
