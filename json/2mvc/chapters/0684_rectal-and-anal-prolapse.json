  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Eversion of one or more layers of the rectum through the anus.",
              "pdf_page": 1262,
              "printed_page": 1180,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "An anal prolapse (incomplete prolapse) is a protrusion of anorectal mucosa through the external anal orifice.",
              "pdf_page": 1262,
              "printed_page": 1180,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "A rectal prolapse (complete prolapse) is a double-layer invagination of the full thickness of the rectal tube through the anal orifice.",
              "pdf_page": 1262,
              "printed_page": 1180,
              "column": 1
            }
          ]
        },
