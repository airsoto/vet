        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog and cat (especially Manx).",
              "pdf_page": 1262,
              "printed_page": 1180,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Any age, sex, or breed.",
              "pdf_page": 1262,
              "printed_page": 1180,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "High prevalence for young, parasitized dogs or cats with diarrhea.",
              "pdf_page": 1262,
              "printed_page": 1180,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Persistent tenesmus.",
              "pdf_page": 1262,
              "printed_page": 1180,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Incomplete prolapse—protrusion of a portion of the circumference of the rectal mucosa that typically appears worse immediately after defecation and then subsides.",
              "pdf_page": 1262,
              "printed_page": 1180,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Complete prolapse appears as a tubular hyperemic mass protruding from the anus.",
              "pdf_page": 1262,
              "printed_page": 1180,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic prolapses may be dark blue or black in color or the mucosa may be ulcerated.",
              "pdf_page": 1262,
              "printed_page": 1180,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Gastrointestinal disorders that cause diarrhea and tenesmus, such as parasitism, colitis/enteritis, constipation/obstipation, rectal foreign body, rectal deviation and diverticulum, proctitis, and rectal or anal tumors.",
              "pdf_page": 1262,
              "printed_page": 1180,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urogenital disorders, such as cystitis, urolithiasis, prostatitis, prostatic hypertrophy, and dystocia.",
              "pdf_page": 1262,
              "printed_page": 1180,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tenesmus following perineal, rectal, or urogenital surgery (e.g., perineal herniorrhaphy).",
              "pdf_page": 1262,
              "printed_page": 1180,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Prolapsed intussusception—rule out by passing a finger or blunt probe between the mass and the anus (the probe should not penetrate more than 1–2 cm before contacting the fornix; if the probe easily passes 5–6 cm, then suspect prolapsed intussusception) or by abdominal ultrasonography (look for increased intestinal layering).",
              "pdf_page": 1262,
              "printed_page": 1180,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neoplasia—rule out by palpation, fine-needle aspiration and cytology, and/or biopsy and histopathology.",
              "pdf_page": 1262,
              "printed_page": 1180,
              "column": 1
            }
          ]
        },
