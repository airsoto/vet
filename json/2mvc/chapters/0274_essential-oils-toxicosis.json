        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Passive oil diffusers—animals inhale odor, develop mild to severe respiratory irritation/distress.",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Active diffusers—release micro-droplets of oil. Respiratory difficulties, but droplets can land on animal’s coat causing direct absorption or ingestion via grooming.",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "History of preexisting respiratory issues (e.g., asthmatic cats) places animals at greater risk.",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Indirect ingestion—essential oils used on",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anticholinergics if bradycardic, as long as human skin, animal licks skin. normotensive.",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Direct dermal or oral use as owners try natural",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bronchodilators with respiratory distress. remedies (e.g., flea control) on their animals.",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anti-emetics.",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hepatoprotectants with elevated LEs.",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 2
            }
          ]
        }
      }
    },
