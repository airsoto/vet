  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Essential oils—volatile, organic constituents extracted from plants; contribute to fragrance/taste. Often used as natural remedies by owners for their own medical issues. Essential oil insecticides (low %) manufactured for use on animals.",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Known toxicants tocats—d-Limonene (citrus oil), pine oil, ylang ylang oil, peppermint oil, cinnamon oil.",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Known toxicants tocats and dogs—wintergreen oil, sweet birch oil, eucalyptus oil, clove oil, tea tree (aka melaleuca) oil.",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Known toxicants todogs—pennyroyal oil.",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
        "PATHOPHYSIOLOGY": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": []
        },
        "SYSTEMS AFFECTED": {
          "present": true,
          "status": "content",
          "source_heading": "SYSTEMS AFFECTED",
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cardiovascular—bradycardia, peripheral vasodilation.",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Endocrine/metabolic—hypothermia.",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gastrointestinal (GI)—hypersalivation, vomiting.",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hepatobiliary—elevated liver enzymes (LEs), hepatic failure.",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nervous—ataxia, tremors, CNS depression.",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory—respiratory irritation/distress.",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Skin—irritation, possible ulceration.",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 1
            }
          ]
        },
        "GENETICS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GENETICS",
          "content_blocks": []
        },
        "INCIDENCE/PREVALENCE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "INCIDENCE/PREVALENCE",
          "content_blocks": []
        },
        "GEOGRAPHIC DISTRIBUTION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GEOGRAPHIC DISTRIBUTION",
          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Cats are more sensitive than dogs. Cats lack glucuronyl transferase; cannot metabolize/eliminate toxins via hepatic glucuronidation.",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Signs vary based on type/concentration of oil. Higher the concentration the greater the risk. Only 7–8 drops of 100% oil may be needed to cause toxicosis.",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Onset—1–8 hours post exposure.",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Animal may smell of oil (hair coat, skin, breath) or feel greasy.",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nausea, hypersalivation, vomiting, abdominal pain.",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypothermia.",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ataxia, tremors, CNS depression.",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Coughing, wheezing, panting, tachypnea, and dyspnea.",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bradycardia, hypotension.",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Elevated LEs (cats, sometimes dogs—pennyroyal oil).",
              "pdf_page": 554,
              "printed_page": 472,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
