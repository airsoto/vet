      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Uncommon, highly aggressive, rapidly growing tumor typically affecting the caudal maxilla and orbit of young dogs.",
              "pdf_page": 1082,
              "printed_page": 1000,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most are highly bone-invasive and are non-encapsulated with a smooth to slightly nodular surface (mistaken as benign); may become ulcerated.",
              "pdf_page": 1082,
              "printed_page": 1000,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Biopsy—reveals undifferentiated malignancy of undetermined histogenesis.",
              "pdf_page": 1082,
              "printed_page": 1000,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Highly metastatic—regional lymphatic spread and distant sites.",
              "pdf_page": 1082,
              "printed_page": 1000,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Local disease often represents life-limiting issue despite the high metastatic propensity.",
              "pdf_page": 1082,
              "printed_page": 1000,
              "column": 1
            }
          ]
        },
