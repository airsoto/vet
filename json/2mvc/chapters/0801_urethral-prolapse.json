      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Bacterial urethritis warrants use of appropriate antibiotics.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Consider using diethylstilbestrol for 3–6 weeks after surgery to reduce frequency of erections.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 3
            }
          ]
        },
