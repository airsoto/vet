    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Reevaluate 7–10 days following surgery for hemorrhage or recurrence of urethral prolapse.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 3
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "If urethral prolapse is associated with penile erection, prevent contact with female dogs or situations likely to cause erection.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 3
            }
          ]
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Most common postoperative complication was hemorrhage (39%).",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prolapse recurred in 57% of dogs, but was less common when postoperative butorphanol or acepromazine were given.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Recurrence of the prolapse may occur, especially if an underlying cause has not been detected and eliminated or controlled.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 3
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Prolapse may persist without significant sequelae. Some dogs may not require therapy.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Some may not have problems after castration and/or surgical correction of a prolapsed urethra.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 3
            }
          ]
        }
      }
    },
