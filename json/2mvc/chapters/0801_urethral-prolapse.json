  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Prolapse of the mucosal lining of the distal urethra through the external urethral orifice.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prolapsed urethra appears as a congested, pea-shaped mass protruding from the distal end of the penis and is often associated with hemorrhage. Excessive licking may result in further traumatic damage to the exposed urethral mucosa.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
        "PATHOPHYSIOLOGY": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": []
        },
        "SYSTEMS AFFECTED": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": []
        },
        "GENETICS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GENETICS",
          "content_blocks": []
        },
        "INCIDENCE/PREVALENCE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "INCIDENCE/PREVALENCE",
          "content_blocks": []
        },
        "GEOGRAPHIC DISTRIBUTION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GEOGRAPHIC DISTRIBUTION",
          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Reported in male dogs and extremely rare in male cats.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most common in English bulldog, Boston terrier, and Yorkshire terrier.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mean age 18 months; range 4 months–5 years.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Intermittent or persistent bleeding from the urethra.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intermittent or persistent licking of penis.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dysuria and pollakiuria caused by concomitant disorders.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Persistent or intermittent urethral prolapse.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pale mucous membranes if anemic.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Necrosis of the prolapsed urethra secondary",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "to drying or self-induced trauma from licking.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Uroliths may be palpable in the urinary",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 1,
              "subheading": "Physical Examination Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "bladder or urethra.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 1,
              "subheading": "Physical Examination Findings"
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "May result from sexual excitement and/or unrelated disorders (e.g., infections, uroliths, neoplasia) of the lower urinary tract.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Increased intra-abdominal pressure secondary to dysuria associated with urocystoliths.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Proposed causes include abnormal development of the urethra with increased intra-abdominal pressure as a consequence of brachycephalic airway syndrome, dysuria, or sexual activity. Increased intra-abdominal pressure could impair venous return of blood through the pudendal veins, predisposing susceptible dogs to engorgement of the corpus spongiosum surrounding the distal urethra.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Breed predisposition (bulldogs and Boston terriers).",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Prostatic disease.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Persistent penile frenulum.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fracture of the os penis.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Balanoposthitis.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urethritis.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urethroliths.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Coagulopathy.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urethral neoplasia.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "CBC—may reveal regenerative anemia.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Serum biochemistries—usually normal.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hematuria may be absent in urine collected by cystocentesis, but present in voided urine.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urine culture and sensitivity.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Coagulation profile may rule out coagulopathy.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Survey radiographs—useful to find some uroliths and evaluate the prostate size.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Contrast cystourethrography—useful to rule out radiolucent uroliths, urethral disorders, and prostatic disease.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal ultrasonography—useful to evaluate the prostate and urinary bladder.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ejaculation—useful to evaluate urethra during penile erection; some urethral prolapses are present only during penile erection.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Evaluation of ejaculate may show evidence of prostatic disease.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Enlarged images obtained with a surgical microcamera associated with a flexible endoscope may be necessary to diagnose urethral prolapse in cats.",
              "pdf_page": 1447,
              "printed_page": 1365,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": []
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "May not be required if asymptomatic or only associated with episodic bleeding.",
          "pdf_page": 1447,
          "printed_page": 1365,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "If present only during penile erection, consider castration prior to attempting surgical removal of prolapsed tissue; diethylstilbestrol given for 3–6 weeks after surgery may reduce frequency of erections. If cause is unknown, castration status may not affect prolapse recurrence.",
          "pdf_page": 1447,
          "printed_page": 1365,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Consider surgery for patients with excessive bleeding, pain, or extensive ulceration or necrosis of the prolapsed tissue, or if refractory to medical management.",
          "pdf_page": 1447,
          "printed_page": 1365,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Satisfactory results have been obtained by manual reduction of the prolapse followed by urethropexy.",
          "pdf_page": 1447,
          "printed_page": 1365,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "CO2laser surgical technique may improve hemostasis, visualization, and accuracy of the surgeon, and decrease postoperative swelling.",
          "pdf_page": 1447,
          "printed_page": 1365,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "A surgical microscope may be necessary for adequate visualization to perform urethro plasty in cats.",
          "pdf_page": 1447,
          "printed_page": 1365,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Postoperative hemorrhage and prolapse recurrence may be reduced with a simple continuous suture pattern and administration of postoperative sedation.",
          "pdf_page": 1447,
          "printed_page": 1365,
          "column": 2
        }
      ],
