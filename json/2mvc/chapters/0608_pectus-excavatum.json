              "printed_page": 1052,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Swimmer syndrome—limbs not adducted properly; ambulation impaired.",
              "pdf_page": 1134,
              "printed_page": 1052,
              "column": 1
            }
