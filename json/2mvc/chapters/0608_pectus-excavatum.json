      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Deformity of the sternum and costal cartilages that results in a dorsal-to-ventral narrowing of the chest, primarily in the caudal aspect.",
              "pdf_page": 1134,
              "printed_page": 1052,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Can have secondary abnormalities of respiratory and cardiovascular function from restriction of ventilation and cardiac compression.",
              "pdf_page": 1134,
              "printed_page": 1052,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Considered congenital in origin although an acquired case has been reported.",
              "pdf_page": 1134,
              "printed_page": 1052,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Upper respiratory obstruction at a young age could cause abnormal respiratory gradients and subsequent pectus excavatum.",
              "pdf_page": 1134,
              "printed_page": 1052,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Uncommon defect.",
              "pdf_page": 1134,
              "printed_page": 1052,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Concurrent cardiac defects common.",
              "pdf_page": 1134,
              "printed_page": 1052,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Some patients demonstrate swimmer syndrome—neonatal dogs lack the ability to posture properly and remain in sternal recumbency, which can lead to invagination of the sternum.",
              "pdf_page": 1134,
              "printed_page": 1052,
              "column": 1
            }
          ]
        },
