              "printed_page": 1052,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most common age of presentation—4 weeks–3 months.",
              "pdf_page": 1134,
              "printed_page": 1052,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Male cats more often reported than females, no sex predisposition noted in dogs.",
              "pdf_page": 1134,
              "printed_page": 1052,
              "column": 1
            }
          ]
        },
