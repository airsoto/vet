          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs and cats.",
              "pdf_page": 985,
              "printed_page": 903,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No breed, age, or sex predilections.",
              "pdf_page": 985,
              "printed_page": 903,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Dogs",
              "pdf_page": 985,
              "printed_page": 903,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Common sign—vomiting.",
              "pdf_page": 985,
              "printed_page": 903,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Possible signs—lethargy, hypoglycemia,",
              "pdf_page": 985,
              "printed_page": 903,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "trembling and diarrhea.",
              "pdf_page": 985,
              "printed_page": 903,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Cats",
              "pdf_page": 985,
              "printed_page": 903,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Frequent sign—vomiting.",
              "pdf_page": 985,
              "printed_page": 903,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Possible signs—lethargy, diarrhea, and",
              "pdf_page": 985,
              "printed_page": 903,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "vocalization.",
              "pdf_page": 985,
              "printed_page": 903,
              "column": 1,
              "subheading": "Cats"
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
