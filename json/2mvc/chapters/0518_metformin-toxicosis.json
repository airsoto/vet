        },
        "CONTRAINDICATIONS/POSSIBLE INTERACTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Concurrent administration of cimetidine may reduce the urinary excretion of metformin by competing for renal tubular organic cationic transport systems.",
              "pdf_page": 985,
              "printed_page": 903,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The manufacturer states that other cationic drugs that undergo substantial tubular secretion (e.g., amiloride, digoxin, morphine, procainamide, quinidine, quinine, ranitidine, triamterene, trimethoprim, and vancomycin) may possibly decrease the urinary excretion of metformin.",
              "pdf_page": 985,
              "printed_page": 903,
              "column": 2
            }
          ]
        },
        "ALTERNATIVE DRUG(S)": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "ALTERNATIVE DRUG(S)",
          "content_blocks": []
