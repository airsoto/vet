        "PREGNANCY/FERTILITY/BREEDING": {
          "present": true,
          "status": "content",
          "source_heading": "PREGNANCY/FERTILITY/BREEDING",
          "canonical_heading": "PREGNANCY/FERTILITY/BREEDING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "No evidence of harm to the fetus or impaired fertility during reproduction studies in rats and rabbits given metformin hydrochloride dosages of 600 mg/kg daily.",
              "pdf_page": 985,
              "printed_page": 903,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No adequate and controlled studies to date using metformin hydrochloride in pregnant women.",
              "pdf_page": 985,
              "printed_page": 903,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Excreted in milk in levels similar to plasma. Caution advised in lactating queens.",
              "pdf_page": 985,
              "printed_page": 903,
              "column": 3
            }
          ]
        },
