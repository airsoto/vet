    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Induce emesis within the first 2–3 hours of exposure.",
          "pdf_page": 985,
          "printed_page": 903,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Activated charcoal should only be considered with very large exposure.",
          "pdf_page": 985,
          "printed_page": 903,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Treat gastrointestinal signs supportively.",
          "pdf_page": 985,
          "printed_page": 903,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Treat lactic acidosis if present.",
          "pdf_page": 985,
          "printed_page": 903,
          "column": 2
        }
      ],
