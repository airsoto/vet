      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Metformin (Glucophage) is a biguanide antihyperglycemic prescription medication labeled for the treatment of non-insulindependent (type 2) diabetes mellitus in humans.",
              "pdf_page": 985,
              "printed_page": 903,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Available as single or extended release formulation (Glucophage XR).",
              "pdf_page": 985,
              "printed_page": 903,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Formulated as a single ingredient and in combination with other antidiabetic",
              "pdf_page": 985,
              "printed_page": 903,
              "column": 1
            }
          ]
        },
