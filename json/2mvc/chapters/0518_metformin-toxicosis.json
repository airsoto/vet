    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "The agent potentially could be useful in the adjunctive treatment of non-insulindependent diabetes mellitus in cats; use is controversial.",
          "pdf_page": 985,
          "printed_page": 903,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Toxicity causes gastrointestinal signs and lethargy.",
          "pdf_page": 985,
          "printed_page": 903,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "578 exposures to metformin were reported to the American Society for the Prevention of Cruelty to Animals (ASPCA) Animal Poison Control Center (APCC) during 2015–2018. Of these, 96.1% dogs, 3.7% cats, 0.3% birds. Common findings recorded are vomiting 9.3%, lethargy 3.1%, hypoglycemia 1.9%, trembling 1.5%, diarrhea 1.2%.",
          "pdf_page": 985,
          "printed_page": 903,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Vomiting developed from doses as low as 15.3 mg/kg with hypoglycemia at 48 mg/kg.",
          "pdf_page": 985,
          "printed_page": 903,
          "column": 1
        }
      ],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Metoclopramide 0.2–0.5 mg/kg PO, SC, or IM q6h.",
              "pdf_page": 985,
              "printed_page": 903,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sucralfate 0.5–1 g PO q8–12h for dogs and 0.25–0.5 g PO q8–12h for cats.",
              "pdf_page": 985,
              "printed_page": 903,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Famotidine 0.5–1.1 mg/kg orally q12–24h for dogs and cats.",
              "pdf_page": 985,
              "printed_page": 903,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ranitidine 1–2 mg/kg PO, SC, or IM q8–12h for dogs and 2.5 mg/kg IV q12h or 3.5 mg/kg PO q12h for cats.",
              "pdf_page": 985,
              "printed_page": 903,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Omeprazole 0.5–1 mg/kg PO q24h for dogs and cats.",
              "pdf_page": 985,
              "printed_page": 903,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bicarbonate—if serum bicarbonate or total CO2is unavailable: 2–3 mEq/kg IV over 30 minutes if patient has decreased tissue perfusion or renal failure and does not have diabetic ketoacidosis. Must be used judiciously.",
              "pdf_page": 985,
              "printed_page": 903,
              "column": 2
            }
          ]
        },
