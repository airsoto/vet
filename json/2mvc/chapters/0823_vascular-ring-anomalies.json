    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Surgical correction of the vascular entrapment is indicated—can be performed thoracoscopically or by thoracotomy with similar results.",
          "pdf_page": 1481,
          "printed_page": 1399,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Medical management of concurrent aspiration pneumonia may be necessary.",
          "pdf_page": 1481,
          "printed_page": 1399,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Feeding procedures for megaesophagus may also be necessary for a prolonged period.",
          "pdf_page": 1481,
          "printed_page": 1399,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Supportive care with oxygen may be needed in animals with aspiration pneumonia.",
          "pdf_page": 1481,
          "printed_page": 1399,
          "column": 2
        }
      ],
