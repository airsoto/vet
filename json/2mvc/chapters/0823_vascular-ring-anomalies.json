        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Prognosis for resolution of the problem, even after surgery, is guarded. However, the majority of dogs that survive longer than 2 months post repair of PRAA have a good to excellent outcome.",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Complications of malnourishment and aspiration pneumonia are common and can be severe.",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Esophageal function may be permanently compromised.",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 2
            }
          ]
        }
      }
