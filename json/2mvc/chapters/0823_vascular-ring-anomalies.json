        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "Right Aortic Arch",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Entrapment of the esophagus by a persistent",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 1,
              "subheading": "Right Aortic Arch"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "right fourth aortic arch (PRAA) on the right",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 1,
              "subheading": "Right Aortic Arch"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and dorsally, the base of the heart and",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 1,
              "subheading": "Right Aortic Arch"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "pulmonary artery ventrally, and ductus or",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 1,
              "subheading": "Right Aortic Arch"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "ligamentum arteriosum on the left and dorsally.",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 1,
              "subheading": "Right Aortic Arch"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Causes megaesophagus cranial to the",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 1,
              "subheading": "Right Aortic Arch"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "obstruction at the base of the heart.",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 1,
              "subheading": "Right Aortic Arch"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Double Aortic Arch",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Entrapment of the esophagus by a functional",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 1,
              "subheading": "Double Aortic Arch"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "aortic arch on the right, an atretic aortic arch",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 1,
              "subheading": "Double Aortic Arch"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "on the left, the base of the heart and pulmonary",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 1,
              "subheading": "Double Aortic Arch"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "artery ventrally, and ductus or ligamentum",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 1,
              "subheading": "Double Aortic Arch"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "arteriosum on the left and dorsally.",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 1,
              "subheading": "Double Aortic Arch"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "obstruction at the base of the heart; also",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 1,
              "subheading": "Double Aortic Arch"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "causes some tracheal compression.",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 1,
              "subheading": "Double Aortic Arch"
            }
          ]
        },
