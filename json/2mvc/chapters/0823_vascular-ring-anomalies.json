        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiography—shows food-filled cranial esophagus or signs of aspiration pneumonia in some animals.",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Contrast esophagography—confirms megaesophagus extending to the heart base.",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fluoroscopy—may be used to differentiate esophageal motility disorders.",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Angiography—may be needed to differentiate between specific vascular ring anomalies.",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "OTHER DIAGNOSTIC PROCEDURES",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Esophagoscopy can be used to differentiate",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 2,
              "subheading": "OTHER DIAGNOSTIC PROCEDURES"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "esophageal motility disorders.",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 2,
              "subheading": "OTHER DIAGNOSTIC PROCEDURES"
            }
          ]
        },
