        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog and cat.",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Seen most commonly in German shepherd dogs, Irish setters, Great Danes, and Boston terriers.",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Regurgitation of undigested solid food in animals <6 months old.",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Malnourishment in many animals.",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Time between eating and regurgitation varies.",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Signs of aspiration pneumonia (e.g., cough, tachypnea, or dyspnea) in some animals.",
              "pdf_page": 1481,
              "printed_page": 1399,
              "column": 1
            }
          ]
        },
