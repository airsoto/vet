              "printed_page": 1318,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Genetic, traumatic, degenerative, or idiopathic causes may result in pain, occlusal dysfunction, joint laxity, chronic arthritis, or open-mouth locking.",
              "pdf_page": 1400,
              "printed_page": 1318,
              "column": 1
            }
          ]
        },
