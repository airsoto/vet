    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Nonpharmacologic considerations— management of gestational DM requires intensive fluid and insulin therapy.",
          "pdf_page": 643,
          "printed_page": 561,
          "column": 1
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "Continued glucose toxicity can destroy the pancreatic beta cells’ capacity to produce insulin, leading to permanent DM.",
          "pdf_page": 643,
          "printed_page": 561,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Ovariohysterectomy is recommended. While the diabetes may resolve at the end of diestrus or after parturition, it will return on subsequent cycles and then has a greater potential to become permanent.",
          "pdf_page": 643,
          "printed_page": 561,
          "column": 2
        }
      ],
