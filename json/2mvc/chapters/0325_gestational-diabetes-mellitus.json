    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Acromegaly—affected bitches are listless and have increased abdominal size, increased interdental spaces, polyuria/polydipsia, weight gain, and excessive skin folds in the facial/neck areas.",
              "pdf_page": 643,
              "printed_page": 561,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperglycemia.",
              "pdf_page": 643,
              "printed_page": 561,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Glucosuria.",
              "pdf_page": 643,
              "printed_page": 561,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metabolic acidosis if ketonemic or ketonuric.",
              "pdf_page": 643,
              "printed_page": 561,
              "column": 1
            }
          ]
        },
