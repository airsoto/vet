        "PREGNANCY/FERTILITY/BREEDING": {
          "present": true,
          "status": "content",
          "source_heading": "PREGNANCY/FERTILITY/BREEDING",
          "canonical_heading": "PREGNANCY/FERTILITY/BREEDING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "May abort the litter or have dystocia as a result of the effects of chronic hyperglycemia. There is thought to be a genetic component, due to a breed predisposition. It is not advised to continue to breed affected individuals.",
              "pdf_page": 643,
              "printed_page": 561,
              "column": 3
            }
          ]
        },
