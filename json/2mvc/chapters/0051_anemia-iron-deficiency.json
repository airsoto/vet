        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypoferremia (serum iron <70μg/dL) and transferrin saturation <15% support diagnosis.",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Serum iron values may be normal during",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Monitor CBC every 1–4 weeks, more iron repletion if blood loss is intermittent. frequently as needed.",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fecal exam for hookworms.",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Effective treatment associated with an",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fecal examination for occult blood or increase in MCV and reticulocyte volume. melena.",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Erythrocyte histogram—effective treatment reduces microcytic subpopulation over time",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
