    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "MCHC = mean cell hemoglobin concentration.",
          "pdf_page": 168,
          "printed_page": 86,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Identify/correct cause of blood loss, treat",
          "pdf_page": 168,
          "printed_page": 86,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "MCV = mean cell volume. underlying disease.",
          "pdf_page": 168,
          "printed_page": 86,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "MCVr = mean reticulocyte volume.",
          "pdf_page": 168,
          "printed_page": 86,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Administer iron until hematologic features",
          "pdf_page": 168,
          "printed_page": 86,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "PCV = packed cell volume. of iron deficiency resolve.",
          "pdf_page": 168,
          "printed_page": 86,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "RBC = red blood cell.",
          "pdf_page": 168,
          "printed_page": 86,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "If severe anemia (i.e., PCV <15%),",
          "pdf_page": 168,
          "printed_page": 86,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "RDW = red cell distribution width. transfusion may be required, using whole blood (10–30 mL/kg IV) or packed RBC",
          "pdf_page": 168,
          "printed_page": 86,
          "column": 2
        }
      ],
