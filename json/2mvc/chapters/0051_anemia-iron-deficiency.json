        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Fairly common in adult dogs, rare in adult",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "cats.",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Transient neonatal iron-deficiency anemia",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 1,
              "subheading": "cats."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "may occur at 5–10 weeks of age in kittens.",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 1,
              "subheading": "cats."
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Signs of anemia (e.g., lethargy, weakness, tachypnea, pale mucous membranes).",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cardiovascular—bounding pulses, tachycardia, systolic heart murmur.",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gastrointestinal—intermittent melena or hematochezia, diarrhea.",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Integumentary—heavy hematophagous parasite burden (e.g., fleas), wounds.",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic external blood loss.",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gastrointestinal—hookworms, lymphoma or other neoplasia, ulceration (related to medications, [e.g., non-steroidal antiinflammatories] or disease [e.g., renal disease]).",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Less common—severe flea infestation, urinary tract hemorrhage.",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Iatrogenic—blood donor overuse, excessive diagnostic blood sampling.",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inappropriate home-cooked diet (low dietary iron).",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Any cause of anemia, especially hemorrhage.",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Microcytic anemia in portosystemic shunt disease may or may not be due to iron deficiency.",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anemia of inflammatory disease—ironlimited erythropoiesis.",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Packed cell volume (PCV) variably decreased; may be within reference interval.",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Regenerative or nonregenerative anemia.",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Microcytosis—low normal or low mean cell volume (MCV), low mean reticulocyte volume (MCVr), anisocytosis, widened erythrocyte histogram, or increased red cell distribution width (RDW). Decreased mean cell hemoglobin concentration (MCHC) not sensitive or specific.",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Red blood cell (RBC) morphology— microcytosis, hypochromia, keratocyte (indicating oxidative damage), and schistocyte formation.",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reticulocyte indices reticulocyte corpuscular making oral therapy of little value until hemoglobin concentration mean (CHCMr), partial iron repletion has occurred. reticulocyte hemoglobin content (CHr),",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Oral iron supplementation should continue hypochromic reticulocyte RBCs (%HYPOr), 1–2 months, or until resolved. and %LowCHr are sensitive for detecting",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ferrous sulfate powder—place in food or iron-limited erythropoiesis, but not specific. drinking water, 100–300 mg PO q24h.",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lab tests indicating iron-limited erythro-",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ferrous gluconate—325 mg PO q24h. poiesis do not differentiate true from",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "CONTRAINDICATIONS/POSSIBLE",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "functional iron deficiency. Clinical findings of",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 2,
              "subheading": "CONTRAINDICATIONS/POSSIBLE"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "INTERACTIONS",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "inflammatory disease are required to differentiate",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Oral iron is associated with unexplained",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "iron-limited erythropoiesis. Inflammatory",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "death in kittens and should be avoided.",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "disease and true iron deficiency may also",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Kittens undergo spontaneous iron",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "occur concurrently.",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "replection beginning at 5–6 weeks of age.",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thrombocytosis due to chronic blood loss.",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 2,
              "subheading": "INTERACTIONS"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypoproteinemia—from blood loss.",
              "pdf_page": 168,
              "printed_page": 86,
              "column": 2,
              "subheading": "INTERACTIONS"
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
