    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "If infection established in a kennel, evacuate kennel for 1–2 weeks and disinfect with sodium hypochlorite (1 : 30 dilution), chlorhexidine, or benzalkonium; influenza virus can live on hard surfaces for up to 24 hours.",
          "pdf_page": 855,
          "printed_page": 773,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Uncomplicated cases should resolve within 10–14 days; if patient continues to cough beyond 14 days, further diagnostics indicated.",
          "pdf_page": 856,
          "printed_page": 774,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Mortality rate highly variable and likely linked to degree of secondary bacterial infection, strain of virus, and intensity of veterinary care.",
          "pdf_page": 856,
          "printed_page": 774,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Currently there are licensed influenza vaccines for use in dogs that cover H3N8, H3N2, or both. There are no licensed vaccines for cats.",
          "pdf_page": 856,
          "printed_page": 774,
          "column": 1
        }
      ],
