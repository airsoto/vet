        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Matrix gene reverse transcriptase polymerase chain reaction (RT-PCR) test— most reliable and preferred test; can detect agent in acute phase of disease (1–7 days post onset of clinical signs) in nasal swab.",
              "pdf_page": 855,
              "printed_page": 773,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Viral isolation—possible early (~first 3 days) in infection.",
              "pdf_page": 855,
              "printed_page": 773,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "PCR and viral isolation can be negative if",
              "pdf_page": 855,
              "printed_page": 773,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "collected too late in infection.",
              "pdf_page": 855,
              "printed_page": 773,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Serologic tests for H3N8 will not detect",
              "pdf_page": 855,
              "printed_page": 773,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "H3N2 and vice versa; must test for each separately.",
              "pdf_page": 855,
              "printed_page": 773,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hemagglutination inhibition test—preferred serologic test; acute and convalescent titers optimal; since most dogs have no circulating CIV antibodies, antibodies detected in serum more than 7 days post onset of clinical signs determine exposure to CIV.",
              "pdf_page": 855,
              "printed_page": 773,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Antigen-capture ELISA tests gave unacceptable levels of false negatives with H3N8 infections, but higher viral loads with H3N2 give acceptable results if testing done early in course of infection.",
              "pdf_page": 855,
              "printed_page": 773,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Primary lesion caused by infection is destruction of ciliated epithelial cell layer in upper airways with extension into lungs. Areas of lung consolidation can be found 6–10 days post infection.",
              "pdf_page": 855,
              "printed_page": 773,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Infected animals should be isolated to prevent infection of other animals.",
          "pdf_page": 855,
          "printed_page": 773,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Contagious period for H3N2 CIV extends approximately 2 weeks after onset of clinical signs.",
          "pdf_page": 855,
          "printed_page": 773,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Continued coughing of affected animal is not a sign of virus shedding.",
          "pdf_page": 855,
          "printed_page": 773,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Strongly recommend treating uncomplicated cases as outpatients to prevent hospital contamination.",
          "pdf_page": 855,
          "printed_page": 773,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Only hospitalize those with pneumonia that require IV fluid or oxygen support.",
          "pdf_page": 855,
          "printed_page": 773,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Enforced rest—for at least 14–21 days (uncomplicated cases); 2 months in cases of pneumonia.",
          "pdf_page": 855,
          "printed_page": 773,
          "column": 3
        }
      ],
