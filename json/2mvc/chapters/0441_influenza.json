        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Natural infections of H3N8 CIV currently limited to dogs; H3N2 virus is capable of infecting dogs and cats; H7N2 has infected shelter cats.",
              "pdf_page": 855,
              "printed_page": 773,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "All dogs and cats are susceptible to infection; there are no known age, breed, or sex restrictions on susceptibility.",
              "pdf_page": 855,
              "printed_page": 773,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "60–80% of infected dogs develop clinical",
              "pdf_page": 855,
              "printed_page": 773,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Incubation period 2–4 days post infection.",
              "pdf_page": 855,
              "printed_page": 773,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Modest febrile response 39.4–40 °C (103–104 °F) 3–6 days post infection.",
              "pdf_page": 855,
              "printed_page": 773,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Clear nasal discharge, which can progress to thick, mucoid discharge, most frequently caused by secondary bacterial colonization.",
              "pdf_page": 855,
              "printed_page": 773,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "More severe form of disease shows higher body temperatures with development of pneumonia and tachypnea 6–10 days post infection.",
              "pdf_page": 855,
              "printed_page": 773,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Many dogs develop a cough that can last for several weeks.",
              "pdf_page": 855,
              "printed_page": 773,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory infection caused by influenza viruses.",
              "pdf_page": 855,
              "printed_page": 773,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Most cases have a history of group housing in kennels, day care centers, and rescue shelters, or contact with animals that have recently been in group housing or social settings such as dog shows.",
              "pdf_page": 855,
              "printed_page": 773,
              "column": 2
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "On an individual basis, early signs of influenza are indistinguishable from signs of kennel cough complex.",
              "pdf_page": 855,
              "printed_page": 773,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Distinction from typical respiratory pathogens of dogs is found in group settings in which 60–80% of dogs can show clinical signs.",
              "pdf_page": 855,
              "printed_page": 773,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Later in disease course—pneumonia may develop with or without secondary bacterial infections.",
              "pdf_page": 855,
              "printed_page": 773,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Generally unremarkable.",
              "pdf_page": 855,
              "printed_page": 773,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CBC may reflect stress initially, then bacterial pneumonia later in disease (leukocytosis, left shift).",
              "pdf_page": 855,
              "printed_page": 773,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
