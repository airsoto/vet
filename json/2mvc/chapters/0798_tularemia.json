      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Treat all cases empirically until laboratory confirmation obtained.",
              "pdf_page": 1441,
              "printed_page": 1359,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Little information available on the efficacy",
              "pdf_page": 1441,
              "printed_page": 1359,
              "column": 3
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "of antimicrobials;high mortality if patient not",
              "pdf_page": 1441,
              "printed_page": 1359,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "treated early.",
              "pdf_page": 1441,
              "printed_page": 1359,
              "column": 3,
              "subheading": "of antimicrobials;high mortality if patient not"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Early treatment with amoxicillin 22 mg/kg",
              "pdf_page": 1441,
              "printed_page": 1359,
              "column": 3,
              "subheading": "of antimicrobials;high mortality if patient not"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "PO q8h for 5–7 days or 22 mg/kg IM, SC",
              "pdf_page": 1441,
              "printed_page": 1359,
              "column": 3,
