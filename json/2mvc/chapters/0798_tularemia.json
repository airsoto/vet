        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Sudden onset of anorexia, lethargy, fever (104–106°F/40–41°C).",
              "pdf_page": 1441,
              "printed_page": 1359,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Enlarged submandibular and cervical LN.",
              "pdf_page": 1441,
              "printed_page": 1359,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tender abdomen, palpable mesenteric LN, hepatomegaly—depending on stage of disease.",
              "pdf_page": 1441,
              "printed_page": 1359,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Multifocal white patches or ulcers along glossopalatine arches and tongue.",
              "pdf_page": 1441,
              "printed_page": 1359,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Icterus.",
              "pdf_page": 1441,
              "printed_page": 1359,
              "column": 2
            }
          ]
        },
