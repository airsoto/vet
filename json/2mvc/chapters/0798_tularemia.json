            {
              "type": "bullet",
              "level": 0,
              "text": "Caution: use extreme care when working with infected specimens or isolates.",
              "pdf_page": 1441,
              "printed_page": 1359,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Direct smear—lesion or biopsy; difficult to see organism on Gram staining.",
              "pdf_page": 1441,
              "printed_page": 1359,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Culture—by reference laboratory only; blood, pleural fluid, LN aspirate onto cysteine- or cystine-containing media; not recoverable on routine laboratory media.",
              "pdf_page": 1441,
              "printed_page": 1359,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Direct fluorescent antibody testing— clinical materials or tissues; rapid assay of infection status.",
              "pdf_page": 1441,
              "printed_page": 1359,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Molecular testing of tissues in laboratories with validated diagnostic protocols.",
              "pdf_page": 1441,
              "printed_page": 1359,
              "column": 2
            }
          ]
        },
