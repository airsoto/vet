          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cat—occasionally.",
              "pdf_page": 1441,
              "printed_page": 1359,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog—rarely.",
