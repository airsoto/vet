        "ZOONOTIC POTENTIAL": {
          "present": true,
          "status": "content",
          "source_heading": "ZOONOTIC POTENTIAL",
          "canonical_heading": "ZOONOTIC POTENTIAL",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Extremely high.",
              "pdf_page": 1442,
              "printed_page": 1360,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Human cases related to direct dog contact via bite, scratch or face snuggling/licking, direct contact with dead animals retrieved by domestic dogs, contact with infected ticks; dogs with oral contact with diseased wildlife or carcasses may act as “living fomites” to contaminate humans.",
              "pdf_page": 1442,
              "printed_page": 1360,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "All personnel in contact with patient or body fluids must use face mask, gloves, and gowns to avoid infection.",
              "pdf_page": 1442,
              "printed_page": 1360,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Isolate patients.",
              "pdf_page": 1442,
              "printed_page": 1360,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In emerging disease areas, cat ownership is a disease risk for humans.",
              "pdf_page": 1442,
              "printed_page": 1360,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bites and scratches pose a risk for humans. Kwit NA, Schwartz A, Kugeler KJ, et al.",
              "pdf_page": 1442,
              "printed_page": 1360,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Do not mistake for plague or bite abscess in cats.",
              "pdf_page": 1442,
              "printed_page": 1360,
              "column": 2
            }
          ]
        },
