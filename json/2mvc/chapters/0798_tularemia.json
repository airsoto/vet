    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Monitor for disseminated intravascular coagulation—may occur late in the infection.",
              "pdf_page": 1441,
              "printed_page": 1359,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Monitor renal function during gentamicin therapy.",
              "pdf_page": 1441,
              "printed_page": 1359,
              "column": 3
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Avoid travel to endemic areas.",
              "pdf_page": 1441,
              "printed_page": 1359,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Endemic areas—confine animals to limit exposure to and ingestion of wildlife and ectoparasites (ticks); ectoparasite control by periodic spraying or dusting of animal and pastures.",
              "pdf_page": 1441,
              "printed_page": 1359,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neuter cats—limit hunting behavior, wildlife exposure.",
              "pdf_page": 1441,
              "printed_page": 1359,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Take precautions to limit contamination of food and water with carcasses of infected wildlife.",
              "pdf_page": 1441,
              "printed_page": 1359,
              "column": 3
            }
          ]
        },
