        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Alkaline phosphatase (ALP) concentration of seminal plasma—rule out incomplete ejaculation; samples with ALP <5,000 U/L consistent with incomplete ejaculation or bilateral epididymal obstruction.",
              "pdf_page": 1401,
              "printed_page": 1319,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Ultrasonography—testicular size (document decreasing values over time, comparison between testicles); heterogenous echogenicity of parenchyma, with or without calcification (chronic).",
              "pdf_page": 1401,
              "printed_page": 1319,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Semen evaluation.",
              "pdf_page": 1401,
              "printed_page": 1319,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Testicular biopsy (for azoospermia)—Tru- Cut (tissue plug): most complete histopath ologic diagnosis; fix tissue for sectioning in Bouin’s or formalin solutions.",
              "pdf_page": 1401,
              "printed_page": 1319,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Karyotype—(hypoplasia) identify extra X chromosome or other numerical or structural chromosome anomaly.",
              "pdf_page": 1401,
              "printed_page": 1319,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Normal spermatogenesis on biopsy— indicates obstruction in azoospermic dogs.",
              "pdf_page": 1401,
              "printed_page": 1319,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Basement membrane thickness— differentiates hypoplasia from degeneration (thickness increased).",
              "pdf_page": 1401,
              "printed_page": 1319,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Removal of inciting cause, if possible; degeneration linked to adenohypophysis, adrenal gland, thyroid gland, or other metabolic disruption.",
          "pdf_page": 1401,
          "printed_page": 1319,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "No specific diagnosis—may try gonadotropic hormones; rare anecdotal reports of success.",
          "pdf_page": 1401,
          "printed_page": 1319,
          "column": 2
        }
      ],
