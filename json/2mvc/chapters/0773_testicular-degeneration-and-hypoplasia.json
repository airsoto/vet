        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog—any age or breed; hypoplasia, generally young; degeneration, generally old.",
              "pdf_page": 1401,
              "printed_page": 1319,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tortoiseshell cat—may be fertile; usually linked with sex chromosome abnormalities (see Sexual Development Disorders).",
              "pdf_page": 1401,
              "printed_page": 1319,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Infertility.",
              "pdf_page": 1401,
              "printed_page": 1319,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypoplasia (dogs)—rarely any physical signs other than small testes.",
              "pdf_page": 1401,
              "printed_page": 1319,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Degeneration (dogs)—history of scrotal or testicular insult may be relevant, reduced testicular size and loss of normal turgidity.",
              "pdf_page": 1401,
              "printed_page": 1319,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Oligospermia (low numbers of spermatozoa in the ejaculate) or azoospermia (no spermatozoa in the ejaculate).",
              "pdf_page": 1401,
              "printed_page": 1319,
              "column": 1
            }
          ]
        },
