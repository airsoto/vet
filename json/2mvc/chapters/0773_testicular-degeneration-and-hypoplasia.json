              "printed_page": 1319,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "GnRH 1μg/kg SC, with or with human",
              "pdf_page": 1401,
              "printed_page": 1319,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "chorionic gonadotropin (hCG) 1,600 IU, IM.",
              "pdf_page": 1401,
              "printed_page": 1319,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "hCG 500 IU SC, 2 times/week.",
              "pdf_page": 1401,
              "printed_page": 1319,
              "column": 3
            }
          ]
        },
