      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Gonadotropin-releasing hormone (GnRH) therapy successful in men with hypogonado",
              "pdf_page": 1401,
              "printed_page": 1319,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "tropic hypogonadism; no controlled studies in domestic animals:",
