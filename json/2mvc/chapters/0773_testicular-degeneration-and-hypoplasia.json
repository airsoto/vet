      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Degeneration—histologic changes occurring in the testes after puberty; may be differentiated from hypoplasia by increased thickness of basement membrane or by recognizing a space-filled gap between tail of epididymis and caudal pole of testicle.",
              "pdf_page": 1401,
              "printed_page": 1319,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypoplasia—a variety of histologic lesions thought to be congenital (although often not obvious until after puberty) or heritable.",
              "pdf_page": 1401,
              "printed_page": 1319,
              "column": 1
            }
          ]
        },
