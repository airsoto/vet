    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Degeneration—azoospermia or severe oligospermia in previously fertile dogs having small testes.",
              "pdf_page": 1401,
              "printed_page": 1319,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypoplasia—azoospermia with no history of proven fertility in dogs with small testes.",
              "pdf_page": 1401,
              "printed_page": 1319,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Spermatocele.",
              "pdf_page": 1401,
              "printed_page": 1319,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sperm granuloma.",
              "pdf_page": 1401,
              "printed_page": 1319,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Orchitis.",
              "pdf_page": 1401,
              "printed_page": 1319,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neoplasia.",
              "pdf_page": 1401,
              "printed_page": 1319,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ejaculatory failure—retrograde ejaculation, incomplete ejaculation.",
              "pdf_page": 1401,
              "printed_page": 1319,
              "column": 2
            }
          ]
        },
