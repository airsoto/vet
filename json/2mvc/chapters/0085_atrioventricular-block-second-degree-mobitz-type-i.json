        "DEFINITION": {
          "present": true,
          "status": "content",
          "source_heading": "DEFINITION",
          "canonical_heading": "DEFINITION",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Second-degree atrioventricular (AV) block refers to failure of one or more P waves but not all P waves to be conducted. Mobitz type I second-degree AV block occurs when AV transmission is progressively delayed prior to a blocked P wave.",
              "pdf_page": 232,
              "printed_page": 150,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "ECG Features",
              "pdf_page": 232,
              "printed_page": 150,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "PR interval—becomes progressively",
              "pdf_page": 232,
              "printed_page": 150,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "longer prior to the appearance of a P wave",
              "pdf_page": 232,
              "printed_page": 150,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "that is not followed by a QRS complex",
              "pdf_page": 232,
              "printed_page": 150,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(Figure 1).",
              "pdf_page": 232,
              "printed_page": 150,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Heart rate and QRS morphology—usually",
              "pdf_page": 232,
              "printed_page": 150,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "normal.",
              "pdf_page": 232,
              "printed_page": 150,
              "column": 1,
              "subheading": "ECG Features"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Often cyclic.",
              "pdf_page": 232,
              "printed_page": 150,
              "column": 1,
              "subheading": "ECG Features"
            }
          ]
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Frequently associated with high resting vagal tone and sinus arrhythmia in dogs.",
              "pdf_page": 232,
              "printed_page": 150,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Generally not pathologic or hemodynamically significant.",
              "pdf_page": 232,
              "printed_page": 150,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "This type of AV block usually results from conduction delay within the AV node itself (rather than delay in other segments of the AV conducting system) and is characterized by a progressive increase in AH interval, with eventual block between the A and H deflections on a His bundle recording.",
              "pdf_page": 232,
              "printed_page": 150,
              "column": 1
            }
          ]
        },
