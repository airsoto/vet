          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Cause is unknown, but buttressing in humans is considered to be an attempt by the body to stabilize a diseased tooth. Cats that are prone to periodontal disease may be at a higher risk for developing alveolar osteitis.",
              "pdf_page": 580,
              "printed_page": 498,
              "column": 1
            }
          ]
        }
