              "type": "bullet",
              "level": 0,
              "text": "Unknown; probably severe reaction to unidentified antigen.",
              "pdf_page": 760,
              "printed_page": 678,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—eosinophilic enteritis may be early form.",
              "pdf_page": 760,
              "printed_page": 678,
              "column": 1
            }
          ]
        }
      }
