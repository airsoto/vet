  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Idiopathic, persistent eosinophilia with infiltration of organs causing dysfunction, often leading to death.",
              "pdf_page": 760,
              "printed_page": 678,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "May be caused by a severe reaction to an unidentified antigen and/or dysregulation of immunologic control of eosinophilopoiesis.",
              "pdf_page": 760,
              "printed_page": 678,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Organ damage caused by effects of eosinophil granule products and eosinophilderived cytokines that are released in tissues from activated and/or necrotic cells.",
              "pdf_page": 760,
              "printed_page": 678,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Common sites of infiltration: gastrointestinal (GI) tract (especially intestine and liver), spleen, bone marrow, lung (dogs), and lymph nodes (especially mesenteric).",
              "pdf_page": 760,
              "printed_page": 678,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "More common in cats than dogs.",
              "pdf_page": 760,
              "printed_page": 678,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Unclear whether HES is a distinct entity from eosinophilic leukemia.",
              "pdf_page": 760,
              "printed_page": 678,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Generally poor prognosis, especially cats.",
              "pdf_page": 760,
              "printed_page": 678,
              "column": 1
            }
          ]
        },
