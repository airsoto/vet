        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—occurs more frequently in female, middle-aged domestic shorthairs.",
              "pdf_page": 760,
              "printed_page": 678,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—Rottweilers may be overrepresented.",
              "pdf_page": 760,
              "printed_page": 678,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Lethargy.",
              "pdf_page": 760,
              "printed_page": 678,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anorexia.",
              "pdf_page": 760,
              "printed_page": 678,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intermittent vomiting and diarrhea.",
              "pdf_page": 760,
              "printed_page": 678,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hepatosplenomegaly.",
              "pdf_page": 760,
              "printed_page": 678,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Weight loss.",
              "pdf_page": 760,
              "printed_page": 678,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thickened (diffuse or segmental) intestine that is often nonpainful.",
              "pdf_page": 760,
              "printed_page": 678,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lymphadenopathy (especially mesenteric).",
              "pdf_page": 760,
              "printed_page": 678,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dyspnea.",
              "pdf_page": 760,
              "printed_page": 678,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mass lesions caused by eosinophilic granulomatous inflammation and infiltration.",
              "pdf_page": 760,
              "printed_page": 678,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Less frequently—fever, pruritus, seizures, thromboembolic events.",
              "pdf_page": 760,
              "printed_page": 678,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
