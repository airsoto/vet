      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Uncommon granulomatous and pustular disorder of puppies.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rarely seen in adult dogs.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affects primarily the face, pinnae, and submandibular lymph nodes.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Immunopathogenesis unknown.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
