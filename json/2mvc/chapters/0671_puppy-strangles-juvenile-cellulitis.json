        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytology—pyogranulomatous inflammation with no microorganisms; nondegenerate neutrophils.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Culture—often sterile in early cases; secondary infection with chronicity.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1
            }
          ]
        },
        "IMAGING": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "IMAGING",
          "content_blocks": []
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Skin biopsy.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Multiple discrete or confluent granulomas and pyogranulomas—clusters of large epithelioid macrophages and neutrophils.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sebaceous glands and apocrine glands may be obliterated.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Suppurative changes in the dermis— predominate in later stages.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Panniculitis.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exudate culture—important for selection of antibiotics if secondary infection suspected.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 2
            }
          ]
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Early and aggressive therapy necessary because scarring may be severe.",
          "pdf_page": 1241,
          "printed_page": 1159,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Topical therapy—may be soothing and palliative; adjunct to corticosteroids.",
          "pdf_page": 1241,
          "printed_page": 1159,
          "column": 2
        }
      ],
