        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "subheading",
              "level": 0,
              "text": "•Dogs.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Age range—usually between 3 weeks and 4",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1,
              "subheading": "•Dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "months.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1,
              "subheading": "•Dogs."
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Predisposed breeds—golden retriever,",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1,
              "subheading": "•Dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Labrador retriever, dachshund, and Gordon",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1,
              "subheading": "•Dogs."
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "setter.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1,
              "subheading": "•Dogs."
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Acutely swollen face (eyelids, lips, and muzzle).",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Submandibular lymphadenopathy.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Marked pustular and exudative dermatitis; frequently fistulates; develops within 24–48 hours.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Purulent otitis externa.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lesions often become crusted.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affected skin is usually painful.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lethargy—50% of cases.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anorexia, pyrexia, and sterile suppurative arthritis—25% of cases.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sterile pyogranulomatous panniculitis (rare) over the trunk, preputial, or perianal area; lesions may appear as fluctuant subcutaneous nodules that fistulate.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Unknown—an immune dysfunction with a heritable cause is suspected.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Bacterial folliculitis/furunculosis.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Demodicosis.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Drug reaction/eruption.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Deep fungal infection.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cutaneous hypersensitivity.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vaccination reaction.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hymenoptera or insect envenomation.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute lymphoma.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 1
            }
          ]
        },
