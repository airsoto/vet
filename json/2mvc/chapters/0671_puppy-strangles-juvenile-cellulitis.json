    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Corticosteroids—high doses required; prednisolone 2.2 mg/kg divided q12h for at least 2 weeks then decreased over 2–4 weeks or dexamethasone 0.2 mg/kg q24h.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Do not taper too rapidly.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Corticosteroid—resistant cases: cyclosporine 5 mg/kg q24h.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Adult dogs with panniculitis may require longer therapy.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Antibiotics—only if there is evidence of secondary bacterial infection or as an adjunct therapy with immunosuppressive doses of corticosteroids.",
              "pdf_page": 1241,
              "printed_page": 1159,
              "column": 2
            }
          ]
        },
