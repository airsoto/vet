        "GEOGRAPHIC DISTRIBUTION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GEOGRAPHIC DISTRIBUTION",
          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Dogs and cats. Approximately half of animals involved in immersion accidents are <4 months of age.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Noted acutely after exposure to water.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cyanosis, apnea, respiratory distress.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Coughing ± clear to frothy red sputum.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vomiting.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Obtunded to comatose.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Crackles or wheezes auscultated over chest.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tachycardia or bradycardia, asystole.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Greater risk near bodies of water (including",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "pools, buckets, bathtubs) or ice.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Owner negligence or inadequate safety precautions",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "vs. purposeful harm.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Animals in or near water at time of seizure, head trauma, hypoglycemic event, cardiac arrhythmia, or syncopal episode are at risk of drowning.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypothermia, neck trauma, and meningitis.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "With drowning secondary to seizure, head trauma, hypoglycemic event, cardiac arrhythmia, or syncopal episode, history at time of presentation may be informative.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Fresh water inhalation/ingestion— hemodilution, hemolysis, and decreases in sodium, chloride, and urine specific gravity.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypertonic salt water ingestion/inhalation—",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hemoconcentration and increases in sodium, chloride, and urine specific gravity.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Arterial blood gas reveals hypoxemia (partial pressure of oxygen [PaO2]<80 mmHg), hypoventilation (partial pressure of carbon",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "dioxide [PaCO2]>50 mmHg), and acid-base",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "derangements.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 2,
              "subheading": "dioxide [PaCO2]>50 mmHg), and acid-base"
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Radiographic changes may not be detectable",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "for 24–48 hours.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Focal or diffuse alveolar pattern due to aspiration pneumonia or",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "noncardiogenic pulmonary edema.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mixed patterns may be present, ± radiopaque material filling the airways (“sand bronchogram”).",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Foreign body inhalation may produce",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "segmental atelectasis.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Progression of pulmonary injury to acute respiratory distress syndrome (ARDS) is possible and may appear as bilateral, diffuse, symmetric alveolar infiltrates.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Endotracheal or transtracheal wash with cytologic evaluation and culture with",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "sensitivity indicated if animal is stable.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "ECG",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "monitoring.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cervical radiographs, CT or MRI of brain, and brainstem auditory evoked response (BAER) assessment in select cases.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": []
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Initiate mouth-to-muzzle resuscitation",
          "pdf_page": 497,
          "printed_page": 415,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "on-site.",
          "pdf_page": 497,
          "printed_page": 415,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Emergency inpatient care is",
          "pdf_page": 497,
          "printed_page": 415,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "required.",
          "pdf_page": 497,
          "printed_page": 415,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Airway clearance, if obstructed, is",
          "pdf_page": 497,
          "printed_page": 415,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "first priority.",
          "pdf_page": 497,
          "printed_page": 415,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Cardiopulmonary resusci",
          "pdf_page": 497,
          "printed_page": 415,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "tation (CPR), if necessary.",
          "pdf_page": 497,
          "printed_page": 415,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Oxygen",
          "pdf_page": 497,
          "printed_page": 415,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "supplementation.",
          "pdf_page": 497,
          "printed_page": 415,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Intubation and mechanical ventilation with positive end-expiratory pressure may be required in animals with severe hypoxemia, hypercapnia, or imminent",
          "pdf_page": 497,
          "printed_page": 415,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "respiratory fatigue.",
          "pdf_page": 497,
          "printed_page": 415,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Fluid therapy and acid-base/electrolyte management are crucial.",
          "pdf_page": 497,
          "printed_page": 415,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Gradually rewarm (over 2–3 hours)",
          "pdf_page": 497,
          "printed_page": 415,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "hypothermic animals.",
          "pdf_page": 497,
          "printed_page": 415,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Gravitational drainage or abdominal thrusts (Heimlich maneuver) are not recommended in absence of airway obstruction owing to high risk of regurgitation and subsequent aspiration of",
          "pdf_page": 497,
          "printed_page": 415,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "stomach contents.",
          "pdf_page": 497,
          "printed_page": 415,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Continuous venovenous filtration may decrease mortality following salt water drowning.",
          "pdf_page": 497,
          "printed_page": 415,
          "column": 2
        }
      ],
