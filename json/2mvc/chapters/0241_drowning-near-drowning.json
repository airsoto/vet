              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Use of enrofloxacin in young animals may result in cartilage erosion.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 3
            }
          ]
