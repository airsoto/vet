              "type": "bullet",
              "level": 0,
              "text": "Corticosteroid therapy not indicated; use could be detrimental in animals with aspiration",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "pneumonia.",
