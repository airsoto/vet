    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Mannitol 0.5 g/kg IV over 30 min may be beneficial in animals with suspected cerebral",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "edema.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Broad-spectrum antibiotics (e.g., ampicillin 22 mg/kg IV q8h; enrofloxacin",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "10–20 mg/kg IV q24h in the dog, 5 mg/kg IV q24h in the cat) for aspiration pneumonia.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Beta-2 agonists may help animals with",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "suspected bronchospasm.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pentoxifylline decreased incidence of lung injury in dogs with experimental freshwater aspiration.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 3
            }
          ]
        },
