      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Continuous monitoring of heart rate and rhythm, respiratory rate, mucous membrane color and capillary refill time, urine output, arterial blood pressure, rectal temperature, and",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "neurologic status.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Arterial blood gas, CBC, biochemical profile, coagulation profile, and acid-base status checked as needed.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 3
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Close monitoring of animals (especially young and old/debilitated animals) near bodies of water. Place barriers around bodies of water, life jackets on animals, train owners to perform CPR.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 3
            }
          ]
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Aspiration pneumonia, noncardiogenic pulmonary edema, ARDS, gastrointestinal bleeding, diarrhea, vomiting, acute kidney injury, permanent neurologic derangements, disseminated intravascular coagulation, central diabetes insipidus.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 3
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Directly related to animal’s status at time of admission—animals that present comatose,",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 3
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "severely acidotic (pH<7.0), or requiring",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 3
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "cardiopulmonary resuscitation or mechanical",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 3,
              "subheading": "severely acidotic (pH<7.0), or requiring"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "ventilation have poor prognosis. Animals that",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 3,
              "subheading": "severely acidotic (pH<7.0), or requiring"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "present conscious have good prognosis if no",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 3,
              "subheading": "severely acidotic (pH<7.0), or requiring"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "complications ensue; 37.5% mortality rate in",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 3,
              "subheading": "severely acidotic (pH<7.0), or requiring"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "15 dogs and 1 cat with freshwater aspiration.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 3,
              "subheading": "severely acidotic (pH<7.0), or requiring"
            }
          ]
        }
      }
