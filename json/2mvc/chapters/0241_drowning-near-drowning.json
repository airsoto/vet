  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Defined as process of experiencing respiratory impairment from submersion or immersion in liquid; near drowning defined as water submersion followed by survival for at least 24 hours; recent changes in terminology prefer the use of “death, morbidity or no morbidity following a drowning episode.”",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Following submersion, elevations in CO2 levels in the bloodstream stimulate respiration, and subsequent aspiration of water occurs.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fresh water aspiration dilutes pulmonary surfactant, leading to alveolar collapse ± infectious pneumonia; hypertonic seawater aspiration leads to diffusion of interstitial water into alveoli; large volumes of water are not typically aspirated, but any amount results in ventilation–perfusion mismatch, hypoxemia,",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "and metabolic acidosis.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Submersion time, temperature of water, and type of water (fresh vs. salt vs. chemical water) significantly affect development of organ damage.",
              "pdf_page": 497,
              "printed_page": 415,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
