    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Advanced epithelial or endothelial disease with ulceration—may require treatment for",
          "pdf_page": 419,
          "printed_page": 337,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "ulcerative keratitis.",
          "pdf_page": 419,
          "printed_page": 337,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Stromal—usually none required; may perform superficial keratec tomy to remove lipid deposits if severe, but usually unnecessary and deposits may recur.",
          "pdf_page": 419,
          "printed_page": 337,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Inform client that some corneal dystrophies",
          "pdf_page": 419,
          "printed_page": 337,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "are inherited.",
          "pdf_page": 419,
          "printed_page": 337,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Advanced endothelial dystrophy—may use therapeutic soft contact lens with or without debridement of redundant corneal epithelial tags, conjunctival flap surgery, or thermal cautery of cornea.",
