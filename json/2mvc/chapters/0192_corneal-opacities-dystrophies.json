        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Epithelial—result of degenerative or innate abnormalities of corneal epithelium",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "and/or basement membrane.",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Stromal— innate abnormality or localized error in corneal lipid metabolism; may be affected by hyperlipoproteinemia (may increase opacity).",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Endothelium—degeneration of endothelial cell layer; subsequent loss of endothelial cell pump function results in corneal edema.",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 2
            }
          ]
        }
      }
