    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Reexamination—necessary only if ocular pain or corneal ulceration develops.",
          "pdf_page": 419,
          "printed_page": 337,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Corneal opacity—may wax and wane with lipid dystrophy; unlikely to resolve.",
          "pdf_page": 419,
          "printed_page": 337,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Corneal ulceration—may accompany progression of epithelial or endothelial",
          "pdf_page": 419,
          "printed_page": 337,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "dystrophy.",
          "pdf_page": 419,
          "printed_page": 337,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Vision—not substantially affected except in advanced cases.",
          "pdf_page": 419,
          "printed_page": 337,
          "column": 3
        }
