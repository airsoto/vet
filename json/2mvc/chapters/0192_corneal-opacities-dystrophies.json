          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Usually dogs; rare in cats.",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Epithelial",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Shetland Sheepdogs—age of onset 6",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Epithelial"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "months–6 years; slow progression.",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Epithelial"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Stromal",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually young adult dogs at age of onset.",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Stromal"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Affected breeds—Afghan hound, Airedale",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Stromal"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "terrier, Alaskan Malamute, American cocker",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Stromal"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "spaniel, beagle, bearded collie, bichon frisé,",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Stromal"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "cavalier King Charles spaniel, German",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Stromal"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "shepherd, Lhasa apso, mastiff, miniature",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Stromal"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "pinscher, rough collie, Samoyed, Siberian",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Stromal"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "husky, Weimaraner, whippet, and others;",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Stromal"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "inheritance pattern identified in few breeds.",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Stromal"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Endothelial",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—primarily Boston terriers, Chihuahuas,",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Endothelial"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and dachshunds; may affect other breeds;",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Endothelial"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "typically middle-aged or older at onset of",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Endothelial"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "clinical signs; female predilection suggested.",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Endothelial"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—affects young animals; described most",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Endothelial"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "often in domestic shorthairs; a similar condition",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Endothelial"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "without endothelial disease is inherited as an",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Endothelial"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "autosomal recessive disorder in Manx.",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Endothelial"
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "All cause some degree of opacity in cornea.",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Epithelial",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Can be asymptomatic or have blepharospasm;",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Epithelial"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "multifocal white or gray circular to irregular",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Epithelial"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "opacities or rings; sometimes associated with",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Epithelial"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "multifocal corneal erosions.",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Epithelial"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vision usually",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Epithelial"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "not affected.",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Epithelial"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Stromal",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually asymptomatic without inflamma-",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Stromal"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "tion.",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Stromal"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Central—most common; gray, white,",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Stromal"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "or silver oval to circular opacity of central or",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Stromal"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "paracentral cornea; with magnification may",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Stromal"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "note multiple fibrillar to coalescing opacities",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Stromal"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "that have crystalline or ground-glass",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Stromal"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "appearance (crystalline corneal dystrophy).",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Stromal"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diffuse—affects Airedales; more diffuse,",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Stromal"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "dense opacity than with central dystrophy.",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Stromal"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Annular—commonly affects Siberian",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Stromal"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "huskies; doughnut-shaped opacity of",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 1,
              "subheading": "Stromal"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "paracentral or peripheral cornea.",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 2,
              "subheading": "Stromal"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vision—",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 2,
              "subheading": "Stromal"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "usually not affected; visual deficit possible",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 2,
              "subheading": "Stromal"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "with advanced or diffuse disease.",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 2,
              "subheading": "Stromal"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Endothelial",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Asymptomatic in early stages.",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 2,
              "subheading": "Endothelial"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Edema of",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 2,
              "subheading": "Endothelial"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "temporal or inferio-temporal cornea that usually",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 2,
              "subheading": "Endothelial"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "progresses to entire cornea after months to years.",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 2,
              "subheading": "Endothelial"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Corneal epithelial bullae (bullous keratopathy)",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 2,
              "subheading": "Endothelial"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and subsequent corneal erosion ulceration may",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 2,
              "subheading": "Endothelial"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "develop; erosions or ulceration may cause",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 2,
              "subheading": "Endothelial"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "blepharospasm due to pain.",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 2,
              "subheading": "Endothelial"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vision—may be",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 2,
              "subheading": "Endothelial"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "impaired with advanced disease.",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 2,
              "subheading": "Endothelial"
            }
          ]
        },
