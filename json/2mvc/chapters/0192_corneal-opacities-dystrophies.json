    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Corneal ulceration—topical antibiotics and possibly atropine (see Keratitis—Ulcerative).",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Epithelial—1–2% cyclosporine in oil or 0.2% ointment q8–24h to relieve clinical",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "signs.",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Endothelial—topical 5% sodium chloride ointment; palliative treatment; does not markedly clear cornea, but may prevent progression and rupture of corneal epithelial bullae.",
              "pdf_page": 419,
              "printed_page": 337,
              "column": 3
            }
          ]
        },
