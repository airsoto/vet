        "ALTERNATIVE DRUG(S)": {
          "present": true,
          "status": "content",
          "source_heading": "ALTERNATIVE DRUG(S)",
          "canonical_heading": "ALTERNATIVE DRUG(S)",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Use of dietary antioxidants (e.g., bioflavonoids) is controversial, but may help prevent further formation of Heinz bodies.",
