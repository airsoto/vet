    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Immediate identification and removal of oxidant may be sufficient, though often takes several days after exposure for severity of",
          "pdf_page": 165,
          "printed_page": 83,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "anemia to reach nadir.",
          "pdf_page": 165,
          "printed_page": 83,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Treatment depends on severity and may include IV fluids, RBC transfusions, oxygen, and restricted activity.",
          "pdf_page": 165,
          "printed_page": 83,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Endoscopy or surgery to remove metallic items in gastrointestinal tract.",
          "pdf_page": 165,
          "printed_page": 83,
          "column": 2
        }
      ],
