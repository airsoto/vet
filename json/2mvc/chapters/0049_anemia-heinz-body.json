              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Signs related to underlying disease",
              "pdf_page": 165,
              "printed_page": 83,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "if present.",
              "pdf_page": 165,
              "printed_page": 83,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 165,
              "printed_page": 83,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pale, occasionally icteric mucous membranes,",
