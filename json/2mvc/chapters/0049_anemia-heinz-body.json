        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dietary—onions (raw, cooked, dehydrated, powdered), garlic, propylene glycol (cats).",
              "pdf_page": 165,
              "printed_page": 83,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Drugs—acetaminophen, phenacetin (cats), phenazopyridine (cats), methylene blue, vitamin K1 or K3 (dogs), DL-methionine (cats), benzocaine, phenylhydrazine (dogs),",
              "pdf_page": 165,
              "printed_page": 83,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "propofol (cats).",
              "pdf_page": 165,
              "printed_page": 83,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Miscellaneous—zinc (bolts, pennies minted after 1982, dermatologic or sun creams), naphthalene (mothballs), skunk musk.",
              "pdf_page": 165,
              "printed_page": 83,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Immune-mediated or hemoparasitic hemolysis.",
              "pdf_page": 165,
              "printed_page": 83,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Diagnosis of Heinz body anemia requires regenerative anemia, evidence of hemolytic process, presence of Heinz bodies in peripheral blood, and elimination of other causes of",
              "pdf_page": 165,
              "printed_page": 83,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "hemolysis or blood loss.",
              "pdf_page": 165,
              "printed_page": 83,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Regenerative anemia; severity depends on dose and",
              "pdf_page": 165,
              "printed_page": 83,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "duration of oxidant exposure.",
              "pdf_page": 165,
              "printed_page": 83,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hb concentration and mean corpuscular hemoglobin concentration (MCHC) may be falsely increased due to Heinz body",
              "pdf_page": 165,
              "printed_page": 83,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "interference with measurement.",
              "pdf_page": 165,
              "printed_page": 83,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Heinz bodies on routinely stained blood smear appear as small, nonstaining to pale red, round inclusions that may protrude from",
              "pdf_page": 165,
              "printed_page": 83,
              "column": 2
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "RBC surface. • Single, small (<0.5μm)",
              "pdf_page": 165,
              "printed_page": 83,
              "column": 2
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Heinz bodies may be found in cats without",
              "pdf_page": 165,
              "printed_page": 83,
              "column": 2,
              "subheading": "RBC surface. • Single, small (<0.5μm)"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "anemia, but large or multiple Heinz bodies in",
              "pdf_page": 165,
              "printed_page": 83,
              "column": 2,
              "subheading": "RBC surface. • Single, small (<0.5μm)"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "anemic cat suggest hemolytic anemia.",
              "pdf_page": 165,
              "printed_page": 83,
              "column": 2,
              "subheading": "RBC surface. • Single, small (<0.5μm)"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs",
              "pdf_page": 165,
              "printed_page": 83,
              "column": 2,
              "subheading": "RBC surface. • Single, small (<0.5μm)"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "may have concurrent eccentrocytosis.",
              "pdf_page": 165,
              "printed_page": 83,
              "column": 2,
              "subheading": "RBC surface. • Single, small (<0.5μm)"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperbilirubinemia, bilirubinuria, hemo-",
              "pdf_page": 165,
              "printed_page": 83,
              "column": 2,
              "subheading": "RBC surface. • Single, small (<0.5μm)"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "globinemia, and hemoglobinuria possible",
              "pdf_page": 165,
              "printed_page": 83,
              "column": 2,
              "subheading": "RBC surface. • Single, small (<0.5μm)"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "with intravascular hemolysis.",
              "pdf_page": 165,
              "printed_page": 83,
              "column": 2,
              "subheading": "RBC surface. • Single, small (<0.5μm)"
            }
          ]
        },
