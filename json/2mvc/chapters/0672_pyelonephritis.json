          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "ALTERNATIVE DRUG(S)",
          "content_blocks": []
        }
      }
    },
    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Perform urine cultures and urinalysis during antibiotic administration (∼5–7 days into treatment) and 1 and 4 weeks after antibiotics are finished.",
              "pdf_page": 1243,
              "printed_page": 1161,
              "column": 2
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Eliminate factors predisposing to UTI; correct ectopic ureters.",
              "pdf_page": 1243,
              "printed_page": 1161,
              "column": 2
            }
          ]
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Progressive CKD, recurrent pyelonephritis, struvite nephroliths, septicemia, septic shock, metastatic infection (e.g., endocarditis, polyarthritis).",
              "pdf_page": 1243,
              "printed_page": 1161,
              "column": 2
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Patients with acute or subacute pyelo nephritis—fair to good, with a return to normal health unless the patient also has nephroliths, CKD, or some other underlying cause for UTI (e.g., obstruction or neoplasia).",
              "pdf_page": 1243,
              "printed_page": 1161,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Established chronic infection of the renal medulla may be difficult to resolve because of poor tissue penetration of antibiotics.",
              "pdf_page": 1243,
              "printed_page": 1161,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Patients with CKD caused by pyelo nephritis—prognosis determined by the severity and rate of progression of the CKD.",
              "pdf_page": 1243,
              "printed_page": 1161,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Recurrent pyelonephritis is likely if infected nephroliths are not removed.",
              "pdf_page": 1243,
              "printed_page": 1161,
              "column": 3
            }
          ]
        }
      }
    },
    "MISCELLANEOUS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "ASSOCIATED CONDITIONS": {
          "present": true,
          "status": "content",
          "source_heading": "ASSOCIATED CONDITIONS",
          "canonical_heading": "ASSOCIATED CONDITIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Hyperadrenocorticism, exogenous glucocorticoid administration, CKD, hyperthyroidism (cats), and diabetes mellitus are associated with lower UTI, which can ascend into the ureters and kidneys.",
              "pdf_page": 1243,
              "printed_page": 1161,
              "column": 3
            }
          ]
        },
