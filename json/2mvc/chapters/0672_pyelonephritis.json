    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Base antibiotic selection on urine culture and susceptibility testing. Initiate antibiotics pending culture results.",
              "pdf_page": 1243,
              "printed_page": 1161,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Antibiotics should be bactericidal, achieve good serum and urine concentrations, and not be nephrotoxic.",
              "pdf_page": 1243,
              "printed_page": 1161,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "High serum and urinary antibiotic concentrations do not necessarily ensure high tissue concentrations in the renal medulla; thus, chronic pyelonephritis may be difficult to eradicate.",
              "pdf_page": 1243,
              "printed_page": 1161,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If systemically ill or azotemic, administer IV antibiotics for initial 48 hours.",
              "pdf_page": 1243,
              "printed_page": 1161,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Give orally administered antibiotics at full therapeutic dosages for 2–6 weeks. Duration of antibiotics required for resolution of pyelonephritis is not definitively known.",
              "pdf_page": 1243,
              "printed_page": 1161,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Do not use drugs that achieve good concentrations in urine but poor concen trations in serum (e.g., nitrofurantoin).",
              "pdf_page": 1243,
              "printed_page": 1161,
              "column": 2
            }
          ]
        },
        "CONTRAINDICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS",
          "canonical_heading": "CONTRAINDICATIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Do not use aminoglycosides unless no other alternatives exist on the basis of urine culture and susceptibility testing.",
              "pdf_page": 1243,
              "printed_page": 1161,
              "column": 2
            }
          ]
        },
        "PRECAUTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "PRECAUTIONS",
          "canonical_heading": "PRECAUTIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Trimethoprim-sulfa combinations can cause side effects (keratoconjunctivitis sicca, blood dyscrasias, and polyarthritis) when administered for more than 4 weeks.",
              "pdf_page": 1243,
              "printed_page": 1161,
              "column": 2
            }
          ]
        },
        "POSSIBLE INTERACTIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "POSSIBLE INTERACTIONS",
          "content_blocks": []
        },
        "CONTRAINDICATIONS/POSSIBLE INTERACTIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": []
        },
