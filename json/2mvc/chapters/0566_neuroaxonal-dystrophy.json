  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Inherited degenerative diseases of neurons in diverse regions of the CNS, particularly the cerebellum and associated pathways.",
              "pdf_page": 1059,
              "printed_page": 977,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Primary neuroaxonal dystrophy disorders are sometimes classified as abiotrophies.",
              "pdf_page": 1059,
              "printed_page": 977,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Inheritance—autosomal recessive in breeds where heritability is proven.",
              "pdf_page": 1059,
              "printed_page": 977,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The main pathologic feature of neuroaxonal dystrophy, axonal spheroids, also occurs in normal aging, as well as secondary to a number of other diseases, such as acquired or inherited metabolic diseases, and toxicities.",
              "pdf_page": 1059,
              "printed_page": 977,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
