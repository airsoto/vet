          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dog and cat.",
              "pdf_page": 1059,
              "printed_page": 977,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Breeds predisposed—domestic and Siamese cats, Rottweilers, collies, papillons, Chihuahuas, German shepherd dogs, Jack Russell terriers, and boxers.",
              "pdf_page": 1059,
              "printed_page": 977,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Age at onset—breed-specific, ranging from under 2 months of age in cats, Chihuahuas, and papillons, to 1–2 years in Rottweilers.",
              "pdf_page": 1059,
              "printed_page": 977,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cerebellar ataxia—progressive dysmetria and hypermetria of the limbs (rarely hypometria) with patellar hyperreflexia.",
              "pdf_page": 1059,
              "printed_page": 977,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Strength and proprioception normal in most cases. Rottweilers may have extensive involvement of the dorsal columns of the cervical spinal cord and may exhibit proprioceptive deficits.",
              "pdf_page": 1059,
              "printed_page": 977,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Loss of menace responses despite normal vision and facial nerves.",
              "pdf_page": 1059,
              "printed_page": 977,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Progressive signs of brainstem involvement may be a feature, especially in papillons, including loss of swallowing reflex and abnormal tongue movement; tetraplegia may develop in the final stages.",
              "pdf_page": 1059,
              "printed_page": 977,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mild intention tremors or head and neck dysmetria in some patients.",
              "pdf_page": 1059,
              "printed_page": 977,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Primarily cerebellar signs in Rottweilers, collies, Chihuahuas, and domestic cats; predominantly spinal cord lesions in German shepherd dogs and boxers; tremors and cerebellar ataxia present in all affected animals.",
              "pdf_page": 1059,
              "printed_page": 977,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Unknown.",
              "pdf_page": 1059,
              "printed_page": 977,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually classified as neuronal abiotrophy.",
              "pdf_page": 1059,
              "printed_page": 977,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Autosomal recessive inheritance proven in some breeds.",
              "pdf_page": 1059,
              "printed_page": 977,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Breed predisposition.",
              "pdf_page": 1059,
              "printed_page": 977,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Suspicion is based on clinical signs in a predisposed breed, usually in juvenile animals.",
          "pdf_page": 1059,
          "printed_page": 977,
          "column": 1
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Definitive diagnosis requires histopathologic examination of CNS tissue, usually post-mortem.",
          "pdf_page": 1059,
          "printed_page": 977,
          "column": 1
        }
      ],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Other congenital cerebellar anomalies, abiotrophies, and degenerative disorders. Reported occasionally in cats, and in a number of breeds of dog including border collie, Brittany, coton de Tulear, Gordon setter, Jack Russell (Parson Russell) terrier, Labrador retriever, Old English sheepdog, and many others.",
              "pdf_page": 1059,
              "printed_page": 977,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other structural anomalies of the caudal brainstem, including caudal occipital malformation syndrome and Dandy–Walker syndrome. Differentiated by imaging studies, particularly MRI. Certain breeds are predisposed, e.g., caudal occipital malformation syndrome in the cavalier King Charles spaniel.",
              "pdf_page": 1059,
              "printed_page": 977,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cerebellar hypoplasia caused byin utero infection of kittens with feline panleukopenia virus—apparent by 3–6 weeks of age; nonprogressive.",
              "pdf_page": 1059,
              "printed_page": 977,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Distemper encephalitis—differentiated on the basis of systemic signs preceding or accompanying the neurologic deficits and on results of CSF analysis (normal with neuro axonal dystrophy).",
              "pdf_page": 1059,
              "printed_page": 977,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other infectious encephalitides—fungal, rickettsial, and protozoal; differentiated on the basis of multisystemic signs in some patients, serologic testing, and CSF analysis.",
              "pdf_page": 1059,
              "printed_page": 977,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Noninfectious inflammatory encephalitides, particularly granulomatous meningoencephalomyelitis. Breed-specific encephalitides (pug, Maltese terrier, Yorkshire terrier) usually cause forebrain signs (seizures), but cerebellar involvement may occur. Differentiated by the presence of inflammatory changes in CSF and, in some cases, by contrast-enhancing lesions in the brain apparent with MRI.",
              "pdf_page": 1059,
              "printed_page": 977,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neoplasia affecting the cerebellum— primary, metastatic, or locally invasive. Occurs in older dogs and cats, usually over 5 years of age. Differentiated on the basis of imaging studies (particularly MRI), CSF analysis in some cases, and systemic involvement in the case of metastatic neoplasia.",
              "pdf_page": 1059,
              "printed_page": 977,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cervical spinal cord disease—proprioceptive deficits and tetraparesis.",
              "pdf_page": 1059,
              "printed_page": 977,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diagnosis of neuraxonal dystrophy is by exclusion; it may not be possible to reach an antemortem diagnosis.",
              "pdf_page": 1059,
              "printed_page": 977,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
