    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Rottweilers—worsen over 1–5 years; develop clonic patellar and crossed extensor reflexes.",
          "pdf_page": 1059,
          "printed_page": 977,
          "column": 3
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Not fatal, but severely incapacitating.",
          "pdf_page": 1059,
          "printed_page": 977,
          "column": 3
        }
      ],
