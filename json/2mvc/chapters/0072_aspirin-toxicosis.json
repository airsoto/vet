        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Cats and less commonly dogs.",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Depression, lethargy.",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anorexia.",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vomiting ± blood.",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diarrhea ± blood; melena.",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tachypnea.",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperthermia.",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pallor.",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Polyuria/polydipsia (rare).",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Muscular weakness and ataxia.",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ataxia, coma, seizures, and death in 1 or more days.",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Owners employing human dosage guidelines to medicate cats and dogs.",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—single 25 mg/kg dose has resulted in gastric bleeding.",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats have a decreased ability to conjugate salicylate with glycine and glucuronic acid due to a deficiency in glucuronyl transferase.",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Half-life increases with dosage—cats, 22–27 hours for 5–12 mg/kg and approximately 44 hours for 25 mg/kg; responsible for higher risk in cats. Dogs, half-life = 7.5 hours.",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Elimination is slower in neonatal and geriatric patients.",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Patients with hypoalbuminemia may be at higher risk of toxicity because aspirin is highly protein bound to plasma albumin.",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 1
            }
          ]
        }
      }
    },
