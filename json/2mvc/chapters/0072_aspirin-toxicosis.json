  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Given for its antipyretic, analgesic, antiinflammatory, and antiplatelet effects.",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Aspirin inhibits cyclooxygenase, reducing the synthesis of prostaglandins and thromboxanes.",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gastric irritation and hemorrhage can occur.",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Repeated doses can produce gastrointestinal ulceration and perforation and hepatic injury; renal injury is uncommon.",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Toxic hepatitis, marked metabolic acidosis, and anemia can occur, especially in cats (long half-life).",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hepatic damage may not be dose related.",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 1
            }
          ]
        },
