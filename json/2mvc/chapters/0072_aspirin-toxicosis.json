          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—prone to Heinz body formation.",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Decreased packed cell volume (PCV); may be marked, especially in cats.",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Leukocytosis. depression, and coma are poor prognostic",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypoproteinemia. indicators.",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Elevated liver enzymes.",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Elevated renal values (rare).",
              "pdf_page": 208,
              "printed_page": 126,
              "column": 2
            }
          ]
        },
