  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute to inapparent viral disease with neurologic manifestations caused by West Nile virus (WNV), a member of the family Flaviviridae, genusFlavivirus.",
              "pdf_page": 1516,
              "printed_page": 1434,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Geographic distribution of virus is North, Central, South America, Africa, Asia, southern Europe, and Australia (Kunjin virus).",
              "pdf_page": 1516,
              "printed_page": 1434,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Natural route of infection is through bite of numerous species of mosquitoes depending upon geographic location. Infection produces a low-level viremia, insufficient for dogs to be an amplifying host; antibody detectable by day 7 post infection.",
              "pdf_page": 1516,
              "printed_page": 1434,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
