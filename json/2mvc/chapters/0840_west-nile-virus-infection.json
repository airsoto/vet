              "type": "subheading",
              "level": 0,
              "text": "RISK TO OTHER ANIMALS",
              "pdf_page": 1516,
              "printed_page": 1434,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Generally normal.",
              "pdf_page": 1516,
              "printed_page": 1434,
              "column": 2,
              "subheading": "RISK TO OTHER ANIMALS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Virus is not transmitted from infected dog to",
              "pdf_page": 1516,
              "printed_page": 1434,
              "column": 2,
              "subheading": "RISK TO OTHER ANIMALS"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Serial sampling may show drop in leuko-",
              "pdf_page": 1516,
              "printed_page": 1434,
              "column": 2,
              "subheading": "RISK TO OTHER ANIMALS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "other animals. Clinical case of WNV should",
              "pdf_page": 1516,
              "printed_page": 1434,
              "column": 2,
              "subheading": "RISK TO OTHER ANIMALS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "cytes but may remain within normal.",
              "pdf_page": 1516,
              "printed_page": 1434,
              "column": 2,
              "subheading": "RISK TO OTHER ANIMALS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "be noted as indicative of infected mosquitoes",
              "pdf_page": 1516,
              "printed_page": 1434,
              "column": 2,
              "subheading": "RISK TO OTHER ANIMALS"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "in the area.",
              "pdf_page": 1516,
              "printed_page": 1434,
              "column": 2,
              "subheading": "RISK TO OTHER ANIMALS"
            }
          ]
        },
