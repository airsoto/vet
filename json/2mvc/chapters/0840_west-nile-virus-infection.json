        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Natural infections not limited by species or age.",
              "pdf_page": 1516,
              "printed_page": 1434,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Seroprevalence varies widely with geographic region (3–96%).",
              "pdf_page": 1516,
              "printed_page": 1434,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "High percentage of dogs show no clinical signs—no experimentally infected dogs have shown clinical signs.",
              "pdf_page": 1516,
              "printed_page": 1434,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Incubation period 2–4 days post infection.",
              "pdf_page": 1516,
              "printed_page": 1434,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Febrile response 104–108°F (40.3–42.2°C) 3–6 days post infection.",
              "pdf_page": 1516,
              "printed_page": 1434,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "In the rare affected dog, common signs are ataxia, depression, anorexia, tremors, conscious proprioceptive deficits, seizures, weakness, flaccid paralysis; polyarthritis and myocarditis also reported.",
              "pdf_page": 1516,
              "printed_page": 1434,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Neurologic disease caused by WNV.",
              "pdf_page": 1516,
              "printed_page": 1434,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Outdoor dogs much greater odds of being seropositive than indoor dogs; high seroprevalence in coyotes.",
              "pdf_page": 1516,
              "printed_page": 1434,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Stray dogs at greater odds of being seropositive than owned dogs.",
              "pdf_page": 1516,
              "printed_page": 1434,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lineage 1 virus more neurovirulent (all North American isolates) than lineage 2 (Africa).",
              "pdf_page": 1516,
              "printed_page": 1434,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Yearly fluctuation of infections linked to density of mosquito populations.",
              "pdf_page": 1516,
              "printed_page": 1434,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "On an individual basis, signs of WNVinduced neurologic disease are indistinguishable from signs associated with various “arbovirus” infections, e.g., eastern equine encephalitis (EEE), Venezuelan equine encephalitis (VEE), La Crosse.",
              "pdf_page": 1516,
              "printed_page": 1434,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other considerations—rabies, canine distemper, neosporosis, toxoplasmosis,",
              "pdf_page": 1516,
              "printed_page": 1434,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "pseudorabies, encephalomyocarditis virus,",
              "pdf_page": 1516,
              "printed_page": 1434,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Care should be taken if necropsy is done, as meningoencephalitis of unknown etiology infectious viral particles may be present in (MUE). tissue samples.",
              "pdf_page": 1516,
              "printed_page": 1434,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
