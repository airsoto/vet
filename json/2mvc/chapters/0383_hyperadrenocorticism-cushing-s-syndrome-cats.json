    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "FCS is a debilitating disease. Prognosis is guarded due to severity of complications and concurrent diseases.",
          "pdf_page": 749,
          "printed_page": 667,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Presurgical medical treatment is beneficial to prevent complications from fragile skin and infections.",
          "pdf_page": 749,
          "printed_page": 667,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Radiation therapy of macroadenomas allows better control of the disease and insulin resistance.",
          "pdf_page": 749,
          "printed_page": 667,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Unilateral adrenalectomy for AT and medical therapy for PDH are the most readily available effective treatment options.",
          "pdf_page": 749,
          "printed_page": 667,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Hypophysectomy (microsurgical transsphenoidal) is effective and available at some institutions.",
          "pdf_page": 749,
          "printed_page": 667,
          "column": 2
        }
      ],
