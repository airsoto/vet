    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Trilostane reversibly blocks steroid synthesis. In most patients with FCS from PDH, trilostane reduces clinical signs and improves endocrine test results. A starting dose of 5–10 mg/cat PO q12h is recommended.",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mitotane (Lysodren®; o,p′-DDD) is not recommended for treatment of FCS.",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Other medications have limited efficacy (ketoconazole, metyrapone, and aminoglutethimide).",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 3
            }
          ]
        },
