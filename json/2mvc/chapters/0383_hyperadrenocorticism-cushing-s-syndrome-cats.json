        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Insulin-resistant DM.",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acromegaly.",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hepatopathy.",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Renal disease.",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sex hormone–secreting adrenal tumor.",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperprogesteronism.",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dermatologic disease.",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Lymphopenia, anemia.",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hyperglycemia, hypercholesterolemia, hypertriglyceridemia, hypochloremia.",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Elevated urine cortisol : creatinine (UC : Cr) ratio, proteinuria.",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Azotemia, hyperglobulinemia (less common).",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Elevated serum alkaline phosphatase uncommon.",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 2
            }
          ]
        },
