  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Feline Cushing’s syndrome (FCS) or hyperadrenocorticism is a consequence of abnormally increased functional activity of the adrenal cortex.",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Caused by increased glucocorticoid secretion by the adrenal gland(s).",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Approximately 85% of cases due to bilateral adrenocortical hyperplasia from pituitary hyperplasia or tumor— pituitary-dependent hyperadrenocorticism (PDH).",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Remaining 15% caused by adrenal tumor (AT), half of which are benign.",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Regardless of etiology, concurrent unregulated diabetes mellitus (DM) is frequent (90%) and other concurrent diseases (e.g., pancreatitis, chronic kidney, or cardiac disease) are reported.",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 1
            }
          ]
        },
        "SYSTEMS AFFECTED": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": []
        },
        "GENETICS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GENETICS",
          "content_blocks": []
        },
        "INCIDENCE/PREVALENCE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "INCIDENCE/PREVALENCE",
          "content_blocks": []
        },
        "GEOGRAPHIC DISTRIBUTION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GEOGRAPHIC DISTRIBUTION",
          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Middle-aged to old cat.",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No known breed or sex predisposition.",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dermatologic abnormalities (alopecia; unkempt hair coat; thin, fragile skin that is easily bruised or torn), polyuria, polydipsia, polyphagia, weight loss, muscle wasting, and pot-bellied appearance.",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Weight gain (unless concurrent DM causes weight loss), hepatomegaly, and curled pinnae also seen.",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lethargy (dullness) secondary to muscle weakness or effects of pituitary mass.",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Excess sex hormones can cause signs such as penile barbs and behavioral changes (sexual).",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Pituitary adenoma with subsequent corticotropic hyperplasia and excess glucocorticoid secretion.",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Autonomously functioning benign adrenal adenoma (50%) or malignant adeno carcinoma (50%).",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Iatrogenic from glucocorticoid administration (rare).",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
