        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal ultrasound—accurate to differentiate PDH from AT in most cases; operator dependent. Symmetric adrenal glands of normal or enlarged size are suggestive of PDH; unilateral enlargement or asymmetric adrenal glands support AT.",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CT and MRI—visualization and measurement of pituitary tumors or characterization of adrenal tumors.",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 2
            }
          ]
        },
