            },
            {
              "type": "bullet",
              "level": 0,
              "text": "UC : Cr—sensitive (good negative",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 2,
              "subheading": "Screening Tests"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "predictive value).",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 2,
              "subheading": "Screening Tests"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Low-dose dexamethasone-suppression",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 2,
              "subheading": "Screening Tests"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "test—good sensitivity. Dose: 0.1 mg/kg IV.",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 2,
              "subheading": "Screening Tests"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Failure to suppress consistent with FCS.",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 2,
              "subheading": "Screening Tests"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Adrenocorticotropic hormone (ACTH)",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 2,
              "subheading": "Screening Tests"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "stimulation test—specific but poorly",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 2,
              "subheading": "Screening Tests"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "sensitive, not recommended as initial",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 2,
              "subheading": "Screening Tests"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "diagnostic test.",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 2,
              "subheading": "Screening Tests"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Assays for plasma sex hormone and",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 2,
              "subheading": "Screening Tests"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "progesterone concentrations may rule out",
              "pdf_page": 749,
              "printed_page": 667,
              "column": 2,
              "subheading": "Screening Tests"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "differentials.",
