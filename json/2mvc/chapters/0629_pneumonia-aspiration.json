    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Antibiotic therapy—if signs of sepsis or severe compromise, ampicillin with sulbactam (20 mg/kg IV q8h) plus a fluoroquinolone IV. Adjust antibiotic selection based on results of airway cytology, culture and sensitivity, and clinical response; continue for 10 days after resolution of clinical and radiographic signs; if no signs of sepsis, ampicillin with sulbactam pending results of culture.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Beta-agonist bronchodilators—sometimes cause dramatic improvement but have the potential to worsen ventilation:perfusion mismatch; most often helpful in acute aspiration or with auscultable wheezes.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Short-acting corticosteroids—consider for up to 48 hours to combat inflammation associated with life-threatening aspiration.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 2
            }
          ]
        },
        "CONTRAINDICATIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CONTRAINDICATIONS",
          "content_blocks": []
        },
        "PRECAUTIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PRECAUTIONS",
          "content_blocks": []
        },
        "POSSIBLE INTERACTIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "POSSIBLE INTERACTIONS",
          "content_blocks": []
        },
        "CONTRAINDICATIONS/POSSIBLE INTERACTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Diuretics—generally contraindicated; drying of airways reduces mucociliary clearance.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Corticosteroids—contraindicated beyond initial stabilization; predispose patient to infection.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fluoroquinolones and chloramphenicol— can prolong clearance of theophylline-derivative bronchodilators; decrease theophylline dosage by 30–50% or prolong dosing interval.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 3
            }
          ]
        },
        "ALTERNATIVE DRUG(S)": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "ALTERNATIVE DRUG(S)",
          "content_blocks": []
        }
      }
    },
    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Radiographs—evaluate every 2–7 days initially to determine appropriateness of",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "treatment; then every 1–2 weeks.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "If signs do not resolve or suddenly worsen—possible recurrence of aspiration or a secondary infection; repeat diagnostic evaluation, including tracheal wash or bronchoscopy.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 3
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Predisposed patients undergoing anesthesia—cisapride (slow infusion, 1 mL/kg over 30 minutes) 1–2 hours pre-induction",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "may decrease esophageal reflux.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Suction",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "esophagus prior to extubation.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Antacids could decrease acid-related lung injury in predisposed patients; may also increase risk of infection.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 3
            }
          ]
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
