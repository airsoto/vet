        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Dogs; less commonly cats.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Peracute, acute, or chronic.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cough, tachypnea, nasal discharge, or exercise",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "intolerance.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory distress or cyanosis",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "when severe.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Depending on underlying cause—regurgitation; vomiting; dysphagia; altered consciousness; stertor or stridor.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Pharyngeal abnormalities—local paralysis; generalized neuromuscular disease; cricopharyngeal motor dysfunction; anatomic",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "malformations.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Esophageal abnormalities— megaesophagus; reflux esophagitis; esophageal dysmotility; esophageal obstruction; broncho",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "esophageal fistula.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Laryngeal paralysis, webbing, or obstruction; post-laryngeal",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "surgery.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Altered consciousness—sedation, anesthesia; post-ictus; forebrain disease;",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "metabolic disturbance.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Iatrogenic—force feeding; tube feeding, mineral oil administration.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Bacterial pneumonia.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lung abscess.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 1
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Neutrophilic leukocytosis, left shift, although white blood cells may be normal.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 1
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Arterial blood gas analysis—hypoxemia;",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Paco2generally low.•Consider tests for",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "predisposing problems—acetylcholine",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 1,
              "subheading": "Paco2generally low.•Consider tests for"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "receptor antibodies, resting cortisol or",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 1,
              "subheading": "Paco2generally low.•Consider tests for"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "adrenocorticotropic hormone stimulation,",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 1,
              "subheading": "Paco2generally low.•Consider tests for"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "creatine kinase.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 1,
              "subheading": "Paco2generally low.•Consider tests for"
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiography—bronchoalveolar pattern usually most severe in the gravitydependent lobes (right cranial and middle, left cranial); can take up to 24 hours for pattern to develop after aspiration; scrutinize for evidence of esophageal or mediastinal",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "disease.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Videofluoroscopic swallowing study—provides evidence of swallowing or esophageal dysfunction that can predispose to aspiration. Caution: could result in aspiration of contrast medium.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Tracheal wash—for bacterial culture and sensitivity testing before administering antibiotics; infection often caused by multiple organisms with unpredictable susceptibility.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bronchoscopy—rarely indicated.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Laryngeal function examination—always perform if patient anesthetized for other purposes; otherwise, after resolution of pneumonia if supportive clinical signs.",
              "pdf_page": 1167,
              "printed_page": 1085,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DIAGNOSTIC TESTS",
          "content_blocks": []
        },
        "PATHOLOGIC FINDINGS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": []
        }
      }
    },
    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Oxygen and cage rest—respiratory distress.",
          "pdf_page": 1167,
          "printed_page": 1085,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Ventilatory support—if not oxygen",
          "pdf_page": 1167,
          "printed_page": 1085,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "responsive.",
          "pdf_page": 1167,
          "printed_page": 1085,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "IV fluids—avoid overhydration, which can exacerbate secondary edema.",
          "pdf_page": 1167,
          "printed_page": 1085,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Oral intake—withhold until primary",
          "pdf_page": 1167,
          "printed_page": 1085,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "problem identified and managed.",
          "pdf_page": 1167,
          "printed_page": 1085,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Do not allow patient to remain laterally recumbent",
          "pdf_page": 1167,
          "printed_page": 1085,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "on one side for more than 2 hours.",
          "pdf_page": 1167,
          "printed_page": 1085,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Mild exercise and saline nebulization with coupage",
          "pdf_page": 1167,
          "printed_page": 1085,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "can facilitate airway clearance.",
          "pdf_page": 1167,
          "printed_page": 1085,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Airway suction—only if performed immediately following aspiration (such as during recovery",
          "pdf_page": 1167,
          "printed_page": 1085,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "from anesthesia). lavage—contraindicated.",
          "pdf_page": 1167,
          "printed_page": 1085,
          "column": 2
        }
      ],
