          "source_heading": null,
          "canonical_heading": "GENETICS",
          "content_blocks": []
        },
        "INCIDENCE/PREVALENCE": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "INCIDENCE/PREVALENCE",
          "content_blocks": []
        },
        "GEOGRAPHIC DISTRIBUTION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GEOGRAPHIC DISTRIBUTION",
          "content_blocks": []
        },
        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Colony cats—predisposed, probably because of access to other cats’ vomitus.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Stray cats living in urban areas heavily populated with cats—high incidence of infection.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Captive cheetahs, lions, tigers, cougars— susceptible.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Chronic vomiting, anorexia, weight loss.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Death from chronic gastritis.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ollulanus tricuspis—adults (only up to 1 mm in length) coil into gastric mucosa, causing superficial erosions.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Over time, gastric erosions can become severe with marked inflammation, accumulation of lymphoid aggregates, and fibrous changes in mucosa and submucosa.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Eggs—hatch within female worms; larvae develop to infective L3 larvae within stomach.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "L3 larvae and adults—vomited and infective to other cats; internal autoinfection also occurs.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No fecal transmission known.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Distributed throughout North America, Australia, New Zealand, Europe, Argentina, Chile.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Other causes of vomiting including:",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dietary.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Intoxications.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metabolic—diabetes mellitus, renal disease, liver disease, acidosis, heat stroke, hypo adrenocorticism, hyperthyroidism.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gastric abnormalities—inflammatory bowel disease, neoplasia, obstruction, atrophic gastritis, ulcers, dilatation/volvulus, parasitic such asPhysaloptera.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gastroesophageal junction disorders— hiatal hernia.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Small intestinal disorders—inflammatory bowel disease, neoplasia, fungal, viral, obstruction, paralytic ileus.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Large intestinal disorders—colitis, obstipation, inflammatory bowel disease.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal disorders—pancreatitis, gastrinoma, peritonitis, steatitis, pyometra, diaphragmatic hernia, other neoplasia.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neurologic disorders—psychogenic, motion sickness, vestibular lesions, head trauma, neoplasia.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Miscellaneous—heartworm disease and heart disease.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Reflects vomiting—dehydration, hypovolemia.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 2
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CBC/CHEMISTRY/URINALYSIS",
          "content_blocks": []
        },
        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Baermann—examine vomitus for L3 larvae.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fecal examination, direct or flotation— larvae or eggs seldom found in feces as they are digested within the gastrointestinal tract.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 2
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Abdominal ultrasound—may show gastric thickening; rarely see parasites.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "View worms through an endoscope— difficult due to size of worms.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gastric lavage—using saline collection followed by centrifugation to precipitate L3 larvae, or use Baermann technique.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Histopathology—gastric biopsy occasionally shows parasites.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 2
            }
          ]
        },
        "DIAGNOSTIC TESTS": {
          "present": false,
          "status": "missing",
