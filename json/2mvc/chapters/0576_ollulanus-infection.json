  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ollulanusadult worms are found in stomach of cats.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Infection causes chronic gastritis resulting in anorexia, vomiting, weight loss.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No intermediate hosts required to complete lifecycle; transmission is mainly by contact with vomitus of infected cats.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Eggs develop into larvae within female worm; released larvae may mature to adults without leaving stomach.",
              "pdf_page": 1075,
              "printed_page": 993,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "DEFINITION",
          "content_blocks": []
        },
