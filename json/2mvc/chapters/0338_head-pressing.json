            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Head pressing—just one sign of prosencephalon disease.",
              "pdf_page": 663,
              "printed_page": 581,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Compulsive pacing and circling toward the side of the lesion; circling can be toward either side if lesion is centrally located.",
              "pdf_page": 663,
              "printed_page": 581,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Change in learned behavior, including loss of sleep cycles.",
              "pdf_page": 663,
              "printed_page": 581,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Seizures.",
              "pdf_page": 663,
              "printed_page": 581,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Contralateral postural reaction deficits.",
              "pdf_page": 663,
              "printed_page": 581,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Contralateral visual deficits with normal pupillary light reflexes.",
              "pdf_page": 663,
              "printed_page": 581,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Contralateral facial hypalgesia.",
              "pdf_page": 663,
              "printed_page": 581,
              "column": 1
            }
          ]
        },
