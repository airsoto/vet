    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "GENERAL": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "GENERAL",
          "content_blocks": []
        },
        "APPROPRIATE HEALTH CARE": {
          "present": true,
          "status": "content",
          "source_heading": "APPROPRIATE HEALTH CARE",
          "canonical_heading": "APPROPRIATE HEALTH CARE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Severe clinical signs—hospitalization for diagnostic workup and treatment.",
              "pdf_page": 663,
              "printed_page": 581,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Suspected rabies—quarantine outdoor animal with no vaccination or unknown vaccination history when rapidly progressive neurologic signs are present and animal lives in a rabies-endemic area; minimize the number of people in contact with the animal, and maintain a contact log; if neurologic signs deteriorate rapidly, euthanize the animal and send it to a public health laboratory to be tested for rabies.",
              "pdf_page": 663,
              "printed_page": 581,
              "column": 3
            }
          ]
        },
        "NURSING CARE": {
          "present": true,
          "status": "content",
          "source_heading": "NURSING CARE",
          "canonical_heading": "NURSING CARE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "When hospitalized, patients should be monitored closely for deterioration in mental status and for seizures.",
              "pdf_page": 664,
              "printed_page": 582,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Maintenance IV fluids may be necessary for patients with severe prosencephalic syndrome.",
              "pdf_page": 664,
              "printed_page": 582,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The cage may need to be padded to avoid self-trauma if constantly head pressing and pacing.",
              "pdf_page": 664,
              "printed_page": 582,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Eyes should be monitored regularly for development of corneal ulcers due to self-induced trauma.",
              "pdf_page": 664,
              "printed_page": 582,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Central IV catheters should be placed in the saphenous vein rather than the jugular vein if possible, to avoid increasing intracranial pressure by occlusion of the jugular veins.",
              "pdf_page": 664,
              "printed_page": 582,
              "column": 1
            }
          ]
        },
        "ACTIVITY": {
          "present": true,
          "status": "not_applicable",
          "source_heading": "ACTIVITY",
          "canonical_heading": "ACTIVITY",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "N/A",
              "pdf_page": 664,
              "printed_page": 582,
              "column": 1
            }
          ]
        },
        "DIET": {
          "present": true,
          "status": "content",
          "source_heading": "DIET",
          "canonical_heading": "DIET",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Suspected hepatic encephalopathy—appropriate low-protein diet.",
              "pdf_page": 664,
              "printed_page": 582,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hand-feeding may be necessary in severely encephalopathic patients; risk of aspiration if the patient fails to prehend and swallow correctly.",
              "pdf_page": 664,
              "printed_page": 582,
              "column": 1
            }
          ]
        },
        "CLIENT EDUCATION": {
          "present": true,
          "status": "content",
          "source_heading": "CLIENT EDUCATION",
          "canonical_heading": "CLIENT EDUCATION",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Specific to the underlying condition.",
              "pdf_page": 664,
              "printed_page": 582,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Clients should be warned about the possibility of seizures, be provided with a description of a seizure, and given instructions on what to do if a seizure occurs.",
              "pdf_page": 664,
              "printed_page": 582,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Clients should be provided with a description of signs of acute decompensation due to brain herniation.",
              "pdf_page": 664,
              "printed_page": 582,
              "column": 1
            }
          ]
        },
        "SURGICAL CONSIDERATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "SURGICAL CONSIDERATIONS",
          "canonical_heading": "SURGICAL CONSIDERATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "If signs are due to intracranial disease, elevated intracranial pressure is likely and therefore there is a risk of herniation during anesthesia, with induction and recovery from anesthesia posing the highest risk; patients should be ventilated carefully to ensure that their partial pressure of carbon dioxide (pCO2) remains within normal limits (35–45 mmHg).",
              "pdf_page": 664,
              "printed_page": 582,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hydrocephalus can be treated by placement of a ventriculo-peritoneal shunt.",
              "pdf_page": 664,
              "printed_page": 582,
              "column": 1
            }
          ]
        },
