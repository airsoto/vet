          "source_heading": "DEFINITION",
          "canonical_heading": "DEFINITION",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Compulsive pressing of the head against a wall or other object for no apparent reason.",
              "pdf_page": 663,
              "printed_page": 581,
              "column": 1
            }
          ]
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Alterations in behavior—caused by lesions in the prosencephalon (i.e., cerebrum, limbic system, thalamus, and hypothalamus), particularly those affecting the limbic system and frontal and temporal cortices.",
              "pdf_page": 663,
              "printed_page": 581,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lesions may result in compulsive pacing; when an obstacle (e.g., a wall) is reached, the animal may press its head against it for long periods of time, apparently unable to turn and move away.",
              "pdf_page": 663,
              "printed_page": 581,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Apparent inability to voluntarily move away—may reflect impaired integration of sensory information, leading to inappropriate behavior.",
              "pdf_page": 663,
              "printed_page": 581,
              "column": 1
            }
          ]
        },
        "SYSTEMS AFFECTED": {
          "present": true,
          "status": "content",
          "source_heading": "SYSTEMS AFFECTED",
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": [
