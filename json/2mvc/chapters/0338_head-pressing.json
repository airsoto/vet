      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "A newly blind animal might bump into objects, but rapidly recognizes its environment and acts visual; an animal with a prosencephalic lesion continues bumping into objects despite normal ocular exam.",
              "pdf_page": 663,
              "printed_page": 581,
              "column": 2
            }
          ]
        },
        "CBC/BIOCHEMISTRY/URINALYSIS": {
          "present": true,
          "status": "content",
          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "May reflect a metabolic or toxic cause.",
              "pdf_page": 663,
              "printed_page": 581,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hepatic encephalopathy—decreased serum albumin, blood urea nitrogen, cholesterol, and glucose concentrations, with or without elevated alanine phosphatase (ALP), alanine aminotransferase (ALT), and bilirubin concentrations; microcytic anemia may be present; ammonium biurate crystals may be present in the urine.",
              "pdf_page": 663,
              "printed_page": 581,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lead toxicity—basophilic stippling of erythrocytes; presence of reticulocytes and nucleated red blood cells (RBCs) in the absence of anemia.",
              "pdf_page": 663,
              "printed_page": 581,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Encephalitis—findings often unremarkable, but may reflect an inflammatory process (e.g., with fungal infection).",
              "pdf_page": 663,
              "printed_page": 581,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "CNS lymphoma—may see evidence of bone marrow involvement.",
              "pdf_page": 663,
              "printed_page": 581,
              "column": 2
            }
          ]
        },
