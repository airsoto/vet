        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic radiography—recommended for older patients to identify metastatic disease.",
              "pdf_page": 663,
              "printed_page": 581,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal ultrasonography— recommended for older patients if intra-abdominal neoplasia is suspected; indicated if a porto systemic shunt or other hepatic disease is suspected.",
              "pdf_page": 663,
              "printed_page": 581,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rectal scintigraphy—may be used to definitively diagnose a portosystemic shunt.",
              "pdf_page": 663,
              "printed_page": 581,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Brain CT or MRI—to identify intracranial masses, malformations, skull fractures, inflammation, and hemorrhage.",
              "pdf_page": 663,
              "printed_page": 581,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ultrasonography of the brain via persistent fontanels—may be used to diagnose hydro cephalus in young dogs.",
              "pdf_page": 663,
              "printed_page": 581,
              "column": 3
            }
          ]
        },
