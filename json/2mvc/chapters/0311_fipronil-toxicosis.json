      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Phenylpyrazole compound with selective toxicity against insects.",
              "pdf_page": 617,
              "printed_page": 535,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Discovered in 1987, registered as a pesticide in the United States in 1996; used worldwide today.",
              "pdf_page": 617,
              "printed_page": 535,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Blocks chloride passage through γ-aminobutyric acid (GABA) and glutamate gated chloride channels.",
              "pdf_page": 617,
              "printed_page": 535,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Except for rabbits, low mammalian toxicity—GABA receptors less sensitive and lack mammals lack glutamate gated chloride channels.",
              "pdf_page": 617,
              "printed_page": 535,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Uses:",
              "pdf_page": 617,
              "printed_page": 535,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Topical flea and tick spot-on products",
              "pdf_page": 617,
              "printed_page": 535,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(“plus” versions include S-methoprene).",
              "pdf_page": 617,
              "printed_page": 535,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Roach and ant-bait stations. Flea and tick",
              "pdf_page": 617,
              "printed_page": 535,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "sprays for pets.",
              "pdf_page": 617,
              "printed_page": 535,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Granular turf products.",
              "pdf_page": 617,
              "printed_page": 535,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Soil treatment.",
              "pdf_page": 617,
              "printed_page": 535,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Crop pest control.",
