    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Baseline CBC, chemistry profile, and urinalysis should be performed to rule out preexisting organ dysfunction, which could increase the risk for toxicosis.",
          "pdf_page": 617,
          "printed_page": 535,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "For dermal reaction, bathe with liquid dishwashing detergent and rinse thoroughly.",
          "pdf_page": 617,
          "printed_page": 535,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Antihistamine or steroids for dermal hypersensitivity reaction.",
          "pdf_page": 617,
          "printed_page": 535,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "With ingestion of a large dose, one dose of activated charcoal with sorbitol may be beneficial.",
          "pdf_page": 617,
          "printed_page": 535,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Methocarbamol for tremors.",
          "pdf_page": 617,
          "printed_page": 535,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Anticonvulsants for seizures.",
          "pdf_page": 617,
          "printed_page": 535,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "IV fluids (balanced crystalloid) at twice maintenance if CNS signs occur.",
          "pdf_page": 617,
          "printed_page": 535,
          "column": 2
        }
      ],
