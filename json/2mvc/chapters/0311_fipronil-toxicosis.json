    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Activated charcoal 1–2 g/kg PO and an osmotic cathartic (sorbitol) × 1 dose for large ingestions.",
          "pdf_page": 617,
          "printed_page": 535,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Methocarbamol for tremors—55–220 mg/kg IV; titrate as needed; max daily dose 330 mg/kg/day (cats and dogs).",
          "pdf_page": 617,
          "printed_page": 535,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Anticonvulsants for seizures—diazepam 0.5–1 mg/kg IV (dogs and cats); phenobarbital 2–6 mg/kg IV (dogs and cats).",
          "pdf_page": 617,
          "printed_page": 535,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Diphenhydramine 2–4 mg/kg q8–12h PO; 0.5–2 mg/kg q8–12h IM/SC/IV.",
          "pdf_page": 617,
          "printed_page": 535,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Dexamethasone 0.5–1 mg/kg IV/IM (dogs); 0.125–0.5 mg/kg IV/IM (cats).",
          "pdf_page": 617,
          "printed_page": 535,
          "column": 2
        }
      ],
