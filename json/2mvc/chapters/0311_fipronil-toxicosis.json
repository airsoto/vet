              "level": 0,
              "text": "from bags containing product.",
              "pdf_page": 617,
              "printed_page": 535,
              "column": 1,
              "subheading": "Dogs"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Cats",
              "pdf_page": 617,
              "printed_page": 535,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Accidental ingestion of topical spot-on",
              "pdf_page": 617,
              "printed_page": 535,
              "column": 1,
              "subheading": "Cats"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "product from grooming.",
