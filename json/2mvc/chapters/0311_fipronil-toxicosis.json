        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dermal—skin irritation, alopecia, or dermal hypersensitivity reaction.",
              "pdf_page": 617,
              "printed_page": 535,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Oral—hypersalivation, nausea, vomiting, diarrhea.",
              "pdf_page": 617,
              "printed_page": 535,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ingestion of large doses—CNS: hyperexcitability, tremors, convulsions, seizures, death.",
              "pdf_page": 617,
              "printed_page": 535,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Rabbits",
              "pdf_page": 617,
              "printed_page": 535,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "Dermal and oral exposure (any amount) can",
              "pdf_page": 617,
              "printed_page": 535,
              "column": 1,
              "subheading": "Rabbits"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "cause anorexia, hypersalivation, ataxia,",
              "pdf_page": 617,
              "printed_page": 535,
              "column": 1,
              "subheading": "Rabbits"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "tremors, seizures and death.",
              "pdf_page": 617,
              "printed_page": 535,
              "column": 1,
              "subheading": "Rabbits"
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ingestion by dogs, especially young dogs, occurs more frequently due to behavioral factors.",
              "pdf_page": 617,
              "printed_page": 535,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "With chronic studies in dogs, severe neurotoxic signs were observed at a dose of 20 mg/kg.",
              "pdf_page": 617,
              "printed_page": 535,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Wide availability and frequent access to products.",
              "pdf_page": 617,
              "printed_page": 535,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Biggest concern is exposure to concentrated products frequently found on farms and ranches or used by pesticide control applicators.",
              "pdf_page": 617,
              "printed_page": 535,
              "column": 1
            }
          ]
        }
      }
    },
