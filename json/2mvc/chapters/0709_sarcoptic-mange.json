        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Pinnal–pedal reflex—rubbing the ear margin between the thumb and forefinger induces the dog to scratch with its hind leg.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Superficial skin scrapings—positive in 20–50% of scabies cases; false-negative results are common.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fecal flotation—may reveal mites or ova.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Response to scabicidal treatment—most common method for diagnosing scabies.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 2
            }
          ]
        },
