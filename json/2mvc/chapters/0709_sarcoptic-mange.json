        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Burrowing mites induce hypersensitivity, causing intense pruritus.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 1
            }
          ]
        },
        "SYSTEMS AFFECTED": {
          "present": true,
          "status": "content",
          "source_heading": "SYSTEMS AFFECTED",
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Skin/exocrine",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 1
            }
          ]
        },
