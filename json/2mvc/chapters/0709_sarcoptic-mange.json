    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "All in-contact dogs must be treated.",
          "pdf_page": 1303,
          "printed_page": 1221,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Resolution of pruritis may take several weeks due to hypersensitivity reaction to the mite.",
          "pdf_page": 1303,
          "printed_page": 1221,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Sarcoptesmites usually die quickly in the environment; however, mites have been reported to survive for up to 3 weeks. Thorough cleaning of the dog’s environment is recommended in crowded conditions.",
          "pdf_page": 1303,
          "printed_page": 1221,
          "column": 2
        }
      ],
