          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "A nonseasonal, intensely pruritic, highly contagious parasitic skin disease of dogs and",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "other mammalian species caused bySarcoptes",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "scabieivar.canismites.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 1,
              "subheading": "other mammalian species caused bySarcoptes"
            }
          ]
        },
        "DEFINITION": {
          "present": false,
          "status": "missing",
          "source_heading": null,
