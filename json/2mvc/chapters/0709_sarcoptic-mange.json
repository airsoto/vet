          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Close contact with other dogs in animal shelters, boarding kennels, groomers, dog parks, and veterinary offices.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Exposure to fox or coyote.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 1
            }
          ]
        }
      }
    },
