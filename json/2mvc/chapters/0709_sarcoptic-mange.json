        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "All in-contact dogs usually affected.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Transient pruritus of in-contact other species: cats, humans.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Nonseasonal, progressively worsening intense pruritus.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pruritus develops within 4–6 weeks of exposure.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Seroconversion 3 weeks after clinical signs develop.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Rare individuals do not seroconvert and therefore may not develop severe pruritus.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Elbows, pinnal margins, ventrum, and hocks affected first.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Crusted papules leading to generalized alopecia, crusting, and excoriations; lichenification and thickening with chronicity.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Poor response to antihistamines and anti-inflammatory doses of steroids.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mite numbers often low.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Immunocompromised individuals may harbor larger numbers of mites.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
