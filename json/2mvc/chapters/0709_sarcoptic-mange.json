    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Selamectin—labeled application every 30 days, or application every 2 weeks for at least three treatments.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Isoxazoline parasiticides (afoxalaner, lotilaner, fluralaner or sarolaner)-at labeled dosage/frequency.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ivermectin 0.2–0.4 mg/kg SC or PO every 1–2 weeks.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Milbemycin 2 mg/kg PO every 1–2 weeks.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Doramectin 0.2–0.6 mg/kg SC or PO weekly.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Moxidectin 0.2–0.3 mg/kg SC or PO weekly; with imidacloprid topical at labeled",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lime sulfur 2–4% applied weekly for 4–6 weeks.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fipronil spray applied to entire skin surface every 2 weeks for three treatments.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Topical antiseborrheic therapy in conjunction with scabicidal therapy.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Systemic antibiotics—may be needed to resolve secondary pyoderma.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prednisolone 1 mg/kg for 5–7 days or longer if necessary to relieve pruritus and self-mutilation.",
              "pdf_page": 1303,
              "printed_page": 1221,
              "column": 2
            }
          ]
        },
