        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute inflammation—gross or microscopic abscesses.",
              "pdf_page": 1381,
              "printed_page": 1299,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Septicemia—omphalophlebitis, peritonitis, hepatitis, pneumonia, myocarditis.",
