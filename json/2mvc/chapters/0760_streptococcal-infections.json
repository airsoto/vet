        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs and cats.",
              "pdf_page": 1381,
              "printed_page": 1299,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Very young—more prone to infection because of incomplete immunity; particularly kittens born to primiparous queen.",
              "pdf_page": 1381,
              "printed_page": 1299,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Vary with site of infection and host immunocompetence. Sites of infection can include abscesses, genitourinary tract, ears, septicemia (e.g., toxic shock syndrome), joints, lungs, heart valves, lymph nodes, CNS, wounds (e.g., necrotizing fasciitis), tonsil/pharynx, or skin, and may result in abortion, fading puppies/kittens, or bitch/queen sterility.",
              "pdf_page": 1381,
              "printed_page": 1299,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Weakness.",
              "pdf_page": 1381,
              "printed_page": 1299,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Coughing.",
              "pdf_page": 1381,
              "printed_page": 1299,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dyspnea.",
              "pdf_page": 1381,
              "printed_page": 1299,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fever.",
              "pdf_page": 1381,
              "printed_page": 1299,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hematemesis.",
              "pdf_page": 1381,
              "printed_page": 1299,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hematuria.",
              "pdf_page": 1381,
              "printed_page": 1299,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lymphadenopathy.",
              "pdf_page": 1381,
              "printed_page": 1299,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pain.",
              "pdf_page": 1381,
              "printed_page": 1299,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Age, exposure, and immune response determine disease severity.",
              "pdf_page": 1381,
              "printed_page": 1299,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Virulence—depends on specific organism.",
              "pdf_page": 1381,
              "printed_page": 1299,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Opportunistic—surgical or traumatic wounds, viral infections, atopic dermatitis, immunosuppressive conditions.",
              "pdf_page": 1381,
              "printed_page": 1299,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Coinfection with canine influenza virus increases disease severity. Other predisposing conditions—feline leukemia virus, feline infectious peritonitis, immunodeficiency, respiratory viral infections, feline lower urinary tract disease.",
              "pdf_page": 1381,
              "printed_page": 1299,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Maternal antibodies generally protect neonates.",
              "pdf_page": 1381,
              "printed_page": 1299,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Carrier state occurs.",
              "pdf_page": 1381,
              "printed_page": 1299,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bacterial superantigens may contribute to toxic shock syndrome and necrotizing fasciitis; enrofloxacin-induced bacteriophages may enhance superantigen expression.",
              "pdf_page": 1381,
              "printed_page": 1299,
              "column": 2
            }
          ]
        }
      }
    },
