              "printed_page": 1299,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cocci—in circulating neutrophils if overwhelming sepsis.",
              "pdf_page": 1381,
              "printed_page": 1299,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Biochemistry—suggests predisposing conditions.",
              "pdf_page": 1381,
              "printed_page": 1299,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urinalysis—pyuria (with or without bacteruria).",
              "pdf_page": 1381,
              "printed_page": 1299,
              "column": 2
            }
          ]
        },
