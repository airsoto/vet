        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—purebred cats have higher incidence.",
              "pdf_page": 428,
              "printed_page": 346,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs—toy and miniature breeds at 2.7 times greater risk than large breeds of being affected; high rates in miniature schnauzers with persistent Müllerian duct syndrome (PMDS).",
              "pdf_page": 428,
              "printed_page": 346,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Incidence—rates up to 24.1% in some purebred dogs (compared to 2.1% in overall population) with 50% incidence in dogs with PMDS; in cats observed rates range from 1.3 to 6.2%.",
              "pdf_page": 428,
              "printed_page": 346,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Unilateral more common than bilateral; right testis retained twice as often in dogs, but with equal frequency in cats.",
              "pdf_page": 428,
              "printed_page": 346,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Genetics—estimated medium level of heritability with multifactorial genetic basis; females act as genetic carriers for the trait.",
              "pdf_page": 428,
              "printed_page": 346,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Absence of one, or both, testicles from the scrotum in a patient without history of castration.",
              "pdf_page": 428,
              "printed_page": 346,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cats—strong urine odor, tom cat marking behavior, presence of penile spines.",
              "pdf_page": 428,
              "printed_page": 346,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal pain, lameness, vomiting— increased risk exists for spermatic cord torsion of neoplastic, retained testes.",
              "pdf_page": 428,
              "printed_page": 346,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Feminizing paraneoplastic syndrome— estrogen-secreting Sertoli cell tumors produce feminizing signs including gynecomastia, symmetric alopecia of trunk and flanks, hyperpigmentation of inguinal skin, pendulous preputial sheath, prostatic squamous metaplasia.",
              "pdf_page": 428,
              "printed_page": 346,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Affected males or carriers (i.e., females or nonaffected males of cryptorchid littermates) present in breeding lines.",
              "pdf_page": 428,
              "printed_page": 346,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Carriers produce increased number of males per litter and increased litter size; efforts to eliminate cryptorchidism difficult in these circumstances.",
              "pdf_page": 428,
              "printed_page": 346,
              "column": 1
            }
          ]
        }
      }
    },
