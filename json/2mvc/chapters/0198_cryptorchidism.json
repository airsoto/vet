  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Incomplete scrotal descent of one or both testes; most common testicular congenital anomaly.",
              "pdf_page": 428,
              "printed_page": 346,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominal or inguinal location for undescended testis or testes.",
              "pdf_page": 428,
              "printed_page": 346,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Diagnosis usually made at 2 months of age (i.e., descent to scrotal position should occur before this time), with some exceptions of full descent occurring between 2 and 6 months of age.",
              "pdf_page": 428,
              "printed_page": 346,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abdominally retained testicles typically lack spermatozoa and have only Sertoli cells in the seminiferous tubules; estradiol (E2) and testosterone (T) can be present in normal systemic concentrations in affected animals.",
              "pdf_page": 428,
              "printed_page": 346,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Unilaterally cryptorchid animals are typically fertile.",
              "pdf_page": 428,
              "printed_page": 346,
              "column": 1
            }
          ]
        },
        "DEFINITION": {
          "present": false,
