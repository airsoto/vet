          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Cat and dog.",
              "pdf_page": 1366,
              "printed_page": 1284,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tumors of the pinna—common in cats with light pigmentation, average 12 years.",
              "pdf_page": 1366,
              "printed_page": 1284,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Ear canal tumors—seen in older dogs and cats.",
              "pdf_page": 1366,
              "printed_page": 1284,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cocker spaniels overrepresented for benign and malignant ear canal tumors in one study.",
              "pdf_page": 1366,
              "printed_page": 1284,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
