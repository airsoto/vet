          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Tumors of the pinna:",
              "pdf_page": 1366,
              "printed_page": 1284,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Slowly developing lesions of the edge of",
              "pdf_page": 1366,
              "printed_page": 1284,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "the pinna.",
              "pdf_page": 1366,
              "printed_page": 1284,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Precancerous stage—crusty eczematous",
              "pdf_page": 1366,
              "printed_page": 1284,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "lesions (actinic dermatitis).",
              "pdf_page": 1366,
              "printed_page": 1284,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Cancerous phase—proliferation and/or",
              "pdf_page": 1366,
              "printed_page": 1284,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "ulceration progresses.",
              "pdf_page": 1366,
              "printed_page": 1284,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Multiple cutaneous lesions (about 10–15%",
              "pdf_page": 1366,
              "printed_page": 1284,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "of cats) occur in haired skin (multicentric squamous cell carcinomain situ).",
              "pdf_page": 1366,
              "printed_page": 1284,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tumors of the ear canal:",
              "pdf_page": 1366,
              "printed_page": 1284,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Often unilateral, arise from the external",
              "pdf_page": 1366,
              "printed_page": 1284,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "ear canal.",
              "pdf_page": 1366,
              "printed_page": 1284,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Mass lesion (raised, ulcerated, broad-",
              "pdf_page": 1366,
              "printed_page": 1284,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "based).",
              "pdf_page": 1366,
              "printed_page": 1284,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Malodorous aural discharge.",
              "pdf_page": 1366,
              "printed_page": 1284,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Pruritis.",
              "pdf_page": 1366,
              "printed_page": 1284,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Pain.",
              "pdf_page": 1366,
              "printed_page": 1284,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Vestibular signs/Horner’s syndrome",
