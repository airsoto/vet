              "printed_page": 1284,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Pinna—most common location in cats; tumors of the pinna in dogs are rarely squamous cell carcinoma.",
              "pdf_page": 1366,
              "printed_page": 1284,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Organ system—skin/endocrine.",
              "pdf_page": 1366,
              "printed_page": 1284,
              "column": 1
            }
          ]
