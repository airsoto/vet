          "source_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "canonical_heading": "CBC/BIOCHEMISTRY/URINALYSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "CBC—anemia, leukopenia, leukocytosis, or thrombocytopenia; anemia may be moderate and nonregenerative or severe and regenerative (hemolytic).",
              "pdf_page": 927,
              "printed_page": 845,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Biochemistry—results vary widely, depending on the organ(s) affected.",
              "pdf_page": 927,
              "printed_page": 845,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Urinalysis—repeatable elevated protein:creatinine ratio (>1) with benign sediment and negative culture.",
              "pdf_page": 927,
              "printed_page": 845,
              "column": 3
            }
          ]
        },
        "CBC/CHEMISTRY/URINALYSIS": {
