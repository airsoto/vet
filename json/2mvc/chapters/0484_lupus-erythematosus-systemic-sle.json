    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Corticosteroids—to control the abnormal immune response and reduce inflammation (e.g., prednisone 1–2.2 mg/kg/day PO). Consider alternative steroids (equivalent doses) in cats; e.g., prednisolone, dexamethasone, triamcinolone, methylprednisolone.",
              "pdf_page": 928,
              "printed_page": 846,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cytotoxic immunosuppressive drugs—add when prednisone fails to improve the condition after 7–10 days or if the patient is steroid intolerant.",
              "pdf_page": 928,
              "printed_page": 846,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Azathioprine (dogs only) 2 mg/kg PO q24h until remission, then q48h.",
              "pdf_page": 928,
              "printed_page": 846,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Chlorambucil (cats and dogs) 0.1–0.2 mg/kg PO q24h initially, then q48h.",
              "pdf_page": 928,
              "printed_page": 846,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Cyclosporine – microemulsion (e.g., Atopica); dogs: 5–10 mg/kg/day PO, divided twice daily; cats: 0.5–3 mg/kg PO q12h.",
              "pdf_page": 928,
              "printed_page": 846,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mycophenolate mofetil (dogs) 10 mg/kg",
              "pdf_page": 928,
              "printed_page": 846,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "PO q12h until remission, then taper.",
              "pdf_page": 928,
              "printed_page": 846,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bronchopneumonia, urinary tract infection,",
              "pdf_page": 928,
              "printed_page": 846,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gradually taper doses (no more often than or sepsis secondary to immunosuppression. every 3–4 weeks) once remission is achieved.",
              "pdf_page": 928,
              "printed_page": 846,
              "column": 2
            }
          ]
        },
