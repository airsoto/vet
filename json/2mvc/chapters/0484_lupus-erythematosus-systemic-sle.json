        "PATHOLOGIC FINDINGS": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOLOGIC FINDINGS",
          "canonical_heading": "PATHOLOGIC FINDINGS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Nonerosive polyarthritis with infiltrations of synovial membrane by neutrophils and lymphocytes; no pannus formation.",
              "pdf_page": 927,
              "printed_page": 845,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Membranous or membranoproliferative glomerulonephritis.",
              "pdf_page": 927,
              "printed_page": 845,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mononuclear interface dermatitis with hydropic degeneration of keratinocytes and eosinophilic round bodies representing apoptotic basal keratinocytes.",
              "pdf_page": 927,
              "printed_page": 845,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vasculitis and panniculitis in some patients.",
              "pdf_page": 927,
              "printed_page": 845,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Deposition of immune complexes along the basement membrane of the dermal–epidermal junction (detected by immunofluorescence).",
              "pdf_page": 927,
              "printed_page": 845,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Vasculitis may be seen in any organ.",
              "pdf_page": 927,
              "printed_page": 845,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reactive lymphoid hyperplasia in the lymph nodes and spleen.",
              "pdf_page": 928,
              "printed_page": 846,
              "column": 1
            }
          ]
        }
      }
