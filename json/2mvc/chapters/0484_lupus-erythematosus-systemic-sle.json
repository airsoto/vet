        "OTHER LABORATORY TESTS": {
          "present": true,
          "status": "content",
          "source_heading": "OTHER LABORATORY TESTS",
          "canonical_heading": "OTHER LABORATORY TESTS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "ANA test—detects antibodies directed against nuclear antigens. False positive and false negatives occur.",
              "pdf_page": 927,
              "printed_page": 845,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "LE test on synovial fluid—identifies phagocytized nuclear material within neutrophils and macrophages; timeconsuming.",
              "pdf_page": 927,
              "printed_page": 845,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Direct antiglobulin (Coombs’) test— identifies complement or antibody on the surface of RBCs; test should only be run in patients with anemia.",
              "pdf_page": 927,
              "printed_page": 845,
              "column": 3
            }
          ]
        },
        "IMAGING": {
          "present": true,
          "status": "content",
          "source_heading": "IMAGING",
          "canonical_heading": "IMAGING",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Radiographs of affected joints reveal softtissue swelling consistent with nonerosive arthritis.",
              "pdf_page": 927,
              "printed_page": 845,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Thoracic and abdominal radiographs may demonstrate hepatomegaly or splenomegaly.",
              "pdf_page": 927,
              "printed_page": 845,
              "column": 3
            }
          ]
        },
        "DIAGNOSTIC PROCEDURES": {
          "present": true,
          "status": "content",
          "source_heading": "DIAGNOSTIC PROCEDURES",
          "canonical_heading": "DIAGNOSTIC PROCEDURES",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Arthrocentesis—high cell count with nondegenerate neutrophils and monocytes and low viscosity are characteristic findings.",
              "pdf_page": 927,
              "printed_page": 845,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Bacterial culture of synovial fluid—negative.",
              "pdf_page": 927,
              "printed_page": 845,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Blood culture in animals with fever—negative.",
              "pdf_page": 927,
              "printed_page": 845,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Skin biopsy—in patients with skin lesions; save specimen in 10% buffered formalin (for histologic examination) and Michel’s solution (for immunofluorescence).",
              "pdf_page": 927,
              "printed_page": 845,
              "column": 3
            }
          ]
        },
