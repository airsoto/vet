        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Primarily dogs, but similar syndrome recently reported in 2 cats.",
              "pdf_page": 1322,
              "printed_page": 1240,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Small to medium-size breed (<15 kg), young adult dogs (<5 years), regardless of coat color.",
              "pdf_page": 1322,
              "printed_page": 1240,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dogs with white-hair coats (e.g., Maltese and West Highland white terriers) historically have been overrepresented.",
              "pdf_page": 1322,
              "printed_page": 1240,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Both sexes affected.",
              "pdf_page": 1322,
              "printed_page": 1240,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute-onset, fine, rapid whole-body tremors.",
              "pdf_page": 1322,
              "printed_page": 1240,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical signs initially can be confused with signs of apprehension or hypothermia.",
              "pdf_page": 1322,
              "printed_page": 1240,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Less commonly, signs can include abnormal nystagmus, hypermetria, head tilt, menace response deficits, and opsoclonus.",
              "pdf_page": 1322,
              "printed_page": 1240,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Most often associated with mild inflammatory CNS disease.",
              "pdf_page": 1322,
              "printed_page": 1240,
              "column": 1
            }
          ]
        }
      }
    },
    "DIAGNOSIS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DIFFERENTIAL DIAGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "DIFFERENTIAL DIAGNOSIS",
          "canonical_heading": "DIFFERENTIAL DIAGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Toxin ingestion—mycotoxins (penitrem A, roquefortine); metaldehyde (snail bait); pyrethrins/pyrethroids; organophosphates, many others.",
              "pdf_page": 1322,
              "printed_page": 1240,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Seizures.",
              "pdf_page": 1322,
              "printed_page": 1240,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypomyelination—seen in puppies; chow chow, springer spaniel, Samoyed, Weimaraner, and Dalmatian.",
              "pdf_page": 1322,
              "printed_page": 1240,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metabolic disorder—hypoglycemia, hypoadrenocorticism, hypocalcemia, magnesium imbalance.",
              "pdf_page": 1322,
              "printed_page": 1240,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Behavioral—fear.",
              "pdf_page": 1322,
              "printed_page": 1240,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Hypothermia.",
              "pdf_page": 1322,
              "printed_page": 1240,
              "column": 1
            }
          ]
        },
