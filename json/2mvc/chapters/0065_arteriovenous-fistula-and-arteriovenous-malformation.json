        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Abnormal, low-resistance connections between an artery and a vein (systemic or portal) that bypass a capillary bed.",
              "pdf_page": 194,
              "printed_page": 112,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Arteriovenous malformation (AVM)— typically congenital, involving a vascular nidus, or complex network of communicating vessels.",
              "pdf_page": 194,
              "printed_page": 112,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Arteriovenous fistula (AVF)—often acquired, direct, and singular connections.",
              "pdf_page": 194,
              "printed_page": 112,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Large lesions cause marked drop in systemic vascular resistance and compensatory increase in cardiac output; this may cause circulatory volume overload and congestive heart failure (CHF).",
              "pdf_page": 194,
              "printed_page": 112,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Variable location:",
              "pdf_page": 194,
              "printed_page": 112,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "AVM most often reported in liver of dogs",
              "pdf_page": 194,
              "printed_page": 112,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(termed arterioportal malformations/fistulas).",
              "pdf_page": 194,
              "printed_page": 112,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "AVF more often in limbs or at sites of",
              "pdf_page": 194,
              "printed_page": 112,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "previous surgery/trauma.",
              "pdf_page": 194,
              "printed_page": 112,
              "column": 1
            }
          ]
        },
