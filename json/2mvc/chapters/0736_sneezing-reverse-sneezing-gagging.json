        "DEFINITION": {
          "present": true,
          "status": "content",
          "source_heading": "DEFINITION",
          "canonical_heading": "DEFINITION",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Sneezing—a normal, protective, expiratory reflex that serves to expel air and material from the lungs through the nasal cavity and mouth.",
              "pdf_page": 1350,
              "printed_page": 1268,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reverse sneezing—a normal protective, repetitive inspiratory reflex that serves to remove irritants from the nasopharynx (also termed the aspiration reflex).",
              "pdf_page": 1350,
              "printed_page": 1268,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gagging—a normal protective reflex to clear secretions from the larynx, trachea, pharynx, or esophagus. Prevents irritating/toxic material from entering these structures; often misinterpreted as vomiting by owners.",
              "pdf_page": 1350,
              "printed_page": 1268,
              "column": 1
            }
          ]
        },
        "PATHOPHYSIOLOGY": {
          "present": true,
          "status": "content",
          "source_heading": "PATHOPHYSIOLOGY",
          "canonical_heading": "PATHOPHYSIOLOGY",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Irritation of submucosal irritant receptors; various stimuli (infectious, parasitic, irritant, mechanical—especially accumulated secretions) will elicit these reflexes depending on where the irritation is applied.",
              "pdf_page": 1350,
              "printed_page": 1268,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sneezing—nasal mucosal irritation; improves with chronicity.",
              "pdf_page": 1350,
              "printed_page": 1268,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Reverse sneezing—caudodorsal nasopharyngeal mucosal irritation triggers pharyngeal muscle spasms, subsequent laryngeal obstruction and movement of material into the oropharynx.",
              "pdf_page": 1350,
              "printed_page": 1268,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gagging—intraoral stimulation (tracheal, laryngeal, oropharyngeal, potentially esophageal mucosal irritation) detected by afferent limb of gag reflex. Efferent limb gives rise to uncoordinated muscle movement characteristic of gagging.",
              "pdf_page": 1350,
              "printed_page": 1268,
              "column": 1
            }
          ]
        },
        "SYSTEMS AFFECTED": {
          "present": true,
          "status": "content",
          "source_heading": "SYSTEMS AFFECTED",
          "canonical_heading": "SYSTEMS AFFECTED",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Respiratory—frequently associated with infectious or inflammatory conditions involving the upper respiratory tract.",
              "pdf_page": 1350,
              "printed_page": 1268,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Gastrointestinal—gagging may also be caused by swallowing, esophageal, or gastric disorders.",
              "pdf_page": 1350,
              "printed_page": 1268,
              "column": 1
            }
          ]
        },
