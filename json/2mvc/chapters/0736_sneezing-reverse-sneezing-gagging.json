    "MEDICATIONS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "DRUG(S) OF CHOICE": {
          "present": true,
          "status": "content",
          "source_heading": "DRUG(S) OF CHOICE",
          "canonical_heading": "DRUG(S) OF CHOICE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "There is no drug that specifically suppresses these reflexes; treatment is directed at the underlying irritant.",
              "pdf_page": 1351,
              "printed_page": 1269,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nasal bacterial infections best treated with antibiotics directed against Gram-positive bacteria (most common). Fungal disease treated with systemic and local infusion of antifungals.",
              "pdf_page": 1351,
              "printed_page": 1269,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Nasal mites are treated with ivermectin 200–300μg/kg PO or SC weekly for 3 weeks, selamectin 6–24 mg/kg applied topically every 2 weeks for 3 doses, or milbemycin (in collies and similar breeds) 0.5–1 mg/kg PO weekly for 3 weeks. All dogs in the household should be treated to prevent reinfection.",
              "pdf_page": 1351,
              "printed_page": 1269,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "When no underlying nasal condition is found to explain sneezing, nasal mite treatment is recommended. Immunomodulatory antibiotics such as doxycycline 5–10 mg/kg PO q12–24h",
              "pdf_page": 1351,
              "printed_page": 1269,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "and azathioprine 1–2 mg/kg/day PO in combination with piroxicam 0.3 mg/kg PO daily may be considered.",
              "pdf_page": 1351,
              "printed_page": 1269,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Lower airway diseases with excess secretions are treated with antibiotics if bacterial infection is confirmed; Gram-negative bacteria are most common.",
              "pdf_page": 1351,
              "printed_page": 1269,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Anti-inflammatory—prednisolone 1–2 mg/kg q12–24h or piroxicam 0.3 mg/kg PO q24–48h if no infection, for nonspecific airway inflammation.",
              "pdf_page": 1351,
              "printed_page": 1269,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No treatment for gagging secondary to sensory loss in the larynx with recurring aspiration; elevation of food and water bowls is recommended. Altering the consistency of food offered may also be helpful.",
              "pdf_page": 1351,
              "printed_page": 1269,
              "column": 2
            }
          ]
        },
        "CONTRAINDICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "CONTRAINDICATIONS",
          "canonical_heading": "CONTRAINDICATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Ivermectin in collies and similar breeds (MDR1gene mutation).",
              "pdf_page": 1351,
              "printed_page": 1269,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Use of piroxicam concurrently with other nonsteroidal anti-inflammatory drugs or corticosteroids, as well as in patients with renal insufficiency.",
              "pdf_page": 1351,
              "printed_page": 1269,
              "column": 2
            }
          ]
        },
        "PRECAUTIONS": {
          "present": true,
          "status": "content",
          "source_heading": "PRECAUTIONS",
          "canonical_heading": "PRECAUTIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "The safety of most recommended drugs has not been established in pregnant animals.",
              "pdf_page": 1351,
              "printed_page": 1269,
              "column": 2
            }
          ]
        },
        "POSSIBLE INTERACTIONS": {
          "present": true,
          "status": "not_applicable",
          "source_heading": "POSSIBLE INTERACTIONS",
          "canonical_heading": "POSSIBLE INTERACTIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "N/A",
              "pdf_page": 1351,
              "printed_page": 1269,
              "column": 2
            }
          ]
        },
        "CONTRAINDICATIONS/POSSIBLE INTERACTIONS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CONTRAINDICATIONS/POSSIBLE INTERACTIONS",
          "content_blocks": []
        },
        "ALTERNATIVE DRUG(S)": {
          "present": true,
          "status": "content",
          "source_heading": "ALTERNATIVE DRUG(S)",
          "canonical_heading": "ALTERNATIVE DRUG(S)",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Topical decongestants— 0.125% phenylephrine or 0.025% oxymetazoline.",
              "pdf_page": 1351,
              "printed_page": 1269,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Antihistamines (diphenhydramine, Zyrtec, Claritin) may reduce secretions and sneezing in some cases with underlying allergic component.",
              "pdf_page": 1351,
              "printed_page": 1269,
              "column": 2
            }
          ]
        }
      }
    },
    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Expect reduction in sneezing/reverse sneezing with appropriate therapy.",
              "pdf_page": 1351,
              "printed_page": 1269,
              "column": 2
            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Limit access to foreign bodies, provide adequate dental care and appropriate vaccination.",
              "pdf_page": 1351,
              "printed_page": 1269,
              "column": 2
            }
          ]
        },
        "POSSIBLE COMPLICATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "POSSIBLE COMPLICATIONS",
          "canonical_heading": "POSSIBLE COMPLICATIONS",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "If gagging is secondary to laryngeal sensory loss, serious aspiration pneumonia may develop.",
              "pdf_page": 1351,
              "printed_page": 1269,
              "column": 2
            }
          ]
        },
        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Nasal mites should respond to treatment within 3 weeks.",
              "pdf_page": 1351,
              "printed_page": 1269,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Sneezing and reverse sneezing secondary to foreign material resolve quickly after removal of the foreign body.",
              "pdf_page": 1351,
              "printed_page": 1269,
              "column": 3
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neoplasia may carry a poorer prognosis (chemotherapy or radiation therapy may be indicated).",
              "pdf_page": 1351,
              "printed_page": 1269,
              "column": 3
            }
          ]
        }
      }
    },
