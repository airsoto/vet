        "ACTIVITY": {
          "present": true,
          "status": "content",
          "source_heading": "ACTIVITY",
          "canonical_heading": "ACTIVITY",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "Exercise and activity should be restricted after rhinoscopic biopsies to prevent excessive bleeding.",
              "pdf_page": 1351,
              "printed_page": 1269,
              "column": 1
            }
          ]
        },
        "DIET": {
          "present": true,
          "status": "not_applicable",
          "source_heading": "DIET",
          "canonical_heading": "DIET",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "N/A",
              "pdf_page": 1351,
              "printed_page": 1269,
              "column": 1
            }
          ]
        },
        "CLIENT EDUCATION": {
          "present": true,
          "status": "content",
          "source_heading": "CLIENT EDUCATION",
          "canonical_heading": "CLIENT EDUCATION",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Educate clients so they understand these are normal reflexes. Diagnostic testing is required to determine the underlying cause and to allow appropriate treatment.",
              "pdf_page": 1351,
              "printed_page": 1269,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Close contact with other animals should be limited until treatment for the underlying cause (if infectious) is completed.",
              "pdf_page": 1351,
              "printed_page": 1269,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Episodes of paroxysmal reverse sneezing may be lessened by inducing swallowing (rubbing the throat, giving water) or breath holding (cover nose and mouth).",
              "pdf_page": 1351,
              "printed_page": 1269,
              "column": 1
            }
          ]
        },
        "SURGICAL CONSIDERATIONS": {
          "present": true,
          "status": "content",
          "source_heading": "SURGICAL CONSIDERATIONS",
          "canonical_heading": "SURGICAL CONSIDERATIONS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Anesthesia for surgery or endoscopy— abscessed tooth, foreign body, masses or anatomical airway abnormality, treatment of fungal infections.",
              "pdf_page": 1351,
              "printed_page": 1269,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Use surgery for laryngeal disease with caution when gagging is prominent due to an increased risk of aspiration pneumonia when concurrent esophageal dysfunction is present.",
              "pdf_page": 1351,
              "printed_page": 1269,
              "column": 1
            }
          ]
        },
