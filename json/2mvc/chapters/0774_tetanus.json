            }
          ]
        },
        "PREVENTION/AVOIDANCE": {
          "present": true,
          "status": "content",
          "source_heading": "PREVENTION/AVOIDANCE",
          "canonical_heading": "PREVENTION/AVOIDANCE",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Vaccinate—tetanus toxoid; not typically used in dogs and cats.",
              "pdf_page": 1403,
              "printed_page": 1321,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prevent skin wound trauma—clear runs and yards of wire, glass, etc.",
              "pdf_page": 1403,
              "printed_page": 1321,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Wound management—early and thorough irrigation; debridement and drainage, especially in tetanus-prone wounds.",
              "pdf_page": 1403,
              "printed_page": 1321,
              "column": 1
            }
          ]
        },
        "POSSIBLE COMPLICATIONS": {
