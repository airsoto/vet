      "subsections": {
        "PATIENT MONITORING": {
          "present": true,
          "status": "content",
          "source_heading": "PATIENT MONITORING",
          "canonical_heading": "PATIENT MONITORING",
          "content_blocks": [
            {
              "type": "paragraph",
              "level": 0,
              "text": "tracheostomy may be necessary; monitor",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Monitor for decubital ulcers and peripheral blood gas for evidence of hypoventilation. nerve palsies.",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Monitor blood pressure and ECG.",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Aspiration possible.",
