              "printed_page": 1320,
              "column": 1,
              "subheading": "Progressive/Generalized"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dysphagia, dysphonia.",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1,
              "subheading": "Progressive/Generalized"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Eyes—lids retract (risus sardonicus, also",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1,
              "subheading": "Progressive/Generalized"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "includes wrinkled forehead and grinning",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1,
              "subheading": "Progressive/Generalized"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "appearance); third eyelid prolapses when head",
