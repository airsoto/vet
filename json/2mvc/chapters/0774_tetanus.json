              "printed_page": 1320,
              "column": 1,
              "subheading": "Progressive/Generalized"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(sudden movement, sound, touch).",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1,
              "subheading": "Progressive/Generalized"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Death—during spasm of laryngeal and",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1,
              "subheading": "Progressive/Generalized"
            },
            {
              "type": "paragraph",
              "level": 0,
