        "EXPECTED COURSE AND PROGNOSIS": {
          "present": true,
          "status": "content",
          "source_heading": "EXPECTED COURSE AND PROGNOSIS.",
          "canonical_heading": "EXPECTED COURSE AND PROGNOSIS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Younger dogs with tetanus may be more likely to develop severe clinical signs.",
              "pdf_page": 1403,
              "printed_page": 1321,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "The prognosis for survival in dogs with tetanus is good if abnormalities in heart rate or blood pressure values do not develop.",
              "pdf_page": 1403,
              "printed_page": 1321,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Prognosis—depends on number of factors; poorer prognosis has been associated with",
              "pdf_page": 1403,
              "printed_page": 1321,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "more toxin bound to nerves, wounds closer to the head, shorter interval between injury and first tetanic spasm, and development of aspiration pneumonia.",
              "pdf_page": 1403,
              "printed_page": 1321,
              "column": 2
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Course of recovery—slow; requires rehabilitation to regain full use of limbs; most recover in 1 week; some have a course of 3–4 weeks; unattended disease can be fatal if it progresses to generalized disease (vs. localized tetanus).",
              "pdf_page": 1403,
              "printed_page": 1321,
              "column": 2
            }
          ]
        }
      }
