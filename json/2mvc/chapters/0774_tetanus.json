            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "enter wound.",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Wound—often necrotic; but skin may have",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "healed and not visible to owner.",
