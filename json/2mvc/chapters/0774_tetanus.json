          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Clostridium tetani—an obligate anaerobic spore-forming Gram-positive rod found in soil and as part of normal bacterial flora of the intestinal tract of mammals; predilection for contaminated necrotic anaerobic wounds.",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Germinating spores—in wounds, produce potent exotoxin tetanospasmin (tetanus toxin); resistant to disinfectants and to effects of environmental exposure.",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1
            }
          ]
        },
