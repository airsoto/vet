              "printed_page": 1320,
              "column": 1,
              "subheading": "Progressive/Generalized"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "is touched; eyeballs recede into orbit",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1,
              "subheading": "Progressive/Generalized"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(enophthalmos).",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1,
              "subheading": "Progressive/Generalized"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Erect ears.",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1,
              "subheading": "Progressive/Generalized"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Salivation.",
