              "text": "CSF and blood cultures for bacterial",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 2,
              "subheading": "Antibiotics"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Metronidazole 10 mg/kg PO, IV q8–12h,",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 2,
              "subheading": "Antibiotics"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "pathogens of meningitis.",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 2,
              "subheading": "Antibiotics"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "preferred.",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 2,
              "subheading": "Antibiotics"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Penicillin G 20,000–100,000 IU/kg",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 2,
              "subheading": "Antibiotics"
            },
            {
              "type": "paragraph",
