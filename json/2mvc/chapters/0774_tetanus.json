              "printed_page": 1320,
              "column": 1,
              "subheading": "Historical Findings"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Physical Examination Findings",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "The most commoninitialclinical signs in",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "affected dogs are ocular and facial abnormalities.",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1,
              "subheading": "The most commoninitialclinical signs in"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Localized",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Mild rigidity of muscles or leg nearest the",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1,
              "subheading": "Localized"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "site of spore inoculation (wound).",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1,
              "subheading": "Localized"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Stiffness of (hind) limbs; stilted gait; mild",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1,
              "subheading": "Localized"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "weakness and incoordination.",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1,
              "subheading": "Localized"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Can resolve spontaneously—reflects partial",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1,
              "subheading": "Localized"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "immunity to tetanospasmin.",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1,
              "subheading": "Localized"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Can be prodromal to generalized disease—",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1,
              "subheading": "Localized"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "when enough toxin gains access to CNS.",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1,
              "subheading": "Localized"
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Progressive/Generalized",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Tail—stretches out; progressive tetany of",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1,
              "subheading": "Progressive/Generalized"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "muscles to point of sawhorse appearance.",
