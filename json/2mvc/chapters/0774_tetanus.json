    "TREATMENT": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "paragraph",
          "level": 0,
          "text": "penicillin (IM) thereafter.",
          "pdf_page": 1402,
          "printed_page": 1320,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Inpatient—constant nursing care",
          "pdf_page": 1402,
          "printed_page": 1320,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Glycopyrrolate 0.005–0.01 mg/kg IV, IM important; supportive care for prolonged q4–6h can be used to treat bradycardia period (3–4 weeks). associated with severe tetanus.",
          "pdf_page": 1402,
          "printed_page": 1320,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Feeding—patients often have difficulty",
          "pdf_page": 1402,
          "printed_page": 1320,
          "column": 2
        },
        {
          "type": "subheading",
          "level": 0,
          "text": "CONTRAINDICATIONS/POSSIBLE",
          "pdf_page": 1402,
          "printed_page": 1320,
          "column": 2
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "prehending food; gastrotomy tube may be",
          "pdf_page": 1402,
          "printed_page": 1320,
          "column": 2,
          "subheading": "CONTRAINDICATIONS/POSSIBLE"
        },
        {
          "type": "subheading",
          "level": 0,
          "text": "INTERACTIONS",
          "pdf_page": 1402,
          "printed_page": 1320,
          "column": 2
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "necessary; force feeding may exacerbate",
          "pdf_page": 1402,
          "printed_page": 1320,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Avoid glucocorticoids and atropine.",
          "pdf_page": 1402,
          "printed_page": 1320,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "tetanic state (not advised).",
          "pdf_page": 1402,
          "printed_page": 1320,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Use caution with narcotics—depress",
          "pdf_page": 1402,
          "printed_page": 1320,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Hydration—maintain with oral water; if",
          "pdf_page": 1402,
          "printed_page": 1320,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "respiratory center.",
          "pdf_page": 1402,
          "printed_page": 1320,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "inadequate give a balanced IV fluid.",
          "pdf_page": 1402,
          "printed_page": 1320,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Avoid oral diazepam in cats due to",
          "pdf_page": 1402,
          "printed_page": 1320,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Keep patient in darkened quiet area; do not",
          "pdf_page": 1402,
          "printed_page": 1320,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "hepatotoxicity.",
          "pdf_page": 1402,
          "printed_page": 1320,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "disturb.",
          "pdf_page": 1402,
          "printed_page": 1320,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Keep patient on soft bedding; prevent",
          "pdf_page": 1402,
          "printed_page": 1320,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "decubital ulcers; rotate stabilized patients",
          "pdf_page": 1402,
          "printed_page": 1320,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "cautiously, q4–6h.",
          "pdf_page": 1402,
          "printed_page": 1320,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Airway and ventilation—assess; may be",
          "pdf_page": 1402,
          "printed_page": 1320,
          "column": 2,
          "subheading": "INTERACTIONS"
        },
        {
          "type": "paragraph",
          "level": 0,
          "text": "necessary to perform endotracheal intubation;",
          "pdf_page": 1402,
          "printed_page": 1320,
          "column": 2,
          "subheading": "INTERACTIONS"
        }
      ],
