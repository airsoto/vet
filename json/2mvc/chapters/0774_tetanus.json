              "printed_page": 1320,
              "column": 1,
              "subheading": "Progressive/Generalized"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Convulsions (clonic)—limbs; whole body",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1,
              "subheading": "Progressive/Generalized"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "(opisthotonus); pain during contractions.",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1,
              "subheading": "Progressive/Generalized"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Dyspnea.",
              "pdf_page": 1402,
              "printed_page": 1320,
              "column": 1,
              "subheading": "Progressive/Generalized"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Difficulty opening jaws—trismus",
