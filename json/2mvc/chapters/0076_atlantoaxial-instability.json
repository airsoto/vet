        "SIGNALMENT": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNALMENT",
          "canonical_heading": "SIGNALMENT",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Congenital—toy-breed dogs (Yorkshire terrier, miniature or toy poodle, Chihuahua, Pekingese, and Pomeranian).",
              "pdf_page": 214,
              "printed_page": 132,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Age at onset—usually before 12 months.",
              "pdf_page": 214,
              "printed_page": 132,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Uncommon in larger-breed dogs, dogs>1 year old, and cats.",
              "pdf_page": 214,
              "printed_page": 132,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "No sex predilection.",
              "pdf_page": 214,
              "printed_page": 132,
              "column": 1
            }
          ]
        },
        "SIGNS": {
          "present": true,
          "status": "content",
          "source_heading": "SIGNS",
          "canonical_heading": "SIGNS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Intermittent or progressive ambulatory tetraparesis, usually with neck pain—most common.",
              "pdf_page": 214,
              "printed_page": 132,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Neurologic signs vary from mild to moderate GP/UMN ambulatory tetraparesis to nonambulatory GP/UMN tetraparesis, or tetraplegia, depending on degree of spinal cord compression and secondary pathology (i.e., edema, hemorrhage, or gliosis).",
              "pdf_page": 214,
              "printed_page": 132,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Animals may have only neck pain without concurrent neurologic deficits.",
              "pdf_page": 214,
              "printed_page": 132,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Episodes of collapse secondary to weakness.",
              "pdf_page": 214,
              "printed_page": 132,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Abnormal postural reactions with spinal reflexes that are normal to exaggerated, with normal to increased muscle tone in all four limbs.",
              "pdf_page": 214,
              "printed_page": 132,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acute death may occur when accompanied by trauma and respiratory arrest (uncommon).",
              "pdf_page": 214,
              "printed_page": 132,
              "column": 1
            }
          ]
        },
        "CAUSES": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "CAUSES",
          "content_blocks": []
        },
        "RISK FACTORS": {
          "present": false,
          "status": "missing",
          "source_heading": null,
          "canonical_heading": "RISK FACTORS",
          "content_blocks": []
        },
        "CAUSES & RISK FACTORS": {
          "present": true,
          "status": "content",
          "source_heading": "CAUSES & RISK FACTORS",
          "canonical_heading": "CAUSES & RISK FACTORS",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Usually caused by abnormal development of the dens and/or ligamentous support structures, resulting in subluxation of the atlantoaxial joint.",
              "pdf_page": 214,
              "printed_page": 132,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Fracture of the axis.",
              "pdf_page": 214,
              "printed_page": 132,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical signs often occur as a result of mild or insignificant trauma (e.g., jumping or playing).",
              "pdf_page": 214,
              "printed_page": 132,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Clinical signs may be exacerbated by activity such as flexion of the neck.",
              "pdf_page": 214,
              "printed_page": 132,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Toy-breed dogs—at risk for congenital malformation of the dens.",
              "pdf_page": 214,
              "printed_page": 132,
              "column": 1
            }
          ]
        }
      }
    },
