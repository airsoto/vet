  "sections": {
    "BASICS": {
      "present": true,
      "status": "content",
      "content_blocks": [],
      "subsections": {
        "OVERVIEW": {
          "present": true,
          "status": "content",
          "source_heading": "OVERVIEW",
          "canonical_heading": "OVERVIEW",
          "content_blocks": [
            {
              "type": "bullet",
              "level": 0,
              "text": "Results from malformation or disruption of the articulation between the first and second cervical vertebrae (atlas and axis, respectively); causes spinal cord compression.",
              "pdf_page": 214,
              "printed_page": 132,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Can result in spinal cord trauma or compression at the junction between atlas and axis—may cause neck pain and/or varying degrees of general proprioceptive (GP) ataxia/upper motor neuron (UMN) tetraparesis, tetraplegia (with or without nociception), and death from respiratory arrest.",
              "pdf_page": 214,
              "printed_page": 132,
              "column": 1
            },
            {
              "type": "subheading",
              "level": 0,
              "text": "Etiology",
              "pdf_page": 214,
              "printed_page": 132,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Congenital—anomaly of the dens (aplasia,",
              "pdf_page": 214,
              "printed_page": 132,
              "column": 1,
              "subheading": "Etiology"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "hypoplasia, or malformation [dorsal angulation]",
              "pdf_page": 214,
              "printed_page": 132,
              "column": 1,
              "subheading": "Etiology"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "of the dens) and its ligamentous attachments.",
              "pdf_page": 214,
              "printed_page": 132,
              "column": 1,
              "subheading": "Etiology"
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Acquired—consequence of traumatic",
              "pdf_page": 214,
              "printed_page": 132,
              "column": 1,
              "subheading": "Etiology"
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "injury.",
              "pdf_page": 214,
              "printed_page": 132,
              "column": 1,
              "subheading": "Etiology"
            }
          ]
        },
