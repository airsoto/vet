    "FOLLOW-UP": {
      "present": true,
      "status": "content",
      "content_blocks": [
        {
          "type": "bullet",
          "level": 0,
          "text": "Dogs treated medically require frequent (weekly) bandage changes for associated soft tissue trauma.",
          "pdf_page": 215,
          "printed_page": 133,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "All dogs should be reevaluated at 1 and 3 months (postoperatively or after neck brace removal) and then monthly until neurologic deficits resolve or remain static over 2–3 months.",
          "pdf_page": 215,
          "printed_page": 133,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "More frequent rechecks may be needed for dogs experiencing complications or recurrence of signs.",
          "pdf_page": 215,
          "printed_page": 133,
          "column": 2
        },
        {
          "type": "bullet",
          "level": 0,
          "text": "Untreated animals may experience deterioration in neurologic function, catastrophic acute spinal cord trauma, respiratory arrest, and death.",
          "pdf_page": 215,
          "printed_page": 133,
          "column": 2
        }
      ],
