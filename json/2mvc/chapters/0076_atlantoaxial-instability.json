            {
              "type": "paragraph",
              "level": 0,
              "text": "(NSAID)—1- to 4-week course.",
              "pdf_page": 215,
              "printed_page": 133,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 0,
              "text": "Analgesia:",
              "pdf_page": 215,
              "printed_page": 133,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Tramadol 2.0–4.0 mg/kg PO q6–8h—",
              "pdf_page": 215,
              "printed_page": 133,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "questionable efficacy.",
              "pdf_page": 215,
              "printed_page": 133,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Gabapentin 10–20 mg/kg PO q6–8h.",
              "pdf_page": 215,
              "printed_page": 133,
              "column": 1
            },
            {
              "type": "bullet",
              "level": 1,
              "text": "Pregabalin 3–4 mg/kg (begin with 2 mg/",
              "pdf_page": 215,
              "printed_page": 133,
              "column": 1
            },
            {
              "type": "paragraph",
              "level": 0,
              "text": "kg) PO q8–12h.",
              "pdf_page": 215,
