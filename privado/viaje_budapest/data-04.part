":"Andrássy, Basílica o Mercado Central si el grupo prefiere desplazarse.","mapQuery":"St. Stephen's Basilica Budapest","category":"walk"},{"time":"11:15–12:00","title":"🏨 Recoger equipaje","travel":"—","note":"Recuento del grupo y vehículos.","mapQuery":"Medos Hotel Budapest","category":"hotel"},{"time":"12:00–13:00","title":"🚐 Hotel → aeropuerto","travel":"35–60 min","note":"Transfer concertado recomendado.","mapQuery":"Budapest Ferenc Liszt International Airport","category":"transport"},{"time":"15:30–18:50","title":"✈️ Vuelo Budapest → Madrid","travel":"3 h 20 min","note":"Iberia IB 872.","mapQuery":"Adolfo Suárez Madrid–Barajas Airport","category":"flight"}],"finalPick":[{"label":"Hora límite","choice":"12:15 salida del hotel","reason":"Evita dividir el grupo o llegar con prisas."},{"label":"Mañana","choice":"Paseo corto cerca de Oktogon","reason":"Menos riesgo logístico."}]}],"places":[{"id":"medos","name":"Medos Hotel","emoji":"🏨","type":"Hotel","area":"Oktogon","priority":"Base","mapQuery":"Medos Hotel Budapest Jókai tér 9","notes":"Alojamiento del grupo.","website":"https://medoshotel.hu/en/main-page/"},{"id":"parliament","name":"Parlamento de Hungría","emoji":"🏛️","type":"Monumento","area":"Kossuth tér","priority":"Imprescindible","mapQuery":"Hungarian Parliament Building Budapest","notes":"Exterior obligatorio; interior solo con entrada oficial.","website":"https://orszaghazkonyvkiado.parlament.hu/en/web/visitors/home"},{"id":"fisherman","name":"Bastión de los Pescadores","emoji":"🌇","type":"Mirador","area":"Buda","priority":"Imprescindible","mapQuery":"Fisherman's Bastion Budapest","notes":"Vista clásica del Parlamento y el Danubio."},{"id":"matthias","name":"Iglesia de Matías","emoji":"⛪","type":"Iglesia","area":"Buda","priority":"Muy recomendable","mapQuery":"Matthias Church Budapest","notes":"Interior destacado dentro del Distrito del Castillo.","website":"https://matyas-templom.hu/"},{"id":"buda","name":"Castillo de Buda","emoji":"🏰","type":"Distrito