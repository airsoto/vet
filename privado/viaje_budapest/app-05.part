 <div class="route"><div class="airport"><strong>${esc(f.departure)}</strong><span>${esc(f.origin)}</span></div><div class="route-line">✈</div><div class="airport"><strong>${esc(f.arrival)}</strong><span>${esc(f.destination)}</span></div></div>
    <div class="notice">${esc(f.note)}</div></article>`;
  }
  function renderFlights(){
    $("#flights").innerHTML=`<div class="section-title"><div><h2>Vuelos</h2><p>Horarios locales y márgenes recomendados.</p></div><span class="pill">Iberia</span></div><div class="grid two">${flightCard(data.flights.outbound)}${flightCard(data.flights.return)}</div>`;
  }
  function renderReservations(){
    $("#reservations").innerHTML=`<div class="section-title"><div><h2>Reservas pendientes</h2><p>Lo que conviene cerrar para que 12 personas no improvisen.</p></div><span class="pill">6 tareas</span></div>
      <div class="place-list">${data.reservations.map(r=>`<article class="place-card"><div class="place-emoji">${r.emoji}</div><div><h3>${esc(r.title)}</h3><p>${esc(r.when)} · ${esc(r.options)}</p><div class="place-meta"><span class="chip priority ${esc(r.priority)}">${esc(r.priority)}</span><span class="chip">${esc(r.action)}</span></div></div></article>`).join("")}</div>`;
  }
  function renderPlanB(){
    $("#planb").innerHTML=`<div class="section-title"><div><h2>Plan B</h2><p>Lluvia, cansancio, retrasos o preferencias distintas.</p></div><span class="pill">☔ Flexible</span></div>
      <div class="accordion">${data.planB.map(d=>`<details><summary>${esc(d.title)} <span>＋</span></summary><div class="accordion-content">${d.scenarios.map(s=>`<h3>${esc(s.title)}</h3><ul>${s.items.map(i=>`<li>${esc(i)}</li>`).join("")}</ul>`).join("")}</div></details>`).join("")}</div>`;
  }
  function renderBudget(){
    $("#budget").innerHTML=`<div class="section-title"><div><h2>Presupuesto orientativo</h2><p>Rangos amplios para comparar opciones por persona y grupo.</p></div><span class="pill">12 personas</span></div>
      <div class="notice">${esc(data.budget.currencyNote)}</div>
      <div class="data-table" style="margin-top:12px">${data.budget.items.map(i=>`<div class="data-row"><span>${esc(i.category)}</span><div><strong>${esc(i.perPerson)} por persona · ${esc(i.group)} grupo</strong><div class="mini-note">${esc(i.notes)}</div></div></div>`).join("")}</div>`;
  }
  function renderPractical(){
    $("#practical").innerHTML=`<div class="section-title"><div><h2>Información práctica</h2><p>Detalles que evitan problemas durante el viaje.</p></div></div>
      <div class="grid three">${data.practical.map(p=>`<article class="card"><div class="place-emoji">${p.emoji}</div><h3>${esc(p.title)}</h3><p class="mini-note">${esc(p.text)}</p></article>`).join("")}</div>`;
  }
