${ev.travel&&ev.travel!=="—"?`<span class="chip">↔ ${esc(ev.travel)}</span>`:""}<span class="chip">${esc(ev.category)}</span></div>
        ${mapActions(ev)}</div></article>`).join("")}</div>
      <div class="pick-grid">${d.finalPick.map(p=>`<div class="pick"><span>${esc(p.label)}</span><strong>${esc(p.choice)}</strong><p>${esc(p.reason)}</p></div>`).join("")}</div>
    </div>`;
  }
  function renderHotel(){
    const h=data.hotel;
    $("#hotel").innerHTML=`<div class="section-title"><div><h2>Hotel y transporte</h2><p>Base, contacto y llegada desde el aeropuerto.</p></div><span class="pill">Oktogon</span></div>
    <div class="grid two">
      <article class="card">
        <div class="day-intro"><div><span class="pill">${esc(h.ratingText)}</span><h2>${esc(h.name)}</h2><p>${esc(h.area)}</p></div><div class="day-emoji">🏨</div></div>
        <div class="data-table" style="margin-top:14px">
          <div class="data-row copyable" data-copy="${esc(h.address)}"><span>Dirección</span><strong>${esc(h.address)}</strong></div>
          <div class="data-row copyable" data-copy="${esc(h.phone)}"><span>Teléfono</span><strong>${esc(h.phone)}</strong></div>
        </div>
        <div class="accordion" style="margin-top:12px"><details open><summary>Notas prácticas <span>＋</span></summary><div class="accordion-content"><ul>${h.notes.map(n=>`<li>${esc(n)}</li>`).join("")}</ul></div></details></div>
        ${mapActions(h)}
      </article>
      <div class="stack">${data.transport.map(t=>`<article class="card transport-card"><div class="place-emoji">${t.emoji}</div><div><span class="pill">${esc(t.bestFor)}</span><h3>${esc(t.title)}</h3><p>${esc(t.details)}</p><div class="event-meta"><span class="chip">⏱ ${esc(t.time)}</span></div>${mapActions(t)}</div></article>`).join("")}</div>
    </div>`;
    $$(".copyable",$("#hotel")).forEach(el=>el.addEventListener("click",()=>copyText(el.dataset.copy)));
  }
  function placeCard(p){
    const active=favorites.has(p.id);
    return `<article class="place-card" data-type="${esc(p.type)}">
      <div class="place-emoji">${p.emoji}</div><div><h3>${esc(p.name)}</h3><p>${esc(p.notes)}</p>
      <div class="place-meta"><span class="chip">${esc(p.type)}</span><span class="chip">${esc(p.area)}</span>${p.priority?`<span class="chip good">${esc(p.priority)}</span>`:""}</div>${mapActions(p)}</div>
      <button class="fav-btn ${active?"active":""}" data-fav="${esc(p.id)}" aria-label="Guardar favorito">${active?"★":"☆"}</button></article>`;
  }
  function bindFavs(scope=document){
    $$("[data-fav]",scope).forEach(btn=>btn.addEventListener("click",()=>{
      const id=btn.dataset.fav; favorites.has(id)?favorites.delete(id):favorites.add(id);
      localStorage.setItem(FAV_KEY,JSON.stringify([...favorites])); renderSites(); showToast(favorites.has(id)?"Guardado":"Eliminado");
    }));
  }
