laces.filter(p=>siteFilter==="Todos"||siteFilter==="Favoritos"&&favorites.has(p.id)||p.type===siteFilter);
    $("#sites").innerHTML=`<div class="section-title"><div><h2>Visitas y experiencias</h2><p>Imprescindibles, alternativas y accesos directos a mapas.</p></div><span class="pill">${list.length} sitios</span></div>
    <div class="filter-row">${types.map(t=>`<button class="filter-chip ${siteFilter===t?"active":""}" data-site-filter="${esc(t)}">${esc(t)}</button>`).join("")}</div>
    <div class="place-list">${list.length?list.map(placeCard).join(""):`<div class="empty">No hay elementos en este filtro.</div>`}</div>`;
    $$("[data-site-filter]").forEach(b=>b.addEventListener("click",()=>{siteFilter=b.dataset.siteFilter;renderSites();}));
    bindFavs($("#sites"));
  }
  function restaurantCard(r){
    return `<article class="card restaurant-card">
      <div class="restaurant-top"><div><span class="pill">${r.emoji} ${esc(r.type)}</span><h3>${esc(r.name)}</h3><p>${esc(r.reason)}</p></div></div>
      <div class="restaurant-info"><div class="mini-stat"><span>Zona</span><strong>${esc(r.area)}</strong></div><div class="mini-stat"><span>Precio</span><strong>${esc(r.price)}</strong></div><div class="mini-stat"><span>Reserva</span><strong>${esc(r.reservation)}</strong></div></div>
      <div class="event-meta"><span class="chip">${esc(r.distance)}</span><span class="chip good">${esc(r.group)}</span></div>${mapActions(r)}
    </article>`;
  }
  function renderFood(){
    const areas=["Todos",...new Set(data.restaurants.map(r=>r.area))];
    const list=data.restaurants.filter(r=>foodFilter==="Todos"||r.area===foodFilter);
    $("#food").innerHTML=`<div class="section-title"><div><h2>Dónde comer</h2><p>Opciones pensadas para una mesa de 12.</p></div><span class="pill">Reservar pronto</span></div>
    <div class="filter-row">${areas.map(a=>`<button class="filter-chip ${foodFilter===a?"active":""}" data-food-filter="${esc(a)}">${esc(a)}</button>`).join("")}</div>
    <div class="grid two">${list.map(restaurantCard).join("")}</div>`;
    $$("[data-food-filter]").forEach(b=>b.addEventListener("click",()=>{foodFilter=b.dataset.foodFilter;renderFood();}));
  }
  function renderNight(){
    $("#night").innerHTML=`<div class="section-title"><div><h2>Copas y noche</h2><p>Desde ruin bars hasta rooftops más tranquilos.</p></div><span class="pill">Plan flexible</span></div>
      <div class="grid three">${data.nightlife.map(n=>`<article class="card night-card"><span class="pill">${n.emoji} ${esc(n.type)}</span><h3>${esc(n.name)}</h3><p>${esc(n.notes)}</p><div class="event-meta"><span class="chip">${esc(n.area)}</span><span class="chip hot">${esc(n.vibe)}</span></div>${mapActions(n)}</article>`).join("")}</div>`;
  }
  function flightCard(f){
    return `<article class="card flight-card"><div class="flight-head"><div><span class="pill">${f.emoji} ${esc(f.airline)} · ${esc(f.flight)}</span><h3>${esc(f.date)}</h3></div><strong>${esc(f.duration)}</strong></div>
   